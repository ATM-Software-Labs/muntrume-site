{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MMT Sync",
  "version": "0.4.2",
  "identifier": "me.muntru.mmt-sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; media-src 'self' asset: https://asset.localhost; frame-src https://www.youtube-nocookie.com; font-src 'self'; connect-src 'ipc:' 'http://ipc.localhost' 'https://ipc.localhost'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "label": "main",
        "title": "MMT Sync",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-gpu-vsync --disable-features=msWebOOUI,msPdfOOUI,Translate,BackForwardCache --disable-extensions --disable-background-networking --disable-sync --disable-translate --disable-default-apps --disk-cache-size=1 --media-cache-size=1 --disable-application-cache --renderer-process-limit=1 --js-flags=--max-old-space-size=256"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Muntrume Motorsport",
    "copyright": "Copyright © 2026 Muntrume Motorsport",
    "category": "Sports",
    "shortDescription": "Sincroniza los setups de Muntrume con iRacing",
    "longDescription": "MMT Sync copia los setups .sto del equipo a la carpeta de iRacing del piloto, dentro de MMT.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "installerHooks": "nsis-hooks.nsh",
        "installMode": "both",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MzA1QUY5ODBCNkQ1OTMKUldTVDFiYUErVm93NUt3aTlLa3hISGI4RWltMjJOT3J3YzBvTVlld3dRd3A1VnhzdDFJWnlKZUcK",
      "endpoints": [
        "https://github.com/ATM-Software-Labs/muntrume-site/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
