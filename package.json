{
  "name": "muntrume-site",
  "version": "2.0.0",
  "description": "Muntrume Motorsport official website & setup vault",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/assets/css/tailwind.min.css --minify",
    "compress": "node scripts/compress-html.mjs",
    "i18n": "node src/i18n/emit.mjs",
    "ai-md": "node scripts/bundle-ai-md.mjs",
    "build": "node src/i18n/emit.mjs && node scripts/bundle-ai-md.mjs && npm run css && astro build && node scripts/generate-sitemap.mjs && node scripts/minify-assets.mjs && node scripts/compress-html.mjs",
    "check": "astro check",
    "preview": "astro preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ATM-Software-Labs/muntrume-site.git"
  },
  "author": "Muntrume Motorsport (ATM Software Labs)",
  "license": "UNLICENSED",
  "dependencies": {
    "astro": "7.4.7",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "postal-mime": "4.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "^0.28.2",
    "html-minifier-terser": "7.2.0",
    "tailwindcss": "4.3.3",
    "terser": "5.51.2",
    "typescript": "5.9.3"
  }
}
