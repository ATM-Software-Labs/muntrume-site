---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MuntrumeChatbot from '../components/MuntrumeChatbot.astro';
import { PILOTOS } from '../lib/pilotos';
import { formatoAprox, localeDeIdioma } from '../lib/formato-licencia.js';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  schemaJson?: any;
  hideNav?: boolean;
  hideFooter?: boolean;
  noindex?: boolean;
}

const siteOrigin = Astro.site ? Astro.site.origin : (Astro.url ? Astro.url.origin : "https://muntru.me");

const {
  title = "Muntrume Motorsport | Official iRacing Sim Racing Team — Setup Vault & Telemetry",
  description = `Official iRacing sim racing team based in Sant Andreu, Barcelona. Over 41,000 .STO setups, Garage 61 telemetry, and ${PILOTOS.length} official drivers.`,
  canonical = Astro.url.href,
  ogImage = `${siteOrigin}/assets/img/og-home.jpg`,
  ogType = "website",
  schemaJson = null,
  hideNav = false,
  hideFooter = false,
  noindex = false
} = Astro.props;

function hreflangSet(href: string) {
  let base = href;
  try {
    const u = new URL(href, "https://muntru.me");
    u.searchParams.delete("lang");
    u.hash = "";
    base = u.toString();
  } catch { /* keep href as is */ }
  const alt = (lang: string) => {
    const u = new URL(base);
    if (lang !== "en") u.searchParams.set("lang", lang);
    return u.toString();
  };
  return { en: alt("en"), es: alt("es"), ca: alt("ca"), fr: alt("fr") };
}
const langs = hreflangSet(canonical);

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsTeam",
      "@id": `${siteOrigin}/#org`,
      "name": "Muntrume Motorsport",
      "alternateName": ["Muntrume", "MRT Sim Racing", "Muntrume Racing Team"],
      "url": `${siteOrigin}/`,
      "sport": "Sim Racing (iRacing)",
      "description": `Official iRacing sim racing team based in Sant Andreu, Barcelona. Over 41,000 .STO setups and ${PILOTOS.length} official drivers.`,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteOrigin}/assets/img/icon-512.png`,
        "width": 512,
        "height": 512
      },
      "image": `${siteOrigin}/assets/img/og-home.jpg`,
      "location": {
        "@type": "Place",
        "name": "Muntrume Motorsport HQ",
        "address": {
          "type": "PostalAddress",
          "addressLocality": "Sant Andreu, Barcelona",
          "addressRegion": "Catalonia",
          "addressCountry": "ES"
        }
      },
      "founder": {
        "@type": "Person",
        "name": "Alberto Trujillo Mingorance",
        "url": `${siteOrigin}/drivers/albertot/`
      },
      "member": PILOTOS.map((p) => ({
        "@type": "Person",
        "name": p.fullName,
        "jobTitle": p.role,
        "url": `${siteOrigin}/drivers/${p.slug}/`
      })),
      "knowsAbout": [
        "iRacing",
        "Sim Racing",
        "iRacing Setups",
        "Sports Car",
        "GT3 Endurance",
        "GT4 Endurance",
        "Multiclass Endurance",
        "Motorsport Engineering"
      ],
      "sameAs": [
        "https://discord.gg/ehX6B8JUtE",
        "https://garage61.net/app/teams/muntrume-motorsport",
        "https://ai.trujillomingorance.com",
        "https://github.com/atrumin16/muntrume-site"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "name": "Muntrume Motorsport",
      "url": "https://muntru.me/",
      "inLanguage": ["en-US", "es-ES", "ca-ES", "fr-FR"],
      "publisher": {
        "@id": "https://muntru.me/#org"
      }
    }
  ]
};

const finalSchema = schemaJson || defaultSchema;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth max-w-full overflow-x-hidden" data-theme="dark">
<head>
  <script is:inline>
    (function() {
      try {
        var t = localStorage.getItem('muntrume_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (t === 'light') {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; img-src 'self' data: https:; frame-src 'self' https://discord.com https://*.discord.com; connect-src 'self' https://muntrume.atrumin16.workers.dev https://ai.trujillomingorance.com https://api.garage61.net https://api.brevo.com;" />
  <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="iracing setups, iracing telemetry, muntrume motorsport, garage 61 setups, download iracing setups, free iracing setups, sim racing barcelona, gt3 setups, gt4 setups, sports car endurance, iracing setup vault" />
  <meta name="author" content="Muntrume Motorsport · Alberto Trujillo Mingorance" />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
  <link rel="canonical" href={langs.en} />
  <link rel="alternate" hreflang="en" href={langs.en} />
  <link rel="alternate" hreflang="es" href={langs.es} />
  <link rel="alternate" hreflang="ca" href={langs.ca} />
  <link rel="alternate" hreflang="fr" href={langs.fr} />
  <link rel="alternate" hreflang="x-default" href={langs.en} />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={langs.en} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="Muntrume Motorsport" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="es_ES" />
  <meta property="og:locale:alternate" content="ca_ES" />
  <meta property="og:locale:alternate" content="fr_FR" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@muntrumemrt" />
  <meta name="twitter:creator" content="@atrumin16" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicons and Webmanifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="msapplication-TileColor" content="#080C0A" />
  <meta name="theme-color" content="#080C0A" />

  <!-- Fonts: self-hosted (latin + latin-ext, font-display: swap) — sin terceros ni CSS bloqueante externo -->
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/SpaceGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/BarlowCondensed-800-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/fonts/fonts.css?v=t264" />
  <slot name="head" />

  <link rel="stylesheet" href="/assets/css/tailwind.min.css?v=t298" />
  <link rel="stylesheet" href="/assets/css/mobile.css?v=t265" />
  <link rel="stylesheet" href="/assets/css/racing.css?v=t298" />

  <!-- Core Dark Racing System CSS -->
  <style is:global>
    :root {
      color-scheme: dark;
      --bg-paddock: #0E1211;
      --surface-card: #1A2120;
      --border-card: #242E2C;
      --accent-paddock: #00E699;
      --text-muted: #9AA8A3;
    }
    body {
      background-color: #0E1211;
      color: #f1f5f9;
      font-family: 'Inter', system-ui, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, .font-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    
    /* Modern Racing Card Glow & Hover */
    .paddock-card {
      background-color: #1A2120;
      border: 1px solid #242E2C;
      border-radius: 16px;
      transition: all 0.25s ease-out;
    }
    .paddock-card:hover {
      border-color: rgba(0, 230, 153, 0.5);
      box-shadow: 0 0 24px rgba(0, 230, 153, 0.08);
    }

    #mobileDrawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 18rem;
      max-width: 85vw;
      background-color: #0E1211;
      border-left: 1px solid #1E2A26;
      z-index: 60;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.8);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateX(100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.5rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    #mobileDrawer.open {
      transform: translateX(0) !important;
    }
    #mobileBackdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 55;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    #mobileBackdrop.open {
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #080C0A; }
    ::-webkit-scrollbar-thumb { background: #1E2A26; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #00E699; }
  </style>

  <!-- URL Clean Path Normalizer -->
  <script is:inline>
    if (window.location.pathname.endsWith('.html')) {
      var cleanPath = window.location.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
      window.history.replaceState(null, '', (cleanPath || '/') + window.location.search + window.location.hash);
    }
  </script>

  <!-- Structured SEO Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

  <!-- Core Scripts -->
  <script is:inline src="/assets/js/vpfix.js?v=m9"></script>
  <script is:inline set:html={`window.muntruFormato=${formatoAprox.toString()};window.muntruLocale=${localeDeIdioma.toString()};`}></script>
  <script is:inline src="/assets/js/i18n.js?v=t292"></script>
</head>
<body class="bg-[#080C0A] text-neutral-100 antialiased selection:bg-[#00E699] selection:text-neutral-950 font-sans min-h-screen flex flex-col justify-between relative max-w-full overflow-x-hidden">
  
  <!-- Subtle MoTeC Telemetry Waveform & Circuit Trace Background (3.5% opacity) -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden opacity-[0.035]" aria-hidden="true">
    <svg class="w-full h-full object-cover" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M120 400 C 180 280, 320 220, 500 240 C 650 260, 720 180, 850 160 C 980 140, 1150 220, 1260 340 C 1370 460, 1340 680, 1200 760 C 1050 840, 920 780, 800 800 C 680 820, 560 740, 420 720 C 260 700, 140 620, 100 520 Z" stroke="#00E699" stroke-width="1.5" stroke-dasharray="6 6" />
      <path d="M 0 350 Q 120 310, 240 370 T 480 320 T 720 400 T 960 300 T 1200 360 T 1440 310" stroke="#00E699" stroke-width="1.5" />
      <path d="M 0 550 Q 140 500, 280 580 T 560 520 T 840 610 T 1120 490 T 1440 560" stroke="#00E699" stroke-width="1.2" />
      <path d="M 0 750 Q 160 720, 320 770 T 640 710 T 960 780 T 1280 730 T 1440 760" stroke="#00E699" stroke-width="1" stroke-dasharray="4 8" />
    </svg>
  </div>

  {!hideNav && <Navbar currentPath={Astro.url.pathname} />}
  
  <main id="main-content" tabindex="-1" class="flex-grow relative z-10 max-w-full overflow-x-hidden">
    <div id="muntruNoticeStack" class="m-notice-stack" hidden></div>
    <slot />
  </main>

  {!hideFooter && <Footer />}
  <MuntrumeChatbot />

  <script is:inline src="/assets/js/notices.js?v=t272"></script>
  <script src="/assets/js/motion.js?v=t269" defer></script>
</body>
</html>
