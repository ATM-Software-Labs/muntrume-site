---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import MuntrumeChatbot from '../components/MuntrumeChatbot.astro';
import { PILOTOS } from '../lib/pilotos';
import { formatoAprox, localeDeIdioma } from '../lib/formato-licencia.js';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  ogLocale?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  schemaJson?: any;
  hideNav?: boolean;
  hideFooter?: boolean;
  noindex?: boolean;
}

const siteOrigin = Astro.site ? Astro.site.origin : (Astro.url ? Astro.url.origin : "https://muntru.me");

const {
  title = "Muntrume Motorsport (MMT) · Equipo iRacing",
  description = "Muntrume Motorsport (MMT) es el equipo de iRacing de Sant Andreu, Barcelona. Pilotos, telemetría y setups .sto.",
  keywords = "muntrume motorsport, official simracing team, iracing team, endurance sim racing, gt3 endurance, sim racing engineering, garage 61 telemetry, alberto trujillo, escuderia simracing, equipo iracing",
  canonical = Astro.url.href,
  ogImage = `${siteOrigin}/assets/img/og-home.jpg`,
  ogType = "website",
  ogLocale = "en_US",
  ogImageAlt = "Muntrume Motorsport",
  ogImageWidth,
  ogImageHeight,
  schemaJson = null,
  hideNav = false,
  hideFooter = false,
  noindex = false
} = Astro.props;

function absoluteCanonical(input: string): string {
  let u: URL;
  try { u = new URL(input, "https://muntru.me"); }
  catch { return "https://muntru.me/"; }
  const host = u.hostname;
  const internal = host === "muntru.me" || host === "www.muntru.me" || host === "localhost" || host === "127.0.0.1";
  if (!internal) return u.toString();
  u.protocol = "https:";
  u.hostname = "muntru.me";
  u.port = "";
  u.search = "";
  u.hash = "";
  if (u.pathname !== "/" && !u.pathname.endsWith("/") && !/\.[a-z0-9]+$/i.test(u.pathname)) {
    u.pathname += "/";
  }
  return u.toString();
}

const canon = absoluteCanonical(canonical);
const isHome = new URL(canon).pathname === "/";
const BRAND = "Muntrume Motorsport";
const HOME_TITLE = "Muntrume Motorsport (MMT) · Equipo iRacing";

function fitTitle(raw: string): string {
  if (isHome) return HOME_TITLE;
  let page = String(raw || BRAND)
    .replace(/\s*[|·]\s*Muntrume Motorsport(?:\s*\(MMT\))?.*$/i, "")
    .replace(/\s*[|·]\s*Sala de Prensa Muntrume.*$/i, "")
    .replace(/\s*[|·]\s*Escudería Profesional.*$/i, "")
    .trim();
  if (!page || /^muntrume motorsport$/i.test(page)) page = "Inicio";
  const suffix = ` · ${BRAND}`;
  const max = 60 - suffix.length;
  if (page.length > max) page = page.slice(0, Math.max(1, max - 1)).trimEnd() + "…";
  return page + suffix;
}

function fitDesc(raw: string): string {
  let d = String(raw || "").replace(/\s+/g, " ").trim();
  if (!d) d = "Muntrume Motorsport (MMT), equipo de iRacing en Sant Andreu, Barcelona.";
  if (!/\bMMT\b/.test(d)) {
    const extra = " Equipo MMT.";
    d = d.length + extra.length <= 155 ? d + extra : d.slice(0, 155 - extra.length).trimEnd() + extra;
  }
  if (d.length > 155) d = d.slice(0, 154).trimEnd() + "…";
  return d;
}

const seoTitle = fitTitle(title);
const seoDescription = fitDesc(description);
const brandedOg = /\/og-(home|setups|news|cover|about|contact|team)\.jpg(?:$|\?)/.test(ogImage);
const imageWidth = ogImageWidth ?? (brandedOg ? 1200 : undefined);
const imageHeight = ogImageHeight ?? (brandedOg ? 630 : undefined);

function hreflangSet(href: string) {
  const base = absoluteCanonical(href);
  const alt = (lang: string) => {
    const u = new URL(base);
    if (lang !== "en") u.searchParams.set("lang", lang);
    return u.toString();
  };
  return { en: alt("en"), es: alt("es"), ca: alt("ca"), fr: alt("fr") };
}
const langs = hreflangSet(canon);

const CRUMB_LABEL: Record<string, string> = {
  garage: "Garage",
  paddock: "Paddock",
  sala: "Sala de ingenieros",
  drivers: "Pilotos",
  pilotos: "Pilotos",
  d: "Pilotos",
  news: "Noticias",
  noticias: "Noticias",
  ai: "Copiloto",
  "setup-builder": "Setup Builder",
  communications: "Comunicación",
  cookies: "Cookies",
  privacidad: "Privacidad",
  "aviso-legal": "Aviso legal",
  legal: "Información legal",
  fuentes: "Fuentes",
  retirada: "Retirada",
  admin: "Admin",
  login: "Acceso",
  article: "Despacho",
  contact: "Contacto",
  about: "Paddock",
};

function breadcrumbList(href: string) {
  const path = new URL(href).pathname.split("/").filter(Boolean);
  const items: { name: string; item: string }[] = [{ name: BRAND, item: "https://muntru.me/" }];
  let acc = "https://muntru.me";
  path.forEach((part) => {
    acc += `/${part}`;
    const pilot = PILOTOS.find((p) => p.slug === part);
    const name = pilot?.fullName || CRUMB_LABEL[part] || decodeURIComponent(part).replace(/-/g, " ");
    items.push({ name, item: `${acc}/` });
  });
  return {
    "@type": "BreadcrumbList",
    "@id": `${href}#breadcrumb`,
    itemListElement: items.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: entry.name,
      item: entry.item,
    })),
  };
}

const defaultSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsTeam",
      "@id": `${siteOrigin}/#org`,
      "name": "Muntrume Motorsport",
      "alternateName": ["MMT", "Muntrume", "MMT Motorsport"],
      "url": `${siteOrigin}/`,
      "sport": "Sim Racing (iRacing)",
      "description": `Muntrume Motorsport (MMT), equipo de iRacing en Sant Andreu, Barcelona. ${PILOTOS.length} pilotos oficiales y setups .sto en el Garage.`,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteOrigin}/assets/img/icon-512.png`,
        "width": 512,
        "height": 512
      },
      "image": `${siteOrigin}/assets/img/og-home.jpg`,
      "location": {
        "@type": "Place",
        "name": "Muntrume Motorsport HQ",
        "address": {
          "type": "PostalAddress",
          "addressLocality": "Sant Andreu, Barcelona",
          "addressRegion": "Catalonia",
          "addressCountry": "ES"
        }
      },
      "founder": {
        "@type": "Person",
        "name": "Alberto Trujillo",
        "url": `${siteOrigin}/d/albertot/`
      },
      "member": PILOTOS.map((p) => ({
        "@type": "Person",
        "name": p.fullName,
        "jobTitle": p.role,
        "url": `${siteOrigin}/d/${p.slug}/`
      })),
      "knowsAbout": [
        "iRacing",
        "Sim Racing",
        "iRacing Setups",
        "Sports Car",
        "GT3 Endurance",
        "GT4 Endurance",
        "Multiclass Endurance",
        "Motorsport Engineering"
      ],
      "sameAs": [
        "https://discord.gg/ehX6B8JUtE",
        "https://garage61.net/app/teams/muntrume-motorsport"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "name": "Muntrume Motorsport",
      "alternateName": ["MMT", "Muntrume", "MMT Motorsport"],
      "url": "https://muntru.me/",
      "inLanguage": ["en-US", "es-ES", "ca-ES", "fr-FR"],
      "publisher": {
        "@id": "https://muntru.me/#org"
      }
    }
  ]
};

function graphOf(schema: any): any[] {
  if (!schema) return [];
  if (Array.isArray(schema)) return schema;
  if (Array.isArray(schema["@graph"])) return schema["@graph"];
  return [schema];
}

const homeGraph = isHome && !schemaJson ? defaultSchema["@graph"] : graphOf(schemaJson);
const baseGraph = homeGraph.length ? homeGraph : [{
  "@type": "WebPage",
  "@id": `${canon}#webpage`,
  "url": canon,
  "name": seoTitle,
  "description": seoDescription,
  "isPartOf": { "@id": "https://muntru.me/#website" },
  "about": { "@id": "https://muntru.me/#org" },
}];
const hasCrumbs = baseGraph.some((node) => {
  const kind = node?.["@type"];
  return kind === "BreadcrumbList" || (Array.isArray(kind) && kind.includes("BreadcrumbList"));
});
const finalSchema = {
  "@context": "https://schema.org",
  "@graph": hasCrumbs ? baseGraph : [...baseGraph, breadcrumbList(canon)],
};
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth max-w-full overflow-x-hidden" data-theme="dark">
<head>
  <script is:inline>
    (function() {
      try {
        var t = localStorage.getItem('muntrume_theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        if (t === 'light') {
          document.documentElement.classList.add('light');
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; img-src 'self' data: https:; frame-src 'self' https://discord.com https://*.discord.com; connect-src 'self' https://muntrume.atrumin16.workers.dev wss://muntrume.atrumin16.workers.dev https://ai.trujillomingorance.com https://api.garage61.net https://api.brevo.com https://api.github.com;" />
  <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()" />
  
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Muntrume Motorsport · Alberto Trujillo Mingorance" />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
  <link rel="canonical" href={canon} />
  <link rel="alternate" hreflang="en" href={langs.en} />
  <link rel="alternate" hreflang="es" href={langs.es} />
  <link rel="alternate" hreflang="ca" href={langs.ca} />
  <link rel="alternate" hreflang="fr" href={langs.fr} />
  <link rel="alternate" hreflang="x-default" href={langs.en} />

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={canon} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
  {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
  <meta property="og:site_name" content="Muntrume Motorsport" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content="es_ES" />
  <meta property="og:locale:alternate" content="ca_ES" />
  <meta property="og:locale:alternate" content="fr_FR" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@muntrumemrt" />
  <meta name="twitter:creator" content="@atrumin16" />
  <meta name="twitter:title" content={seoTitle} />
  <meta name="twitter:description" content={seoDescription} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Favicons and Webmanifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/img/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="msapplication-TileColor" content="#080C0A" />
  <meta name="theme-color" content="#080C0A" />

  <!-- Fonts: self-hosted (latin + latin-ext, font-display: swap) — sin terceros ni CSS bloqueante externo -->
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/SpaceGrotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/BarlowCondensed-800-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/fonts/fonts.css?v=t264" />
  <slot name="head" />

  <link rel="stylesheet" href="/assets/css/tailwind.min.css?v=t310" />
  <link rel="stylesheet" href="/assets/css/mobile.css?v=t310" />
  <link rel="stylesheet" href="/assets/css/racing.css?v=t312" />

  <!-- Core Dark Racing System CSS -->
  <style is:global>
    :root {
      color-scheme: dark;
      --bg-paddock: #0A0D0C;
      --surface-card: #141A19;
      --border-card: #1F2926;
      --accent-paddock: #00E699;
      --text-muted: #9AA8A3;
    }
    html.light, html[data-theme="light"] {
      color-scheme: light;
      --bg-paddock: #F4F5F3;
      --surface-card: #FFFFFF;
      --border-card: #D9DEDB;
      --accent-paddock: #007A50;
      --text-muted: #4A5652;
    }
    body {
      background-color: var(--r-bg, #0A0D0C);
      color: var(--r-text, #F2F5F4);
      font-family: 'Inter', system-ui, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, .font-display {
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    
    /* Modern Racing Card Glow & Hover */
    .paddock-card {
      background-color: var(--r-surface, #1A2120);
      border: 1px solid var(--r-line, #242E2C);
      border-radius: 16px;
      transition: all 0.25s ease-out;
    }
    .paddock-card:hover {
      border-color: var(--r-accent, rgba(0, 230, 153, 0.5));
      box-shadow: 0 0 24px rgba(0, 230, 153, 0.08);
    }

    #mobileDrawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 18rem;
      max-width: 85vw;
      background-color: var(--r-surface, #0E1211);
      border-left: 1px solid var(--r-line, #1E2A26);
      z-index: 60;
      box-shadow: -10px 0 30px rgba(0, 0, 0, 0.8);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      transform: translateX(100%);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.5rem;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    #mobileDrawer.open {
      transform: translateX(0) !important;
    }
    #mobileBackdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 55;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    #mobileBackdrop.open {
      opacity: 1 !important;
      pointer-events: auto !important;
    }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--r-bg, #080C0A); }
    ::-webkit-scrollbar-thumb { background: var(--r-line-2, #1E2A26); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--r-accent, #00E699); }
    html { scrollbar-color: var(--r-line-2, #1E2A26) var(--r-bg, #080C0A); }
  </style>

  <!-- URL Clean Path Normalizer -->
  <script is:inline>
    if (window.location.pathname.endsWith('.html')) {
      var cleanPath = window.location.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
      window.history.replaceState(null, '', (cleanPath || '/') + window.location.search + window.location.hash);
    }
  </script>

  <!-- Structured SEO Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

  <!-- Core Scripts -->
  <script is:inline src="/assets/js/vpfix.js?v=m9"></script>
  <script is:inline set:html={`window.muntruFormato=${formatoAprox.toString()};window.muntruLocale=${localeDeIdioma.toString()};`}></script>
  <script is:inline src="/assets/js/i18n.js?v=t292"></script>
</head>
<body class="bg-[var(--r-bg)] text-[var(--r-text)] antialiased selection:bg-[var(--r-accent)] selection:text-[var(--r-accent-ink)] font-sans min-h-screen flex flex-col justify-between relative max-w-full overflow-x-hidden">
  
  <!-- Subtle MoTeC Telemetry Waveform & Circuit Trace Background (3.5% opacity) -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden opacity-[0.035]" aria-hidden="true">
    <svg class="w-full h-full object-cover" viewBox="0 0 1440 900" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M120 400 C 180 280, 320 220, 500 240 C 650 260, 720 180, 850 160 C 980 140, 1150 220, 1260 340 C 1370 460, 1340 680, 1200 760 C 1050 840, 920 780, 800 800 C 680 820, 560 740, 420 720 C 260 700, 140 620, 100 520 Z" stroke="#00E699" stroke-width="1.5" stroke-dasharray="6 6" />
      <path d="M 0 350 Q 120 310, 240 370 T 480 320 T 720 400 T 960 300 T 1200 360 T 1440 310" stroke="#00E699" stroke-width="1.5" />
      <path d="M 0 550 Q 140 500, 280 580 T 560 520 T 840 610 T 1120 490 T 1440 560" stroke="#00E699" stroke-width="1.2" />
      <path d="M 0 750 Q 160 720, 320 770 T 640 710 T 960 780 T 1280 730 T 1440 760" stroke="#00E699" stroke-width="1" stroke-dasharray="4 8" />
    </svg>
  </div>

  {!hideNav && <Navbar currentPath={Astro.url.pathname} />}
  
  <main id="main-content" tabindex="-1" class="flex-grow relative z-10 max-w-full overflow-x-hidden">
    <div id="muntruNoticeStack" class="m-notice-stack" hidden></div>
    <slot />
  </main>

  {!hideFooter && <Footer />}
  <MuntrumeChatbot />

  <script is:inline src="/assets/js/notices.js?v=t272"></script>
  <script src="/assets/js/motion.js?v=t269" defer></script>
</body>
</html>
