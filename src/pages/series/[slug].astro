---
import Layout from "../../layouts/Layout.astro";
import schedule from "../../../desktop/src/season_schedule_2026_s4.json";
import { CAR_CATALOG_LIST } from "../../../desktop/src/cars/catalog";
import { getSeriesLogoEntry } from "../../lib/car-series";

interface ScheduleWeek {
  week_num: number;
  start_date?: string;
  track_name: string;
}

interface ScheduleSeries {
  id: string;
  name: string;
  category: string;
  tier: string;
  license: string;
  cars?: string[];
  weeks?: ScheduleWeek[];
}

export function getStaticPaths() {
  const allSeries = (schedule as { series?: ScheduleSeries[] }).series ?? [];
  return allSeries.map((sr) => ({
    params: { slug: sr.id },
    props: { series: sr },
  }));
}

interface Props {
  series: ScheduleSeries;
}

const { series } = Astro.props;
const cleanName = series.name.replace(/\s*-\s*2026 Season \d+$/i, "").trim();
const { logo, officialSlug } = getSeriesLogoEntry(series.name);
const heroLogo = logo || "/assets/img/series/gt-sprint.jpg";
const officialIracingUrl = officialSlug ? `https://www.iracing.com/series/${officialSlug}/` : "https://www.iracing.com/series/";

const SEASON_START_MS = Date.UTC(2026, 8, 15);
const currentWeek = Math.max(1, Math.min(12, Math.floor((Date.now() - SEASON_START_MS) / 604_800_000) + 1));

const TIER_COLORS: Record<string, string> = {
  RClass: "#ef4444",
  DClass: "#f97316",
  CClass: "#eab308",
  BClass: "#22c55e",
  AClass: "#3b82f6",
};
const tierColor = TIER_COLORS[series.tier] || "#10b981";

const normCar = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, "");
const carLinks = (series.cars ?? []).map((carName) => {
  const nc = normCar(carName);
  const hit = CAR_CATALOG_LIST.find((c) => {
    const full = normCar(`${c.brand} ${c.model}`);
    const model = normCar(c.model);
    return full === nc || nc.includes(full) || (model.length >= 6 && nc.includes(model));
  });
  return {
    name: carName,
    href: hit ? `/car/${hit.carFolder}/` : null,
  };
});

const weeks = series.weeks ?? [];
const activeWeek = weeks.find((w) => w.week_num === currentWeek);

const pageTitle = `${cleanName} · iRacing 2026 S4 | Muntrume Motorsport`;
const pageDescription = `Calendario de 12 semanas, coches elegibles, licencia ${series.license} y setups .STO para ${cleanName} en iRacing 2026 Season 4.`;
const canonical = `https://muntru.me/series/${series.id}/`;
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="r-section sd-page" aria-labelledby="sdTitle">
    <div class="r-wrap">
      <nav class="sd-crumb" aria-label="Ruta">
        <a href="/series/">← Series Oficiales</a>
        <span>/</span>
        <span>{series.category}</span>
      </nav>

      <header class="sd-hero">
        <div class="sd-hero__logo">
          <img src={heroLogo} alt={cleanName} loading="eager" decoding="async" />
        </div>
        <div class="sd-hero__info">
          <div class="sd-badges">
            <span class="sd-badge" style={`border-color:${tierColor}66;color:${tierColor};background:${tierColor}1a`}>{series.license}</span>
            <span class="sd-badge sd-badge--muted">{series.category}</span>
            {activeWeek && <span class="sd-badge sd-badge--live">W{String(currentWeek).padStart(2, "0")}: {activeWeek.track_name}</span>}
          </div>
          <h1 id="sdTitle" class="r-h1">{cleanName}</h1>
          <p class="sd-sub">
            Temporada 2026 Season 4 · {weeks.length} semanas oficiales · {carLinks.length} {carLinks.length === 1 ? "coche elegible" : "coches elegibles"}.
          </p>
          <div class="sd-actions">
            <a href="/garage/" class="sd-btn sd-btn--primary">Ver Setups (.sto) →</a>
            <a href={`/calendar/?q=${encodeURIComponent(cleanName)}`} class="sd-btn">Abrir en Calendario</a>
            <a href={officialIracingUrl} target="_blank" rel="noreferrer noopener" class="sd-btn">Página oficial iRacing ↗</a>
          </div>
        </div>
      </header>

      <div class="sd-layout">
        <section class="sd-panel">
          <h2 class="sd-h2">Calendario Completo ({weeks.length} semanas)</h2>
          <div class="sd-weeks">
            {weeks.map((w) => {
              const isNow = w.week_num === currentWeek;
              return (
                <div class={`sd-week ${isNow ? "is-now" : ""}`}>
                  <span class="sd-week__num">W{String(w.week_num).padStart(2, "0")}</span>
                  <div class="sd-week__track">
                    <strong>{w.track_name}</strong>
                    {w.start_date && <small>{w.start_date}</small>}
                  </div>
                  {isNow && <span class="sd-week__now">ACTUAL</span>}
                </div>
              );
            })}
          </div>
        </section>

        <aside class="sd-panel">
          <h2 class="sd-h2">Coches Elegibles ({carLinks.length})</h2>
          <div class="sd-cars">
            {carLinks.map((c) =>
              c.href ? (
                <a href={c.href} class="sd-car sd-car--link">
                  <span>{c.name}</span>
                  <span>Ficha →</span>
                </a>
              ) : (
                <div class="sd-car">
                  <span>{c.name}</span>
                </div>
              )
            )}
          </div>
        </aside>
      </div>
    </div>
  </section>

  <style>
    .sd-crumb {
      display: flex;
      gap: 0.5rem;
      font-family: var(--font-mono, monospace);
      font-size: 0.78rem;
      color: #94a3b8;
      margin-bottom: 1.1rem;
    }
    .sd-crumb a { color: #34d399; text-decoration: none; }
    .sd-hero {
      display: grid;
      grid-template-columns: minmax(220px, 320px) 1fr;
      gap: 1.5rem;
      padding: 1.35rem;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(15, 23, 42, 0.7);
      align-items: center;
      margin-bottom: 1.75rem;
    }
    @media (max-width: 760px) { .sd-hero { grid-template-columns: 1fr; } }
    .sd-hero__logo {
      border-radius: 0.75rem;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: #020617;
      aspect-ratio: 16 / 9;
    }
    .sd-hero__logo img { width: 100%; height: 100%; object-fit: cover; }
    .sd-badges { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 0.6rem; }
    .sd-badge {
      font-family: var(--font-mono, monospace);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .sd-badge--muted { color: #cbd5e1; background: rgba(255, 255, 255, 0.06); }
    .sd-badge--live { color: #34d399; border-color: rgba(16, 185, 129, 0.45); background: rgba(16, 185, 129, 0.14); }
    .sd-sub { margin: 0.45rem 0 1rem; color: #94a3b8; font-size: 0.9rem; }
    .sd-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .sd-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.55rem 0.95rem;
      border-radius: 0.6rem;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.04);
      color: #e2e8f0;
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
    }
    .sd-btn--primary { background: #10b981; border-color: #10b981; color: #052e16; }
    .sd-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 1.25rem; }
    @media (max-width: 860px) { .sd-layout { grid-template-columns: 1fr; } }
    .sd-panel {
      padding: 1.2rem;
      border-radius: 0.9rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(15, 23, 42, 0.6);
    }
    .sd-h2 { margin: 0 0 0.9rem; font-size: 1.05rem; font-weight: 800; }
    .sd-weeks { display: grid; gap: 0.5rem; }
    .sd-week {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      padding: 0.6rem 0.75rem;
      border-radius: 0.6rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(2, 6, 23, 0.5);
    }
    .sd-week.is-now {
      border-color: rgba(16, 185, 129, 0.55);
      background: rgba(16, 185, 129, 0.1);
    }
    .sd-week__num {
      font-family: var(--font-mono, monospace);
      font-size: 0.78rem;
      font-weight: 800;
      color: #34d399;
      min-width: 2.3rem;
    }
    .sd-week__track { flex: 1; min-width: 0; }
    .sd-week__track strong { display: block; font-size: 0.86rem; }
    .sd-week__track small { color: #94a3b8; font-size: 0.74rem; }
    .sd-week__now {
      font-family: var(--font-mono, monospace);
      font-size: 0.66rem;
      font-weight: 800;
      padding: 0.15rem 0.45rem;
      border-radius: 999px;
      background: #10b981;
      color: #052e16;
    }
    .sd-cars { display: grid; gap: 0.45rem; }
    .sd-car {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.55rem 0.75rem;
      border-radius: 0.55rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(2, 6, 23, 0.45);
      font-size: 0.82rem;
      color: #e2e8f0;
      text-decoration: none;
    }
    .sd-car--link:hover { border-color: rgba(16, 185, 129, 0.5); color: #34d399; }
  </style>
</Layout>
