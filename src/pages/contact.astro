---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Contact · Muntrume Motorsport";
const pageDescription = "Contact Muntrume Motorsport - Sim racing team from Sant Andreu, Barcelona. Driver applications, setup vault questions, press and general inquiries.";
---

<Layout title={pageTitle} description={pageDescription}>
<!-- ========================================================================= -->
  <!-- 2. HERO: COMMUNICATIONS & HEADQUARTERS                                    -->
  <!-- ========================================================================= -->
  <section class="pt-28 pb-12 bg-[#0e1217] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center py-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#161c24] border border-white/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <span>Contact</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-4">
          GET IN <span class="text-emerald-400">TOUCH</span>
        </h1>
        <p class="text-base text-neutral-400 max-w-2xl mx-auto leading-relaxed">
          Driver applications, questions about the setup vault, press or anything else: send us a message and we will reply by email.
        </p>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-8">
        
        <div class="bg-[#161c24] border border-white/10 rounded-2xl p-5 shadow-md">
          <div class="text-xs text-neutral-400 uppercase font-semibold">Email</div>
          <a href="mailto:info@muntru.me" class="text-sm font-bold text-white mt-1 block truncate hover:text-emerald-400">info@muntru.me</a>
        </div>

        <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="bg-[#161c24] border border-white/10 hover:border-white/20 rounded-2xl p-5 shadow-md transition group block">
          <div class="text-xs text-neutral-400 uppercase font-semibold">Discord</div>
          <div class="text-sm font-bold text-white mt-1 group-hover:text-emerald-400 transition">discord.gg/ehX6B8JUtE</div>
        </a>

        <div class="bg-[#161c24] border border-white/10 rounded-2xl p-5 shadow-md">
          <div class="text-xs text-neutral-400 uppercase font-semibold">Based in</div>
          <div class="text-sm font-bold text-white mt-1">Sant Andreu, Barcelona</div>
          <div class="text-[11px] text-neutral-400 mt-1">Catalonia · CET</div>
        </div>


      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. CONTACT FORM & FAQ SECTION                                             -->
  <!-- ========================================================================= -->
  <section id="contact-form" class="py-16 bg-[#0e1217]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- FORM COLUMN (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          
          <div class="bg-[#161c24] border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl">
            
            <div class="pb-6 mb-6 border-b border-white/10">
              <h2 class="text-xl font-bold text-white tracking-tight">
                Send us a message
              </h2>
              <p class="text-xs text-neutral-400 mt-1">Your message goes straight to the team inbox. We reply by email.</p>
            </div>

            <form id="contactForm" class="space-y-5 text-xs" novalidate>
              <!-- Honeypot: humans never see or fill this -->
              <div aria-hidden="true" style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;">
                <label for="website">Leave this field empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
              </div>
              
              <!-- Name & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-neutral-400 mb-1.5 font-semibold uppercase tracking-wider text-[11px]">Your Name *</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" required minlength="2" maxlength="100" autocomplete="name" 
                    placeholder="e.g. Alex Garcia"
                    class="w-full bg-[#0e1217] border border-white/10 rounded-xl px-4 py-3 text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500 transition text-sm"
                  >
                </div>

                <div>
                  <label for="email" class="block text-neutral-400 mb-1.5 font-semibold uppercase tracking-wider text-[11px]">Email Address *</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" required maxlength="254" autocomplete="email" 
                    placeholder="e.g. alex@domain.com"
                    class="w-full bg-[#0e1217] border border-white/10 rounded-xl px-4 py-3 text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500 transition text-sm"
                  >
                </div>
              </div>

              <!-- Inquiry Type & Subject -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="type" class="block text-neutral-400 mb-1.5 font-semibold uppercase tracking-wider text-[11px]">Inquiry Type *</label>
                  <select 
                    id="type" 
                    name="type"
                    class="w-full bg-[#0e1217] border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500 transition text-sm"
                  >
                    <option value="driver_application">Driver Tryout &amp; Recruitment</option>
                    <option value="sponsorship">Sponsorship &amp; Partnerships</option>
                    <option value="media">Media &amp; Press Inquiries</option>
                    <option value="telemetry_engineering">Setups &amp; Engineering</option>
                    <option value="general">General Support &amp; Community</option>
                  </select>
                </div>

                <div>
                  <label for="subject" class="block text-neutral-400 mb-1.5 font-semibold uppercase tracking-wider text-[11px]">Subject *</label>
                  <input 
                    type="text" 
                    id="subject" 
                    name="subject" required minlength="3" maxlength="150" 
                    placeholder="e.g. Driver application"
                    class="w-full bg-[#0e1217] border border-white/10 rounded-xl px-4 py-3 text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500 transition text-sm"
                  >
                </div>
              </div>

              <!-- Message Body -->
              <div>
                <label for="message" class="block text-neutral-400 mb-1.5 font-semibold uppercase tracking-wider text-[11px]">Message Content (Include iRating &amp; Experience if applying) *</label>
                <textarea 
                  id="message" 
                  name="message"
                  rows="6" 
                  required minlength="20" maxlength="5000" 
                  placeholder="Tell us about your inquiry or your sim racing experience..."
                  class="w-full bg-[#0e1217] border border-white/10 rounded-xl p-4 text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500 transition leading-relaxed resize-y text-sm"
                ></textarea>
              </div>

              <!-- Submit Button & Feedback Status -->
              <div class="pt-2">
                <button 
                  type="submit" 
                  id="submitBtn" 
                  class="w-full sm:w-auto px-8 py-3.5 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-sm rounded-xl transition shadow-md hover:shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span id="submitText">Send message &rarr;</span>
                </button>
              </div>

              <div id="formFeedback" class="hidden p-5 rounded-2xl text-xs" role="status" aria-live="polite"></div>

              <p class="text-[11px] text-neutral-400">Prefer your own email app? Write to us directly at <a id="directMail" class="underline text-neutral-300 hover:text-white" href="mailto:info@muntru.me">info@muntru.me</a> or reach us on <a class="underline text-neutral-300 hover:text-white" href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer">Discord</a>.</p>

            </form>

          </div>

        </div>

        <!-- FAQ COLUMN (5 Cols) -->
        <div class="lg:col-span-5 space-y-4">
          
          <div class="pb-2 mb-2">
            <h3 class="text-sm font-bold tracking-wider uppercase text-white">Frequently Asked Questions</h3>
          </div>

          <!-- FAQ Item 1 -->
          <div class="faq-card bg-[#161c24] border border-white/10 rounded-2xl overflow-hidden transition-colors shadow-sm">
            <button class="w-full text-left p-5 font-bold text-sm text-white flex items-center justify-between gap-3 focus:outline-none" onclick="toggleFaq(this)">
              <span>How can I join Muntrume Motorsport as a driver?</span>
              <span class="faq-icon text-emerald-400 text-base transition-transform font-bold">+</span>
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 px-5 pb-0 text-neutral-400 text-xs leading-relaxed">
              <p class="pb-5">Send us a message with the form above (choose "Driver Tryout &amp; Recruitment") or say hello on our Discord.</p>
            </div>
          </div>

          <!-- FAQ Item 5 -->
          <div class="faq-card bg-[#161c24] border border-white/10 rounded-2xl overflow-hidden transition-colors shadow-sm">
            <button class="w-full text-left p-5 font-bold text-sm text-white flex items-center justify-between gap-3 focus:outline-none" onclick="toggleFaq(this)">
              <span>What is the fastest way to get in touch?</span>
              <span class="faq-icon text-emerald-400 text-base transition-transform font-bold">+</span>
            </button>
            <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 px-5 pb-0 text-neutral-400 text-xs leading-relaxed">
              <p class="pb-5">Discord is usually the quickest. For anything that needs a written reply, use the form or email info@muntru.me.</p>
            </div>
          </div>

          <!-- Direct Discord Widget Callout -->
          <div class="pt-4">
            <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="block p-5 rounded-2xl bg-[#161c24] border border-white/10 hover:border-white/20 transition text-center group shadow-lg">
              <div class="text-xs font-bold text-white group-hover:text-emerald-400 transition mb-1">
                Prefer chat?
              </div>
              <div class="text-xs text-neutral-400">Join our Discord &rarr;</div>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 5. FOOTER (Unified Motorsport Master Footer)                              -->
  <!-- ========================================================================= -->

<!-- ========================================================================= -->
  <!-- JAVASCRIPT: Form Controller & FAQ Accordion Engine                        -->
  <!-- ========================================================================= -->
  <script is:inline>
    // 1. Mobile Drawer Controller
    function toggleNavDrawer() {
      const drawer = document.getElementById('mobileDrawer');
      const backdrop = document.getElementById('mobileBackdrop');
      if (!drawer || !backdrop) return;
      const isOpen = drawer.classList.contains('open');
      if (isOpen) {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
      } else {
        drawer.classList.add('open');
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    // 2. FAQ Accordion Toggle
    function toggleFaq(btn) {
      const card = btn.closest('.faq-card');
      const answer = card.querySelector('.faq-answer');
      const icon = card.querySelector('.faq-icon');
      const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

      // Close all FAQs
      document.querySelectorAll('.faq-card').forEach(c => {
        const a = c.querySelector('.faq-answer');
        const i = c.querySelector('.faq-icon');
        if (a) a.style.maxHeight = '0px';
        if (i) i.textContent = '+';
        c.classList.remove('border-emerald-500/40');
      });

      if (!isOpen) {
        answer.style.maxHeight = answer.scrollHeight + 'px';
        icon.textContent = '−';
        card.classList.add('border-emerald-500/40');
      }
    }

    // 3. Contact Form Submission → Worker /api/contact (sends via Resend; "sent" only when the Worker confirms)
    (() => {
      const API = 'https://muntrume.atrumin16.workers.dev/api/contact';
      const form = document.getElementById('contactForm');
      const btn = document.getElementById('submitBtn');
      const btnText = document.getElementById('submitText');
      const feedback = document.getElementById('formFeedback');
      const val = (id) => document.getElementById(id).value.trim();
      let token = null;

      async function getToken() {
        try {
          const r = await fetch(API + '/token', { cache: 'no-store' });
          const d = await r.json();
          token = d && d.success ? d.token : null;
        } catch (_) { token = null; }
        return token;
      }
      getToken();

      function mailtoLink() {
        const body = `${val('message')}\n\n— ${val('name')} <${val('email')}>`;
        return `mailto:info@muntru.me?subject=${encodeURIComponent(val('subject') || 'Contact from muntru.me')}&body=${encodeURIComponent(body)}`;
      }
      const ICON_OK = '<svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>';
      const ICON_ERR = '<svg class="w-4 h-4 text-rose-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v4m0 4h.01M10.3 3.9L1.8 18a2 2 0 001.7 3h17a2 2 0 001.7-3L13.7 3.9a2 2 0 00-3.4 0z"/></svg>';
      function show(kind, title, html) {
        feedback.className = 'p-5 rounded-2xl text-xs ' + (kind === 'ok'
          ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-200'
          : 'bg-rose-500/10 border border-rose-500/30 text-rose-200');
        feedback.innerHTML = `<div class="flex items-center gap-2 font-bold text-white mb-1">${kind === 'ok' ? ICON_OK : ICON_ERR}<span>${escapeHtml(title)}</span></div><div>${html}</div>`;
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function busy(on) {
        btn.disabled = on;
        btn.style.opacity = on ? '0.6' : '';
        btn.style.cursor = on ? 'wait' : '';
        btnText.textContent = on ? 'Sending…' : 'Send message →';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const checks = [
          ['name', val('name').length >= 2, 'Please enter your name.'],
          ['email', /^[^\s@<>"']+@[^\s@<>"']+\.[a-z]{2,}$/i.test(val('email')), 'Please enter a valid email address.'],
          ['subject', val('subject').length >= 3, 'Please add a short subject.'],
          ['message', val('message').length >= 20, 'Your message is too short (20+ characters).'],
        ];
        const bad = checks.find(c => !c[1]);
        if (bad) {
          const el = document.getElementById(bad[0]);
          el.setAttribute('aria-invalid', 'true'); el.focus();
          show('err', 'Check the form', escapeHtml(bad[2]));
          return;
        }
        checks.forEach(c => document.getElementById(c[0]).removeAttribute('aria-invalid'));
        busy(true);
        try {
          if (!token) await getToken();
          const r = await fetch(API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: val('name'), email: val('email'), type: document.getElementById('type').value,
              subject: val('subject'), message: val('message'), website: document.getElementById('website').value, token })
          });
          const d = await r.json().catch(() => ({}));
          if (r.ok && d.success && d.id) {
            show('ok', `Message sent, ${val('name').split(/\s+/)[0]}!`,
              `Race Control has it in the team inbox. We'll reply to <span class="text-white">${escapeHtml(val('email'))}</span>.`);
            form.reset();
            getToken();
            return;
          }
          if (d.reload) await getToken();
          const tip = r.status < 429 ? '' : ` You can also <a class="underline text-white" href="${mailtoLink()}">email us directly</a>.`;
          show('err', 'Your message was not sent', escapeHtml(d.error || 'Something went wrong. Please try again.') + tip);
        } catch (_) {
          show('err', 'Your message was not sent', `We could not reach our server. Please <a class="underline text-white" href="${mailtoLink()}">email us directly</a> or try again in a moment.`);
        } finally {
          busy(false);
        }
      });
    })();

    function escapeHtml(t) {
      const d = document.createElement('div');
      d.textContent = t;
      return d.innerHTML;
    }
  </script>
</Layout>
