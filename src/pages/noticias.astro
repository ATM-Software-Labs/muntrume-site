              </div>
              <h4 class="text-2xl font-bold text-[var(--r-text)] mb-1" data-i18n="news.trivia.done">Resultado</h4>
              <p class="text-sm text-[var(--r-text)] mb-6"><span data-i18n="news.trivia.final">Puntuación final:</span> <span id="triviaFinalScore" class="text-[var(--r-accent)] font-bold">0</span> / 9</p>
              <button onclick="initTrivia()" class="px-5 py-2.5 bg-[var(--r-accent)] hover:opacity-90 text-[var(--r-accent-ink)] font-bold text-xs rounded-xl transition">
                <span data-i18n="news.trivia.restart">Jugar otra vez</span>
              </button>
            </div>
          </div>

          <!-- GAME 3: F1 LIGHTS REACTION TEST -->
          <div id="game-reaction" class="game-panel hidden text-center">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-[var(--r-line)] text-left">
              <div>
                <h3 class="text-lg font-bold text-[var(--r-text)]" data-i18n="news.react.title">Reacción al semáforo de salida</h3>
                <p class="text-xs text-[var(--r-muted)] mt-0.5" data-i18n="news.react.lead">Espera a las 5 luces rojas. Cuando se apaguen, haz clic lo más rápido que puedas.</p>
              </div>
              <div class="text-right">
                <div class="text-xl font-bold text-[var(--r-accent)]" id="reaction-best">—</div>
                <div class="text-[10px] text-[var(--r-muted)] uppercase font-semibold" data-i18n="news.react.best">Mejor (ms)</div>
              </div>
            </div>

            <div class="py-8 max-w-xl mx-auto">
              <div class="flex justify-center gap-3 sm:gap-4 mb-8 flex-wrap">
                <div class="f1-light" id="light1"></div>
                <div class="f1-light" id="light2"></div>
                <div class="f1-light" id="light3"></div>
                <div class="f1-light" id="light4"></div>
                <div class="f1-light" id="light5"></div>
