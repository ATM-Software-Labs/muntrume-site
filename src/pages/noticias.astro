                class="px-8 py-3.5 bg-[var(--r-accent)] hover:opacity-90 text-[var(--r-accent-ink)] font-extrabold text-sm rounded-xl transition shadow-md active:scale-95"
              >
                <span data-i18n="news.react.start">Iniciar</span>
              </button>
            </div>
          </div>

          <!-- GAME 4: CIRCUIT MEMORY MATCH -->
          <div id="game-memory" class="game-panel hidden">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-[var(--r-line)]">
              <div>
                <h3 class="text-lg font-bold text-[var(--r-text)]" data-i18n="news.mem.title">Parejas de circuitos</h3>
                <p class="text-xs text-[var(--r-muted)] mt-0.5" data-i18n="news.mem.lead">Encuentra los circuitos que hacen pareja.</p>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <div class="text-xl font-bold text-[var(--r-accent)]" id="memory-moves">0</div>
                  <div class="text-[10px] text-[var(--r-muted)] uppercase font-semibold" data-i18n="news.mem.moves">Movimientos</div>
                </div>
                <div class="text-right">
                  <div class="text-xl font-bold text-[var(--r-text)]" id="memory-pairs">0/8</div>
                  <div class="text-[10px] text-[var(--r-muted)] uppercase font-semibold" data-i18n="news.mem.pairs">Parejas</div>
                </div>
                <button onclick="initMemory()" class="px-3.5 py-1.5 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-[var(--r-accent)] text-xs text-[var(--r-text)] transition font-medium">
                  <span data-i18n="news.mem.reset">Reiniciar</span>
                </button>
              </div>
            </div>

            <div id="memoryGrid" class="grid grid-cols-4 gap-3 max-w-md sm:max-w-xl mx-auto"></div>
            
            <div id="memoryWin" class="hidden text-center py-8">
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-[var(--r-accent)] mx-auto mb-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              </div>
              <h4 class="text-xl font-bold text-[var(--r-text)] mb-1" data-i18n="news.mem.win">Todos los circuitos encontrados</h4>
              <p class="text-xs text-[var(--r-text)] mb-4"><span data-i18n="news.mem.done">Completado en</span> <span id="memoryFinalMoves" class="text-[var(--r-accent)] font-bold">0</span> <span data-i18n="news.mem.movesWord">movimientos.</span></p>
              <button onclick="initMemory()" class="px-5 py-2.5 bg-[var(--r-accent)] hover:opacity-90 text-[var(--r-accent-ink)] font-bold text-xs rounded-xl transition">
