                <div id="wordList" class="grid grid-cols-2 gap-2"></div>
                <div id="wsWinMessage" class="hidden mt-4 p-3 bg-emerald-500/10 border border-emerald-500/30 text-[var(--r-accent)] rounded-xl text-center font-bold text-xs flex items-center justify-center gap-2">
                  <svg class="w-4 h-4 text-[var(--r-accent)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
