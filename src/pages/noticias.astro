  <!-- ========================================================================= -->
  <!-- 7. STYLES: Filter Buttons, Loading Shimmer & Mini-Games                   -->
  <!-- ========================================================================= -->
  <style is:global>
    /* Ticker text scroll animation */
    @keyframes scrollTicker {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .scrolling-ticker {
      display: inline-block;
      white-space: nowrap;
      animation: scrollTicker 40s linear infinite;
    }
    .scrolling-ticker:hover {
      animation-play-state: paused;
    }

    /* Filter Buttons */
    .filter-btn {
      padding: 0.45rem 1rem;
      border: 1px solid var(--r-line);
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--r-muted);
      background: var(--r-surface);
      transition: all 0.2s ease;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .filter-btn:hover {
      border-color: var(--r-accent);
      color: var(--r-text);
      background: var(--r-bg-2);
      box-shadow: 0 0 12px var(--r-accent-glow);
    }
    .filter-btn.active {
      background: var(--r-accent) !important;
      color: var(--r-accent-ink) !important;
      font-weight: 700;
      border-color: var(--r-accent) !important;
      box-shadow: 0 0 12px var(--r-accent-glow);
    }

    /* Skeleton Loading */
    .loading-skeleton {
      background: linear-gradient(90deg, var(--r-surface) 25%, var(--r-bg-2) 50%, var(--r-surface) 75%);
      background-size: 200% 100%;
      animation: skeletonWave 1.8s infinite;
    }
    @keyframes skeletonWave {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Word search styles */
    .wordsearch-grid {
      display: grid;
      gap: 4px;
      user-select: none;
      background: var(--r-bg-2);
      padding: 10px;
      border-radius: 0.75rem;
      border: 1px solid var(--r-line);
    }
    .ws-cell {
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--r-surface);
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.15s;
      border-radius: 6px;
      color: var(--r-text);
      border: 1px solid var(--r-line);
    }
    .ws-cell:hover {
      background: var(--r-bg-2);
      color: var(--r-accent);
      border-color: var(--r-accent);
    }
    .ws-cell.selecting {
      background: var(--r-accent);
      color: var(--r-accent-ink);
      transform: scale(1.06);
      border-color: var(--r-accent);
    }
    .ws-cell.found {
      background: var(--r-accent);
      color: var(--r-accent-ink);
      border-color: var(--r-accent);
      animation: foundPop 0.3s ease;
    }
    @keyframes foundPop {
      0% { transform: scale(1); }
      50% { transform: scale(1.15); }
      100% { transform: scale(1); }
    }
    .game-card-btn {
      transition: all 0.2s ease;
      border: 1px solid var(--r-line);
      background: var(--r-surface);
    }
    .game-card-btn:hover {
      border-color: var(--r-line-2);
      transform: translateY(-2px);
    }
    .game-card-btn.selected {
      background: var(--r-bg-2);
      border-color: var(--r-accent);
      box-shadow: 0 0 15px var(--r-accent-glow);
    }
  </style>

  <script is:inline src="/assets/js/news.js?v=t330"></script>
</Layout>
