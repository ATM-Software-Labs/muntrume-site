  <section class="border-t border-[var(--r-line)] bg-[var(--r-bg)] py-8 text-[var(--r-muted)] text-xs font-mono">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 p-5 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)]">
