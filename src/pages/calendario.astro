---
import Layout from "../layouts/Layout.astro";
import schedule from "../../desktop/src/season_schedule_2026_s4.json";

const SEASON_START_MS = Date.UTC(2026, 8, 15);
const buildWeek = Math.max(1, Math.min(12, Math.floor((Date.now() - SEASON_START_MS) / 604_800_000) + 1));

const CAT_LABELS: Record<string, string> = {
  "SPORTS CAR": "Sports Car",
  "FORMULA CAR": "Formula Car",
  "OVAL": "Oval",
  "DIRT OVAL": "Dirt Oval",
  "DIRT ROAD": "Dirt Road",
};

const TIER_ORDER: Record<string, number> = {
  RClass: 1,
  DClass: 2,
  CClass: 3,
  BClass: 4,
  AClass: 5,
};

const TIER_LABELS: Record<string, string> = {
  RClass: "Rookie",
  DClass: "Class D",
  CClass: "Class C",
  BClass: "Class B",
  AClass: "Class A",
};

const TIER_COLORS: Record<string, string> = {
  RClass: "#ef4444",
  DClass: "#f97316",
  CClass: "#eab308",
  BClass: "#22c55e",
  AClass: "#3b82f6",
};

// Ranking aproximado de popularidad semanal en iRacing (menor = más popular)
const POPULARITY_RULES: Array<[RegExp, number]> = [
  [/^Global Mazda MX-5 Cup/i, 1],
  [/^GT3 Challenge Fixed/i, 2],
  [/^GT Sprint Series/i, 3],
  [/^IMSA iRacing Series by GO Fast/i, 4],
  [/^IMSA iRacing Series - Fixed/i, 5],
  [/^Ferrari 296 Challenge/i, 6],
  [/^Production Car Challenge/i, 7],
  [/^iRacing Porsche Cup by CONSPIT/i, 8],
  [/^iRacing Porsche Cup - Fixed/i, 9],
  [/^FIA F4/i, 10],
  [/^Formula C - Super Formula Lights by RSS/i, 11],
  [/^Formula C - Super Formula Lights - Fixed/i, 12],
  [/^GT4 Falken Tyre/i, 13],
  [/^Sports Car Challenge by Falken/i, 14],
  [/^BMW M2 Cup/i, 15],
  [/^Formula Vee/i, 16],
  [/^Formula 1600 Rookie/i, 17],
  [/^GT Endurance/i, 18],
  [/^IMSA Endurance/i, 19],
  [/^Ring Meister/i, 20],
  [/^Advanced Mazda/i, 21],
  [/^NASCAR Cup Series|^NASCAR Class A/i, 22],
  [/^NASCAR Xfinity|^NASCAR Class B/i, 23],
  [/^NASCAR Craftsman|^NASCAR Class C/i, 24],
  [/^ARCA/i, 25],
  [/^Draft Master/i, 26],
  [/^Super Formula/i, 27],
  [/^IndyCar/i, 28],
];

function popularityRank(name: string, tier: string): number {
  for (const [rx, score] of POPULARITY_RULES) {
    if (rx.test(name)) return score;
  }
  return 100 + (TIER_ORDER[tier] ?? 9);
}

function isFixedSeries(name: string): boolean {
  return /fixed|rookie|mx-5 cup|bmw m2 cup|formula vee|formula 1600|ferrari 296 challenge|draft master|ring meister/i.test(name);
}

function isEnduranceSeries(name: string): boolean {
  return /endurance|24h|creventic|special/i.test(name);
}

function trackQuery(rawTrack: string): string {
  const t = rawTrack || "";
  if (/suzuka/i.test(t)) return "Suzuka";
  if (/fuji/i.test(t)) return "Fuji";
  if (/mans/i.test(t)) return "Le Mans";
  if (/long beach/i.test(t)) return "Long Beach";
  if (/panorama|bathurst/i.test(t)) return "Bathurst";
  if (/spa-francorchamps/i.test(t)) return "Spa";
  if (/nürburgring|nurburgring/i.test(t)) return "Nurburgring";
  if (/interlagos/i.test(t)) return "Interlagos";
  if (/monza/i.test(t)) return "Monza";
  if (/laguna seca/i.test(t)) return "Laguna Seca";
  if (/watkins glen/i.test(t)) return "Watkins Glen";
  if (/road america/i.test(t)) return "Road America";
  if (/road atlanta/i.test(t)) return "Road Atlanta";
  if (/daytona/i.test(t)) return "Daytona";
  if (/sebring/i.test(t)) return "Sebring";
  if (/imola/i.test(t)) return "Imola";
  if (/silverstone/i.test(t)) return "Silverstone";
  if (/barcelona/i.test(t)) return "Barcelona";
  if (/red bull ring/i.test(t)) return "Red Bull Ring";
  if (/americas|cota/i.test(t)) return "COTA";
  return t.replace(/\s+(International Racing Course|International Speedway|Street Circuit|Circuit|Raceway|Motorsports Park).*$/i, "").trim();
}

const cleanSeries = schedule.series
  .map((s) => {
    const cleanName = s.name.replace(/\s*-?\s*2026 Season.*$/i, "").trim();
    const cat = s.category || "SPORTS CAR";
    const tier = s.tier || "DClass";
    const fixed = isFixedSeries(cleanName);
    const endurance = isEnduranceSeries(cleanName);
    const pop = popularityRank(cleanName, tier);
    return {
      id: s.id,
      name: cleanName,
      category: cat,
      categoryLabel: CAT_LABELS[cat] ?? cat,
      tier,
      tierRank: TIER_ORDER[tier] ?? 9,
      tierLabel: TIER_LABELS[tier] ?? tier,
      tierColor: TIER_COLORS[tier] ?? "#94a3b8",
      fixed,
      endurance,
      pop,
      cars: s.cars ?? [],
      weeks: (s.weeks ?? []).map((w) => ({
        w: w.week_num,
        date: w.start_date,
        track: w.track_name,
        config: w.config ?? "",
        duration: w.duration ?? "",
        trackQ: trackQuery(w.track_name),
      })),
    };
  })
  .sort((a, b) => a.pop - b.pop || a.name.localeCompare(b.name));

const catOrder = ["SPORTS CAR", "FORMULA CAR", "OVAL", "DIRT OVAL", "DIRT ROAD"];

const pageTitle = "Calendario Oficial iRacing 2026 Season 4 | Muntrume Motorsport";
const pageDescription = "Planificador minimalista del calendario oficial de iRacing 2026 Season 4 (154 series · 12 semanas), ordenable por popularidad, licencia, Fixed/Open y disciplina.";
const canonical = "https://muntru.me/calendario/";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="r-section cal" aria-labelledby="calPageTitle">
    <div class="r-wrap">
      <header class="cal-head">
        <div>
          <p class="r-kicker">2026 SEASON 4 · <span id="calLiveWeek">SEMANA {buildWeek}</span></p>
          <h1 id="calPageTitle" class="r-h1">Calendario iRacing</h1>
        </div>
        <div class="cal-head-meta">
          <span id="calCount" class="cal-count">{cleanSeries.length} series</span>
          <a href="/garage/" class="r-link">Ir al Garage →</a>
        </div>
      </header>

      <div class="cal-bar" role="region" aria-label="Filtros y ordenación">
        <div class="cal-bar__row">
          <div class="cal-group">
            <button type="button" class="cal-chip" id="btnFavFilter" aria-pressed="false">★ Favoritas</button>
            <button type="button" class="cal-chip" id="btnReset">↺ Reset</button>
          </div>

          <label class="cal-search">
            <span class="sr-only">Buscar serie, coche o circuito</span>
            <input id="calSearch" type="search" placeholder="Buscar serie, coche o circuito…" autocomplete="off" />
          </label>

          <label class="cal-sort">
            <span>Ordenar</span>
            <select id="calSort">
              <option value="pop">Popularidad</option>
              <option value="tier-asc">Licencia (R → A)</option>
              <option value="tier-desc">Licencia (A → R)</option>
              <option value="name">Nombre (A–Z)</option>
            </select>
          </label>
        </div>

        <div class="cal-bar__row cal-bar__row--filters">
          <div class="cal-group" id="calCatPills" role="group" aria-label="Disciplina">
            <button type="button" class="cal-pill is-on" data-cat="ALL">Todas</button>
            {catOrder.map((c) => (
              <button type="button" class="cal-pill" data-cat={c}>{CAT_LABELS[c]}</button>
            ))}
            <button type="button" class="cal-pill" data-cat="ENDURANCE">Endurance</button>
          </div>

          <div class="cal-group" id="calSetupPills" role="group" aria-label="Setup">
            <button type="button" class="cal-pill is-on" data-setup="ALL">Open + Fixed</button>
            <button type="button" class="cal-pill" data-setup="OPEN">Open</button>
            <button type="button" class="cal-pill" data-setup="FIXED">Fixed</button>
          </div>

          <div class="cal-group" id="calTierPills" role="group" aria-label="Licencia">
            <button type="button" class="cal-pill is-on" data-tier="ALL">Todas</button>
            {Object.entries(TIER_LABELS).map(([k, lbl]) => (
              <button type="button" class="cal-pill cal-pill--tier" data-tier={k} style={`--tier:${TIER_COLORS[k]}`}>
                {lbl}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div id="calGrid" class="cal-grid">
        {cleanSeries.map((s) => {
          const cur = s.weeks.find((w) => w.w === buildWeek) ?? s.weeks[0];
          const searchBlob = `${s.name} ${s.categoryLabel} ${s.tierLabel} ${s.cars.join(" ")} ${s.weeks.map((w) => `${w.track} ${w.config}`).join(" ")}`.toLowerCase();
          return (
            <article
              class="cal-card"
              style={`--tier:${s.tierColor}`}
              data-id={s.id}
              data-name={s.name.toLowerCase()}
              data-cat={s.category}
              data-tier={s.tier}
              data-tier-rank={s.tierRank}
              data-pop={s.pop}
              data-setup={s.fixed ? "FIXED" : "OPEN"}
              data-endurance={s.endurance ? "1" : "0"}
              data-search={searchBlob}
            >
              <header class="cal-card__head">
                <div class="cal-card__title-wrap">
                  <span class="cal-dot" title={s.tierLabel}></span>
                  <h2 class="cal-card__title">{s.name}</h2>
                </div>
                <button type="button" class="cal-fav" data-fav-btn={s.id} aria-pressed="false" title="Guardar en favoritas">★</button>
              </header>

              <div class="cal-card__sub">
                <span class="cal-tag">{s.fixed ? "FIXED" : "OPEN"}</span>
                <span class="cal-tag cal-tag--tier">{s.tierLabel}</span>
                <span class="cal-tag">{s.categoryLabel}</span>
                {cur?.duration && <span class="cal-tag cal-tag--dur">{cur.duration}</span>}
              </div>

              <ol class="cal-weeks" aria-label={`Calendario 12 semanas de ${s.name}`}>
                {s.weeks.map((w) => {
                  const state = w.w < buildWeek ? "past" : w.w === buildWeek ? "now" : "next";
                  return (
                    <li class={`cal-week is-${state}`} data-week-num={w.w}>
                      <a href={w.trackQ ? `/garage/?track=${encodeURIComponent(w.trackQ)}` : "/garage/"} title={`Ver setups en ${w.track}`}>
                        <span class="cal-week__num">{w.w}</span>
                        <span class="cal-week__track">{w.track}</span>
                        <span class="cal-week__cfg">{w.config}</span>
                      </a>
                    </li>
                  );
                })}
              </ol>

              <footer class="cal-card__foot">
                <span class="cal-card__cars" title={s.cars.join(" · ")}>
                  {s.cars.slice(0, 2).join(" · ")}{s.cars.length > 2 ? ` +${s.cars.length - 2}` : ""}
                </span>
                <a
                  class="cal-card__cta"
                  data-foot-garage
                  href={cur?.trackQ ? `/garage/?track=${encodeURIComponent(cur.trackQ)}` : "/garage/"}
                >
                  Setups S{buildWeek} →
                </a>
              </footer>
            </article>
          );
        })}
      </div>

      <p id="calEmptyState" class="r-empty" hidden>Ninguna serie coincide con los filtros actuales.</p>
    </div>
  </section>

  <style>
    .cal { padding-top: 24px; }
    .cal-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 18px; }
    .cal-head-meta { display: flex; align-items: center; gap: 16px; }
    .cal-count { font: 600 12px/1.2 ui-monospace, monospace; color: var(--r-muted); }

    .cal-bar {
      display: grid; gap: 10px; padding: 14px; border-radius: 14px;
      border: 1px solid var(--r-line); background: var(--r-surface, rgba(255,255,255,0.03));
      margin-bottom: 20px;
    }
    .cal-bar__row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }
    .cal-bar__row--filters { justify-content: flex-start; gap: 12px 18px; padding-top: 8px; border-top: 1px solid var(--r-line); }
    .cal-group { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }

    .cal-search { flex: 1; min-width: 220px; }
    .cal-search input {
      width: 100%; padding: 8px 12px; border-radius: 8px;
      border: 1px solid var(--r-line); background: var(--r-bg, #0e1211); color: var(--r-text); font-size: 13px;
    }
    .cal-sort { display: inline-flex; align-items: center; gap: 8px; font: 600 12px/1.2 ui-monospace, monospace; color: var(--r-muted); }
    .cal-sort select {
      padding: 8px 10px; border-radius: 8px; border: 1px solid var(--r-line);
      background: var(--r-bg, #0e1211); color: var(--r-text); font-size: 13px; cursor: pointer;
    }

    .cal-chip, .cal-pill {
      padding: 6px 10px; border-radius: 8px; border: 1px solid var(--r-line);
      background: transparent; color: var(--r-muted); font: 600 12px/1.2 inherit; cursor: pointer;
      transition: border-color .15s ease, color .15s ease, background .15s ease;
    }
    .cal-chip:hover, .cal-pill:hover { border-color: var(--r-line-2); color: var(--r-text); }
    .cal-chip.is-on, .cal-pill.is-on {
      border-color: var(--tier, var(--r-accent, #00e699));
      background: rgba(0, 230, 153, 0.12);
      color: var(--r-text);
    }
    .cal-pill--tier.is-on { background: color-mix(in srgb, var(--tier) 16%, transparent); }

    .cal-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
    .cal-card {
      display: flex; flex-direction: column; border-radius: 12px;
      border: 1px solid var(--r-line); border-top: 2px solid var(--tier, var(--r-accent, #00e699));
      background: var(--r-surface, rgba(255,255,255,0.03)); overflow: hidden;
    }
    .cal-card__head {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;
      padding: 12px 12px 6px;
    }
    .cal-card__title-wrap { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .cal-dot { width: 8px; height: 8px; border-radius: 999px; background: var(--tier, #00e699); flex-shrink: 0; }
    .cal-card__title {
      margin: 0; font-size: 14px; font-weight: 700; line-height: 1.25; color: var(--r-text);
      overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
    .cal-fav {
      background: transparent; border: none; color: var(--r-muted); cursor: pointer;
      font-size: 15px; line-height: 1; padding: 2px 4px; opacity: .6; transition: opacity .15s, color .15s;
    }
    .cal-fav:hover, .cal-fav.is-on { opacity: 1; color: #f59e0b; }

    .cal-card__sub { display: flex; flex-wrap: wrap; gap: 5px; padding: 0 12px 10px; }
    .cal-tag {
      font: 700 10px/1.2 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .04em;
      padding: 2px 6px; border-radius: 5px; border: 1px solid var(--r-line); color: var(--r-muted);
    }
    .cal-tag--tier { border-color: var(--tier); color: var(--tier); }
    .cal-tag--dur { color: var(--r-accent, #00e699); border-color: rgba(0, 230, 153, 0.3); }

    .cal-weeks { list-style: none; margin: 0; padding: 0 8px 8px; display: grid; gap: 2px; }
    .cal-week a {
      display: grid; grid-template-columns: 20px 1fr auto; align-items: center; gap: 6px;
      padding: 4px 7px; border-radius: 6px; text-decoration: none; font-size: 11px; line-height: 1.25;
      color: var(--r-text); transition: background .12s ease;
    }
    .cal-week a:hover { background: rgba(255, 255, 255, 0.06); }
    .cal-week__num { font: 700 10px/1 ui-monospace, monospace; color: var(--r-muted); text-align: right; }
    .cal-week__track { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cal-week__cfg {
      font-size: 10px; color: var(--r-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 82px;
    }

    .cal-week.is-past a { opacity: 0.42; }
    .cal-week.is-now a {
      border: 1px solid var(--r-accent, #00e699);
      background: rgba(0, 230, 153, 0.12);
    }
    .cal-week.is-now .cal-week__num,
    .cal-week.is-now .cal-week__track { color: var(--r-accent, #00e699); }

    .cal-card__foot {
      margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding: 9px 12px; border-top: 1px solid var(--r-line); font-size: 11px;
    }
    .cal-card__cars { color: var(--r-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cal-card__cta { font: 700 11px/1.2 ui-monospace, monospace; color: var(--r-accent, #00e699); text-decoration: none; white-space: nowrap; }
    .cal-card__cta:hover { text-decoration: underline; }
  </style>

  <script is:inline>
    (() => {
      const grid = document.getElementById("calGrid");
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll(".cal-card"));
      const searchInput = document.getElementById("calSearch");
      const sortSelect = document.getElementById("calSort");
      const countEl = document.getElementById("calCount");
      const emptyEl = document.getElementById("calEmptyState");
      const favBtn = document.getElementById("btnFavFilter");
      const resetBtn = document.getElementById("btnReset");
      const liveWeekEl = document.getElementById("calLiveWeek");

      const week = Math.max(1, Math.min(12, Math.floor((Date.now() - Date.UTC(2026, 8, 15)) / 604800000) + 1));
      if (liveWeekEl) liveWeekEl.textContent = "SEMANA " + week;

      const FAV_KEY = "mmt_cal_favs_v1";
      let favs = new Set();
      try {
        favs = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || "[]"));
      } catch {}

      let activeCat = "ALL";
      let activeSetup = "ALL";
      let activeTier = "ALL";
      let onlyFavs = false;

      // Highlight live week dynamically
      cards.forEach((card) => {
        card.querySelectorAll("[data-week-num]").forEach((li) => {
          const w = Number(li.dataset.weekNum);
          li.classList.remove("is-past", "is-now", "is-next");
          li.classList.add(w < week ? "is-past" : w === week ? "is-now" : "is-next");
        });
        const foot = card.querySelector("[data-foot-garage]");
        const nowLink = card.querySelector('.cal-week.is-now a');
        if (foot && nowLink) {
          foot.setAttribute("href", nowLink.getAttribute("href") || "/garage/");
          foot.textContent = "Setups S" + week + " →";
        }
      });

      function syncFavIcons() {
        cards.forEach((card) => {
          const id = card.dataset.id || "";
          const btn = card.querySelector("[data-fav-btn]");
          if (!btn) return;
          const on = favs.has(id);
          btn.classList.toggle("is-on", on);
          btn.setAttribute("aria-pressed", String(on));
        });
      }

      function applySort() {
        const mode = sortSelect?.value || "pop";
        const sorted = [...cards].sort((a, b) => {
          if (mode === "tier-asc") {
            return Number(a.dataset.tierRank) - Number(b.dataset.tierRank) || Number(a.dataset.pop) - Number(b.dataset.pop);
          }
          if (mode === "tier-desc") {
            return Number(b.dataset.tierRank) - Number(a.dataset.tierRank) || Number(a.dataset.pop) - Number(b.dataset.pop);
          }
          if (mode === "name") {
            return (a.dataset.name || "").localeCompare(b.dataset.name || "");
          }
          return Number(a.dataset.pop) - Number(b.dataset.pop) || (a.dataset.name || "").localeCompare(b.dataset.name || "");
        });
        sorted.forEach((el) => grid.appendChild(el));
      }

      function applyFilter() {
        const q = (searchInput?.value || "").trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const okCat = activeCat === "ALL" || (activeCat === "ENDURANCE" ? card.dataset.endurance === "1" : card.dataset.cat === activeCat);
          const okSetup = activeSetup === "ALL" || card.dataset.setup === activeSetup;
          const okTier = activeTier === "ALL" || card.dataset.tier === activeTier;
          const okFav = !onlyFavs || favs.has(card.dataset.id || "");
          const okQ = !q || (card.dataset.search || "").includes(q);
          const show = okCat && okSetup && okTier && okFav && okQ;
          card.hidden = !show;
          if (show) visible++;
        });
        if (countEl) countEl.textContent = visible + (visible === 1 ? " serie" : " series");
        if (emptyEl) emptyEl.hidden = visible > 0;
      }

      grid.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-fav-btn]");
        if (!btn) return;
        const id = btn.dataset.favBtn;
        if (!id) return;
        if (favs.has(id)) favs.delete(id);
        else favs.add(id);
        try { localStorage.setItem(FAV_KEY, JSON.stringify([...favs])); } catch {}
        syncFavIcons();
        if (onlyFavs) applyFilter();
      });

      document.getElementById("calCatPills")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-cat]");
        if (!btn) return;
        activeCat = btn.dataset.cat || "ALL";
        document.querySelectorAll("#calCatPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b === btn));
        applyFilter();
      });

      document.getElementById("calSetupPills")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-setup]");
        if (!btn) return;
        activeSetup = btn.dataset.setup || "ALL";
        document.querySelectorAll("#calSetupPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b === btn));
        applyFilter();
      });

      document.getElementById("calTierPills")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-tier]");
        if (!btn) return;
        activeTier = btn.dataset.tier || "ALL";
        document.querySelectorAll("#calTierPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b === btn));
        applyFilter();
      });

      favBtn?.addEventListener("click", () => {
        onlyFavs = !onlyFavs;
        favBtn.classList.toggle("is-on", onlyFavs);
        favBtn.setAttribute("aria-pressed", String(onlyFavs));
        applyFilter();
      });

      resetBtn?.addEventListener("click", () => {
        activeCat = "ALL";
        activeSetup = "ALL";
        activeTier = "ALL";
        onlyFavs = false;
        if (searchInput) searchInput.value = "";
        if (sortSelect) sortSelect.value = "pop";
        favBtn?.classList.remove("is-on");
        favBtn?.setAttribute("aria-pressed", "false");
        document.querySelectorAll("#calCatPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b.dataset.cat === "ALL"));
        document.querySelectorAll("#calSetupPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b.dataset.setup === "ALL"));
        document.querySelectorAll("#calTierPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b.dataset.tier === "ALL"));
        applySort();
        applyFilter();
      });

      searchInput?.addEventListener("input", applyFilter);
      sortSelect?.addEventListener("change", () => { applySort(); applyFilter(); });

      syncFavIcons();
      applySort();
      applyFilter();
    })();
  </script>
</Layout>
