---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Muntrume AI Docs · Arquitectura, Artefactos y API | Muntrume Motorsport";
const pageDescription = "Documentación técnica oficial de Muntrume AI (ai.muntru.me): asistente 100 % Open Source (MIT) con motores Lite/Pro/Ultra Max, Artifacts Studio (HTML, SVG, Mermaid, Slides, CSV, DOC/PDF), visión por imagen y API REST/SSE.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: "Documentación oficial de Muntrume AI (ai.muntru.me)",
    description: pageDescription,
    url: "https://muntru.me/ai-docs/",
    inLanguage: "es",
    author: { "@type": "Organization", name: "Muntrume Motorsport", url: "https://muntru.me/" },
    publisher: { "@type": "Organization", name: "Muntrume Motorsport", url: "https://muntru.me/" },
    about: {
      "@type": "SoftwareApplication",
      name: "Muntrume AI",
      url: "https://ai.muntru.me/",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web",
      isAccessibleForFree: true,
      license: "https://opensource.org/licenses/MIT",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "¿Qué es Muntrume AI y cómo funciona?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Muntrume AI (ai.muntru.me) es un estudio de inteligencia artificial 100 % Open Source bajo licencia MIT desarrollado por Muntrume Motorsport en Barcelona. Combina enrutamiento inteligente en Cloudflare Workers, skills de ingeniería iRacing/software, visión por imagen y un Artifacts Studio en pantalla dividida para ejecutar y publicar aplicaciones HTML, diagramas SVG/Mermaid, presentaciones 16:9, hojas CSV y documentos exportables a DOC y PDF.",
        },
      },
      {
        "@type": "Question",
        name: "¿Qué tipos de artefactos soporta Muntrume AI Studio?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Soporta aplicaciones web HTML/CSS/JS interactivas en sandbox, gráficos vectoriales SVG, diagramas de flujo Mermaid, presentaciones navegables 16:9 (slides), tablas CSV descargables, documentos técnicos exportables a Word (.doc), PDF y Markdown, y bloques de código con resaltado sintáctico. Cualquier piloto autenticado puede publicarlos con URL permanente en ai.muntru.me/a/<slug>.",
        },
      },
      {
        "@type": "Question",
        name: "¿Cómo pueden las IAs externas y buscadores indexar Muntrume AI?",
        acceptedAnswer: {
          "@type": "Answer",
          text: "Muntrume publica documentación estructurada en https://muntru.me/ai-docs/, https://ai.muntru.me/docs/, https://muntru.me/llms.txt, https://muntru.me/llms-full.txt, https://muntru.me/ai-knowledge.json, https://muntru.me/ai-openapi.json y https://muntru.me/.well-known/ai-plugin.json, con marcado Schema.org JSON-LD y permiso explícito en robots.txt para rastreadores de buscadores e IAs.",
        },
      },
    ],
  },
];

const codeCurl = `curl -X POST https://ai.muntru.me/api/ai \\
  -H "Content-Type: application/json" \\
  -H "Authorization: Bearer <TEAM_JWT_TOKEN>" \\
  -d '{
    "prompt": "Calcula estrategia de combustible para 6h de Spa en GT3 (2.95 L/vuelta, 2:17.5)",
    "tier": "pro",
    "mode": "team",
    "skill": "strategy",
    "lang": "es",
    "stream": false
  }'`;

const codeJs = `const res = await fetch("https://ai.muntru.me/api/ai", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "Authorization": "Bearer <TEAM_JWT_TOKEN>"
  },
  body: JSON.stringify({
    prompt: "Diagnostica subviraje en entrada en curva rápida con Porsche 992 GT3 R",
    tier: "pro",
    mode: "team",
    skill: "setup",
    lang: "es",
    stream: false
  })
});

const data = await res.json();
console.log(data.model_brand, data.markdown);`;

const codePython = `import requests

response = requests.post(
    "https://ai.muntru.me/api/ai",
    headers={"Authorization": "Bearer <TEAM_JWT_TOKEN>"},
    json={
        "prompt": "Crea un diagrama mermaid de decisión de pit-stop en lluvia",
        "tier": "pro",
        "skill": "code",
        "lang": "es",
        "stream": False,
    },
    timeout=30,
)
payload = response.json()
print(payload["markdown"])`;

const codeSse = `// Streaming Server-Sent Events (requiere JWT de miembro Muntrume)
const res = await fetch("https://ai.muntru.me/api/ai", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "Authorization": "Bearer <TEAM_JWT_TOKEN>"
  },
  body: JSON.stringify({ prompt: "Plan de stints 12h Sebring", tier: "ultra_max", stream: true })
});

const reader = res.body.getReader();
const decoder = new TextDecoder();
while (true) {
  const { value, done } = await reader.read();
  if (done) break;
  process.stdout.write(decoder.decode(value));
}`;
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/ai-docs/">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="mdoc-page">
    <div class="mdoc-grid">
      <!-- LEFT NAVIGATION SIDEBAR (MSFT / ANTHROPIC STYLE) -->
      <aside class="mdoc-sidebar" aria-label="Navegación de documentación">
        <div class="mdoc-sidebar__inner">
          <div class="mdoc-sidebar__brand">
            <span class="mdoc-brand-dot" aria-hidden="true"></span>
            <div>
              <strong>Muntrume AI</strong>
              <span>Docs · v1.0 MIT</span>
            </div>
          </div>

          <div class="mdoc-nav-group">
            <div class="mdoc-nav-group__title">Primeros pasos</div>
            <a href="#overview" class="mdoc-nav-link is-active" data-doc-link="overview">Introducción</a>
            <a href="#quickstart" class="mdoc-nav-link" data-doc-link="quickstart">Inicio rápido</a>
            <a href="#modelos" class="mdoc-nav-link" data-doc-link="modelos">Motores Muntrume 1.0</a>
          </div>

          <div class="mdoc-nav-group">
            <div class="mdoc-nav-group__title">Capacidades</div>
            <a href="#skills" class="mdoc-nav-link" data-doc-link="skills">Skills y comandos slash</a>
            <a href="#artefactos" class="mdoc-nav-link" data-doc-link="artefactos">Artifacts Studio</a>
            <a href="#vision" class="mdoc-nav-link" data-doc-link="vision">Visión y telemetría</a>
          </div>

          <div class="mdoc-nav-group">
            <div class="mdoc-nav-group__title">Referencia técnica</div>
            <a href="#seguridad" class="mdoc-nav-link" data-doc-link="seguridad">Seguridad y Zero-Trust</a>
            <a href="#api" class="mdoc-nav-link" data-doc-link="api">API POST /api/ai</a>
            <a href="#parametros" class="mdoc-nav-link" data-doc-link="parametros">Parámetros del esquema</a>
            <a href="#indexacion" class="mdoc-nav-link" data-doc-link="indexacion">SEO, LLMs y OpenAPI</a>
            <a href="#faq" class="mdoc-nav-link" data-doc-link="faq">Preguntas frecuentes</a>
          </div>

          <div class="mdoc-sidebar__foot">
            <a href="https://ai.muntru.me/" class="mdoc-cta-mini">Abrir AI Studio ↗</a>
          </div>
        </div>
      </aside>

      <!-- CENTER EDITORIAL CONTENT -->
      <article class="mdoc-article">
        <!-- BREADCRUMB & HERO -->
        <header class="mdoc-hero" id="overview" data-doc-section="overview">
          <div class="mdoc-crumb">
            <a href="https://muntru.me/">Muntrume</a>
            <span aria-hidden="true">/</span>
            <a href="https://ai.muntru.me/">Muntrume AI</a>
            <span aria-hidden="true">/</span>
            <span>Documentación</span>
          </div>

          <div class="mdoc-kicker">
            <span class="mdoc-kicker__dot" aria-hidden="true"></span>
            <span>DOCUMENTACIÓN OFICIAL · OPEN SOURCE (MIT)</span>
          </div>

          <h1>Documentación de Muntrume AI</h1>
          <p class="mdoc-lead">
            Aprende a usar, integrar y extender <strong>Muntrume AI Studio</strong> (<a href="https://ai.muntru.me/">ai.muntru.me</a>), la plataforma de ingeniería sim racing, generación de código y artefactos interactivos desarrollada por Muntrume Motorsport sobre Cloudflare Workers y D1.
          </p>

          <div class="mdoc-hero-actions">
            <a href="https://ai.muntru.me/" class="r-btn r-btn--primary">Abrir Muntrume AI Studio →</a>
            <a href="#api" class="r-btn">Referencia de API</a>
            <a href="https://github.com/ATM-Software-Labs/muntrume-site" target="_blank" rel="noopener noreferrer" class="r-btn">Código fuente (MIT)</a>
          </div>

          <div class="mdoc-callout mdoc-callout--info">
            <div class="mdoc-callout__title">Optimizado para humanos, buscadores y agentes de IA</div>
            <p>
              Toda esta especificación está disponible en formato legible por máquina en <a href="/llms.txt">llms.txt</a>, <a href="/llms-full.txt">llms-full.txt</a>, <a href="/ai-knowledge.json">ai-knowledge.json</a> y <a href="/ai-openapi.json">ai-openapi.json</a>.
            </p>
          </div>
        </header>

        <!-- QUICKSTART -->
        <section class="mdoc-section" id="quickstart" data-doc-section="quickstart" data-g-reveal>
          <h2>Inicio rápido</h2>
          <p class="mdoc-sub">Tres formas de empezar a trabajar con Muntrume AI en menos de un minuto.</p>

          <div class="mdoc-cards mdoc-cards--3">
            <a href="https://ai.muntru.me/" class="mdoc-card mdoc-card--link glow-card">
              <span class="mdoc-step">01</span>
              <h3>Estudio Web</h3>
              <p>Abre <code>ai.muntru.me</code> sin registro previo para consultas de setups, estrategia, código y artefactos.</p>
              <span class="mdoc-card__more">Ir al Studio →</span>
            </a>

            <a href="#skills" class="mdoc-card mdoc-card--link glow-card">
              <span class="mdoc-step">02</span>
              <h3>Comandos Slash</h3>
              <p>Escribe <code>/setup</code>, <code>/strategy</code>, <code>/code</code>, <code>/mermaid</code> o <code>/slides</code> directo en el chat.</p>
              <span class="mdoc-card__more">Ver comandos →</span>
            </a>

            <a href="#api" class="mdoc-card mdoc-card--link glow-card">
              <span class="mdoc-step">03</span>
              <h3>API REST &amp; SSE</h3>
              <p>Integra <code>POST /api/ai</code> en tus scripts, bots o herramientas con respuesta JSON o streaming SSE.</p>
              <span class="mdoc-card__more">Ver ejemplos →</span>
            </a>
          </div>
        </section>

        <!-- MODELOS -->
        <section class="mdoc-section" id="modelos" data-doc-section="modelos" data-g-reveal>
          <h2>Motores Muntrume 1.0</h2>
          <p class="mdoc-sub">
            El enrutador edge selecciona el perfil de inferencia según el parámetro <code>tier</code>, con conmutación automática ante saturación y cero exposición de proveedores internos.
          </p>

          <div class="mdoc-table-wrap">
            <table class="mdoc-table">
              <thead>
                <tr>
                  <th>Modelo</th>
                  <th>Parámetro <code>tier</code></th>
                  <th>Límite salida</th>
                  <th>Caso de uso recomendado</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Muntrume 1.0 Lite</strong></td>
                  <td><code>lite</code></td>
                  <td>900 tokens</td>
                  <td>Diagnósticos rápidos en boxes, definiciones y traducciones con latencia mínima.</td>
                </tr>
                <tr>
                  <td><strong>Muntrume 1.0 Pro</strong> <span class="mdoc-tag">Recomendado</span></td>
                  <td><code>pro</code></td>
                  <td>2.400 – 3.400 tokens</td>
                  <td>Ingeniería de setups iRacing, desarrollo de software, tablas y artefactos interactivos.</td>
                </tr>
                <tr>
                  <td><strong>Muntrume 1.0 Ultra Max</strong></td>
                  <td><code>ultra_max</code></td>
                  <td>3.200 – 3.800 tokens</td>
                  <td>Estrategia endurance 12h/24h, arquitectura avanzada y razonamiento paso a paso visible.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- SKILLS Y COMANDOS SLASH -->
        <section class="mdoc-section" id="skills" data-doc-section="skills" data-g-reveal>
          <h2>Skills especializadas y comandos slash</h2>
          <p class="mdoc-sub">
            Las skills inyectan contexto de ingeniería y reglas de formato específicas. Puedes activarlas desde la interfaz o escribiendo el prefijo slash al inicio de tu consulta.
          </p>

          <div class="mdoc-cards mdoc-cards--2">
            <div class="mdoc-card glow-card">
              <div class="mdoc-card__head"><code>/setup</code><span>skill: setup</span></div>
              <h3>Ingeniero de Setups iRacing</h3>
              <p>Ajustes de balance aerodinámico, barras estabilizadoras (ARB), precarga de diferencial, amortiguadores, presiones en caliente y brake bias.</p>
            </div>

            <div class="mdoc-card glow-card">
              <div class="mdoc-card__head"><code>/strategy</code><span>skill: strategy</span></div>
              <h3>Estrategia Endurance</h3>
              <p>Consumo por vuelta, cálculo de stints por depósito, ventanas de pit stop, doble stint de neumáticos y rotación de pilotos.</p>
            </div>

            <div class="mdoc-card glow-card">
              <div class="mdoc-card__head"><code>/code</code><span>skill: code</span></div>
              <h3>Código y Artefactos Live</h3>
              <p>Genera aplicaciones web autocontenidas en bloques <code>```html</code> y gráficos vectoriales <code>```svg</code> previsualizables en vivo.</p>
            </div>

            <div class="mdoc-card glow-card">
              <div class="mdoc-card__head"><code>/mermaid</code><span>artefacto: mermaid</span></div>
              <h3>Diagramas de Flujo Mermaid</h3>
              <p>Genera diagramas de flujo, secuencias y árboles de decisión pit-wall en <code>```mermaid</code> listos para renderizar en el Studio.</p>
            </div>

            <div class="mdoc-card glow-card">
              <div class="mdoc-card__head"><code>/slides</code><span>skill: slides</span></div>
              <h3>Presentaciones 16:9</h3>
              <p>Construye decks navegables con teclado y barra de progreso separados por <code>---</code> dentro de bloques <code>```slides</code>.</p>
            </div>

            <div class="mdoc-card glow-card">
              <div class="mdoc-card__head"><code>/doc</code><span>skill: doc</span></div>
              <h3>Documentos Técnicos</h3>
              <p>Informes estructurados con tablas, callouts y checklists exportables en 1 clic a Word (<code>.doc</code>), PDF y Markdown (<code>.md</code>).</p>
            </div>
          </div>
        </section>

        <!-- ARTIFACTS STUDIO -->
        <section class="mdoc-section" id="artefactos" data-doc-section="artefactos" data-g-reveal>
          <h2>Artifacts Studio y publicación permanente</h2>
          <p class="mdoc-sub">
            El panel lateral en pantalla dividida ejecuta y previsualiza bloques generados por la IA en un entorno aislado (<code>sandbox="allow-scripts allow-forms allow-downloads"</code>).
          </p>

          <div class="mdoc-feature-list">
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Formatos soportados</div>
              <div class="mdoc-feature__v"><code>html</code>, <code>svg</code>, <code>mermaid</code>, <code>slides</code> (16:9), <code>csv</code>, <code>doc</code> (Markdown) y <code>code</code>.</div>
            </div>
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Vista previa responsive</div>
              <div class="mdoc-feature__v">Selector instantáneo <strong>PC (100 %)</strong>, <strong>Tablet (768 px)</strong> y <strong>Móvil (390 px)</strong>, botón <strong>Recargar</strong>, <strong>Pestaña nueva</strong> y <strong>Pantalla completa</strong>.</div>
            </div>
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Edición e iteración</div>
              <div class="mdoc-feature__v">Editor de código integrado con recarga automática y botón <em>Mejorar con IA</em> para iterar sobre el artefacto activo.</div>
            </div>
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Exportación y hosting D1</div>
              <div class="mdoc-feature__v">Descarga en <code>.html</code>, <code>.svg</code>, <code>.mmd</code>, <code>.csv</code>, <code>.doc</code>, PDF y <code>.md</code>. Publicación permanente en <code>https://ai.muntru.me/a/&lt;slug&gt;</code>, código crudo en <code>/raw</code> y perfil de autor en <code>/u/&lt;handle&gt;</code>.</div>
            </div>
          </div>
        </section>

        <!-- VISIÓN Y TELEMETRÍA -->
        <section class="mdoc-section" id="vision" data-doc-section="vision" data-g-reveal>
          <h2>Visión por imagen y contexto externo</h2>
          <p class="mdoc-sub">
            Muntrume AI admite entradas multimodales y enriquecimiento de contexto en tiempo real desde la misma petición:
          </p>
          <ul class="mdoc-bullets">
            <li><strong>Análisis visual (Vision AI)</strong>: adjunta o pega (<code>Ctrl+V</code>) capturas PNG/JPG/WebP de telemetría Garage 61, gráficos de barras, licencias iRacing o interfaces de código.</li>
            <li><strong>Contexto GitHub</strong>: pasa una URL pública de repositorio o archivo en <code>github_url</code> para analizar código real o READMEs.</li>
            <li><strong>Búsqueda web y datos D1 en vivo</strong>: activa <code>web_search: true</code> para cruzar consultas del equipo con datos en vivo de pilotos y resultados públicos.</li>
          </ul>
        </section>

        <!-- SEGURIDAD Y ZERO-TRUST -->
        <section class="mdoc-section" id="seguridad" data-doc-section="seguridad" data-g-reveal>
          <h2>Seguridad y control de acceso (Zero-Trust)</h2>
          <p class="mdoc-sub">
            Muntrume AI separa estrictamente el acceso público a la documentación del acceso privado a los motores de inferencia del equipo.
          </p>

          <div class="mdoc-feature-list">
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Acceso a modelos (Privado)</div>
              <div class="mdoc-feature__v"><code>POST /api/ai</code> y los menús del Studio en <code>ai.muntru.me</code> exigen sesión verificada de miembro activo de Muntrume Motorsport mediante token <strong>JWT HMAC-SHA256</strong> (<code>Authorization: Bearer</code>) validado contra D1 (<code>allowed_users</code>). Las peticiones sin sesión devuelven <code>HTTP 401</code>.</div>
            </div>
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Documentación (Pública)</div>
              <div class="mdoc-feature__v">Visitantes externos, buscadores e IAs externas tienen acceso abierto y sin autenticación a <code>/ai-docs/</code>, <code>ai.muntru.me/docs/</code>, artefactos públicos <code>/a/&lt;slug&gt;</code>, <code>llms.txt</code>, <code>ai-knowledge.json</code> y <code>ai-openapi.json</code>.</div>
            </div>
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Aislamiento y CSP</div>
              <div class="mdoc-feature__v">Todos los artefactos HTML/SVG/Mermaid se ejecutan en iframes aislados (<code>sandbox="allow-scripts allow-forms allow-downloads"</code>) con <code>Content-Security-Policy</code> estricta, <code>X-Content-Type-Options: nosniff</code> y limitación de tasa por usuario en edge.</div>
            </div>
            <div class="mdoc-feature">
              <div class="mdoc-feature__k">Credenciales</div>
              <div class="mdoc-feature__v">Las contraseñas del Vault se almacenan con <strong>PBKDF2-SHA256</strong> (100.000 iteraciones) y las claves de inferencia residen exclusivamente como secretos cifrados en Cloudflare Workers, nunca en repositorios Git.</div>
            </div>
          </div>
        </section>

        <!-- API REFERENCE WITH MULTI-LANG TABS -->
        <section class="mdoc-section" id="api" data-doc-section="api" data-g-reveal>
          <h2>Referencia de API · <code>POST /api/ai</code></h2>
          <p class="mdoc-sub">
            Endpoint público disponible en <code>https://ai.muntru.me/api/ai</code> y <code>https://muntrume.atrumin16.workers.dev/api/ai</code>.
          </p>

          <div class="mdoc-code-box">
            <div class="mdoc-code-box__bar">
              <div class="mdoc-code-tabs" role="tablist" aria-label="Lenguaje de ejemplo">
                <button type="button" role="tab" class="mdoc-code-tab is-active" data-code-tab="curl" aria-selected="true">cURL</button>
                <button type="button" role="tab" class="mdoc-code-tab" data-code-tab="js" aria-selected="false">JavaScript</button>
                <button type="button" role="tab" class="mdoc-code-tab" data-code-tab="python" aria-selected="false">Python</button>
                <button type="button" role="tab" class="mdoc-code-tab" data-code-tab="sse" aria-selected="false">SSE Stream</button>
              </div>
              <button type="button" id="mdocCopyBtn" class="mdoc-copy-btn">Copiar</button>
            </div>
            <pre class="mdoc-pre" data-code-panel="curl"><code>{codeCurl}</code></pre>
            <pre class="mdoc-pre" data-code-panel="js" hidden><code>{codeJs}</code></pre>
            <pre class="mdoc-pre" data-code-panel="python" hidden><code>{codePython}</code></pre>
            <pre class="mdoc-pre" data-code-panel="sse" hidden><code>{codeSse}</code></pre>
          </div>
        </section>

        <!-- PARAMETROS -->
        <section class="mdoc-section" id="parametros" data-doc-section="parametros" data-g-reveal>
          <h2>Parámetros de solicitud</h2>
          <div class="mdoc-table-wrap">
            <table class="mdoc-table">
              <thead>
                <tr>
                  <th>Campo</th>
                  <th>Tipo</th>
                  <th>Por defecto</th>
                  <th>Descripción</th>
                </tr>
              </thead>
              <tbody>
                <tr><td><code>prompt</code></td><td><code>string</code></td><td><em>requerido*</em></td><td>Instrucción o pregunta del usuario (máx. 8.000 caracteres).</td></tr>
                <tr><td><code>tier</code></td><td><code>string</code></td><td><code>"pro"</code></td><td>Nivel de motor: <code>lite</code>, <code>pro</code> o <code>ultra_max</code>.</td></tr>
                <tr><td><code>mode</code></td><td><code>string</code></td><td><code>"team"</code></td><td>Contexto: <code>team</code> (ingeniero Muntrume), <code>general</code> o <code>ai_setup</code>.</td></tr>
                <tr><td><code>skill</code></td><td><code>string</code></td><td><code>""</code></td><td>Skill opcional: <code>setup</code>, <code>strategy</code>, <code>code</code>, <code>slides</code> o <code>doc</code>.</td></tr>
