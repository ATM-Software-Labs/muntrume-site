  <script is:inline>
    (function () {
      // 1. Multi-language API Code Tabs + Copy
      var tabs = document.querySelectorAll('[data-code-tab]');
      var panels = document.querySelectorAll('[data-code-panel]');
      var copyBtn = document.getElementById('mdocCopyBtn');
      var activeTab = 'curl';

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          activeTab = tab.getAttribute('data-code-tab') || 'curl';
          tabs.forEach(function (t) {
            var on = t === tab;
            t.classList.toggle('is-active', on);
            t.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach(function (p) {
            p.hidden = p.getAttribute('data-code-panel') !== activeTab;
          });
        });
      });

      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var panel = document.querySelector('[data-code-panel="' + activeTab + '"] code');
          if (!panel) return;
          navigator.clipboard.writeText(panel.textContent || '').then(function () {
            copyBtn.textContent = 'Copiado ✓';
            setTimeout(function () { copyBtn.textContent = 'Copiar'; }, 1600);
          });
        });
      }

      // 2. Scroll-Spy for Left Sidebar & Right "On this page" Rail
      var sections = document.querySelectorAll('[data-doc-section]');
      if ('IntersectionObserver' in window && sections.length) {
        var setActive = function (id) {
          document.querySelectorAll('[data-doc-link]').forEach(function (a) {
            a.classList.toggle('is-active', a.getAttribute('data-doc-link') === id);
          });
          document.querySelectorAll('[data-rail-link]').forEach(function (a) {
            a.classList.toggle('is-active', a.getAttribute('data-rail-link') === id);
          });
        };
        var spy = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var id = entry.target.getAttribute('data-doc-section');
              if (id) setActive(id);
            }
          });
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 });
        sections.forEach(function (sec) { spy.observe(sec); });
      }
    })();
  </script>
