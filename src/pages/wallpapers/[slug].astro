---
import Layout from "../../layouts/Layout.astro";
import { absoluteWallpaperUrl, getWallpaperCatalog, type WallpaperSeries } from "../../lib/wallpaper-catalog";

export async function getStaticPaths() {
  const catalog = await getWallpaperCatalog();
  return catalog.series.map((series) => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

interface Props {
  series: WallpaperSeries;
}

const { series } = Astro.props;
const pageUrl = `https://muntru.me/wallpapers/${series.slug}/`;
const kindLabel = series.kind === "series" ? "Serie" : "Categoría";
const pageTitle = `Wallpapers ${series.name}`;
const pageDescription = `${series.items.length} wallpapers de ${series.name} (${kindLabel.toLowerCase()}) en iRacing, JPG 16:9 y móvil 9:16. Equipo MMT.`;
const ogImage = absoluteWallpaperUrl(series.items[0]?.img || "/assets/img/coche2.webp");

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ImageGallery",
      "@id": `${pageUrl}#gallery`,
      url: pageUrl,
      name: `${series.name} · Wallpapers`,
      description: pageDescription,
      inLanguage: "es",
      image: series.items.map((item) => ({
        "@type": "ImageObject",
        contentUrl: absoluteWallpaperUrl(item.img),
        url: pageUrl,
        name: item.title || item.model,
        caption: item.alt,
        representativeOfPage: item.id === series.items[0]?.id,
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt={series.items[0]?.alt || series.name}
  schemaJson={pageSchema}
>
  <div class="min-h-screen bg-[var(--r-bg)] text-[var(--r-text)] py-12 px-4 sm:px-6">
    <div class="r-wrap space-y-6">
      <header class="border-b border-[var(--r-line)] pb-5 space-y-2">
        <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--r-accent)] font-bold">
          <a href="/wallpapers/" class="hover:underline">Wallpapers</a>
          <span class="text-[var(--r-muted)]"> · {kindLabel}</span>
        </p>
        <h1 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight text-[var(--r-text)]">{series.name}</h1>
        <p class="text-sm text-[var(--r-muted)] font-mono">{series.items.length} wallpapers en este grupo, en el orden del coche y del número de toma.</p>
      </header>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {series.items.map((item, index) => (
          <li class="group rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] overflow-hidden hover:border-[var(--r-accent)] transition shadow-sm">
            <a href={item.img} target="_blank" rel="noopener noreferrer" class="block aspect-video bg-[#090b0f] overflow-hidden">
              <img
                src={item.img}
                alt={item.alt}
                width="640"
                height="360"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                referrerpolicy="no-referrer"
                onerror="if(!this.dataset.proxied){this.dataset.proxied='1';this.src='https://api.muntru.me/api/media/proxy?url='+encodeURIComponent(this.getAttribute('src')||'');}else{var li=this.closest('li');if(li)li.style.display='none';}"
                class="w-full h-full object-cover object-center transition-transform duration-300 group-hover:scale-105"
              />
            </a>
            <div class="p-3 font-mono flex items-center justify-between gap-2">
              <div class="min-w-0">
                <p class="text-xs font-bold text-[var(--r-text)] truncate">{item.title || item.model}</p>
                {item.circuit && <p class="text-[10px] text-[var(--r-muted)] truncate">{item.circuit}</p>}
              </div>
              <a href={item.img} target="_blank" rel="noopener noreferrer" class="shrink-0 px-2.5 py-1 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] text-[10px] font-extrabold">
                Ver HD ↗
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
