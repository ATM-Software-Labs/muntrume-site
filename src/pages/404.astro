---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Página no encontrada | Muntrume Motorsport";
---

<Layout title={pageTitle} description="Esta página no existe en Muntrume Motorsport (MMT). Vuelve al inicio, al garage o a la plantilla." noindex translated i18nTitle="miss.meta.title" i18nDescription="miss.meta.desc">
  <section class="r-section" style="border-top:0;padding-top:clamp(28px,5vw,64px)" aria-labelledby="missingTitle">
    <div class="r-wrap" style="display:grid;gap:16px;max-width:68ch">
      <p class="r-kicker" data-i18n="miss.kicker">404</p>
      <h1 id="missingTitle" class="r-h2" data-i18n="miss.title">Esta página no está</h1>
      <p class="r-lead" data-i18n="miss.lead">El enlace no corresponde a ninguna página del sitio.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/" class="r-btn r-btn--primary" data-i18n="nav.home">Inicio</a>
        <a href="/pilotos/" class="r-btn" style="border-color:var(--r-line);color:var(--r-text)" data-i18n="nav.drivers">Pilotos</a>
        <a href="/garage/" class="r-btn" style="border-color:var(--r-line);color:var(--r-text)" data-i18n="nav.garage">Garage</a>
        <a href="/noticias/" class="r-btn" style="border-color:var(--r-line);color:var(--r-text)" data-i18n="nav.news">Noticias</a>
        <a href="/paddock/" class="r-btn" style="border-color:var(--r-line);color:var(--r-text)" data-i18n="nav.paddock">Paddock</a>
      </div>
    </div>
  </section>
</Layout>
