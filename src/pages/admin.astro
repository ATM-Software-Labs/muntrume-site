---
import Layout from '../layouts/Layout.astro';
import catalog from '../../public/assets/data/catalog_index.json';
import { PILOTOS } from '../lib/pilotos';

const fmt = (n: number) => n.toLocaleString('en-US');
const totalSetups = catalog.total_setups || 42654;
const totalCars = catalog.cars?.length || 105;
const totalCircuits = catalog.circuits?.length || 128;
---

<Layout
  title="Race Control | Consola de Administración · Muntrume Motorsport"
  description="Consola de dirección de equipo y administración técnica de Muntrume Motorsport: gestión de pilotos D1, auditoría BoP 26S4, nomenclatura MMT, NEC VLN y buzones @muntru.me."
  noindex={true}
>
  <Fragment slot="head">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('mrt_vault_token') || sessionStorage.getItem('mrt_vault_token');
          var u = localStorage.getItem('mrt_vault_user') || sessionStorage.getItem('mrt_vault_user');
          if (!t || t === 'guest_token' || !u) {
            window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
            return;
          }
          var parsed = JSON.parse(u);
          var email = parsed && parsed.email ? String(parsed.email).trim().toLowerCase() : '';
          if (email !== 'atrumin16@gmail.com' && parsed.role !== 'admin') {
            window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
          }
        } catch (e) {
          window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/garage?auth=admin" />
    </noscript>
  </Fragment>

  <div class="rc-shell" id="rcShell">
    <!-- Top Sub-Header / Telemetry Command Bar -->
    <div class="rc-topbar">
      <div class="r-wrap rc-topbar__inner">
        <div class="rc-brand">
          <span class="rc-badge rc-badge--live">
            <span class="rc-dot"></span>
            RACE CONTROL v4.2
          </span>
          <div class="rc-brand__titles">
            <h1 class="rc-brand__title">Consola de Dirección &amp; Telemetría</h1>
            <p class="rc-brand__sub">Alberto Trujillo (#16 · Team Principal) · <code id="rcSessionEmail">atrumin16@gmail.com</code></p>
          </div>
        </div>

        <div class="rc-search-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
          <input
            type="search"
            id="adminGlobalSearch"
            class="rc-search-input"
            placeholder="Buscar piloto, setup MMT, circuito, buzón o log… (Pulsa '/' para enfocar)"
            aria-label="Buscar en Race Control"
          />
          <kbd class="rc-kbd">/</kbd>
        </div>

        <div class="rc-topbar__actions">
          <span id="rcBackendBadge" class="rc-badge rc-badge--ok" title="Estado de conexión con Cloudflare D1 y Worker">
            <span class="rc-dot"></span>
            <span id="rcBackendBadgeText">D1 Edge: Online</span>
          </span>
          <a href="/garage" class="r-btn r-btn--sm">Ir al Garage →</a>
          <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
          <button type="button" class="r-btn r-btn--sm" style="border-color:rgba(239,68,68,0.4);color:#f87171" onclick="secureAdminLogout()" title="Cerrar sesión de administrador de forma segura">
            🔒 Salir
          </button>
        </div>
      </div>
    </div>

    <!-- Main Workspace Grid (Sidebar + Active Module) -->
    <div class="r-wrap rc-workspace">
      <!-- Left Navigation Sidebar -->
      <aside class="rc-sidebar" aria-label="Módulos de Race Control">
        <div class="rc-sidebar__group">
          <p class="rc-sidebar__label">Módulos de Control</p>
          <nav class="rc-nav" role="tablist" aria-label="Secciones de administración">
            <button type="button" id="nav-overview" data-rc-tab="overview" class="rc-nav__btn is-active" onclick="switchAdminTab('overview')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
              <span>Panel General</span>
              <span class="rc-nav__pill">LIVE</span>
            </button>
            <button type="button" id="nav-directory" data-rc-tab="directory" class="rc-nav__btn" onclick="switchAdminTab('directory')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Directorio &amp; Altas</span>
              <span id="sidebarPendingBadge" class="rc-nav__pill">4</span>
            </button>
            <button type="button" id="nav-setups" data-rc-tab="setups" class="rc-nav__btn" onclick="switchAdminTab('setups')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-6"/></svg>
              <span>Vault MMT &amp; NEC BoP</span>
              <span class="rc-nav__pill">42.6k</span>
            </button>
            <button type="button" id="nav-domains" data-rc-tab="domains" class="rc-nav__btn" onclick="switchAdminTab('domains')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>Buzones @muntru.me</span>
              <span class="rc-nav__pill">5</span>
            </button>
            <button type="button" id="nav-iracing" data-rc-tab="iracing" class="rc-nav__btn" onclick="switchAdminTab('iracing')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              <span>iRacing Sync Bridge</span>
            </button>
            <button type="button" id="nav-security" data-rc-tab="security" class="rc-nav__btn" onclick="switchAdminTab('security')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Seguridad &amp; Auditoría</span>
            </button>
          </nav>
        </div>

        <div class="rc-sidebar__card">
          <div class="rc-sidebar__card-head">
            <span class="rc-dot"></span>
            <span>INFRAESTRUCTURA EDGE</span>
          </div>
          <dl class="rc-sidebar__dl">
            <div><dt>Dominio</dt><dd>muntru.me</dd></div>
            <div><dt>Base D1</dt><dd id="rcSidebarD1Status">Sincronizada</dd></div>
            <div><dt>Escrutinio BoP</dt><dd class="rc-accent">100% PASS TECH</dd></div>
            <div><dt>NEC VLN 26S4</dt><dd>W01–W13 (1,638)</dd></div>
          </dl>
          <div class="rc-sidebar__btns">
            <button type="button" class="r-btn r-btn--sm" style="width:100%" onclick="refreshRaceControlData()">↻ Sincronizar D1 Ahora</button>
          </div>
        </div>
      </aside>

      <!-- Right Content Area -->
      <div class="rc-main">
        <!-- Notice Banner (Feedback for Admin Operations) -->
        <div id="rcFeedbackBanner" class="m-notice m-notice--info hidden" role="status">
          <div class="m-notice__body">
            <p class="m-notice__title" id="rcFeedbackTitle">Estado</p>
            <p class="m-notice__msg" id="rcFeedbackMsg"></p>
          </div>
          <button type="button" class="m-notice__close" onclick="hideRcNotice()" aria-label="Cerrar">×</button>
        </div>

        <!-- =============================================================== -->
        <!-- TAB 1: PANEL GENERAL (OVERVIEW)                                 -->
        <!-- =============================================================== -->
        <section id="tab-overview" class="rc-panel space-y-6">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Centro de Mando · Tiempo Real</p>
              <h2 class="r-h3">Estado Global de Muntrume Motorsport</h2>
              <p class="rc-muted">Supervisión unificada de pilotos oficiales, escrutinio BoP 26S4, catálogo MMT (.STO), paquetes semanales NEC VLN y correo institucional.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--sm" onclick="openEmailPreviewModal('welcome')">✉️ Plantillas Correo</button>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
            </div>
          </div>

          <!-- 4 KPI Cards -->
          <div class="rc-kpi-grid">
            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">PLANTILLA &amp; ACCESOS</span>
                <span class="rc-badge rc-badge--ok" id="kpiDriversBadge">D1 Activo</span>
              </div>
              <div class="rc-kpi-val" id="kpiDriversCount">{PILOTOS.length}</div>
              <p class="rc-kpi-sub" id="kpiPendingSub">Pilotos titulares con acceso verificado (0 solicitudes pendientes)</p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('directory')">Gestionar Directorio →</button>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">VAULT MMT (.STO)</span>
                <span class="rc-badge rc-badge--ok">26S4</span>
              </div>
              <div class="rc-kpi-val" id="kpiSetupsCount">{fmt(totalSetups)}</div>
              <p class="rc-kpi-sub">{totalCars} coches · {totalCircuits} circuitos · Nomenclatura oficial <code>MMT_</code></p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('setups')">Auditar Setups &amp; BoP →</button>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">ESPECIAL NEC · VLN</span>
                <span class="rc-badge rc-badge--ok">W01–W13</span>
              </div>
              <div class="rc-kpi-val">1,638</div>
              <p class="rc-kpi-sub">Setups en Nürburgring Combined Gesamtstrecke VLN (Altura &ge; 70.5 mm)</p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('setups')">Ver Calendario NEC →</button>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">CORREO &amp; SEGURIDAD</span>
                <span class="rc-badge rc-badge--ok">Zero-Trust</span>
              </div>
              <div class="rc-kpi-val">5 / 100%</div>
              <p class="rc-kpi-sub">5 buzones <code>@muntru.me</code> · 0 Failed Tech · PBKDF2 100k iter.</p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('domains')">Abrir Buzones &amp; DNS →</button>
            </article>
          </div>

          <!-- Roster Oficial en Vivo + Acciones Rápidas -->
          <div class="rc-card">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Plantilla Oficial &amp; Telemetría en Vivo (iRacing / Garage 61)</h3>
                <p class="rc-muted">Datos sincronizados desde <code>/api/drivers</code> y vinculación de cuenta del Setup Vault.</p>
              </div>
              <div class="rc-btn-row">
                <a href="/drivers" class="r-btn r-btn--sm">Ver Roster Público ↗</a>
                <button type="button" class="r-btn r-btn--sm" onclick="switchAdminTab('directory')">Directorio Completo →</button>
              </div>
            </div>
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Dorsal &amp; Piloto</th>
                    <th>Rol Institucional</th>
                    <th>Buzón @muntru.me</th>
                    <th>Sports Car iRating / SR</th>
                    <th>Estado Vault</th>
                    <th class="text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="overviewRosterBody">
                  {PILOTOS.map((p) => (
                    <tr>
                      <td>
                        <div class="rc-user-cell">
                          <span class="rc-avatar">#{p.dorsal}</span>
                          <div>
                            <div class="rc-strong">{p.fullName}</div>
                            <div class="rc-mono-sub">cust_id: {p.cust_id || 'Pendiente'}</div>
                          </div>
                        </div>
                      </td>
                      <td><span class="rc-badge">{p.role}</span></td>
                      <td><code>{p.slug === 'albertot' ? 'alberto@muntru.me' : p.slug === 'mateob' ? 'mateo@muntru.me' : p.slug === 'eduardoc' ? 'eduardo@muntru.me' : 'juanlu@muntru.me'}</code></td>
                      <td><span class="rc-mono-sub">Sincronizando…</span></td>
                      <td><span class="rc-badge rc-badge--ok">Verificado</span></td>
                      <td class="text-right">
                        <a href={`/drivers/${p.slug}/`} class="r-btn r-btn--sm">Perfil ↗</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Two-Column Operational Summary: BoP Health & Recent Activity -->
          <div class="rc-two-col">
            <div class="rc-card">
              <div class="rc-card__head">
                <div>
                  <h3 class="rc-card__title">✓ Estado de Escrutinio BoP 26S4 &amp; Nomenclatura MMT</h3>
                  <p class="rc-muted">Auditoría automática sobre los {fmt(totalSetups)} archivos <code>.sto</code> del Vault.</p>
                </div>
                <span class="rc-badge rc-badge--ok">0 FAILED TECH</span>
              </div>
              <ul class="rc-check-list">
                <li>
                  <span>Estructura Oficial <code>MMT_[MODELO]_[CIRCUITO]_[SESIÓN].sto</code></span>
                  <strong class="rc-accent">42,654 / 42,654 (100%)</strong>
                </li>
                <li>
                  <span>Alturas Estáticas y Caídas dentro de límites iRacing 26S4</span>
                  <strong class="rc-accent">PASS TECH (100%)</strong>
                </li>
                <li>
                  <span>Nürburgring Combined Gesamtstrecke VLN (Altura NEC &ge; 70.5 mm)</span>
                  <strong class="rc-accent">1,638 / 1,638 OK</strong>
                </li>
                <li>
                  <span>Presión Fría Mínima (&ge; 151.7 kPa Dry / &ge; 165.5 kPa Wet)</span>
                  <strong class="rc-accent">Verificado</strong>
                </li>
                <li>
                  <span>Marca de agua institucional UTF-16LE (<code>muntru.me</code>)</span>
                  <strong class="rc-accent">Activa en descarga</strong>
                </li>
              </ul>
            </div>

            <div class="rc-card">
              <div class="rc-card__head">
                <div>
                  <h3 class="rc-card__title">Actividad Reciente en Race Control</h3>
                  <p class="rc-muted">Últimos eventos registrados en Cloudflare D1 y consola.</p>
                </div>
                <button type="button" class="r-btn r-btn--sm" onclick="switchAdminTab('security')">Ver Auditoría →</button>
              </div>
              <ul id="overviewActivityList" class="rc-activity-list"></ul>
            </div>
          </div>
        </section>

        <!-- =============================================================== -->
        <!-- TAB 2: DIRECTORIO DE PILOTOS, SOLICITUDES & ALTAS D1            -->
        <!-- =============================================================== -->
        <section id="tab-directory" class="rc-panel space-y-6 hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Gestión de Miembros · Cloudflare D1</p>
              <h2 class="r-h3">Directorio de Pilotos &amp; Solicitudes de Acceso</h2>
              <p class="rc-muted">Autoriza solicitudes de ingreso al Garage, genera enlaces únicos de contraseña (72 h) o contraseñas temporales de 1 uso y administra permisos.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--sm" onclick="refreshRaceControlData()">↻ Actualizar D1</button>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
            </div>
          </div>

          <!-- Solicitudes Pendientes (Se muestra si hay pendientes o al filtrar) -->
          <div id="pendingRequestsCard" class="rc-card hidden" style="border-left:3px solid var(--r-accent)">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Solicitudes de Acceso Pendientes de Aprobación</h3>
                <p class="rc-muted">Solicitudes enviadas desde el formulario «Solicitar acceso» de <code>/garage</code>.</p>
              </div>
              <span id="pendingRequestsCountBadge" class="rc-badge rc-badge--warn">0 pendientes</span>
            </div>
            <div id="pendingRequestsList" class="space-y-3"></div>
          </div>

          <!-- Filtros de Directorio -->
          <div class="rc-toolbar">
            <div class="g-views" role="group" aria-label="Filtrar miembros">
              <button type="button" id="dirFilter-all" class="is-on" onclick="filterDirectory('all')">Todos</button>
              <button type="button" id="dirFilter-active" onclick="filterDirectory('active')">Titulares Activos</button>
              <button type="button" id="dirFilter-admin" onclick="filterDirectory('admin')">Administradores</button>
              <button type="button" id="dirFilter-pending" onclick="filterDirectory('pending')">Solicitudes</button>
            </div>
            <div class="rc-search-inline">
              <input
                type="search"
                id="directorySearchInput"
                class="g-search"
                placeholder="Filtrar por nombre, correo, dorsal o rol…"
                oninput="renderDirectoryTable()"
              />
            </div>
          </div>

          <div class="rc-card">
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Piloto &amp; Identidad</th>
                    <th>Correo de Acceso / Buzón</th>
                    <th>Rol &amp; Dorsal</th>
                    <th>Licencia / Telemetría</th>
                    <th>Estado Credencial</th>
                    <th class="text-right">Acciones de Cuenta</th>
                  </tr>
                </thead>
                <tbody id="directoryTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- =============================================================== -->
        <!-- TAB 3: VAULT SETUPS, NOMENCLATURA MMT & ESPECIAL NEC VLN        -->
        <!-- =============================================================== -->
        <section id="tab-setups" class="rc-panel space-y-6 hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Ingeniería de Pista · BoP 26S4</p>
              <h2 class="r-h3">Vault Setups, Nomenclatura MMT &amp; Especial NEC VLN</h2>
              <p class="rc-muted">Inspector de cumplimiento del estándar <code>MMT_[MODELO]_[CIRCUITO]_[SESIÓN]_[VERSIÓN].sto</code> y verificación de escrutinio técnico sin <em>Failed Tech</em>.</p>
            </div>
            <div class="rc-btn-row">
              <a href="/garage" class="r-btn r-btn--primary r-btn--sm">Abrir Catálogo en /garage →</a>
            </div>
          </div>

          <!-- Interactive MMT Nomenclature Generator & Live BoP Validator -->
          <div class="rc-card" style="border-left:3px solid var(--r-accent)">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">🔬 Simulador de Nomenclatura Oficial MMT &amp; Escrutinio BoP</h3>
                <p class="rc-muted">Prueba cualquier combinación de modelo, circuito, sesión y versión para validar su nombre oficial y sus parámetros técnicos BoP 26S4.</p>
              </div>
              <span class="rc-badge rc-badge--ok">PASS TECH · 0 FAILED TECH</span>
            </div>

            <div class="rc-sim-grid">
              <div class="g-field">
                <label for="simCarSelect">Modelo MMT</label>
                <select id="simCarSelect" onchange="updateMmtSimulator()">
                  <option value="ferrari296gt3">F296 · Ferrari 296 GT3</option>
                  <option value="porsche992rgt3">P911 · Porsche 911 GT3 R (992)</option>
                  <option value="bmwm4gt3">M4 · BMW M4 GT3</option>
                  <option value="mercedesamgevogt3">AMG · Mercedes-AMG GT3 2020</option>
                  <option value="audir8lmsevo2gt3">R8 · Audi R8 LMS EVO II GT3</option>
                  <option value="lamborghinievogt3">LAMBO · Lamborghini Huracán GT3 EVO</option>
                  <option value="mclaren720sgt3">MACLA · McLaren 720S GT3 EVO</option>
                  <option value="chevyvettez06rgt3">Z06 · Chevrolet Corvette Z06 GT3.R</option>
                  <option value="fordmustanggt3">MUST · Ford Mustang GT3</option>
                  <option value="amvantageevogt3">AMR · Aston Martin Vantage GT3 EVO</option>
                  <option value="amvalkyriegtp">VALK · Aston Martin Valkyrie AMR-LMH</option>
                  <option value="ferrari499p">F499P · Ferrari 499P Hypercar</option>
                  <option value="cadillacvseriesrgtp">CADDY · Cadillac V-Series.R GTP</option>
                  <option value="porsche963gtp">P963 · Porsche 963 GTP</option>
                  <option value="bmwlmdh">BMWH · BMW M Hybrid V8 GTP</option>
                  <option value="acuraarx06gtp">ACURA · Acura ARX-06 GTP</option>
                  <option value="porsche718gt4">PORS · Porsche 718 Cayman GT4</option>
                  <option value="audirs3lmsgen2">RS3 · Audi RS 3 LMS TCR</option>
                  <option value="hyundaielantracn7">HYUN · Hyundai Elantra N TCR</option>
                  <option value="hondacivictyper">CIVIC · Honda Civic Type R TCR</option>
                  <option value="toyotagr86">GR86 · Toyota GR86 Cup</option>
                  <option value="superformulasf23 toyota">SF23 · Super Formula SF23</option>
                  <option value="dallaraf3">F3 · Dallara F3</option>
                  <option value="formulair04">F4 · FIA F4</option>
                  <option value="raygr22">FF1600 · Ray FF1600</option>
                  <option value="mx5 cup">MX5 · Global Mazda MX-5 Cup</option>
                </select>
              </div>

              <div class="g-field">
                <label for="simCircuitSelect">Circuito</label>
                <select id="simCircuitSelect" onchange="updateMmtSimulator()">
                  <option value="Nürburgring Combined Gesamtstrecke VLN">VLN · Nürburgring Combined Gesamtstrecke VLN (NEC)</option>
                  <option value="Spa">SPA · Circuit de Spa-Francorchamps</option>
                  <option value="Le Mans">LEMANS · Circuit des 24 Heures du Mans</option>
                  <option value="Daytona">DAYTONA · Daytona International Speedway</option>
                  <option value="Sebring">SEBRING · Sebring International Raceway</option>
                  <option value="Watkins Glen">WGLEN · Watkins Glen International</option>
