                  <option value="tracks">Circuitos más corridos</option>
                  <option value="licenses">Licencias iRacing</option>
                </select>
                <label class="r-btn r-btn--sm" for="umG61FileInput" style="cursor:pointer">Elegir foto…</label>
                <input type="file" id="umG61FileInput" accept="image/png,image/jpeg,image/webp" class="hidden" onchange="handleG61FileSelected(event)" />
                <button type="button" id="umG61AnalyzeBtn" class="r-btn r-btn--primary r-btn--sm" onclick="analyzeG61Screenshot()" disabled>Analizar y recalcular</button>
              </div>
            </div>
            <div id="umG61PreviewWrap" class="rc-g61-preview hidden">
              <img id="umG61PreviewImg" alt="Vista previa captura Garage 61" />
              <span id="umG61StatusMsg" class="rc-mono-sub">Lista para analizar con Visión IA.</span>
            </div>
          </div>

          <div class="rc-two-col" style="gap:12px">
            <div class="g-field">
              <label for="umFavoriteTrack">Circuito favorito</label>
              <input type="text" id="umFavoriteTrack" maxlength="90" placeholder="Se autocompleta con el #1 de Garage 61" />
            </div>
            <div class="g-field">
              <label for="umTotalHours">Horas totales en pista (auto-sumado)</label>
              <input type="number" id="umTotalHours" step="0.1" min="0" placeholder="Ej. 184.5" oninput="recalcUnifiedPilotStats()" />
            </div>
          </div>

          <div class="rc-two-col" style="gap:14px">
            <div class="rc-subcard">
              <div class="rc-subcard__head">
                <strong>Coches más usados</strong>
                <button type="button" class="r-btn r-btn--sm" onclick="addG61ListRow('cars')">+ Añadir coche</button>
              </div>
              <div id="umTopCarsList" class="rc-g61-list"></div>
            </div>

            <div class="rc-subcard">
              <div class="rc-subcard__head">
                <strong>Circuitos más corridos</strong>
                <button type="button" class="r-btn r-btn--sm" onclick="addG61ListRow('tracks')">+ Añadir circuito</button>
              </div>
              <div id="umTopTracksList" class="rc-g61-list"></div>
            </div>
          </div>
        </div>

        <!-- SUBTAB 4: STATS & MEDIA DEL PILOTO (MTI / F1 25) -->
        <div id="umPanel-stats" class="rc-um-panel hidden">
          <div class="rc-stats-banner">
            <div class="rc-stats-ovr-box">
              <span>OVERALL</span>
              <strong id="umOvrBig">—</strong>
            </div>
            <div style="flex:1;min-width:200px">
              <div class="rc-strong">Motor de Media MTI (F1 25)</div>
              <p class="rc-muted" style="margin:3px 0 8px;font-size:12.5px">Se recalcula en tiempo real usando el iRating, Safety Rating y las horas acumuladas de Garage 61 (máximo 98).</p>
              <div class="rc-btn-row">
                <label class="g-check" for="umStatsAuto" style="margin:0">
                  <input type="checkbox" id="umStatsAuto" checked onchange="toggleUnifiedStatsAuto()" />
                  Recalcular automáticamente
                </label>
                <button type="button" class="r-btn r-btn--sm" onclick="recalcUnifiedPilotStats(true)">↻ Recalcular ahora</button>
              </div>
            </div>
          </div>

          <div class="rc-stats-inputs">
            <div class="g-field">
              <label for="umStatOverall">OVERALL (1–98)</label>
              <input type="number" id="umStatOverall" min="1" max="98" oninput="syncOvrBigFromInput()" />
            </div>
            <div class="g-field">
              <label for="umStatPace">PACE (1–98)</label>
              <input type="number" id="umStatPace" min="1" max="98" />
            </div>
            <div class="g-field">
              <label for="umStatAwareness">AWARENESS (1–98)</label>
              <input type="number" id="umStatAwareness" min="1" max="98" />
            </div>
            <div class="g-field">
              <label for="umStatRacecraft">RACECRAFT (1–98)</label>
              <input type="number" id="umStatRacecraft" min="1" max="98" />
            </div>
            <div class="g-field">
              <label for="umStatExperience">EXPERIENCE (1–98)</label>
              <input type="number" id="umStatExperience" min="1" max="98" />
            </div>
          </div>
        </div>

        <!-- Sticky Modal Footer -->
        <div class="rc-modal-foot">
          <div class="rc-mono-sub" id="umLiveSummary">iRating: — · Horas: — · OVR: —</div>
          <div class="rc-btn-row">
            <button type="button" class="r-btn r-btn--sm" onclick="closeUnifiedPilotModal()">Cancelar</button>
            <button type="submit" id="umSubmitBtn" class="r-btn r-btn--primary r-btn--sm">Guardar todo en D1</button>
          </div>
        </div>
      </form>
    </div>
  </div>

