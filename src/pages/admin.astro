---
import Layout from '../layouts/Layout.astro';
import catalog from '../../public/assets/data/catalog_index.json';

const fmt = (n: number) => n.toLocaleString('es-ES');
const totalSetups = Number(catalog.total_setups) || 0;
const totalCars = catalog.cars?.length || 0;
const totalCircuits = catalog.circuits?.length || 0;
const seasons = Array.isArray(catalog.seasons) ? catalog.seasons.join(', ') : '';
---

<Layout
  title="Administración · Muntrume Motorsport"
  description="Cuentas del Setup Vault, solicitudes de acceso y catálogo de setups de Muntrume Motorsport."
  noindex={true}
>
  <Fragment slot="head">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('mrt_vault_token') || sessionStorage.getItem('mrt_vault_token');
          var u = localStorage.getItem('mrt_vault_user') || sessionStorage.getItem('mrt_vault_user');
          if (!t || t === 'guest_token' || !u) {
            window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
            return;
          }
          var parsed = JSON.parse(u);
          var email = parsed && parsed.email ? String(parsed.email).trim().toLowerCase() : '';
          if (email !== 'atrumin16@gmail.com' && parsed.role !== 'admin') {
            window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
          }
        } catch (e) {
          window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/garage?auth=admin" />
    </noscript>
  </Fragment>

  <div class="rc-shell" id="rcShell">
    <!-- Top Sub-Header / Telemetry Command Bar -->
    <div class="rc-topbar">
      <div class="r-wrap rc-topbar__inner">
        <div class="rc-brand">
          <span class="rc-badge rc-badge--live">
            <span class="rc-dot"></span>
            RACE CONTROL v4.2
          </span>
          <div class="rc-brand__titles">
            <h1 class="rc-brand__title">Administración del Setup Vault</h1>
            <p class="rc-brand__sub">Alberto Trujillo (#16 · Team Principal) · <code id="rcSessionEmail">atrumin16@gmail.com</code></p>
          </div>
        </div>

        <div class="rc-search-box">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
          <input
            type="search"
            id="adminGlobalSearch"
            class="rc-search-input"
            placeholder="Buscar por nombre o correo… (Pulsa '/' para enfocar)"
            aria-label="Buscar en Race Control"
          />
          <kbd class="rc-kbd">/</kbd>
        </div>

        <div class="rc-topbar__actions">
          <span id="rcBackendBadge" class="rc-badge rc-badge--ok" title="Estado de conexión con Cloudflare D1 y Worker">
            <span class="rc-dot"></span>
            <span id="rcBackendBadgeText">Comprobando…</span>
          </span>
          <a href="/garage" class="r-btn r-btn--sm">Ir al Garage →</a>
          <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
          <button type="button" class="r-btn r-btn--sm" style="border-color:rgba(239,68,68,0.4);color:#f87171" onclick="secureAdminLogout()" title="Cerrar sesión de administrador de forma segura">
            🔒 Salir
          </button>
        </div>
      </div>
    </div>

    <!-- Main Workspace Grid (Sidebar + Active Module) -->
    <div class="r-wrap rc-workspace">
      <!-- Left Navigation Sidebar -->
      <aside class="rc-sidebar" aria-label="Módulos de Race Control">
        <div class="rc-sidebar__group">
          <p class="rc-sidebar__label">Módulos de Control</p>
          <nav class="rc-nav" role="tablist" aria-label="Secciones de administración">
            <button type="button" id="nav-overview" data-rc-tab="overview" class="rc-nav__btn is-active" onclick="switchAdminTab('overview')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
              <span>Panel General</span>
            </button>
            <button type="button" id="nav-directory" data-rc-tab="directory" class="rc-nav__btn" onclick="switchAdminTab('directory')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Directorio &amp; Altas</span>
              <span id="sidebarPendingBadge" class="rc-nav__pill">—</span>
            </button>
            <button type="button" id="nav-setups" data-rc-tab="setups" class="rc-nav__btn" onclick="switchAdminTab('setups')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-6"/></svg>
              <span>Catálogo .sto</span>
              <span class="rc-nav__pill">{fmt(totalSetups)}</span>
            </button>
            <button type="button" id="nav-security" data-rc-tab="security" class="rc-nav__btn" onclick="switchAdminTab('security')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Seguridad &amp; Auditoría</span>
            </button>
          </nav>
        </div>

        <div class="rc-sidebar__card">
          <div class="rc-sidebar__card-head">
            <span class="rc-dot"></span>
            <span>INFRAESTRUCTURA EDGE</span>
          </div>
          <dl class="rc-sidebar__dl">
            <div><dt>Dominio</dt><dd>muntru.me</dd></div>
            <div><dt>Cuentas</dt><dd id="rcSidebarD1Status">—</dd></div>
            <div><dt>Catálogo</dt><dd>{fmt(totalSetups)} .sto</dd></div>
          </dl>
          <div class="rc-sidebar__btns">
            <button type="button" class="r-btn r-btn--sm" style="width:100%" onclick="refreshRaceControlData()">↻ Sincronizar D1 Ahora</button>
          </div>
        </div>
      </aside>

      <!-- Right Content Area -->
      <div class="rc-main">
        <!-- Notice Banner (Feedback for Admin Operations) -->
        <div id="rcFeedbackBanner" class="m-notice m-notice--info hidden" role="status">
          <div class="m-notice__body">
            <p class="m-notice__title" id="rcFeedbackTitle">Estado</p>
            <p class="m-notice__msg" id="rcFeedbackMsg"></p>
          </div>
          <button type="button" class="m-notice__close" onclick="hideRcNotice()" aria-label="Cerrar">×</button>
        </div>

        <!-- =============================================================== -->
        <!-- TAB 1: PANEL GENERAL (OVERVIEW)                                 -->
        <!-- =============================================================== -->
        <section id="tab-overview" class="rc-panel space-y-6">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Setup Vault</p>
              <h2 class="r-h3">Cuentas y catálogo</h2>
              <p class="rc-muted">Cuentas reales de Cloudflare D1, solicitudes de acceso y el catálogo público de setups.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
            </div>
          </div>

          <!-- 4 KPI Cards -->
          <div class="rc-kpi-grid">
            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">PLANTILLA &amp; ACCESOS</span>
                <span class="rc-badge" id="kpiDriversBadge">—</span>
              </div>
              <div class="rc-kpi-val" id="kpiDriversCount">—</div>
              <p class="rc-kpi-sub" id="kpiPendingSub">Cuentas en el Vault</p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('directory')">Gestionar Directorio →</button>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">SOLICITUDES PENDIENTES</span>
                <span class="rc-badge" id="kpiPendingStatusBadge">—</span>
              </div>
              <div class="rc-kpi-val" id="kpiPendingCount">0</div>
              <p class="rc-kpi-sub">Solicitudes de acceso al Vault</p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('directory')">Revisar Solicitudes →</button>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">VAULT MMT (.STO)</span>
                <span class="rc-badge rc-badge--ok">{catalog.seasons?.[0] || "catálogo"}</span>
              </div>
              <div class="rc-kpi-val" id="kpiSetupsCount">{fmt(totalSetups)}</div>
              <p class="rc-kpi-sub">{totalCars} coches · {totalCircuits} circuitos oficiales</p>
              <button type="button" class="rc-kpi-link" onclick="switchAdminTab('setups')">Ver Setups →</button>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">SIN CONTRASEÑA</span>
                <span class="rc-badge" id="kpiNoPasswordBadge">D1</span>
              </div>
              <div class="rc-kpi-val" id="kpiNoPassword">—</div>
              <p class="rc-kpi-sub">Cuentas activas sin contraseña</p>
              <button type="button" class="rc-kpi-link" onclick="refreshRaceControlData()">Sincronizar D1 →</button>
            </article>
          </div>

          <!-- Roster Oficial en Vivo + Acciones Rápidas -->
          <div class="rc-card">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Cuentas del Setup Vault</h3>
                <p class="rc-muted">Listado en vivo de <code>/api/setups/admin/panel</code>. El enlace de contraseña se envía por correo.</p>
              </div>
              <div class="rc-btn-row">
                <a href="/pilotos/" class="r-btn r-btn--sm">Plantilla pública ↗</a>
                <button type="button" class="r-btn r-btn--sm" onclick="switchAdminTab('directory')">Directorio completo →</button>
              </div>
            </div>
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Piloto</th>
                    <th>Rol</th>
                    <th>Último acceso</th>
                    <th>Estado</th>
                    <th class="text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="overviewRosterBody">
                  <tr><td colspan="5" class="r-empty">Cargando cuentas…</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Two-Column Operational Summary: BoP Health & Recent Activity -->
          <div class="rc-two-col">
            <div class="rc-card">
              <div class="rc-card__head">
                <div>
                  <h3 class="rc-card__title">Catálogo público</h3>
                  <p class="rc-muted">Cifras de <code>catalog_index.json</code>, el mismo índice que usa el Garage.</p>
                </div>
                <a href="/garage/" class="r-btn r-btn--sm">Abrir Garage →</a>
              </div>
              <ul class="rc-check-list">
                <li>
                  <span>Archivos .sto</span>
                  <strong class="rc-accent">{fmt(totalSetups)}</strong>
                </li>
                <li>
                  <span>Coches</span>
                  <strong class="rc-accent">{fmt(totalCars)}</strong>
                </li>
                <li>
                  <span>Circuitos</span>
                  <strong class="rc-accent">{fmt(totalCircuits)}</strong>
                </li>
                <li>
                  <span>Temporadas</span>
                  <strong class="rc-accent">{seasons || "—"}</strong>
                </li>
              </ul>
            </div>

            <div class="rc-card">
              <div class="rc-card__head">
                <div>
                  <h3 class="rc-card__title">Actividad de administración</h3>
                  <p class="rc-muted">Últimas filas de <code>admin_audit</code> en D1.</p>
                </div>
                <button type="button" class="r-btn r-btn--sm" onclick="switchAdminTab('security')">Ver Auditoría →</button>
              </div>
              <ul id="overviewActivityList" class="rc-activity-list"></ul>
            </div>
          </div>
        </section>

        <!-- =============================================================== -->
        <!-- TAB 2: DIRECTORIO DE PILOTOS, SOLICITUDES & ALTAS D1            -->
        <!-- =============================================================== -->
        <section id="tab-directory" class="rc-panel space-y-6 hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Gestión de Miembros · Cloudflare D1</p>
              <h2 class="r-h3">Directorio de Pilotos &amp; Solicitudes de Acceso</h2>
              <p class="rc-muted">Aprueba solicitudes y altas. El enlace para crear la contraseña lo envía el sistema; solo se muestra aquí si el correo no sale.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--sm" onclick="refreshRaceControlData()">↻ Actualizar D1</button>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
            </div>
          </div>

          <!-- Solicitudes Pendientes (Se muestra si hay pendientes o al filtrar) -->
          <div id="pendingRequestsCard" class="rc-card hidden" style="border-left:3px solid var(--r-accent)">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Solicitudes de Acceso Pendientes de Aprobación</h3>
                <p class="rc-muted">Solicitudes enviadas desde el formulario «Solicitar acceso» de <code>/garage</code>.</p>
              </div>
              <span id="pendingRequestsCountBadge" class="rc-badge rc-badge--warn">0 pendientes</span>
            </div>
            <div id="pendingRequestsList" class="space-y-3"></div>
          </div>

          <!-- Filtros de Directorio -->
          <div class="rc-toolbar">
            <div class="g-views" role="group" aria-label="Filtrar miembros">
              <button type="button" id="dirFilter-all" class="is-on" onclick="filterDirectory('all')">Todos</button>
              <button type="button" id="dirFilter-active" onclick="filterDirectory('active')">Titulares Activos</button>
              <button type="button" id="dirFilter-admin" onclick="filterDirectory('admin')">Administradores</button>
              <button type="button" id="dirFilter-inactive" onclick="filterDirectory('inactive')">Bloqueadas</button>
              <button type="button" id="dirFilter-pending" onclick="filterDirectory('pending')">Solicitudes</button>
            </div>
            <div class="rc-search-inline">
              <input
                type="search"
                id="directorySearchInput"
                class="g-search"
                placeholder="Filtrar por nombre, correo, dorsal o rol…"
                oninput="renderDirectoryTable()"
              />
            </div>
          </div>

          <div class="rc-card">
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Piloto &amp; Identidad</th>
                    <th>Correo de Acceso</th>
                    <th>Rol &amp; Dorsal</th>
                    <th>Último acceso</th>
                    <th>Estado Credencial</th>
                    <th class="text-right">Acciones de Cuenta</th>
                  </tr>
                </thead>
                <tbody id="directoryTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <section id="tab-setups" class="rc-panel space-y-6 hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Catálogo público</p>
              <h2 class="r-h3">Setups del Garage</h2>
              <p class="rc-muted">Estas cifras salen de <code>catalog_index.json</code>. El listado y la descarga están en el Garage.</p>
            </div>
            <div class="rc-btn-row">
              <a href="/garage/" class="r-btn r-btn--primary r-btn--sm">Abrir el Garage →</a>
            </div>
          </div>
          <div class="rc-card">
            <ul class="rc-check-list">
              <li><span>Archivos .sto</span><strong class="rc-accent">{fmt(totalSetups)}</strong></li>
              <li><span>Coches</span><strong class="rc-accent">{fmt(totalCars)}</strong></li>
              <li><span>Circuitos</span><strong class="rc-accent">{fmt(totalCircuits)}</strong></li>
              <li><span>Temporadas</span><strong class="rc-accent">{seasons || "—"}</strong></li>
            </ul>
          </div>
        </section>

        <!-- =============================================================== -->
        <!-- TAB 6: SEGURIDAD ZERO-TRUST & REGISTROS DE AUDITORÍA            -->
        <!-- =============================================================== -->
        <section id="tab-security" class="rc-panel space-y-6 hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">D1</p>
              <h2 class="r-h3">Registro de administración</h2>
              <p class="rc-muted">Acciones guardadas por el Worker en <code>admin_audit</code>: altas, enlaces de contraseña, bloqueos y bajas.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--sm" onclick="exportAuditLogsCsv()">⬇ Exportar CSV</button>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="refreshRaceControlData()">↻ Refrescar Logs</button>
            </div>
          </div>

          <div class="rc-card">
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Fecha</th>
                    <th>Acción</th>
                    <th>Admin</th>
                    <th>Detalle</th>
                  </tr>
                </thead>
                <tbody id="auditLogsTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL 1: ALTA DE PILOTO / GENERADOR DE INVITACIÓN                     -->
  <!-- ===================================================================== -->
  <div id="addDriverModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="addDriverModalTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="addDriverModalTitle">Alta de Piloto en el Vault</h2>
        <button type="button" class="m-notice__close" onclick="closeAddDriverModal()" aria-label="Cerrar">×</button>
      </div>
      <p>Crea la cuenta en D1 y envía el enlace o la contraseña temporal al correo del piloto.</p>
      <form id="addDriverForm" onsubmit="submitAddDriverForm(event)">
        <div class="g-field">
          <label for="newDriverName">Nombre y Apellido</label>
          <input type="text" id="newDriverName" required placeholder="Ej. Carlos Sainz" />
        </div>
        <div class="g-field">
          <label for="newDriverEmail">Correo Electrónico de Acceso</label>
          <input type="email" id="newDriverEmail" required placeholder="piloto@dominio.com" />
        </div>
        <div class="rc-two-col" style="gap:10px">
          <div class="g-field">
            <label for="newDriverRole">Rol en el Equipo</label>
            <select id="newDriverRole">
              <option value="driver">Piloto</option>
              <option value="admin">Admin</option>
            </select>
          </div>
          <div class="g-field">
            <label for="newDriverMethod">Método de Credencial</label>
            <select id="newDriverMethod">
              <option value="link">Enlace único (72 h)</option>
              <option value="temp_password">Contraseña temporal</option>
            </select>
          </div>
        </div>
        <label class="g-check" for="newDriverSendEmail">
          <input type="checkbox" id="newDriverSendEmail" checked />
          Enviar el correo de acceso (recomendado)
        </label>
        <div class="rc-btn-row" style="justify-content:flex-end;margin-top:8px">
          <button type="button" class="r-btn r-btn--sm" onclick="closeAddDriverModal()">Cancelar</button>
          <button type="submit" id="addDriverSubmitBtn" class="r-btn r-btn--primary r-btn--sm">Autorizar Piloto</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL 2: CREDENCIALES GENERADAS / MENSAJE DE BIENVENIDA COPIABLE      -->
  <!-- ===================================================================== -->
  <div id="credentialsResultModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="credModalTitle">
    <div class="g-dialog g-dialog--wide">
      <div class="g-dialog__bar">
        <h2 id="credModalTitle">El correo no se ha enviado</h2>
        <button type="button" class="m-notice__close" onclick="closeCredentialsResultModal()" aria-label="Cerrar">×</button>
      </div>
      <p id="credModalSub">La cuenta está creada. Copia el enlace o la clave solo para entregarlo por otro medio.</p>
      <div class="rc-cred-box">
        <div class="rc-kpi-tag" id="credSecretLabel">ENLACE DE CONTRASEÑA</div>
        <code id="credSecretCode" class="rc-cred-secret"></code>
      </div>
      <p id="credEmailError" class="rc-muted"></p>
      <div class="rc-btn-row" style="justify-content:flex-end">
        <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="copyCredentialSecretOnly()">Copiar</button>
        <button type="button" class="r-btn r-btn--sm" onclick="closeCredentialsResultModal()">Cerrar</button>
      </div>
    </div>
  </div>

  <style is:global>
    /* Race Control Theme-Adaptive Design System (100% Light & Dark Mode Compatible) */
    .rc-shell {
      min-height: calc(100svh - 64px);
      background: var(--r-bg);
      color: var(--r-text);
      padding-bottom: 64px;
    }
    .rc-topbar {
      background: var(--r-surface);
      border-bottom: 1px solid var(--r-line);
      padding: 16px 0;
    }
    .rc-topbar__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .rc-brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .rc-brand__title {
      margin: 0;
      font: 800 clamp(20px, 2.4vw, 26px)/1 var(--r-display);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: var(--r-text);
    }
    .rc-brand__sub {
      margin: 3px 0 0;
      font: 500 12px/1.3 var(--r-mono);
      color: var(--r-muted);
    }
    .rc-brand__sub code {
      color: var(--r-accent);
      font-weight: 700;
    }
    .rc-search-box {
      flex: 1 1 280px;
      max-width: 440px;
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--r-bg);
      border: 1px solid var(--r-line);
      border-radius: 10px;
      padding: 0 12px;
      min-height: 40px;
      color: var(--r-muted);
      transition: border-color 0.2s;
    }
    .rc-search-box:focus-within {
