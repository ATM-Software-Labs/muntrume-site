---
import Layout from '../layouts/Layout.astro';
import catalog from '../../public/assets/data/catalog_index.json';
import { PILOTOS } from '../lib/pilotos';

const fmt = (n: number) => n.toLocaleString('en-US');
const totalSetups = catalog.total_setups || 42654;
const totalCars = catalog.cars?.length || 105;
const totalCircuits = catalog.circuits?.length || 128;

const LICENSE_CATEGORIES = [
  { key: 'sports_car', label: 'Sports Car', hint: 'GT3, GT4, Cup, Resistencia (principal)' },
  { key: 'formula_car', label: 'Formula Car', hint: 'F4, F3, SF23, IndyCar' },
  { key: 'oval', label: 'Oval', hint: 'NASCAR, Indy Oval, Stock Cars' },
  { key: 'dirt_road', label: 'Dirt Road', hint: 'Rallycross, Pro 2/4 Off-Road' },
  { key: 'dirt_oval', label: 'Dirt Oval', hint: 'Sprint Cars, Midget, Late Model' },
];
---

<Layout
  title="Muntrume Admin | Consola de Equipo · Muntrume Motorsport"
  description="Consola unificada de administración de Muntrume Motorsport: pilotos, roles, 5 licencias iRacing, importador de capturas Garage 61, stats MTI y seguridad D1."
  noindex={true}
>
  <Fragment slot="head">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <script is:inline>
      (function() {
        try {
          var t = localStorage.getItem('mrt_vault_token') || sessionStorage.getItem('mrt_vault_token');
          var u = localStorage.getItem('mrt_vault_user') || sessionStorage.getItem('mrt_vault_user');
          if (!t || t === 'guest_token' || !u) {
            window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
            return;
          }
          var parsed = JSON.parse(u);
          var email = parsed && parsed.email ? String(parsed.email).trim().toLowerCase() : '';
          if (email !== 'atrumin16@gmail.com' && parsed.role !== 'admin') {
            window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
          }
        } catch (e) {
          window.location.replace('/garage?auth=admin&redirect=' + encodeURIComponent(window.location.pathname + window.location.search));
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/garage?auth=admin" />
    </noscript>
  </Fragment>

  <div class="rc-shell" id="rcShell">
    <!-- Sticky Google Admin Top Bar -->
    <div class="rc-topbar">
      <div class="rc-container rc-topbar__inner">
        <div class="rc-brand">
          <div class="rc-brand__icon" aria-hidden="true">
            <img src="/assets/img/icon-192.png" alt="" width="28" height="28" />
          </div>
          <div class="rc-brand__titles">
            <h1 class="rc-brand__title">Muntrume Admin</h1>
            <p class="rc-brand__sub"><code id="rcSessionEmail">alberto@muntru.me</code></p>
          </div>
        </div>

        <div class="rc-search-box">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="M21 21l-4.35-4.35"></path>
          </svg>
          <input
            type="search"
            id="adminGlobalSearch"
            class="rc-search-input"
            placeholder="Buscar piloto, correo, dorsal o rol…"
            aria-label="Buscar en Muntrume Admin"
          />
          <kbd class="rc-kbd">/</kbd>
        </div>

        <div class="rc-topbar__actions">
          <span id="rcBackendBadge" class="rc-badge rc-badge--ok" title="Estado de conexión con Cloudflare D1">
            <span class="rc-dot"></span>
            <span id="rcBackendBadgeText">D1 Online</span>
          </span>
          <a href="/drivers/" class="rc-btn-ghost">Pilotos ↗</a>
          <a href="/garage/" class="rc-btn-ghost">Garage ↗</a>
          <button type="button" class="rc-btn-primary" onclick="openAddDriverModal()">+ Alta piloto</button>
          <button type="button" class="rc-btn-danger" onclick="secureAdminLogout()" title="Cerrar sesión de administrador">Salir</button>
        </div>
      </div>
    </div>

    <!-- Main Google Admin Workspace (3 Clean Sections Only) -->
    <div class="rc-container rc-workspace">
      <aside class="rc-sidebar" aria-label="Navegación de administración">
        <div class="rc-sidebar__group">
          <p class="rc-sidebar__label">Consola</p>
          <nav class="rc-nav" role="tablist" aria-label="Secciones">
            <button type="button" id="nav-overview" data-rc-tab="overview" class="rc-nav__btn is-active" onclick="switchAdminTab('overview')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span>Pilotos &amp; Perfiles</span>
              <span id="sidebarPendingBadge" class="rc-nav__pill">{PILOTOS.length}</span>
            </button>
            <button type="button" id="nav-access" data-rc-tab="access" class="rc-nav__btn" onclick="switchAdminTab('access')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Accesos &amp; Correos</span>
            </button>
            <button type="button" id="nav-security" data-rc-tab="security" class="rc-nav__btn" onclick="switchAdminTab('security')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Seguridad &amp; Logs</span>
            </button>
            <button type="button" id="nav-season" data-rc-tab="season" class="rc-nav__btn" onclick="switchAdminTab('season')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>Nueva Season</span>
            </button>
          </nav>
        </div>

        <div class="rc-sidebar__card">
          <div class="rc-sidebar__card-head">
            <span class="rc-dot"></span>
            <span>ESTADO EN VIVO</span>
          </div>
          <dl class="rc-sidebar__dl">
            <div><dt>Dominio</dt><dd>muntru.me</dd></div>
            <div><dt>Base D1</dt><dd id="rcSidebarD1Status">Sincronizada</dd></div>
            <div><dt>Vault .STO</dt><dd class="rc-accent">{fmt(totalSetups)}</dd></div>
            <div><dt>Steward Bot</dt><dd>Activo</dd></div>
          </dl>
          <button type="button" class="r-btn r-btn--sm" style="width:100%" onclick="refreshRaceControlData()">↻ Sincronizar D1</button>
          <button type="button" class="r-btn r-btn--sm" id="btnStewardBotSweep" style="width:100%" onclick="runStewardBotSweep()">🛡 Pasar Steward Bot</button>
        </div>
      </aside>

      <div class="rc-main">
        <!-- Notice Banner -->
        <div id="rcFeedbackBanner" class="m-notice m-notice--info hidden" role="status">
          <div class="m-notice__body">
            <p class="m-notice__title" id="rcFeedbackTitle">Estado</p>
            <p class="m-notice__msg" id="rcFeedbackMsg"></p>
          </div>
          <button type="button" class="m-notice__close" onclick="hideRcNotice()" aria-label="Cerrar">×</button>
        </div>

        <!-- =============================================================== -->
        <!-- TAB 1: PILOTOS, PERFILES, LICENCIAS & GARAGE 61 (TODO EN UNO)   -->
        <!-- =============================================================== -->
        <section id="tab-overview" class="rc-panel">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Panel Todo en Uno · Cloudflare D1</p>
              <h2 class="r-h3">Pilotos, Licencias, Garage 61 &amp; Cuentas</h2>
              <p class="rc-muted">Edita en un solo modal nombres, roles, las 5 licencias de iRacing, sube capturas de Garage 61 para coches/circuitos y recalcula la media OVR en vivo.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--sm" onclick="refreshRaceControlData()">↻ Actualizar</button>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAddDriverModal()">+ Alta de Piloto</button>
            </div>
          </div>

          <!-- 4 Clean KPIs (including live Team Average iRating & OVR) -->
          <div class="rc-kpi-grid">
            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">CUENTAS D1</span>
                <span class="rc-badge rc-badge--ok" id="kpiDriversBadge">D1 Activo</span>
              </div>
              <div class="rc-kpi-val" id="kpiDriversCount">{PILOTOS.length}</div>
              <p class="rc-kpi-sub" id="kpiPendingSub">Pilotos y cuentas autorizadas</p>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">MEDIA DEL EQUIPO</span>
                <span class="rc-badge rc-badge--ok" id="kpiTeamAvgOvrBadge">OVR —</span>
              </div>
              <div class="rc-kpi-val" id="kpiTeamAvgIr">—</div>
              <p class="rc-kpi-sub" id="kpiTeamAvgSub">iRating medio Sports Car en vivo</p>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">SOLICITUDES</span>
                <span class="rc-badge rc-badge--ok" id="kpiPendingStatusBadge">Al día</span>
              </div>
              <div class="rc-kpi-val" id="kpiPendingCount">0</div>
              <p class="rc-kpi-sub">Pendientes de aprobar en el Vault</p>
            </article>

            <article class="rc-kpi-card">
              <div class="rc-kpi-card__top">
                <span class="rc-kpi-tag">SETUP VAULT</span>
                <span class="rc-badge rc-badge--ok">26S4</span>
              </div>
              <div class="rc-kpi-val">{fmt(totalSetups)}</div>
              <p class="rc-kpi-sub">{totalCars} coches · {totalCircuits} circuitos</p>
            </article>
          </div>

          <!-- Pending Requests (only visible when > 0) -->
          <div id="pendingRequestsCard" class="rc-card hidden" style="border-left:3px solid var(--r-accent)">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Solicitudes de Acceso Pendientes</h3>
                <p class="rc-muted">Aprobación directa desde <code>/garage</code>.</p>
              </div>
              <span id="pendingRequestsCountBadge" class="rc-badge rc-badge--warn">0 pendientes</span>
            </div>
            <div id="pendingRequestsList" class="space-y-3"></div>
          </div>

          <!-- Official Team Profiles (All-in-One: 5 Licenses, Garage 61, OVR Stats) -->
          <div class="rc-card">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Plantilla Oficial · Perfiles, Licencias &amp; Stats en Vivo</h3>
                <p class="rc-muted">Pulsa <strong>Editar todo</strong> en cualquier piloto para cambiar nombre, dorsal, rol, las 5 licencias iRacing, subir foto de Garage 61 y recalcular su media MTI.</p>
              </div>
              <a href="/drivers/" class="r-btn r-btn--sm">Ver Roster Público ↗</a>
            </div>
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Dorsal &amp; Piloto</th>
                    <th>Rol / Ficha</th>
                    <th>Licencias Activas</th>
                    <th>iRating · OVR</th>
                    <th>Garage 61</th>
                    <th class="text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="overviewRosterBody"></tbody>
              </table>
            </div>
          </div>

          <!-- Unified Accounts Directory (D1 allowed_users) -->
          <div class="rc-card">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Directorio de Cuentas &amp; Permisos (Cloudflare D1)</h3>
                <p class="rc-muted">Gestiona todas las cuentas con acceso al Vault, cambia roles, permisos <code>.sto</code> o credenciales.</p>
              </div>
              <div class="rc-toolbar" style="gap:8px">
                <div class="g-views" role="group" aria-label="Filtrar cuentas">
                  <button type="button" id="dirFilter-all" class="is-on" onclick="filterDirectory('all')">Todos</button>
                  <button type="button" id="dirFilter-active" onclick="filterDirectory('active')">Activos</button>
                  <button type="button" id="dirFilter-admin" onclick="filterDirectory('admin')">Admins</button>
                  <button type="button" id="dirFilter-inactive" onclick="filterDirectory('inactive')">Bloqueadas</button>
                </div>
                <input
                  type="search"
                  id="directorySearchInput"
                  class="g-search"
                  style="width:220px"
                  placeholder="Filtrar cuentas…"
                  oninput="renderDirectoryTable()"
                />
              </div>
            </div>
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Usuario</th>
                    <th>Correo de Acceso</th>
                    <th>Rol</th>
                    <th>Categoría / iRating</th>
                    <th>Estado</th>
                    <th class="text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="directoryTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- =============================================================== -->
        <!-- TAB 2: ACCESOS RÁPIDOS & CORREOS @MUNTRU.ME                     -->
        <!-- =============================================================== -->
        <section id="tab-access" class="rc-panel hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Credenciales &amp; Comunicaciones · @muntru.me</p>
              <h2 class="r-h3">Accesos en 1 Clic &amp; Estudio de Correos</h2>
              <p class="rc-muted">Envía enlaces de reseteo de 72 h, genera claves temporales, revoca sesiones o prueba plantillas transaccionales de Resend.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openEmailPreviewModal('welcome')">✉️ Abrir Plantillas de Correo</button>
            </div>
          </div>

          <div class="rc-card" style="border-left:3px solid var(--r-accent)">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">🔑 Centro Rápido de Credenciales</h3>
                <p class="rc-muted">Selecciona el correo del piloto y ejecuta la acción en un clic.</p>
              </div>
              <span class="rc-badge rc-badge--ok">PBKDF2 · Zero-Trust</span>
            </div>
            <div class="rc-quick-reset-bar">
              <div class="rc-quick-reset-inputs">
                <input
                  type="email"
                  id="quickResetEmailInput"
                  list="quickResetDriversDatalist"
                  class="g-search"
                  placeholder="Correo del piloto (ej. mateo@muntru.me)…"
                />
                <datalist id="quickResetDriversDatalist"></datalist>
              </div>
              <div class="rc-btn-row">
                <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="runQuickCredentialAction('send_reset')">✉️ Enviar Link Reset</button>
                <button type="button" class="r-btn r-btn--sm" onclick="runQuickCredentialAction('copy_link')">📋 Copiar Link (72h)</button>
                <button type="button" class="r-btn r-btn--sm" onclick="runQuickCredentialAction('temp_password')">⚡ Clave Temporal</button>
                <button type="button" class="r-btn r-btn--sm" onclick="runQuickCredentialAction('revoke_sessions')">⎋ Cerrar Sesiones</button>
              </div>
            </div>
          </div>

          <div class="rc-card">
            <div class="rc-card__head">
              <div>
                <h3 class="rc-card__title">Buzones Institucionales @muntru.me</h3>
                <p class="rc-muted">Infraestructura Resend + Cloudflare Email Routing con SPF, DKIM y DMARC activos.</p>
              </div>
              <button type="button" class="r-btn r-btn--sm" onclick="openEmailPreviewModal('reset')">Previsualizar correos →</button>
            </div>
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Buzón</th>
                    <th>Titular</th>
                    <th>Función</th>
                    <th>Estado</th>
                    <th class="text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="mailboxesTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- =============================================================== -->
        <!-- TAB 3: SEGURIDAD ZERO-TRUST & LOGS DE AUDITORÍA                 -->
        <!-- =============================================================== -->
        <section id="tab-security" class="rc-panel hidden">
          <div class="rc-section-head">
            <div>
              <p class="r-kicker">Criptografía &amp; Trazabilidad</p>
              <h2 class="r-h3">Seguridad Zero-Trust &amp; Auditoría</h2>
              <p class="rc-muted">Registro cronológico de cambios en perfiles, roles, accesos y moderación automática.</p>
            </div>
            <div class="rc-btn-row">
              <button type="button" class="r-btn r-btn--sm" onclick="exportAuditLogsCsv()">⬇ Exportar CSV</button>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="refreshRaceControlData()">↻ Refrescar</button>
            </div>
          </div>

          <div class="rc-kpi-grid">
            <div class="rc-kpi-card">
              <span class="rc-kpi-tag">CIFRADO</span>
              <div class="rc-kpi-val">PBKDF2</div>
              <p class="rc-kpi-sub">100,000 iteraciones SHA-256</p>
            </div>
            <div class="rc-kpi-card">
              <span class="rc-kpi-tag">RATE LIMITING</span>
              <div class="rc-kpi-val">10 req/m</div>
              <p class="rc-kpi-sub">Protección Edge por IP</p>
            </div>
            <div class="rc-kpi-card">
              <span class="rc-kpi-tag">MARCA DE AGUA .STO</span>
              <div class="rc-kpi-val">UTF-16LE</div>
              <p class="rc-kpi-sub">Firma <code>muntru.me</code></p>
            </div>
            <div class="rc-kpi-card">
              <span class="rc-kpi-tag">STEWARD BOT</span>
              <div class="rc-kpi-val">Auto</div>
              <p class="rc-kpi-sub">Moderación de comentarios</p>
            </div>
          </div>

          <div class="rc-card">
            <div class="rc-card__head">
              <h3 class="rc-card__title">Registro de Actividad</h3>
              <div class="g-views" role="group" aria-label="Filtrar eventos">
                <button type="button" id="auditFilter-all" class="is-on" onclick="filterAuditLogs('all')">Todos</button>
                <button type="button" id="auditFilter-auth" onclick="filterAuditLogs('auth')">Auth</button>
                <button type="button" id="auditFilter-download" onclick="filterAuditLogs('download')">Descargas</button>
                <button type="button" id="auditFilter-admin" onclick="filterAuditLogs('admin')">Admin</button>
              </div>
            </div>
            <div class="r-scroll">
              <table class="r-table">
                <thead>
                  <tr>
                    <th>Fecha / Hora</th>
                    <th>Categoría</th>
                    <th>Actor</th>
                    <th>Detalle</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody id="auditLogsTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- TAB 4: NUEVA SEASON · GENERADOR AUTOMÁTICO DE SETUPS PARA MMT SYNC Y GARAGE -->
        <section id="tab-season" class="rc-section hidden">
          <div class="rc-card">
            <div class="rc-card__head">
              <div>
                <h2>Generador de Nueva Season · MMT Sync &amp; Garage</h2>
                <p class="rc-muted">Sube el <strong>PDF oficial o provisional de iRacing</strong> (<code>SeasonSchedule.pdf</code>) o pega el calendario manualmente. Race Control detecta la temporada, las series, los coches y las semanas, y empareja automáticamente los <code>.sto</code> verificados del Vault en <strong>MMT Sync</strong> y <code>/garage/</code>.</p>
              </div>
            </div>

            <div id="rcSeasonPdfBox" class="rc-pdf-drop" style="margin-bottom:14px">
              <input type="file" id="rcSeasonPdfInput" accept="application/pdf,.pdf" hidden onchange="handleSeasonPdfFile(this.files && this.files[0])" />
              <div class="rc-pdf-drop__top">
                <div>
                  <strong style="font-size:13.5px">Importar calendario desde PDF de iRacing</strong>
                  <p class="rc-muted" id="rcSeasonPdfStatus" style="margin:3px 0 0;font-size:12px">Arrastra aquí el <code>SeasonSchedule.pdf</code> oficial de iRacing o selecciónalo. Se procesa 100% en tu navegador.</p>
                </div>
                <button type="button" id="rcSeasonPdfBtn" class="r-btn r-btn--sm" onclick="document.getElementById('rcSeasonPdfInput')?.click()">📄 Subir PDF iRacing</button>
              </div>
              <div id="rcSeasonPdfPicker" class="rc-pdf-picker hidden">
                <div class="rc-two-col" style="gap:10px;align-items:end">
                  <div class="g-field">
                    <label for="rcSeasonPdfSearch">Filtrar serie del PDF</label>
                    <input type="text" id="rcSeasonPdfSearch" placeholder="Ej. GT Sprint, IMSA, GT4, Porsche Cup, Endurance..." oninput="filterSeasonPdfSeries()" />
                  </div>
                  <div class="g-field">
                    <label for="rcSeasonPdfSeries">Serie detectada</label>
                    <select id="rcSeasonPdfSeries" onchange="applySelectedPdfSeries()"></select>
                  </div>
                </div>
                <div class="rc-pdf-picker__meta">
                  <span id="rcSeasonPdfSeriesMeta" class="rc-muted" style="font-size:12px"></span>
                  <button type="button" class="r-btn r-btn--sm r-btn--primary" onclick="applySelectedPdfSeries()">Cargar serie en el calendario</button>
                </div>
              </div>
            </div>

            <div class="rc-two-col" style="gap:12px;margin-bottom:12px">
              <div class="g-field">
                <label for="rcSeasonCode">Código de Temporada *</label>
                <input type="text" id="rcSeasonCode" value="27S1" maxlength="12" placeholder="Ej. 26S4" />
              </div>
              <div class="g-field">
                <label for="rcSeasonStatus">Estado del calendario</label>
                <select id="rcSeasonStatus">
                  <option value="provisional">Provisional (añade sufijo _PROV)</option>
                  <option value="official">Oficial iRacing (producción)</option>
                </select>
              </div>
            </div>

            <div class="rc-two-col" style="gap:12px;margin-bottom:12px">
              <div class="g-field">
                <label for="rcSeasonPreset">Flota de coches objetivo</label>
                <select id="rcSeasonPreset" onchange="applySeasonCarPreset()">
                  <option value="gt3">GT3 Oficial (11 coches)</option>
                  <option value="imsa">IMSA Multicategoría (GTP + LMP2 + GT3)</option>
                  <option value="gtp">GTP / Hypercar (6 coches)</option>
                  <option value="pcup">Porsche 911 GT3 Cup (992)</option>
                  <option value="lmp2">LMP2 Dallara P217</option>
                  <option value="gt4">GT4 (6 coches)</option>
                  <option value="custom">Personalizada (editar a la derecha)</option>
                </select>
              </div>
              <div class="g-field">
                <label for="rcSeasonCars">Slugs de coches (separados por coma)</label>
                <input type="text" id="rcSeasonCars" value="porsche992rgt3, ferrari296gt3, bmwm4gt3, mercedesamgevogt3, audir8lmsevo2gt3, mclaren720sgt3, lamborghinievogt3, fordmustanggt3, chevyvettez06rgt3, acuransxevo22gt3, amvantageevogt3" />
              </div>
            </div>

            <div class="g-field" style="margin-bottom:12px">
              <label for="rcSeasonSchedule">Calendario iRacing (una semana por línea o JSON)</label>
              <textarea id="rcSeasonSchedule" rows="8" placeholder="Week 1 - Circuit de Spa-Francorchamps&#10;Week 2 - Autodromo Nazionale Monza&#10;Week 3 - Daytona International Speedway&#10;Week 4 - Watkins Glen International&#10;Week 5 - Sebring International Raceway&#10;Week 6 - Nürburgring Grand-Prix-Strecke"></textarea>
            </div>

            <div class="rc-btn-row" style="gap:10px;flex-wrap:wrap">
              <button type="button" id="rcSeasonDryRunBtn" class="r-btn" onclick="runSeasonAutoGenerate(true)">1. Simular emparejamiento (Dry-Run)</button>
              <button type="button" id="rcSeasonPublishBtn" class="r-btn r-btn--primary" onclick="runSeasonAutoGenerate(false)">2. Generar y publicar en MMT Sync + Garage</button>
              <span id="rcSeasonProgress" class="rc-muted" style="font-size:12.5px"></span>
            </div>

            <div id="rcSeasonOutput" style="margin-top:16px" hidden></div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- MODAL UNIFICADO TODO-EN-UNO: PILOTO, LICENCIAS, GARAGE 61 & STATS     -->
  <!-- ===================================================================== -->
  <div id="unifiedPilotModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="unifiedPilotTitle">
    <div class="g-dialog g-dialog--wide rc-modal-dialog rc-modal-dialog--xl">
      <div class="g-dialog__bar">
        <div>
          <h2 id="unifiedPilotTitle">Editor Todo-en-Uno del Piloto</h2>
          <p class="rc-muted" id="unifiedPilotSub" style="margin:2px 0 0;font-size:12px">Identidad, rol, 5 licencias iRacing, captura Garage 61 y recálculo automático de media MTI.</p>
        </div>
        <button type="button" class="m-notice__close" onclick="closeUnifiedPilotModal()" aria-label="Cerrar">×</button>
      </div>

      <!-- Inner Section Pills -->
      <div class="rc-modal-tabs" role="tablist">
        <button type="button" id="umTabBtn-identity" class="is-on" onclick="switchUnifiedModalTab('identity')">1. Identidad &amp; Rol</button>
        <button type="button" id="umTabBtn-licenses" onclick="switchUnifiedModalTab('licenses')">2. Licencias (5)</button>
        <button type="button" id="umTabBtn-g61" onclick="switchUnifiedModalTab('g61')">3. Foto Garage 61</button>
        <button type="button" id="umTabBtn-stats" onclick="switchUnifiedModalTab('stats')">4. Media &amp; Stats</button>
      </div>

      <form id="unifiedPilotForm" class="rc-modal-form" onsubmit="submitUnifiedPilotForm(event)">
        <input type="hidden" id="umSlug" />
        <input type="hidden" id="umOrigEmail" />

        <!-- SUBTAB 1: IDENTIDAD, ROL & CUENTA -->
        <div id="umPanel-identity" class="rc-um-panel">
          <div class="rc-two-col" style="gap:12px">
            <div class="g-field">
              <label for="umFullName">Nombre visible *</label>
              <input type="text" id="umFullName" required maxlength="80" placeholder="Ej. Alberto Trujillo" />
            </div>
            <div class="rc-two-col" style="gap:10px">
              <div class="g-field">
                <label for="umDorsal">Dorsal</label>
                <input type="text" id="umDorsal" maxlength="8" placeholder="#16" />
              </div>
              <div class="g-field">
                <label for="umKind">En parrilla</label>
                <select id="umKind">
                  <option value="driver">Piloto oficial</option>
                  <option value="staff">Staff interno</option>
                </select>
              </div>
            </div>
          </div>

          <div class="rc-two-col" style="gap:12px">
            <div class="g-field">
              <label for="umAccountRole">Rol de cuenta (permisos)</label>
              <select id="umAccountRole">
                <option value="driver">Official Driver (Titular)</option>
                <option value="team_driver">Team Endurance Driver</option>
                <option value="academy">Academy Driver</option>
                <option value="engineer">Race Engineer</option>
                <option value="staff">Staff / Prensa</option>
                <option value="admin">Team Principal / Admin</option>
              </select>
            </div>
            <div class="g-field">
              <label for="umRoleTitle">Cargo visible en la ficha</label>
              <input type="text" id="umRoleTitle" maxlength="80" placeholder="Ej. Team Principal &amp; Lead Telemetry" />
            </div>
          </div>

          <div class="rc-two-col" style="gap:12px">
            <div class="g-field">
              <label for="umEmail">Correo de acceso / vinculado</label>
              <input type="email" id="umEmail" placeholder="piloto@muntru.me" />
            </div>
            <div class="g-field">
              <label for="umCustId">iRacing cust_id</label>
              <input type="text" id="umCustId" inputmode="numeric" maxlength="10" placeholder="Ej. 993381" />
            </div>
          </div>

          <div class="rc-two-col" style="gap:12px">
            <div class="g-field">
              <label for="umSpecialty">Especialidad</label>
              <input type="text" id="umSpecialty" maxlength="120" placeholder="Ej. GT3 &amp; Multiclass Endurance" />
            </div>
            <div class="rc-two-col" style="gap:10px">
              <div class="g-field">
                <label for="umClub">Club iRacing</label>
                <input type="text" id="umClub" maxlength="80" placeholder="Iberia" />
              </div>
              <div class="g-field">
                <label for="umCountry">País</label>
                <input type="text" id="umCountry" maxlength="60" placeholder="Spain" />
              </div>
            </div>
          </div>

          <div class="rc-two-col" style="gap:12px">
            <div class="g-field">
              <label for="umTeam">Equipo / División (cuenta D1)</label>
              <input type="text" id="umTeam" maxlength="80" placeholder="Muntrume Motorsport" />
            </div>
            <div class="g-field">
              <label for="umCarClass">Categoría principal</label>
              <input type="text" id="umCarClass" maxlength="80" placeholder="GT3 · IMSA &amp; NEC" />
            </div>
          </div>

          <div class="g-field">
            <label for="umBio">Biografía pública</label>
            <textarea id="umBio" rows="2" maxlength="400" placeholder="Resumen deportivo del piloto…"></textarea>
          </div>

          <label class="g-check" for="umSetupAccess">
            <input type="checkbox" id="umSetupAccess" checked />
