          </label>
        </div>

        <!-- SUBTAB 2: LAS 5 LICENCIAS DE IRACING -->
        <div id="umPanel-licenses" class="rc-um-panel hidden">
          <p class="rc-muted" style="margin:0">Completa las licencias que tenga activas el piloto. <strong>Sports Car</strong> alimenta el cálculo automático de su media OVR.</p>
          <div class="rc-lic-grid">
            {LICENSE_CATEGORIES.map((cat) => (
              <div class="rc-lic-row" data-lic-row={cat.key}>
                <div class="rc-lic-row__meta">
                  <strong>{cat.label}</strong>
                  <span>{cat.hint}</span>
                </div>
                <select id={`umLicClass-${cat.key}`} aria-label={`Clase ${cat.label}`} onchange="recalcUnifiedPilotStats()">
                  <option value="">Sin licencia</option>
                  <option value="Pro">Pro / WC</option>
                  <option value="Class A">Class A</option>
                  <option value="Class B">Class B</option>
                  <option value="Class C">Class C</option>
                  <option value="Class D">Class D</option>
                  <option value="Rookie">Rookie</option>
                </select>
                <input
                  type="number"
                  id={`umLicSr-${cat.key}`}
                  step="0.01"
                  min="0"
                  max="4.99"
                  placeholder="SR (ej. 3.45)"
                  aria-label={`Safety Rating ${cat.label}`}
                  oninput="recalcUnifiedPilotStats()"
                />
                <input
                  type="number"
                  id={`umLicIr-${cat.key}`}
                  step="1"
                  min="100"
                  max="25000"
                  placeholder="iRating (ej. 2450)"
                  aria-label={`iRating ${cat.label}`}
                  oninput="recalcUnifiedPilotStats()"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- SUBTAB 3: GARAGE 61 SCREENSHOT IMPORTER + EDITABLE CARS & TRACKS -->
        <div id="umPanel-g61" class="rc-um-panel hidden">
          <div class="rc-g61-drop" id="umG61Dropzone">
