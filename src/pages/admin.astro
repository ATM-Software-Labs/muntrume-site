---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Race Control | Muntrume Motorsport";
const pageDescription = "Official Muntrume Motorsport Race Control & Administration Console for driver roster management, security rules, Setup Vault, and mail routing.";
---

<Layout title={pageTitle} description={pageDescription} hideNav={true} hideFooter={true} noindex={true}>
<div class="race-control-console flex-1 flex flex-col min-h-screen bg-[#0b0e13] text-neutral-100">
<!-- Top Google Admin App Bar -->
  <header class="h-16 bg-[#121620] border-b border-white/10 flex items-center justify-between px-4 sm:px-6 flex-shrink-0 z-40">
    <div class="flex items-center gap-3">
      <button class="p-2 rounded-xl hover:bg-white/5 text-neutral-400 hover:text-white transition">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></svg>
      </button>

      <a href="/" class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-600 to-emerald-400 flex items-center justify-center font-black text-white text-sm shadow">
          M
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-sm text-white tracking-tight flex items-center gap-1.5">
            <span>Muntrume</span>
            <span class="text-neutral-500 font-light">|</span>
            <span class="text-neutral-300 font-normal">Race Control</span>
          </span>
          <span class="text-[9px] text-emerald-400 font-mono tracking-wider uppercase font-semibold">
            Team Principal &amp; Administration Console
          </span>
        </div>
      </a>
    </div>

    <!-- Universal Search Bar -->
    <div class="hidden md:flex items-center flex-1 max-w-xl mx-8">
      <div class="relative w-full">
        <input 
          type="text" 
          id="globalSearchInput"
          oninput="handleAdminSearch(this.value)"
          placeholder="Search drivers, domains, security rules, or setups... (Press '/' to focus)" 
          class="w-full bg-[#181e2b] border border-white/10 rounded-2xl px-4 py-2 pl-10 text-xs text-neutral-200 placeholder-neutral-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition"
        >
        <svg class="w-4 h-4 text-neutral-400 absolute left-3.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <span class="absolute right-3 top-2 px-1.5 py-0.5 rounded bg-white/10 text-[10px] text-neutral-400 font-mono">/</span>
      </div>
    </div>

    <!-- Status & Admin Profile -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:flex items-center gap-2 text-[10px] font-mono">
        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-bold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>D1 Vault: Online</span>
        </span>
        <span class="px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-bold">
          TLS 1.3 Active
        </span>
      </div>

      <a href="/garage" class="text-xs px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-neutral-300 font-semibold transition">
        Open Garage Vault
      </a>

      <!-- Super Admin Avatar -->
      <div class="flex items-center gap-2.5 pl-2 border-l border-white/10">
        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-emerald-600 to-emerald-400 border-2 border-emerald-300 flex items-center justify-center font-black font-mono text-xs text-black shadow">
          #16
        </div>
        <div class="hidden xl:block text-left text-xs">
          <div class="font-bold text-white leading-tight">Alberto Trujillo <span class="font-mono text-emerald-400">(atrumin16)</span></div>
          <div class="text-[10px] text-neutral-400 font-mono">atrumin16@gmail.com · Team Principal &amp; Admin</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Workspace: Sidebar + Main Content -->
  <div class="flex-1 flex overflow-hidden">
    
    <!-- Left Navigation Drawer -->
    <aside class="w-60 bg-[#0e1217] border-r border-white/10 flex flex-col justify-between p-3.5 flex-shrink-0">
      <div class="space-y-4">
        <div class="text-[10px] font-bold uppercase tracking-wider text-neutral-500 px-3">
          Centro de Control
        </div>

        <nav class="space-y-1 text-xs">
          <button onclick="switchAdminSection('dashboard')" id="nav-dashboard" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left text-neutral-300 hover:bg-white/5 transition sidebar-link-active font-semibold">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            <span>Página Principal</span>
          </button>

          <button onclick="switchAdminSection('directory')" id="nav-directory" class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-left text-neutral-400 hover:bg-white/5 transition">
            <span class="flex items-center gap-3">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              <span>Directorio Pilotos</span>
            </span>
            <span id="badgePendingReq" class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded-full bg-amber-500/20 text-amber-300">0</span>
          </button>

          <button onclick="switchAdminSection('mail')" id="nav-mail" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left text-neutral-400 hover:bg-white/5 transition">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Buzones @muntru.me</span>
          </button>

          <button onclick="switchAdminSection('setups')" id="nav-setups" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left text-neutral-400 hover:bg-white/5 transition">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
            <span>Setups & Telemetría</span>
          </button>

          <button onclick="switchAdminSection('security')" id="nav-security" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left text-neutral-400 hover:bg-white/5 transition">
            <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            <span>Seguridad & Reglas</span>
          </button>

          <button onclick="switchAdminSection('iracing-sync')" id="nav-iracing-sync" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left text-neutral-400 hover:bg-white/5 transition">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span class="font-bold text-white">iRacing Sync Bridge</span>
          </button>

          <button onclick="switchAdminSection('audit')" id="nav-audit" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-left text-neutral-400 hover:bg-white/5 transition">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Registros de Auditoría</span>
          </button>
        </nav>
      </div>

      <!-- Domain Footnote -->
      <div class="p-3.5 rounded-2xl bg-[#141821] border border-white/5 space-y-1 text-xs">
        <div class="text-[10px] text-neutral-500 font-bold uppercase tracking-wider">Dominio Primario</div>
        <div class="font-mono font-bold text-white text-xs">muntru.me</div>
        <div class="text-[10px] text-emerald-400 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Cloudflare Pro · SSL Activo</span>
        </div>
      </div>
    </aside>

    <!-- Main Admin Dashboard Content Area -->
    <div class="flex-1 bg-[#0b0e13] overflow-y-auto p-6 sm:p-8 space-y-8">
      
      <!-- Section: DASHBOARD (Google Admin Style Cards) -->
      <div id="section-dashboard" class="space-y-8">
        
        <!-- Welcome Banner -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-white/10">
          <div>
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
              Consola de Administración de Muntrume
            </h1>
            <p class="text-xs sm:text-sm text-neutral-400 mt-1">
              Supervisión de directorio de pilotos, buzones @muntru.me, cuotas D1 y seguridad de la organización.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <button onclick="openAddPilotModal()" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs transition flex items-center gap-1.5 shadow-lg shadow-emerald-500/20">
              <span>+ Alta de Piloto</span>
            </button>
            <button onclick="testAdminEmails()" class="px-3.5 py-2 rounded-xl bg-[#181e2b] hover:bg-white/10 border border-white/10 text-xs text-neutral-200 font-bold transition">
              ✉️ Probar Plantillas Correo
            </button>
          </div>
        </div>

        <!-- Google Admin Style KPI Grid Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
          
          <!-- Card 1: Directorio de Usuarios -->
          <div class="gadmin-card p-6 flex flex-col justify-between space-y-4">
            <div class="flex items-start justify-between">
              <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
              </div>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-bold">Usuarios</span>
            </div>
            <div>
              <div class="text-3xl font-black text-white font-mono" id="kpiActiveUsers">4</div>
              <div class="text-xs font-bold text-neutral-300 mt-1">Pilotos Oficiales Activos</div>
              <div class="text-[11px] text-neutral-500 mt-0.5">0 solicitudes pendientes de revisión</div>
            </div>
            <button onclick="switchAdminSection('directory')" class="text-xs text-cyan-400 font-bold hover:underline flex items-center gap-1 pt-2">
              <span>Gestionar Directorio</span>
              <span>→</span>
            </button>
          </div>

          <!-- Card 2: Buzones de Correo @muntru.me -->
          <div class="gadmin-card p-6 flex flex-col justify-between space-y-4">
            <div class="flex items-start justify-between">
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 font-bold">Correo</span>
            </div>
            <div>
              <div class="text-3xl font-black text-white font-mono">5</div>
              <div class="text-xs font-bold text-neutral-300 mt-1">Buzones Institucionales</div>
              <div class="text-[11px] text-neutral-500 mt-0.5">Resend API + Webmail Interno Activo</div>
            </div>
            <a href="/mail" class="text-xs text-amber-400 font-bold hover:underline flex items-center gap-1 pt-2">
              <span>Abrir Webmail</span>
              <span>→</span>
            </a>
          </div>

          <!-- Card 3: Vault D1 & Setups -->
          <div class="gadmin-card p-6 flex flex-col justify-between space-y-4">
            <div class="flex items-start justify-between">
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
              </div>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-bold">Cloudflare D1</span>
            </div>
            <div>
              <div class="text-3xl font-black text-white font-mono">497</div>
              <div class="text-xs font-bold text-neutral-300 mt-1">Setups Servidos desde Vault</div>
              <div class="text-[11px] text-neutral-500 mt-0.5">Marca de agua institucional activa</div>
            </div>
            <button onclick="switchAdminSection('setups')" class="text-xs text-emerald-400 font-bold hover:underline flex items-center gap-1 pt-2">
              <span>Explorar Telemetría</span>
              <span>→</span>
            </button>
          </div>

          <!-- Card 4: Seguridad & Zero-Trust -->
          <div class="gadmin-card p-6 flex flex-col justify-between space-y-4">
            <div class="flex items-start justify-between">
              <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 font-bold">Seguridad</span>
            </div>
            <div>
              <div class="text-3xl font-black text-white font-mono">100k</div>
              <div class="text-xs font-bold text-neutral-300 mt-1">Iteraciones PBKDF2-SHA256</div>
              <div class="text-[11px] text-neutral-500 mt-0.5">Límite de tasa: 10 peticiones/min</div>
            </div>
            <button onclick="switchAdminSection('security')" class="text-xs text-purple-400 font-bold hover:underline flex items-center gap-1 pt-2">
              <span>Auditoría de Acceso</span>
              <span>→</span>
            </button>
          </div>

        </div>

        <!-- Quick Access Pilots Table Preview -->
        <div class="gadmin-card p-6 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-base font-extrabold text-white">Directorio Rápido de Miembros Oficiales</h2>
              <p class="text-xs text-neutral-400">Pilotos titulares con acceso autenticado al Vault y buzón @muntru.me.</p>
            </div>
            <button onclick="switchAdminSection('directory')" class="px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-bold text-white transition">
              Ver todos (4)
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#0b0e13] text-neutral-400 font-bold uppercase text-[10px] tracking-wider border-b border-white/5">
                <tr>
                  <th class="py-3 px-4">Piloto & Rol</th>
                  <th class="py-3 px-4">Correo Institucional</th>
                  <th class="py-3 px-4">Licencia iRacing</th>
                  <th class="py-3 px-4">Estado Cuenta</th>
                  <th class="py-3 px-4 text-right">Acciones Rápidas</th>
                </tr>
              </thead>
              <tbody id="quickPilotsTable" class="divide-y divide-white/5">
                <!-- Rendered by JS -->
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Section: DIRECTORIO DE PILOTOS (DETALLADO) -->
      <div id="section-directory" class="hidden space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
          <div>
            <h1 class="text-2xl font-black text-white">Directorio de Pilotos & Solicitudes</h1>
            <p class="text-xs text-neutral-400 mt-0.5">Aprobación de nuevos aspirantes, reseteo de claves y gestión de roles.</p>
          </div>
          <button onclick="openAddPilotModal()" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs transition">
            + Añadir Piloto al Equipo
          </button>
        </div>

        <!-- Filters Tabs -->
        <div class="flex gap-2 border-b border-white/10 pb-3 text-xs font-bold">
          <button onclick="filterPilotsTab('all')" id="pilotTab-all" class="px-3.5 py-1.5 rounded-xl bg-white/10 text-white">Todos (4)</button>
          <button onclick="filterPilotsTab('active')" id="pilotTab-active" class="px-3.5 py-1.5 rounded-xl text-neutral-400 hover:text-white">Activos (4)</button>
          <button onclick="filterPilotsTab('pending')" id="pilotTab-pending" class="px-3.5 py-1.5 rounded-xl text-neutral-400 hover:text-white">Pendientes (0)</button>
        </div>

        <!-- Detailed Table -->
        <div class="gadmin-card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="bg-[#0b0e13] text-neutral-400 font-bold uppercase text-[10px] tracking-wider border-b border-white/5">
                <tr>
                  <th class="py-3 px-4">Piloto</th>
                  <th class="py-3 px-4">Buzón @muntru.me</th>
                  <th class="py-3 px-4">iRating / Licencia</th>
                  <th class="py-3 px-4">Especialidad</th>
                  <th class="py-3 px-4">Estado</th>
                  <th class="py-3 px-4 text-right">Opciones</th>
                </tr>
              </thead>
              <tbody id="detailedPilotsTable" class="divide-y divide-white/5">
                <!-- Rendered by JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Section: BUZONES @MUNTRU.ME -->
      <div id="section-mail" class="hidden space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-white/10">
          <div>
            <h1 class="text-2xl font-black text-white">Servidor de Correo & Buzones Institucionales</h1>
            <p class="text-xs text-neutral-400 mt-0.5">Gestión de cuentas `@muntru.me`, enrutamiento de briefings y API transaccional.</p>
          </div>
          <a href="/mail" class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 text-black font-extrabold text-xs transition">
            Abrir Cliente Webmail →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="gadmin-card p-5 space-y-2">
            <div class="text-[10px] font-bold text-neutral-500 uppercase">Enrutador DNS</div>
            <div class="text-base font-black text-white">Cloudflare Email Routing</div>
            <div class="text-xs text-emerald-400 font-mono">MX: route1.mx.cloudflare.net</div>
          </div>
          <div class="gadmin-card p-5 space-y-2">
            <div class="text-[10px] font-bold text-neutral-500 uppercase">Proveedor Transaccional</div>
            <div class="text-base font-black text-white">Resend API</div>
            <div class="text-xs text-cyan-400 font-mono">api.resend.com · TLS Verified</div>
          </div>
          <div class="gadmin-card p-5 space-y-2">
            <div class="text-[10px] font-bold text-neutral-500 uppercase">Almacenamiento Local</div>
            <div class="text-base font-black text-white">Base de Datos D1 Vault</div>
            <div class="text-xs text-amber-400 font-mono">Cifrado de Comunicados Internos</div>
          </div>
        </div>

        <div class="gadmin-card p-6 space-y-4">
          <h2 class="text-sm font-extrabold text-white">Buzones Activos del Equipo</h2>
          <div class="divide-y divide-white/5 text-xs font-mono">
            <div class="py-2.5 flex items-center justify-between">
              <span class="text-emerald-400 font-bold">alberto@muntru.me</span>
              <span class="text-neutral-400">Alberto Trujillo (Team Principal) · Ilimitado</span>
            </div>
            <div class="py-2.5 flex items-center justify-between">
              <span class="text-amber-400 font-bold">mateo@muntru.me</span>
