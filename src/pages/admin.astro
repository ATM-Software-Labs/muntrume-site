  <style is:global>
    /* ========================================================================= */
    /* MUNTRUME ADMIN — GOOGLE ADMIN CONSOLE (ALL-IN-ONE, LIGHT & DARK)          */
    /* ========================================================================= */
    .rc-shell {
      min-height: calc(100svh - 60px);
      background: var(--r-bg);
      color: var(--r-text);
      font-family: var(--r-sans, system-ui, -apple-system, sans-serif);
      padding-bottom: 72px;
    }
    .rc-container {
      width: 100%;
      max-width: 1460px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Sticky Top Bar */
    .rc-topbar {
      position: sticky;
      top: 60px;
      z-index: 30;
      background: var(--r-surface);
      border-bottom: 1px solid var(--r-line);
      padding: 12px 0;
    }
    .rc-topbar__inner {
      display: grid;
      grid-template-columns: auto minmax(200px, 480px) auto;
      align-items: center;
      gap: 20px;
    }
    .rc-brand { display: flex; align-items: center; gap: 11px; min-width: 0; }
    .rc-brand__icon {
      width: 36px; height: 36px; border-radius: 10px;
      background: var(--r-bg-2); border: 1px solid var(--r-line);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .rc-brand__icon img { border-radius: 6px; }
    .rc-brand__title { margin: 0; font: 700 16px/1.2 var(--r-sans, system-ui, sans-serif); letter-spacing: -0.02em; color: var(--r-text); white-space: nowrap; }
    .rc-brand__sub { margin: 2px 0 0; font: 500 11.5px/1.2 var(--r-mono); color: var(--r-muted); }

    .rc-search-box {
      width: 100%; display: flex; align-items: center; gap: 10px;
      background: var(--r-bg-2); border: 1px solid var(--r-line);
      border-radius: 999px; padding: 0 16px; height: 40px; color: var(--r-muted);
      transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .rc-search-box:focus-within {
      background: var(--r-surface); border-color: var(--r-accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--r-accent) 16%, transparent);
    }
    .rc-search-input { flex: 1; border: 0 !important; background: transparent !important; padding: 0 !important; color: var(--r-text); font: 400 13.5px/1.3 var(--r-sans, system-ui, sans-serif); outline: none; min-width: 0; }
    .rc-kbd { font: 600 11px/1 var(--r-mono); padding: 3px 7px; border-radius: 6px; border: 1px solid var(--r-line); background: var(--r-surface); color: var(--r-muted); }

