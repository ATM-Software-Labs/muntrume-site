---
import Layout from "../../layouts/Layout.astro";
import "../../styles/support.css";

const title = "Mis solicitudes · Muntrume Support";
const description = "Consulta el estado y el historial de tus solicitudes abiertas en Muntrume Support.";
const canonical = "https://support.muntru.me/requests";
---

<Layout title={title} description={description} canonical={canonical} noindex={true}>
  <main class="sup-page">
    <nav class="sup-subnav" aria-label="Navegación de Soporte">
      <div class="sup-subnav-inner">
        <div class="sup-crumbs">
          <a href="https://support.muntru.me/">Muntrume Support</a>
          <span>›</span>
          <span>Mis solicitudes</span>
        </div>
        <div class="sup-subnav-links">
          <a href="https://support.muntru.me/">Centro de Ayuda</a>
          <a href="https://support.muntru.me/requests/new">Enviar una solicitud</a>
          <a href="https://support.muntru.me/requests" class="is-active">Mis solicitudes</a>
        </div>
      </div>
    </nav>

    <section class="sup-section sup-section-last">
      <div class="sup-wrap">
        <div class="sup-card">
          <div class="sup-req-head">
            <div>
              <span class="sup-kicker" id="sup-req-kicker">Historial de tickets</span>
              <h1 id="sup-req-title">Mis solicitudes</h1>
            </div>
            <div class="sup-req-tools" id="sup-req-tools" hidden>
              <div class="sup-req-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input id="sup-req-filter-q" type="search" placeholder="Buscar por asunto, piloto o #MMT..." aria-label="Buscar solicitudes" />
              </div>
              <select id="sup-req-filter-status" aria-label="Filtrar por estado">
                <option value="all">Estado: Todos</option>
                <option value="open">Abierto</option>
                <option value="in_progress">En curso</option>
                <option value="solved">Resuelto</option>
              </select>
              <select id="sup-req-filter-prio" aria-label="Filtrar por prioridad" hidden>
                <option value="all">Prioridad: Todas</option>
                <option value="critical">Crítica</option>
                <option value="high">Alta</option>
                <option value="normal">Normal</option>
              </select>
              <select id="sup-req-filter-dept" aria-label="Filtrar por departamento" hidden>
                <option value="all">Depto: Todos</option>
                <option value="Soporte">Soporte Técnico</option>
                <option value="Legal">Legal y Privacidad</option>
                <option value="Prensa">Prensa</option>
                <option value="Información">Información</option>
              </select>
              <button type="button" id="sup-req-refresh" class="sup-btn sup-btn-ghost sup-btn-sm" title="Actualizar cola">↻</button>
              <a href="https://support.muntru.me/requests/new" class="sup-btn sup-btn-primary sup-btn-sm">+ Nueva solicitud</a>
            </div>
          </div>

          <div id="sup-staff-panel" class="sup-staff-panel" hidden>
            <div class="sup-staff-bar">
              <div class="sup-scope-tabs" role="tablist" aria-label="Vista de tickets">
                <button type="button" class="sup-scope-tab is-active" data-scope="all">Cola de Técnicos (Todos)</button>
                <button type="button" class="sup-scope-tab" data-scope="mine">Solo mis tickets</button>
              </div>
              <span class="sup-staff-pill">Modo Técnico · Race Control</span>
            </div>
            <div class="sup-kpi-row" id="sup-kpi-row">
              <button type="button" class="sup-kpi-card" data-kpi-status="open"><span>Abiertos</span><strong id="kpi-open">0</strong></button>
              <button type="button" class="sup-kpi-card" data-kpi-status="in_progress"><span>En curso</span><strong id="kpi-prog">0</strong></button>
              <button type="button" class="sup-kpi-card is-crit" data-kpi-prio="critical"><span>Críticos</span><strong id="kpi-crit">0</strong></button>
              <button type="button" class="sup-kpi-card" data-kpi-status="solved"><span>Resueltos</span><strong id="kpi-solved">0</strong></button>
              <button type="button" class="sup-kpi-card" data-kpi-status="all"><span>Total</span><strong id="kpi-total">0</strong></button>
            </div>
          </div>

          <div id="sup-req-anon" class="sup-anon-box" hidden>
            <p>Inicia sesión con tu cuenta de Muntrume para consultar el estado y el historial de tus solicitudes.</p>
            <a href="https://muntru.me/login/?next=https%3A%2F%2Fsupport.muntru.me%2Frequests" class="sup-btn sup-btn-primary">Iniciar sesión</a>
          </div>

          <div id="sup-req-loading" class="sup-muted-state">Comprobando sesión...</div>

          <div id="sup-req-table-wrap" class="sup-table-wrap" hidden>
            <table class="sup-table">
              <thead>
                <tr>
                  <th>Asunto</th>
                  <th id="sup-th-requester" hidden>Solicitante</th>
                  <th>ID</th>
                  <th>Prioridad</th>
                  <th>Departamento</th>
                  <th>Última actividad</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody id="sup-req-tbody"></tbody>
            </table>
          </div>

          <div id="sup-req-empty" class="sup-muted-state" hidden>
            Aún no tienes solicitudes registradas con esta cuenta.
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
(() => {
  try {
    if (location.hash && location.hash.includes("mm_auth=")) {
      const hp = new URLSearchParams(location.hash.slice(1));
      const tk = hp.get("mm_auth");
      const uRaw = hp.get("mm_user");
      if (tk) { localStorage.setItem("mrt_vault_token", tk); localStorage.setItem("mm_token", tk); }
      if (uRaw) { localStorage.setItem("mrt_vault_user", decodeURIComponent(escape(atob(uRaw)))); }
      history.replaceState(null, "", location.pathname + location.search);
    }
  } catch {}

  const API = "https://api.muntru.me";
  const STATUS_META = {
    open: { label: "Abierto", cls: "sup-st-open" },
    in_progress: { label: "En curso", cls: "sup-st-prog" },
    solved: { label: "Resuelto", cls: "sup-st-solved" },
    closed: { label: "Cerrado", cls: "sup-st-solved" },
  };
  function getToken() { try { return localStorage.getItem("mrt_vault_token") || localStorage.getItem("mm_token") || ""; } catch { return ""; } }
  function esc(s) { return String(s || "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])); }
  function relDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const mins = Math.floor((Date.now() - d.getTime()) / 60000);
    if (mins < 1) return "Hace un momento";
    if (mins < 60) return `Hace ${mins} min`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `Hace ${hrs} h`;
    const days = Math.floor(hrs / 24);
    if (days < 30) return `Hace ${days} d`;
    return d.toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" });
  }

  const reqTools = document.getElementById("sup-req-tools");
  const reqAnon = document.getElementById("sup-req-anon");
  const reqLoading = document.getElementById("sup-req-loading");
  const reqTableWrap = document.getElementById("sup-req-table-wrap");
  const reqTbody = document.getElementById("sup-req-tbody");
  const reqEmpty = document.getElementById("sup-req-empty");
  const reqKicker = document.getElementById("sup-req-kicker");
  const reqTitle = document.getElementById("sup-req-title");
  const staffPanel = document.getElementById("sup-staff-panel");
  const thRequester = document.getElementById("sup-th-requester");
  const filterQ = document.getElementById("sup-req-filter-q");
  const filterStatus = document.getElementById("sup-req-filter-status");
  const filterPrio = document.getElementById("sup-req-filter-prio");
  const filterDept = document.getElementById("sup-req-filter-dept");
  const refreshBtn = document.getElementById("sup-req-refresh");
  let allTickets = [];
  let isStaff = false;
  let currentScope = "all";

  const PRIO_META = {
    critical: { label: "Crítica", cls: "is-crit" },
    high: { label: "Alta", cls: "is-high" },
    normal: { label: "Normal", cls: "is-norm" },
  };

  function updateKpis(stats) {
    if (!stats) return;
    document.getElementById("kpi-open").textContent = String(stats.open ?? 0);
    document.getElementById("kpi-prog").textContent = String(stats.in_progress ?? 0);
    document.getElementById("kpi-crit").textContent = String(stats.critical ?? 0);
    document.getElementById("kpi-solved").textContent = String(stats.solved ?? 0);
    document.getElementById("kpi-total").textContent = String(stats.total ?? 0);
  }

  function renderTickets() {
    const q = (filterQ?.value || "").trim().toLowerCase();
    const st = filterStatus?.value || "all";
    const pr = filterPrio?.value || "all";
    const dp = filterDept?.value || "all";
    const showReqCol = isStaff && currentScope === "all";
    if (thRequester) thRequester.hidden = !showReqCol;

    const rows = allTickets.filter((t) => {
      if (st !== "all" && t.status !== st) return false;
      if (pr !== "all" && (t.priority || "normal") !== pr) return false;
      if (dp !== "all" && !String(t.routing_department || "").toLowerCase().includes(dp.toLowerCase())) return false;
      if (q && !(`${t.id} ${t.subject} ${t.routing_department || ""} ${t.category_label || t.category} ${t.user_name || ""} ${t.user_email || ""}`).toLowerCase().includes(q)) return false;
      return true;
    });
    if (!rows.length) {
      reqTableWrap.hidden = true;
      reqEmpty.textContent = allTickets.length
        ? "No hay solicitudes que coincidan con los filtros seleccionados."
        : (showReqCol ? "No hay tickets registrados en la cola de soporte." : "Aún no tienes solicitudes registradas con esta cuenta.");
      reqEmpty.hidden = false;
      return;
    }
    reqEmpty.hidden = true;
    reqTableWrap.hidden = false;
    reqTbody.innerHTML = rows.map((t) => {
      const meta = STATUS_META[t.status] || { label: t.status || "Abierto", cls: "sup-st-open" };
      const pMeta = PRIO_META[t.priority || "normal"] || PRIO_META.normal;
      const isInc = !!t.is_incident;
      const href = `https://support.muntru.me/requests/${encodeURIComponent(t.id)}`;
      const replies = Number(t.reply_count || 0);
      const reqCell = showReqCol
        ? `<td class="sup-td-req"><strong>${esc(t.user_name || "Piloto")}</strong><div class="sup-subj-sub">${esc(t.user_email || "")}</div></td>`
        : "";
      const statusCell = showReqCol
        ? `<td>
            <select class="sup-inline-status ${meta.cls}" data-quick-status="${esc(t.id)}" aria-label="Cambiar estado de ${esc(t.id)}">
              <option value="open" ${t.status === "open" ? "selected" : ""}>Abierto</option>
              <option value="in_progress" ${t.status === "in_progress" ? "selected" : ""}>En curso</option>
              <option value="solved" ${t.status === "solved" ? "selected" : ""}>Resuelto</option>
            </select>
          </td>`
        : `<td><span class="sup-st-pill ${meta.cls}">${esc(meta.label)}</span></td>`;
      return `<tr class="sup-row-clickable" data-href="${href}">
        <td class="sup-td-subj">
          <a href="${href}" class="sup-subj-link">${esc(t.subject)}</a>
          <div class="sup-subj-sub">${esc(t.category_label || t.category)}${replies ? ` · ${replies} ${replies === 1 ? "respuesta" : "respuestas"}` : ""}</div>
        </td>
        ${reqCell}
        <td class="sup-td-id"><code>#${esc(t.id)}</code></td>
        <td><span class="sup-prio-pill ${pMeta.cls}">${esc(pMeta.label)}</span></td>
        <td><span class="sup-inbox-tag ${isInc ? "is-inc" : "is-info"}">${esc(t.routing_department || "Soporte")}</span></td>
        <td class="sup-td-date">${esc(relDate(t.updated_at || t.created_at))}</td>
        ${statusCell}
      </tr>`;
    }).join("");
  }

  reqTbody.addEventListener("click", (e) => {
    if (e.target.closest("a, select, option, button")) return;
    const tr = e.target.closest("tr[data-href]");
    if (tr) location.href = tr.getAttribute("data-href");
  });

  reqTbody.addEventListener("change", async (e) => {
    const sel = e.target.closest("select[data-quick-status]");
    if (!sel) return;
    const id = sel.getAttribute("data-quick-status");
    const nextStatus = sel.value;
    const tok = getToken();
    if (!tok || !id) return;
    sel.disabled = true;
    try {
      const res = await fetch(`${API}/api/support/tickets/reply`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${tok}` },
        body: JSON.stringify({ ticket_id: id, status: nextStatus, message: "" }),
      });
      if (res.ok) {
        await load(currentScope);
      } else {
        sel.disabled = false;
      }
    } catch {
      sel.disabled = false;
    }
  });

  filterQ.addEventListener("input", renderTickets);
  filterStatus.addEventListener("change", renderTickets);
  filterPrio.addEventListener("change", renderTickets);
  filterDept.addEventListener("change", renderTickets);
  refreshBtn.addEventListener("click", () => load(currentScope));

  document.querySelectorAll("[data-scope]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const sc = btn.getAttribute("data-scope") || "all";
      if (sc === currentScope) return;
      currentScope = sc;
      document.querySelectorAll("[data-scope]").forEach((b) => b.classList.toggle("is-active", b === btn));
      load(currentScope);
    });
  });

  document.querySelectorAll("[data-kpi-status], [data-kpi-prio]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const st = btn.getAttribute("data-kpi-status");
      const pr = btn.getAttribute("data-kpi-prio");
      if (st) { filterStatus.value = st; filterPrio.value = "all"; }
      if (pr) { filterPrio.value = pr; filterStatus.value = "all"; }
      renderTickets();
    });
  });

  async function load(scope) {
    const tok = getToken();
    if (!tok) {
      reqLoading.hidden = true;
      reqAnon.hidden = false;
      return;
    }
    try {
      const qs = scope ? `?scope=${encodeURIComponent(scope)}` : "";
      const res = await fetch(`${API}/api/support/tickets/mine${qs}`, { headers: { Authorization: `Bearer ${tok}` } });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) { reqLoading.hidden = true; reqAnon.hidden = false; return; }
      isStaff = !!data.is_staff;
      currentScope = data.scope || (isStaff ? "all" : "mine");
      allTickets = Array.isArray(data.tickets) ? data.tickets : [];
      reqLoading.hidden = true;
      reqTools.hidden = false;
      if (isStaff) {
        staffPanel.hidden = false;
        filterPrio.hidden = false;
        filterDept.hidden = false;
        reqKicker.textContent = "Race Control · Panel de Técnicos";
        reqTitle.textContent = currentScope === "all" ? "Todos los tickets de soporte" : "Mis solicitudes";
        document.querySelectorAll("[data-scope]").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-scope") === currentScope));
        updateKpis(data.stats);
      }
      renderTickets();
    } catch {
      reqLoading.textContent = "No se pudieron cargar las solicitudes ahora mismo.";
    }
  }
  load();
})();
</script>
