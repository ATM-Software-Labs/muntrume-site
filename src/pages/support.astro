---
import Layout from "../layouts/Layout.astro";

const title = "Centro de Ayuda y Soporte · Muntrume Motorsport";
const description = "Centro de Ayuda de Muntrume Motorsport (MMT): soporte técnico para incidencias en support@muntru.me, consultas en info@muntru.me y seguimiento de tus solicitudes.";
const canonical = "https://support.muntru.me/";

const HELP_CARDS = [
  {
    title: "Cuenta, Passkeys y Muntrume Guard",
    desc: "Acceso sin contraseña, códigos OTP, autenticación 2FA (TOTP), aprobación móvil y recuperación de cuenta.",
    href: "/settings/",
    cta: "Ir a Ajustes de cuenta",
    tags: "cuenta passkey guard mfa 2fa totp contraseña login recuperar acceso bloqueado",
  },
  {
    title: "MMT Sync, Overlays 60 FPS y Auto-Fuel",
    desc: "Instalación en Windows, sincronización de setups .sto, telemetría HUD y cálculo automático de gasolina en iRacing.",
    href: "https://docs.muntru.me/mmt-sync/",
    cta: "Abrir guía de MMT Sync",
    tags: "mmt sync app windows overlay hud telemetria auto fuel gasolina combustible iracing",
  },
  {
    title: "Setups .STO y Garage Vault",
    desc: "Cómo descargar, sincronizar y cargar archivos .sto, vueltas fantasma .blap/.olap y paquetes de temporada.",
    href: "/garage/",
    cta: "Abrir Garage Vault",
    tags: "setups sto garage vault descargas blap olap coche circuito temporada",
  },
  {
    title: "Muntrume AI y Documentación Técnica",
    desc: "Guías oficiales de la escudería, API técnica, Copiloto de ingeniería IA y preguntas frecuentes.",
    href: "https://docs.muntru.me/",
    cta: "Explorar docs.muntru.me",
    tags: "ia ai copiloto docs documentacion api guias preguntas frecuentes faq",
  },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="sup-page">
    <!-- Hero Centro de Ayuda -->
    <section class="sup-hero">
      <div class="sup-wrap">
        <div class="sup-hero-inner">
          <span class="sup-eyebrow">Centro de Ayuda · Muntrume Motorsport</span>
          <h1 class="sup-title">¿Necesitas ayuda? Estamos aquí para ayudarte.</h1>
          <p class="sup-subtitle">
            Busca una guía rápida, envía una solicitud ordenada a nuestro equipo técnico o revisa el estado de tus tickets abiertos.
          </p>

          <div class="sup-search-box">
            <svg class="sup-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              id="sup-hero-search"
              type="search"
              placeholder="Buscar ayuda sobre cuentas, MMT Sync, Auto-Fuel, setups..."
              autocomplete="off"
              aria-label="Buscar en el Centro de Ayuda"
            />
          </div>

          <div class="sup-hero-actions">
            <a href="#enviar-solicitud" class="sup-btn sup-btn-primary">Enviar una solicitud</a>
            <a href="#mis-solicitudes" class="sup-btn sup-btn-ghost">Mis solicitudes</a>
            <a href="https://docs.muntru.me/" target="_blank" rel="noopener" class="sup-btn sup-btn-ghost">Docs oficiales ↗</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Tarjetas de temas rápidos -->
    <section class="sup-section">
      <div class="sup-wrap">
        <div class="sup-topics-grid" id="sup-topics-grid">
          {HELP_CARDS.map((card) => (
            <a
              href={card.href}
              target={card.href.startsWith("http") ? "_blank" : undefined}
              rel={card.href.startsWith("http") ? "noopener" : undefined}
              class="sup-topic-card"
              data-tags={card.tags}
            >
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
              <span class="sup-topic-cta">{card.cta} →</span>
            </a>
          ))}
        </div>
        <p id="sup-topics-empty" class="sup-empty-inline" hidden>
          No encontramos una guía exacta para esa búsqueda. Puedes abrir una solicitud directa justo debajo.
        </p>
      </div>
    </section>

    <!-- Enviar una solicitud -->
    <section class="sup-section" id="enviar-solicitud">
      <div class="sup-wrap sup-narrow">
        <div class="sup-card">
          <div class="sup-card-head">
            <div>
              <span class="sup-kicker">Formulario ordenado de soporte</span>
              <h2>Enviar una solicitud</h2>
              <p class="sup-lead">
                Elige el motivo de tu consulta. El sistema clasifica automáticamente el ticket y lo envía a <code>support@muntru.me</code> (incidencias) o <code>info@muntru.me</code> (consultas).
              </p>
            </div>
          </div>

          <form id="sup-form" class="sup-form" novalidate>
            <!-- Selector principal estilo Discord Support -->
            <div class="sup-field">
              <label for="sup-category">¿En qué podemos ayudarte? <span class="req">*</span></label>
              <select id="sup-category" name="category" required>
                <option value="">— Selecciona un tipo de solicitud —</option>
                <optgroup label="Incidencias técnicas y seguridad (→ support@muntru.me)">
                  <option value="cuenta_comprometida">Cuenta comprometida / Robo de acceso (Urgente)</option>
                  <option value="acceso_mfa">Problema de acceso, Passkey, 2FA o Muntrume Guard</option>
                  <option value="bug_mmt_sync">Fallo en MMT Sync, Overlays o Auto-Fuel</option>
                  <option value="bug_web_overlay">Error en la web muntru.me / docs / Muntrume AI</option>
                  <option value="error_setup">Problema con un setup .STO o Garage Vault</option>
                  <option value="retirada_privacidad">Privacidad, RGPD o retirada de contenido</option>
                </optgroup>
                <optgroup label="Consultas generales y escudería (→ info@muntru.me)">
                  <option value="consulta_general">Consulta general</option>
                  <option value="acceso_equipo">Solicitud / Información para entrar al equipo</option>
                  <option value="sugerencia">Sugerencia o nueva función</option>
                  <option value="colaboracion_prensa">Prensa, patrocinios o colaboraciones</option>
                </optgroup>
              </select>
            </div>

            <!-- Badge dinámico de enrutamiento -->
            <div id="sup-route-banner" class="sup-route-banner" hidden>
              <span class="sup-route-dot" aria-hidden="true"></span>
              <span id="sup-route-text"></span>
            </div>

            <!-- Resto del formulario (se despliega al elegir categoría) -->
            <div id="sup-form-body" class="sup-form-body" hidden>
              <div class="sup-grid-2">
                <div class="sup-field">
                  <label for="sup-email">Tu correo electrónico <span class="req">*</span></label>
                  <input id="sup-email" name="email" type="email" required placeholder="tu@correo.com" autocomplete="email" />
                </div>
                <div class="sup-field">
                  <label for="sup-name">Nombre o piloto</label>
                  <input id="sup-name" name="name" type="text" maxlength="80" placeholder="Ej. Alberto Trujillo" autocomplete="name" />
                </div>
              </div>

              <!-- Campos contextuales dinámicos -->
              <div class="sup-grid-2" id="sup-dynamic-row" hidden>
                <div class="sup-field" id="sup-wrap-appver" hidden>
                  <label for="sup-app-version">Versión de MMT Sync (opcional)</label>
                  <input id="sup-app-version" name="app_version" type="text" maxlength="40" placeholder="Ej. v1.4.2 · Windows 11" />
                </div>
                <div class="sup-field" id="sup-wrap-pageurl" hidden>
                  <label for="sup-page-url">URL afectada (opcional)</label>
                  <input id="sup-page-url" name="page_url" type="url" maxlength="240" placeholder="https://muntru.me/..." />
                </div>
                <div class="sup-field" id="sup-wrap-iracing" hidden>
                  <label for="sup-iracing-id">iRacing Customer ID (opcional)</label>
                  <input id="sup-iracing-id" name="iracing_id" type="text" maxlength="40" placeholder="Ej. 842190" />
                </div>
                <div class="sup-field" id="sup-wrap-priority" hidden>
                  <label for="sup-priority">Prioridad</label>
                  <select id="sup-priority" name="priority">
                    <option value="normal">Normal</option>
                    <option value="high">Alta (bloquea carrera o acceso)</option>
                  </select>
                </div>
              </div>

              <div class="sup-field">
                <label for="sup-subject">Asunto <span class="req">*</span></label>
                <input id="sup-subject" name="subject" type="text" required minlength="4" maxlength="160" placeholder="Resumen breve del problema o consulta" />
              </div>

              <div class="sup-field">
                <label for="sup-description">Descripción detallada <span class="req">*</span></label>
                <textarea id="sup-description" name="description" rows="6" required minlength="15" maxlength="4000" placeholder="Explícanos qué ocurre, pasos para reproducirlo, mensajes de error o detalles relevantes..."></textarea>
                <span class="sup-hint">Recibirás un correo de confirmación con tu número de ticket <code>#MMT-XXXXXX</code> y podrás seguirlo en Mis solicitudes.</span>
              </div>

              <div class="sup-field">
                <label for="sup-files">Adjuntos (opcional · máx. 2 archivos PDF/PNG/JPG/TXT, 350 KB c/u)</label>
                <input id="sup-files" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.webp,.txt" />
              </div>

              <div id="sup-form-error" class="sup-alert sup-alert-err" role="alert" hidden></div>

              <div class="sup-form-footer">
                <button type="submit" id="sup-submit-btn" class="sup-btn sup-btn-primary">
                  Enviar solicitud
                </button>
              </div>
            </div>
          </form>

          <!-- Estado de éxito -->
          <div id="sup-success-box" class="sup-success-box" hidden>
            <div class="sup-success-badge">Solicitud registrada</div>
            <h3>Hemos creado tu ticket <code id="sup-created-id">#MMT-000000</code></h3>
            <p id="sup-created-desc"></p>
            <div class="sup-hero-actions" style="justify-content:flex-start;margin-top:16px;">
              <a href="#mis-solicitudes" class="sup-btn sup-btn-primary">Ver en Mis solicitudes</a>
              <button type="button" id="sup-new-ticket-btn" class="sup-btn sup-btn-ghost">Enviar otra solicitud</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mis solicitudes -->
    <section class="sup-section" id="mis-solicitudes">
      <div class="sup-wrap">
        <div class="sup-card">
          <div class="sup-req-head">
            <div>
              <span class="sup-kicker">Historial de tickets</span>
              <h2>Mis solicitudes</h2>
            </div>
            <div class="sup-req-tools" id="sup-req-tools" hidden>
              <div class="sup-req-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input id="sup-req-filter-q" type="search" placeholder="Buscar por asunto o #MMT..." aria-label="Buscar solicitudes" />
              </div>
              <select id="sup-req-filter-status" aria-label="Filtrar por estado">
                <option value="all">Estado: Todos</option>
                <option value="open">Abierto</option>
                <option value="in_progress">En curso</option>
                <option value="solved">Resuelto</option>
              </select>
            </div>
          </div>

          <!-- No autenticado -->
          <div id="sup-req-anon" class="sup-anon-box" hidden>
            <p>Inicia sesión con tu cuenta de Muntrume para consultar el estado y el historial de tus solicitudes.</p>
            <a href="https://muntru.me/login/?next=https%3A%2F%2Fsupport.muntru.me%2F" class="sup-btn sup-btn-primary">Iniciar sesión</a>
          </div>

          <!-- Cargando -->
          <div id="sup-req-loading" class="sup-muted-state">Comprobando sesión...</div>

          <!-- Tabla de tickets -->
          <div id="sup-req-table-wrap" class="sup-table-wrap" hidden>
            <table class="sup-table">
              <thead>
                <tr>
                  <th>Asunto</th>
                  <th>ID</th>
                  <th>Buzón</th>
                  <th>Creado</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody id="sup-req-tbody"></tbody>
            </table>
          </div>

          <div id="sup-req-empty" class="sup-muted-state" hidden>
            Aún no tienes solicitudes registradas con esta cuenta.
          </div>

          <!-- Vista de detalle de ticket (2 columnas estilo Discord/Zendesk) -->
          <div id="sup-ticket-detail" class="sup-detail" hidden>
            <div class="sup-detail-crumbs">
              <button type="button" id="sup-detail-back" class="sup-back-btn">← Volver a Mis solicitudes</button>
              <span class="sup-crumb-sep">/</span>
              <span id="sup-detail-crumb-id">#MMT-000000</span>
            </div>

            <div class="sup-detail-grid">
              <!-- Columna izquierda: Asunto + Hilo + Añadir a la conversación -->
              <div class="sup-detail-main">
                <h2 id="sup-detail-subject" class="sup-detail-subject"></h2>
                <div id="sup-detail-thread" class="sup-thread"></div>

                <form id="sup-reply-form" class="sup-reply-box" novalidate>
                  <div class="sup-reply-row">
                    <div class="sup-avatar" id="sup-reply-avatar" aria-hidden="true">U</div>
                    <div class="sup-reply-fields">
                      <textarea id="sup-reply-text" rows="3" maxlength="4000" placeholder="Añadir a la conversación..."></textarea>
                      <div class="sup-reply-bar">
                        <label class="sup-file-chip">
                          <span>📎 Adjuntar archivo</span>
                          <input id="sup-reply-files" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,.webp,.txt" hidden />
                        </label>
                        <span id="sup-reply-file-names" class="sup-reply-file-names"></span>
                        <button type="submit" id="sup-reply-submit" class="sup-btn sup-btn-primary sup-btn-sm">Enviar respuesta</button>
                      </div>
                      <div id="sup-reply-err" class="sup-alert sup-alert-err" hidden></div>
                    </div>
                  </div>
                </form>
              </div>

              <!-- Columna derecha: Tarjeta de metadatos y adjuntos -->
              <aside class="sup-detail-side">
                <dl class="sup-meta-list">
                  <div class="sup-meta-row">
                    <dt>Solicitante</dt>
                    <dd id="sup-meta-requester">—</dd>
                  </div>
                  <div class="sup-meta-row">
                    <dt>Creado</dt>
                    <dd id="sup-meta-created">—</dd>
                  </div>
                  <div class="sup-meta-row">
                    <dt>Última actividad</dt>
                    <dd id="sup-meta-updated">—</dd>
                  </div>
                </dl>

                <hr class="sup-meta-hr" />

                <dl class="sup-meta-list">
                  <div class="sup-meta-row">
                    <dt>ID</dt>
                    <dd><code id="sup-meta-id">#MMT-000000</code></dd>
                  </div>
                  <div class="sup-meta-row">
                    <dt>Estado</dt>
                    <dd id="sup-meta-status"></dd>
                  </div>
                  <div class="sup-meta-row">
                    <dt>Buzón</dt>
                    <dd id="sup-meta-inbox">—</dd>
                  </div>
                  <div class="sup-meta-row">
                    <dt>Categoría</dt>
                    <dd id="sup-meta-cat">—</dd>
                  </div>
                </dl>

                <div id="sup-meta-att-wrap" class="sup-meta-att" hidden>
                  <hr class="sup-meta-hr" />
                  <div class="sup-meta-att-title">Adjuntos</div>
                  <div id="sup-meta-att-list" class="sup-meta-att-list"></div>
                </div>

                <div class="sup-meta-actions" id="sup-meta-actions">
                  <button type="button" id="sup-toggle-status-btn" class="sup-btn sup-btn-ghost sup-btn-sm" style="width:100%;">Marcar como resuelto</button>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Información de contacto directo -->
    <section class="sup-section sup-section-last">
      <div class="sup-wrap">
        <div class="sup-routing-grid">
          <div class="sup-routing-card">
            <span class="sup-pill sup-pill-inc">Incidencias y Seguridad</span>
            <h3>support@muntru.me</h3>
            <p>Cuentas comprometidas, Passkeys, 2FA, fallos en MMT Sync, Overlays, Auto-Fuel, Garage Vault o solicitudes RGPD.</p>
          </div>
          <div class="sup-routing-card">
            <span class="sup-pill sup-pill-info">Consultas y Escudería</span>
            <h3>info@muntru.me</h3>
            <p>Información general, ingreso al equipo Muntrume Motorsport, sugerencias de producto, prensa y colaboraciones.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
(() => {
  // Consume SSO handoff from muntru.me/login/ when arriving on support.muntru.me
  try {
    if (location.hash && location.hash.includes("mm_auth=")) {
      const hp = new URLSearchParams(location.hash.slice(1));
      const tk = hp.get("mm_auth");
      const uRaw = hp.get("mm_user");
      if (tk) {
        localStorage.setItem("mrt_vault_token", tk);
        localStorage.setItem("mm_token", tk);
      }
      if (uRaw) {
        const uJson = decodeURIComponent(escape(atob(uRaw)));
        localStorage.setItem("mrt_vault_user", uJson);
      }
      history.replaceState(null, "", location.pathname + location.search + "#mis-solicitudes");
    }
  } catch {}

  const API = "https://muntrume.atrumin16.workers.dev";
  const INCIDENT_CATS = new Set([
    "cuenta_comprometida",
    "acceso_mfa",
    "bug_mmt_sync",
    "bug_web_overlay",
    "error_setup",
    "retirada_privacidad",
  ]);

  const STATUS_META = {
    open: { label: "Abierto", cls: "sup-st-open" },
    in_progress: { label: "En curso", cls: "sup-st-prog" },
    solved: { label: "Resuelto", cls: "sup-st-solved" },
    closed: { label: "Cerrado", cls: "sup-st-solved" },
  };

  function getToken() {
    try { return localStorage.getItem("mrt_vault_token") || localStorage.getItem("mm_token") || ""; }
    catch { return ""; }
  }
  function getUser() {
    try { return JSON.parse(localStorage.getItem("mrt_vault_user") || "null"); }
    catch { return null; }
  }
  function relDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    const diffMs = Date.now() - d.getTime();
    const mins = Math.floor(diffMs / 60000);
    if (mins < 1) return "Hace un momento";
    if (mins < 60) return `Hace ${mins} min`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `Hace ${hrs} h`;
    const days = Math.floor(hrs / 24);
    if (days < 30) return `Hace ${days} d`;
    return d.toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" });
  }
  function esc(s) {
    return String(s || "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  }

  // 1. Hero live filter over topic cards
  const heroSearch = document.getElementById("sup-hero-search");
  const topicCards = Array.from(document.querySelectorAll(".sup-topic-card"));
  const topicsEmpty = document.getElementById("sup-topics-empty");
  if (heroSearch) {
    heroSearch.addEventListener("input", () => {
      const q = heroSearch.value.trim().toLowerCase();
      let visible = 0;
      topicCards.forEach((card) => {
        const hay = (card.textContent + " " + (card.getAttribute("data-tags") || "")).toLowerCase();
        const show = !q || hay.includes(q);
        card.hidden = !show;
        if (show) visible++;
      });
      if (topicsEmpty) topicsEmpty.hidden = visible > 0;
    });
  }

  // 2. Dynamic form behavior
  const catSel = document.getElementById("sup-category");
  const formBody = document.getElementById("sup-form-body");
  const routeBanner = document.getElementById("sup-route-banner");
  const routeText = document.getElementById("sup-route-text");
  const dynRow = document.getElementById("sup-dynamic-row");
  const wrapAppVer = document.getElementById("sup-wrap-appver");
  const wrapPageUrl = document.getElementById("sup-wrap-pageurl");
  const wrapIracing = document.getElementById("sup-wrap-iracing");
  const wrapPriority = document.getElementById("sup-wrap-priority");
  const emailInp = document.getElementById("sup-email");
  const nameInp = document.getElementById("sup-name");
  const form = document.getElementById("sup-form");
  const errBox = document.getElementById("sup-form-error");
  const submitBtn = document.getElementById("sup-submit-btn");
  const successBox = document.getElementById("sup-success-box");
  const createdIdEl = document.getElementById("sup-created-id");
  const createdDescEl = document.getElementById("sup-created-desc");
  const newTicketBtn = document.getElementById("sup-new-ticket-btn");

  const currentUser = getUser();
  if (currentUser) {
    if (emailInp && currentUser.email) emailInp.value = currentUser.email;
    if (nameInp && currentUser.name) nameInp.value = currentUser.name;
  }

  function updateCategoryUI() {
    const cat = catSel ? catSel.value : "";
    if (!cat) {
      if (formBody) formBody.hidden = true;
      if (routeBanner) routeBanner.hidden = true;
      return;
    }
    const isInc = INCIDENT_CATS.has(cat);
    const inbox = isInc ? "support@muntru.me" : "info@muntru.me";
    if (routeBanner) {
      routeBanner.hidden = false;
      routeBanner.className = "sup-route-banner " + (isInc ? "is-inc" : "is-info");
    }
    if (routeText) {
      routeText.innerHTML = cat === "cuenta_comprometida"
        ? `Prioridad <strong>CRÍTICA</strong> · Se enviará de forma inmediata y ordenada a <code>${inbox}</code>.`
        : `Se enviará ordenadamente al buzón <code>${inbox}</code> con acuse de recibo automático.`;
    }
    if (formBody) formBody.hidden = false;

    const showApp = cat === "bug_mmt_sync";
    const showUrl = cat === "bug_web_overlay" || cat === "retirada_privacidad";
    const showIr = ["cuenta_comprometida", "acceso_mfa", "error_setup", "acceso_equipo"].includes(cat);
    const showPrio = isInc && cat !== "cuenta_comprometida";

    if (wrapAppVer) wrapAppVer.hidden = !showApp;
    if (wrapPageUrl) wrapPageUrl.hidden = !showUrl;
    if (wrapIracing) wrapIracing.hidden = !showIr;
    if (wrapPriority) wrapPriority.hidden = !showPrio;
    if (dynRow) dynRow.hidden = !(showApp || showUrl || showIr || showPrio);
  }

  if (catSel) {
    catSel.addEventListener("change", updateCategoryUI);
    const params = new URLSearchParams(location.search);
    const pre = params.get("category") || params.get("cat");
    if (pre && Array.from(catSel.options).some((o) => o.value === pre)) {
      catSel.value = pre;
      updateCategoryUI();
    }
  }

  if (newTicketBtn) {
    newTicketBtn.addEventListener("click", () => {
      if (successBox) successBox.hidden = true;
      if (form) {
        form.hidden = false;
        form.reset();
        if (currentUser?.email && emailInp) emailInp.value = currentUser.email;
        if (currentUser?.name && nameInp) nameInp.value = currentUser.name;
      }
      updateCategoryUI();
    });
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (errBox) { errBox.hidden = true; errBox.textContent = ""; }

      const payload = {
        category: catSel.value,
        email: emailInp.value.trim(),
        name: nameInp.value.trim(),
        subject: document.getElementById("sup-subject").value.trim(),
        description: document.getElementById("sup-description").value.trim(),
        app_version: document.getElementById("sup-app-version").value.trim(),
        page_url: document.getElementById("sup-page-url").value.trim(),
        iracing_id: document.getElementById("sup-iracing-id").value.trim(),
        priority: document.getElementById("sup-priority").value,
      };

      if (!payload.category) {
        errBox.textContent = "Selecciona el tipo de solicitud.";
        errBox.hidden = false;
        return;
      }
      if (!payload.email || !payload.email.includes("@")) {
        errBox.textContent = "Introduce un correo electrónico válido.";
        errBox.hidden = false;
        return;
      }
      if (payload.subject.length < 4) {
        errBox.textContent = "Escribe un asunto breve (mínimo 4 caracteres).";
        errBox.hidden = false;
        return;
      }
      if (payload.description.length < 15) {
        errBox.textContent = "Describe el caso con un poco más de detalle (mínimo 15 caracteres).";
        errBox.hidden = false;
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando...";
      try {
        payload.attachments = await readAttachments(document.getElementById("sup-files"));
        const headers = { "Content-Type": "application/json" };
        const tok = getToken();
        if (tok) headers["Authorization"] = `Bearer ${tok}`;
        const res = await fetch(`${API}/api/support/tickets`, {
          method: "POST",
          headers,
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
          throw new Error(data.error || "No se pudo registrar la solicitud.");
        }
        const t = data.ticket;
        if (createdIdEl) createdIdEl.textContent = `#${t.id}`;
        if (createdDescEl) {
          createdDescEl.innerHTML = `Derivado a <strong>${esc(t.routing_inbox)}</strong> (${esc(t.category_label)}). Te hemos enviado un correo de confirmación a <strong>${esc(payload.email)}</strong>.`;
        }
        form.hidden = true;
        if (successBox) successBox.hidden = false;
        loadMyTickets();
      } catch (err) {
        errBox.textContent = err.message || "Error de conexión. Inténtalo de nuevo.";
        errBox.hidden = false;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Enviar solicitud";
      }
    });
  }

  function fmtFullDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    if (isNaN(d.getTime())) return iso;
    return d.toLocaleString("es-ES", { day: "numeric", month: "long", year: "numeric", hour: "2-digit", minute: "2-digit" });
  }
  function fmtBytes(n) {
    const b = Number(n || 0);
    if (b >= 1024 * 1024) return `${(b / (1024 * 1024)).toFixed(1)} MB`;
    return `${Math.max(1, Math.round(b / 1024))} KB`;
  }
  function initialsOf(name) {
    const parts = String(name || "U").trim().split(/\s+/).filter(Boolean);
    return ((parts[0]?.[0] || "U") + (parts[1]?.[0] || "")).toUpperCase();
  }
  async function readAttachments(inputEl) {
    const files = Array.from(inputEl?.files || []).slice(0, 2);
    const out = [];
    for (const f of files) {
      if (f.size > 350 * 1024) throw new Error(`El archivo "${f.name}" supera el límite de 350 KB.`);
      const dataUrl = await new Promise((resolve, reject) => {
        const r = new FileReader();
        r.onload = () => resolve(String(r.result || ""));
        r.onerror = () => reject(new Error(`No se pudo leer ${f.name}`));
        r.readAsDataURL(f);
      });
      out.push({ name: f.name, size: f.size, dataUrl });
    }
    return out;
  }

  // 3. Mis solicitudes (tabla filtrable + vista de detalle de ticket)
  const reqHead = document.querySelector("#mis-solicitudes .sup-req-head");
  const reqTools = document.getElementById("sup-req-tools");
  const reqAnon = document.getElementById("sup-req-anon");
  const reqLoading = document.getElementById("sup-req-loading");
  const reqTableWrap = document.getElementById("sup-req-table-wrap");
  const reqTbody = document.getElementById("sup-req-tbody");
  const reqEmpty = document.getElementById("sup-req-empty");
  const filterQ = document.getElementById("sup-req-filter-q");
  const filterStatus = document.getElementById("sup-req-filter-status");
  const detailWrap = document.getElementById("sup-ticket-detail");
  const detailBack = document.getElementById("sup-detail-back");
  const replyForm = document.getElementById("sup-reply-form");
  const replyText = document.getElementById("sup-reply-text");
  const replyFiles = document.getElementById("sup-reply-files");
  const replyFileNames = document.getElementById("sup-reply-file-names");
  const replyErr = document.getElementById("sup-reply-err");
  const replySubmit = document.getElementById("sup-reply-submit");
  const toggleStatusBtn = document.getElementById("sup-toggle-status-btn");
  let allTickets = [];
  let activeTicket = null;

  function renderAttachmentsHtml(list) {
    if (!Array.isArray(list) || !list.length) return "";
    return `<div class="sup-att-list">${list.map((a) => `
      <div class="sup-att-item">
        <span class="sup-att-ico" aria-hidden="true">📎</span>
        <div class="sup-att-info">
          <div class="sup-att-name">${esc(a.name)}</div>
          <div class="sup-att-meta">${esc(fmtBytes(a.size))} · <a href="${esc(a.dataUrl)}" download="${esc(a.name)}" class="sup-att-dl">Descargar</a></div>
        </div>
      </div>
    `).join("")}</div>`;
  }

  function closeTicketDetail() {
    activeTicket = null;
    if (detailWrap) detailWrap.hidden = true;
    if (reqHead) reqHead.hidden = false;
    renderTickets();
    if (location.hash.startsWith("#ticket=")) {
      history.replaceState(null, "", location.pathname + location.search + "#mis-solicitudes");
    }
  }

  async function openTicket(ticketId) {
    const tok = getToken();
    if (!tok) return;
    if (reqHead) reqHead.hidden = true;
    if (reqTableWrap) reqTableWrap.hidden = true;
    if (reqEmpty) reqEmpty.hidden = true;
    if (detailWrap) detailWrap.hidden = false;
    document.getElementById("sup-detail-crumb-id").textContent = `#${ticketId}`;
    document.getElementById("sup-detail-subject").textContent = "Cargando conversación...";
    document.getElementById("sup-detail-thread").innerHTML = "";
    try {
      const res = await fetch(`${API}/api/support/tickets/get?id=${encodeURIComponent(ticketId)}`, {
        headers: { Authorization: `Bearer ${tok}` },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) throw new Error(data.error || "No se pudo cargar el ticket.");
      const t = data.ticket;
      const msgs = Array.isArray(data.messages) ? data.messages : [];
      activeTicket = t;

      document.getElementById("sup-detail-subject").textContent = t.subject;
      document.getElementById("sup-meta-requester").textContent = t.user_name || t.user_email;
      document.getElementById("sup-meta-created").textContent = fmtFullDate(t.created_at);
      document.getElementById("sup-meta-updated").textContent = fmtFullDate(t.updated_at);
      document.getElementById("sup-meta-id").textContent = `#${t.id}`;
      const stMeta = STATUS_META[t.status] || { label: t.status || "Abierto", cls: "sup-st-open" };
      document.getElementById("sup-meta-status").innerHTML = `<span class="sup-st-pill ${stMeta.cls}">${esc(stMeta.label)}</span>`;
      document.getElementById("sup-meta-inbox").textContent = t.routing_inbox;
      document.getElementById("sup-meta-cat").textContent = t.category_label || t.category;

      const allAtts = [...(t.attachments || [])];
      msgs.forEach((m) => { if (Array.isArray(m.attachments)) allAtts.push(...m.attachments); });
      const attWrap = document.getElementById("sup-meta-att-wrap");
      const attListEl = document.getElementById("sup-meta-att-list");
      if (allAtts.length) {
        attWrap.hidden = false;
        attListEl.innerHTML = renderAttachmentsHtml(allAtts);
      } else {
        attWrap.hidden = true;
      }

      if (toggleStatusBtn) {
        toggleStatusBtn.textContent = t.status === "solved" ? "Reabrir solicitud" : "Marcar como resuelto";
      }
      const myAvatar = document.getElementById("sup-reply-avatar");
      if (myAvatar) myAvatar.textContent = initialsOf(currentUser?.name || t.user_name);

      const threadItems = [
        { author_name: t.user_name || t.user_email, author_role: "user", body: t.description, created_at: t.created_at, attachments: t.attachments || [] },
        ...msgs,
      ];
      document.getElementById("sup-detail-thread").innerHTML = threadItems.map((m) => `
        <article class="sup-msg ${m.author_role === "staff" ? "is-staff" : ""}">
          <div class="sup-msg-head">
            <div class="sup-avatar ${m.author_role === "staff" ? "is-staff" : ""}" aria-hidden="true">${esc(initialsOf(m.author_name))}</div>
            <div>
              <div class="sup-msg-author">
                ${esc(m.author_name)}
                ${m.author_role === "staff" ? `<span class="sup-staff-badge">Muntrume Support</span>` : ""}
              </div>
              <div class="sup-msg-time">${esc(relDate(m.created_at))}</div>
            </div>
          </div>
          <div class="sup-msg-body">${esc(m.body)}</div>
          ${renderAttachmentsHtml(m.attachments)}
        </article>
      `).join("");

      history.replaceState(null, "", `${location.pathname}${location.search}#ticket=${t.id}`);
      detailWrap.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (err) {
      document.getElementById("sup-detail-subject").textContent = err.message || "Error cargando el ticket.";
    }
  }

  function renderTickets() {
    if (activeTicket) return;
    const q = (filterQ?.value || "").trim().toLowerCase();
    const st = filterStatus?.value || "all";
    const rows = allTickets.filter((t) => {
      if (st !== "all" && t.status !== st) return false;
      if (q && !(`${t.id} ${t.subject} ${t.routing_inbox} ${t.category}`).toLowerCase().includes(q)) return false;
      return true;
    });
    if (!rows.length) {
      if (reqTableWrap) reqTableWrap.hidden = true;
      if (reqEmpty) {
        reqEmpty.textContent = allTickets.length
          ? "No hay solicitudes que coincidan con tu filtro."
          : "Aún no tienes solicitudes registradas con esta cuenta.";
        reqEmpty.hidden = false;
      }
      return;
    }
    if (reqEmpty) reqEmpty.hidden = true;
    if (reqTableWrap) reqTableWrap.hidden = false;
    reqTbody.innerHTML = rows.map((t) => {
      const meta = STATUS_META[t.status] || { label: t.status || "Abierto", cls: "sup-st-open" };
      const isInc = t.routing_inbox === "support@muntru.me";
      return `<tr class="sup-row-clickable" data-open-ticket="${esc(t.id)}" tabindex="0" role="button">
        <td class="sup-td-subj">
          <div class="sup-subj-text">${esc(t.subject)}</div>
          <div class="sup-subj-sub">${esc(t.category)}</div>
        </td>
        <td class="sup-td-id"><code>#${esc(t.id)}</code></td>
        <td><span class="sup-inbox-tag ${isInc ? "is-inc" : "is-info"}">${esc(t.routing_inbox)}</span></td>
        <td class="sup-td-date">${esc(relDate(t.updated_at || t.created_at))}</td>
        <td><span class="sup-st-pill ${meta.cls}">${esc(meta.label)}</span></td>
      </tr>`;
    }).join("");
  }

  if (reqTbody) {
    reqTbody.addEventListener("click", (e) => {
      const row = e.target.closest("[data-open-ticket]");
      if (row) openTicket(row.getAttribute("data-open-ticket"));
    });
    reqTbody.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        const row = e.target.closest("[data-open-ticket]");
        if (row) { e.preventDefault(); openTicket(row.getAttribute("data-open-ticket")); }
      }
    });
  }
  if (detailBack) detailBack.addEventListener("click", closeTicketDetail);
  if (replyFiles) {
    replyFiles.addEventListener("change", () => {
      const names = Array.from(replyFiles.files || []).slice(0, 2).map((f) => f.name).join(", ");
      if (replyFileNames) replyFileNames.textContent = names;
    });
  }
  if (replyForm) {
    replyForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!activeTicket) return;
      if (replyErr) { replyErr.hidden = true; replyErr.textContent = ""; }
      const message = (replyText?.value || "").trim();
      if (!message) {
        replyErr.textContent = "Escribe un mensaje para enviar.";
        replyErr.hidden = false;
        return;
      }
      replySubmit.disabled = true;
      replySubmit.textContent = "Enviando...";
      try {
        const attachments = await readAttachments(replyFiles);
        const res = await fetch(`${API}/api/support/tickets/reply`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${getToken()}` },
          body: JSON.stringify({ ticket_id: activeTicket.id, message, attachments }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(data.error || "No se pudo enviar la respuesta.");
        if (replyText) replyText.value = "";
        if (replyFiles) replyFiles.value = "";
        if (replyFileNames) replyFileNames.textContent = "";
        await openTicket(activeTicket.id);
        loadMyTickets();
      } catch (err) {
        replyErr.textContent = err.message || "Error al enviar.";
        replyErr.hidden = false;
      } finally {
        replySubmit.disabled = false;
        replySubmit.textContent = "Enviar respuesta";
      }
    });
  }
  if (toggleStatusBtn) {
    toggleStatusBtn.addEventListener("click", async () => {
      if (!activeTicket) return;
      const nextStatus = activeTicket.status === "solved" ? "open" : "solved";
      toggleStatusBtn.disabled = true;
      try {
        const res = await fetch(`${API}/api/support/tickets/reply`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${getToken()}` },
          body: JSON.stringify({ ticket_id: activeTicket.id, status: nextStatus }),
        });
        if (res.ok) {
          await openTicket(activeTicket.id);
          loadMyTickets();
        }
      } finally {
        toggleStatusBtn.disabled = false;
      }
    });
  }

  async function loadMyTickets() {
    const tok = getToken();
    if (!tok) {
      if (reqLoading) reqLoading.hidden = true;
      if (reqAnon) reqAnon.hidden = false;
      if (reqTools) reqTools.hidden = true;
      if (reqTableWrap) reqTableWrap.hidden = true;
      if (reqEmpty) reqEmpty.hidden = true;
      return;
    }
    if (reqAnon) reqAnon.hidden = true;
    if (reqLoading) { reqLoading.textContent = "Cargando tus solicitudes..."; reqLoading.hidden = false; }
    try {
      const res = await fetch(`${API}/api/support/tickets/mine`, {
        headers: { Authorization: `Bearer ${tok}` },
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        if (reqLoading) reqLoading.hidden = true;
        if (reqAnon) reqAnon.hidden = false;
        return;
      }
      allTickets = Array.isArray(data.tickets) ? data.tickets : [];
      if (reqLoading) reqLoading.hidden = true;
      if (reqTools) reqTools.hidden = false;
      const hm = location.hash.match(/^#ticket=(MMT-\d{6})$/i);
      if (hm && !activeTicket) {
        openTicket(hm[1].toUpperCase());
      } else {
        renderTickets();
      }
    } catch {
      if (reqLoading) {
        reqLoading.textContent = "No se pudieron cargar tus solicitudes ahora mismo.";
        reqLoading.hidden = false;
      }
    }
  }

  if (filterQ) filterQ.addEventListener("input", renderTickets);
  if (filterStatus) filterStatus.addEventListener("change", renderTickets);
  loadMyTickets();
})();
</script>

