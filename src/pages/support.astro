  .sup-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .sup-field { display: flex; flex-direction: column; gap: 6px; }
  .sup-field label {
    font-size: 0.86rem;
