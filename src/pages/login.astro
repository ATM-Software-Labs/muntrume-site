---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Iniciar sesión · Muntrume Motorsport"
  description="Acceso seguro Zero-Trust al Setup Vault, Muntrume AI Studio y Race Control mediante Passkey WebAuthn, contraseña, código por correo o MFA Open Source."
  canonical="https://muntru.me/login/"
  noindex={true}
>
  <main class="mm-login-page">
    <div class="mm-login-shell">
      <!-- LEFT BRANDING / SECURITY PANEL -->
      <section class="mm-login-aside" aria-label="Seguridad Muntrume">
        <div class="mm-login-badge">
          <span class="mm-login-dot" aria-hidden="true"></span>
          <span>MUNTRUME ID · ZERO-TRUST</span>
        </div>
        <h1>Acceso unificado del equipo</h1>
        <p class="mm-login-aside__lead">
          Una sola sesión verificada para <strong>Setup Vault</strong> (+42.600 setups <code>.sto</code>), <strong>Muntrume AI Studio</strong>, <strong>MMT Sync</strong> y <strong>Race Control</strong>.
        </p>

        <div class="mm-login-pillars">
          <div class="mm-login-pillar">
            <div class="mm-login-pillar__icon" aria-hidden="true">🔑</div>
            <div>
              <strong>Passkeys FIDO2 / WebAuthn</strong>
              <p>Inicia sesión en 1 toque con Windows Hello, Touch ID, Face ID o llave de seguridad.</p>
            </div>
          </div>
          <div class="mm-login-pillar">
            <div class="mm-login-pillar__icon" aria-hidden="true">🛡️</div>
            <div>
              <strong>MFA 100 % Open Source</strong>
              <p>Compatible con TOTP RFC 6238, <code>ntfy.sh</code>, Discord DM, Android SMS Gateway y WhatsApp self-hosted.</p>
            </div>
          </div>
          <div class="mm-login-pillar">
            <div class="mm-login-pillar__icon" aria-hidden="true">📚</div>
            <div>
              <strong>Documentación siempre abierta</strong>
              <p>¿Solo quieres consultar la arquitectura o la API? Visita <a href="https://docs.muntru.me/">docs.muntru.me</a> sin iniciar sesión.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- RIGHT AUTH CARD -->
      <section class="mm-login-card" aria-label="Formulario de acceso">
        <div class="mm-login-card__head">
          <h2>Iniciar sesión</h2>
          <p id="loginNextHint">Accede con tu cuenta autorizada de piloto o ingeniero.</p>
        </div>

        <!-- 1-TAP PASSKEY CTA -->
        <button type="button" id="btnPasskeyLogin" class="mm-btn-passkey">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
          <span>Entrar con Passkey (Windows Hello / Touch ID)</span>
        </button>

        <div class="mm-login-divider"><span>o continúa con</span></div>

        <!-- METHOD TABS -->
        <div class="mm-login-tabs" role="tablist">
          <button type="button" class="mm-login-tab is-active" data-auth-tab="totp" role="tab" aria-selected="true">Authenticator</button>
          <button type="button" class="mm-login-tab" data-auth-tab="code" role="tab" aria-selected="false">Email</button>
          <button type="button" class="mm-login-tab" data-auth-tab="otp" role="tab" aria-selected="false">MFA OSS</button>
          <button type="button" class="mm-login-tab" data-auth-tab="password" role="tab" aria-selected="false">Contraseña</button>
        </div>

        <!-- STATUS / ERROR BANNER -->
        <div id="loginStatus" class="mm-login-alert" hidden role="status" aria-live="polite"></div>

        <!-- TAB 1: AUTHENTICATOR (TOTP PASSWORDLESS) -->
        <form id="formTotp" class="mm-login-form" data-auth-panel="totp" novalidate>
          <label class="mm-field">
            <span>Correo electrónico autorizado</span>
            <input type="email" id="totpEmail" autocomplete="username" placeholder="piloto@muntru.me" required />
          </label>
          <label class="mm-field">
            <span>Código de 6 dígitos (o código de recuperación XXXX-XXXX)</span>
            <input type="text" id="totpCode" inputmode="text" maxlength="12" autocomplete="one-time-code" placeholder="123456" required />
          </label>
          <button type="submit" id="btnSubmitTotp" class="mm-btn-submit">Entrar sin contraseña con Authenticator</button>
        </form>

        <!-- TAB 2: PASSWORD -->
        <form id="formPassword" class="mm-login-form" data-auth-panel="password" hidden novalidate>
          <label class="mm-field">
            <span>Correo electrónico</span>
            <input type="email" id="pwEmail" name="email" autocomplete="username webauthn" placeholder="piloto@muntru.me" required />
          </label>
          <label class="mm-field">
            <div class="mm-field__row">
              <span>Contraseña</span>
              <button type="button" id="btnForgotToggle" class="mm-link-btn">¿Primer acceso u olvidaste tu contraseña?</button>
            </div>
            <div class="mm-pw-wrap">
              <input type="password" id="pwPass" name="password" autocomplete="current-password" placeholder="••••••••••••" required />
              <button type="button" id="btnTogglePw" class="mm-pw-eye" aria-label="Mostrar u ocultar contraseña">Ver</button>
            </div>
          </label>
          <button type="submit" id="btnSubmitPw" class="mm-btn-submit">Iniciar sesión</button>
        </form>

        <!-- TAB 2: EMAIL MAGIC CODE -->
        <form id="formEmailCode" class="mm-login-form" data-auth-panel="code" hidden novalidate>
          <label class="mm-field">
            <span>Correo electrónico autorizado</span>
            <input type="email" id="codeEmail" autocomplete="email" placeholder="piloto@muntru.me" required />
          </label>
          <div id="codeStepVerify" hidden>
            <label class="mm-field">
              <span>Código de 6 dígitos recibido en tu correo</span>
              <input type="text" id="codeInput" inputmode="numeric" maxlength="8" autocomplete="one-time-code" placeholder="123456" />
            </label>
          </div>
          <div class="mm-form-actions">
            <button type="button" id="btnRequestCode" class="mm-btn-submit">Enviar código por correo</button>
            <button type="submit" id="btnVerifyCode" class="mm-btn-submit" hidden>Verificar código y entrar</button>
          </div>
        </form>

        <!-- TAB 3: OPEN-SOURCE OTP (ntfy / Discord / SMS / WhatsApp) -->
        <form id="formOssOtp" class="mm-login-form" data-auth-panel="otp" hidden novalidate>
          <label class="mm-field">
            <span>Correo electrónico autorizado</span>
            <input type="email" id="otpEmail" autocomplete="email" placeholder="piloto@muntru.me" required />
          </label>
          <label class="mm-field">
            <span>Canal Open Source configurado en tu perfil</span>
            <select id="otpChannel">
              <option value="ntfy">ntfy.sh (Notificación push móvil)</option>
              <option value="discord">Discord DM (Bot oficial MMT)</option>
              <option value="sms_gateway">Android SMS Gateway (SMS propio)</option>
              <option value="whatsapp_oss">WhatsApp self-hosted (Evolution / WAHA)</option>
            </select>
          </label>
          <div id="otpStepVerify" hidden>
            <label class="mm-field">
              <span>Código OTP recibido</span>
              <input type="text" id="otpCodeInput" inputmode="numeric" maxlength="8" autocomplete="one-time-code" placeholder="123456" />
            </label>
          </div>
          <div class="mm-form-actions">
            <button type="button" id="btnSendOtp" class="mm-btn-submit">Enviar OTP al canal</button>
            <button type="submit" id="btnVerifyOtp" class="mm-btn-submit" hidden>Validar OTP y entrar</button>
          </div>
        </form>

        <!-- INLINE FORGOT PASSWORD -->
        <div id="forgotBox" class="mm-forgot-box" hidden>
          <div class="mm-forgot-box__head">
            <strong>Restablecer o crear contraseña</strong>
            <button type="button" id="btnForgotClose" class="mm-link-btn">Cerrar</button>
          </div>
          <p>Introduce tu correo autorizado y te enviaremos un enlace firmado desde <code>mail.muntru.me</code>.</p>
          <div class="mm-forgot-row">
            <input type="email" id="forgotEmail" placeholder="piloto@muntru.me" />
            <button type="button" id="btnSendForgot" class="mm-btn-mini">Enviar enlace</button>
          </div>
        </div>

        <div class="mm-login-card__foot">
          <a href="/ajustes/">Perfil y Ajustes de Seguridad</a>
          <a href="/paddock/#tryouts">Solicitar acceso →</a>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      var API = "https://muntrume.atrumin16.workers.dev";
      var params = new URLSearchParams(location.search);
      var nextRaw = params.get("next") || params.get("redirect") || "/garage/";
      var nextUrl = /^https:\/\/(ai|docs|muntru)\.muntru\.me(\/|$)/i.test(nextRaw)
        ? nextRaw
        : (nextRaw.startsWith("/") && !nextRaw.startsWith("//") && !nextRaw.includes("\\") ? nextRaw : "/garage/");

      var statusEl = document.getElementById("loginStatus");
      function setStatus(msg, type) {
        if (!statusEl) return;
        if (!msg) { statusEl.hidden = true; return; }
        statusEl.textContent = msg;
        statusEl.className = "mm-login-alert mm-login-alert--" + (type || "info");
        statusEl.hidden = false;
      }

      function saveSessionAndGo(data) {
        if (!data || !data.token) {
          setStatus("No se recibió token de sesión.", "error");
          return;
        }
        try {
          localStorage.setItem("mrt_vault_token", data.token);
          localStorage.setItem("mm_token", data.token);
          if (data.user) {
            localStorage.setItem("mrt_vault_user", JSON.stringify(data.user));
          }
        } catch (e) {}
        setStatus("Sesión verificada. Redirigiendo…", "ok");
        var target = nextUrl;
        if (/^https:\/\/ai\.muntru\.me(\/|$)/i.test(target)) {
          var uEnc = "";
          try { if (data.user) uEnc = "&mm_user=" + encodeURIComponent(btoa(unescape(encodeURIComponent(JSON.stringify(data.user))))); } catch (e) {}
          target = target.split("#")[0] + "#mm_auth=" + encodeURIComponent(data.token) + uEnc;
        }
        setTimeout(function () { location.href = target; }, 350);
      }

      async function postJson(path, body) {
        var r = await fetch(API + path, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body || {})
        });
        var data = await r.json().catch(function () { return {}; });
        if (!r.ok || data.success === false) {
          throw new Error(data.error || ("Error HTTP " + r.status));
        }
        return data;
      }

      // Tabs
      document.querySelectorAll("[data-auth-tab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-auth-tab");
          setStatus("");
          document.querySelectorAll("[data-auth-tab]").forEach(function (t) {
            var active = t === btn;
            t.classList.toggle("is-active", active);
            t.setAttribute("aria-selected", active ? "true" : "false");
          });
          document.querySelectorAll("[data-auth-panel]").forEach(function (p) {
            p.hidden = p.getAttribute("data-auth-panel") !== id;
          });
        });
      });

      // Toggle password visibility
      var pwPass = document.getElementById("pwPass");
      var btnTogglePw = document.getElementById("btnTogglePw");
      if (btnTogglePw && pwPass) {
        btnTogglePw.addEventListener("click", function () {
          var show = pwPass.type === "password";
          pwPass.type = show ? "text" : "password";
          btnTogglePw.textContent = show ? "Ocultar" : "Ver";
        });
      }

      // Authenticator (TOTP passwordless)
      var formTotp = document.getElementById("formTotp");
      if (formTotp) {
        formTotp.addEventListener("submit", async function (e) {
          e.preventDefault();
          var email = (document.getElementById("totpEmail").value || "").trim();
          var code = (document.getElementById("totpCode").value || "").trim();
          if (!email || !code) { setStatus("Introduce tu correo y el código de 6 dígitos.", "error"); return; }
          var btn = document.getElementById("btnSubmitTotp");
          btn.disabled = true;
          setStatus("Verificando código Authenticator…", "info");
          try {
            var data = await postJson("/api/auth/mfa/totp/login", { email: email, code: code });
            saveSessionAndGo(data);
          } catch (err) {
            setStatus(err.message || "Código Authenticator inválido.", "error");
            btn.disabled = false;
          }
        });
      }

      // Password login
      var formPw = document.getElementById("formPassword");
      if (formPw) {
        formPw.addEventListener("submit", async function (e) {
          e.preventDefault();
          var email = (document.getElementById("pwEmail").value || "").trim();
          var password = pwPass.value || "";
          if (!email || !password) { setStatus("Introduce tu correo y contraseña.", "error"); return; }
          var btn = document.getElementById("btnSubmitPw");
          btn.disabled = true;
          setStatus("Verificando credenciales…", "info");
          try {
            var data = await postJson("/api/setups/auth", { email: email, password: password });
            saveSessionAndGo(data);
          } catch (err) {
            setStatus(err.message || "Error al iniciar sesión.", "error");
            btn.disabled = false;
          }
        });
      }

      // Email magic code
      var btnReqCode = document.getElementById("btnRequestCode");
      var btnVerCode = document.getElementById("btnVerifyCode");
      var codeStep = document.getElementById("codeStepVerify");
      if (btnReqCode) {
        btnReqCode.addEventListener("click", async function () {
          var email = (document.getElementById("codeEmail").value || "").trim();
          if (!email) { setStatus("Introduce tu correo autorizado.", "error"); return; }
          btnReqCode.disabled = true;
          setStatus("Enviando código a tu correo…", "info");
          try {
            await postJson("/api/setups/code/request", { email: email });
            codeStep.hidden = false;
            btnVerCode.hidden = false;
            btnReqCode.textContent = "Reenviar código";
            setStatus("Código enviado. Revisa tu bandeja de entrada.", "ok");
          } catch (err) {
            setStatus(err.message || "No se pudo enviar el código.", "error");
          } finally {
            btnReqCode.disabled = false;
          }
        });
      }
      var formCode = document.getElementById("formEmailCode");
      if (formCode) {
        formCode.addEventListener("submit", async function (e) {
          e.preventDefault();
          var email = (document.getElementById("codeEmail").value || "").trim();
          var code = (document.getElementById("codeInput").value || "").trim();
          if (!email || !code) { setStatus("Introduce el correo y el código de 6 dígitos.", "error"); return; }
          btnVerCode.disabled = true;
          try {
            var data = await postJson("/api/setups/code/verify", { email: email, code: code });
            saveSessionAndGo(data);
          } catch (err) {
            setStatus(err.message || "Código inválido o caducado.", "error");
            btnVerCode.disabled = false;
          }
        });
      }

      // Open-Source OTP
      var btnSendOtp = document.getElementById("btnSendOtp");
      var btnVerifyOtp = document.getElementById("btnVerifyOtp");
      var otpStep = document.getElementById("otpStepVerify");
      if (btnSendOtp) {
        btnSendOtp.addEventListener("click", async function () {
          var email = (document.getElementById("otpEmail").value || "").trim();
          var channel = document.getElementById("otpChannel").value;
          if (!email) { setStatus("Introduce tu correo autorizado.", "error"); return; }
          btnSendOtp.disabled = true;
          setStatus("Enviando código OTP por " + channel + "…", "info");
          try {
            await postJson("/api/auth/mfa/otp/send", { email: email, channel: channel });
            otpStep.hidden = false;
            btnVerifyOtp.hidden = false;
            setStatus("Código OTP enviado a tu canal " + channel + ".", "ok");
          } catch (err) {
            setStatus(err.message || "No se pudo enviar el OTP.", "error");
          } finally {
            btnSendOtp.disabled = false;
          }
        });
      }
      var formOtp = document.getElementById("formOssOtp");
      if (formOtp) {
        formOtp.addEventListener("submit", async function (e) {
          e.preventDefault();
          var email = (document.getElementById("otpEmail").value || "").trim();
          var code = (document.getElementById("otpCodeInput").value || "").trim();
          if (!email || !code) { setStatus("Introduce correo y código OTP.", "error"); return; }
          btnVerifyOtp.disabled = true;
          try {
            var data = await postJson("/api/auth/mfa/otp/verify", { email: email, code: code });
            saveSessionAndGo(data);
          } catch (err) {
            setStatus(err.message || "Código OTP inválido.", "error");
            btnVerifyOtp.disabled = false;
          }
        });
      }

      // Passkey WebAuthn Login
      function b64uToBytes(s) {
        var b = String(s).replace(/-/g, "+").replace(/_/g, "/");
        var bin = atob(b + "===".slice((b.length + 3) % 4));
        var arr = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
        return arr;
      }
      function bytesToB64u(buf) {
        var arr = new Uint8Array(buf);
        var s = "";
        for (var i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
        return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
      }
      var btnPk = document.getElementById("btnPasskeyLogin");
      if (btnPk) {
        btnPk.addEventListener("click", async function () {
          if (!window.PublicKeyCredential) {
            setStatus("Este navegador no soporta Passkeys WebAuthn.", "error");
            return;
          }
          var email = (document.getElementById("totpEmail").value || document.getElementById("pwEmail").value || "").trim();
          btnPk.disabled = true;
          setStatus("Esperando confirmación biométrica o llave de seguridad…", "info");
          try {
            var opts = await postJson("/api/auth/passkey/login/options", email ? { email: email } : {});
            var pk = opts.publicKey || opts.options || opts;
            pk.challenge = b64uToBytes(pk.challenge);
            if (Array.isArray(pk.allowCredentials)) {
              pk.allowCredentials = pk.allowCredentials.map(function (c) {
                return Object.assign({}, c, { id: b64uToBytes(c.id) });
              });
            }
            var cred = await navigator.credentials.get({ publicKey: pk });
            if (!cred) throw new Error("Autenticación cancelada.");
            var payload = {
              credential_id: cred.id,
              authenticator_data: bytesToB64u(cred.response.authenticatorData),
              client_data_json: bytesToB64u(cred.response.clientDataJSON),
              signature: bytesToB64u(cred.response.signature)
            };
            var data = await postJson("/api/auth/passkey/login/verify", payload);
            saveSessionAndGo(data);
          } catch (err) {
            setStatus(err.message || "No se pudo completar el inicio con Passkey.", "error");
            btnPk.disabled = false;
          }
        });
      }

      // Forgot password inline
      var forgotBox = document.getElementById("forgotBox");
      var btnForgotToggle = document.getElementById("btnForgotToggle");
      var btnForgotClose = document.getElementById("btnForgotClose");
      var btnSendForgot = document.getElementById("btnSendForgot");
      if (btnForgotToggle && forgotBox) {
        btnForgotToggle.addEventListener("click", function () {
          forgotBox.hidden = !forgotBox.hidden;
          var cur = (document.getElementById("pwEmail").value || "").trim();
          if (cur) document.getElementById("forgotEmail").value = cur;
        });
      }
      if (btnForgotClose && forgotBox) {
        btnForgotClose.addEventListener("click", function () { forgotBox.hidden = true; });
      }
      if (btnSendForgot) {
        btnSendForgot.addEventListener("click", async function () {
          var email = (document.getElementById("forgotEmail").value || "").trim();
          if (!email) { setStatus("Introduce tu correo para recibir el enlace.", "error"); return; }
          btnSendForgot.disabled = true;
          try {
            await postJson("/api/setups/password/forgot", { email: email });
            setStatus("Si la cuenta está autorizada, hemos enviado el enlace a tu correo.", "ok");
            forgotBox.hidden = true;
          } catch (err) {
            setStatus(err.message || "Error al solicitar el enlace.", "error");
          } finally {
            btnSendForgot.disabled = false;
          }
        });
      }
    })();
  </script>
</Layout>

<style>
  .mm-login-page {
    min-height: calc(100vh - 64px);
    padding: 96px 20px 64px;
    background: var(--r-bg);
    color: var(--r-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mm-login-shell {
    width: 100%;
    max-width: 1040px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 440px);
    gap: 56px;
    align-items: center;
  }
  .mm-login-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--r-line);
    background: var(--r-surface);
    font: 700 11px/1 var(--r-mono, ui-monospace, monospace);
    letter-spacing: 0.08em;
    color: var(--r-accent, #10b981);
    margin-bottom: 18px;
  }
  .mm-login-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--r-accent, #10b981);
  }
  .mm-login-aside h1 {
    font-family: var(--r-sans, system-ui, sans-serif);
    text-transform: none;
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 14px;
    color: var(--r-text);
  }
  .mm-login-aside__lead {
    font-size: 16px;
    line-height: 1.65;
    color: var(--r-muted);
    margin: 0 0 28px;
  }
  .mm-login-aside__lead strong { color: var(--r-text); }
  .mm-login-pillars { display: grid; gap: 14px; }
  .mm-login-pillar {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--r-line);
    background: var(--r-surface);
  }
  .mm-login-pillar__icon { font-size: 18px; line-height: 1.2; }
  .mm-login-pillar strong { display: block; font-size: 14px; color: var(--r-text); margin-bottom: 3px; }
  .mm-login-pillar p { margin: 0; font-size: 13.2px; line-height: 1.55; color: var(--r-muted); }
  .mm-login-pillar a { color: var(--r-accent, #10b981); font-weight: 600; text-decoration: none; }
  .mm-login-pillar a:hover { text-decoration: underline; }

  .mm-login-card {
    background: var(--r-surface);
    border: 1px solid var(--r-line);
    border-radius: 18px;
    padding: 28px 28px 24px;
    box-shadow: 0 22px 50px -28px rgba(0, 0, 0, 0.45);
  }
  .mm-login-card__head h2 {
    margin: 0 0 4px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--r-text);
  }
  .mm-login-card__head p {
    margin: 0 0 18px;
    font-size: 13.5px;
    color: var(--r-muted);
  }

  .mm-btn-passkey {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 16px;
