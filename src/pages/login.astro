---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Iniciar sesión · Muntrume Motorsport"
  description="Acceso unificado Zero-Trust de Muntrume Motorsport: inicia sesión sin contraseña con Passkey WebAuthn, Authenticator TOTP, código por correo o MFA Open Source con sesión persistente de hasta 30 días."
  canonical="https://muntru.me/login/"
  noindex={true}
>
  <main class="ml-page">
    <div class="ml-bg" aria-hidden="true">
      <div class="ml-bg__grid"></div>
      <div class="ml-bg__glow"></div>
    </div>

    <div class="ml-shell">
      <!-- LEFT EDITORIAL BRAND PANEL -->
      <section class="ml-aside" aria-label="Muntrume ID">
        <div class="ml-brand">
          <img src="/assets/img/icon-192.png" alt="Muntrume Motorsport" width="32" height="32" class="ml-brand__logo" />
          <div class="ml-brand__meta">
            <strong>Muntrume ID</strong>
            <span>ZERO-TRUST · SESIÓN HASTA 30 DÍAS</span>
          </div>
        </div>

        <h1>Un solo acceso para todo el equipo</h1>
        <p class="ml-aside__lead">
          Entra sin fricción al <strong>Setup Vault</strong> (+42.600 setups <code>.sto</code>), <strong>Muntrume AI Studio</strong>, <strong>MMT Sync</strong> y <strong>Race Control</strong> con seguridad criptográfica sin coste.
        </p>

        <div class="ml-features">
          <div class="ml-feat">
            <div class="ml-feat__ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
            </div>
            <div>
              <strong>Passkeys FIDO2 y Authenticator sin contraseña</strong>
              <p>Accede en 1 toque con Windows Hello, Touch ID, Face ID o código de 6 dígitos TOTP RFC 6238.</p>
            </div>
          </div>

          <div class="ml-feat">
            <div class="ml-feat__ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </div>
            <div>
              <strong>MFA 100 % Open Source y verificación Step-Up</strong>
              <p>Compatible con <code>ntfy.sh</code>, Discord DM, Android SMS Gateway y WhatsApp self-hosted. Cualquier cambio de seguridad confirma antes tu identidad.</p>
            </div>
          </div>

          <div class="ml-feat">
            <div class="ml-feat__ico" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <strong>Sesión persistente de 30 días</strong>
              <p>Mantén tu sesión abierta entre <code>muntru.me</code> y <code>ai.muntru.me</code> sin volver a escribir claves cada semana.</p>
            </div>
          </div>
        </div>

        <div class="ml-ecosys" aria-label="Servicios incluidos">
          <a href="/garage/">Garage Vault</a>
          <a href="https://ai.muntru.me/">Muntrume AI</a>
          <a href="https://docs.muntru.me/">Documentación</a>
          <a href="https://support.muntru.me/">Centro de Soporte</a>
          <a href="/app/">MMT Sync</a>
        </div>
      </section>

      <!-- RIGHT FLOATING AUTH CARD -->
      <section class="ml-card" aria-label="Iniciar sesión">
        <!-- ACTIVE SESSION QUICK-CONTINUE -->
        <div id="activeSessionBox" class="ml-session-box" hidden>
          <div class="ml-session-box__info">
            <div id="activeAvatar" class="ml-session-avatar">MM</div>
            <div>
              <strong id="activeName">Sesión activa</strong>
              <span id="activeEmail"></span>
            </div>
          </div>
          <div class="ml-session-box__actions">
            <button type="button" id="btnContinueSession" class="ml-btn-primary">Continuar →</button>
            <button type="button" id="btnSwitchAccount" class="ml-btn-subtle">Usar otra cuenta</button>
          </div>
        </div>

        <div class="ml-card__head">
          <h2>Iniciar sesión</h2>
          <p>Elige acceso instantáneo sin contraseña o tus credenciales de equipo.</p>
        </div>

        <!-- PRIMARY 1-TAP PASSKEY -->
        <button type="button" id="btnPasskeyLogin" class="ml-btn-passkey">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Entrar con Passkey</span>
          <span class="ml-pk-tag">1 toque</span>
        </button>

        <div class="ml-divider"><span>o selecciona otro método</span></div>

        <!-- SEGMENTED METHOD TABS -->
        <div class="ml-tabs" role="tablist">
          <button type="button" class="ml-tab is-active" data-auth-tab="totp" role="tab" aria-selected="true">Authenticator</button>
          <button type="button" class="ml-tab" data-auth-tab="app" role="tab" aria-selected="false">App Móvil</button>
          <button type="button" class="ml-tab" data-auth-tab="code" role="tab" aria-selected="false">Email</button>
          <button type="button" class="ml-tab" data-auth-tab="otp" role="tab" aria-selected="false">MFA OSS</button>
          <button type="button" class="ml-tab" data-auth-tab="password" role="tab" aria-selected="false">Contraseña</button>
        </div>

        <!-- FEEDBACK ALERT -->
        <div id="loginStatus" class="ml-alert" hidden role="status" aria-live="polite"></div>

        <!-- TAB 1: AUTHENTICATOR (TOTP PASSWORDLESS) -->
        <form id="formTotp" class="ml-form" data-auth-panel="totp" novalidate>
          <label class="ml-field">
            <span>Correo de equipo</span>
            <input type="email" id="totpEmail" data-sync-email autocomplete="username" placeholder="piloto@muntru.me" required />
          </label>
          <label class="ml-field">
            <span>Código de 6 dígitos (o recuperación XXXX-XXXX)</span>
            <input type="text" id="totpCode" class="ml-code-input" inputmode="text" maxlength="12" autocomplete="one-time-code" placeholder="000 000" required />
          </label>
          <button type="submit" id="btnSubmitTotp" class="ml-btn-primary">Entrar con Authenticator</button>
        </form>

        <!-- TAB 1B: MOBILE APP APPROVAL & ACCOUNT RECOVERY -->
        <form id="formAppApprove" class="ml-form" data-auth-panel="app" hidden novalidate>
          <label class="ml-field">
            <span>Correo de equipo</span>
            <input type="email" id="appApproveEmail" data-sync-email autocomplete="email" placeholder="piloto@muntru.me" required />
          </label>
          <label class="ml-field">
            <span>Acción</span>
            <select id="appApprovePurpose">
              <option value="login">Iniciar sesión desde la App Móvil (1 toque)</option>
              <option value="recovery">Recuperar cuenta y crear nueva contraseña</option>
            </select>
          </label>
          <div id="appApproveWaitBox" hidden style="padding:14px;border-radius:12px;border:1px solid var(--r-line);background:var(--r-bg);text-align:center;display:grid;gap:10px;">
            <div style="font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--r-muted);">Número de confirmación</div>
            <div id="appApproveCode" style="font:800 36px/1 var(--r-mono,monospace);color:var(--r-accent);letter-spacing:0.12em;">--</div>
            <p style="margin:0;font-size:12.5px;color:var(--r-muted);line-height:1.45;">Abre la <strong>App Muntrume</strong> en tu teléfono (<a href="/app/" style="color:var(--r-accent);">muntru.me/app</a>), comprueba este número y pulsa <strong>Aprobar</strong>, o escanea este QR:</p>
            <img id="appApproveQr" alt="QR de aprobación móvil" width="150" height="150" style="margin:0 auto;border-radius:10px;background:#fff;padding:6px;border:1px solid var(--r-line);" />
            <div id="appApproveState" style="font-size:12px;font-weight:600;color:var(--r-accent);">⏳ Esperando aprobación en tu teléfono…</div>
          </div>
          <button type="submit" id="btnStartAppApprove" class="ml-btn-primary">Enviar solicitud a mi App Móvil</button>
        </form>

        <!-- TAB 2: EMAIL MAGIC CODE -->
        <form id="formEmailCode" class="ml-form" data-auth-panel="code" hidden novalidate>
          <label class="ml-field">
            <span>Correo de equipo</span>
            <input type="email" id="codeEmail" data-sync-email autocomplete="email" placeholder="piloto@muntru.me" required />
          </label>
          <div id="codeStepVerify" hidden>
            <label class="ml-field">
              <span>Código recibido en tu correo</span>
              <input type="text" id="codeInput" class="ml-code-input" inputmode="numeric" maxlength="8" autocomplete="one-time-code" placeholder="000 000" />
            </label>
          </div>
          <div class="ml-form-stack">
            <button type="button" id="btnRequestCode" class="ml-btn-primary">Enviar código al correo</button>
            <button type="submit" id="btnVerifyCode" class="ml-btn-primary" hidden>Verificar código y entrar</button>
          </div>
        </form>

        <!-- TAB 3: OPEN-SOURCE OTP -->
        <form id="formOssOtp" class="ml-form" data-auth-panel="otp" hidden novalidate>
          <label class="ml-field">
            <span>Correo de equipo</span>
            <input type="email" id="otpEmail" data-sync-email autocomplete="email" placeholder="piloto@muntru.me" required />
          </label>
          <label class="ml-field">
            <span>Canal Open Source configurado</span>
            <select id="otpChannel">
              <option value="ntfy">ntfy.sh (Push móvil instantáneo)</option>
              <option value="discord">Discord DM (Bot oficial MMT)</option>
              <option value="sms_gateway">Android SMS Gateway (SMS propio)</option>
              <option value="whatsapp_oss">WhatsApp self-hosted (Evolution / WAHA)</option>
            </select>
          </label>
          <div id="otpStepVerify" hidden>
            <label class="ml-field">
              <span>Código OTP de 6 dígitos</span>
              <input type="text" id="otpCodeInput" class="ml-code-input" inputmode="numeric" maxlength="8" autocomplete="one-time-code" placeholder="000 000" />
            </label>
          </div>
          <div class="ml-form-stack">
            <button type="button" id="btnSendOtp" class="ml-btn-primary">Enviar OTP al canal</button>
            <button type="submit" id="btnVerifyOtp" class="ml-btn-primary" hidden>Validar OTP y entrar</button>
          </div>
        </form>

        <!-- TAB 4: PASSWORD -->
        <form id="formPassword" class="ml-form" data-auth-panel="password" hidden novalidate>
          <label class="ml-field">
            <span>Correo de equipo</span>
            <input type="email" id="pwEmail" data-sync-email name="email" autocomplete="username webauthn" placeholder="piloto@muntru.me" required />
          </label>
          <label class="ml-field">
            <div class="ml-field__row">
              <span>Contraseña</span>
              <button type="button" id="btnForgotToggle" class="ml-link-btn">¿Primer acceso u olvidaste tu clave?</button>
            </div>
            <div class="ml-pw-wrap">
              <input type="password" id="pwPass" name="password" autocomplete="current-password" placeholder="••••••••••••" required />
              <button type="button" id="btnTogglePw" class="ml-pw-eye" aria-label="Mostrar u ocultar contraseña">Ver</button>
            </div>
          </label>
          <button type="submit" id="btnSubmitPw" class="ml-btn-primary">Iniciar sesión</button>
        </form>

        <!-- INLINE FORGOT PASSWORD -->
        <div id="forgotBox" class="ml-forgot" hidden>
          <div class="ml-forgot__head">
            <strong>Restablecer o crear contraseña</strong>
            <button type="button" id="btnForgotClose" class="ml-link-btn">Cerrar</button>
          </div>
          <p>Te enviaremos un enlace firmado desde <code>mail.muntru.me</code> para definir tu contraseña.</p>
          <div class="ml-forgot__row">
            <input type="email" id="forgotEmail" data-sync-email placeholder="piloto@muntru.me" />
            <button type="button" id="btnSendForgot" class="ml-btn-mini">Enviar</button>
          </div>
        </div>

        <div class="ml-card__foot">
          <a href="/settings/">Configuración de cuenta</a>
          <a href="https://support.muntru.me/">¿Necesitas ayuda? Soporte</a>
          <a href="/contact/?to=admin">Solicitar acceso →</a>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    (function () {
      var API = "https://api.muntru.me";
      var params = new URLSearchParams(location.search);
      var nextRaw = params.get("next") || params.get("redirect") || "/garage/";
      var nextUrl = /^https:\/\/(ai|docs|support|skins|muntru)\.muntru\.me(\/|$)/i.test(nextRaw)
        ? nextRaw
        : (nextRaw.startsWith("/") && !nextRaw.startsWith("//") && !nextRaw.includes("\\") ? nextRaw : "/garage/");

      function sanitizeUser(u) {
        if (!u || !u.email) return null;
        return { id: u.id, email: u.email, name: u.name || u.email.split("@")[0], role: u.role || "driver", has_setup_access: u.has_setup_access ? 1 : 0 };
      }

      function buildTarget(token, user) {
        var target = nextUrl;
        var cleanUser = sanitizeUser(user);
        if (window.__mmtSyncSsoCookie) window.__mmtSyncSsoCookie(token, cleanUser);
        if (/^https:\/\/(ai|support|skins)\.muntru\.me(\/|$)/i.test(target) && token) {
          var uEnc = "";
          try { if (cleanUser) uEnc = "&mm_user=" + encodeURIComponent(btoa(unescape(encodeURIComponent(JSON.stringify(cleanUser))))); } catch (e) {}
          target = target.split("#")[0] + "#mm_auth=" + encodeURIComponent(token) + uEnc;
        }
        return target;
      }

      // Check existing active session (instant SSO bounce when coming from ai.muntru.me, support.muntru.me or skins.muntru.me)
      try {
        var existingTk = localStorage.getItem("mrt_vault_token") || localStorage.getItem("mm_token") || "";
        var existingUser = JSON.parse(localStorage.getItem("mrt_vault_user") || "null");
        if (existingTk && existingUser && existingUser.email) {
          if (/^https:\/\/(ai|support|skins)\.muntru\.me(\/|$)/i.test(nextUrl) && params.get("switch") !== "1") {
            location.replace(buildTarget(existingTk, existingUser));
            return;
          }
          var box = document.getElementById("activeSessionBox");
          var nm = existingUser.name || existingUser.email.split("@")[0];
          document.getElementById("activeName").textContent = "Sesión activa · " + nm;
          document.getElementById("activeEmail").textContent = existingUser.email;
          document.getElementById("activeAvatar").textContent = nm.split(/\s+/).map(function (w) { return w[0] || ""; }).join("").slice(0, 2).toUpperCase() || "MM";
          box.hidden = false;
          document.getElementById("btnContinueSession").addEventListener("click", function () {
            location.href = buildTarget(existingTk, existingUser);
          });
          document.getElementById("btnSwitchAccount").addEventListener("click", function () {
            localStorage.removeItem("mrt_vault_token");
            localStorage.removeItem("mm_token");
            localStorage.removeItem("mrt_vault_user");
            if (window.__mmtClearSsoCookie) window.__mmtClearSsoCookie();
            box.hidden = true;
          });
        }
      } catch (e) {}

      // Sync email input across all method tabs
      var emailInputs = document.querySelectorAll("[data-sync-email]");
      emailInputs.forEach(function (inp) {
        inp.addEventListener("input", function () {
          var v = inp.value;
          emailInputs.forEach(function (other) { if (other !== inp) other.value = v; });
        });
      });

      var statusEl = document.getElementById("loginStatus");
      function setStatus(msg, type) {
        if (!statusEl) return;
        if (!msg) { statusEl.hidden = true; return; }
        statusEl.textContent = msg;
        statusEl.className = "ml-alert ml-alert--" + (type || "info");
        statusEl.hidden = false;
      }

      function saveSessionAndGo(data) {
        if (!data || !data.token) {
          setStatus("No se recibió token de sesión.", "error");
          return;
        }
        try {
          var cleanUser = sanitizeUser(data.user);
          localStorage.setItem("mrt_vault_token", data.token);
          localStorage.setItem("mm_token", data.token);
          if (cleanUser) localStorage.setItem("mrt_vault_user", JSON.stringify(cleanUser));
          if (window.__mmtSyncSsoCookie) window.__mmtSyncSsoCookie(data.token, cleanUser);
        } catch (e) {}
        setStatus("Sesión verificada (activa 30 días). Redirigiendo…", "ok");
        setTimeout(function () { location.href = buildTarget(data.token, data.user); }, 320);
      }

      async function postJson(path, body) {
        var r = await fetch(API + path, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body || {})
        });
        var data = await r.json().catch(function () { return {}; });
        if (!r.ok || data.success === false) {
          throw new Error(data.error || ("Error HTTP " + r.status));
        }
        return data;
      }

      // Tabs
      document.querySelectorAll("[data-auth-tab]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-auth-tab");
          setStatus("");
          document.querySelectorAll("[data-auth-tab]").forEach(function (t) {
            var active = t === btn;
            t.classList.toggle("is-active", active);
            t.setAttribute("aria-selected", active ? "true" : "false");
          });
          document.querySelectorAll("[data-auth-panel]").forEach(function (p) {
            p.hidden = p.getAttribute("data-auth-panel") !== id;
          });
        });
      });

      // Toggle password visibility
      var pwPass = document.getElementById("pwPass");
      var btnTogglePw = document.getElementById("btnTogglePw");
      if (btnTogglePw && pwPass) {
        btnTogglePw.addEventListener("click", function () {
          var show = pwPass.type === "password";
          pwPass.type = show ? "text" : "password";
          btnTogglePw.textContent = show ? "Ocultar" : "Ver";
        });
      }

      // Authenticator TOTP passwordless
      document.getElementById("formTotp")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        var email = (document.getElementById("totpEmail").value || "").trim();
        var code = (document.getElementById("totpCode").value || "").trim();
        if (!email || !code) { setStatus("Introduce tu correo y el código de 6 dígitos.", "error"); return; }
        var btn = document.getElementById("btnSubmitTotp");
        btn.disabled = true;
        setStatus("Verificando código Authenticator…", "info");
        try {
          var data = await postJson("/api/auth/mfa/totp/login", { email: email, code: code });
          saveSessionAndGo(data);
        } catch (err) {
          setStatus(err.message || "Código Authenticator inválido.", "error");
          btn.disabled = false;
        }
      });

      // Password login
      document.getElementById("formPassword")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        var email = (document.getElementById("pwEmail").value || "").trim();
        var password = pwPass.value || "";
        if (!email || !password) { setStatus("Introduce tu correo y contraseña.", "error"); return; }
        var btn = document.getElementById("btnSubmitPw");
        btn.disabled = true;
        setStatus("Verificando credenciales…", "info");
        try {
          var data = await postJson("/api/setups/auth", { email: email, password: password });
          saveSessionAndGo(data);
        } catch (err) {
          setStatus(err.message || "Error al iniciar sesión.", "error");
          btn.disabled = false;
        }
      });

      // Email magic code
      var btnReqCode = document.getElementById("btnRequestCode");
      var btnVerCode = document.getElementById("btnVerifyCode");
      var codeStep = document.getElementById("codeStepVerify");
      btnReqCode?.addEventListener("click", async function () {
        var email = (document.getElementById("codeEmail").value || "").trim();
        if (!email) { setStatus("Introduce tu correo de equipo.", "error"); return; }
        btnReqCode.disabled = true;
        setStatus("Enviando código a tu correo…", "info");
        try {
          await postJson("/api/setups/code/request", { email: email });
          codeStep.hidden = false;
          btnVerCode.hidden = false;
          btnReqCode.textContent = "Reenviar código";
          document.getElementById("codeInput")?.focus();
          setStatus("Código enviado. Revisa tu bandeja de entrada.", "ok");
        } catch (err) {
          setStatus(err.message || "No se pudo enviar el código.", "error");
        } finally { btnReqCode.disabled = false; }
      });
      document.getElementById("formEmailCode")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        var email = (document.getElementById("codeEmail").value || "").trim();
        var code = (document.getElementById("codeInput").value || "").trim();
        if (!email || !code) { setStatus("Introduce el correo y el código recibido.", "error"); return; }
        btnVerCode.disabled = true;
        try {
          var data = await postJson("/api/setups/code/verify", { email: email, code: code });
          saveSessionAndGo(data);
        } catch (err) {
          setStatus(err.message || "Código inválido o caducado.", "error");
          btnVerCode.disabled = false;
        }
      });

      // Open-Source OTP
      var btnSendOtp = document.getElementById("btnSendOtp");
      var btnVerifyOtp = document.getElementById("btnVerifyOtp");
      var otpStep = document.getElementById("otpStepVerify");
      btnSendOtp?.addEventListener("click", async function () {
        var email = (document.getElementById("otpEmail").value || "").trim();
        var channel = document.getElementById("otpChannel").value;
        if (!email) { setStatus("Introduce tu correo de equipo.", "error"); return; }
        btnSendOtp.disabled = true;
        setStatus("Enviando OTP por " + channel + "…", "info");
        try {
          await postJson("/api/auth/mfa/otp/send", { email: email, channel: channel });
          otpStep.hidden = false;
          btnVerifyOtp.hidden = false;
          document.getElementById("otpCodeInput")?.focus();
          setStatus("Código OTP enviado a tu canal.", "ok");
        } catch (err) {
          setStatus(err.message || "No se pudo enviar el OTP.", "error");
        } finally { btnSendOtp.disabled = false; }
      });
      document.getElementById("formOssOtp")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        var email = (document.getElementById("otpEmail").value || "").trim();
        var code = (document.getElementById("otpCodeInput").value || "").trim();
        if (!email || !code) { setStatus("Introduce correo y código OTP.", "error"); return; }
        btnVerifyOtp.disabled = true;
        try {
          var data = await postJson("/api/auth/mfa/otp/verify", { email: email, code: code });
          saveSessionAndGo(data);
        } catch (err) {
          setStatus(err.message || "Código OTP inválido.", "error");
          btnVerifyOtp.disabled = false;
        }
      });

      // Passkey WebAuthn
      function b64uToBytes(s) {
        var b = String(s).replace(/-/g, "+").replace(/_/g, "/");
        var bin = atob(b + "===".slice((b.length + 3) % 4));
        var arr = new Uint8Array(bin.length);
        for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
        return arr;
      }
      function bytesToB64u(buf) {
        var arr = new Uint8Array(buf);
        var s = "";
        for (var i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
        return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
      }
      var btnPk = document.getElementById("btnPasskeyLogin");
      btnPk?.addEventListener("click", async function () {
        if (!window.PublicKeyCredential) { setStatus("Este navegador no soporta Passkeys WebAuthn.", "error"); return; }
        var email = (document.getElementById("totpEmail").value || "").trim();
        btnPk.disabled = true;
        setStatus("Esperando confirmación biométrica o llave FIDO2…", "info");
        try {
          var opts = await postJson("/api/auth/passkey/login/options", email ? { email: email } : {});
          var pk = opts.publicKey || opts.options || opts;
          pk.challenge = b64uToBytes(pk.challenge);
          if (Array.isArray(pk.allowCredentials)) {
            pk.allowCredentials = pk.allowCredentials.map(function (c) {
              return Object.assign({}, c, { id: b64uToBytes(c.id) });
            });
          }
          var cred = await navigator.credentials.get({ publicKey: pk });
          if (!cred) throw new Error("Autenticación cancelada.");
          var data = await postJson("/api/auth/passkey/login/verify", {
            credential_id: cred.id,
            authenticator_data: bytesToB64u(cred.response.authenticatorData),
            client_data_json: bytesToB64u(cred.response.clientDataJSON),
            signature: bytesToB64u(cred.response.signature)
          });
          saveSessionAndGo(data);
        } catch (err) {
          setStatus(err.message || "No se pudo completar el inicio con Passkey.", "error");
          btnPk.disabled = false;
        }
      });

      // Mobile App Approval & Account Recovery (Muntrume Guard)
      var appApproveTimer = null;
      document.getElementById("formAppApprove")?.addEventListener("submit", async function (e) {
        e.preventDefault();
        if (appApproveTimer) { clearInterval(appApproveTimer); appApproveTimer = null; }
        var email = (document.getElementById("appApproveEmail")?.value || "").trim();
        var purpose = document.getElementById("appApprovePurpose")?.value || "login";
        if (!email) { setStatus("Introduce tu correo de equipo.", "error"); return; }
        var btn = document.getElementById("btnStartAppApprove");
        var waitBox = document.getElementById("appApproveWaitBox");
        var codeEl = document.getElementById("appApproveCode");
        var qrEl = document.getElementById("appApproveQr");
        var stateEl = document.getElementById("appApproveState");
        if (btn) btn.disabled = true;
        setStatus("Enviando solicitud a tu App Muntrume…", "info");
        try {
          var res = await postJson("/api/auth/app-approve/start", { email: email, purpose: purpose });
          if (codeEl) codeEl.textContent = res.match_code || "--";
          if (qrEl && res.approve_url) {
            qrEl.src = "https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=" + encodeURIComponent(res.approve_url);
          }
          if (stateEl) stateEl.textContent = "⏳ Esperando aprobación en tu teléfono…";
          if (waitBox) waitBox.hidden = false;
          setStatus("Solicitud enviada. Confirma el número " + res.match_code + " en tu App Muntrume.", "info");

          var cid = res.challenge_id;
          appApproveTimer = setInterval(async function () {
            try {
              var pr = await fetch(API + "/api/auth/app-approve/poll?id=" + encodeURIComponent(cid));
              var pd = await pr.json().catch(function () { return {}; });
              if (pd.status === "approved" && pd.token) {
                clearInterval(appApproveTimer);
                appApproveTimer = null;
                if (stateEl) stateEl.textContent = "✅ ¡Aprobado desde tu teléfono!";
                if (pd.purpose === "recovery" && pd.set_password_link) {
                  try {
                    var cu = sanitizeUser(pd.user);
                    localStorage.setItem("mrt_vault_token", pd.token);
                    localStorage.setItem("mm_token", pd.token);
                    if (cu) localStorage.setItem("mrt_vault_user", JSON.stringify(cu));
                    if (window.__mmtSyncSsoCookie) window.__mmtSyncSsoCookie(pd.token, cu);
                  } catch (err) {}
                  setStatus("Cuenta recuperada desde tu App. Abriendo cambio de contraseña…", "ok");
                  setTimeout(function () { location.href = pd.set_password_link; }, 450);
                } else {
                  saveSessionAndGo(pd);
                }
              } else if (pd.status === "denied") {
                clearInterval(appApproveTimer);
                appApproveTimer = null;
                if (stateEl) stateEl.textContent = "✕ Solicitud rechazada desde tu teléfono.";
                setStatus("El inicio de sesión fue rechazado desde la App Móvil.", "error");
              } else if (pd.status === "expired") {
                clearInterval(appApproveTimer);
                appApproveTimer = null;
                if (stateEl) stateEl.textContent = "⌛ Solicitud caducada. Vuelve a enviarla.";
                setStatus("La solicitud ha caducado. Pulsa el botón para generar una nueva.", "error");
              }
            } catch (err) {}
          }, 2200);
        } catch (err) {
          setStatus(err.message || "No se pudo iniciar la aprobación móvil.", "error");
        } finally {
          if (btn) btn.disabled = false;
        }
      });

      // Forgot password
      var forgotBox = document.getElementById("forgotBox");
      document.getElementById("btnForgotToggle")?.addEventListener("click", function () {
        forgotBox.hidden = !forgotBox.hidden;
      });
      document.getElementById("btnForgotClose")?.addEventListener("click", function () {
        forgotBox.hidden = true;
      });
      document.getElementById("btnSendForgot")?.addEventListener("click", async function () {
        var email = (document.getElementById("forgotEmail").value || "").trim();
        if (!email) { setStatus("Introduce tu correo para recibir el enlace.", "error"); return; }
        var b = document.getElementById("btnSendForgot");
        b.disabled = true;
        try {
          await postJson("/api/setups/password/forgot", { email: email });
          setStatus("Si la cuenta está autorizada, hemos enviado el enlace desde mail.muntru.me.", "ok");
          forgotBox.hidden = true;
        } catch (err) {
          setStatus(err.message || "Error al solicitar el enlace.", "error");
        } finally { b.disabled = false; }
      });
    })();
  </script>
</Layout>

