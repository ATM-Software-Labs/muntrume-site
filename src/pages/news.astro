---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Sala de Prensa y Noticias de Competición · Muntrume Motorsport";
const pageDescription = "Últimas noticias de Muntrume Motorsport en iRacing, crónicas de carreras de resistencia, comunicados oficiales de escudería y novedades del sim racing.";
---

<Layout title={pageTitle} description={pageDescription}>
<!-- ========================================================================= -->
  <!-- 2. BREAKING TICKER (Clean Marquee)                                        -->
  <!-- ========================================================================= -->
  <div id="breakingBanner" class="fixed top-16 left-0 right-0 z-40 bg-[#161c24]/95 backdrop-blur-md border-b border-white/10 text-neutral-300 text-xs py-2 px-4 flex items-center gap-3 overflow-hidden hidden">
    <div class="flex items-center gap-2 flex-shrink-0 bg-emerald-500/15 text-emerald-400 px-2.5 py-0.5 rounded-full border border-emerald-500/30 text-[11px] font-semibold uppercase tracking-wider">
      <span class="pulse-dot"></span>
      <span>LATEST DISPATCH</span>
    </div>
    <div class="overflow-hidden flex-1 relative">
      <div class="scrolling-ticker text-xs" id="breakingText"></div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 3. NEWS WIRE HERO & METADATA STRIP                                        -->
  <!-- ========================================================================= -->
  <section class="pt-28 pb-10 bg-[#0e1217] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top status badges -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-8 border-b border-white/10 text-xs">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-semibold tracking-wide uppercase flex items-center gap-2">
            <span class="pulse-dot"></span>
            Wire Live &amp; Connected
          </span>
          <span class="text-neutral-400 hidden sm:inline" id="currentDate">SYNCING CLOCK...</span>
          <span class="text-neutral-600 hidden md:inline">•</span>
          <span class="text-neutral-400 hidden md:inline">Updated: <span id="lastUpdate" class="text-neutral-200 font-medium">Just now</span></span>
        </div>

        <div class="flex items-center gap-3 text-neutral-400 w-full sm:w-auto">
          <span class="hidden sm:inline">Sant Andreu, Barcelona</span>
          <span class="text-neutral-700 hidden sm:inline">|</span>
          <span class="px-2.5 py-0.5 rounded-md bg-[#161c24] border border-white/10 text-emerald-400 font-semibold" id="articleCount">0 Articles</span>
          <span class="px-2.5 py-0.5 rounded-md bg-[#161c24] border border-white/10 text-neutral-300 font-medium" id="sourceCount">0 Sources</span>
          <span class="text-neutral-700 hidden sm:inline">|</span>
        </div>
      </div>

      <!-- Main Editorial Header -->
      <div class="text-center py-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#161c24] border border-white/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <span>Press Room &amp; Media Wire</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white mb-4">
          PRESS ROOM &amp; <span class="text-emerald-400">MEDIA WIRE</span>
        </h1>
        <p class="text-base text-neutral-400 max-w-2xl mx-auto leading-relaxed">
          Team updates and motorsport headlines from public RSS feeds.
        </p>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. MAIN NEWS WIRE & ASIDE WIDGETS                                         -->
  <!-- ========================================================================= -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- MAIN FEED COLUMN (8 Cols) -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- SECTION: TOP STORIES & FILTER BAR -->
        <section id="top-stories">
          
          <!-- Search & Filter Controls -->
          <div class="bg-[#161c24] border border-white/10 rounded-2xl p-5 mb-6 space-y-4 shadow-lg">
            
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <h2 class="text-xl font-bold text-white tracking-tight">Top Wire Stories</h2>
              </div>
              
              <!-- Search bar -->
              <div class="relative w-full sm:w-72">
                <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input 
                  type="text" 
                  id="searchInput" 
                  placeholder="Search intel &amp; dispatches..." 
                  class="w-full bg-[#0e1217] border border-white/10 rounded-xl pl-10 pr-3.5 py-2.5 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500 transition"
                >
              </div>
            </div>

            <!-- Filter Pills -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-white/10" id="filterButtons">
              <button class="filter-btn active px-3.5 py-2 rounded-xl text-xs font-bold transition bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 cursor-pointer" data-filter="all">All Dispatches</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="team">Team News</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="iracing">iRacing</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="simracing">Sim Racing</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="esports">Esports</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="sport">Motorsport</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="tech">Hardware &amp; Tech</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="endurance">Endurance</button>
              <button class="filter-btn px-3.5 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer" data-filter="breaking">Breaking</button>
            </div>

          </div>

          <!-- Loading Skeleton (Hidden by default since static articles are pre-rendered) -->
          <div id="loadingState" class="hidden space-y-4">
            <div class="loading-skeleton h-96 rounded-2xl border border-white/10"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="loading-skeleton h-48 rounded-2xl border border-white/10"></div>
              <div class="loading-skeleton h-48 rounded-2xl border border-white/10"></div>
            </div>
          </div>

          <!-- Loaded Articles Container (Visible by default) -->
          <div id="featuredGrid" class="space-y-6">
            <div id="mainFeatured">
              <a href="/setups" class="group block relative overflow-hidden rounded-3xl bg-[#161c24] border border-white/10 hover:border-white/20 transition duration-300 shadow-2xl">
                <div class="h-80 sm:h-96 w-full relative overflow-hidden bg-[#0e1217]">
                  <img src="/assets/img/coche1-640.webp" alt="Despacho Oficial 24H Le Mans" width="640" height="360" loading="eager" decoding="async" class="w-full h-full object-cover transition duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-90" />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#161c24] via-[#161c24]/70 to-transparent"></div>
                </div>
                <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
                  <div class="flex items-center gap-2.5 mb-3 flex-wrap text-xs">
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-bold text-[10px] tracking-wider uppercase">Breaking</span>
                    <span class="px-2.5 py-0.5 rounded-full bg-[#1c232d] text-neutral-300 border border-white/10 text-[11px] font-medium">Muntrume Engineering</span>
                    <span class="text-neutral-400 text-xs">Temporada 2026 Season 4</span>
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-2 group-hover:text-emerald-400 transition-colors leading-tight">
                    🏁 Despacho Oficial 24H Le Mans 26S4: Setup Valkyrie GTP y Telemetría de Mulsanne
                  </h3>
                  <p class="text-neutral-300 text-xs sm:text-sm line-clamp-2 mb-4 max-w-3xl leading-relaxed">
                    Análisis de telemetría a 60 Hz para prototipos GTP en Les Hunaudières. Calibración de alerón a 4.5° y gestión de consumo de 3.42 L/vuelta.
                  </p>
                  <div class="inline-flex items-center gap-2 text-emerald-400 font-semibold text-xs group-hover:translate-x-1 transition-transform">
                    <span>Acceder a Setups del Vault &rarr;</span>
                  </div>
                </div>
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="sideStories">
              <a href="/setups" class="group block bg-[#161c24] border border-white/10 hover:border-white/20 rounded-2xl overflow-hidden transition duration-300 shadow-md flex flex-col justify-between">
                <div>
                  <div class="h-44 w-full overflow-hidden bg-[#0e1217] relative">
                    <img src="/assets/img/coche2-640.webp" alt="Setup Spa GT3" width="640" height="360" loading="lazy" decoding="async" class="w-full h-full object-cover transition duration-500 group-hover:scale-105 opacity-80 group-hover:opacity-100" />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#161c24] via-transparent to-transparent"></div>
                  </div>
                  <div class="p-5">
                    <div class="flex items-center gap-2 mb-2 text-[11px]">
                      <span class="px-2 py-0.5 rounded-md bg-[#1c232d] text-neutral-300 border border-white/5 font-medium">Muntrume Motorsport</span>
                      <span class="text-neutral-400">GT3 Endurance</span>
                    </div>
                    <h3 class="font-bold text-white text-sm sm:text-base line-clamp-2 mb-2 group-hover:text-emerald-400 transition-colors">
                      🛠️ Calibración de Amortiguadores para Eau Rouge &amp; Raidillon en GT3
                    </h3>
                    <p class="text-neutral-400 text-xs line-clamp-2 leading-relaxed">
                      Actualización del setup para Ferrari 296 y Porsche 992 GT3 R en Spa-Francorchamps con control de balance en compresión rápida.
                    </p>
                  </div>
                </div>
                <div class="px-5 pb-5 pt-0">
                  <span class="text-emerald-400 text-xs font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                    <span>Ver Setups &rarr;</span>
                  </span>
                </div>
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-white/10" id="secondaryGrid"></div>
          </div>

          <!-- Error Container -->
          <div id="errorState" class="hidden text-center py-16 bg-[#161c24] border border-white/10 rounded-2xl p-6">
            <div class="w-12 h-12 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 mx-auto flex items-center justify-center mb-4 font-bold text-xl">!</div>
            <h3 class="text-lg font-bold text-white mb-1">Feed Sync Offline</h3>
            <p class="text-neutral-400 mb-5 text-xs">Connection to news feeds timed out. Tap retry to reconnect:</p>
            <button onclick="loadAllNews()" class="bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-semibold py-2.5 px-6 rounded-xl text-xs transition shadow-md">
              Retry Sync
            </button>
          </div>

        </section>

        <!-- SECTION: ESPORTS WIRE -->
        <section id="esports-news" class="pt-8 border-t border-white/10">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase">Esports</span>
              <h2 class="text-xl font-bold text-white tracking-tight">Competitive Racing &amp; Esports</h2>
            </div>
          </div>
          <div id="esportsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="loading-skeleton h-56 rounded-2xl border border-white/10"></div>
            <div class="loading-skeleton h-56 rounded-2xl border border-white/10"></div>
          </div>
        </section>

        <!-- SECTION: MOTORSPORT WIRE -->
        <section id="sport-news" class="pt-8 border-t border-white/10">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase">Motorsport</span>
              <h2 class="text-xl font-bold text-white tracking-tight">Global Racing Headlines</h2>
            </div>
          </div>
          <div id="sportGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="loading-skeleton h-56 rounded-2xl border border-white/10"></div>
            <div class="loading-skeleton h-56 rounded-2xl border border-white/10"></div>
          </div>
        </section>

      </div>

      <!-- SIDEBAR WIDGETS COLUMN (4 Cols) -->
      <aside class="lg:col-span-4 space-y-6">
        
        <!-- WIDGET 1: AI DAILY BRIEF -->
        <div class="bg-[#161c24] border border-white/10 rounded-2xl p-6 relative overflow-hidden shadow-lg">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <h3 class="text-xs font-bold tracking-wider uppercase text-white">Top Headlines</h3>
            </div>
            
          </div>
          <div id="aiBriefContent" class="text-xs text-neutral-300 leading-relaxed">
            <div class="loading-skeleton h-3 mb-2 rounded"></div>
            <div class="loading-skeleton h-3 mb-2 rounded"></div>
            <div class="loading-skeleton h-3 rounded"></div>
          </div>
          <button onclick="refreshAIBrief()" class="mt-4 text-xs text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1.5 transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>Refresh Briefing</span>
          </button>
        </div>

        <!-- WIDGET 3: TRENDING STORIES -->
        <div class="bg-[#161c24] border border-white/10 rounded-2xl p-6 shadow-lg">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-white/10">
            <h3 class="text-xs font-bold tracking-wider uppercase text-white">Trending Dispatches</h3>
          </div>
          <div id="trendingList" class="space-y-3">
            <div class="loading-skeleton h-10 rounded-xl"></div>
            <div class="loading-skeleton h-10 rounded-xl"></div>
            <div class="loading-skeleton h-10 rounded-xl"></div>
          </div>
        </div>

        <!-- WIDGET 4: TEAM SQUAD METRICS -->
        <div class="bg-[#161c24] border border-white/10 rounded-2xl p-6 shadow-lg">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/10">
            <div class="flex items-center gap-2">
              <span class="pulse-dot"></span>
              <h3 class="text-xs font-bold tracking-wider uppercase text-white">The Team</h3>
            </div>
            
          </div>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between items-center py-1.5">
              <span class="text-neutral-400">Drivers</span>
              <span class="text-white font-semibold">4 Drivers</span>
            </div>
          </div>
          <a href="/team" class="mt-4 block text-center py-2.5 rounded-xl bg-[#0e1217] border border-white/10 hover:border-white/20 text-emerald-400 text-xs font-semibold transition">
            View Full Driver Roster &rarr;
          </a>
        </div>

        <!-- WIDGET 5: DAILY DISPATCH DISCORD -->
        <div class="bg-gradient-to-br from-[#161c24] to-[#1c232d] border border-white/10 rounded-2xl p-6 text-center shadow-lg">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mx-auto mb-3">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.13-.255-.01-.556-.28-.646a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
          </div>
          <h3 class="text-sm font-bold text-white mb-1">Join the Paddock Discord</h3>
          <p class="text-xs text-neutral-400 mb-4 leading-relaxed">Talk setups and racing with the team.</p>
          <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="block py-2.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs transition shadow-md">
            Connect to Discord
          </a>
        </div>

      </aside>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 5. DRIVER REACTION & REFLEX TRAINING (Games Section)                       -->
  <!-- ========================================================================= -->
  <section id="games" class="py-14 bg-[#0e1217] border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-4 border-b border-white/10">
        <div>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase">Driver Training</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mt-1">Reflex &amp; Reaction Calibration</h2>
          <p class="text-xs text-neutral-400 mt-1">Calibrate reaction latency, motorsport terminology, and memory before entering the cockpit.</p>
        </div>
        <button onclick="toggleGames()" class="px-4 py-2 rounded-xl bg-[#161c24] border border-white/10 hover:border-white/20 text-xs font-semibold text-emerald-400 transition" id="gamesToggleBtn">
          <span id="gamesToggleText">Collapse Module</span>
        </button>
      </div>

      <div id="gamesSection" class="transition-all duration-500">
        
        <!-- Game Switcher Tabs -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
          <button onclick="selectGame('wordsearch')" class="game-card-btn selected" id="gameBtn-wordsearch">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mx-auto mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"/></svg>
            </div>
            <div class="font-bold text-sm text-white">Word Search</div>
            <div class="text-[11px] text-neutral-400 mt-0.5">Motorsport Grid</div>
          </button>
          <button onclick="selectGame('trivia')" class="game-card-btn" id="gameBtn-trivia">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mx-auto mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
            </div>
            <div class="font-bold text-sm text-white">Telemetry Trivia</div>
            <div class="text-[11px] text-neutral-400 mt-0.5">10 Questions</div>
          </button>
          <button onclick="selectGame('reaction')" class="game-card-btn" id="gameBtn-reaction">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mx-auto mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div class="font-bold text-sm text-white">F1 Reaction Test</div>
            <div class="text-[11px] text-neutral-400 mt-0.5">Lights Out</div>
          </button>
          <button onclick="selectGame('memory')" class="game-card-btn" id="gameBtn-memory">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mx-auto mb-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"/></svg>
            </div>
            <div class="font-bold text-sm text-white">Circuit Memory</div>
            <div class="text-[11px] text-neutral-400 mt-0.5">Track Match</div>
