---
import Layout from '../layouts/Layout.astro';
import StatsBar from '../components/StatsBar.astro';

const pageTitle = "Media Center & Wire — Muntrume Motorsport";
const pageDescription = "Comunicados oficiales de escudería, crónicas de resistencia y actualizaciones técnicas de iRacing. Porsche Motorsport style media wire.";

const featuredStory = {
  title: "Muntrume Motorsport completa la calibración de 239.539 setups para la temporada 2026",
  date: "4 Noviembre 2026",
  category: "Team News",
  readTime: "3 min lectura",
  image: "/assets/img/hero-bg.webp",
  excerpt: "La escudería de Sant Andreu homologa su catálogo completo para 196 vehículos en iRacing, incorporando sincronización en un clic mediante File System Access API y telemetría de Garage 61."
};

const secondaryDispatches = [
  {
    title: "Alineación confirmada: 4 pilotos oficiales competirán en las 24h de Nürburgring en iRacing",
    date: "2 Noviembre 2026",
    category: "Team News",
    readTime: "2 min",
    link: "/pilotos"
  },
  {
    title: "Nueva actualización del Setup Vault añade compatibilidad nativa con explorador FTP directo",
    date: "1 Noviembre 2026",
    category: "iRacing",
    readTime: "2 min",
    link: "/garage"
  },
  {
    title: "Telemetría Garage 61: Análisis de deltas y referencias por sectores para GT3 en Spa-Francorchamps",
    date: "28 Octubre 2026",
    category: "iRacing",
    readTime: "4 min",
    link: "/garage"
  },
  {
    title: "Alberto Trujillo fija el récord del equipo en clasificación con el Porsche 911 GT3 R (992)",
    date: "24 Octubre 2026",
    category: "Team News",
    readTime: "2 min",
    link: "/p/alberto-trujillo"
  },
  {
    title: "Infraestructura Zero-Trust desplegada en el buzón institucional de pilotos bajo dominio propio",
    date: "19 Octubre 2026",
    category: "Team News",
    readTime: "3 min",
    link: "/paddock"
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="pt-24 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Top Header -->
    <section class="max-w-3xl space-y-3 pt-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#121A17] border border-[#1E2A26] text-xs font-mono text-[#00E699]">
        <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
        <span>WIRE LIVE</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight font-display">
        MEDIA CENTER <span class="text-[#00E699]">&amp; WIRE</span>
      </h1>

      <p class="text-sm sm:text-base text-[#8B9A8F] leading-relaxed">
        Comunicados oficiales de escudería, crónicas técnicas y despacho de novedades en iRacing.
      </p>

      <!-- Minimalist Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pt-2">
        <button class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold bg-[#00E699] text-neutral-950 transition cursor-pointer">
          All
        </button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-[#121A17] hover:bg-white/5 border border-[#1E2A26] text-[#8B9A8F] hover:text-white transition cursor-pointer">
          Team News
        </button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold bg-[#121A17] hover:bg-white/5 border border-[#1E2A26] text-[#8B9A8F] hover:text-white transition cursor-pointer">
          iRacing
        </button>
      </div>
    </section>

    <!-- 1 Large Featured Story (Left) + 5 Secondary Headlines (Right) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left: Large Featured Article -->
      <article class="lg:col-span-7 paddock-card overflow-hidden group">
        <div class="relative w-full aspect-[16/9] overflow-hidden bg-[#080C0A]">
          <img 
            src={featuredStory.image} 
            alt={featuredStory.title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter contrast-125"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#121A17] via-transparent to-transparent"></div>
          <div class="absolute top-4 left-4 flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full bg-[#080C0A]/90 border border-[#1E2A26] text-[#00E699] text-[10px] font-mono font-bold uppercase">
              {featuredStory.category}
            </span>
            <span class="px-2.5 py-0.5 rounded-full bg-[#080C0A]/90 border border-[#1E2A26] text-[#8B9A8F] text-[10px] font-mono">
              {featuredStory.readTime}
            </span>
          </div>
        </div>

        <div class="p-6 sm:p-8 space-y-3">
          <div class="text-[11px] font-mono text-[#8B9A8F]">{featuredStory.date}</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-display group-hover:text-[#00E699] transition-colors leading-tight">
            {featuredStory.title}
          </h2>
          <p class="text-xs sm:text-sm text-[#8B9A8F] leading-relaxed">
            {featuredStory.excerpt}
          </p>
          <div class="pt-4 flex items-center gap-2 text-xs font-mono font-bold text-[#00E699]">
            <span>Leer comunicado completo</span>
            <span>&rarr;</span>
          </div>
        </div>
      </article>

      <!-- Right: 5 Secondary Headlines -->
      <div class="lg:col-span-5 space-y-3">
        <div class="text-xs font-mono uppercase tracking-widest text-[#8B9A8F] pb-2 border-b border-[#1E2A26]">
          ÚLTIMOS TITULARES &bull; PORSCHE MEDIA WIRE
        </div>

        {secondaryDispatches.map((item, idx) => (
          <a 
            href={item.link} 
            class="block paddock-card p-4 sm:p-5 group hover:border-[#00E699]/40 transition-colors"
          >
            <div class="flex items-center justify-between text-[10px] font-mono text-[#8B9A8F] mb-1.5">
              <span class="text-[#00E699] font-bold">DISPATCH #{String(idx + 1).padStart(2, '0')}</span>
              <span>{item.date}</span>
            </div>
            <h3 class="text-sm font-bold text-white group-hover:text-[#00E699] transition-colors font-display leading-snug">
              {item.title}
            </h3>
            <div class="flex items-center justify-between mt-2 pt-2 border-t border-[#1E2A26]/50 text-[10px] font-mono text-[#8B9A8F]">
              <span>{item.category}</span>
              <span>{item.readTime} &rarr;</span>
            </div>
          </a>
        ))}
      </div>

    </section>

    <!-- Stats Bar -->
    <section class="pt-6">
      <StatsBar />
    </section>

  </main>
</Layout>
