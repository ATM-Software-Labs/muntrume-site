---
import Layout from "../../layouts/Layout.astro";
import { getSupportedBrandsCatalog } from "../../../desktop/src/brand-logos";

const brands = getSupportedBrandsCatalog();

const pageTitle = "Fabricantes & Colores HUD · MMT Sync Overlays | Muntrume Motorsport";
const pageDescription = `Catálogo oficial de ${brands.length} fabricantes soportados por el parser del iRacing SDK en MMT Sync Overlays, con SVG vectorial, preview de Standings y códigos HEX.`;
const pageUrl = "https://muntru.me/overlay/brands/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
>
  <main class="min-h-screen bg-[#090b0f] text-slate-100 py-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto space-y-6">
      <!-- Header -->
      <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-5">
        <div class="space-y-2">
          <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-emerald-400">
            <a href="/overlay/" class="hover:underline">← Volver a /overlay</a>
            <span class="text-slate-600">·</span>
            <span>desktop/src/brand-logos.ts</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Matriz Oficial de Fabricantes &amp; Colores HUD
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 max-w-2xl font-mono">
            Fuente única de verdad compartida entre la app de escritorio MMT Sync y la web.
            <span class="text-emerald-400 font-bold ml-1">{brands.length} marcas indexadas</span>.
          </p>
        </div>

        <!-- Instant Filter -->
        <div class="w-full md:w-80">
          <label for="brandSearchInput" class="sr-only">Buscar marca, CarPath o color hex</label>
          <div class="relative">
            <input
              id="brandSearchInput"
              type="search"
              placeholder="Buscar marca, CarPath o #HEX..."
              class="w-full bg-[#0d1118] border border-white/15 focus:border-emerald-500 rounded px-3 py-2 text-xs font-mono text-white placeholder-slate-500 outline-none transition"
            />
            <span id="brandCountBadge" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] font-mono tabular-nums text-emerald-400">
              {brands.length}/{brands.length}
            </span>
          </div>
        </div>
      </header>

      <!-- Brands Grid -->
      <section id="brandGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {brands.map((b, idx) => (
          <article
            class="brand-card rounded border border-white/10 bg-[#0d1118] p-3 flex flex-col gap-3 font-mono tabular-nums hover:border-white/25 transition"
            data-search={`${b.name} ${b.carPath} ${b.color} ${b.sampleModel}`.toLowerCase()}
          >
            <!-- Top: 32x32 Official SVG + HEX Badge -->
            <div class="flex items-start justify-between gap-2">
              <span
                class="w-9 h-9 rounded border border-white/10 bg-[#090b0f] flex items-center justify-center shrink-0"
                style={`color:${b.color}`}
                title={b.name}
              >
                <svg viewBox="0 0 24 24" width="32" height="32" fill={b.color} fill-rule="evenodd" clip-rule="evenodd" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d={b.path} />
                </svg>
              </span>
              <span
                class="text-[10px] px-1.5 py-0.5 rounded border border-white/10 bg-[#090b0f] font-bold tracking-wide"
                style={`color:${b.color}`}
              >
                {b.color.toUpperCase()}
              </span>
            </div>

            <!-- Middle: Brand Name & SDK CarPath -->
            <div>
              <h2 class="text-xs font-bold text-white truncate">{b.name}</h2>
              <p class="text-[10px] text-slate-400 truncate" title={b.sampleModel}>
                CarPath: <span class="text-slate-300">{b.carPath}</span>
              </p>
            </div>

            <!-- Bottom: Real Standings 22px Row Preview -->
            <div
              class="h-[22px] rounded-[3px] bg-[rgba(9,11,15,0.88)] border border-white/10 border-l-[3px] px-1.5 flex items-center justify-between gap-1.5 text-[10px]"
              style={`border-left-color:${b.color}`}
              title="Vista previa en fila Standings (22px)"
            >
              <div class="flex items-center gap-1 min-w-0">
                <span class="text-slate-400 font-bold w-3 text-right">{idx + 1}</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill={b.color} fill-rule="evenodd" clip-rule="evenodd" class="shrink-0" aria-hidden="true">
                  <path fill-rule="evenodd" clip-rule="evenodd" d={b.path} />
                </svg>
                <span class="text-slate-200 font-semibold truncate">MMT #{(idx + 1) * 3}</span>
              </div>
              <span class="text-[9px] px-1 rounded bg-emerald-500/15 text-emerald-400 font-bold shrink-0">
                3.8k
              </span>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>

  <script is:inline>
    (() => {
      const input = document.getElementById("brandSearchInput");
      const badge = document.getElementById("brandCountBadge");
      const cards = Array.from(document.querySelectorAll(".brand-card"));
      if (!input) return;

      input.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach((card) => {
          const hay = card.getAttribute("data-search") || "";
          const match = !q || hay.includes(q);
          card.style.display = match ? "" : "none";
          if (match) shown++;
        });
        if (badge) badge.textContent = `${shown}/${cards.length}`;
      });
    })();
  </script>
</Layout>
