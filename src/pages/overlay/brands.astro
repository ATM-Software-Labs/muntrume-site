---
import Layout from "../../layouts/Layout.astro";
import { getSupportedBrandsCatalog } from "../../../desktop/src/brand-logos";

const brands = getSupportedBrandsCatalog();

const pageTitle = "Fabricantes y colores HUD";
const withLogo = brands.filter((b) => b.logoVerified).length;
const pageDescription = `${withLogo} fabricantes del catálogo iRacing con su emblema real, adaptado al fondo oscuro. Equipo MMT.`;
const pageUrl = "https://muntru.me/overlay/brands/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
>
  <main class="brand-hud min-h-screen bg-[#090b0f] text-slate-100 py-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto space-y-6">
      <!-- Header -->
      <header class="flex flex-col gap-4 border-b border-white/10 pb-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-2">
          <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-emerald-400">
            <a href="/overlay/" class="hover:underline">← Volver a /overlay</a>
            <span class="text-slate-600 hidden sm:inline">·</span>
            <span class="hidden sm:inline">desktop/src/brand-logos.ts</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
            Fabricantes y colores HUD
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 max-w-2xl font-mono">
            Cada tarjeta es un fabricante del catálogo. El emblema conserva la forma y los colores reales; las letras del logo van en blanco para leerse aquí.
            <span class="text-emerald-400 font-bold ml-1">{withLogo} con logo</span>.
          </p>
        </div>

        <!-- Instant Filter -->
        <div class="w-full lg:w-80 lg:shrink-0">
          <label for="brandSearchInput" class="sr-only">Buscar marca, CarPath o color hex</label>
          <div class="relative">
            <input
              id="brandSearchInput"
              type="search"
              placeholder="Buscar marca, CarPath o #HEX..."
              class="w-full bg-[#0d1118] border border-white/15 focus:border-emerald-500 rounded px-3 py-2 text-xs font-mono text-white placeholder-slate-500 outline-none transition"
            />
            <span id="brandCountBadge" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] font-mono tabular-nums text-emerald-400">
              {brands.length}/{brands.length}
            </span>
          </div>
        </div>
      </header>

      <!-- Brands Grid -->
      <section id="brandGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {brands.map((b, idx) => (
          <article
            class="brand-card rounded border border-white/10 bg-[#0d1118] p-3 flex flex-col gap-3 font-mono tabular-nums hover:border-white/25 transition"
            data-search={`${b.name} ${b.carPaths.join(" ")} ${b.color}`.toLowerCase()}
          >
            <!-- Top: 32x32 Official SVG + HEX Badge -->
            <div class="flex items-start justify-between gap-2">
              <span
                class="brand-mark w-11 h-11 rounded border border-white/10 bg-[#090b0f] flex items-center justify-center shrink-0 p-1"
                title={b.logoVerified ? b.name : `${b.name}: sin emblema verificable`}
              >
                <Fragment set:html={b.svg} />
              </span>
              <span
                class="text-[10px] px-1.5 py-0.5 rounded border border-white/10 bg-[#090b0f] font-bold tracking-wide"
                style={`color:${b.color}`}
              >
                {b.color.toUpperCase()}{b.colorKind === "neutral" ? " · neutro" : ""}
              </span>
            </div>

            <div>
              <h2 class="text-xs font-bold text-white">{b.name}</h2>
              <p class="text-[10px] text-slate-500" data-i18n={b.logoVerified ? "brands.logo" : "brands.nologo"}>{b.logoVerified ? "Logo de marca" : "Sin logo verificable"}</p>
              <ul class="mt-1 space-y-0.5">
                {b.cars.map((car) => (
                  <li class="text-[10px] text-slate-300 break-all flex items-baseline gap-1.5">
                    <span>{car.carFolder}</span>
                    {car.legacy && (
                      <span data-i18n="brands.legacy" class="shrink-0 rounded border border-amber-400/40 bg-amber-400/10 px-1 text-[9px] font-bold uppercase tracking-wide text-amber-200">Legacy</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bottom: Real Standings 22px Row Preview -->
            <div
              class="h-[22px] rounded-[3px] bg-[rgba(9,11,15,0.88)] border border-white/10 border-l-[3px] px-1.5 flex items-center justify-between gap-1.5 text-[10px]"
              style={`border-left-color:${b.color}`}
              title="Vista previa en fila Standings (22px)"
            >
              <div class="flex items-center gap-1 min-w-0">
                <span class="text-slate-400 font-bold w-3 text-right">{idx + 1}</span>
                <span class="w-3.5 h-3.5 shrink-0 inline-flex [&>svg]:w-full [&>svg]:h-full">
                  <Fragment set:html={b.svg} />
                </span>
                <span class="text-slate-200 font-semibold truncate">{b.name}</span>
              </div>
              <span class="text-[9px] px-1 rounded bg-white/5 text-slate-300 font-bold shrink-0">
                {b.carPaths.length}
              </span>
            </div>
          </article>
        ))}
      </section>
    </div>
  </main>

  <style is:global>
    .brand-mark > svg { width: 100%; height: 100%; }
  </style>
  <script is:inline>
    (() => {
      const input = document.getElementById("brandSearchInput");
      const badge = document.getElementById("brandCountBadge");
      const cards = Array.from(document.querySelectorAll(".brand-card"));
      if (!input) return;

      input.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach((card) => {
          const hay = card.getAttribute("data-search") || "";
          const match = !q || hay.includes(q);
          card.style.display = match ? "" : "none";
          if (match) shown++;
        });
        if (badge) badge.textContent = `${shown}/${cards.length}`;
      });
    })();
  </script>
</Layout>
