---
import Layout from "../../layouts/Layout.astro";
import { getSupportedBrandsCatalog } from "../../../desktop/src/brand-logos";
import { BRAND_LOGO_ASSETS } from "../../../desktop/src/cars/brand-logo-assets";

const brands = getSupportedBrandsCatalog();

const IRACING_PARTNERS = [
  { name: "FIA", kind: "Federación", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/05/partner-fia-v2-400x200.png", href: "https://www.fia.com/" },
  { name: "IMSA", kind: "Campeonato", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-04-400x200.png", href: "https://www.imsa.com/" },
  { name: "NASCAR", kind: "Campeonato", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-02-400x200.png", href: "https://www.nascar.com/" },
  { name: "IndyCar", kind: "Campeonato", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2024/01/iR_Partners__IndyCar-400x200.png", href: "https://www.iracing.com/partners/" },
  { name: "DTM", kind: "Campeonato", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2026/09/iR-Partners-DTM-400x200.png", href: "https://www.dtm.com/" },
  { name: "Supercars", kind: "Campeonato", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-06-400x200.png", href: "https://www.supercars.com/" },
  { name: "TCR", kind: "Campeonato", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2024/02/iR_Partners_TCR-400x200.png", href: "https://www.iracing.com/partners/" },
  { name: "Cosworth", kind: "Ingeniería", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2025/09/iR_Partners_Cosworth-400x200.png", href: "https://www.iracing.com/partners/" },
  { name: "Aston Martin", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2015/12/iR-Partners-AstonMartin-400x200.png", href: "https://www.astonmartin.com/racing" },
  { name: "Audi Motorsport", kind: "Fabricante", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-15-400x200.png", href: "https://www.audi-motorsport.com/" },
  { name: "BMW Motorsport", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-12-400x200.png", href: "https://www.bmw-motorsport.com/" },
  { name: "Cadillac V-Series", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2012/10/iR_Partners__Cadillac-400x200.png", href: "https://www.cadillac.com/" },
  { name: "Dallara", kind: "Chasis", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-18-400x200.png", href: "https://www.dallara.it/" },
  { name: "Ford Performance", kind: "Fabricante", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-17-400x200.png", href: "https://www.ford.com/" },
  { name: "General Motors", kind: "Fabricante", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-11-400x200.png", href: "https://www.gm.com/" },
  { name: "Classic Team Lotus", kind: "Fabricante", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-29-400x200.png", href: "https://www.classicteamlotus.co.uk/" },
  { name: "Mazda", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2026/09/ir-partners-mazda-400x200.png", href: "https://www.mazda.com/" },
  { name: "McLaren", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2026/09/iR-Partners-McLaren-400x200.png", href: "https://www.mclaren.com/" },
  { name: "Mercedes-AMG", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-13-400x200.png", href: "https://www.mercedes-amg.com/" },
  { name: "Mercedes-AMG F1", kind: "Equipo F1", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-03-400x200.png", href: "https://www.mercedesamgf1.com/" },
  { name: "Radical Sportscars", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-27-400x200.png", href: "https://www.radicalsportscars.com/" },
  { name: "RUF Automobile", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-32-400x200.png", href: "https://www.ruf-automobile.de/" },
  { name: "Skip Barber", kind: "Escuela", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-30-400x200.png", href: "https://skipbarber.com/" },
  { name: "Toyota Racing", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2015/03/iR_Partners__Toyota-400x200.png", href: "https://www.toyotaracing.com/" },
  { name: "Volkswagen", kind: "Fabricante", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/09/iR_Partners-25-400x200.png", href: "https://www.vw.com/" },
  { name: "Williams F1", kind: "Equipo F1", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2012/10/iR_Partners__Williams-400x200.png", href: "https://www.williamsf1.com/" },
  { name: "Nürburgring", kind: "Circuito", darkBg: false, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-09-400x200.png", href: "https://www.nuerburgring.de/" },
  { name: "Spa-Francorchamps", kind: "Circuito", darkBg: true, img: "https://s100.iracing.com/wp-content/uploads/2023/05/iR_Partners-10-400x200.png", href: "https://www.spa-francorchamps.be/" },
];

const pageTitle = "Fabricantes y colores HUD";
const withLogo = brands.filter((b) => b.logoVerified).length;
const pageDescription = `${withLogo} fabricantes del catálogo iRacing con su emblema real y ${IRACING_PARTNERS.length} partners oficiales de iRacing. Equipo MMT.`;
const pageUrl = "https://muntru.me/overlay/brands/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
>
  <main class="brand-hud min-h-screen bg-[var(--r-bg)] text-[var(--r-text)] py-12 px-4 sm:px-6">
    <div class="r-wrap space-y-6">
      <!-- Header -->
      <header class="flex flex-col gap-4 border-b border-[var(--r-line)] pb-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="space-y-2">
          <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-[var(--r-accent)] font-bold">
            <a href="/overlay/" class="hover:underline">← Volver a /overlay</a>
            <span class="text-[var(--r-muted)] hidden sm:inline">·</span>
            <span class="hidden sm:inline text-[var(--r-muted)]">desktop/src/brand-logos.ts</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold font-display tracking-tight text-[var(--r-text)]">
            Fabricantes y colores HUD
          </h1>
          <p class="text-xs sm:text-sm text-[var(--r-muted)] max-w-2xl font-mono">
            Cada tarjeta es un fabricante del catálogo. El emblema conserva la forma y los colores reales.
            <span class="text-[var(--r-accent)] font-bold ml-1">{withLogo} con logo</span>.
          </p>
        </div>

        <!-- Instant Filter -->
        <div class="w-full lg:w-80 lg:shrink-0">
          <label for="brandSearchInput" class="sr-only">Buscar marca, CarPath o color hex</label>
          <div class="relative">
            <input
              id="brandSearchInput"
              type="search"
              placeholder="Buscar marca, CarPath o #HEX..."
              class="w-full bg-[var(--r-surface)] border border-[var(--r-line)] focus:border-[var(--r-accent)] rounded-xl pl-3 pr-14 py-2 text-xs font-mono text-[var(--r-text)] placeholder-[var(--r-muted)] outline-none transition"
            />
            <span id="brandCountBadge" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-[10px] font-mono tabular-nums text-[var(--r-accent)]">
              {brands.length}/{brands.length}
            </span>
          </div>
        </div>
      </header>

      <!-- Brands Grid -->
      <section id="brandGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {brands.map((b, idx) => (
          <article
            class="brand-card rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-3.5 flex flex-col gap-3 font-mono tabular-nums hover:border-[var(--r-accent)] transition"
            data-search={`${b.name} ${b.carPaths.join(" ")} ${b.color}`.toLowerCase()}
          >
            <!-- Top: 48x48 Official SVG + HEX Badge -->
            <div class="flex items-start justify-between gap-2">
              <span
                class="brand-mark w-12 h-12 rounded-xl border border-white/15 bg-[#090b0f] shadow-inner flex items-center justify-center shrink-0 p-1.5"
                style="background-color:#090b0f;border-color:rgba(255,255,255,0.15)"
                title={b.logoVerified ? b.name : `${b.name}: sin emblema verificable`}
              >
                <Fragment set:html={b.svg} />
              </span>
              <span
                data-no-translate
                class="inline-flex items-center gap-1.5 text-[10px] px-2 py-0.5 rounded-md border border-[var(--r-line)] bg-[var(--r-bg-2)] font-bold tracking-wide text-[var(--r-text)]"
              >
                <span class="w-2.5 h-2.5 rounded-full shrink-0 border border-black/20 dark:border-white/20" style={`background:${b.color}`}></span>
                <span>{b.color.toUpperCase()}{b.colorKind === "neutral" ? " · Neutro" : ""}</span>
              </span>
            </div>

            <div>
              <div class="flex items-center justify-between gap-2">
                <h2 data-no-translate class="text-sm font-bold text-[var(--r-text)]">{b.name}</h2>
                {BRAND_LOGO_ASSETS[b.logoId]?.sourceUrl && (
                  <a
                    href={BRAND_LOGO_ASSETS[b.logoId].sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[9px] text-[var(--r-muted)] hover:text-[var(--r-accent)] underline shrink-0"
                    title="Fuente oficial del emblema"
                  >
                    Fuente ↗
                  </a>
                )}
              </div>
              <p class="text-[10px] text-[var(--r-muted)]" data-i18n={b.logoVerified ? "brands.logo" : "brands.nologo"}>{b.logoVerified ? "Emblema oficial HUD" : "Marca neutra HUD"}</p>
              <ul data-no-translate class="mt-1.5 space-y-0.5 max-h-40 overflow-y-auto pr-1">
                {b.cars.map((car) => (
                  <li class="text-[10px] text-[var(--r-muted)] break-all flex items-baseline gap-1.5">
                    <span>{car.carFolder}</span>
                    {car.legacy && (
                      <span data-i18n="brands.legacy" class="shrink-0 rounded border border-amber-500/40 bg-amber-500/10 px-1 text-[9px] font-bold uppercase tracking-wide text-amber-600 dark:text-amber-400">Legacy</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Bottom: Real Standings 24px Row Preview -->
            <div
              data-no-translate
              class="brand-standings-row mt-auto h-[24px] rounded-[4px] bg-[#090b0f] border border-white/10 border-l-[3px] px-2 flex items-center justify-between gap-1.5 text-[10px]"
              style={`background-color:#090b0f;border-left-color:${b.color};color:#f8fafc`}
              title="Vista previa en fila Standings (24px)"
            >
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="font-bold w-3.5 text-right" style="color:#94a3b8">{idx + 1}</span>
                <span class="w-4 h-4 shrink-0 inline-flex items-center justify-center [&>svg]:w-full [&>svg]:h-full">
                  <Fragment set:html={b.svg} />
                </span>
                <span class="font-semibold truncate" style="color:#f8fafc">{b.name}</span>
              </div>
              <span class="text-[9px] px-1.5 py-0.2 rounded bg-white/10 font-bold shrink-0" style="color:#cbd5e1">
                {b.carPaths.length}
              </span>
            </div>
          </article>
        ))}
      </section>

      <!-- Official iRacing Partners Gallery -->
      <section class="pt-8 border-t border-[var(--r-line)] space-y-4" aria-labelledby="partnersHeading">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-widest text-[var(--r-accent)] font-bold">Referencias oficiales · iracing.com/partners</p>
            <h2 id="partnersHeading" class="text-xl font-extrabold font-display tracking-tight text-[var(--r-text)]">
              Partners, fabricantes y campeonatos oficiales ({IRACING_PARTNERS.length})
            </h2>
          </div>
          <a href="https://www.iracing.com/partners/" target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-[var(--r-accent)] hover:underline">
            Ver directorio oficial en iRacing.com ↗
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          {IRACING_PARTNERS.map((p) => (
            <a
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              class="partner-card rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-3 flex flex-col gap-2 hover:border-[var(--r-accent)] transition"
              data-partner-search={`${p.name} ${p.kind}`.toLowerCase()}
            >
              <div
                class={`h-16 rounded-lg flex items-center justify-center p-2 overflow-hidden border ${p.darkBg ? "bg-[#0d1117] border-white/15" : "bg-white border-black/10"}`}
                style={p.darkBg ? "background-color:#0d1117;border-color:rgba(255,255,255,0.15)" : "background-color:#ffffff;border-color:rgba(0,0,0,0.10)"}
              >
                <img src={p.img} alt={p.name} loading="lazy" decoding="async" class="max-h-full max-w-full object-contain" />
              </div>
              <div class="flex items-center justify-between gap-1 font-mono">
                <span class="text-xs font-bold text-[var(--r-text)] truncate">{p.name}</span>
                <span class="text-[9px] text-[var(--r-muted)] shrink-0">{p.kind}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>

  <style is:global>
    .brand-mark > svg { width: 100%; height: 100%; }
  </style>
  <script is:inline>
    (() => {
      const input = document.getElementById("brandSearchInput");
      const badge = document.getElementById("brandCountBadge");
      const cards = Array.from(document.querySelectorAll(".brand-card"));
      const partnerCards = Array.from(document.querySelectorAll(".partner-card"));
      if (!input) return;

      input.addEventListener("input", () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        cards.forEach((card) => {
          const hay = card.getAttribute("data-search") || "";
          const match = !q || hay.includes(q);
          card.style.display = match ? "" : "none";
          if (match) shown++;
        });
        partnerCards.forEach((card) => {
          const hay = card.getAttribute("data-partner-search") || "";
          card.style.display = !q || hay.includes(q) ? "" : "none";
        });
        if (badge) badge.textContent = `${shown}/${cards.length}`;
      });
    })();
  </script>
</Layout>
