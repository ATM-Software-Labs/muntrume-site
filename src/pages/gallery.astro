---
import Layout from '../layouts/Layout.astro';
import CommunityUploadModal from '../components/CommunityUploadModal.astro';
import { TRACK_GALLERY_PHOTOS } from '../data/paddock-gallery';

const pageTitle = 'Galería de competición | Muntrume Motorsport';
const pageDescription =
  'Capturas reales en pista de Muntrume Motorsport en iRacing: GT3, prototipos GTP y stints nocturnos de resistencia.';

const totalCount = 0;
const gt3Count = 0;
const gtpCount = 0;
const cupCount = 0;
const nightCount = 0;

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: 'https://muntru.me/gallery/',
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="https://muntru.me/galeria/"
  ogImage="https://muntru.me/assets/img/coche1.webp"
  ogImageAlt="Galería de competición Muntrume Motorsport"
  schemaJson={gallerySchema}
>
  <section class="r-section" style="padding-top: clamp(96px, 11vw, 128px); padding-bottom: 80px; border-top: none;">
    <div class="r-wrap space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 border-b border-[var(--r-line)]">
      <div class="space-y-2">
        <div class="flex items-center gap-4 text-xs font-mono font-bold">
          <a href="/" class="text-[var(--r-muted)] hover:text-[var(--r-accent)]">&larr; Volver al inicio</a>
          <a href="/paddock/" class="text-[var(--r-accent)] hover:underline">&larr; Paddock</a>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--r-text)] font-display tracking-tight">
          Galería de competición
        </h1>
        <p class="text-xs sm:text-sm text-[var(--r-muted)] max-w-xl">
          Capturas en pista de nuestros programas GT3, Prototipos GTP y stints nocturnos de resistencia en iRacing.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2" id="galeriaFilterBar">
        <button
          type="button"
          data-open-community-upload
          class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition cursor-pointer bg-emerald-500 text-slate-950 hover:bg-emerald-400"
        >
          + Subir captura
        </button>
        <a
          href="/wallpapers/"
          class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/35"
        >
          ↓ Descargar como Pack Wallpapers (.ZIP)
        </a>
        <div id="galleryFilterBar" class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-filter="all"
            class="galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition cursor-pointer bg-[var(--r-accent)] text-[var(--r-accent-ink)] border border-[var(--r-accent)]"
          >
            Todas
          </button>
        </div>
        <select id="glSortSelect" class="h-8 rounded-full border border-white/15 bg-[var(--r-surface)] px-3 text-[11px] font-mono text-white/90 outline-none cursor-pointer">
          <option value="popular">Más Populares (iRacing + Likes)</option>
          <option value="likes">Más Votadas</option>
          <option value="recent">Más Recientes</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="galeriaGrid">
      <div class="col-span-full rounded-2xl border border-dashed border-[var(--r-line)] bg-[var(--r-surface)]/60 p-10 text-center space-y-3">
        <p class="text-sm font-mono text-[var(--r-muted)]">Todavía no hay capturas publicadas</p>
        <button type="button" data-open-community-upload class="px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 text-xs font-mono font-bold cursor-pointer">+ Subir captura</button>
      </div>
    </div>
    <div class="mt-6 flex justify-center">
      <button type="button" id="glLoadMoreBtn" hidden class="px-5 py-2.5 rounded-xl border border-white/15 bg-[var(--r-surface)] hover:border-[var(--r-accent)] text-xs font-mono font-bold text-white transition cursor-pointer">
        Cargar más capturas ↓
      </button>
    </div>
    </div>
  </section>

  <!-- Lightbox HD con navegación ← / →, Esc y descarga -->
  <div
    id="galeriaLightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="glLbTitle"
  >
    <div class="relative w-full max-w-5xl rounded-2xl border border-[var(--r-line)] bg-[var(--r-surface)] shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-[var(--r-line)]">
        <div class="min-w-0">
          <h3 id="glLbTitle" class="text-base font-extrabold text-[var(--r-text)] font-display truncate"></h3>
          <p id="glLbSub" class="text-xs font-mono text-[var(--r-muted)] truncate"></p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a
            id="glLbDownload"
            href="#"
            download
            class="px-3 py-1.5 rounded-lg bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-[var(--r-accent)] text-xs font-mono font-bold text-[var(--r-text)] transition"
          >
            Descargar HD
          </a>
          <button
            id="glLbClose"
            type="button"
            aria-label="Cerrar visor"
            class="w-8 h-8 rounded-lg bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-[var(--r-accent)] text-[var(--r-text)] flex items-center justify-center font-bold cursor-pointer"
          >
            ✕
          </button>
        </div>
      </div>

      <div class="relative bg-[#090d12] flex items-center justify-center h-[62vh] sm:h-[72vh]">
        <button
          id="glLbPrev"
          type="button"
          aria-label="Foto anterior"
          class="absolute left-3 z-10 w-10 h-10 rounded-full bg-black/75 border border-white/20 text-white hover:border-[var(--r-accent)] font-bold cursor-pointer"
        >
          &larr;
        </button>
        <img id="glLbImg" src="" alt="" referrerpolicy="no-referrer" onerror="if(!this.dataset.proxied&&this.src&&this.src.startsWith('http')){this.dataset.proxied='1';this.src='https://muntrume.atrumin16.workers.dev/api/media/proxy?url='+encodeURIComponent(this.src);}" class="w-full h-full object-contain transition-transform duration-200 cursor-zoom-in" />
        <button
          id="glLbNext"
          type="button"
          aria-label="Foto siguiente"
          class="absolute right-3 z-10 w-10 h-10 rounded-full bg-black/75 border border-white/20 text-white hover:border-[var(--r-accent)] font-bold cursor-pointer"
        >
          &rarr;
        </button>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 border-t border-white/10 text-[11px] font-mono text-white/80" style="background: rgba(9, 11, 15, 0.72); backdrop-filter: blur(12px);">
        <div class="flex flex-wrap items-center gap-3">
          <span id="glLbCredit">Muntrume Motorsport · iRacing</span>
          <button type="button" id="glLbLikeBtn" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-white font-mono text-[11px] font-bold tabular-nums transition cursor-pointer" style="background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.14);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#ffffff;opacity:0.85;"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
            <span id="glLbLikeCount">0</span>
          </button>
        </div>
        <button type="button" id="glLbTakedownBtn" class="text-white/55 hover:text-rose-300 underline cursor-pointer">
          ¿Eres el autor y quieres retirarla?
        </button>
      </div>
    </div>
  </div>

  <!-- Takedown Request Modal (Prompt 174) -->
  <div id="glTakedownModal" style="position:fixed;inset:0;z-index:220;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.86);backdrop-filter:blur(6px);padding:16px;">
    <div class="w-full max-w-md rounded-2xl border border-white/15 bg-[#0d1117] text-white p-6 shadow-2xl relative">
      <button type="button" id="glTdClose" aria-label="Cerrar" style="position:absolute;top:14px;right:14px;" class="w-8 h-8 rounded-lg border border-white/15 text-white/70 hover:text-white cursor-pointer">✕</button>
      <span class="text-[10.5px] font-mono uppercase tracking-widest text-rose-400">Derechos de Autor · Takedown</span>
      <h3 class="text-lg font-extrabold font-display mt-1">Solicitar retirada de imagen</h3>

      <div class="mt-3 flex items-center gap-3 p-2.5 rounded-xl border border-white/10 bg-black/40">
        <img id="glTdThumb" src="" alt="" class="w-20 h-12 rounded-lg object-cover bg-black shrink-0" />
        <div class="min-w-0 text-[11px] font-mono">
          <p id="glTdPhotoTitle" class="font-bold text-white truncate">—</p>
          <p id="glTdPhotoId" class="text-white/50 truncate">ID: —</p>
        </div>
      </div>

      <form id="glTdForm" class="mt-4 space-y-3 text-xs">
        <div>
          <label class="block font-mono text-[11px] text-white/70 mb-1">Nombre o @usuario del autor *</label>
          <input type="text" name="authorName" required maxlength="80" placeholder="Ej. @tu_usuario" class="w-full rounded-xl border border-white/15 bg-black/40 px-3 py-2 text-white" />
        </div>
        <div>
          <label class="block font-mono text-[11px] text-white/70 mb-1">Correo electrónico de contacto *</label>
          <input type="email" name="email" required maxlength="120" placeholder="tu@correo.com" class="w-full rounded-xl border border-white/15 bg-black/40 px-3 py-2 text-white" />
        </div>
        <div>
          <label class="block font-mono text-[11px] text-white/70 mb-1">Enlace a la publicación original (opcional)</label>
          <input type="url" name="originalUrl" maxlength="250" placeholder="https://..." class="w-full rounded-xl border border-white/15 bg-black/40 px-3 py-2 text-white" />
        </div>
        <div>
          <label class="block font-mono text-[11px] text-white/70 mb-1">Motivo / Comentario *</label>
          <textarea name="reason" required rows="2" maxlength="300" placeholder="Soy el autor original y solicito su retirada..." class="w-full rounded-xl border border-white/15 bg-black/40 px-3 py-2 text-white"></textarea>
        </div>
        <label class="flex items-start gap-2.5 text-[11px] text-white/80 cursor-pointer">
          <input type="checkbox" required style="width:16px;height:16px;min-width:16px;margin-top:2px;accent-color:#f43f5e;appearance:auto;-webkit-appearance:checkbox;" />
          <span>Declaro bajo mi responsabilidad que soy el autor o titular de derechos de esta captura.</span>
        </label>
        <p id="glTdStatus" class="text-xs font-mono hidden"></p>
        <div class="flex justify-end gap-2 pt-1">
          <button type="button" id="glTdCancel" class="px-4 py-2 rounded-xl border border-white/15 text-white/75 hover:text-white cursor-pointer">Cancelar</button>
          <button type="submit" id="glTdSubmit" class="px-4 py-2 rounded-xl bg-rose-500 text-white font-bold hover:bg-rose-400 transition cursor-pointer">Enviar solicitud de retirada</button>
        </div>
      </form>
    </div>
  </div>
  <CommunityUploadModal />
</Layout>

<script>
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.galeria-filter-btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.galeria-card'));
  const lb = document.getElementById('galeriaLightbox');
  const lbImg = document.getElementById('glLbImg') as HTMLImageElement | null;
  const lbTitle = document.getElementById('glLbTitle');
  const lbSub = document.getElementById('glLbSub');
  const lbDownload = document.getElementById('glLbDownload') as HTMLAnchorElement | null;
  let activeFilter = 'all';
  let currentVisibleIdx = 0;

  const visibleButtons = () =>
    cards
      .filter((c) => !c.hidden && c.style.display !== 'none')
      .map((c) => c.querySelector<HTMLButtonElement>('.galeria-open-btn'))
      .filter((b): b is HTMLButtonElement => Boolean(b));

  const openAt = (idx: number) => {
    const list = visibleButtons();
    if (!list.length || !lb || !lbImg) return;
    currentVisibleIdx = ((idx % list.length) + list.length) % list.length;
    const btn = list[currentVisibleIdx];
    const src = btn.dataset.src || '';
    const title = btn.dataset.title || '';
    const sub = btn.dataset.sub || '';
    lbImg.src = src;
    lbImg.alt = title;
    const baseScale = btn.dataset.cleanCrop === '1' ? 'scale(1.13)' : 'scale(1)';
    lbImg.style.transform = baseScale;
    lbImg.dataset.zoomed = '0';
    lbImg.classList.remove('cursor-zoom-out');
    lbImg.classList.add('cursor-zoom-in');
    if (lbTitle) lbTitle.textContent = title;
    if (lbSub) lbSub.textContent = sub;
    if (lbDownload) {
      lbDownload.href = src;
      lbDownload.download = src.split('/').pop() || 'muntrume-hd.webp';
    }
    const setupLink = document.getElementById('glLbSetupLink') as HTMLAnchorElement | null;
    if (setupLink) {
      const carSlug = btn.dataset.carSlug || '';
      const trackSlug = btn.dataset.trackSlug || '';
      if (carSlug && trackSlug) {
        setupLink.href = `/setups/${carSlug}/${trackSlug}/`;
        setupLink.hidden = false;
      } else if (carSlug) {
        setupLink.href = `/setups/${carSlug}/`;
        setupLink.hidden = false;
      } else {
        setupLink.hidden = true;
      }
    }
    // Preload next and previous images for 0ms transitions (Prompt 157)
    const nextBtn = list[(currentVisibleIdx + 1) % list.length];
    const prevBtn = list[(currentVisibleIdx - 1 + list.length) % list.length];
    if (nextBtn?.dataset.src) { const im = new Image(); im.src = nextBtn.dataset.src; }
    if (prevBtn?.dataset.src) { const im = new Image(); im.src = prevBtn.dataset.src; }
    if (btn.dataset.photoId) {
      fetch('https://muntrume.atrumin16.workers.dev/api/gallery/view', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: btn.dataset.photoId }),
      }).catch(() => {});
    }
    const creditEl = document.getElementById('glLbCredit');
    const lbLikeBtn = document.getElementById('glLbLikeBtn') as HTMLButtonElement | null;
    if (lbLikeBtn) {
      const pid = btn.dataset.photoId || '';
      const voted = loadVotedSet().has(pid);
      lbLikeBtn.dataset.photoId = pid;
      lbLikeBtn.setAttribute('style', likeBtnStyle(voted));
      lbLikeBtn.innerHTML = `${thumbSvg(voted)}<span id="glLbLikeCount">${btn.dataset.likes || '0'}</span>`;
    }
    if (creditEl) {
      const author = btn.dataset.author || 'Muntrume Motorsport';
      const sourceUrl = btn.dataset.sourceUrl || '';
      creditEl.innerHTML = sourceUrl
        ? `Captura por ${author} · <a href="${sourceUrl}" target="_blank" rel="noopener noreferrer nofollow" class="text-emerald-400 underline">Ver fuente ↗</a>`
        : `Captura por ${author}`;
    }
    lb.dataset.activePhotoId = btn.dataset.photoId || '';
    lb.classList.remove('hidden');
    lb.classList.add('flex');
  };

  const tdModal = document.getElementById('glTakedownModal');
  const tdForm = document.getElementById('glTdForm') as HTMLFormElement | null;
  const tdStatus = document.getElementById('glTdStatus');
  const tdSubmit = document.getElementById('glTdSubmit') as HTMLButtonElement | null;
  const closeTd = () => {
    if (tdModal) tdModal.style.display = 'none';
  };
  document.getElementById('glTdClose')?.addEventListener('click', closeTd);
  document.getElementById('glTdCancel')?.addEventListener('click', closeTd);
  tdModal?.addEventListener('click', (e) => { if (e.target === tdModal) closeTd(); });

  document.getElementById('glLbTakedownBtn')?.addEventListener('click', () => {
    const id = lb?.dataset.activePhotoId || '';
    const title = lbTitle?.textContent || 'Captura de galería';
    const src = lbImg?.src || '';
    const thumb = document.getElementById('glTdThumb') as HTMLImageElement | null;
    const titleEl = document.getElementById('glTdPhotoTitle');
    const idEl = document.getElementById('glTdPhotoId');
    if (thumb) thumb.src = src;
    if (titleEl) titleEl.textContent = title;
    if (idEl) idEl.textContent = `ID: ${id || 'N/A'}`;
    if (tdModal) {
      tdModal.dataset.photoId = id;
      tdModal.dataset.photoTitle = title;
      tdModal.style.display = 'flex';
    }
  });

  tdForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(tdForm);
    const id = tdModal?.dataset.photoId || tdModal?.dataset.photoTitle || 'galeria';
    if (tdSubmit) { tdSubmit.disabled = true; tdSubmit.textContent = 'Enviando…'; }
    try {
      const resp = await fetch('https://muntrume.atrumin16.workers.dev/api/gallery/takedown', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id,
          authorName: fd.get('authorName'),
          email: fd.get('email'),
          contact: `${fd.get('authorName')} <${fd.get('email')}>`,
          originalUrl: fd.get('originalUrl'),
          reason: fd.get('reason'),
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (tdStatus) {
        tdStatus.textContent = data.message || data.error || 'Solicitud enviada.';
        tdStatus.className = resp.ok ? 'text-xs font-mono text-emerald-400' : 'text-xs font-mono text-rose-400';
        tdStatus.classList.remove('hidden');
      }
      if (resp.ok) {
        tdForm.reset();
        setTimeout(closeTd, 1500);
      }
    } catch {
      if (tdStatus) {
        tdStatus.textContent = 'Error de red al enviar la solicitud.';
        tdStatus.className = 'text-xs font-mono text-rose-400';
        tdStatus.classList.remove('hidden');
      }
    } finally {
      if (tdSubmit) { tdSubmit.disabled = false; tdSubmit.textContent = 'Enviar solicitud de retirada'; }
    }
  });

  lbImg?.addEventListener('click', () => {
    const zoomed = lbImg.dataset.zoomed === '1';
    lbImg.dataset.zoomed = zoomed ? '0' : '1';
    lbImg.style.transform = zoomed ? 'scale(1)' : 'scale(2)';
    lbImg.classList.toggle('cursor-zoom-in', zoomed);
    lbImg.classList.toggle('cursor-zoom-out', !zoomed);
  });
  lbImg?.addEventListener('mousemove', (e) => {
    if (lbImg.dataset.zoomed !== '1') return;
    const r = lbImg.getBoundingClientRect();
    const ox = Math.min(100, Math.max(0, ((e.clientX - r.left) / Math.max(1, r.width)) * 100));
    const oy = Math.min(100, Math.max(0, ((e.clientY - r.top) / Math.max(1, r.height)) * 100));
    lbImg.style.transformOrigin = `${ox}% ${oy}%`;
  });

  // Dynamic community gallery hydration with progressive pagination + white SVG likes
  const LIKES_KEY = 'mmt_gallery_likes_v1';
  const loadVotedSet = (): Set<string> => {
    try { return new Set(JSON.parse(localStorage.getItem(LIKES_KEY) || '[]')); } catch { return new Set(); }
  };
  const saveVotedSet = (s: Set<string>) => {
    try { localStorage.setItem(LIKES_KEY, JSON.stringify(Array.from(s))); } catch {}
  };
  const thumbSvg = (voted: boolean) =>
    `<svg width="15" height="15" viewBox="0 0 24 24" fill="${voted ? '#ffffff' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#ffffff;opacity:${voted ? '1' : '0.85'};"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>`;
  const likeBtnStyle = (voted: boolean) =>
    voted
      ? 'background:rgba(16,185,129,0.16);border-color:#10b981;color:#ffffff;'
      : 'background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.14);color:#ffffff;';

  const renderCardHtml = (p: any, idx: number) => {
    const voted = loadVotedSet().has(String(p.id));
    const useCrop = Boolean(p.hasLegacyWatermark && p.cleanCrop && !p.aiEnhanced);
    const cropStyle = useCrop ? 'transform:scale(1.13);transform-origin:center;' : '';
    return `
    <article data-category="${p.category}" data-index="${idx}" class="galeria-card group rounded-xl overflow-hidden bg-[var(--r-surface)] transition-all duration-200" style="border: 1px solid rgba(255, 255, 255, 0.08);">
      <button type="button" class="galeria-open-btn relative block w-full aspect-video overflow-hidden bg-[#090d12] cursor-zoom-in text-left" data-photo-id="${p.id}" data-likes="${p.likes || 0}" data-src="${p.imageUrl}" data-title="${p.title}" data-sub="${p.car || ''} · ${p.track || 'iRacing'}" data-author="${p.authorName}" data-source-url="${p.sourceUrl || ''}" data-car-slug="${p.carSlug || ''}" data-track-slug="${p.trackSlug || ''}" data-clean-crop="${useCrop ? '1' : '0'}">
        <img src="${p.imageUrl}" alt="${p.title}" width="640" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="if(!this.dataset.proxied){this.dataset.proxied='1';this.src='https://muntrume.atrumin16.workers.dev/api/media/proxy?url='+encodeURIComponent(this.getAttribute('src')||'');}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" style="filter: contrast(1.04) saturate(1.06);${cropStyle}" />
        <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(9,11,15,0.88) 0%, transparent 55%);"></div>
        <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded bg-black/80 border border-white/15 text-[var(--r-accent)] text-[10px] font-mono font-bold uppercase">${p.category}</span>
        <span class="absolute bottom-2.5 left-2.5 text-[10px] font-mono text-white/85">📸 ${p.authorName}</span>
        <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded bg-black/80 border border-white/15 text-[10px] font-mono text-white/90 opacity-0 group-hover:opacity-100 transition-opacity">Ampliar HD ⤢</span>
      </button>
      <div class="p-3.5 space-y-1">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-sm font-bold text-[var(--r-text)] font-display truncate">${p.title}</h2>
          <button type="button" data-like-id="${p.id}" class="gl-like-btn inline-flex items-center gap-1 px-2 py-0.5 rounded-lg border font-mono text-[11px] font-bold tabular-nums shrink-0 transition cursor-pointer" style="${likeBtnStyle(voted)}">${thumbSvg(voted)}<span>${p.likes || 0}</span></button>
        </div>
        <p class="text-[11px] text-[var(--r-muted)] flex items-center justify-between gap-2">
          <span>${p.car || p.track || 'iRacing'}</span>
          ${p.sourceUrl ? `<a href="${p.sourceUrl}" target="_blank" rel="noopener noreferrer nofollow" class="underline hover:text-white">Ver fuente ↗</a>` : ''}
        </p>
      </div>
    </article>
  `;
  };

  let nextOffset = 200;
  let currentSort = 'popular';
  const initQs = new URLSearchParams(window.location.search);
  const initCar = (initQs.get('car') || '').trim();
  const loadMoreBtn = document.getElementById('glLoadMoreBtn') as HTMLButtonElement | null;
  const sortSelect = document.getElementById('glSortSelect') as HTMLSelectElement | null;

  document.getElementById('galeriaGrid')?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.gl-like-btn');
    if (!btn) return;
    e.stopPropagation();
    const id = btn.dataset.likeId || '';
    const voted = loadVotedSet();
    if (!id || voted.has(id)) return;
    voted.add(id);
    saveVotedSet(voted);
    const curVal = Number(btn.querySelector('span')?.textContent || '0') + 1;
    btn.setAttribute('style', likeBtnStyle(true));
    btn.innerHTML = `${thumbSvg(true)}<span>${curVal}</span>`;
    await fetch(`https://muntrume.atrumin16.workers.dev/api/gallery/${encodeURIComponent(id)}/like`, { method: 'POST' }).catch(() => {});
  });

  const SLUG_GROUPS: string[][] = [
    ['chevrolet-corvette-z06-gt3-r', 'chevrolet-corvette-z06-gt3r', 'chevyvettez06rgt3'],
    ['super-formula-sf23', 'super-formula-sf23-toyota'],
    ['porsche-911-cup-992-1', 'porsche-911-gt3-cup', 'porsche-911-gt3-cup-992', 'porsche992cup'],
    ['porsche-911-gt3-r-992', 'porsche992rgt3'],
    ['dirt-micro-sprint', 'dirt-outlaw-micro-sprint-winged'],
    ['dirt-micro-sprint-non-winged', 'dirt-outlaw-micro-sprint-non-winged'],
  ];

  const fetchGalleryPage = async (sort = 'popular') => {
    const altsRaw = new URLSearchParams(window.location.search).get('alts') || '';
    const extraSlugs = altsRaw.split(',').map((s) => s.trim()).filter(Boolean);
    if (initCar) {
      const lower = initCar.toLowerCase();
      const grp = SLUG_GROUPS.find((g) => g.includes(lower));
      if (grp) {
        for (const alias of grp) {
          if (alias !== lower && !extraSlugs.includes(alias)) extraSlugs.push(alias);
        }
      }
    }
    const carParam = initCar ? `&car=${encodeURIComponent(initCar)}` : '';
    const primary = await fetch(`https://muntrume.atrumin16.workers.dev/api/gallery?status=published&sort=${encodeURIComponent(sort)}&limit=200&offset=0${carParam}`)
      .then((r) => (r.ok ? r.json() : null));
    if (!primary || !Array.isArray(primary.photos)) return primary;
    if (!initCar) {
      // Exclude residual 1-photo promotional studio renders from the main gallery grid
      const countsBySlug = new Map<string, number>();
      for (const p of primary.photos) {
        const s = String(p.carSlug || p.car || '').toLowerCase();
        if (s) countsBySlug.set(s, (countsBySlug.get(s) || 0) + 1);
      }
      primary.photos = primary.photos.filter((p: any) => {
        const s = String(p.carSlug || p.car || '').toLowerCase();
        const isLegacyPromo = /s100\.iracing\.com/i.test(String(p.imageUrl || '')) && (countsBySlug.get(s) || 0) <= 1;
        return !isLegacyPromo;
      });
    }
    if (extraSlugs.length === 0) return primary;
    const seen = new Set(primary.photos.map((p: any) => p.imageUrl || p.id));
    const extras = await Promise.all(
      extraSlugs.map((slug) =>
        fetch(`https://muntrume.atrumin16.workers.dev/api/gallery?status=published&sort=${encodeURIComponent(sort)}&limit=200&offset=0&car=${encodeURIComponent(slug)}`)
          .then((r) => (r.ok ? r.json() : null))
          .catch(() => null)
      )
    );
    for (const ex of extras) {
      if (!ex || !Array.isArray(ex.photos)) continue;
      for (const p of ex.photos) {
        const k = p.imageUrl || p.id;
        if (!seen.has(k)) {
          seen.add(k);
          primary.photos.push(p);
        }
      }
    }
    return primary;
  };

  sortSelect?.addEventListener('change', () => {
    currentSort = sortSelect.value || 'popular';
    nextOffset = 200;
    void fetchGalleryPage(currentSort).then((data) => {
      const grid = document.getElementById('galeriaGrid');
      if (!grid || !data || !Array.isArray(data.photos)) return;
      grid.innerHTML = data.photos.map((p: any, idx: number) => renderCardHtml(p, idx)).join('');
      cards.length = 0;
      cards.push(...Array.from(grid.querySelectorAll<HTMLElement>('.galeria-card')));
      cards.forEach((card) => {
        const b = card.querySelector<HTMLButtonElement>('.galeria-open-btn');
        b?.addEventListener('click', () => { const list = visibleButtons(); openAt(Math.max(0, list.indexOf(b))); });
      });
      if (loadMoreBtn) loadMoreBtn.hidden = !data.hasMore;
    });
  });

  fetchGalleryPage(currentSort)
    .then((data) => {
      if (!data || !Array.isArray(data.photos)) return;
      const grid = document.getElementById('galeriaGrid');
      if (!grid) return;
      if (data.photos.length === 0) {
        grid.innerHTML = `
          <div class="col-span-full rounded-2xl border border-dashed border-[var(--r-line)] bg-[var(--r-surface)]/60 p-10 text-center space-y-3">
            <p class="text-sm font-mono text-[var(--r-muted)]">Próximamente nuevas capturas oficiales del equipo</p>
            <button type="button" data-open-community-upload class="px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 text-xs font-mono font-bold cursor-pointer">+ Subir captura</button>
          </div>
        `;
        grid.querySelector('[data-open-community-upload]')?.addEventListener('click', () => {
          const m = document.getElementById('communityUploadModal');
          if (m) m.hidden = false;
        });
        return;
      }
      grid.innerHTML = data.photos.map((p: any, idx: number) => renderCardHtml(p, idx)).join('');
      if (loadMoreBtn) loadMoreBtn.hidden = !data.hasMore;
      loadMoreBtn?.addEventListener('click', async () => {
        loadMoreBtn.disabled = true;
        loadMoreBtn.textContent = 'Cargando…';
        try {
          const carParam = initCar ? `&car=${encodeURIComponent(initCar)}` : '';
          const more = await fetch(`https://muntrume.atrumin16.workers.dev/api/gallery?status=published&sort=${encodeURIComponent(currentSort)}&limit=200&offset=${nextOffset}${carParam}`).then((r) => (r.ok ? r.json() : null));
          if (more && Array.isArray(more.photos) && more.photos.length > 0) {
            const startIdx = cards.length;
            grid.insertAdjacentHTML('beforeend', more.photos.map((p: any, i: number) => renderCardHtml(p, startIdx + i)).join(''));
            const newCards = Array.from(grid.querySelectorAll<HTMLElement>('.galeria-card')).slice(startIdx);
            cards.push(...newCards);
            newCards.forEach((card) => {
              const btn = card.querySelector<HTMLButtonElement>('.galeria-open-btn');
              btn?.addEventListener('click', () => {
                const list = visibleButtons();
                openAt(Math.max(0, list.indexOf(btn)));
              });
            });
            nextOffset += more.photos.length;
            loadMoreBtn.hidden = !more.hasMore;
          } else {
            loadMoreBtn.hidden = true;
          }
        } finally {
          loadMoreBtn.disabled = false;
          loadMoreBtn.textContent = 'Cargar más capturas ↓';
        }
      });
      cards.length = 0;
      cards.push(...Array.from(grid.querySelectorAll<HTMLElement>('.galeria-card')));

      const normCat = (raw: string): string => {
        const s = raw.trim().toLowerCase();
        if (s === 'prototipos gtp' || s === 'gtp') return 'gtp';
        if (s === 'noche / resistencia' || s === 'night') return 'night';
        return s;
      };
      const LABELS: Record<string, string> = {
        gt3: 'GT3',
        gtp: 'Prototipos GTP',
        gte: 'GTE / Classic',
        gt4: 'GT4',
        cup: 'Cup',
        formula: 'Formula',
        oval: 'Oval',
        dirt: 'Dirt',
        night: 'Noche / Resistencia',
      };

      const counts: Record<string, number> = {};
      for (const p of data.photos) {
        const c = normCat(String(p.category || ''));
        if (c) counts[c] = (counts[c] || 0) + 1;
      }

      const qs = new URLSearchParams(window.location.search);
      const qCat = normCat(qs.get('category') || '');
      if (qCat && counts[qCat]) activeFilter = qCat;

      const filterBar = document.getElementById('galleryFilterBar');
      const applyFilter = (f: string, syncUrl = true) => {
        activeFilter = f;
        filterBar?.querySelectorAll<HTMLButtonElement>('.galeria-filter-btn').forEach((b) => {
          const on = (b.dataset.filter || 'all') === activeFilter;
          b.className = on
            ? 'galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition cursor-pointer bg-[var(--r-accent)] text-[var(--r-accent-ink)] border border-[var(--r-accent)]'
            : 'galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold transition cursor-pointer bg-[var(--r-surface)] text-[var(--r-muted)] border border-[var(--r-line)] hover:border-[var(--r-accent)]';
        });
        cards.forEach((c) => {
          c.style.display = '';
          c.hidden = activeFilter !== 'all' && normCat(c.dataset.category || '') !== activeFilter;
        });
        if (syncUrl) {
          const nextUrl = new URL(window.location.href);
          if (activeFilter === 'all') nextUrl.searchParams.delete('category');
          else nextUrl.searchParams.set('category', activeFilter);
          history.replaceState(null, '', nextUrl.toString());
        }
      };

      if (filterBar) {
        const order = ['gt3', 'gtp', 'gte', 'cup', 'gt4', 'formula', 'oval', 'dirt', 'night', ...Object.keys(counts)];
        const uniqueKeys = Array.from(new Set(order)).filter((k) => (counts[k] || 0) >= 1);
        const clearCarBtn = initCar
          ? `<a href="/gallery/" class="px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition cursor-pointer bg-white/10 text-white border border-white/20 hover:border-[var(--r-accent)]">&larr; Ver todos los coches</a>`
          : '';
        filterBar.innerHTML = [
          clearCarBtn,
          `<button type="button" data-filter="all" class="galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition cursor-pointer">Todas (${data.photos.length})</button>`,
          ...uniqueKeys.map(
            (k) => `<button type="button" data-filter="${k}" class="galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold transition cursor-pointer">${LABELS[k] || k.toUpperCase()} (${counts[k]})</button>`
          ),
        ].join('');
        filterBar.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
          if (btn) applyFilter(btn.dataset.filter || 'all', true);
        });
      }

      applyFilter(activeFilter, false);

      const normSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      const qCar = normSlug(qs.get('car') || '');
      const qTrack = normSlug(qs.get('track') || '');
      if (qCar || qTrack) {
        cards.forEach((c) => {
          const btn = c.querySelector<HTMLButtonElement>('.galeria-open-btn');
          const cSlug = normSlug(btn?.dataset.carSlug || '');
          const tSlug = normSlug(btn?.dataset.trackSlug || '');
          const match = (!qCar || cSlug === qCar) && (!qTrack || tSlug === qTrack);
          c.style.display = match ? '' : 'none';
        });
      }

      cards.forEach((card) => {
        const btn = card.querySelector<HTMLButtonElement>('.galeria-open-btn');
        btn?.addEventListener('click', () => {
          const list = visibleButtons();
          openAt(Math.max(0, list.indexOf(btn)));
        });
      });
    })
    .catch(() => {});

  const closeLb = () => {
    if (!lb) return;
    lb.classList.add('hidden');
    lb.classList.remove('flex');
  };

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter || 'all';
      filterBtns.forEach((b) => {
        const on = b === btn;
        b.className = on
          ? 'galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-bold transition cursor-pointer bg-[var(--r-accent)] text-[var(--r-accent-ink)] border border-[var(--r-accent)]'
          : 'galeria-filter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold transition cursor-pointer bg-[var(--r-surface)] text-[var(--r-muted)] border border-[var(--r-line)] hover:border-[var(--r-accent)]';
      });
      cards.forEach((c) => {
        c.hidden = activeFilter !== 'all' && c.dataset.category !== activeFilter;
      });
    });
  });

  cards.forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('.galeria-open-btn');
    btn?.addEventListener('click', () => {
      const list = visibleButtons();
      const idx = list.indexOf(btn);
      openAt(idx >= 0 ? idx : 0);
    });
  });

  document.getElementById('glLbLikeBtn')?.addEventListener('click', async () => {
    const lbLikeBtn = document.getElementById('glLbLikeBtn') as HTMLButtonElement | null;
    const pid = lbLikeBtn?.dataset.photoId || '';
    const voted = loadVotedSet();
    if (!lbLikeBtn || !pid || voted.has(pid)) return;
    voted.add(pid);
    saveVotedSet(voted);
    const nextN = Number(document.getElementById('glLbLikeCount')?.textContent || '0') + 1;
    lbLikeBtn.setAttribute('style', likeBtnStyle(true));
    lbLikeBtn.innerHTML = `${thumbSvg(true)}<span id="glLbLikeCount">${nextN}</span>`;
    const cardLike = document.querySelector<HTMLButtonElement>(`.gl-like-btn[data-like-id="${pid}"]`);
    if (cardLike) {
      cardLike.setAttribute('style', likeBtnStyle(true));
      cardLike.innerHTML = `${thumbSvg(true)}<span>${nextN}</span>`;
    }
    await fetch(`https://muntrume.atrumin16.workers.dev/api/gallery/${encodeURIComponent(pid)}/like`, { method: 'POST' }).catch(() => {});
  });

  document.getElementById('glLbClose')?.addEventListener('click', closeLb);
  document.getElementById('glLbPrev')?.addEventListener('click', () => openAt(currentVisibleIdx - 1));
  document.getElementById('glLbNext')?.addEventListener('click', () => openAt(currentVisibleIdx + 1));
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) closeLb();
  });

  document.addEventListener('keydown', (e) => {
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowLeft') openAt(currentVisibleIdx - 1);
    else if (e.key === 'ArrowRight') openAt(currentVisibleIdx + 1);
  });
</script>
