---
import Layout from '../../layouts/Layout.astro';
import DriverCard from '../../components/DriverCard.astro';
import DriverF1Stats from '../../components/DriverF1Stats.astro';
import DriverRatingsChart from '../../components/DriverRatingsChart.astro';
import { PILOTOS, LICENCE_UPDATED_LABEL, isRoadTrack } from '../../lib/pilotos';
import { licenciaPrincipal } from '../../lib/licencias';
import { formatoAprox, localeDeIdioma } from '../../lib/formato-licencia.js';
import catalog from '../../../public/assets/data/catalog_index.json';

export function getStaticPaths() {
  return PILOTOS.map(p => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const driver = PILOTOS.find(p => p.slug === slug) || PILOTOS[0];
const principal = licenciaPrincipal(driver.slug);
const pageTitle = `${driver.fullName} (${driver.dorsal}) | Pilotos | Muntrume Motorsport`;
const loc = localeDeIdioma("es");
const pageDescription = principal
  ? `${driver.fullName}, ${driver.role} en Muntrume Motorsport. Licencia Sports Car ${principal.classLabel}, SR ${formatoAprox(Number(principal.sr), "sr", loc)}, iRating ${formatoAprox(principal.irating, "k", loc)}. Actualizado: ${LICENCE_UPDATED_LABEL}.`
  : `${driver.fullName}, ${driver.role} en Muntrume Motorsport.`;
const pageUrl = `https://muntru.me/d/${driver.slug}/`;
const ogImage = `https://muntru.me/assets/img/og/${driver.slug}.webp`;
const index = Math.max(0, PILOTOS.findIndex((p) => p.slug === driver.slug));
const prev = PILOTOS[(index + PILOTOS.length - 1) % PILOTOS.length];
const next = PILOTOS[(index + 1) % PILOTOS.length];

const mates = PILOTOS.map((p) => {
  const row = licenciaPrincipal(p.slug);
  const hours = p.totalTrackHours || (p.topTracks || []).reduce((acc, t) => acc + t.hours, 0);
  return {
    driver: p,
    sr: row ? Number(row.sr) : 0,
    ir: row?.irating ?? 0,
    tt: row?.ttRating ?? 0,
    hours,
  };
}).filter((row) => row.sr > 0 || row.ir > 0);

const selfRow = mates.find((m) => m.driver.slug === driver.slug) || mates[0];
const avgSr = mates.length ? Number((mates.reduce((s, r) => s + r.sr, 0) / mates.length).toFixed(2)) : 0;
const avgIr = mates.length ? Math.round(mates.reduce((s, r) => s + r.ir, 0) / mates.length) : 0;
const avgHours = mates.length ? Number((mates.reduce((s, r) => s + r.hours, 0) / mates.length).toFixed(1)) : 0;
const maxSr = Math.max(...mates.map((row) => row.sr), avgSr, 1);
const maxIr = Math.max(...mates.map((row) => row.ir), avgIr, 1);
const maxHours = Math.max(...mates.map((row) => row.hours), avgHours, 1);

const CAR_SLUG_MAP: Record<string, string> = {
  "Ford Mustang GT3": "fordmustanggt3",
  "Ferrari 296 GT3": "ferrari296gt3",
  "McLaren 720S GT3 EVO": "mclaren720sgt3",
  "BMW M4 GT3": "bmwm4gt3",
  "Porsche 911 GT3 R (992)": "porsche992rgt3",
  "Mercedes-AMG GT3 2020": "mercedesamgevogt3",
  "Porsche 911 GT3 Cup (992)": "porsche992cup",
  "Acura NSX GT3 EVO 22": "acuransxevo22gt3",
  "Porsche 718 Cayman GT4 Clubsport": "porsche718gt4",
  "BMW M4 GT4": "bmwm4gt4",
  "McLaren 570S GT4": "mclaren570sgt4",
  "Aston Martin Vantage GT4": "amvantagegt4",
};

type CatalogRow = [number, string, string, string, string, string, string, number];
const allRows = (catalog.initial_rows || []) as CatalogRow[];

const driverSetups = (driver.topCars || []).slice(0, 3).map((carItem) => {
  const carKey = CAR_SLUG_MAP[carItem.name] || "";
  const matching = allRows.filter((r) => r[1] === carKey && isRoadTrack(r[4]));
  const tracks = Array.from(new Set(matching.map((r) => r[4]))).slice(0, 2);
  const endurRow = matching.find((r) => String(r[6]).toLowerCase() === "race" && String(r[5]).includes("Endur") && !String(r[5]).includes("Safe"));
  const sprintRow = matching.find((r) => String(r[6]).toLowerCase() === "race" && String(r[5]).includes("Sprint") && !String(r[5]).includes("Safe"));
  const qualyRow = matching.find((r) => String(r[6]).toLowerCase() === "qualy" && !String(r[5]).includes("Safe"));
  const bestRow = endurRow || sprintRow || qualyRow || matching[0];
  const sampleFiles = bestRow
    ? [{
        season: bestRow[2],
        week: bestRow[3],
        track: bestRow[4],
        file: bestRow[5],
        type: bestRow[6],
      }]
    : [];
  return {
    carName: carItem.name,
    carKey,
    hours: carItem.hours,
    tracks,
    sampleFiles,
  };
});

const DRIVER_RECIPIENT_IDS: Record<string, string> = {
  albertot: "alberto",
  mateob: "mateo",
};
const driverRecipientId = DRIVER_RECIPIENT_IDS[driver.slug] || "admin";

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://muntru.me/" },
        { "@type": "ListItem", "position": 2, "name": "Pilotos", "item": "https://muntru.me/pilotos/" },
        { "@type": "ListItem", "position": 3, "name": driver.fullName, "item": pageUrl }
      ]
    },
    {
      "@type": "Person",
      "@id": `${pageUrl}#person`,
      "name": driver.fullName,
      "jobTitle": driver.role,
      "url": pageUrl,
      "memberOf": {
        "@type": "SportsTeam",
        "@id": "https://muntru.me/#org",
        "name": "Muntrume Motorsport",
        "alternateName": ["MMT", "Muntrume", "MMT Motorsport"]
      },
      "nationality": driver.country || undefined,
      "image": ogImage
    },
    {
      "@type": "ProfilePage",
      "@id": `${pageUrl}#profile`,
      "url": pageUrl,
      "name": driver.fullName,
      "description": pageDescription,
      "mainEntity": { "@id": `${pageUrl}#person` }
    },
    {
      "@type": "SportsTeam",
      "@id": "https://muntru.me/#org",
      "name": "Muntrume Motorsport",
      "alternateName": ["MMT", "Muntrume", "MMT Motorsport"],
      "sport": "Sim Racing (iRacing)",
      "url": "https://muntru.me/",
      "contactPoint": [
        { "@type": "ContactPoint", "contactType": "customer support", "url": "https://support.muntru.me/requests/new" },
        { "@type": "ContactPoint", "contactType": "legal", "url": "https://muntru.me/contact/?to=legal" }
      ],
      "athlete": { "@id": `${pageUrl}#person` }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl} ogImage={ogImage} schemaJson={personSchema}>
  <section class="r-section" style="border-top:0;padding-top:clamp(88px,10vw,120px);padding-bottom:40px" aria-labelledby="dTitle" data-driver={driver.slug} id="driverRoot">
    <div class="r-wrap max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-[var(--r-muted)] mb-4" aria-label="Ruta" data-no-i18n>
        <a href="/" class="hover:text-[var(--r-text)] transition-colors">Inicio</a>
        <span class="opacity-40">/</span>
        <a href="/pilotos/" class="hover:text-[var(--r-text)] transition-colors">Pilotos</a>
        <span class="opacity-40">/</span>
        <span class="text-[var(--r-accent)] font-bold">{driver.fullName}</span>
      </nav>
      <nav class="d-tabs" aria-label="Secciones de la ficha" data-no-i18n>
        <a href="#resumen">Resumen</a>
        <a href="#stats">Cifras</a>
        <a href="#licencia">Licencia</a>
        <a href="#favorito">Circuito favorito</a>
        <a href="#vueltas">Vueltas</a>
        <a href="#circuitos">Circuitos</a>
        <a href="#coches">Coches</a>
        <a href="#bio">Perfil</a>
        <a href="#logros">Logros</a>
        <a href="#redes">Redes</a>
        <a href={`/contact/?to=${driverRecipientId}`}>Contacto</a>
        <a href="#setups">Setups</a>
        <a href="#comparativa">Equipo</a>
        <a href="#eventos" id="eventosTab">Calendario</a>
      </nav>
      <DriverCard driver={driver} heading="h1" headingId="dTitle" hero />
      <DriverF1Stats driver={driver} />
      <DriverRatingsChart slug={driver.slug} driverName={driver.fullName} />
      <div class="d-tools">
        <nav class="d-pager" aria-label="Other drivers">
          <a href={`/d/${prev.slug}/`}>← {prev.fullName}</a>
          <a href={`/d/${next.slug}/`}>{next.fullName} →</a>
        </nav>
        <div class="d-share">
          <button type="button" id="nativeShare">Compartir ficha</button>
          <button type="button" id="copyLink">Copiar enlace</button>
          <p id="copyStatus" class="r-meta" role="status" aria-live="polite"></p>
        </div>
      </div>

      <section class="d-contact-banner d-reveal" id="contacto" aria-labelledby="contactoTitle">
        <div class="d-contact-banner__head">
          <div>
            <p class="r-kicker">Contacto oficial</p>
            <h2 id="contactoTitle" class="d-block__title">Contacto directo · {driver.fullName} ({driver.dorsal})</h2>
          </div>
          <span class="d-f1__formula-pill">RESPUESTA DIRECTA</span>
        </div>
        <div class="d-contact-grid">
          <div class="d-contact-item d-contact-item--primary">
            <span class="d-contact-item__label">Piloto · {driver.fullName}</span>
            <div class="d-contact-item__row">
              <a href={`/contact/?to=${driverRecipientId}`} class="d-contact-item__mail">Enviar mensaje directo →</a>
            </div>
          </div>
          <div class="d-contact-item">
            <span class="d-contact-item__label">Soporte Técnico / Incidencias</span>
            <div class="d-contact-item__row">
              <a href="https://support.muntru.me/requests/new" class="d-contact-item__mail">Abrir ticket en Soporte →</a>
            </div>
          </div>
          <div class="d-contact-item">
            <span class="d-contact-item__label">Legal / Privacidad / Administración</span>
            <div class="d-contact-item__row">
              <a href="/contact/?to=legal" class="d-contact-item__mail">Contactar con Departamento Legal →</a>
            </div>
          </div>
        </div>
      </section>

      {driverSetups.length > 0 && (
        <section class="d-setups d-reveal" id="setups" aria-labelledby="setupsTitle">
          <div class="d-section-head">
            <div>
              <p class="r-kicker">Setup Vault · Top Destacados</p>
              <h2 id="setupsTitle" class="d-block__title">Setups destacados ({driverSetups.length})</h2>
              <p class="r-meta">Solo los setups que mejor funcionan para {driver.name}, con sensaciones, delta vs Top Split y notas desde MMT Sync.</p>
            </div>
            <a href="/garage" class="r-link">Ver catálogo completo →</a>
          </div>
          <div class="d-setups__grid grid grid-cols-1 md:grid-cols-3 gap-5 items-stretch">
            {driverSetups.map((item) => {
              const topFile = item.sampleFiles[0];
              return (
              <article class="d-setup-card flex flex-col justify-between h-full">
                <div class="d-setup-card__content flex flex-col gap-3">
                  <div class="d-setup-card__top">
                    <h3 class="d-setup-card__title">{item.carName}</h3>
                    <span class="d-setup-card__hours"><span data-approx="h" data-n={item.hours}>{formatoAprox(item.hours, "h", loc)}</span> en pista</span>
                  </div>
                  {topFile ? (
                    <ul class="d-setup-card__files">
                      <li>
                        <div class="d-setup-file__row">
                          <span class="sto-type" data-type={String(topFile.type || "").toUpperCase()}>{topFile.type}</span>
                          <code title={topFile.file}>{topFile.file}</code>
                        </div>
                        <span class="d-setup-file__meta">{topFile.season} · {topFile.track}</span>
                      </li>
                    </ul>
                  ) : (
                    <p class="r-meta">Disponible en el catálogo general del Garage ({item.carKey || "GT"}).</p>
                  )}
                  <div
                    class="rounded-xl border border-[var(--r-line)] bg-[var(--r-bg-2)] p-2.5"
                    data-setup-rating-slot
                    data-car-key={item.carKey}
                    data-setup-file={topFile?.file || ""}
                  >
                    <span class="text-[11px] font-mono text-[var(--r-muted)]">Cargando valoraciones de pista…</span>
                  </div>
                </div>
                <div class="d-setup-card__footer flex items-center justify-between gap-2 flex-wrap">
                  <a class="r-link d-setup-card__cta" href={item.carKey ? `/garage?car=${encodeURIComponent(item.carKey)}` : "/garage"}>
                    <span>Ver más en Garage</span>
                    <span aria-hidden="true">→</span>
                  </a>
                  <button
                    type="button"
                    data-open-setup-review
                    data-setup={topFile?.file || item.carName}
                    data-car={item.carKey}
                    data-track={topFile?.track || ""}
                    class="px-2.5 py-1 rounded-lg border border-[var(--r-line)] bg-[var(--r-bg-2)] hover:border-[var(--r-accent)] text-[11px] font-mono font-bold text-[var(--r-text)] cursor-pointer transition"
                  >
                    ⭐ Valorar
                  </button>
                </div>
              </article>
              );
            })}
          </div>
        </section>
      )}

      {mates.length > 1 && selfRow && (
        <section class="d-compare d-reveal" id="comparativa" aria-labelledby="compareTitle">
          <h2 id="compareTitle" class="d-block__title">Comparación del equipo</h2>
          <p class="r-meta">Cifras Sports Car frente a la media de Muntrume Motorsport.</p>

          <div class="d-vs-grid">
            <div class="d-vs-card">
              <span class="d-vs-card__label">iRating (Sports Car)</span>
              <div class="d-vs-row">
                <span>{driver.name}</span>
                <strong data-approx="k" data-n={selfRow.ir}>{formatoAprox(selfRow.ir, "k", loc)}</strong>
              </div>
              <span class="d-mini" aria-hidden="true"><span style={`width:${Math.round((100 * selfRow.ir) / maxIr)}%`}></span></span>
              <div class="d-vs-row d-vs-row--avg">
                <span>Muntrume Avg</span>
                <strong data-approx="k" data-n={avgIr}>{formatoAprox(avgIr, "k", loc)}</strong>
              </div>
              <span class="d-mini d-mini--muted" aria-hidden="true"><span style={`width:${Math.round((100 * avgIr) / maxIr)}%`}></span></span>
            </div>

            <div class="d-vs-card">
              <span class="d-vs-card__label">Safety Rating (SR)</span>
              <div class="d-vs-row">
                <span>{driver.name}</span>
                <strong data-approx="sr" data-n={selfRow.sr}>{formatoAprox(selfRow.sr, "sr", loc)}</strong>
              </div>
              <span class="d-mini" aria-hidden="true"><span style={`width:${Math.round((100 * selfRow.sr) / maxSr)}%`}></span></span>
              <div class="d-vs-row d-vs-row--avg">
                <span>Muntrume Avg</span>
                <strong data-approx="sr" data-n={avgSr}>{formatoAprox(avgSr, "sr", loc)}</strong>
              </div>
              <span class="d-mini d-mini--muted" aria-hidden="true"><span style={`width:${Math.round((100 * avgSr) / maxSr)}%`}></span></span>
            </div>

            <div class="d-vs-card">
              <span class="d-vs-card__label">Sports Car Hours on Track</span>
              <div class="d-vs-row">
                <span>{driver.name}</span>
                <strong data-approx="h" data-n={selfRow.hours}>{formatoAprox(selfRow.hours, "h", loc)}</strong>
              </div>
              <span class="d-mini" aria-hidden="true"><span style={`width:${Math.round((100 * selfRow.hours) / maxHours)}%`}></span></span>
              <div class="d-vs-row d-vs-row--avg">
                <span>Muntrume Avg</span>
                <strong data-approx="h" data-n={avgHours}>{formatoAprox(avgHours, "h", loc)}</strong>
              </div>
              <span class="d-mini d-mini--muted" aria-hidden="true"><span style={`width:${Math.round((100 * avgHours) / maxHours)}%`}></span></span>
            </div>
          </div>

          <ul class="d-compare__list">
            {mates.map((row) => (
              <li class:list={[row.driver.slug === driver.slug && "is-self"]}>
                <span>{row.driver.fullName}</span>
                <span class="d-mini" aria-hidden="true"><span style={`width:${Math.round((100 * row.sr) / maxSr)}%`}></span></span>
                <span>SR <span data-approx="sr" data-n={row.sr}>{formatoAprox(row.sr, "sr", loc)}</span></span>
                <span class="d-mini" aria-hidden="true"><span style={`width:${Math.round((100 * row.ir) / maxIr)}%`}></span></span>
                <span>iRating <span data-approx="k" data-n={row.ir}>{row.ir ? formatoAprox(row.ir, "k", loc) : ""}</span></span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>

  <section class="r-section r-section--alt" id="eventos" aria-labelledby="eventosTitle">
    <div class="r-wrap max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full" style="display:grid;gap:12px">
      <div class="d-section-head">
        <div>
          <p class="r-kicker">Season</p>
          <h2 id="eventosTitle" class="r-h3">Próximos eventos</h2>
        </div>
      </div>
      <ul class="r-list" id="driverEvents" hidden></ul>
      <p class="r-empty" id="driverEventsEmpty">Pendiente. No hay eventos próximos publicados para este piloto.</p>
    </div>
  </section>

  <section class="r-section r-section--alt" id="racesSection" hidden aria-labelledby="racesTitle">
    <div class="r-wrap max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full" style="display:grid;gap:16px">
      <div class="r-head" style="margin-bottom:0">
        <div><p class="r-kicker">iRacing</p><h2 id="racesTitle" class="r-h3">Latest 5 Sports Car Races</h2></div>
      </div>
      <div class="r-scroll" id="racesWrap" hidden>
        <table class="r-table">
          <caption class="r-meta" style="text-align:left;padding-bottom:8px">Official iRacing public session results (Sports Car only).</caption>
          <thead><tr><th scope="col">Date</th><th scope="col">Series</th><th scope="col">Circuit</th><th scope="col">Car</th><th scope="col" class="num">Start → Finish</th><th scope="col" class="num">Inc.</th><th scope="col" class="num">ΔiR</th></tr></thead>
          <tbody id="racesBody"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="r-section" aria-label="More drivers">
    <div class="r-wrap max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full" style="display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center">
      <a href="/pilotos/" class="r-link">← Plantilla</a>
      <a href="https://garage61.net/app/teams/muntrume-motorsport" target="_blank" rel="noopener noreferrer" class="r-btn r-btn--primary">Official Team Telemetry on Garage 61 ↗</a>
    </div>
  </section>

  <script is:inline src="/assets/js/driver-page.js?v=t295" defer></script>
  <script is:inline src="/assets/js/setup-reviews.js?v=1" defer></script>
  <script is:inline>
    (function () {
      var url = location.href;
      var copy = document.getElementById("copyLink");
      var native = document.getElementById("nativeShare");
      var status = document.getElementById("copyStatus");
      function copyFallback() {
        var done = function () { if (status) status.textContent = "Enlace copiado"; };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(function () {});
        }
      }
      if (copy) copy.addEventListener("click", copyFallback);
      if (native) native.addEventListener("click", function () {
        if (navigator.share) {
          navigator.share({ title: document.title, url: url }).catch(function () {});
        } else {
          copyFallback();
        }
      });
    })();
  </script>
  <style>
    .d-contact-banner {
      margin-top: 20px;
      padding: 20px 22px;
      border-radius: 16px;
      border: 1px solid var(--r-line, rgba(255, 255, 255, 0.12));
      background: linear-gradient(135deg, rgba(0, 230, 153, 0.06), rgba(14, 18, 24, 0.92));
    }
    .d-contact-banner__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
    }
    .d-contact-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }
    @media (max-width: 820px) {
      .d-contact-grid { grid-template-columns: 1fr; }
    }
    .d-contact-item {
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--r-line, rgba(255, 255, 255, 0.12));
      background: var(--r-surface, #0e1319);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .d-contact-item--primary {
      border-color: rgba(0, 230, 153, 0.4);
    }
    .d-contact-item__label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--r-muted, #94a3b8);
    }
    .d-contact-item__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }
    .d-contact-item__mail {
      color: var(--r-accent, #00e699);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 13.5px;
      font-weight: 700;
      text-decoration: none;
    }
    .d-contact-item__mail:hover { text-decoration: underline; }
  </style>
</Layout>
