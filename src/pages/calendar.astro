    .cal-card__cta:hover { text-decoration: underline; }
  </style>

  <script is:inline>
    (() => {
      const grid = document.getElementById("calGrid");
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll(".cal-card"));
      const searchInput = document.getElementById("calSearch");
      const sortSelect = document.getElementById("calSort");
      const countEl = document.getElementById("calCount");
      const emptyEl = document.getElementById("calEmptyState");
      const favBtn = document.getElementById("btnFavFilter");
      const resetBtn = document.getElementById("btnReset");
      const liveWeekEl = document.getElementById("calLiveWeek");

      const week = Math.max(1, Math.min(12, Math.floor((Date.now() - Date.UTC(2026, 8, 15)) / 604800000) + 1));
      if (liveWeekEl) liveWeekEl.textContent = "SEMANA " + week;

      const FAV_KEY = "mmt_cal_favs_v1";
      let favs = new Set();
      try {
        favs = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || "[]"));
      } catch {}

      let activeCat = "ALL";
      let activeSetup = "ALL";
      let activeTier = "ALL";
      let onlyFavs = false;
      let visibleLimit = 6;
      const loadMoreWrap = document.getElementById("calLoadMoreWrap");
      const showMoreBtn = document.getElementById("calShowMoreBtn");
      const showAllBtn = document.getElementById("calShowAllBtn");

      // Highlight live week dynamically
      cards.forEach((card) => {
        card.querySelectorAll("[data-week-num]").forEach((li) => {
          const w = Number(li.dataset.weekNum);
          li.classList.remove("is-past", "is-now", "is-next");
          li.classList.add(w < week ? "is-past" : w === week ? "is-now" : "is-next");
        });
        const foot = card.querySelector("[data-foot-garage]");
        const titleLink = card.querySelector("[data-title-garage]");
        const nowLink = card.querySelector('.cal-week.is-now a');
        if (nowLink) {
          const href = nowLink.getAttribute("href") || "/garage/";
          if (titleLink) titleLink.setAttribute("href", href);
          if (foot) {
            foot.setAttribute("href", href);
            foot.textContent = "Setups S" + week + " →";
          }
        }
      });

      function syncFavIcons() {
        cards.forEach((card) => {
          const id = card.dataset.id || "";
          const btn = card.querySelector("[data-fav-btn]");
          if (!btn) return;
          const on = favs.has(id);
          btn.classList.toggle("is-on", on);
          btn.setAttribute("aria-pressed", String(on));
        });
      }

      function applySort() {
        const mode = sortSelect?.value || "pop";
        const sorted = [...cards].sort((a, b) => {
          if (mode === "tier-asc") {
            return Number(a.dataset.tierRank) - Number(b.dataset.tierRank) || Number(a.dataset.pop) - Number(b.dataset.pop);
          }
          if (mode === "tier-desc") {
            return Number(b.dataset.tierRank) - Number(a.dataset.tierRank) || Number(a.dataset.pop) - Number(b.dataset.pop);
          }
          if (mode === "name") {
            return (a.dataset.name || "").localeCompare(b.dataset.name || "");
          }
          return Number(a.dataset.pop) - Number(b.dataset.pop) || (a.dataset.name || "").localeCompare(b.dataset.name || "");
        });
        sorted.forEach((el) => grid.appendChild(el));
      }

      function applyFilter(resetLimit = true) {
        if (resetLimit) visibleLimit = 6;
        const q = (searchInput?.value || "").trim().toLowerCase();
        const orderedCards = Array.from(grid.querySelectorAll(".cal-card"));
        let matching = 0;
        let shown = 0;
        orderedCards.forEach((card) => {
          const okCat = activeCat === "ALL" || (activeCat === "ENDURANCE" ? card.dataset.endurance === "1" : card.dataset.cat === activeCat);
          const okSetup = activeSetup === "ALL" || card.dataset.setup === activeSetup;
          const okTier = activeTier === "ALL" || card.dataset.tier === activeTier;
          const okFav = !onlyFavs || favs.has(card.dataset.id || "");
          const okQ = !q || (card.dataset.search || "").includes(q);
          const match = okCat && okSetup && okTier && okFav && okQ;
          if (!match) {
            card.hidden = true;
            return;
          }
          matching++;
          const show = q.length > 0 || matching <= visibleLimit;
          card.hidden = !show;
          if (show) shown++;
        });
        const remaining = Math.max(0, matching - shown);
        if (countEl) {
          countEl.textContent = remaining > 0
            ? `Mostrando ${shown} de ${matching} series`
            : matching + (matching === 1 ? " serie" : " series");
        }
        if (loadMoreWrap) loadMoreWrap.hidden = remaining === 0;
        if (showMoreBtn) showMoreBtn.textContent = `Mostrar +6 series (${remaining} restantes)`;
        if (emptyEl) emptyEl.hidden = matching > 0;
      }

      showMoreBtn?.addEventListener("click", () => {
        visibleLimit += 6;
        applyFilter(false);
      });
      showAllBtn?.addEventListener("click", () => {
        visibleLimit = cards.length;
        applyFilter(false);
      });

      grid.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-fav-btn]");
        if (!btn) return;
        const id = btn.dataset.favBtn;
        if (!id) return;
        if (favs.has(id)) favs.delete(id);
        else favs.add(id);
        try { localStorage.setItem(FAV_KEY, JSON.stringify([...favs])); } catch {}
        syncFavIcons();
        window.dispatchEvent(new CustomEvent("mmt-planner-refresh"));
        if (onlyFavs) applyFilter();
      });

      document.getElementById("calCatPills")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-cat]");
        if (!btn) return;
        activeCat = btn.dataset.cat || "ALL";
        document.querySelectorAll("#calCatPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b === btn));
        applyFilter();
        window.dispatchEvent(new CustomEvent("mmt-planner-refresh", { detail: { cat: activeCat } }));
      });

      document.getElementById("calSetupPills")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-setup]");
        if (!btn) return;
        activeSetup = btn.dataset.setup || "ALL";
        document.querySelectorAll("#calSetupPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b === btn));
        applyFilter();
      });

      document.getElementById("calTierPills")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-tier]");
        if (!btn) return;
        activeTier = btn.dataset.tier || "ALL";
        document.querySelectorAll("#calTierPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b === btn));
        applyFilter();
      });

      favBtn?.addEventListener("click", () => {
        onlyFavs = !onlyFavs;
        favBtn.classList.toggle("is-on", onlyFavs);
        favBtn.setAttribute("aria-pressed", String(onlyFavs));
        applyFilter();
      });

      resetBtn?.addEventListener("click", () => {
        activeCat = "ALL";
        activeSetup = "ALL";
        activeTier = "ALL";
        onlyFavs = false;
        if (searchInput) searchInput.value = "";
        if (sortSelect) sortSelect.value = "pop";
        favBtn?.classList.remove("is-on");
        favBtn?.setAttribute("aria-pressed", "false");
        document.querySelectorAll("#calCatPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b.dataset.cat === "ALL"));
        document.querySelectorAll("#calSetupPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b.dataset.setup === "ALL"));
        document.querySelectorAll("#calTierPills .cal-pill").forEach((b) => b.classList.toggle("is-on", b.dataset.tier === "ALL"));
        applySort();
        applyFilter();
      });

      searchInput?.addEventListener("input", applyFilter);
      sortSelect?.addEventListener("change", () => { applySort(); applyFilter(); });

      syncFavIcons();
      applySort();
      applyFilter();
    })();
  </script>

  <script id="calTrackCatalogData" type="application/json" set:html={JSON.stringify(trackCatalog)}></script>

  <script>
    import { calculateCheckout, detectDefaultTaxProfileId } from "../lib/iracing-store-planner";
    import type { TrackHistoricalMeta } from "../data/iracing-track-roi";

    const panel = document.getElementById("calPlannerPanel");
    const toggleBtn = document.getElementById("btnPlannerToggle");
    const taxSelect = document.getElementById("plannerTaxSelect") as HTMLSelectElement | null;
    const club40Chk = document.getElementById("plannerClub40") as HTMLInputElement | null;
    const creditsInput = document.getElementById("plannerCreditsInput") as HTMLInputElement | null;
    const matrixEl = document.getElementById("plannerMatrix");
    const weeksCoveredEl = document.getElementById("plannerWeeksCovered");
    const roiListEl = document.getElementById("plannerRoiList");
    const roiModeEl = document.getElementById("plannerRoiMode");
    const roiMoreWrap = document.getElementById("plannerRoiMoreWrap");
    const roiCountInfoEl = document.getElementById("plannerRoiCountInfo");
    const roiMoreBtn = document.getElementById("plannerRoiMoreBtn");
    const scopeSelect = document.getElementById("plannerTrackScope") as HTMLSelectElement | null;
    const resetOwnedBtn = document.getElementById("plannerResetOwnedBtn");
    const carRoiListEl = document.getElementById("plannerCarRoiList");
    const cartItemsEl = document.getElementById("plannerCartItems");
    const upsellEl = document.getElementById("plannerUpsellHint");
    const ticketEl = document.getElementById("plannerTicket");

    let trackCatalog: TrackHistoricalMeta[] = [];
    try {
      const raw = document.getElementById("calTrackCatalogData")?.textContent || "[]";
      trackCatalog = JSON.parse(raw);
    } catch { /* ignore */ }

    const freeTrackSet = new Set(
      trackCatalog.filter((t) => t.isFree).map((t) => t.track.toLowerCase())
    );

    if (panel && toggleBtn) {
      const OWNED_KEY = "mmt-owned-tracks-v1";
      const OWNED_CARS_KEY = "mmt-owned-cars-v1";
      const CART_KEY = "mmt-planner-cart-v1";
      const CART_CARS_KEY = "mmt-planner-cart-cars-v1";
      const FAV_KEY = "mmt_cal_favs_v1";
      const SCOPE_KEY = "mmt-planner-scope-v1";

      let owned = new Set<string>();
      let ownedCars = new Set<string>();
      let cart = new Set<string>();
      let cartCars = new Set<string>();
      let roiLimit = 8;
      let activeCalendarCat = "ALL";
      try {
        owned = new Set(JSON.parse(localStorage.getItem(OWNED_KEY) || "[]"));
        ownedCars = new Set(JSON.parse(localStorage.getItem(OWNED_CARS_KEY) || "[]"));
        cart = new Set(JSON.parse(localStorage.getItem(CART_KEY) || "[]"));
        cartCars = new Set(JSON.parse(localStorage.getItem(CART_CARS_KEY) || "[]"));
        const savedScope = localStorage.getItem(SCOPE_KEY);
        if (scopeSelect && savedScope) scopeSelect.value = savedScope;
      } catch { /* ignore */ }

      const params = new URLSearchParams(window.location.search);
      if (params.get("missing")) {
        params.get("missing")!.split(",").map((s) => s.trim()).filter(Boolean).forEach((t) => cart.add(t));
        localStorage.setItem(CART_KEY, JSON.stringify(Array.from(cart)));
      }
      if (params.get("planner") === "1" || params.get("missing")) {
        panel.hidden = false;
        toggleBtn.classList.add("is-on");
        toggleBtn.setAttribute("aria-expanded", "true");
      }

      if (taxSelect) {
        taxSelect.value = detectDefaultTaxProfileId();
        taxSelect.addEventListener("change", () => {
          localStorage.setItem("mmt-tax-profile", taxSelect.value);
          renderPlanner();
        });
      }
      scopeSelect?.addEventListener("change", () => {
        roiLimit = 8;
        try { localStorage.setItem(SCOPE_KEY, scopeSelect.value); } catch {}
        renderPlanner();
      });
      roiMoreBtn?.addEventListener("click", () => {
        roiLimit += 8;
        renderPlanner();
      });
      resetOwnedBtn?.addEventListener("click", () => {
        owned.clear();
        localStorage.setItem(OWNED_KEY, "[]");
        roiLimit = 8;
        renderPlanner();
      });
      club40Chk?.addEventListener("change", renderPlanner);
      creditsInput?.addEventListener("input", renderPlanner);
      document.getElementById("plannerClearCart")?.addEventListener("click", () => {
        cart.clear();
        cartCars.clear();
        localStorage.setItem(CART_KEY, "[]");
        localStorage.setItem(CART_CARS_KEY, "[]");
        renderPlanner();
      });

      const BASE_FREE_TRACKS = trackCatalog.filter((t) => t.isFree).map((t) => t.track);
      const BASE_FREE_CARS = [
        "Global Mazda MX-5 Cup",
        "Formula Vee",
        "Ray FF1600",
        "BMW M2 CS Racing",
        "Toyota GR86",
        "Street Stock",
        "Legends Ford '34 Coupe",
      ];

      document.getElementById("plannerMarkBaseBtn")?.addEventListener("click", () => {
        BASE_FREE_TRACKS.forEach((t) => { owned.add(t); cart.delete(t); });
        BASE_FREE_CARS.forEach((c) => { ownedCars.add(c); cartCars.delete(c); });
        localStorage.setItem(OWNED_KEY, JSON.stringify(Array.from(owned)));
        localStorage.setItem(OWNED_CARS_KEY, JSON.stringify(Array.from(ownedCars)));
        localStorage.setItem(CART_KEY, JSON.stringify(Array.from(cart)));
        localStorage.setItem(CART_CARS_KEY, JSON.stringify(Array.from(cartCars)));
        renderPlanner();
      });

      const detectMmtBtn = document.getElementById("plannerDetectMmtBtn");
      detectMmtBtn?.addEventListener("click", async () => {
        detectMmtBtn.textContent = "⏳ Detectando...";
        try {
          const res = await fetch("http://127.0.0.1:38421/ping");
          const data = await res.json();
          if (data && data.status === "ready") {
            detectMmtBtn.textContent = `✅ MMT Sync v${data.version || ""} activo`;
            BASE_FREE_TRACKS.forEach((t) => owned.add(t));
            localStorage.setItem(OWNED_KEY, JSON.stringify(Array.from(owned)));
            renderPlanner();
            return;
          }
        } catch { /* ignore */ }
        detectMmtBtn.textContent = "⚠ Abre MMT Sync para detectar";
        setTimeout(() => { detectMmtBtn.textContent = "⚡ Detectar MMT Sync"; }, 3000);
      });

      toggleBtn.addEventListener("click", () => {
        const nextHidden = !panel.hidden;
        panel.hidden = nextHidden;
        toggleBtn.classList.toggle("is-on", !nextHidden);
        toggleBtn.setAttribute("aria-expanded", String(!nextHidden));
        if (!nextHidden) renderPlanner();
      });

      function matchesScope(cats: string[], scope: string): boolean {
        if (scope === "ALL") return true;
        if (scope === "ROAD" || scope === "ENDURANCE") {
          return cats.includes("SPORTS CAR") || cats.includes("FORMULA CAR");
        }
        return cats.includes(scope);
      }

      function renderPlanner() {
        syncCalendarOwnershipColors();
        const cards = Array.from(document.querySelectorAll<HTMLElement>("#calGrid .cal-card"));
        let favIds = new Set<string>();
        try {
          favIds = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || "[]").map(String));
        } catch { /* ignore */ }

        const ownedLower = new Set(Array.from(owned).map((t) => t.toLowerCase()));
        const isTrackOwned = (name: string) => ownedLower.has(name.toLowerCase());
        const isTrackFree = (name: string) => freeTrackSet.has(name.toLowerCase());

        const targetCards = favIds.size > 0
          ? cards.filter((c) => favIds.has(c.dataset.id || ""))
          : cards.slice(0, 6);

        // Resolve discipline scope for historical recommendations
        let effectiveScope = scopeSelect?.value || "AUTO";
        if (effectiveScope === "AUTO") {
          if (activeCalendarCat !== "ALL") {
            effectiveScope = activeCalendarCat;
          } else if (favIds.size > 0) {
            const favCats = new Set(targetCards.map((c) => c.dataset.cat || "SPORTS CAR"));
            effectiveScope = favCats.size === 1 ? Array.from(favCats)[0] : "ALL";
          } else {
            effectiveScope = "ROAD";
          }
        }

        const weekCoverage = new Array<boolean>(12).fill(false);
        const selectedWeeksMap = new Map<string, number>();
        const carRoiMap = new Map<string, { car: string; seriesCount: number; isSpecial: boolean }>();

        targetCards.forEach((card) => {
          const isEndu = card.dataset.endurance === "1";
          let cardCars: string[] = [];
          try {
            cardCars = JSON.parse(card.dataset.cars || "[]");
          } catch { /* ignore */ }
          cardCars.forEach((carName) => {
            const cleanCar = String(carName || "").trim();
            if (!cleanCar || ownedCars.has(cleanCar)) return;
            const curCar = carRoiMap.get(cleanCar) ?? { car: cleanCar, seriesCount: 0, isSpecial: isEndu };
            curCar.seriesCount += 1;
            if (isEndu) curCar.isSpecial = true;
            carRoiMap.set(cleanCar, curCar);
          });

          card.querySelectorAll<HTMLElement>("[data-week-num]").forEach((li) => {
            const w = Number(li.dataset.weekNum || 0);
            const trackName = (li.querySelector(".cal-week__track")?.textContent || "").trim();
            if (!trackName || w < 1 || w > 12) return;
            const hasIt = isTrackOwned(trackName) || isTrackFree(trackName) || cart.has(trackName);
            if (hasIt) weekCoverage[w - 1] = true;
            if (!isTrackOwned(trackName) && !isTrackFree(trackName)) {
              const key = trackName.toLowerCase();
              selectedWeeksMap.set(key, (selectedWeeksMap.get(key) ?? 0) + 1);
            }
          });
        });

        // If all favorite cars are owned, fall back to popular multi-series cars across all S4 series
        if (carRoiMap.size < 4) {
          cards.slice(0, 40).forEach((card) => {
            const isEndu = card.dataset.endurance === "1";
            let cardCars: string[] = [];
            try { cardCars = JSON.parse(card.dataset.cars || "[]"); } catch {}
            cardCars.forEach((carName) => {
              const cleanCar = String(carName || "").trim();
              if (!cleanCar || ownedCars.has(cleanCar) || BASE_FREE_CARS.includes(cleanCar)) return;
              const curCar = carRoiMap.get(cleanCar) ?? { car: cleanCar, seriesCount: 0, isSpecial: isEndu };
              curCar.seriesCount += 1;
              if (isEndu) curCar.isSpecial = true;
              carRoiMap.set(cleanCar, curCar);
            });
          });
        }

        const coveredCount = weekCoverage.filter(Boolean).length;
        if (weeksCoveredEl) {
          weeksCoveredEl.textContent = `${coveredCount}/12 semanas ${coveredCount >= 8 ? "✓ Participation Credits OK" : `(faltan ${8 - coveredCount} para 8/12)`}`;
        }
        if (matrixEl) {
          matrixEl.innerHTML = weekCoverage
            .map((ok, idx) => `<div class="h-7 rounded flex items-center justify-center font-bold border ${ok ? "bg-emerald-500/20 border-emerald-500/40 text-emerald-600 dark:text-emerald-300" : "bg-rose-500/10 border-rose-500/30 text-rose-600 dark:text-rose-300"}">S${idx + 1}</div>`)
            .join("");
        }

        // Build unified multi-season paid track recommendations (never runs dry!)
        interface RecommendedTrack {
          track: string;
          selectedWeeks: number;
          s4Series: number;
          s3Series: number;
          specialEvents: string[];
          score: number;
        }

        const allCandidates: RecommendedTrack[] = [];
        for (const meta of trackCatalog) {
          if (meta.isFree || isTrackOwned(meta.track)) continue;
          const selW = selectedWeeksMap.get(meta.track.toLowerCase()) ?? 0;
          if (selW === 0 && !matchesScope(meta.cats, effectiveScope)) continue;
          const totalMultiSeason = meta.s4Series + meta.s3Series;
          const specialBonus = meta.specialEvents.length * 10;
          const score = selW * 16 + totalMultiSeason * 1.5 + specialBonus;
          allCandidates.push({
            track: meta.track,
            selectedWeeks: selW,
            s4Series: meta.s4Series,
            s3Series: meta.s3Series,
            specialEvents: meta.specialEvents,
            score,
          });
        }

        allCandidates.sort((a, b) => b.score - a.score || (b.s4Series + b.s3Series) - (a.s4Series + a.s3Series));
        const hasSelectedNeeds = allCandidates.some((c) => c.selectedWeeks > 0);
        const shownRoi = allCandidates.slice(0, roiLimit);

        if (resetOwnedBtn) {
          const paidOwnedCount = Array.from(owned).filter((t) => !isTrackFree(t)).length;
          resetOwnedBtn.hidden = paidOwnedCount === 0;
        }

        if (roiModeEl) {
          const scopeLabel = effectiveScope === "ROAD" ? "Road (GT + Fórmula)" : effectiveScope === "ALL" ? "Todas las disciplinas" : effectiveScope;
          roiModeEl.textContent = hasSelectedNeeds
            ? `Priorizando tus series + historial 2026 S3/S4 (${scopeLabel})`
            : `📈 Tus series cubiertas · Recomendando mejores compras históricas 2026 S3 + S4 + Special Events (${scopeLabel})`;
        }

        if (roiListEl) {
          if (shownRoi.length === 0) {
            roiListEl.innerHTML = `<div class="sm:col-span-2 p-3 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg)] text-xs font-mono text-[var(--r-muted)]">¡Increíble! Ya tienes marcados todos los circuitos de pago de esta disciplina. Cambia el filtro a "Todas las disciplinas" para ver más recomendaciones.</div>`;
          } else {
            roiListEl.innerHTML = shownRoi.map((item, i) => {
              const inCart = cart.has(item.track);
              const esc = item.track.replace(/"/g, "&quot;");
              const parts: string[] = [];
              if (item.selectedWeeks > 0) parts.push(`<span class="text-[var(--r-accent)] font-bold">+${item.selectedWeeks} sem. ahora</span>`);
              parts.push(`S4: ${item.s4Series} · S3: ${item.s3Series} series`);
              const evBadge = item.specialEvents.length > 0
                ? `<div class="text-[10px] text-amber-600 dark:text-amber-300 font-bold truncate mt-0.5">🏆 ${item.specialEvents.slice(0, 2).join(" · ")}</div>`
                : "";
              return `
                <div class="p-2.5 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg)] flex items-center justify-between gap-2 text-xs font-mono">
                  <div class="min-w-0">
                    <div class="font-bold text-[var(--r-text)] truncate">${i + 1}º ${item.track}</div>
                    <div class="text-[10px] text-[var(--r-muted)] truncate">${parts.join(" · ")}</div>
                    ${evBadge}
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    <button type="button" data-own-track="${esc}" class="px-2 py-1 rounded border border-[var(--r-line)] text-[10px] text-[var(--r-muted)] hover:text-[var(--r-accent)] hover:border-[var(--r-accent)] cursor-pointer">Tengo</button>
                    <button type="button" data-cart-track="${esc}" class="px-2 py-1 rounded border text-[10px] font-bold cursor-pointer ${inCart ? "border-rose-500/50 text-rose-500" : "border-[var(--r-accent)] text-[var(--r-accent)]"}">${inCart ? "Quitar" : "+ Carrito"}</button>
                  </div>
                </div>
              `;
            }).join("");

            roiListEl.querySelectorAll<HTMLButtonElement>("[data-cart-track]").forEach((btn) => {
              btn.addEventListener("click", () => {
                const t = btn.dataset.cartTrack || "";
                if (cart.has(t)) cart.delete(t);
                else cart.add(t);
                localStorage.setItem(CART_KEY, JSON.stringify(Array.from(cart)));
                renderPlanner();
              });
            });
            roiListEl.querySelectorAll<HTMLButtonElement>("[data-own-track]").forEach((btn) => {
              btn.addEventListener("click", () => {
                const t = btn.dataset.ownTrack || "";
                owned.add(t);
                cart.delete(t);
                localStorage.setItem(OWNED_KEY, JSON.stringify(Array.from(owned)));
                localStorage.setItem(CART_KEY, JSON.stringify(Array.from(cart)));
                renderPlanner();
              });
            });
          }
        }

        if (roiMoreWrap && roiCountInfoEl && roiMoreBtn) {
          const remaining = Math.max(0, allCandidates.length - shownRoi.length);
          roiMoreWrap.hidden = allCandidates.length <= 8;
          roiCountInfoEl.textContent = `Mostrando ${shownRoi.length} de ${allCandidates.length} circuitos de pago recomendables`;
          roiMoreBtn.hidden = remaining === 0;
          if (remaining > 0) {
            roiMoreBtn.textContent = `Ver +${Math.min(8, remaining)} circuitos (${remaining} restantes) ↓`;
          }
        }

        if (carRoiListEl) {
          const topCars = Array.from(carRoiMap.values())
            .sort((a, b) => (b.seriesCount + (b.isSpecial ? 2 : 0)) - (a.seriesCount + (a.isSpecial ? 2 : 0)))
            .slice(0, 6);
          carRoiListEl.innerHTML = topCars.map((item, i) => {
            const inCart = cartCars.has(item.car);
            const esc = item.car.replace(/"/g, "&quot;");
            return `
              <div class="p-2.5 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg)] flex items-center justify-between gap-2 text-xs font-mono">
                <div class="min-w-0">
                  <div class="font-bold text-[var(--r-text)] truncate">${i + 1}º ${item.car}</div>
                  <div class="text-[10px] text-[var(--r-muted)]">Válido en ${item.seriesCount} ${item.seriesCount === 1 ? "serie" : "series"}${item.isSpecial ? " · Special Event" : ""}</div>
                </div>
                <div class="flex items-center gap-1 shrink-0">
                  <button type="button" data-own-car="${esc}" class="px-2 py-1 rounded border border-[var(--r-line)] text-[10px] text-[var(--r-muted)] hover:text-[var(--r-accent)] cursor-pointer">Tengo</button>
                  <button type="button" data-cart-car="${esc}" class="px-2 py-1 rounded border text-[10px] font-bold cursor-pointer ${inCart ? "border-rose-500/50 text-rose-500" : "border-[var(--r-accent)] text-[var(--r-accent)]"}">${inCart ? "Quitar" : "+ Carrito"}</button>
                </div>
              </div>
            `;
          }).join("");

          carRoiListEl.querySelectorAll<HTMLButtonElement>("[data-cart-car]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const c = btn.dataset.cartCar || "";
              if (cartCars.has(c)) cartCars.delete(c);
              else cartCars.add(c);
              localStorage.setItem(CART_CARS_KEY, JSON.stringify(Array.from(cartCars)));
              renderPlanner();
            });
          });
          carRoiListEl.querySelectorAll<HTMLButtonElement>("[data-own-car]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const c = btn.dataset.ownCar || "";
              ownedCars.add(c);
              cartCars.delete(c);
              localStorage.setItem(OWNED_CARS_KEY, JSON.stringify(Array.from(ownedCars)));
              localStorage.setItem(CART_CARS_KEY, JSON.stringify(Array.from(cartCars)));
              renderPlanner();
            });
          });
        }

        const totalCartItems = cart.size + cartCars.size;

        // "Qué podrás correr con tu contenido + carrito"
        const playableCountEl = document.getElementById("plannerPlayableCount");
        const playableListEl = document.getElementById("plannerPlayableList");
        const ownedPlusCartTracks = new Set([...owned, ...cart, ...BASE_FREE_TRACKS]);
        const ownedPlusCartCars = new Set([...ownedCars, ...cartCars]);
        const playableSeries: Array<{ name: string; weeksReady: number }> = [];
        cards.forEach((card) => {
          const title = (card.querySelector("[data-title-garage]")?.textContent || "").trim();
          let cList: string[] = [];
          try { cList = JSON.parse(card.dataset.cars || "[]"); } catch {}
          const hasCar = cList.some((c) => ownedPlusCartCars.has(c));
          if (!hasCar) return;
          let weeksReady = 0;
          card.querySelectorAll<HTMLElement>("[data-week-num]").forEach((li) => {
            const trk = (li.querySelector(".cal-week__track")?.textContent || "").trim();
            if (trk && ownedPlusCartTracks.has(trk)) weeksReady++;
          });
          if (weeksReady > 0 && title) {
            playableSeries.push({ name: title, weeksReady });
          }
        });
        if (playableCountEl) {
          playableCountEl.textContent = `${playableSeries.length} ${playableSeries.length === 1 ? "serie desbloqueada" : "series desbloqueadas"}`;
        }
        if (playableListEl) {
          playableListEl.innerHTML = playableSeries.length === 0
            ? `<span class="text-[var(--r-muted)]">Pulsa "✔ Base Gratis iRacing" o añade 1 coche y 1 circuito al carrito para ver qué series puedes correr.</span>`
            : playableSeries.slice(0, 8).map((s) =>
                `<span class="px-2 py-1 rounded-lg border border-emerald-500/35 bg-emerald-500/10 text-[var(--r-text)] font-semibold">✓ ${s.name} (${s.weeksReady}/12 sem.)</span>`
              ).join("");
        }
        if (cartItemsEl) {
          if (totalCartItems === 0) {
            cartItemsEl.innerHTML = `<p class="text-[var(--r-muted)]">Añade circuitos o coches recomendados para simular tu pack con descuento.</p>`;
          } else {
            const trackRows = Array.from(cart).map((t) => `
              <div class="flex items-center justify-between gap-2 py-1 border-b border-[var(--r-line)]/40">
                <span class="truncate text-[var(--r-text)]">🏁 ${t}</span>
                <span class="text-[var(--r-muted)] shrink-0">$14.95</span>
              </div>
            `);
            const carRows = Array.from(cartCars).map((c) => `
              <div class="flex items-center justify-between gap-2 py-1 border-b border-[var(--r-line)]/40">
                <span class="truncate text-[var(--r-text)]">🏎 ${c}</span>
                <span class="text-[var(--r-muted)] shrink-0">$11.95</span>
              </div>
            `);
            cartItemsEl.innerHTML = [...trackRows, ...carRows].join("");
          }
        }

        const ownedCount = club40Chk?.checked ? 40 : (owned.size + ownedCars.size);
        const credits = Number(creditsInput?.value || 0);
        const profileId = taxSelect?.value || "es";
        const ck = calculateCheckout(cart.size, cartCars.size, ownedCount, credits, profileId);

        if (upsellEl) {
          upsellEl.hidden = !ck.upsellHint;
          if (ck.upsellHint) upsellEl.textContent = ck.upsellHint;
        }

        if (ticketEl) {
          ticketEl.innerHTML = `
            <div class="flex justify-between text-[var(--r-muted)]"><span>Subtotal (${totalCartItems} piezas)</span><span>$${ck.subtotalUsd.toFixed(2)}</span></div>
            <div class="flex justify-between text-emerald-600 dark:text-emerald-400"><span>Dto. Volumen (${ck.discountLabel})</span><span>-$${ck.discountUsd.toFixed(2)}</span></div>
            ${ck.creditsUsedUsd > 0 ? `<div class="flex justify-between text-sky-600 dark:text-sky-400"><span>Participation Credits</span><span>-$${ck.creditsUsedUsd.toFixed(2)}</span></div>` : ""}
            <div class="flex justify-between text-[var(--r-muted)]"><span>Base Imponible</span><span>$${ck.taxableBaseUsd.toFixed(2)}</span></div>
            <div class="flex justify-between text-[var(--r-muted)]"><span>${ck.taxName}</span><span>+$${ck.taxUsd.toFixed(2)}</span></div>
            <div class="flex justify-between text-sm font-black text-[var(--r-text)] pt-1 border-t border-[var(--r-line)]"><span>TOTAL REAL (USD)</span><span class="text-[var(--r-accent)]">$${ck.totalUsd.toFixed(2)}</span></div>
            <div class="text-right text-[11px] font-bold text-[var(--r-text)]">≈ ${ck.localAmountFormatted} ${ck.localCurrency}</div>
            <p class="text-[9.5px] text-[var(--r-muted)] leading-tight pt-1">Conversión orientativa; el tipo de cambio final depende de Steam o de tu tarjeta/PayPal.</p>
          `;
        }
      }

      function syncCalendarOwnershipColors() {
        const ownedLower = new Set(Array.from(owned).map((t) => t.toLowerCase()));
        document.querySelectorAll<HTMLLIElement>("#calGrid .cal-week[data-track]").forEach((li) => {
          const trk = (li.dataset.track || "").trim();
          if (!trk) return;
          const low = trk.toLowerCase();
          const has = ownedLower.has(low) || freeTrackSet.has(low);
          li.classList.toggle("is-owned", has);
          li.classList.toggle("is-missing", !has);
          const dot = li.querySelector<HTMLElement>(".cal-own-dot");
          if (dot) dot.title = has ? `${trk}: Comprado / Base (clic para cambiar)` : `${trk}: Falta comprar (clic para marcar como comprado)`;
        });
      }

      document.getElementById("calGrid")?.addEventListener("click", (e) => {
        const dot = (e.target as HTMLElement | null)?.closest<HTMLElement>("[data-toggle-track]");
        if (!dot) return;
        e.preventDefault();
        e.stopPropagation();
        const trk = (dot.dataset.toggleTrack || "").trim();
        if (!trk) return;
        const low = trk.toLowerCase();
        let existingKey: string | null = null;
        owned.forEach((v) => { if (v.toLowerCase() === low) existingKey = v; });
        if (existingKey) {
          owned.delete(existingKey);
        } else {
          owned.add(trk);
          cart.delete(trk);
        }
        localStorage.setItem(OWNED_KEY, JSON.stringify(Array.from(owned)));
        localStorage.setItem(CART_KEY, JSON.stringify(Array.from(cart)));
        syncCalendarOwnershipColors();
        if (!panel.hidden) renderPlanner();
      });

      syncCalendarOwnershipColors();
      if (!panel.hidden) renderPlanner();
      window.addEventListener("mmt-planner-refresh", (ev: Event) => {
        const custom = ev as CustomEvent<{ cat?: string }>;
        if (custom?.detail?.cat) activeCalendarCat = custom.detail.cat;
        syncCalendarOwnershipColors();
        if (!panel.hidden) renderPlanner();
      });
    }
  </script>
</Layout>
