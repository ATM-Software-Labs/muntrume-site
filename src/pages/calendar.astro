---
import Layout from "../layouts/Layout.astro";
import schedule from "../../desktop/src/season_schedule_2026_s4.json";
import catalog from "../../public/assets/data/catalog_index.json";
import { TAX_PROFILES } from "../lib/iracing-store-planner";
import { buildTrackHistoricalCatalog } from "../data/iracing-track-roi";

const SEASON_START_MS = Date.UTC(2026, 8, 15);
const buildWeek = Math.max(1, Math.min(12, Math.floor((Date.now() - SEASON_START_MS) / 604_800_000) + 1));

const CAT_LABELS: Record<string, string> = {
  "SPORTS CAR": "Sports Car",
  "FORMULA CAR": "Formula Car",
  "OVAL": "Oval",
  "DIRT OVAL": "Dirt Oval",
  "DIRT ROAD": "Dirt Road",
};

const TIER_ORDER: Record<string, number> = {
  RClass: 1,
  DClass: 2,
  CClass: 3,
  BClass: 4,
  AClass: 5,
};

const TIER_LABELS: Record<string, string> = {
  RClass: "Rookie",
  DClass: "Class D",
  CClass: "Class C",
  BClass: "Class B",
  AClass: "Class A",
};

const TIER_COLORS: Record<string, string> = {
  RClass: "#ef4444",
  DClass: "#f97316",
  CClass: "#eab308",
  BClass: "#22c55e",
  AClass: "#3b82f6",
};

// Ranking aproximado de popularidad semanal en iRacing (menor = más popular)
const POPULARITY_RULES: Array<[RegExp, number]> = [
  [/^Global Mazda MX-5 Cup/i, 1],
  [/^GT3 Challenge Fixed/i, 2],
  [/^GT Sprint Series/i, 3],
  [/^IMSA iRacing Series by GO Fast/i, 4],
  [/^IMSA iRacing Series - Fixed/i, 5],
  [/^Ferrari 296 Challenge/i, 6],
  [/^Production Car Challenge/i, 7],
  [/^iRacing Porsche Cup by CONSPIT/i, 8],
  [/^iRacing Porsche Cup - Fixed/i, 9],
  [/^FIA F4/i, 10],
  [/^Formula C - Super Formula Lights by RSS/i, 11],
  [/^Formula C - Super Formula Lights - Fixed/i, 12],
  [/^GT4 Falken Tyre/i, 13],
  [/^Sports Car Challenge by Falken/i, 14],
  [/^BMW M2 Cup/i, 15],
  [/^Formula Vee/i, 16],
  [/^Formula 1600 Rookie/i, 17],
  [/^GT Endurance/i, 18],
  [/^IMSA Endurance/i, 19],
  [/^Ring Meister/i, 20],
  [/^Advanced Mazda/i, 21],
  [/^NASCAR Cup Series|^NASCAR Class A/i, 22],
  [/^NASCAR Xfinity|^NASCAR Class B/i, 23],
  [/^NASCAR Craftsman|^NASCAR Class C/i, 24],
  [/^ARCA/i, 25],
  [/^Draft Master/i, 26],
  [/^Super Formula/i, 27],
  [/^IndyCar/i, 28],
];

function popularityRank(name: string, tier: string): number {
  for (const [rx, score] of POPULARITY_RULES) {
    if (rx.test(name)) return score;
  }
  return 100 + (TIER_ORDER[tier] ?? 9);
}

function isFixedSeries(name: string): boolean {
  return /fixed|rookie|mx-5 cup|bmw m2 cup|formula vee|formula 1600|ferrari 296 challenge|draft master|ring meister/i.test(name);
}

function isEnduranceSeries(name: string): boolean {
  return /endurance|24h|creventic|special/i.test(name);
}

const normStr = (s: string) =>
  (s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, " ").trim();
const normKey = (s: string) => normStr(s).replace(/\s+/g, "");

const CATALOG_CIRCUITS = catalog.circuits.map((c) => ({ raw: c, n: normStr(c) }));
const CATALOG_CARS = catalog.cars.map((c) => ({ id: c, n: normKey(c) }));

const CAR_ALIASES: Array<[RegExp, string]> = [
  [/porsche\s*911\s*gt3\s*cup/i, "porsche992cup"],
  [/porsche.*992\.?2/i, "porsche9922cup"],
  [/porsche\s*911\s*gt3\s*r\s*\(992\)/i, "porsche992rgt3"],
  [/aston\s*martin\s*vantage\s*gt3/i, "amvantageevogt3"],
  [/aston\s*martin\s*vantage\s*gt4/i, "amvantagegt4"],
  [/aston\s*martin.*valkyrie/i, "amvalkyriegtp"],
  [/mercedes[-\s]*amg\s*gt3/i, "mercedesamggt3"],
  [/mercedes[-\s]*amg\s*gt4/i, "mercedesamggt4"],
  [/mercedes[-\s]*amg\s*w13/i, "mercedesw13"],
  [/super\s*formula\s*lights/i, "superformulalights324"],
  [/super\s*formula\s*sf23.*honda/i, "superformulasf23 honda"],
  [/super\s*formula\s*sf23.*toyota/i, "superformulasf23 toyota"],
  [/indy\s*pro\s*2000/i, "indypropm18"],
  [/dallara\s*ir18/i, "dallarair18"],
  [/dallara\s*ir-?01/i, "dallarair01"],
  [/dallara\s*f3/i, "dallaraf3"],
  [/formula\s*ir-?04|\bfia\s*f4\b/i, "formulair04"],
  [/formula\s*1600|ray\s*ff1600/i, "raygr22"],
  [/formula\s*vee/i, "formulavee"],
  [/skip\s*barber/i, "rt2000"],
  [/mx-?5\s*cup/i, "mx5 cup"],
  [/toyota\s*gr86/i, "toyotagr86"],
  [/bmw\s*m2\s*(?:racing|g87)/i, "bmwm2g87"],
  [/bmw\s*m2\s*cs/i, "bmwm2csr"],
  [/bmw\s*m4\s*gt3/i, "bmwm4gt3"],
  [/bmw\s*m4.*gt4/i, "bmwm4evogt4"],
  [/bmw\s*m\s*hybrid\s*v8/i, "bmwlmdh"],
  [/clio/i, "renaultcliocup"],
  [/caterham\s*academy/i, "caterham caterhamacademy"],
  [/caterham\s*420r/i, "caterham caterham420r"],
  [/radical\s*sr8/i, "radical sr8"],
  [/spec\s*racer\s*ford/i, "specracer"],
  [/lotus\s*79/i, "lotus79"],
  [/euro\s*nascar/i, "euronascar"],
  [/supercars\s*ford\s*mustang/i, "supercars fordmustanggen3"],
  [/supercars\s*chevrolet\s*camaro/i, "supercars chevycamarogen3"],
  [/legends\s*ford/i, "legends ford34c"],
  [/mini\s*stock/i, "ministock"],
  [/late\s*model\s*stock/i, "latemodel2023"],
  [/super\s*late\s*model/i, "superlatemodel"],
  [/modified\s*-\s*sk/i, "skmodified"],
  [/modified\s*-\s*nascar\s*whelen/i, "skmodified tour"],
  [/nascar\s*cup.*camaro/i, "stockcars chevycamarozl12022"],
  [/nascar\s*cup.*mustang/i, "stockcars fordmustang2022"],
  [/nascar\s*cup.*camry/i, "stockcars toyotacamry2022"],
  [/nascar\s*legends.*monte\s*carlo/i, "stockcars chevymontecarlo87"],
  [/nascar\s*legends.*thunderbird/i, "stockcars fordthunderbird87"],
  [/nascar\s*legends.*grand\s*prix/i, "stockcars pontiacgrandprix87"],
  [/nascar\s*legends.*lesabre/i, "stockcars buicklesabre87"],
  [/nascar\s*o'reilly.*camaro/i, "stockcars2 camaro2019"],
  [/nascar\s*o'reilly.*mustang/i, "stockcars2 mustang2019"],
  [/nascar\s*o'reilly.*supra/i, "stockcars2 supra2019"],
  [/nascar\s*truck\s*ford/i, "trucks fordf150"],
  [/nascar\s*truck\s*chevrolet/i, "trucks silverado"],
  [/nascar\s*truck\s*toyota/i, "trucks toyotatundra2022"],
  [/dirt\s*micro\s*sprint.*non-?winged/i, "dirtmicrosprint nonwinged"],
  [/dirt\s*micro\s*sprint.*winged/i, "dirtmicrosprint winged"],
  [/dirt\s*big\s*block/i, "dirtmodified bigblock"],
  [/dirt\s*358\s*modified/i, "dirtlatemodel 358"],
  [/dirt\s*sprint\s*car\s*-\s*360/i, "dirtsprint winged 360"],
  [/dirt\s*sprint\s*car\s*-\s*410/i, "dirtsprint winged 410"],
  [/dirt\s*ump\s*modified/i, "dirtumpmod"],
  [/dirt\s*late\s*model\s*-\s*(?:super|pro)/i, "dirtlatemodel 438"],
  [/dirt\s*late\s*model\s*-\s*limited/i, "dirtlatemodel 358"],
];

function resolveSeriesCarIds(cars: string[], seriesName: string): string[] {
  const found = new Set<string>();
  const joinedCars = (cars || []).join(" ");
  const inputs = [...(cars || []), joinedCars, seriesName];
  for (const raw of inputs) {
    for (const [rx, id] of CAR_ALIASES) {
      if (rx.test(raw) && catalog.cars.includes(id)) found.add(id);
    }
    const nk = normKey(raw);
    if (!nk || nk.length < 4) continue;
    for (const c of CATALOG_CARS) {
      if (nk === c.n || nk.includes(c.n) || (c.n.length >= 6 && c.n.includes(nk))) {
        found.add(c.id);
      }
    }
  }
  return [...found];
}

function trackQuery(rawTrack: string): string {
  const t = rawTrack || "";
  if (/suzuka/i.test(t)) return "Suzuka";
  if (/fuji/i.test(t)) return "Fuji";
  if (/mans/i.test(t)) return "Le Mans";
  if (/long beach/i.test(t)) return "Long Beach";
  if (/panorama|bathurst/i.test(t)) return "Bathurst";
  if (/americas|cota/i.test(t)) return "COTA";
  if (/enzo e dino ferrari|imola/i.test(t)) return "Imola";
  if (/carlos pace|interlagos/i.test(t)) return "Interlagos";
  if (/gilles villeneuve|montreal/i.test(t)) return "Montreal";
  if (/magny-cours/i.test(t)) return "Magny Cours";
  if (/gateway/i.test(t)) return "Gateway";
  if (/hermanos rodr/i.test(t)) return "Mexico";
  if (/n[uü]rburgring/i.test(t)) return "Nurburgring";
  if (/arag[oó]n/i.test(t)) return "Aragon";
  if (/barber/i.test(t)) return "Barber";
  if (/winton/i.test(t)) return "Winton";
  if (/kern/i.test(t)) return "Kern";
  if (/miami/i.test(t)) return "Miami";
  if (/virginia/i.test(t)) return "Virginia";
  if (/l[eé]denon/i.test(t)) return "Ledenon";
  if (/federated auto parts/i.test(t)) return "Federated Auto Parts";
  if (/nashville fairgrounds/i.test(t)) return "Nashville Fairgrounds";
  if (/nashville superspeedway/i.test(t)) return "Nashville Super";
  if (/the bend/i.test(t)) return "The Bend";
  if (/algarve|portim/i.test(t)) return "Algarve";
  if (/echopark/i.test(t)) return "Echopark";
  if (/st\.?\s*petersburg/i.test(t)) return "St. Petersburg";
  const nt = normStr(t);
  const hit = CATALOG_CIRCUITS.find((c) => nt === c.n || nt.includes(c.n) || c.n.includes(nt));
  if (hit) return hit.raw;
  return t.replace(/\s+(International Racing Course|International Speedway|Street Circuit|Circuit|Raceway|Motorsports Park).*$/i, "").trim();
}

function buildGarageHref(carIds: string[], trackQ: string): string {
  const p = new URLSearchParams();
  if (carIds.length === 1) p.set("car", carIds[0]);
  else if (carIds.length > 1) p.set("cars", carIds.join(","));
  if (trackQ) p.set("track", trackQ);
  const qs = p.toString();
  return qs ? `/garage/?${qs}` : "/garage/";
}

const cleanSeries = schedule.series
  .map((s) => {
    const cleanName = s.name.replace(/\s*-?\s*2026 Season.*$/i, "").trim();
    const cat = s.category || "SPORTS CAR";
    const tier = s.tier || "DClass";
    const fixed = isFixedSeries(cleanName);
    const endurance = isEnduranceSeries(cleanName);
    const pop = popularityRank(cleanName, tier);
    const carIds = resolveSeriesCarIds(s.cars ?? [], cleanName);
    return {
      id: s.id,
      name: cleanName,
      category: cat,
      categoryLabel: CAT_LABELS[cat] ?? cat,
      tier,
      tierRank: TIER_ORDER[tier] ?? 9,
      tierLabel: TIER_LABELS[tier] ?? tier,
      tierColor: TIER_COLORS[tier] ?? "#94a3b8",
      fixed,
      endurance,
      pop,
      carIds,
      cars: s.cars ?? [],
      weeks: (s.weeks ?? []).map((w) => {
        const trackQ = trackQuery(w.track_name);
        return {
          w: w.week_num,
          date: w.start_date,
          track: w.track_name,
          config: w.config ?? "",
          duration: w.duration ?? "",
          trackQ,
          href: buildGarageHref(carIds, trackQ),
        };
      }),
    };
  })
  .sort((a, b) => a.pop - b.pop || a.name.localeCompare(b.name));

const trackCatalog = buildTrackHistoricalCatalog(cleanSeries);

const catOrder = ["SPORTS CAR", "FORMULA CAR", "OVAL", "DIRT OVAL", "DIRT ROAD"];

const pageTitle = "Official iRacing 2026 Season 4 Schedule Planner";
const pageDescription = "Interactive iRacing 2026 Season 4 schedule planner (154 series · 12 weeks), filterable by popularity, license class, Fixed/Open, discipline, and owned content. MMT.";
const canonical = "https://muntru.me/calendar/";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonical}>
  <section class="r-section cal" aria-labelledby="calPageTitle">
    <div class="r-wrap">
      <header class="cal-head">
        <div>
          <p class="r-kicker">2026 SEASON 4 · <span id="calLiveWeek">SEMANA {buildWeek}</span></p>
          <h1 id="calPageTitle" class="r-h1">Calendario iRacing</h1>
        </div>
        <div class="cal-head-meta">
          <span id="calCount" class="cal-count">{cleanSeries.length} series</span>
          <a href="/calendar/special-events/" class="r-link">Special Events 2026 →</a>
          <a href="/garage/" class="r-link">Ir al Garage →</a>
        </div>
      </header>

      <div class="cal-bar" role="region" aria-label="Filtros y ordenación">
        <div class="cal-bar__row">
          <div class="cal-group">
            <button type="button" class="cal-chip" id="btnFavFilter" aria-pressed="false">★ Favoritas</button>
            <button type="button" class="cal-chip is-on" id="btnPlannerToggle" aria-expanded="true">🛒 Planificador &amp; Compras</button>
            <button type="button" class="cal-chip" id="btnReset">↺ Reset</button>
          </div>

          <label class="cal-search">
            <span class="sr-only">Buscar serie, coche o circuito</span>
            <input id="calSearch" type="search" placeholder="Buscar serie, coche o circuito…" autocomplete="off" />
          </label>

          <label class="cal-sort">
            <span>Ordenar</span>
            <select id="calSort">
              <option value="pop">Popularidad</option>
              <option value="tier-asc">Licencia (R → A)</option>
              <option value="tier-desc">Licencia (A → R)</option>
              <option value="name">Nombre (A–Z)</option>
            </select>
          </label>
        </div>

        <div class="cal-bar__row cal-bar__row--filters">
          <div class="cal-group" id="calCatPills" role="group" aria-label="Disciplina">
            <button type="button" class="cal-pill is-on" data-cat="ALL">Todas</button>
            {catOrder.map((c) => (
              <button type="button" class="cal-pill" data-cat={c}>{CAT_LABELS[c]}</button>
            ))}
            <button type="button" class="cal-pill" data-cat="ENDURANCE">Endurance</button>
          </div>

          <div class="cal-group" id="calSetupPills" role="group" aria-label="Setup">
            <button type="button" class="cal-pill is-on" data-setup="ALL">Open + Fixed</button>
            <button type="button" class="cal-pill" data-setup="OPEN">Open</button>
            <button type="button" class="cal-pill" data-setup="FIXED">Fixed</button>
          </div>

          <div class="cal-group" id="calTierPills" role="group" aria-label="Licencia">
            <button type="button" class="cal-pill is-on" data-tier="ALL">Todas</button>
            {Object.entries(TIER_LABELS).map(([k, lbl]) => (
              <button type="button" class="cal-pill cal-pill--tier" data-tier={k} style={`--tier:${TIER_COLORS[k]}`}>
                {lbl}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Prompt 111, 112 & 114: Planificador de Temporada, Volume Discounts y Simulador Fiscal -->
      <section id="calPlannerPanel" class="mb-6 rounded-2xl border border-[var(--r-line)] bg-[var(--r-surface)] p-5 space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--r-line)]">
          <div>
            <p class="text-[11px] font-mono uppercase tracking-widest text-[var(--r-accent)] font-bold">🛒 Planificador Inteligente · Volume Discounts + IVA</p>
            <h2 class="text-xl font-extrabold text-[var(--r-text)] font-display">Qué comprar y qué podrás correr</h2>
          </div>
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <button type="button" id="plannerMarkBaseBtn" class="h-8 px-2.5 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-[var(--r-accent)] hover:bg-emerald-500/20 font-bold cursor-pointer transition" title="Marca automáticamente circuitos y coches gratuitos incluidos en la suscripción base de iRacing">✔ Base Gratis iRacing</button>
            <button type="button" id="plannerDetectMmtBtn" class="h-8 px-2.5 rounded-lg border border-[var(--r-line)] bg-[var(--r-bg)] hover:border-[var(--r-accent)] text-[var(--r-text)] cursor-pointer transition" title="Comprueba si MMT Sync está abierto localmente">⚡ Detectar MMT Sync</button>
            <label class="flex items-center gap-1.5 text-[var(--r-muted)]">
              <span>🌍</span>
              <select id="plannerTaxSelect" class="h-8 rounded-lg border border-[var(--r-line)] bg-[var(--r-bg)] px-2 text-xs text-[var(--r-text)]">
                {TAX_PROFILES.map((tp) => (
                  <option value={tp.id}>{tp.label}</option>
                ))}
              </select>
            </label>
            <label class="flex items-center gap-1 text-[var(--r-muted)]" title="40+ piezas en propiedad = 20% dto. permanente">
              <input id="plannerClub40" type="checkbox" class="accent-[#00e699]" />
              <span>🏆 Club 40</span>
            </label>
            <label class="flex items-center gap-1 text-[var(--r-muted)]">
              <span>💳 $</span>
              <input id="plannerCreditsInput" type="number" min="0" max="40" step="1" value="0" class="w-12 h-8 rounded-lg border border-[var(--r-line)] bg-[var(--r-bg)] px-1.5 text-xs text-[var(--r-text)]" />
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
          <!-- Columna 1 & 2: Qué podrás correr + Matriz 12 Semanas + Top Circuitos & Coches -->
          <div class="lg:col-span-2 space-y-4">
            <div id="plannerPlayableBox" class="p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/[0.06] space-y-1.5 font-mono text-xs">
              <div class="flex items-center justify-between gap-2">
                <strong class="text-[var(--r-accent)]">🏁 Qué podrás correr con tu contenido + carrito</strong>
                <span id="plannerPlayableCount" class="text-[var(--r-accent)] font-bold">0 series esta semana</span>
              </div>
              <div id="plannerPlayableList" class="flex flex-wrap gap-1.5 text-[11px]"></div>
            </div>

            <div class="p-3.5 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg)] space-y-2.5">
              <div class="flex items-center justify-between text-xs font-mono">
                <strong class="text-[var(--r-text)]">📅 Cobertura 12 Semanas (8/12 = Credits)</strong>
                <span id="plannerWeeksCovered" class="text-[var(--r-accent)] font-bold">0/12 semanas</span>
              </div>
              <div id="plannerMatrix" class="grid grid-cols-6 sm:grid-cols-12 gap-1.5 font-mono text-[10px]"></div>
            </div>

            <div class="space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                <div>
                  <strong class="text-[var(--r-text)]">🏁 Circuitos Más Recomendables ($14.95)</strong>
                  <p id="plannerRoiMode" class="text-[10px] text-[var(--r-muted)] mt-0.5">Historial 2026 S3 + S4 · Special Events</p>
                </div>
                <div class="flex items-center gap-1.5">
                  <select id="plannerTrackScope" class="h-7 rounded-lg border border-[var(--r-line)] bg-[var(--r-bg)] px-2 text-[11px] text-[var(--r-text)] cursor-pointer" title="Filtrar recomendaciones por disciplina">
                    <option value="AUTO">Disciplina: Auto</option>
                    <option value="ROAD">Road (GT + Fórmula)</option>
                    <option value="SPORTS CAR">Sports Car</option>
                    <option value="FORMULA CAR">Formula Car</option>
                    <option value="OVAL">Oval</option>
                    <option value="DIRT OVAL">Dirt Oval</option>
                    <option value="DIRT ROAD">Dirt Road</option>
                    <option value="ALL">Todas las disciplinas</option>
                  </select>
                  <button type="button" id="plannerResetOwnedBtn" hidden class="h-7 px-2 rounded-lg border border-[var(--r-line)] text-[10px] text-[var(--r-muted)] hover:text-rose-500 cursor-pointer" title="Restablecer circuitos marcados como 'Tengo'">↺ Reset Tengo</button>
                </div>
              </div>
              <div id="plannerRoiList" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
              <div id="plannerRoiMoreWrap" hidden class="flex items-center justify-between pt-1 font-mono text-[11px]">
                <span id="plannerRoiCountInfo" class="text-[var(--r-muted)]"></span>
                <button type="button" id="plannerRoiMoreBtn" class="px-3 py-1.5 rounded-lg border border-[var(--r-line)] bg-[var(--r-bg)] hover:border-[var(--r-accent)] text-[var(--r-text)] font-bold cursor-pointer transition">Ver más circuitos recomendados ↓</button>
              </div>
            </div>

            <div class="space-y-2 pt-2 border-t border-[var(--r-line)]/50">
              <div class="flex items-center justify-between text-xs font-mono">
                <strong class="text-[var(--r-text)]">🏎 Top Coches Recomendados ($11.95)</strong>
                <span class="text-[var(--r-muted)]">Multi-serie · Special Events</span>
              </div>
              <div id="plannerCarRoiList" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
            </div>
          </div>

          <!-- Columna 3: Ticket Fiscal en Vivo -->
          <div class="p-4 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg)] flex flex-col justify-between gap-4 font-mono text-xs">
            <div class="space-y-3">
              <div class="flex items-center justify-between border-b border-[var(--r-line)] pb-2">
                <strong class="text-sm text-[var(--r-text)]">Carrito Simulado</strong>
                <button type="button" id="plannerClearCart" class="text-[11px] text-[var(--r-muted)] hover:text-rose-500 cursor-pointer">Vaciar</button>
              </div>
              <div id="plannerCartItems" class="space-y-1.5 max-h-40 overflow-y-auto text-[11px]"></div>
              <p id="plannerUpsellHint" hidden class="p-2 rounded-lg bg-amber-500/15 border border-amber-500/40 text-amber-600 dark:text-amber-300 text-[11px] leading-snug"></p>
