                    </li>
                  );
                })}
              </ol>

              <footer class="cal-card__foot">
                <span class="cal-card__cars" title={s.cars.join(" · ")}>
                  {s.cars.slice(0, 2).join(" · ")}{s.cars.length > 2 ? ` +${s.cars.length - 2}` : ""}
                </span>
                <a
                  class="cal-card__cta"
                  data-foot-garage
                  href={cur?.href ?? "/garage/"}
                >
                  Setups S{buildWeek} →
                </a>
              </footer>
            </article>
          );
        })}
      </div>

      <div id="calLoadMoreWrap" hidden class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <button type="button" id="calShowMoreBtn" class="cal-chip is-on" style="padding:10px 18px;font-size:13px;">Mostrar más series</button>
        <button type="button" id="calShowAllBtn" class="cal-chip" style="padding:10px 16px;font-size:13px;">Mostrar todas</button>
      </div>

      <p id="calEmptyState" class="r-empty" hidden>Ninguna serie coincide con los filtros actuales.</p>
    </div>
  </section>

