      <div class="cal-legend" aria-label="Leyenda de propiedad y semana actual">
        <span class="cal-legend__item"><span class="cal-legend__pill">S{buildWeek}</span> Semana actual</span>
        <span class="cal-legend__item"><span class="cal-legend__dot is-owned"></span> Comprado / Base</span>
        <span class="cal-legend__item"><span class="cal-legend__dot is-missing"></span> Falta comprar</span>
        <span class="cal-legend__hint">Clic en el punto de cualquier circuito para marcarlo como comprado</span>
      </div>

      <div id="calGrid" class="cal-grid">
        {cleanSeries.map((s) => {
          const cur = s.weeks.find((w) => w.w === buildWeek) ?? s.weeks[0];
          const searchBlob = `${s.name} ${s.categoryLabel} ${s.tierLabel} ${s.cars.join(" ")} ${s.weeks.map((w) => `${w.track} ${w.config}`).join(" ")}`.toLowerCase();
          return (
            <article
              class="cal-card"
              style={`--tier:${s.tierColor}`}
              data-id={s.id}
              data-name={s.name.toLowerCase()}
              data-cat={s.category}
              data-tier={s.tier}
              data-tier-rank={s.tierRank}
              data-pop={s.pop}
              data-setup={s.fixed ? "FIXED" : "OPEN"}
