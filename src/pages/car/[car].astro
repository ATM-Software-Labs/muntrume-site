---
import Layout from '../../layouts/Layout.astro';
import MediaLightbox from '../../components/MediaLightbox.astro';
import MediaCarousel from '../../components/MediaCarousel.astro';
import VideoModal from '../../components/VideoModal.astro';
import { CAR_CATALOG_LIST, type CarMetadata } from '../../../desktop/src/cars/catalog';
import { getBrandOrigin, getCarDossier } from '../../data/car-dossiers';
import { getCarVideos } from '../../lib/video-links';
import { getCarGallerySlides } from '../../lib/car-gallery';
import catalogIndex from '../../../public/assets/data/catalog_index.json';

export function getStaticPaths() {
  const seen = new Set<string>();
  const uniqueCars = CAR_CATALOG_LIST.filter((c) => {
    const slug = c.carFolder.toLowerCase();
    if (seen.has(slug)) return false;
    seen.add(slug);
    return true;
  });

  return uniqueCars.map((car) => ({
    params: { car: car.carFolder.toLowerCase() },
    props: { car },
  }));
}

interface Props {
  car: CarMetadata;
}

const { car } = Astro.props;
const brandSlug = car.brand
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');

const origin = getBrandOrigin(car.brand);
const dossier = getCarDossier(car);
const hasGarageSetups = (catalogIndex.cars as string[]).some(
  (c) => c.toLowerCase() === car.carFolder.toLowerCase(),
);

const carSlides = getCarGallerySlides(car);

const carVideos = getCarVideos(car.brand, car.model, car.carClass, car.carFolder);

const pageTitle = `${car.brand} ${car.model} · Ficha Técnica iRacing | Muntrume Motorsport`;
const pageDescription = `${car.brand} ${car.model} (${car.carClass}): ${dossier.headline}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`https://muntru.me/car/${car.carFolder.toLowerCase()}/`}
>
  <main class="r-wrap py-12 sm:py-16 space-y-10">
    <nav aria-label="Breadcrumb" class="r-kicker flex flex-wrap items-center gap-2">
      <a href="/paddock/" class="hover:text-[var(--r-accent)] transition">Paddock</a>
      <span>/</span>
      <a href={`/${brandSlug}/`} class="hover:text-[var(--r-accent)] transition">{car.brand}</a>
      <span>/</span>
      <span class="text-[var(--r-text)] font-bold">{car.model}</span>
    </nav>

    <!-- HERO DOSSIER -->
    <header class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border-b border-[var(--r-line)] pb-8">
      <div class="lg:col-span-6 space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-1 rounded-md bg-[var(--r-accent)]/15 border border-[var(--r-accent)]/40 text-[var(--r-accent)] text-xs font-mono font-bold uppercase">
            {car.carClass} · {car.category}
          </span>
          <span class="px-2.5 py-1 rounded-md bg-[var(--r-surface)] border border-[var(--r-line)] text-xs font-mono text-[var(--r-text)]">
            {origin.flag} {origin.country}
          </span>
          <button
            type="button"
            data-like-btn
            data-like-id={`car:${car.carFolder}`}
            class="px-2.5 py-1 rounded-md bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-rose-500/60 text-xs font-mono font-bold text-[var(--r-muted)] inline-flex items-center gap-1.5 transition cursor-pointer"
            title="Me gusta"
          >
            <span data-heart>♡</span>
            <span data-count>0</span>
          </button>
        </div>

        <h1 class="r-h2">
          {car.brand} {car.model}
        </h1>

        <p class="r-lead">
          {dossier.headline}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href={`/garage?car=${encodeURIComponent(car.carFolder)}`}
            class="r-btn r-btn--primary"
          >
            {hasGarageSetups ? 'Ver Setups (.sto) en Garage →' : 'Buscar en Garage →'}
          </a>
          <a
            href={car.manualUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="r-btn r-btn--ghost"
          >
            User Manual (PDF) ↗
          </a>
          <a
            href={car.forumUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="r-btn r-btn--ghost"
          >
            Car Forum ↗
          </a>
        </div>
      </div>

      <div class="lg:col-span-6">
        <button
          type="button"
          data-preview-src={carSlides[0]?.src || car.previewImg || ''}
          data-preview-title={`${car.brand} ${car.model}`}
          data-preview-sub={`${car.carClass} · ${origin.flag} ${origin.country} · ${car.specs}`}
          data-preview-id={`car:${car.carFolder}`}
          data-preview-setups={`/garage?car=${encodeURIComponent(car.carFolder)}`}
          class="relative block w-full aspect-[344/182] rounded-2xl bg-[#090d12] border border-[var(--r-line)] hover:border-[var(--r-accent)] overflow-hidden cursor-zoom-in group transition"
          title="Ampliar imagen completa"
        >
          <img
            src={car.previewImg || carSlides[0]?.src || '/assets/img/hero-bg.webp'}
            alt={`${car.brand} ${car.model}`}
            width="688"
            height="364"
            class="w-full h-full object-contain object-center transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-lg bg-black/80 border border-white/15 text-[11px] font-mono text-white/90">
            Ampliar foto completa ⤢
          </span>
        </button>
      </div>
    </header>

    <!-- FICHA TECNICA -->
    <section aria-label="Especificaciones de ingeniería" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="p-4 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] space-y-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--r-accent)]">Motorización</span>
        <p class="text-sm font-bold text-[var(--r-text)]">{dossier.powertrain}</p>
      </div>
      <div class="p-4 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] space-y-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--r-accent)]">Transmisión</span>
        <p class="text-sm font-bold text-[var(--r-text)]">{dossier.drivetrain}</p>
      </div>
      <div class="p-4 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] space-y-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--r-accent)]">Electrónica &amp; Ayudas</span>
        <p class="text-sm font-bold text-[var(--r-text)]">{dossier.electronics}</p>
      </div>
      <div class="p-4 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] space-y-1">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--r-accent)]">País &amp; Sede Técnica</span>
        <p class="text-sm font-bold text-[var(--r-text)]">{origin.flag} {origin.country}</p>
        <p class="text-[11px] font-mono text-[var(--r-muted)]">{origin.hq}</p>
      </div>
    </section>

    <!-- PILOTOS REALES + CURIOSIDADES + MEJORES VUELTAS -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-5 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] p-6 space-y-4">
        <div>
          <span class="r-kicker">Paddock Real · WEC, IMSA &amp; Histórica</span>
          <h2 class="text-xl font-extrabold text-[var(--r-text)] font-display mt-1">
            Pilotos reconocidos en la vida real
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {dossier.realDrivers.map((driver) => (
            <a
              href={driver.url}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-[var(--r-accent)] transition flex items-center justify-between gap-2 group"
              title={`Abrir biografía / Wikipedia de ${driver.name}`}
            >
              <div class="min-w-0">
                <div class="text-xs font-mono font-bold text-[var(--r-text)] group-hover:text-[var(--r-accent)] truncate">
                  {driver.name}
                </div>
                <div class="text-[10px] font-mono text-[var(--r-muted)] truncate">
                  {driver.series}
                </div>
              </div>
              <span class="text-[11px] font-mono text-[var(--r-accent)] shrink-0">↗</span>
            </a>
          ))}
        </div>
        <div class="pt-3 border-t border-[var(--r-line)] space-y-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--r-accent)]">Carpeta técnica iRacing</span>
          <p class="text-xs font-mono text-[var(--r-muted)]">
            ID de chasis: <strong class="text-[var(--r-text)]">{car.carFolder}</strong>
          </p>
        </div>
      </div>

      <div class="lg:col-span-7 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] p-6 space-y-4">
        <div>
          <span class="r-kicker">Ingeniería &amp; Historia</span>
          <h2 class="text-xl font-extrabold text-[var(--r-text)] font-display mt-1">
            Curiosidades y comportamiento en pista
          </h2>
        </div>
        <ul class="space-y-3 text-sm text-[var(--r-muted)] leading-relaxed">
          {dossier.curiosities.map((fact) => (
            <li class="p-3.5 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] text-[var(--r-text)]">
              {fact}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- MEJORES VUELTAS DE REFERENCIA -->
    <section class="rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] p-6 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="r-kicker">Telemetría &amp; Ritmo</span>
          <h2 class="text-xl font-extrabold text-[var(--r-text)] font-display mt-1">
            Mejores vueltas de referencia &amp; Benchmarks
          </h2>
        </div>
        <a href={`/${brandSlug}/`} class="r-link">
          Ver todos los {car.brand} →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {dossier.lapBenchmarks.map((b) => (
          <div class="p-4 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] space-y-1">
            <span class="text-xs font-mono text-[var(--r-muted)]">{b.track}</span>
            <div class="text-2xl font-extrabold font-mono text-[var(--r-accent)]">{b.lap}</div>
            <p class="text-[11px] font-mono text-[var(--r-muted)]">{b.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- GALERIA DE FOTOS INTERACTIVA (AUTO-CAROUSEL) -->
    <section aria-label="Galería interactiva del vehículo" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-2 border-b border-[var(--r-line)]">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--r-accent)]">Galería propia interactiva</span>
          <h2 class="r-h3">Galería fotográfica · {car.brand} {car.model}</h2>
        </div>
        <span class="text-xs font-mono text-[var(--r-muted)]">
          Carrusel automático todo en uno · Pausa al pasar el ratón · Haz clic para ampliar en HD
        </span>
      </div>

      <MediaCarousel
        id={`car-${car.carFolder.toLowerCase()}`}
        slides={carSlides}
        intervalMs={4500}
        aspectRatioClass="aspect-[16/9]"
      />
    </section>

    <!-- VIDEOS OFICIALES & COMUNIDAD -->
    <section aria-label="Vídeos y onboards del vehículo" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-2 border-b border-[var(--r-line)]">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--r-accent)]">Onboard &amp; Streaming</span>
          <h2 class="r-h3">Vídeos oficiales y onboard en pista (iRacing &amp; Comunidad)</h2>
        </div>
        <a
          href="https://www.youtube.com/@iracing/videos"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono font-bold text-[var(--r-accent)] hover:underline flex items-center gap-1"
        >
          <span>Canal Oficial de iRacing</span>
          <span>↗</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {carVideos.map((vid) => (
          <div class="rounded-2xl overflow-hidden border border-[var(--r-line)] bg-[var(--r-surface)] hover:border-[var(--r-accent)] transition-all duration-300 flex flex-col justify-between shadow-sm hover:shadow-md group">
            <div>
              <div
                class="relative aspect-[16/9] bg-[#090d12] overflow-hidden cursor-pointer"
                data-video-id={vid.videoId}
                data-video-title={vid.title}
                data-video-channel={vid.channel}
                role="button"
                tabindex="0"
                aria-label={`Reproducir vídeo: ${vid.title}`}
              >
                <img
                  src={vid.thumbnail}
                  alt={vid.title}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-black/30"></div>

                <div class="absolute top-2.5 left-2.5 flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded-md bg-red-600/90 text-white font-mono text-[10px] font-bold flex items-center gap-1">
                    <svg class="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    YouTube
                  </span>
                  <span class="px-2 py-0.5 rounded-md bg-black/75 border border-white/15 text-[var(--r-accent)] text-[10px] font-mono font-bold uppercase">
                    {vid.badge}
                  </span>
                </div>

                {vid.duration && (
                  <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded bg-black/85 text-white text-[10px] font-mono">
                    {vid.duration}
                  </span>
                )}

                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="w-12 h-12 rounded-full bg-red-600/90 group-hover:bg-red-600 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5 fill-current ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </div>
              </div>

              <div class="p-4 space-y-1.5">
                <span class="text-[10px] font-mono text-[var(--r-muted)] uppercase tracking-wider block">
                  {vid.channel}
                </span>
                <h3
                  class="text-sm font-bold text-[var(--r-text)] group-hover:text-[var(--r-accent)] transition-colors line-clamp-2 cursor-pointer"
                  data-video-id={vid.videoId}
                  data-video-title={vid.title}
                  data-video-channel={vid.channel}
                >
                  {vid.title}
                </h3>
                <p class="text-xs text-[var(--r-muted)] line-clamp-2 leading-relaxed">
                  {vid.desc}
                </p>
              </div>
            </div>

            <div class="px-4 pb-4 pt-2 border-t border-[var(--r-line)] flex items-center justify-between text-xs font-mono font-bold">
              <button
                type="button"
                data-video-id={vid.videoId}
                data-video-title={vid.title}
                data-video-channel={vid.channel}
                class="text-[var(--r-text)] hover:text-[var(--r-accent)] transition flex items-center gap-1.5 cursor-pointer"
              >
                <span>▶ Reproducir</span>
              </button>
              <a
                href={vid.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--r-accent)] hover:underline flex items-center gap-1"
                title="Abrir directamente en YouTube"
              >
                <span>Ver en YouTube</span>
                <span class="group-hover:translate-x-0.5 transition-transform">↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
  <MediaLightbox />
  <VideoModal />
</Layout>
