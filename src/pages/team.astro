---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Official Drivers Roster · Muntrume Motorsport";
const pageDescription = "Meet the four official drivers of Muntrume Motorsport, an elite iRacing sim racing team based in Barcelona.";
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- ========================================================================= -->
  <!-- 1. HERO: DRIVER ROSTER & SQUAD OVERVIEW                                    -->
  <!-- ========================================================================= -->
  <section class="pt-28 pb-12 bg-[#0e1217] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Status Strip -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-8 border-b border-white/10 text-xs">
        <div class="flex items-center gap-3">
          <span class="px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-semibold uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Official Lineup · 4 Drivers
          </span>
          <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300 font-mono text-[11px]">
            iRacing Esports Division
          </span>
        </div>
        <div class="flex items-center gap-3 text-neutral-400 font-mono text-xs">
          <span>Sant Andreu · Barcelona, CAT</span>
        </div>
      </div>

      <div class="text-center py-6 max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-emerald-400 text-xs font-semibold mb-4">
          <span>🏁 Competition Roster</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white mb-4">
          TEAM <span class="text-emerald-400">DRIVERS</span>
        </h1>
        <p class="text-sm sm:text-base text-neutral-400 leading-relaxed">
          Los cuatro pilotos oficiales de Muntrume Motorsport en activo para las competiciones de resistencia en prototipos GTP, GT3 y campeonatos de monoplazas en iRacing.
        </p>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. DRIVERS DIRECTORY: SPACIOUS LUXURY MOTORSPORT CARDS                     -->
  <!-- ========================================================================= -->
  <section id="drivers" class="py-16 bg-[#0e1217]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Category Filter Pills (Generous, Touch-Friendly) -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-white/10">
        <div class="flex flex-wrap items-center gap-2" id="rosterFilterTabs">
          <button data-filter="all" class="team-filter-pill active px-4 py-2 rounded-xl text-xs font-bold transition bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 cursor-pointer">
            Todos los Pilotos (4)
          </button>
          <button data-filter="gtp" class="team-filter-pill px-4 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer">
            GTP Prototypes
          </button>
          <button data-filter="gt3" class="team-filter-pill px-4 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer">
            GT3 Endurance
          </button>
          <button data-filter="formula" class="team-filter-pill px-4 py-2 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white bg-white/5 border border-white/10 hover:border-white/20 cursor-pointer">
            Monoplazas &amp; SFL
          </button>
        </div>

        <div class="text-xs font-mono text-neutral-500">
          Plantilla Homologada 2026
        </div>
      </div>

      <!-- Drivers Grid (Spacious 2 Columns on Laptop / Tablet, 4 Columns on XL) -->
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-8" id="driversGrid">
        
        <!-- DRIVER 1: Alberto Trujillo -->
        <article class="driver-card bg-[#161c24] border border-emerald-500/30 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden group hover:border-emerald-500 transition-all duration-300" data-categories="gtp gt3">
          <div class="space-y-5">
            <!-- Top Card Header: Number & Role Badge -->
            <div class="flex items-center justify-between">
              <span class="text-lg font-black text-white font-mono">#1</span>
              <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 uppercase tracking-wider">
                FOUNDER
              </span>
            </div>
            
            <!-- Driver Avatar -->
            <div class="text-center pt-2">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-emerald-500/20 to-emerald-950/60 border-2 border-emerald-500/40 flex items-center justify-center mx-auto shadow-xl group-hover:scale-105 group-hover:border-emerald-400 transition-all">
                <span class="font-black text-3xl text-emerald-400 tracking-wider font-mono">AT</span>
              </div>
              <h2 class="text-xl font-black text-white mt-4 tracking-tight">Alberto Trujillo</h2>
              <p class="text-xs text-emerald-400 font-bold uppercase tracking-wider mt-1">Team Principal &amp; Telemetría</p>
            </div>

            <!-- Bio / Specialty -->
            <p class="text-xs text-neutral-300 leading-relaxed text-center min-h-[48px]">
              Especialista en dinámica vehicular, análisis de telemetría a 60 Hz y estrategia en pruebas de resistencia de 24 horas.
            </p>
            
            <!-- Hardware Specs Strip -->
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-[11px] font-mono text-neutral-400 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Coches:</span>
                <span class="text-white font-bold text-right truncate">Valkyrie GTP · 296 GT3</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Rig:</span>
                <span class="text-emerald-400 font-bold text-right truncate">DD 25Nm · Loadcell</span>
              </div>
            </div>

            <!-- Category Pills -->
            <div class="flex flex-wrap justify-center gap-1.5 pt-1">
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">GTP Prototype</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">GT3 Endurance</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">24H Le Mans</span>
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="pt-6">
            <a href="/p/alberto-trujillo/" class="w-full py-3 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 text-xs font-black uppercase tracking-wider rounded-xl transition shadow-lg shadow-emerald-500/20 inline-flex items-center justify-center gap-2">
              <span>Ver Ficha y Telemetría</span>
              <span class="text-base">&rarr;</span>
            </a>
          </div>
        </article>

        <!-- DRIVER 2: Mateo Berbis -->
        <article class="driver-card bg-[#161c24] border border-amber-500/30 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden group hover:border-amber-400 transition-all duration-300" data-categories="gt3">
          <div class="space-y-5">
            <!-- Top Card Header: Number & Role Badge -->
            <div class="flex items-center justify-between">
              <span class="text-lg font-black text-white font-mono">#2</span>
              <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 uppercase tracking-wider">
                DRIVER
              </span>
            </div>

            <!-- Driver Avatar -->
            <div class="text-center pt-2">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-amber-500/20 to-amber-950/60 border-2 border-amber-400/40 flex items-center justify-center mx-auto shadow-xl group-hover:scale-105 group-hover:border-amber-300 transition-all">
                <span class="font-black text-3xl text-amber-300 tracking-wider font-mono">MB</span>
              </div>
              <h2 class="text-xl font-black text-white mt-4 tracking-tight">Mateo Berbis</h2>
              <p class="text-xs text-amber-400 font-bold uppercase tracking-wider mt-1">Lead Sprint &amp; Qualy Driver</p>
            </div>

            <!-- Bio / Specialty -->
            <p class="text-xs text-neutral-300 leading-relaxed text-center min-h-[48px]">
              Piloto de velocidad pura y clasificación. Especialista en vuelta rápida bajo presión, frenadas al límite y tráfico en parrillas GT3.
            </p>
            
            <!-- Hardware Specs Strip -->
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-[11px] font-mono text-neutral-400 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Coches:</span>
                <span class="text-white font-bold text-right truncate">Ferrari 296 · BMW M4</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Rig:</span>
                <span class="text-amber-400 font-bold text-right truncate">DD · Curved Ultrawide</span>
              </div>
            </div>

            <!-- Category Pills -->
            <div class="flex flex-wrap justify-center gap-1.5 pt-1">
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20">GT3 Sprint</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">Bathurst 12H</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">Qualy Speed</span>
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="pt-6">
            <a href="/p/mateo-berbis/" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-black uppercase tracking-wider rounded-xl transition shadow-lg shadow-amber-500/20 inline-flex items-center justify-center gap-2">
              <span>Ver Ficha y Telemetría</span>
              <span class="text-base">&rarr;</span>
            </a>
          </div>
        </article>

        <!-- DRIVER 3: Eduardo Chongkan -->
        <article class="driver-card bg-[#161c24] border border-slate-500/30 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden group hover:border-slate-300 transition-all duration-300" data-categories="gtp">
          <div class="space-y-5">
            <!-- Top Card Header: Number & Role Badge -->
            <div class="flex items-center justify-between">
              <span class="text-lg font-black text-white font-mono">#3</span>
              <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-slate-500/15 border border-slate-400/30 text-slate-300 uppercase tracking-wider">
                DRIVER
              </span>
            </div>

            <!-- Driver Avatar -->
            <div class="text-center pt-2">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-slate-500/20 to-slate-900/60 border-2 border-slate-400/40 flex items-center justify-center mx-auto shadow-xl group-hover:scale-105 group-hover:border-slate-200 transition-all">
                <span class="font-black text-3xl text-slate-200 tracking-wider font-mono">EC</span>
              </div>
              <h2 class="text-xl font-black text-white mt-4 tracking-tight">Eduardo Chongkan</h2>
              <p class="text-xs text-slate-300 font-bold uppercase tracking-wider mt-1">Race Engineer &amp; Prototipos</p>
            </div>

            <!-- Bio / Specialty -->
            <p class="text-xs text-neutral-300 leading-relaxed text-center min-h-[48px]">
              Ingeniero de pista y piloto de prototipos. Especializado en curvas de amortiguación, desgaste de gomas y ritmo en stints largos.
            </p>
            
            <!-- Hardware Specs Strip -->
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-[11px] font-mono text-neutral-400 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Coches:</span>
                <span class="text-white font-bold text-right truncate">Cadillac GTP · Dallara P217</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Rig:</span>
                <span class="text-slate-300 font-bold text-right truncate">DD Pro · Hydraulic Pedals</span>
              </div>
            </div>

            <!-- Category Pills -->
            <div class="flex flex-wrap justify-center gap-1.5 pt-1">
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-slate-500/10 text-slate-300 border border-slate-400/20">LMP2 Prototype</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">Cadillac GTP</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">Nürburgring 24H</span>
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="pt-6">
            <a href="/p/eduardo-chongkan/" class="w-full py-3 bg-slate-200 hover:bg-white text-neutral-950 text-xs font-black uppercase tracking-wider rounded-xl transition shadow-lg shadow-white/10 inline-flex items-center justify-center gap-2">
              <span>Ver Ficha y Telemetría</span>
              <span class="text-base">&rarr;</span>
            </a>
          </div>
        </article>

        <!-- DRIVER 4: Juanlu Carrillo -->
        <article class="driver-card bg-[#161c24] border border-orange-500/30 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-2xl relative overflow-hidden group hover:border-orange-400 transition-all duration-300" data-categories="formula">
          <div class="space-y-5">
            <!-- Top Card Header: Number & Role Badge -->
            <div class="flex items-center justify-between">
              <span class="text-lg font-black text-white font-mono">#4</span>
              <span class="text-[10px] font-bold px-3 py-1 rounded-full bg-orange-500/15 border border-orange-500/30 text-orange-400 uppercase tracking-wider">
                DRIVER
              </span>
            </div>

            <!-- Driver Avatar -->
            <div class="text-center pt-2">
              <div class="w-24 h-24 rounded-2xl bg-gradient-to-br from-orange-500/20 to-orange-950/60 border-2 border-orange-500/40 flex items-center justify-center mx-auto shadow-xl group-hover:scale-105 group-hover:border-orange-300 transition-all">
                <span class="font-black text-3xl text-orange-400 tracking-wider font-mono">JC</span>
              </div>
              <h2 class="text-xl font-black text-white mt-4 tracking-tight">Juanlu Carrillo</h2>
              <p class="text-xs text-orange-400 font-bold uppercase tracking-wider mt-1">Monoplazas &amp; Formula Specialist</p>
            </div>

            <!-- Bio / Specialty -->
            <p class="text-xs text-neutral-300 leading-relaxed text-center min-h-[48px]">
              Especialista en monoplazas de alta carga aerodinámica, batallas cuerpo a cuerpo y gestión de tráfico en Super Formula Lights.
            </p>
            
            <!-- Hardware Specs Strip -->
            <div class="p-3 rounded-xl bg-white/5 border border-white/5 text-[11px] font-mono text-neutral-400 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Coches:</span>
                <span class="text-white font-bold text-right truncate">SFL 324 · FIA F4</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-neutral-500 shrink-0">Rig:</span>
                <span class="text-orange-400 font-bold text-right truncate">DD Pro · Formula Wheel</span>
              </div>
            </div>

            <!-- Category Pills -->
            <div class="flex flex-wrap justify-center gap-1.5 pt-1">
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-orange-500/10 text-orange-300 border border-orange-500/20">Super Formula Lights</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">FIA F4</span>
              <span class="text-[10px] font-mono px-2.5 py-1 rounded-lg bg-white/5 text-neutral-300 border border-white/10">Daytona 24H</span>
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="pt-6">
            <a href="/p/juanlu-carrillo/" class="w-full py-3 bg-orange-500 hover:bg-orange-400 text-neutral-950 text-xs font-black uppercase tracking-wider rounded-xl transition shadow-lg shadow-orange-500/20 inline-flex items-center justify-center gap-2">
              <span>Ver Ficha y Telemetría</span>
              <span class="text-base">&rarr;</span>
            </a>
          </div>
        </article>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. COMMUNITY DISCORD CALLOUT & TEAM COLLABORATION                         -->
  <!-- ========================================================================= -->
  <section id="discord" class="py-16 bg-[#0e1217] border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-[#141a23] border border-white/10 rounded-3xl p-8 sm:p-12 shadow-2xl">
        
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold">
            <span>🏁 Official Communications</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Canales de Voz y <span class="text-emerald-400">Telemetría en Vivo</span>
          </h2>
          <p class="text-sm text-neutral-300 leading-relaxed max-w-xl">
            Únete al canal oficial de Discord de Muntrume Motorsport para compartir telemetrías en tiempo real con los pilotos, debatir estrategias de carrera y seguir las retransmisiones oficiales.
          </p>
          <div class="pt-3 flex flex-wrap items-center gap-4">
            <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl transition shadow-lg shadow-emerald-500/20">
              <span>Unirse a Discord Oficial</span>
              <span class="text-base">&rarr;</span>
            </a>
            <a href="/mail" class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white font-bold text-xs uppercase tracking-wider transition">
              <span>Buzón Institucional Webmail</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 bg-[#0e1217] border border-white/10 rounded-2xl p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="font-bold text-white text-xs uppercase tracking-wider">Race Operations Center</span>
            </div>
            <span class="text-[11px] text-emerald-400 font-mono font-bold">Activo 24/7</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Ingeniería de datos a 60 Hz en MoTeC i2 Pro, sincronización directa con Garage 61 y briefings de carrera cifrados para el equipo.
          </p>
          <div class="pt-2 flex items-center justify-between text-[11px] font-mono text-neutral-500 border-t border-white/5">
            <span>Servidor: Muntrume Discord</span>
            <span class="text-neutral-300 font-bold">4 Pilotos Oficiales</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. JAVASCRIPT: Category Filter Controller                                 -->
  <!-- ========================================================================= -->
  <script is:inline>
    function setupRosterFilters() {
      const pills = document.querySelectorAll('.team-filter-pill');
      const cards = document.querySelectorAll('.driver-card');
      if (!pills.length || !cards.length) return;

      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pills.forEach(p => {
            p.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/30');
            p.classList.add('text-neutral-400', 'bg-white/5', 'border-white/10');
          });
          pill.classList.add('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/30');
          pill.classList.remove('text-neutral-400', 'bg-white/5', 'border-white/10');

          const filter = pill.dataset.filter;
          cards.forEach(card => {
            if (filter === 'all') {
              card.style.display = '';
            } else {
              const cats = (card.dataset.categories || '').toLowerCase();
              card.style.display = cats.includes(filter) ? '' : 'none';
            }
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupRosterFilters);
    } else {
      setupRosterFilters();
    }
  </script>
</Layout>
