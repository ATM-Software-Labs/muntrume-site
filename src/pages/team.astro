---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Team Roster · Muntrume Motorsport";
const pageDescription = "Meet the four drivers of Muntrume Motorsport, a sim racing team from Barcelona racing on iRacing.";
---

<Layout title={pageTitle} description={pageDescription}>
<!-- ========================================================================= -->
  <!-- 2. HERO: DRIVER ROSTER & SQUAD OVERVIEW                                    -->
  <!-- ========================================================================= -->
  <section class="pt-28 pb-14 bg-[#0e1217] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Status Strip -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-8 border-b border-white/10 text-xs">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-semibold uppercase flex items-center gap-2">
            <span class="pulse-dot"></span>
            Lineup · 4 Drivers
          </span>
          
        </div>
        <div class="flex items-center gap-3 text-neutral-400 font-medium">
          <span>Sant Andreu · Barcelona</span>
        </div>
      </div>

      <div class="text-center py-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-emerald-400 text-xs font-semibold mb-4">
          <span>Team Roster</span>
        </div>
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-4">
          TEAM <span class="text-emerald-400">ROSTER</span>
        </h1>
        <p class="text-sm sm:text-base text-neutral-400 max-w-2xl mx-auto leading-relaxed">
          The four drivers of Muntrume Motorsport on iRacing. <a href="/pilotos" class="text-emerald-400" style="text-decoration:underline">Pilot profiles</a>
        </p>
      </div>


    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. DRIVERS DIRECTORY (Driver Cards)                              -->
  <!-- ========================================================================= -->
  <section id="drivers" class="py-16 bg-[#0e1217]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Controls Toolbar: Search & License Filters -->
      <div class="bg-[#161c24] border border-white/10 rounded-2xl p-4 mb-10 shadow-lg flex flex-col md:flex-row items-center justify-between gap-4">
        
        <!-- Search -->
        <div class="relative w-full md:w-80">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Search driver or category..." 
            class="w-full bg-[#0e1217] border border-white/10 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-neutral-400 focus:outline-none focus:border-emerald-500 transition"
          >
        </div>

        <div id="licenseFilters" hidden></div>

        <!-- Sort Select -->
        <div class="w-full md:w-auto flex items-center gap-2 text-xs text-neutral-400 font-medium">
          <span class="whitespace-nowrap">Sort:</span>
          <select id="sortSelect" aria-label="Sort drivers" class="bg-[#0e1217] border border-white/10 rounded-xl px-3 py-2 text-white text-xs focus:outline-none focus:border-emerald-500">
            <option value="roster">Roster order</option>
            <option value="name-asc">Name (A-Z)</option>
          </select>
        </div>

      </div>

      <!-- Drivers Grid (4 Drivers) -->
      <h2 class="sr-only">Driver roster</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="driversGrid">
        
        <!-- DRIVER 1: Alberto Trujillo -->
        <div class="driver-card bg-[#161c24] border border-white/10 rounded-2xl p-6 text-center relative overflow-hidden flex flex-col justify-between shadow-xl" data-license="all" data-name="Alberto Trujillo">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs text-neutral-400 font-bold rank-badge">#1</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 uppercase tracking-wider">FOUNDER</span>
            </div>
            
            <div class="relative inline-block mb-4">
              <div class="w-28 h-28 rounded-full border-2 border-emerald-500 bg-emerald-950/60 flex items-center justify-center mx-auto shadow-xl font-extrabold text-2xl text-emerald-400">
                AT
              </div>
            </div>

            <h3 class="text-lg font-bold text-white mb-1">Alberto Trujillo</h3>
            <p class="text-xs text-neutral-400 mb-5 leading-relaxed line-clamp-2">Founder &amp; driver.</p>
            <a href="/pilot?id=alberto-trujillo" class="w-full py-2.5 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 text-xs font-bold rounded-xl transition shadow-sm inline-flex items-center justify-center gap-1.5">
              <span>Ver Perfil y Telemetría</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- DRIVER 2: Mateo Berbis -->
        <div class="driver-card bg-[#161c24] border border-white/10 rounded-2xl p-6 text-center relative overflow-hidden flex flex-col justify-between shadow-xl" data-license="all" data-name="Mateo Berbis">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs text-neutral-400 font-bold rank-badge">#2</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 uppercase tracking-wider">DRIVER</span>
            </div>

            <div class="relative inline-block mb-4">
              <div class="w-28 h-28 rounded-full border-2 border-amber-400 bg-amber-950/60 flex items-center justify-center mx-auto shadow-xl font-extrabold text-2xl text-amber-300">
                MB
              </div>
            </div>

            <h3 class="text-lg font-bold text-white mb-1">Mateo Berbis</h3>
            <p class="text-xs text-neutral-400 mb-5 leading-relaxed line-clamp-2">Driver.</p>
            <a href="/pilot?id=mateo-berbis" class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-bold rounded-xl transition shadow-sm inline-flex items-center justify-center gap-1.5">
              <span>Ver Perfil y Telemetría</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- DRIVER 3: Eduardo Chongkan -->
        <div class="driver-card bg-[#161c24] border border-white/10 rounded-2xl p-6 text-center relative overflow-hidden flex flex-col justify-between shadow-xl" data-license="all" data-name="Eduardo Chongkan">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs text-neutral-400 font-bold rank-badge">#3</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-slate-500/15 border border-slate-400/30 text-slate-300 uppercase tracking-wider">DRIVER</span>
            </div>

            <div class="relative inline-block mb-4">
              <div class="w-28 h-28 rounded-full border-2 border-slate-400 bg-slate-800/60 flex items-center justify-center mx-auto shadow-xl font-extrabold text-2xl text-slate-300">
                EC
              </div>
            </div>

            <h3 class="text-lg font-bold text-white mb-1">Eduardo Chongkan</h3>
            <p class="text-xs text-neutral-400 mb-5 leading-relaxed line-clamp-2">Driver.</p>
            <a href="/pilot?id=eduardo-chongkan" class="w-full py-2.5 bg-slate-200 hover:bg-white text-neutral-950 text-xs font-bold rounded-xl transition shadow-sm inline-flex items-center justify-center gap-1.5">
              <span>Ver Perfil y Telemetría</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- DRIVER 4: Juanlu Carrillo -->
        <div class="driver-card bg-[#161c24] border border-white/10 rounded-2xl p-6 text-center relative overflow-hidden flex flex-col justify-between shadow-xl" data-license="all" data-name="Juanlu Carrillo">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs text-neutral-400 font-bold rank-badge">#4</span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-orange-500/15 border border-orange-500/30 text-orange-400 uppercase tracking-wider">DRIVER</span>
            </div>

            <div class="relative inline-block mb-4">
              <div class="w-28 h-28 rounded-full border-2 border-orange-500 bg-orange-950/60 flex items-center justify-center mx-auto shadow-xl font-extrabold text-2xl text-orange-400">
                JC
              </div>
            </div>

            <h3 class="text-lg font-bold text-white mb-1">Juanlu Carrillo</h3>
            <p class="text-xs text-neutral-400 mb-5 leading-relaxed line-clamp-2">Driver.</p>
            <a href="/pilot?id=juanlu-carrillo" class="w-full py-2.5 bg-orange-500 hover:bg-orange-400 text-neutral-950 text-xs font-bold rounded-xl transition shadow-sm inline-flex items-center justify-center gap-1.5">
              <span>Ver Perfil y Telemetría</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

      </div>

      <!-- No Results Message -->
      <div id="noResults" class="hidden text-center py-12 text-sm text-neutral-500 bg-[#161c24] rounded-2xl border border-white/10 mt-8">
        No drivers match current filter query.
      </div>

    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 5. COMMUNITY DISCORD CALLOUT                                              -->
  <!-- ========================================================================= -->
  <section id="discord" class="py-16 bg-[#0e1217] border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <div class="lg:col-span-6 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-emerald-400 text-xs font-semibold">
            <span>Community</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Connect With <span class="text-emerald-400">the Team</span>
          </h2>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Join the Muntrume Motorsport Discord to talk setups and racing with the team.
          </p>

          <div class="pt-4">
            <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl transition shadow-lg hover:shadow-emerald-500/20">
              <span>Join Discord</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="bg-[#161c24] rounded-2xl p-2.5 border border-white/10 shadow-2xl overflow-hidden">
            <iframe 
              title="Muntrume Motorsport Discord server widget"
              loading="lazy"
              src="https://discord.com/widget?id=1188239582865661992&theme=dark" 
              width="100%" 
              height="380" 
              allowtransparency="true" 
              frameborder="0" 
              sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts">
            </iframe>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 6. DRIVER MODAL (Interactive Athlete Dossier)                             -->
  <!-- ========================================================================= -->
  <div id="driverModal" class="fixed inset-0 z-50 hidden items-center justify-center modal-backdrop p-4" onclick="closeModalOutside(event)">
    <div class="modal-content bg-[#161c24] border border-white/10 rounded-2xl w-full max-w-xl overflow-hidden shadow-2xl">
      
      <!-- Modal Header -->
      <div class="bg-[#1c232d] p-6 border-b border-white/10 relative">
        <button onclick="closeDriverModal()" class="absolute top-5 right-5 text-neutral-400 hover:text-white p-1 transition" aria-label="Close modal">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <div class="flex items-center gap-4">
          <img id="modal-avatar" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Driver avatar" width="64" height="64" class="w-16 h-16 rounded-full object-cover border-2 border-emerald-400">
          <div>
            <h3 id="modal-name" class="text-xl font-bold text-white tracking-tight"></h3>
            <span id="modal-license" class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold mt-1"></span>
            <div id="modal-role" class="text-xs text-neutral-400 mt-1"></div>
          </div>
        </div>
      </div>

      <!-- Modal Tabs -->
      <div class="border-b border-white/10 px-6 flex gap-2 bg-[#161c24]">
        <button class="tab-btn active" onclick="switchModalTab('stats', this)">Profile</button>
        <button class="tab-btn" onclick="switchModalTab('bio', this)">Driver Bio</button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 text-xs">
        <!-- Tab 1: Stats -->
        <div id="tab-stats" class="tab-content active space-y-4">
          <div class="grid grid-cols-2 gap-3" id="modal-stats"></div>
        </div>

        <!-- Tab 3: Bio -->
        <div id="tab-bio" class="tab-content">
          <div class="bg-[#1c232d] p-5 rounded-xl border border-white/5 text-neutral-300 leading-relaxed text-sm">
            <p id="modal-bio"></p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 7. FOOTER (Unified Motorsport Master Footer)                              -->
  <!-- ========================================================================= -->

<!-- ========================================================================= -->
  <!-- JAVASCRIPT: Driver Modal, Search, Sort & Filter Engine                    -->
  <!-- ========================================================================= -->
  <script is:inline>
    // 1. Mobile Drawer Controller
    function toggleNavDrawer() {
      const drawer = document.getElementById('mobileDrawer');
      const backdrop = document.getElementById('mobileBackdrop');
      if (!drawer || !backdrop) return;
      const isOpen = drawer.classList.contains('open');
      if (isOpen) {
        drawer.classList.remove('open');
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
      } else {
        drawer.classList.add('open');
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    // 2. Driver Modal Controller
    const driverModal = document.getElementById('driverModal');

    function switchModalTab(tabName, btnElement) {
      document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
      btnElement.classList.add('active');
      document.getElementById(`tab-${tabName}`).classList.add('active');
    }

    function openDriverModal(name, license, role, avatar, licenseClass, stats, bio) {
      document.getElementById('modal-name').textContent = name;
      document.getElementById('modal-role').textContent = role;
      document.getElementById('modal-avatar').src = avatar;
      document.getElementById('modal-bio').textContent = bio;

      const licenseEl = document.getElementById('modal-license');
      licenseEl.textContent = license;
      licenseEl.className = `${licenseClass} inline-block px-2.5 py-0.5 rounded text-[11px] font-semibold mt-1 border`;

      document.getElementById('modal-stats').innerHTML = `
        <div class="bg-[#1c232d] p-3 rounded-xl border border-white/5">
          <div class="text-[10px] text-neutral-400 uppercase font-semibold">Category</div>
          <div class="text-xs font-semibold text-neutral-200 mt-1">${stats.category}</div>
        </div>
        <div class="bg-[#1c232d] p-3 rounded-xl border border-white/5">
          <div class="text-[10px] text-neutral-400 uppercase font-semibold">Specialty</div>
          <div class="text-xs font-semibold text-neutral-200 mt-1">${stats.specialty}</div>
        </div>
      `;

      // Reset to first tab
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      document.querySelector('.tab-btn').classList.add('active');
      document.getElementById('tab-stats').classList.add('active');

      driverModal.classList.remove('hidden');
      driverModal.classList.add('flex');
    }


    function closeDriverModal() {
      driverModal.classList.add('hidden');
      driverModal.classList.remove('flex');
    }

    function closeModalOutside(e) {
      if (e.target === driverModal) closeDriverModal();
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDriverModal();
    });

    // 3. FILTER, SORT & SEARCH LOGIC
    const searchInput = document.getElementById('searchInput');
    const licenseFilters = document.querySelectorAll('#licenseFilters .filter-btn');
    const sortSelect = document.getElementById('sortSelect');
    const driversGrid = document.getElementById('driversGrid');
    const noResults = document.getElementById('noResults');

    let currentFilter = 'all';
    let currentSearch = '';
    let currentSort = 'roster';
    document.querySelectorAll('.driver-card').forEach((c, i) => { c.dataset.order = i; });

    function applyDriverFilters() {
      const cards = Array.from(document.querySelectorAll('.driver-card'));
      let visible = 0;

      cards.forEach(c => {
        const license = c.dataset.license;
        const name = c.dataset.name.toLowerCase();

        const matchLic = currentFilter === 'all' || license === currentFilter;
        const matchSearch = !currentSearch || name.includes(currentSearch.toLowerCase());

        if (matchLic && matchSearch) {
          c.classList.remove('hidden-card');
          visible++;
        } else {
          c.classList.add('hidden-card');
        }
      });

      if (visible === 0) noResults.classList.remove('hidden');
      else noResults.classList.add('hidden');

      applyDriverSorting();
    }

    function applyDriverSorting() {
      const visibleCards = Array.from(document.querySelectorAll('.driver-card:not(.hidden-card)'));
      const hiddenCards = Array.from(document.querySelectorAll('.driver-card.hidden-card'));

      visibleCards.sort((a, b) => {
        switch (currentSort) {
          case 'roster': return Number(a.dataset.order) - Number(b.dataset.order);
          case 'name-asc': return a.dataset.name.localeCompare(b.dataset.name);
          default: return 0;
        }
      });

      visibleCards.forEach((c, i) => {
        const badge = c.querySelector('.rank-badge');
        if (badge) badge.textContent = `#${i + 1}`;
        driversGrid.appendChild(c);
      });
      hiddenCards.forEach(c => driversGrid.appendChild(c));
    }

    searchInput.addEventListener('input', (e) => {
      currentSearch = e.target.value;
      applyDriverFilters();
    });

    licenseFilters.forEach(b => {
      b.addEventListener('click', () => {
        licenseFilters.forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        currentFilter = b.dataset.filter;
        applyDriverFilters();
      });
    });

    sortSelect.addEventListener('change', (e) => {
      currentSort = e.target.value;
      applyDriverSorting();
    });
  </script>
</Layout>
