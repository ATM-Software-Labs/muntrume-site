---
import Layout from '../../layouts/Layout.astro';
import { IRACING_TRACKS, getTrackGarageInfo, getTrackScheduleInfo, getHistoricTrackRank } from '../../lib/track-matcher';

const items = IRACING_TRACKS.map((t) => {
  const garage = getTrackGarageInfo(t);
  const sched = getTrackScheduleInfo(t);
  const isFree = t.categories.includes('Free');
  const seriesCount = sched.entries.length;
  const galleryCount = t.gallery?.length ?? 0;
  const historicRank = getHistoricTrackRank(t.slug);
  // Authoritative historical popularity combined with series activity and setups
  const popularityScore =
    (historicRank < 900 ? (100 - historicRank) * 250 : 0) +
    seriesCount * 8 +
    Math.min(garage.setupCount, 400) * 0.25 +
    (isFree ? 20 : 0) +
    sched.configs.length * 2 +
    (galleryCount > 0 ? 5 : 0);

  return {
    ...t,
    isFree,
    setupCount: garage.setupCount,
    seriesCount,
    galleryCount,
    popularityScore,
    configs: sched.configs,
    excerpt: t.history.length > 135 ? `${t.history.slice(0, 132).trim()}…` : t.history,
  };
}).sort((a, b) => b.popularityScore - a.popularityScore || a.name.localeCompare(b.name));

const withSetupsCount = items.filter((i) => i.setupCount > 0).length;
const freeCount = items.filter((i) => i.isFree).length;
const pageTitle = 'Circuitos Oficiales iRacing | Muntrume Motorsport';
const pageDescription = `Directorio de ${items.length} circuitos oficiales de iRacing con foto, historia, variantes de trazado y acceso directo a setups (.sto) en el Garage.`;
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/tracks/">
  <main class="r-wrap py-12 sm:py-16 space-y-8">
    <nav aria-label="Breadcrumb" class="r-kicker flex items-center gap-2">
      <a href="/paddock/" class="hover:text-[var(--r-accent)] transition">Paddock</a>
      <span>/</span>
      <span class="text-[var(--r-text)] font-bold">Circuitos</span>
    </nav>

    <header class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 border-b border-[var(--r-line)] pb-6">
      <div class="space-y-2">
        <div class="r-kicker">iRacing Track Directory · Fotos, historia y variantes</div>
        <h1 class="r-h2">Circuitos Oficiales ({items.length})</h1>
        <p class="r-lead max-w-2xl">
          Todos los trazados de iRacing con ficha técnica, historia, configuraciones de temporada y acceso directo a sus setups (.sto) en el Garage.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filtrar circuitos">
          <button type="button" class="trk-pill is-on" data-filter="all">Todos ({items.length})</button>
          <button type="button" class="trk-pill" data-filter="setups">Con Setups ({withSetupsCount})</button>
          <button type="button" class="trk-pill" data-filter="free">Incluidos / Free ({freeCount})</button>
        </div>
        <select
          id="track-sort"
          aria-label="Ordenar circuitos"
          class="px-3 py-2 rounded-xl bg-[var(--r-surface)] border border-[var(--r-line)] focus:border-[var(--r-accent)] outline-none text-xs font-mono text-[var(--r-text)] cursor-pointer"
        >
          <option value="pop">Orden: Popularidad</option>
          <option value="setups">Orden: Más setups</option>
          <option value="series">Orden: Más series</option>
          <option value="az">Orden: A–Z</option>
        </select>
        <input
          id="track-search"
          type="search"
          placeholder="Buscar circuito..."
          class="w-full sm:w-52 px-3.5 py-2 rounded-xl bg-[var(--r-surface)] border border-[var(--r-line)] focus:border-[var(--r-accent)] outline-none text-xs font-mono text-[var(--r-text)]"
        />
      </div>
    </header>

    <section id="track-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map((track) => (
        <a
          href={`/tracks/${track.slug}/`}
          data-track-name={`${track.name} ${track.configs.join(' ')}`.toLowerCase()}
          data-track-title={track.name.toLowerCase()}
          data-pop={String(track.popularityScore)}
          data-setups={String(track.setupCount)}
          data-series={String(track.seriesCount)}
          data-has-setups={track.setupCount > 0 ? '1' : '0'}
          data-is-free={track.isFree ? '1' : '0'}
          class="track-card group rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-[var(--r-accent)] overflow-hidden transition flex flex-col"
        >
          <div class="relative aspect-[16/9] bg-[#090d12] overflow-hidden">
            {track.thumb && (
              <img
                src={track.thumb}
                alt={track.name}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04]"
              />
            )}
            <div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5">
              {track.isFree && (
                <span class="px-2 py-0.5 rounded bg-black/75 border border-white/15 text-[10px] font-mono font-bold uppercase text-emerald-300">
                  Incluido
                </span>
              )}
              {track.setupCount > 0 && (
                <span class="px-2 py-0.5 rounded bg-black/75 border border-[var(--r-accent)]/40 text-[10px] font-mono font-bold text-[var(--r-accent)]">
                  {track.setupCount} setups
                </span>
              )}
              {track.seriesCount > 0 && (
                <span class="px-2 py-0.5 rounded bg-black/75 border border-white/15 text-[10px] font-mono font-bold text-white/90">
                  {track.seriesCount} series
                </span>
              )}
            </div>
            {track.galleryCount > 0 && (
              <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/75 border border-white/15 text-[10px] font-mono text-white/85">
                {track.galleryCount} fotos
              </span>
            )}
          </div>

          <div class="p-4 flex flex-col flex-1 gap-2">
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-sm font-bold text-[var(--r-text)] group-hover:text-[var(--r-accent)] transition leading-snug">
                {track.name}
              </h2>
              <span class="text-[11px] font-mono text-[var(--r-accent)] shrink-0">Ficha →</span>
            </div>

            {track.configs.length > 0 && (
              <p class="text-[11px] font-mono text-[var(--r-muted)] truncate">
                {track.configs.length} {track.configs.length === 1 ? 'variante' : 'variantes'}: {track.configs.slice(0, 3).join(' · ')}
              </p>
            )}

            {track.excerpt && (
              <p class="text-xs text-[var(--r-muted)] line-clamp-2 mt-auto">
                {track.excerpt}
              </p>
            )}
          </div>
        </a>
      ))}
    </section>
  </main>

  <style>
    .trk-pill {
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid var(--r-line);
      background: transparent;
      color: var(--r-muted);
      font: 600 11px/1.2 ui-monospace, monospace;
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .trk-pill:hover { border-color: var(--r-line-2); color: var(--r-text); }
    .trk-pill.is-on {
      border-color: var(--r-accent, #00e699);
      background: rgba(0, 230, 153, 0.12);
      color: var(--r-text);
    }
  </style>

  <script is:inline>
    (function () {
      var grid = document.getElementById('track-grid');
      var input = document.getElementById('track-search');
      var sortSelect = document.getElementById('track-sort');
      var cards = Array.prototype.slice.call(document.querySelectorAll('.track-card'));
      var pills = document.querySelectorAll('.trk-pill');
      var activeFilter = 'all';

      function applySort() {
        if (!grid || !sortSelect) return;
        var mode = sortSelect.value || 'pop';
        var sorted = cards.slice().sort(function (a, b) {
          if (mode === 'az') {
            return (a.getAttribute('data-track-title') || '').localeCompare(b.getAttribute('data-track-title') || '');
          }
          var key = mode === 'setups' ? 'data-setups' : mode === 'series' ? 'data-series' : 'data-pop';
          var diff = Number(b.getAttribute(key) || 0) - Number(a.getAttribute(key) || 0);
          if (diff !== 0) return diff;
          return (a.getAttribute('data-track-title') || '').localeCompare(b.getAttribute('data-track-title') || '');
        });
        sorted.forEach(function (card) { grid.appendChild(card); });
      }

      function apply() {
        var q = (input && input.value ? input.value : '').trim().toLowerCase();
        cards.forEach(function (card) {
          var name = card.getAttribute('data-track-name') || '';
          var hasSetups = card.getAttribute('data-has-setups') === '1';
          var isFree = card.getAttribute('data-is-free') === '1';
          var okFilter = activeFilter === 'all' || (activeFilter === 'setups' && hasSetups) || (activeFilter === 'free' && isFree);
          var okSearch = !q || name.indexOf(q) !== -1;
          card.classList.toggle('hidden', !(okFilter && okSearch));
        });
      }

      if (input) input.addEventListener('input', apply);
      if (sortSelect) sortSelect.addEventListener('change', applySort);
      pills.forEach(function (btn) {
        btn.addEventListener('click', function () {
          activeFilter = btn.getAttribute('data-filter') || 'all';
          pills.forEach(function (b) { b.classList.toggle('is-on', b === btn); });
          apply();
        });
      });
    })();
  </script>
</Layout>
