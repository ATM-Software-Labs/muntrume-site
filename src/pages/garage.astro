  <div id="setPasswordModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="setPwTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="setPwTitle">Crea tu contraseña</h2>
        <button type="button" class="m-notice__close" onclick="closeSetPasswordModal()" aria-label="Cerrar">×</button>
      </div>
