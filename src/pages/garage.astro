---
import Layout from '../layouts/Layout.astro';
import catalog from '../../public/assets/data/catalog_index.json';
import { PILOTOS } from '../lib/pilotos';

const pageTitle = "Garage | Muntrume Motorsport";
const pageDescription = "Muntrume Motorsport Setup Vault: over 41,000 .STO setups by car, circuit, and season, plus Garage 61 telemetry, Team Communications, and Dynamic Setup Builder.";
const fmt = (n: number) => n.toLocaleString('en-US');
const figs = [
  { n: fmt(catalog.total_setups), l: "Setups in the Vault" },
  { n: String(catalog.cars.length), l: "Supported Cars" },
  { n: String(catalog.circuits.length), l: "Calibrated Circuits" },
  { n: String(PILOTOS.length), l: "Official Drivers" },
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/garage">
  <Fragment slot="head">
    <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
  </Fragment>
  <section class="r-section g-hero" aria-labelledby="garageTitle">
    <div class="r-wrap">
      <p class="r-kicker">Setup Vault &amp; Team HQ</p>
      <h1 id="garageTitle" class="r-h2">Garage</h1>
      <p class="r-lead">Official .STO setups organized by car, circuit, and season. Driver account required for downloads. Files write directly to your local iRacing folder.</p>
      <div class="g-actions" id="garageHeroActions">
        <button type="button" id="heroAuthBtn" data-driver-signin-btn class="r-btn r-btn--primary" onclick="openAuthModal('login')">Driver Sign In</button>
        <div id="heroSessionPill" class="hidden items-center gap-2.5 px-4 py-2.5 rounded-xl bg-[var(--r-surface)] border border-[var(--r-line)] text-xs font-mono text-[var(--r-text)]">
          <span class="w-2 h-2 rounded-full bg-[var(--r-accent)] shrink-0"></span>
          <span id="heroSessionIdentity" class="font-bold text-[var(--r-accent)]">atrumin16</span>
          <span class="text-[var(--r-muted)]">·</span>
          <span id="heroSessionName">Alberto Trujillo (#16)</span>
        </div>
        <a id="heroRaceControlBtn" href="/admin" class="r-btn r-btn--primary hidden" style="box-shadow:0 0 22px rgba(0,230,153,.28)">RACE CONTROL</a>
        <button type="button" class="r-btn" onclick="openAuthModal('login')">Acceso Pilotos</button>
        <a href="https://garage61.net/app/teams/muntrume-motorsport" target="_blank" rel="noopener noreferrer" class="r-btn">Garage 61 Telemetry ↗</a>
      </div>
      <div class="r-figs">
        {figs.map((f) => (<div><strong class="r-num">{f.n}</strong>{f.l}</div>))}
      </div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="saveTitle">
    <div class="r-wrap" style="display:grid;gap:var(--r-s4)">
      <div class="g-panel g-save" id="fsSavePanel">
        <div class="g-save__row">
          <div>
            <p class="r-kicker">Guardado</p>
            <h2 id="saveTitle" class="r-h3">Carpeta de iRacing</h2>
          </div>
          <button type="button" id="linkFolderBtn" class="r-btn r-btn--primary r-btn--sm" onclick="toggleLinkDirectory()">
            <span id="linkFolderText">Vincular carpeta de iRacing</span>
          </button>
        </div>
        <p id="metricDirectStatus" class="g-status">Sin carpeta vinculada</p>
        <p class="r-meta" style="margin:0">Si vinculas una carpeta, el archivo se escribe en tu ordenador. Muntrume no lo recibe.</p>

        <!-- Banner Inteligente Cyberpunk / Dark Mode para Navegadores Restrictivos (Brave) -->
        <div id="fsAccessNotice" class="p-4 rounded-xl bg-[#080C0A] border border-[#1E2A26] border-l-4 border-l-[#00ff88] shadow-[0_10px_30px_rgba(0,0,0,0.6)] space-y-3" role="alert" hidden>
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#00ff88] animate-ping" aria-hidden="true"></span>
              <span class="text-[11px] font-mono uppercase font-bold text-[#00ff88] tracking-wider">COMPATIBILIDAD DE NAVEGADOR · BRAVE / RESTRICTIVO</span>
            </div>
            <button type="button" id="fsNoticeDismiss" class="text-neutral-400 hover:text-white p-1 text-sm font-mono cursor-pointer transition" onclick="dismissFsAccessNotice()" aria-label="Cerrar aviso">✕</button>
          </div>
          <div class="space-y-2 text-xs">
            <p class="font-bold text-white text-sm" id="fsNoticeTitle">Guardado en carpeta local no disponible directamente</p>
            <div id="fsNoticeOther">
              <p class="text-neutral-400 leading-relaxed">Tu navegador actual no permite que las webs escriban directamente en carpetas del disco. Puedes <strong>descargar los setups de forma tradicional (.sto)</strong> en 1 clic o abrir el Setup Vault en Google Chrome o Microsoft Edge.</p>
            </div>
            <div id="fsNoticeBrave" hidden class="space-y-2.5">
              <p class="text-neutral-300 leading-relaxed">Brave desactiva por defecto la <em>File System Access API</em> por privacidad. Puedes activarla en 10 segundos o continuar con la descarga clásica:</p>
              <div class="p-2.5 rounded-lg bg-[#0E1513] border border-[#1E2A26] flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
                <code class="text-[#00ff88] select-all">brave://flags/#file-system-access-api</code>
                <div class="relative inline-block">
                  <button type="button" id="copyFlagsBtn" onclick="copyBraveFlagUrlWithTooltip(this)" class="r-btn r-btn--sm" style="border-color:#00E699;color:#00E699;min-height:34px;padding:0 12px">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copiar ruta de flags</span>
                  </button>
                  <span id="flagsTooltip" class="hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2.5 py-1 text-[10px] font-mono font-bold bg-[#00ff88] text-neutral-950 rounded shadow-md whitespace-nowrap animate-bounce">
                    ✓ ¡Copiado al portapapeles!
                  </span>
                </div>
              </div>
              <p class="text-[11px] text-neutral-400">Pega la ruta en una pestaña de Brave, pon la flag en <strong>Enabled</strong>, pulsa <strong>Relaunch</strong> y recarga.</p>
            </div>
          </div>
          <div class="pt-2 flex flex-wrap gap-2 items-center">
            <button type="button" class="r-btn r-btn--sm r-btn--primary" onclick="openFallbackDownloadModal()">Descarga tradicional directa</button>
            <button type="button" class="r-btn r-btn--sm" style="border-color:var(--r-line);color:var(--r-text)" onclick="copyVaultUrlForChrome()">Copiar enlace para Chrome / Edge</button>
          </div>
        </div>

        <div id="savedFolderReconnectBanner" class="m-notice m-notice--inline m-notice--info hidden" role="status">
          <span class="m-notice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 8h.01"/></svg>
          </span>
          <div class="m-notice__body">
            <p class="m-notice__title">Permiso de carpeta</p>
            <p class="m-notice__msg">Vuelve a permitir esta carpeta.</p>
            <p class="m-notice__msg" id="savedFolderNameLabel" data-no-i18n></p>
          </div>
          <button type="button" class="r-btn r-btn--sm" onclick="reconnectSavedDirectory()">Permitir</button>
        </div>
      </div>

      <div>
        <div class="r-head" style="margin-bottom:var(--r-s3)">
          <div>
            <p class="r-kicker">Método</p>
            <h2 class="r-h3">Cómo se guarda</h2>
          </div>
        </div>
        <ol class="g-steps">
          <li>
            <span>01</span>
            <h3 class="r-h3">Vincular la carpeta</h3>
            <p>Una vez, si el navegador lo permite: la carpeta de setups de iRacing, con permiso de lectura y escritura.</p>
          </li>
          <li>
            <span>02</span>
            <h3 class="r-h3">Elegir el setup</h3>
            <p>Filtra por coche, circuito y temporada. Clasificación, carrera o lluvia.</p>
          </li>
          <li>
            <span>03</span>
            <h3 class="r-h3">Guardar o descargar</h3>
            <p>Con la carpeta vinculada, el archivo entra en la ruta del coche. Si no, se descarga el .sto.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="r-section" aria-labelledby="vaultTitle">
    <div class="r-wrap" style="display:grid;gap:var(--r-s3)">
      <div class="g-toolbar">
        <div class="g-tabs" id="garageTabs" role="tablist" aria-label="Garage Sections">
          <button type="button" role="tab" aria-selected="true" aria-controls="garageSectionSetups" id="tabBtnSetups" class="is-on" onclick="switchGarageTab('setups')">Setups</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionTelemetry" id="tabBtnTelemetry" onclick="switchGarageTab('telemetry')">Telemetry</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionComms" id="tabBtnComms" onclick="switchGarageTab('comms')">Communications</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionBuilder" id="tabBtnBuilder" onclick="switchGarageTab('builder')">Setup Builder</button>
        </div>
        <div class="g-session" id="garageSessionToolbar">
          <span id="userEmailDisplay" class="font-mono text-xs font-semibold">Guest</span>
          <span id="userRoleBadge" class="g-badge">Catalog</span>
          <a id="adminPanelBtn" href="/admin" class="r-btn r-btn--primary r-btn--sm hidden" style="box-shadow:0 0 18px rgba(0,230,153,.28)">RACE CONTROL</a>
          <button type="button" id="logoutBtn" class="r-link hidden" onclick="handleLogout()">Log out</button>
          <button type="button" id="authGateOpenBtn" data-driver-signin-btn class="r-btn r-btn--primary r-btn--sm" onclick="openAuthModal('login')">Driver Sign In</button>
        </div>
      </div>

      <div id="garageSectionSetups" role="tabpanel" aria-labelledby="tabBtnSetups" style="display:grid;gap:16px">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="vaultTitle" class="r-h3" style="margin:0">Catálogo Oficial MMT</h2>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--r-surface)] border border-[var(--r-accent)] text-[11px] font-mono text-[var(--r-accent)] font-bold">
            <span class="w-2 h-2 rounded-full bg-[var(--r-accent)]"></span>
            <span>BOP 26S4 VERIFIED · PASS TECH (0 FAILED TECH)</span>
          </div>
        </div>

        <!-- Muro de Autenticación para Invitados / No autenticados -->
        <div id="vaultAuthGateWall" class="p-8 sm:p-12 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] text-center space-y-5 my-2 shadow-sm">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-[var(--r-bg-2)] border border-[var(--r-line)] flex items-center justify-center text-[var(--r-accent)] shadow-xs">
            <svg class="w-7 h-7 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <div class="max-w-md mx-auto space-y-2">
            <h3 class="text-xl sm:text-2xl font-extrabold text-[var(--r-text)] font-display uppercase tracking-tight">Acceso Privado para Pilotos</h3>
            <p class="text-xs sm:text-sm text-[var(--r-muted)] leading-relaxed">
              El Setup Vault de Muntrume Motorsport y los paquetes semanales de la NEC están reservados a miembros autenticados. Inicia sesión con tu cuenta de piloto para ver y descargar setups (.STO).
            </p>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <button type="button" class="r-btn r-btn--primary" onclick="openAuthModal('login')">Iniciar Sesión de Piloto</button>
            <button type="button" class="r-btn" onclick="openAuthModal('join')">Solicitar Ingreso al Equipo</button>
          </div>
        </div>

        <!-- Contenido Completo del Catálogo (Solo para pilotos autenticados) -->
        <div id="vaultSetupsContent" class="hidden space-y-4">
        <!-- Apartado Dedicado NEC (Nürburgring Combined Gesamtstrecke VLN) + Guía Oficial Nomenclatura MMT -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="g-panel" style="padding:18px;border-left:3px solid var(--r-accent)">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <div>
                <p class="r-kicker" style="margin:0">Especial Nordschleife · Semanal W01–W13</p>
                <h3 class="r-h3" style="font-size:1.08rem;margin:2px 0 0">🏁 NEC · Nürburgring Combined Gesamtstrecke VLN</h3>
              </div>
              <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="filterNecSetups()">Ver Setups NEC (VLN) →</button>
            </div>
            <p class="r-meta" style="margin:0 0 10px;line-height:1.5">
              Packs semanales (<code>W01</code> a <code>W13</code>) para las clases oficiales de la <strong>Nürburgring Endurance Championship (NEC)</strong>: GT3 (<code>F296, P911, M4, AMG, R8, LAMBO, MACLA, Z06, MUST, AMR</code>), Porsche Cup (<code>P911</code>), GT4 (<code>PORS, M4, AMG, AMR, MACLA</code>), TCR (<code>RS3, HYUN, CIVIC</code>), <code>GR86</code> y <code>MX5</code>. Calibrados con altura estática <strong>&ge; 70.5 mm</strong> para superar el escrutinio técnico del Nordschleife sin <em>Failed Tech</em>.
            </p>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W01')">NEC W01</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W02')">NEC W02</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W03')">NEC W03</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W04')">NEC W04</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W05')">NEC W05</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W06')">NEC W06</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W07')">NEC W07</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('W08')">NEC W08</button>
              <button type="button" class="r-btn r-btn--sm" style="min-height:28px;padding:0 10px;font-size:11px" onclick="filterNecSetups('')">Todas (W01–W13)</button>
            </div>
          </div>

          <details class="g-panel" style="padding:18px">
            <summary class="cursor-pointer font-bold text-sm flex items-center justify-between gap-2" style="list-style:none">
              <div>
                <p class="r-kicker" style="margin:0">Estándar Oficial del Equipo</p>
                <span class="r-h3" style="font-size:1.08rem">📋 Guía de Nomenclatura MMT &amp; Escrutinio BoP</span>
              </div>
              <span class="font-mono text-xs text-[var(--r-accent)]">MMT_[MODELO]_[CIRCUITO]_[SESIÓN] ▾</span>
            </summary>
            <div class="mt-3 pt-3 border-t border-[var(--r-line)] text-xs space-y-2.5">
              <p class="font-mono text-[11px] p-2 rounded bg-[var(--r-bg-2)] border border-[var(--r-line)] text-[var(--r-accent)]">
                MMT_[MODELO]_[CIRCUITO]_[SESIÓN]_[VERSIÓN_OPCIONAL].sto
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]">
                <div>
                  <strong class="block text-[var(--r-text)] mb-1">Nomenclatura y Modificadores:</strong>
                  <ul class="space-y-0.5 text-[var(--r-muted)] font-mono">
                    <li><strong class="text-[var(--r-accent)]">Q / Q2</strong> → Quali 1 vuelta / 2 vueltas</li>
                    <li><strong class="text-[var(--r-accent)]">R</strong> → Race estándar / Sprint</li>
                    <li><strong class="text-[var(--r-accent)]">END</strong> → Endurance / Especiales</li>
                    <li><strong class="text-[var(--r-accent)]">W</strong> → Wet (Lluvia)</li>
                    <li><strong class="text-red-400 font-bold">_E</strong> → Modificador Esport (Nivel Pro / Superagresivo)</li>
                    <li><strong class="text-amber-400 font-bold">(sin letra)</strong> → Normal (Piloto Avanzado / Mejor ratio)</li>
                    <li><strong class="text-emerald-400 font-bold">_S</strong> → Modificador Safe (Principiante / Máxima estabilidad)</li>
                    <li><strong class="text-[var(--r-accent)]">V2, V3</strong> → Versión / Revisión BoP</li>
                  </ul>
                </div>
                <div>
                  <strong class="block text-[var(--r-text)] mb-1">Abreviaturas de Modelos MMT:</strong>
                  <ul class="space-y-0.5 text-[var(--r-muted)] font-mono">
                    <li><strong class="text-[var(--r-text)]">AMR / VALK</strong> · Aston Martin / Valkyrie</li>
                    <li><strong class="text-[var(--r-text)]">F296 / F499P</strong> · Ferrari GT3 / GTP</li>
                    <li><strong class="text-[var(--r-text)]">P911 / PORS / P963</strong> · Porsche GT3 / GTP</li>
                    <li><strong class="text-[var(--r-text)]">M4 / BMWH</strong> · BMW M4 GT3 / GTP</li>
                    <li><strong class="text-[var(--r-text)]">CADDY / Z06 / CHEVY</strong> · Cadillac / Corvette</li>
                    <li><strong class="text-[var(--r-text)]">HUR / LAMBO / MACLA</strong> · Lambo / McLaren</li>
                    <li><strong class="text-[var(--r-text)]">AMG / R8 / ACURA</strong> · Mercedes / Audi / Acura</li>
                    <li><strong class="text-[var(--r-text)]">SF23, F3, F4, FF1600, MX5</strong> · Escuela / Open</li>
                  </ul>
                </div>
              </div>
            </div>
          </details>
        </div>

        <div class="g-pills" aria-label="Categoría">
          <button type="button" id="catPill-all" class="mmt-cat-pill is-on" onclick="selectMmtCategory('all')">Todas</button>
          <button type="button" id="catPill-nec" class="mmt-cat-pill" onclick="selectMmtCategory('nec')">🏁 NEC · Nürburgring VLN</button>
          <button type="button" id="catPill-gtp" class="mmt-cat-pill" onclick="selectMmtCategory('gtp')">GTP</button>
          <button type="button" id="catPill-gt3" class="mmt-cat-pill" onclick="selectMmtCategory('gt3')">GT3</button>
          <button type="button" id="catPill-gt4" class="mmt-cat-pill" onclick="selectMmtCategory('gt4')">GT4</button>
          <button type="button" id="catPill-formulas" class="mmt-cat-pill" onclick="selectMmtCategory('formulas')">Fórmulas</button>
          <button type="button" id="catPill-cup" class="mmt-cat-pill" onclick="selectMmtCategory('cup')">Cup</button>
          <button type="button" id="catPill-mx5" class="mmt-cat-pill" onclick="selectMmtCategory('mx5')">MX-5</button>
        </div>
        <div class="g-filters">
          <div class="g-field">
            <label for="carSelect">Coche</label>
            <select id="carSelect" onchange="onFilterChange()"><option value="">Todos los coches</option></select>
          </div>
          <div class="g-field">
            <label for="seasonSelect">Temporada</label>
            <select id="seasonSelect" onchange="onFilterChange()"><option value="">Todas las temporadas</option></select>
          </div>
          <div class="g-field">
            <label for="weekSelect">Semana</label>
            <select id="weekSelect" onchange="onFilterChange()"><option value="">Todas las semanas</option></select>
          </div>
          <div class="g-field">
            <label for="circuitSelect">Circuito</label>
            <select id="circuitSelect" onchange="onFilterChange()"><option value="">Todos los circuitos</option></select>
          </div>
        </div>
        <div class="g-toolbar">
          <div class="g-search-wrap" style="flex:1;min-width:min(100%,220px)">
            <label class="visually-hidden" for="searchInput" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Buscar setups</label>
            <input id="searchInput" class="g-search" type="search" oninput="onSearchInput()" placeholder="Buscar por circuito, coche o tipo" />
          </div>
          <div class="g-field" style="min-width:160px">
            <label for="setupSort">Orden</label>
            <select id="setupSort" onchange="onFilterChange()">
              <option value="season">Temporada</option>
              <option value="circuit">Circuito</option>
              <option value="car">Coche</option>
              <option value="week">Semana</option>
            </select>
          </div>
          <div class="g-views" aria-label="Tipo de sesión">
            <button type="button" id="typeAll" class="is-on" onclick="setTypeFilter('')">Todos</button>
            <button type="button" id="typeRace" onclick="setTypeFilter('Race')">Race / End</button>
            <button type="button" id="typeQualy" onclick="setTypeFilter('Qualy')">Qualy</button>
            <button type="button" id="typeWet" onclick="setTypeFilter('Wet')">Wet</button>
          </div>
          <div class="g-views" aria-label="Vista del catálogo">
            <button type="button" id="viewModeFoldersBtn" class="is-on" onclick="setViewMode('folders')">Carpetas</button>
            <button type="button" id="viewModeListBtn" onclick="setViewMode('list')">Lista</button>
            <button type="button" id="viewModeFtpBtn" onclick="setViewMode('ftp')">Archivos</button>
          </div>
          <button type="button" id="toggleAllFoldersBtn" class="r-btn r-btn--sm" onclick="toggleAllFolderAccordions()"><span id="toggleAllFoldersText">Desplegar todo</span></button>
          <button type="button" class="r-btn r-btn--sm" onclick="resetGarageFilters()" title="Restablecer todos los filtros">Limpiar filtros</button>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 py-1">
          <p class="r-meta" style="margin:0"><span id="visibleFoldersCount">0</span> carpetas · <span id="visibleSetupsCount">0</span> setups verificados BoP (<span id="selectedBatchCount">0</span> seleccionados)</p>
          <div class="flex flex-wrap items-center gap-2">
