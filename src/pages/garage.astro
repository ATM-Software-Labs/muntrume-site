  <div id="changePasswordModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="changePwTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="changePwTitle">Nueva contraseña</h2>
        <button type="button" class="m-notice__close" onclick="closeChangePasswordModal()" aria-label="Cerrar">×</button>
      </div>
      <p>Elige una contraseña permanente para la cuenta.</p>
      <form id="changePasswordForm" onsubmit="handleChangePasswordSubmit(event)">
        <div class="g-field">
          <label for="newPassInput">Nueva contraseña</label>
