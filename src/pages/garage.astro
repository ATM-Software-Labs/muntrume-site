  <script is:inline>
    function switchGarageTab(tab) {
      var btnSetups = document.getElementById('tabBtnSetups');
      var btnTelemetry = document.getElementById('tabBtnTelemetry');
      var btnComms = document.getElementById('tabBtnComms');

      var secSetups = document.getElementById('garageSectionSetups');
      var secTelemetry = document.getElementById('garageSectionTelemetry');
      var secComms = document.getElementById('garageSectionComms');

      [btnSetups, btnTelemetry, btnComms].forEach(function(b) {
        b.classList.remove('bg-[#121A17]', 'text-[#00E699]', 'border', 'border-[#00E699]/40', 'shadow');
        b.classList.add('text-[#8B9A8F]');
      });

      if (secSetups) secSetups.classList.add('hidden');
      if (secTelemetry) secTelemetry.classList.add('hidden');
      if (secComms) secComms.classList.add('hidden');

      if (tab === 'setups') {
        btnSetups.classList.add('bg-[#121A17]', 'text-[#00E699]', 'border', 'border-[#00E699]/40', 'shadow');
        btnSetups.classList.remove('text-[#8B9A8F]');
        if (secSetups) secSetups.classList.remove('hidden');
      } else if (tab === 'telemetry') {
        btnTelemetry.classList.add('bg-[#121A17]', 'text-[#00E699]', 'border', 'border-[#00E699]/40', 'shadow');
        btnTelemetry.classList.remove('text-[#8B9A8F]');
        if (secTelemetry) secTelemetry.classList.remove('hidden');
      } else if (tab === 'comms') {
        btnComms.classList.add('bg-[#121A17]', 'text-[#00E699]', 'border', 'border-[#00E699]/40', 'shadow');
        btnComms.classList.remove('text-[#8B9A8F]');
        if (secComms) secComms.classList.remove('hidden');
      }
    }
    window.switchGarageTab = switchGarageTab;

    // Check URL parameters for tab
    document.addEventListener('DOMContentLoaded', function() {
      var p = new URLSearchParams(window.location.search);
      if (p.get('tab') === 'telemetry') switchGarageTab('telemetry');
      if (p.get('tab') === 'comms') switchGarageTab('comms');
    });
  </script>
