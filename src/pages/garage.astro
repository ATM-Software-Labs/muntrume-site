---
import Layout from '../layouts/Layout.astro';
import catalog from '../../public/assets/data/catalog_index.json';
import { PILOTOS } from '../lib/pilotos';

const pageTitle = "Garage | Muntrume Motorsport";
const pageDescription = "Muntrume Motorsport Setup Vault: over 41,000 .STO setups by car, circuit, and season, plus Garage 61 telemetry, Team Communications, and Dynamic Setup Builder.";
const fmt = (n: number) => n.toLocaleString('en-US');
const figs = [
  { n: fmt(catalog.total_setups), l: "Setups in the Vault" },
  { n: String(catalog.cars.length), l: "Supported Cars" },
  { n: String(catalog.circuits.length), l: "Calibrated Circuits" },
  { n: String(PILOTOS.length), l: "Official Drivers" },
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/garage">
  <section class="r-section g-hero" aria-labelledby="garageTitle">
    <div class="r-wrap">
      <p class="r-kicker">Setup Vault &amp; Team HQ</p>
      <h1 id="garageTitle" class="r-h2">Garage</h1>
      <p class="r-lead">Official .STO setups organized by car, circuit, and season. Driver account required for downloads. Files write directly to your local iRacing folder.</p>
      <div class="g-actions">
        <button type="button" class="r-btn r-btn--primary" onclick="openAuthModal('login')">Driver Sign In</button>
        <button type="button" class="r-btn" onclick="enterGuestPreview()">Browse Catalog</button>
        <a href="https://garage61.net/app/teams/muntrume-motorsport" target="_blank" rel="noopener noreferrer" class="r-btn">Garage 61 Telemetry ↗</a>
      </div>
      <div class="r-figs">
        {figs.map((f) => (<div><strong class="r-num">{f.n}</strong>{f.l}</div>))}
      </div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="saveTitle">
    <div class="r-wrap" style="display:grid;gap:var(--r-s4)">
      <div class="g-panel g-save" id="fsSavePanel">
        <div class="g-save__row">
          <div>
            <p class="r-kicker">Guardado</p>
            <h2 id="saveTitle" class="r-h3">Carpeta de iRacing</h2>
          </div>
          <button type="button" id="linkFolderBtn" class="r-btn r-btn--primary r-btn--sm" onclick="toggleLinkDirectory()">
            <span id="linkFolderText">Vincular carpeta de iRacing</span>
          </button>
        </div>
        <p id="metricDirectStatus" class="g-status">Sin carpeta vinculada</p>
        <p class="r-meta" style="margin:0">Si vinculas una carpeta, el archivo se escribe en tu ordenador. Muntrume no lo recibe.</p>

        <!-- Banner Inteligente Cyberpunk / Dark Mode para Navegadores Restrictivos (Brave) -->
        <div id="fsAccessNotice" class="p-4 rounded-xl bg-[#080C0A] border border-[#1E2A26] border-l-4 border-l-[#00ff88] shadow-[0_10px_30px_rgba(0,0,0,0.6)] space-y-3" role="alert" hidden>
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#00ff88] animate-ping" aria-hidden="true"></span>
              <span class="text-[11px] font-mono uppercase font-bold text-[#00ff88] tracking-wider">COMPATIBILIDAD DE NAVEGADOR · BRAVE / RESTRICTIVO</span>
            </div>
            <button type="button" id="fsNoticeDismiss" class="text-neutral-400 hover:text-white p-1 text-sm font-mono cursor-pointer transition" onclick="dismissFsAccessNotice()" aria-label="Cerrar aviso">✕</button>
          </div>
          <div class="space-y-2 text-xs">
            <p class="font-bold text-white text-sm" id="fsNoticeTitle">Guardado en carpeta local no disponible directamente</p>
            <div id="fsNoticeOther">
              <p class="text-neutral-400 leading-relaxed">Tu navegador actual no permite que las webs escriban directamente en carpetas del disco. Puedes <strong>descargar los setups de forma tradicional (.sto)</strong> en 1 clic o abrir el Setup Vault en Google Chrome o Microsoft Edge.</p>
            </div>
            <div id="fsNoticeBrave" hidden class="space-y-2.5">
              <p class="text-neutral-300 leading-relaxed">Brave desactiva por defecto la <em>File System Access API</em> por privacidad. Puedes activarla en 10 segundos o continuar con la descarga clásica:</p>
              <div class="p-2.5 rounded-lg bg-[#0E1513] border border-[#1E2A26] flex flex-wrap items-center justify-between gap-2 font-mono text-[11px]">
                <code class="text-[#00ff88] select-all">brave://flags/#file-system-access-api</code>
                <div class="relative inline-block">
                  <button type="button" id="copyFlagsBtn" onclick="copyBraveFlagUrlWithTooltip(this)" class="r-btn r-btn--sm" style="border-color:#00E699;color:#00E699;min-height:34px;padding:0 12px">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;flex-shrink:0"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <span>Copiar ruta de flags</span>
                  </button>
                  <span id="flagsTooltip" class="hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2.5 py-1 text-[10px] font-mono font-bold bg-[#00ff88] text-neutral-950 rounded shadow-md whitespace-nowrap animate-bounce">
                    ✓ ¡Copiado al portapapeles!
                  </span>
                </div>
              </div>
              <p class="text-[11px] text-neutral-400">Pega la ruta en una pestaña de Brave, pon la flag en <strong>Enabled</strong>, pulsa <strong>Relaunch</strong> y recarga.</p>
            </div>
          </div>
          <div class="pt-2 flex flex-wrap gap-2 items-center">
            <button type="button" class="r-btn r-btn--sm r-btn--primary" onclick="openFallbackDownloadModal()">Descarga tradicional directa</button>
            <button type="button" class="r-btn r-btn--sm" style="border-color:var(--r-line);color:var(--r-text)" onclick="copyVaultUrlForChrome()">Copiar enlace para Chrome / Edge</button>
          </div>
        </div>

        <div id="savedFolderReconnectBanner" class="m-notice m-notice--inline m-notice--info hidden" role="status">
          <span class="m-notice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 8h.01"/></svg>
          </span>
          <div class="m-notice__body">
            <p class="m-notice__title">Permiso de carpeta</p>
            <p class="m-notice__msg">Vuelve a permitir esta carpeta.</p>
            <p class="m-notice__msg" id="savedFolderNameLabel" data-no-i18n></p>
          </div>
          <button type="button" class="r-btn r-btn--sm" onclick="reconnectSavedDirectory()">Permitir</button>
        </div>
      </div>

      <div>
        <div class="r-head" style="margin-bottom:var(--r-s3)">
          <div>
            <p class="r-kicker">Método</p>
            <h2 class="r-h3">Cómo se guarda</h2>
          </div>
        </div>
        <ol class="g-steps">
          <li>
            <span>01</span>
            <h3 class="r-h3">Vincular la carpeta</h3>
            <p>Una vez, si el navegador lo permite: la carpeta de setups de iRacing, con permiso de lectura y escritura.</p>
          </li>
          <li>
            <span>02</span>
            <h3 class="r-h3">Elegir el setup</h3>
            <p>Filtra por coche, circuito y temporada. Clasificación, carrera o lluvia.</p>
          </li>
          <li>
            <span>03</span>
            <h3 class="r-h3">Guardar o descargar</h3>
            <p>Con la carpeta vinculada, el archivo entra en la ruta del coche. Si no, se descarga el .sto.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="r-section" aria-labelledby="vaultTitle">
    <div class="r-wrap" style="display:grid;gap:var(--r-s3)">
      <div class="g-toolbar">
        <div class="g-tabs" id="garageTabs" role="tablist" aria-label="Garage Sections">
          <button type="button" role="tab" aria-selected="true" aria-controls="garageSectionSetups" id="tabBtnSetups" class="is-on" onclick="switchGarageTab('setups')">Setups</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionTelemetry" id="tabBtnTelemetry" onclick="switchGarageTab('telemetry')">Telemetry</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionComms" id="tabBtnComms" onclick="switchGarageTab('comms')">Communications</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionBuilder" id="tabBtnBuilder" onclick="switchGarageTab('builder')">Setup Builder</button>
        </div>
        <div class="g-session">
          <span id="userEmailDisplay">Guest</span>
          <span id="userRoleBadge" class="g-badge">Catalog</span>
          <button type="button" id="logoutBtn" class="r-link hidden" onclick="handleLogout()">Sign Out</button>
          <button type="button" id="authBtn" class="r-btn r-btn--primary r-btn--sm" onclick="openAuthModal('login')">Driver Sign In</button>
        </div>
      </div>

      <div id="garageSectionSetups" role="tabpanel" aria-labelledby="tabBtnSetups" style="display:grid;gap:16px">
        <h2 id="vaultTitle" class="r-h3">Catálogo</h2>
        <div class="g-pills" aria-label="Categoría">
          <button type="button" id="catPill-all" class="mmt-cat-pill is-on" onclick="selectMmtCategory('all')">Todas</button>
          <button type="button" id="catPill-gtp" class="mmt-cat-pill" onclick="selectMmtCategory('gtp')">GTP</button>
          <button type="button" id="catPill-gt3" class="mmt-cat-pill" onclick="selectMmtCategory('gt3')">GT3</button>
          <button type="button" id="catPill-gt4" class="mmt-cat-pill" onclick="selectMmtCategory('gt4')">GT4</button>
          <button type="button" id="catPill-formulas" class="mmt-cat-pill" onclick="selectMmtCategory('formulas')">Fórmulas</button>
          <button type="button" id="catPill-cup" class="mmt-cat-pill" onclick="selectMmtCategory('cup')">Cup</button>
        </div>
        <div class="g-filters">
          <div class="g-field">
            <label for="carSelect">Coche</label>
            <select id="carSelect" onchange="onFilterChange()"><option value="">Todos los coches</option></select>
          </div>
          <div class="g-field">
            <label for="seasonSelect">Temporada</label>
            <select id="seasonSelect" onchange="onFilterChange()"><option value="">Todas las temporadas</option></select>
          </div>
          <div class="g-field">
            <label for="weekSelect">Semana</label>
            <select id="weekSelect" onchange="onFilterChange()"><option value="">Todas las semanas</option></select>
          </div>
          <div class="g-field">
            <label for="circuitSelect">Circuito</label>
            <select id="circuitSelect" onchange="onFilterChange()"><option value="">Todos los circuitos</option></select>
          </div>
        </div>
        <div class="g-toolbar">
          <div class="g-search-wrap" style="flex:1;min-width:min(100%,220px)">
            <label class="visually-hidden" for="searchInput" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Buscar setups</label>
            <input id="searchInput" class="g-search" type="search" oninput="onSearchInput()" placeholder="Buscar por circuito, coche o tipo" />
          </div>
          <div class="g-field" style="min-width:160px">
            <label for="setupSort">Orden</label>
            <select id="setupSort" onchange="onFilterChange()">
              <option value="season">Temporada</option>
              <option value="circuit">Circuito</option>
              <option value="car">Coche</option>
              <option value="week">Semana</option>
            </select>
          </div>
          <div class="g-views" aria-label="Vista del catálogo">
            <button type="button" id="viewModeFoldersBtn" class="is-on" onclick="setViewMode('folders')">Carpetas</button>
            <button type="button" id="viewModeListBtn" onclick="setViewMode('list')">Lista</button>
            <button type="button" id="viewModeFtpBtn" onclick="setViewMode('ftp')">Archivos</button>
          </div>
          <button type="button" id="toggleAllFoldersBtn" class="r-btn r-btn--sm" onclick="toggleAllFolderAccordions()"><span id="toggleAllFoldersText">Desplegar todo</span></button>
        </div>
        <p class="r-meta" style="margin:0"><span id="visibleFoldersCount">0</span> carpetas · <span id="visibleSetupsCount">0</span> setups</p>
        <div id="setupsContainer">
          <p id="setupsLoading" class="r-empty">Pulsa «Ver catálogo» o entra con tu cuenta para cargar los setups.</p>
          <div id="setupsGrid" class="g-setups"></div>
          <p id="emptyState" class="r-empty hidden">Ningún setup coincide. Prueba otro coche, circuito o temporada.</p>
          <div id="loadMoreContainer" class="hidden" style="text-align:center">
            <button type="button" class="r-btn r-btn--sm" onclick="loadMoreFolders()"><span id="loadMoreBtnText">Mostrar más</span></button>
          </div>
        </div>
      </div>

      <div id="garageSectionTelemetry" class="hidden" role="tabpanel" aria-labelledby="tabBtnTelemetry" hidden>
        <div class="g-panel">
          <div class="g-panel__head">
            <div>
              <p class="r-kicker">60 Hz Data &amp; Laps</p>
              <h2 class="r-h3">Garage 61 Official Team Telemetry</h2>
            </div>
            <a class="r-btn r-btn--primary r-btn--sm" href="https://garage61.net/app/teams/muntrume-motorsport" target="_blank" rel="noopener noreferrer">Open Garage 61 Team Hub ↗</a>
          </div>
          <p>Official Muntrume Motorsport lap telemetry, sector deltas, and fuel data are hosted on Garage 61 (<code style="color:#00E699">garage61.net/app/teams/muntrume-motorsport</code>). Direct access is always guaranteed below, and you can optionally link your personal Garage 61 API token in this browser.</p>
          <div class="g-actions">
            <a class="r-btn r-btn--primary r-btn--sm" href="https://garage61.net/app/teams/muntrume-motorsport" target="_blank" rel="noopener noreferrer">Launch Muntrume Motorsport on Garage 61 ↗</a>
            <button type="button" class="r-btn r-btn--sm" onclick="configureG61TokenPrompt()">Configure Personal Garage 61 Token</button>
          </div>
        </div>
      </div>

      <div id="garageSectionComms" class="hidden" role="tabpanel" aria-labelledby="tabBtnComms" hidden>
        <div class="g-panel">
          <div class="g-panel__head">
            <div>
              <p class="r-kicker">Team HQ &amp; Mail</p>
              <h2 class="r-h3">Communications &amp; Corporate Webmail</h2>
            </div>
            <a class="r-btn r-btn--primary r-btn--sm" href="https://mail.trujillomingorance.com" target="_blank" rel="noopener noreferrer">Corporate Webmail ↗</a>
          </div>
          <p>Endurance race briefings, stint strategy dispatches, and official corporate email (<code style="color:#00E699">mail.trujillomingorance.com</code>). The internal driver mailbox syncs automatically with your active Garage session.</p>
          <div class="g-actions">
            <a class="r-btn r-btn--primary r-btn--sm" href="https://mail.trujillomingorance.com" target="_blank" rel="noopener noreferrer">Open Corporate Webmail (mail.trujillomingorance.com) ↗</a>
            <a class="r-btn r-btn--sm" href="/communications">Open Internal Driver Inbox →</a>
            <button type="button" class="r-btn r-btn--sm" onclick="openAuthModal('login')">Driver Sign In</button>
          </div>
        </div>
      </div>

      <div id="garageSectionBuilder" class="hidden" role="tabpanel" aria-labelledby="tabBtnBuilder" hidden>
        <div class="g-panel" id="builderPanel">
          <div class="g-panel__head">
            <div>
              <p class="r-kicker">Dynamic .STO Assembler</p>
              <h2 class="r-h3" id="builderTitle">Setup Builder</h2>
              <p>Select a vehicle and Road circuit from the catalog or type a custom combination across Qualy, Race, Wet, and Endurance sessions.</p>
            </div>
            <a class="r-link" href="/setup-builder">Open Full-Screen Builder →</a>
          </div>
          <div id="builderGate">
            <p class="r-meta">Sign in with your driver account to download assembled .sto packages.</p>
            <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAuthModal('login')">Driver Sign In</button>
          </div>
          <form id="builderForm">
            <div class="sb-grid">
              <div class="sb-col">
                <div class="sb-col__head">
                  <span class="sb-col__step">01</span>
                  <div>
                    <h3 class="sb-col__title">Vehicle Selection</h3>
                    <p class="sb-col__sub">Catalog dropdown or free-text model</p>
                  </div>
                </div>
                <div class="g-field">
                  <label for="builderCar">Catalog Car</label>
                  <select id="builderCar"><option value="">Select car from catalog...</option></select>
                </div>
                <div class="g-field">
                  <label for="builderCarText">Or type car name</label>
                  <input id="builderCarText" type="text" autocomplete="off" placeholder="e.g. Ferrari 296 GT3, Mustang GT3" />
                </div>
              </div>
              <div class="sb-col">
                <div class="sb-col__head">
                  <span class="sb-col__step">02</span>
                  <div>
                    <h3 class="sb-col__title">Road Circuit Selection</h3>
                    <p class="sb-col__sub">Catalog dropdown or free-text track</p>
                  </div>
                </div>
                <div class="g-field">
                  <label for="builderTrack">Catalog Circuit</label>
                  <select id="builderTrack"><option value="">Select circuit from catalog...</option></select>
                </div>
                <div class="g-field">
                  <label for="builderTrackText">Or type circuit name</label>
                  <input id="builderTrackText" type="text" autocomplete="off" placeholder="e.g. Spa-Francorchamps, Le Mans" />
                </div>
              </div>
            </div>
            <div class="sb-sessions-box">
              <div class="sb-col__head" style="margin-bottom:10px">
                <span class="sb-col__step">03</span>
                <div>
                  <h3 class="sb-col__title">Setup Session Types</h3>
                  <p class="sb-col__sub">Select session configurations (Qualy, Race, Wet, Endurance)</p>
                </div>
              </div>
              <div id="builderSessions" class="sb-sessions-grid" role="group" aria-label="Sessions">
                <button type="button" class="g-chip sb-chip" data-session="qualy" aria-pressed="true">
                  <span class="sb-chip__dot"></span>
                  <span class="sb-chip__name">Qualy</span>
                  <span class="sb-chip__meta">Low fuel · Peak grip</span>
                </button>
                <button type="button" class="g-chip sb-chip" data-session="race" aria-pressed="true">
                  <span class="sb-chip__dot"></span>
                  <span class="sb-chip__name">Race</span>
                  <span class="sb-chip__meta">Full tank · Race pace</span>
                </button>
                <button type="button" class="g-chip sb-chip" data-session="wet" aria-pressed="false">
                  <span class="sb-chip__dot"></span>
                  <span class="sb-chip__name">Wet</span>
                  <span class="sb-chip__meta">Rain tyres · Wet balance</span>
                </button>
                <button type="button" class="g-chip sb-chip" data-session="endurance" aria-pressed="false">
                  <span class="sb-chip__dot"></span>
                  <span class="sb-chip__name">Endurance</span>
                  <span class="sb-chip__meta">Multi-stint · Tyre life</span>
                </button>
              </div>
            </div>
            <div class="g-actions">
              <button type="submit" id="builderSubmit" class="r-btn r-btn--primary r-btn--sm">Build Setups →</button>
              <button type="button" id="builderDownload" class="r-btn r-btn--sm" hidden>Download .STO</button>
            </div>
            <div id="builderAnswer" class="builder-md" hidden aria-live="polite"></div>
            <div id="builderSources" class="builder-sources"></div>
          </form>
        </div>
      </div>

      <div id="vaultLanding" class="hidden"></div>
      <div id="vaultDashboard" class="hidden"></div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="garageLegal">
    <div class="r-wrap lg-wrap">
      <p class="r-kicker">Uso de los setups</p>
      <h2 id="garageLegal" class="r-h3">Propiedad y uso permitido</h2>
      <div class="lg-body">
        <p>Los archivos de setup (.sto) y la telemetría de este Garage son de Muntrume Motorsport. El acceso es personal e intransferible, solo para pilotos autorizados. No se pueden redistribuir sin autorización escrita.</p>
        <p>Si el navegador escribe el archivo en una carpeta de tu ordenador, ese archivo no se sube a Muntrume. La descarga también se queda en tu equipo.</p>
        <p class="g-links"><a class="r-link" href="/aviso-legal">Aviso legal</a><a class="r-link" href="/privacidad">Privacidad</a></p>
        <p class="r-meta">Este texto es informativo y no constituye asesoramiento jurídico.</p>
      </div>
    </div>
  </section>

  <div id="authModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="authTitle">Acceso de piloto</h2>
        <button type="button" class="m-notice__close" onclick="closeAuthModal()" aria-label="Cerrar">×</button>
      </div>
      <div class="g-auth-tabs">
        <button type="button" id="tabLoginBtn" class="is-on" onclick="switchAuthTab('login')">Entrar</button>
        <button type="button" id="tabJoinBtn" onclick="switchAuthTab('join')">Solicitar acceso</button>
      </div>
      <form id="loginForm" onsubmit="handleLoginSubmit(event)">
        <div class="g-field">
          <label for="loginEmail">Correo</label>
          <input type="email" id="loginEmail" required autocomplete="username" placeholder="tu-email@dominio.com" />
        </div>
        <div class="g-field">
          <label for="loginKey">Contraseña</label>
          <div class="g-pass">
            <input type="password" id="loginKey" required autocomplete="current-password" placeholder="Contraseña de piloto" />
            <button type="button" class="g-pass__toggle" aria-controls="loginKey" aria-pressed="false" onclick="togglePassword('loginKey', this)">Mostrar</button>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;align-items:center">
          <label class="g-check" for="rememberMe"><input type="checkbox" id="rememberMe" checked /> Recordar sesión</label>
          <button type="button" class="r-link" onclick="openForgotPasswordModal()">¿Olvidaste la contraseña?</button>
        </div>
        <div id="loginError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
        <button type="submit" id="loginSubmitBtn" class="r-btn r-btn--primary"><span id="loginBtnText">Entrar</span></button>
      </form>
      <form id="joinForm" class="hidden" onsubmit="handleJoinSubmit(event)">
        <p>¿Quieres acceso al Garage? Deja tu nombre y el correo de iRacing.</p>
        <div class="g-field">
          <label for="reqName">Nombre de piloto</label>
          <input type="text" id="reqName" required placeholder="Nombre o nick" />
        </div>
        <div class="g-field">
          <label for="reqEmail">Correo</label>
          <input type="email" id="reqEmail" required placeholder="tu-email@dominio.com" />
        </div>
        <div class="g-field">
          <label for="reqMessage">Mensaje</label>
          <textarea id="reqMessage" rows="3" placeholder="Coche, categoría o lo que quieras comentar"></textarea>
        </div>
        <input type="hidden" id="reqIracingId" value="" />
        <input type="hidden" id="reqCategory" value="" />
        <input type="hidden" id="reqWebsite" value="" />
        <div id="joinFeedback" class="m-notice m-notice--inline m-notice--success hidden" role="status"></div>
        <div id="joinError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
        <button type="submit" id="joinSubmitBtn" class="r-btn r-btn--primary"><span id="joinBtnText">Solicitar acceso</span></button>
      </form>
