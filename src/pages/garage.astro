---
import Layout from '../layouts/Layout.astro';
import catalog from '../../public/assets/data/catalog_index.json';
import { PILOTOS } from '../lib/pilotos';

const pageTitle = "Garage | Muntrume Motorsport — Setup Vault";
const pageDescription = "Setup Vault de Muntrume Motorsport: setups .STO por coche, circuito y temporada. La descarga exige cuenta de piloto. Si el archivo se guarda en tu carpeta, no se sube.";
const fmt = (n: number) => n.toLocaleString('es-ES');
const figs = [
  { n: fmt(catalog.total_setups), l: "Setups en el catálogo" },
  { n: String(catalog.cars.length), l: "Coches" },
  { n: String(catalog.circuits.length), l: "Circuitos" },
  { n: String(PILOTOS.length), l: "Pilotos" },
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/garage">
  <section class="r-section g-hero" aria-labelledby="garageTitle">
    <div class="r-wrap">
      <p class="r-kicker">Setup Vault</p>
      <h1 id="garageTitle" class="r-h2">Garage</h1>
      <p class="r-lead">Setups .STO del equipo, por coche, circuito y temporada. Descargar exige cuenta de piloto. El archivo se queda en tu ordenador.</p>
      <div class="g-actions">
        <button type="button" class="r-btn r-btn--primary" onclick="openAuthModal('login')">Acceso de piloto</button>
        <button type="button" class="r-btn" onclick="enterGuestPreview()">Ver catálogo</button>
      </div>
      <div class="r-figs">
        {figs.map((f) => (<div><strong class="r-num">{f.n}</strong>{f.l}</div>))}
      </div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="saveTitle">
    <div class="r-wrap" style="display:grid;gap:var(--r-s4)">
      <div class="g-panel g-save" id="fsSavePanel">
        <div class="g-save__row">
          <div>
            <p class="r-kicker">Guardado</p>
            <h2 id="saveTitle" class="r-h3">Carpeta de iRacing</h2>
          </div>
          <button type="button" id="linkFolderBtn" class="r-btn r-btn--primary r-btn--sm" onclick="toggleLinkDirectory()">
            <span id="linkFolderText">Vincular carpeta de iRacing</span>
          </button>
        </div>
        <p id="metricDirectStatus" class="g-status">Sin carpeta vinculada</p>
        <p class="r-meta" style="margin:0">Si vinculas una carpeta, el archivo se escribe en tu ordenador. Muntrume no lo recibe.</p>

        <div id="fsAccessNotice" class="m-notice m-notice--inline m-notice--warning" role="alert" hidden>
          <span class="m-notice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4l9 16H3L12 4z"/><path d="M12 10v4M12 16.5h.01"/></svg>
          </span>
          <div class="m-notice__body">
            <p class="m-notice__title">Guardado en carpeta no disponible</p>
            <div id="fsNoticeOther">
              <p class="m-notice__msg">Este navegador no incluye el guardado directo en una carpeta. Puedes descargar el archivo .sto, o abrir el Garage en Microsoft Edge o Google Chrome.</p>
            </div>
            <div id="fsNoticeBrave" hidden>
              <p class="m-notice__msg">En Brave el acceso a carpetas está desactivado. Puedes activar la opción experimental o usar Microsoft Edge o Google Chrome.</p>
              <details>
                <summary>Cómo activarlo</summary>
                <ol>
                  <li>Abre una pestaña nueva en Brave con esta dirección.</li>
                  <li><code>brave://flags/#file-system-access-api</code></li>
                  <li>Pon File System Access API en Enabled.</li>
                  <li>Pulsa Relaunch.</li>
                  <li>Vuelve al Garage y vincula la carpeta.</li>
                </ol>
                <p class="r-meta" style="margin:8px 0 0">Brave avisa de que las opciones de esa página son experimentales.</p>
                <button type="button" class="r-link" onclick="copyBraveFlagUrl()">Copiar dirección</button>
              </details>
            </div>
          </div>
          <button type="button" id="fsNoticeDismiss" class="m-notice__close" onclick="dismissFsAccessNotice()" aria-label="Cerrar aviso"><span aria-hidden="true">×</span></button>
        </div>

        <div id="savedFolderReconnectBanner" class="m-notice m-notice--inline m-notice--info hidden" role="status">
          <span class="m-notice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 8h.01"/></svg>
          </span>
          <div class="m-notice__body">
            <p class="m-notice__title">Permiso de carpeta</p>
            <p class="m-notice__msg">Vuelve a permitir esta carpeta.</p>
            <p class="m-notice__msg" id="savedFolderNameLabel" data-no-i18n></p>
          </div>
          <button type="button" class="r-btn r-btn--sm" onclick="reconnectSavedDirectory()">Permitir</button>
        </div>
      </div>

      <div>
        <div class="r-head" style="margin-bottom:var(--r-s3)">
          <div>
            <p class="r-kicker">Método</p>
            <h2 class="r-h3">Cómo se guarda</h2>
          </div>
        </div>
        <ol class="g-steps">
          <li>
            <span>01</span>
            <h3 class="r-h3">Vincular la carpeta</h3>
            <p>Una vez, si el navegador lo permite: la carpeta de setups de iRacing, con permiso de lectura y escritura.</p>
          </li>
          <li>
            <span>02</span>
            <h3 class="r-h3">Elegir el setup</h3>
            <p>Filtra por coche, circuito y temporada. Clasificación, carrera o lluvia.</p>
          </li>
          <li>
            <span>03</span>
            <h3 class="r-h3">Guardar o descargar</h3>
            <p>Con la carpeta vinculada, el archivo entra en la ruta del coche. Si no, se descarga el .sto.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="r-section" aria-labelledby="vaultTitle">
    <div class="r-wrap" style="display:grid;gap:var(--r-s3)">
      <div class="g-toolbar">
        <div class="g-tabs" id="garageTabs" role="tablist" aria-label="Secciones del Garage">
          <button type="button" role="tab" aria-selected="true" aria-controls="garageSectionSetups" id="tabBtnSetups" class="is-on" onclick="switchGarageTab('setups')">Setups</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionTelemetry" id="tabBtnTelemetry" onclick="switchGarageTab('telemetry')">Telemetría</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionComms" id="tabBtnComms" onclick="switchGarageTab('comms')">Comunicación</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="garageSectionBuilder" id="tabBtnBuilder" onclick="switchGarageTab('builder')">Montador</button>
        </div>
        <div class="g-session">
          <span id="userEmailDisplay">Invitado</span>
          <span id="userRoleBadge" class="g-badge">Catálogo</span>
          <button type="button" id="logoutBtn" class="r-link hidden" onclick="handleLogout()">Salir</button>
          <button type="button" id="authBtn" class="r-btn r-btn--primary r-btn--sm" onclick="openAuthModal('login')">Acceso de piloto</button>
        </div>
      </div>

      <div id="garageSectionSetups" role="tabpanel" aria-labelledby="tabBtnSetups" style="display:grid;gap:16px">
        <h2 id="vaultTitle" class="r-h3">Catálogo</h2>
        <div class="g-pills" aria-label="Categoría">
          <button type="button" id="catPill-all" class="mmt-cat-pill is-on" onclick="selectMmtCategory('all')">Todas</button>
          <button type="button" id="catPill-gtp" class="mmt-cat-pill" onclick="selectMmtCategory('gtp')">GTP</button>
          <button type="button" id="catPill-gt3" class="mmt-cat-pill" onclick="selectMmtCategory('gt3')">GT3</button>
          <button type="button" id="catPill-gt4" class="mmt-cat-pill" onclick="selectMmtCategory('gt4')">GT4</button>
          <button type="button" id="catPill-formulas" class="mmt-cat-pill" onclick="selectMmtCategory('formulas')">Fórmulas</button>
          <button type="button" id="catPill-cup" class="mmt-cat-pill" onclick="selectMmtCategory('cup')">Cup</button>
        </div>
        <div class="g-filters">
          <div class="g-field">
            <label for="carSelect">Coche</label>
            <select id="carSelect" onchange="onFilterChange()"><option value="">Todos los coches</option></select>
          </div>
          <div class="g-field">
            <label for="seasonSelect">Temporada</label>
            <select id="seasonSelect" onchange="onFilterChange()"><option value="">Todas las temporadas</option></select>
          </div>
          <div class="g-field">
            <label for="weekSelect">Semana</label>
            <select id="weekSelect" onchange="onFilterChange()"><option value="">Todas las semanas</option></select>
          </div>
          <div class="g-field">
            <label for="circuitSelect">Circuito</label>
            <select id="circuitSelect" onchange="onFilterChange()"><option value="">Todos los circuitos</option></select>
          </div>
        </div>
        <div class="g-toolbar">
          <div class="g-search-wrap" style="flex:1;min-width:min(100%,220px)">
            <label class="visually-hidden" for="searchInput" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Buscar setups</label>
            <input id="searchInput" class="g-search" type="search" oninput="onSearchInput()" placeholder="Buscar por circuito, coche o tipo" />
          </div>
          <div class="g-field" style="min-width:160px">
            <label for="setupSort">Orden</label>
            <select id="setupSort" onchange="onFilterChange()">
              <option value="season">Temporada</option>
              <option value="circuit">Circuito</option>
              <option value="car">Coche</option>
              <option value="week">Semana</option>
            </select>
          </div>
          <div class="g-views" aria-label="Vista del catálogo">
            <button type="button" id="viewModeFoldersBtn" class="is-on" onclick="setViewMode('folders')">Carpetas</button>
            <button type="button" id="viewModeListBtn" onclick="setViewMode('list')">Lista</button>
            <button type="button" id="viewModeFtpBtn" onclick="setViewMode('ftp')">Archivos</button>
          </div>
          <button type="button" id="toggleAllFoldersBtn" class="r-btn r-btn--sm" onclick="toggleAllFolderAccordions()"><span id="toggleAllFoldersText">Desplegar todo</span></button>
        </div>
        <p class="r-meta" style="margin:0"><span id="visibleFoldersCount">0</span> carpetas · <span id="visibleSetupsCount">0</span> setups</p>
        <div id="setupsContainer">
          <p id="setupsLoading" class="r-empty">Pulsa «Ver catálogo» o entra con tu cuenta para cargar los setups.</p>
          <div id="setupsGrid" class="g-setups"></div>
          <p id="emptyState" class="r-empty hidden">Ningún setup coincide. Prueba otro coche, circuito o temporada.</p>
          <div id="loadMoreContainer" class="hidden" style="text-align:center">
            <button type="button" class="r-btn r-btn--sm" onclick="loadMoreFolders()"><span id="loadMoreBtnText">Mostrar más</span></button>
          </div>
        </div>
      </div>

      <div id="garageSectionTelemetry" class="hidden" role="tabpanel" aria-labelledby="tabBtnTelemetry" hidden>
        <div class="g-panel">
          <div class="g-panel__head">
            <div>
              <p class="r-kicker">Datos</p>
              <h2 class="r-h3">Telemetría</h2>
            </div>
            <a class="r-link" href="https://garage61.net/app/teams/muntrume" target="_blank" rel="noopener noreferrer">Abrir Garage 61</a>
          </div>
          <p>Las vueltas del equipo se consultan en Garage 61. El token personal se guarda solo en este navegador y se usa para leer vueltas.</p>
          <button type="button" class="r-btn r-btn--sm" onclick="configureG61TokenPrompt()">Configurar token de Garage 61</button>
        </div>
      </div>

      <div id="garageSectionComms" class="hidden" role="tabpanel" aria-labelledby="tabBtnComms" hidden>
        <div class="g-panel">
          <div>
            <p class="r-kicker">Equipo</p>
            <h2 class="r-h3">Comunicación</h2>
          </div>
          <p>Briefings de resistencia, estrategia y correo del equipo. El buzón de piloto se abre con la misma cuenta del Garage.</p>
          <div class="g-actions">
            <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAuthModal('login')">Entrar</button>
            <a class="r-btn r-btn--sm" href="/mail">Webmail</a>
          </div>
        </div>
      </div>

      <div id="garageSectionBuilder" class="hidden" role="tabpanel" aria-labelledby="tabBtnBuilder" hidden>
        <div class="g-panel" id="builderPanel">
          <div>
            <p class="r-kicker">Área de piloto</p>
            <h2 class="r-h3" id="builderTitle">Montador de setups</h2>
            <p>Pide una combinación del catálogo. La respuesta usa los setups del equipo. Garage 61 no permite subir un setup desde aquí.</p>
          </div>
          <div id="builderGate">
            <p class="r-meta">Entra con tu cuenta de piloto para usar el montador.</p>
            <button type="button" class="r-btn r-btn--primary r-btn--sm" onclick="openAuthModal('login')">Acceso de piloto</button>
          </div>
          <form id="builderForm" hidden>
            <div class="g-filters">
              <div class="g-field">
                <label for="builderCar">Coche del catálogo</label>
                <select id="builderCar"><option value="">Elegir coche</option></select>
              </div>
              <div class="g-field">
                <label for="builderCarText">O escribe el coche</label>
                <input id="builderCarText" type="text" autocomplete="off" placeholder="Ferrari 296 GT3" />
              </div>
              <div class="g-field">
                <label for="builderTrack">Circuito del catálogo</label>
                <select id="builderTrack"><option value="">Elegir circuito</option></select>
              </div>
              <div class="g-field">
                <label for="builderTrackText">O escribe el circuito</label>
                <input id="builderTrackText" type="text" autocomplete="off" placeholder="Spa" />
              </div>
            </div>
            <div id="builderSessions" role="group" aria-label="Sesiones" style="display:flex;flex-wrap:wrap;gap:8px">
              <button type="button" class="g-chip" data-session="qualy" aria-pressed="true">Qualy</button>
              <button type="button" class="g-chip" data-session="race" aria-pressed="true">Carrera</button>
              <button type="button" class="g-chip" data-session="wet" aria-pressed="false">Mojado</button>
              <button type="button" class="g-chip" data-session="endurance" aria-pressed="false">Endurance</button>
            </div>
            <div class="g-actions">
              <button type="submit" id="builderSubmit" class="r-btn r-btn--primary r-btn--sm">Pedir setups</button>
              <button type="button" id="builderDownload" class="r-btn r-btn--sm" hidden>Descargar</button>
            </div>
            <div id="builderAnswer" class="builder-md" hidden aria-live="polite"></div>
            <div id="builderSources" class="builder-sources"></div>
          </form>
        </div>
      </div>

      <div id="vaultLanding" class="hidden"></div>
      <div id="vaultDashboard" class="hidden"></div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="garageLegal">
    <div class="r-wrap lg-wrap">
      <p class="r-kicker">Uso de los setups</p>
      <h2 id="garageLegal" class="r-h3">Propiedad y uso permitido</h2>
      <div class="lg-body">
        <p>Los archivos de setup (.sto) y la telemetría de este Garage son de Muntrume Motorsport. El acceso es personal e intransferible, solo para pilotos autorizados. No se pueden redistribuir sin autorización escrita.</p>
        <p>Si el navegador escribe el archivo en una carpeta de tu ordenador, ese archivo no se sube a Muntrume. La descarga también se queda en tu equipo.</p>
        <p class="g-links"><a class="r-link" href="/aviso-legal">Aviso legal</a><a class="r-link" href="/privacidad">Privacidad</a></p>
        <p class="r-meta">Este texto es informativo y no constituye asesoramiento jurídico.</p>
      </div>
    </div>
  </section>

  <div id="authModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="authTitle">Acceso de piloto</h2>
        <button type="button" class="m-notice__close" onclick="closeAuthModal()" aria-label="Cerrar">×</button>
      </div>
      <div class="g-auth-tabs">
        <button type="button" id="tabLoginBtn" class="is-on" onclick="switchAuthTab('login')">Entrar</button>
        <button type="button" id="tabJoinBtn" onclick="switchAuthTab('join')">Solicitar acceso</button>
      </div>
      <form id="loginForm" onsubmit="handleLoginSubmit(event)">
        <div class="g-field">
          <label for="loginEmail">Correo</label>
          <input type="email" id="loginEmail" required autocomplete="username" placeholder="tu-email@dominio.com" />
        </div>
        <div class="g-field">
          <label for="loginKey">Contraseña</label>
          <div class="g-pass">
            <input type="password" id="loginKey" required autocomplete="current-password" placeholder="Contraseña de piloto" />
            <button type="button" class="g-pass__toggle" aria-controls="loginKey" aria-pressed="false" onclick="togglePassword('loginKey', this)">Mostrar</button>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;align-items:center">
          <label class="g-check" for="rememberMe"><input type="checkbox" id="rememberMe" checked /> Recordar sesión</label>
          <button type="button" class="r-link" onclick="openForgotPasswordModal()">¿Olvidaste la contraseña?</button>
        </div>
        <div id="loginError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
        <button type="submit" id="loginSubmitBtn" class="r-btn r-btn--primary"><span id="loginBtnText">Entrar</span></button>
      </form>
      <form id="joinForm" class="hidden" onsubmit="handleJoinSubmit(event)">
        <p>¿Quieres acceso al Garage? Deja tu nombre y el correo de iRacing.</p>
        <div class="g-field">
          <label for="reqName">Nombre de piloto</label>
          <input type="text" id="reqName" required placeholder="Nombre o nick" />
        </div>
        <div class="g-field">
          <label for="reqEmail">Correo</label>
          <input type="email" id="reqEmail" required placeholder="tu-email@dominio.com" />
        </div>
        <div class="g-field">
          <label for="reqMessage">Mensaje</label>
          <textarea id="reqMessage" rows="3" placeholder="Coche, categoría o lo que quieras comentar"></textarea>
        </div>
        <input type="hidden" id="reqIracingId" value="" />
        <input type="hidden" id="reqCategory" value="" />
        <input type="hidden" id="reqWebsite" value="" />
        <div id="joinFeedback" class="m-notice m-notice--inline m-notice--success hidden" role="status"></div>
        <div id="joinError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
        <button type="submit" id="joinSubmitBtn" class="r-btn r-btn--primary"><span id="joinBtnText">Solicitar acceso</span></button>
      </form>
    </div>
  </div>

  <div id="previewModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="previewModalTitle">
    <div class="g-dialog g-dialog--wide">
      <div class="g-dialog__bar">
        <h2 id="previewModalTitle">Vista del setup</h2>
        <button type="button" class="m-notice__close" onclick="closeSetupPreviewModal()" aria-label="Cerrar">×</button>
      </div>
      <div id="previewModalBody">Cargando el setup…</div>
    </div>
  </div>

  <div id="forgotPasswordModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="forgotTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="forgotTitle">Recuperar acceso</h2>
        <button type="button" class="m-notice__close" onclick="closeForgotPasswordModal()" aria-label="Cerrar">×</button>
      </div>
      <p>Escribe el correo de la cuenta. Te enviaremos un enlace para elegir contraseña.</p>
      <div class="g-field">
        <label for="forgotEmail">Correo</label>
        <input type="email" id="forgotEmail" placeholder="tu-email@dominio.com" />
      </div>
      <div id="forgotError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
      <div id="forgotFeedback" class="m-notice m-notice--inline m-notice--success hidden" role="status"></div>
      <button type="button" id="forgotSubmitBtn" class="r-btn r-btn--primary" onclick="handleForgotPasswordSubmit(event)">Enviar enlace</button>
    </div>
  </div>

  <div id="setPasswordModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="setPwTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="setPwTitle">Crea tu contraseña</h2>
        <button type="button" class="m-notice__close" onclick="closeSetPasswordModal()" aria-label="Cerrar">×</button>
      </div>
      <p id="setPwIntro">Comprobando el enlace…</p>
      <form id="setPasswordForm" class="hidden" onsubmit="handleSetPasswordSubmit(event)">
        <div class="g-field">
          <label for="setPwNew">Nueva contraseña</label>
          <input type="password" id="setPwNew" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Mínimo 10 caracteres" />
        </div>
        <div class="g-field">
          <label for="setPwConfirm">Confirmar contraseña</label>
          <input type="password" id="setPwConfirm" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Repite la contraseña" />
        </div>
        <button type="submit" id="setPwBtn" class="r-btn r-btn--primary">Guardar y entrar</button>
      </form>
      <div id="setPwError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
    </div>
  </div>

  <div id="changePasswordModal" class="g-modal hidden" role="dialog" aria-modal="true" aria-labelledby="changePwTitle">
    <div class="g-dialog">
      <div class="g-dialog__bar">
        <h2 id="changePwTitle">Nueva contraseña</h2>
        <button type="button" class="m-notice__close" onclick="closeChangePasswordModal()" aria-label="Cerrar">×</button>
      </div>
      <p>Elige una contraseña permanente para la cuenta.</p>
      <form id="changePasswordForm" onsubmit="handleChangePasswordSubmit(event)">
        <div class="g-field">
          <label for="newPassInput">Nueva contraseña</label>
          <input type="password" id="newPassInput" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Mínimo 10 caracteres" />
        </div>
        <div class="g-field">
          <label for="confirmPassInput">Confirmar contraseña</label>
          <input type="password" id="confirmPassInput" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Repite la contraseña" />
        </div>
        <div id="changePassError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
        <button type="submit" id="changePassBtn" class="r-btn r-btn--primary">Guardar</button>
      </form>
    </div>
  </div>

  <script is:inline src="/assets/js/setups.js?v=t276"></script>
  <script is:inline src="/assets/js/setup-builder.js?v=t276" defer></script>
  <script is:inline>
    window.togglePassword = function (id, btn) {
      var input = document.getElementById(id);
      if (!input || !btn) return;
      var show = input.type === "password";
      input.type = show ? "text" : "password";
      btn.textContent = show ? "Ocultar" : "Mostrar";
      btn.setAttribute("aria-pressed", show ? "true" : "false");
    };
    function switchGarageTab(tab) {
      var map = {
        setups: ["tabBtnSetups", "garageSectionSetups"],
        telemetry: ["tabBtnTelemetry", "garageSectionTelemetry"],
        comms: ["tabBtnComms", "garageSectionComms"],
        builder: ["tabBtnBuilder", "garageSectionBuilder"]
      };
      var buttons = ["tabBtnSetups", "tabBtnTelemetry", "tabBtnComms", "tabBtnBuilder"].map(function (id) { return document.getElementById(id); });
      var sections = ["garageSectionSetups", "garageSectionTelemetry", "garageSectionComms", "garageSectionBuilder"].map(function (id) { return document.getElementById(id); });
      var chosen = map[tab] || map.setups;
      buttons.forEach(function (b) {
        if (!b) return;
        var on = b.id === chosen[0];
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      sections.forEach(function (s) {
        if (!s) return;
        var on = s.id === chosen[1];
        s.classList.toggle("hidden", !on);
        s.hidden = !on;
      });
    }
    window.switchGarageTab = switchGarageTab;

    function switchAuthTab(tab) {
      var loginForm = document.getElementById("loginForm");
      var joinForm = document.getElementById("joinForm");
      var tabLoginBtn = document.getElementById("tabLoginBtn");
      var tabJoinBtn = document.getElementById("tabJoinBtn");
      var login = tab !== "join";
      if (loginForm) loginForm.classList.toggle("hidden", !login);
      if (joinForm) joinForm.classList.toggle("hidden", login);
      if (tabLoginBtn) tabLoginBtn.classList.toggle("is-on", login);
      if (tabJoinBtn) tabJoinBtn.classList.toggle("is-on", !login);
    }
    window.switchAuthTab = switchAuthTab;
    window.switchTab = switchAuthTab;

    window.openAuthModal = window.openAuthModal || function (tab) {
      var modal = document.getElementById("authModal");
      if (modal) { modal.classList.remove("hidden"); switchAuthTab(tab || "login"); }
    };
    window.closeAuthModal = window.closeAuthModal || function () {
      var modal = document.getElementById("authModal");
      if (modal) modal.classList.add("hidden");
    };
    window.openForgotPasswordModal = window.openForgotPasswordModal || function () {
      document.getElementById("forgotPasswordModal")?.classList.remove("hidden");
    };
    window.closeForgotPasswordModal = window.closeForgotPasswordModal || function () {
      document.getElementById("forgotPasswordModal")?.classList.add("hidden");
    };
    window.handleLoginSubmit = function (e) {
      if (typeof window.handleLogin === "function") return window.handleLogin(e);
      e.preventDefault();
    };
    window.handleJoinSubmit = function (e) {
      if (typeof window.handleJoinRequest === "function") return window.handleJoinRequest(e);
      e.preventDefault();
    };
    window.handleForgotPasswordSubmit = function (e) {
      if (typeof window.handleForgotPassword === "function") return window.handleForgotPassword(e);
      e.preventDefault();
    };
    window.handleSetPasswordSubmit = function (e) {
      if (typeof window.handleSetPassword === "function") return window.handleSetPassword(e);
      e.preventDefault();
    };
    window.handleChangePasswordSubmit = function (e) {
      if (typeof window.handleChangePassword === "function") return window.handleChangePassword(e);
      e.preventDefault();
    };
    window.closeSetPasswordModal = function () {
      document.getElementById("setPasswordModal")?.classList.add("hidden");
    };
    window.closeChangePasswordModal = function () {
      document.getElementById("changePasswordModal")?.classList.add("hidden");
    };

    document.addEventListener("DOMContentLoaded", function () {
      var p = new URLSearchParams(window.location.search);
      if (p.get("tab") === "telemetry") switchGarageTab("telemetry");
      if (p.get("tab") === "comms") switchGarageTab("comms");
      if (p.get("tab") === "builder") switchGarageTab("builder");
    });
  </script>
</Layout>
