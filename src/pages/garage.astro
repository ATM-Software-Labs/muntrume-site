        <div class="g-field">
          <label for="setPwNew">Nueva contraseña</label>
          <input type="password" id="setPwNew" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Mínimo 10 caracteres" />
        </div>
        <div class="g-field">
          <label for="setPwConfirm">Confirmar contraseña</label>
          <input type="password" id="setPwConfirm" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Repite la contraseña" />
        </div>
        <button type="submit" id="setPwBtn" class="r-btn r-btn--primary">Guardar y entrar</button>
      </form>
      <div id="setPwError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
    </div>
