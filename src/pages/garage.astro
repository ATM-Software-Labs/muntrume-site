  <script is:inline>
    window.togglePassword = function (id, btn) {
      var input = document.getElementById(id);
      if (!input || !btn) return;
      var show = input.type === "password";
      input.type = show ? "text" : "password";
      btn.textContent = show ? "Ocultar" : "Mostrar";
      btn.setAttribute("aria-pressed", show ? "true" : "false");
    };
    function switchGarageTab(tab) {
      var map = {
        setups: ["tabBtnSetups", "garageSectionSetups"],
        telemetry: ["tabBtnTelemetry", "garageSectionTelemetry"],
        comms: ["tabBtnComms", "garageSectionComms"],
        builder: ["tabBtnBuilder", "garageSectionBuilder"]
      };
      var buttons = ["tabBtnSetups", "tabBtnTelemetry", "tabBtnComms", "tabBtnBuilder"].map(function (id) { return document.getElementById(id); });
      var sections = ["garageSectionSetups", "garageSectionTelemetry", "garageSectionComms", "garageSectionBuilder"].map(function (id) { return document.getElementById(id); });
      var chosen = map[tab] || map.setups;
      buttons.forEach(function (b) {
        if (!b) return;
        var on = b.id === chosen[0];
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      sections.forEach(function (s) {
        if (!s) return;
        var on = s.id === chosen[1];
        s.classList.toggle("hidden", !on);
        s.hidden = !on;
      });
    }
    window.switchGarageTab = switchGarageTab;

    function switchAuthTab(tab) {
      var loginForm = document.getElementById("loginForm");
      var joinForm = document.getElementById("joinForm");
      var tabLoginBtn = document.getElementById("tabLoginBtn");
      var tabJoinBtn = document.getElementById("tabJoinBtn");
      var login = tab !== "join";
      if (loginForm) loginForm.classList.toggle("hidden", !login);
      if (joinForm) joinForm.classList.toggle("hidden", login);
      if (tabLoginBtn) tabLoginBtn.classList.toggle("is-on", login);
      if (tabJoinBtn) tabJoinBtn.classList.toggle("is-on", !login);
    }
    window.switchAuthTab = switchAuthTab;
    window.switchTab = switchAuthTab;

    window.openAuthModal = window.openAuthModal || function (tab) {
      var modal = document.getElementById("authModal");
      if (modal) { modal.classList.remove("hidden"); switchAuthTab(tab || "login"); }
    };
    window.closeAuthModal = window.closeAuthModal || function () {
      var modal = document.getElementById("authModal");
      if (modal) modal.classList.add("hidden");
    };
    window.openForgotPasswordModal = window.openForgotPasswordModal || function () {
      document.getElementById("forgotPasswordModal")?.classList.remove("hidden");
    };
    window.closeForgotPasswordModal = window.closeForgotPasswordModal || function () {
      document.getElementById("forgotPasswordModal")?.classList.add("hidden");
    };
    window.handleLoginSubmit = function (e) {
      if (typeof window.handleLogin === "function") return window.handleLogin(e);
      e.preventDefault();
    };
    window.handleJoinSubmit = function (e) {
      if (typeof window.handleJoinRequest === "function") return window.handleJoinRequest(e);
      e.preventDefault();
    };
    window.handleForgotPasswordSubmit = function (e) {
      if (typeof window.handleForgotPassword === "function") return window.handleForgotPassword(e);
      e.preventDefault();
    };
    window.handleSetPasswordSubmit = function (e) {
      if (typeof window.handleSetPassword === "function") return window.handleSetPassword(e);
      e.preventDefault();
    };
    window.handleChangePasswordSubmit = function (e) {
      if (typeof window.handleChangePassword === "function") return window.handleChangePassword(e);
      e.preventDefault();
    };
    window.closeSetPasswordModal = function () {
      document.getElementById("setPasswordModal")?.classList.add("hidden");
    };
    window.closeChangePasswordModal = function () {
      document.getElementById("changePasswordModal")?.classList.add("hidden");
    };

    document.addEventListener("DOMContentLoaded", function () {
      var p = new URLSearchParams(window.location.search);
      if (p.get("tab") === "telemetry") switchGarageTab("telemetry");
      if (p.get("tab") === "comms") switchGarageTab("comms");
      if (p.get("tab") === "builder") switchGarageTab("builder");
      var necWeek = p.get("nec");
      var qSearch = p.get("q");
      if (necWeek !== null && typeof window.filterNecSetups === "function") {
        setTimeout(function () { window.filterNecSetups(necWeek); }, 350);
      } else if (qSearch && typeof window.quickSearchMmt === "function") {
        setTimeout(function () { window.quickSearchMmt(qSearch); }, 350);
      }
    });
  </script>
</Layout>
