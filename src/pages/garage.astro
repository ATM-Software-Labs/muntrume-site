        </div>
        <div class="g-field">
          <label for="confirmPassInput">Confirmar contraseña</label>
          <input type="password" id="confirmPassInput" required minlength="10" maxlength="128" autocomplete="new-password" placeholder="Repite la contraseña" />
        </div>
        <div id="changePassError" class="m-notice m-notice--inline m-notice--error hidden" role="alert"></div>
        <button type="submit" id="changePassBtn" class="r-btn r-btn--primary">Guardar</button>
      </form>
