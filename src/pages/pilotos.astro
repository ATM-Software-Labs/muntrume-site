---
import Layout from '../layouts/Layout.astro';
import StatsBar from '../components/StatsBar.astro';

const pageTitle = "Pilotos Oficiales de Sim Racing | Roster iRacing — Muntrume Motorsport";
const pageDescription = "Alineación oficial de 4 pilotos de Muntrume Motorsport en iRacing: Alberto Trujillo, Mateo Berbis, Eduardo Chongkan y Juanlu Carrillo. Estadísticas y telemetría.";

const drivers = [
  {
    name: "Alberto Trujillo",
    slug: "alberto-trujillo",
    role: "Team Principal & GT3 Driver",
    category: "gt3 gtp",
    num: "#01",
    rating: "3.9k iRating · Licencia A 4.99",
    primaryCar: "Porsche 911 GT3 R (992)",
    tags: ["GT3 Specialist", "VRS 24h", "Setup Architect"],
    bio: "Especialista en telemetría a 60 Hz, arquitectura de suspensión y ritmo de carrera en 24h."
  },
  {
    name: "Mateo Berbis",
    slug: "mateo-berbis",
    role: "Endurance & GT3 Driver",
    category: "gt3",
    num: "#02",
    rating: "3.4k iRating · Licencia A 4.85",
    primaryCar: "Ferrari 296 GT3",
    tags: ["Endurance Pro", "Bathurst 12H", "Night Stints"],
    bio: "Velocidad pura en vuelta de clasificación y gestión impecable de tráfico en parrillas GT3."
  },
  {
    name: "Eduardo Chongkan",
    slug: "eduardo-chongkan",
    role: "Prototype & Formula Driver",
    category: "gtp formula",
    num: "#03",
    rating: "3.7k iRating · Licencia A 4.90",
    primaryCar: "Cadillac V-Series.R GTP",
    tags: ["Hypercar GTP", "Super Formula", "Qualy Pace"],
    bio: "Especialista en aerodinámica de alta carga, prototipos híbridos y monoplazas de máxima potencia."
  },
  {
    name: "Juanlu Carrillo",
    slug: "juanlu-carrillo",
    role: "Touring & Cup Driver",
    category: "gt3 cup",
    num: "#04",
    rating: "3.2k iRating · Licencia A 4.75",
    primaryCar: "Porsche 992 Cup",
    tags: ["Cup Series", "Close Racing", "TBR SimOps"],
    bio: "Maestro en vehículos sin ABS ni control de tracción, batalla puerta a puerta y consistencia."
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="pt-24 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Header Hero -->
    <section class="text-center max-w-3xl mx-auto space-y-4 pt-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#121A17] border border-[#1E2A26] text-xs font-mono text-[#00E699]">
        <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
        <span>ROSTER OFICIAL &bull; TEMPORADA 2026</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight font-display">
        PILOTOS <span class="text-[#00E699]">DEL EQUIPO</span>
      </h1>
      <p class="text-sm sm:text-base text-[#8B9A8F] leading-relaxed max-w-xl mx-auto">
        Alineación homologada de Muntrume Motorsport para los campeonatos oficiales de resistencia y sprint en iRacing.
      </p>

      <!-- Clean Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-4">
        <button type="button" onclick="filterDrivers('all')" class="driver-filter-btn active px-4 py-1.5 rounded-full text-xs font-mono font-bold bg-[#00E699] text-neutral-950 transition cursor-pointer">
          Todos (4)
        </button>
        <button type="button" onclick="filterDrivers('gt3')" class="driver-filter-btn px-4 py-1.5 rounded-full text-xs font-mono font-semibold bg-[#121A17] hover:bg-white/5 border border-[#1E2A26] text-[#8B9A8F] hover:text-white transition cursor-pointer">
          GT3 Pro
        </button>
        <button type="button" onclick="filterDrivers('gtp')" class="driver-filter-btn px-4 py-1.5 rounded-full text-xs font-mono font-semibold bg-[#121A17] hover:bg-white/5 border border-[#1E2A26] text-[#8B9A8F] hover:text-white transition cursor-pointer">
          Prototipos GTP
        </button>
        <button type="button" onclick="filterDrivers('formula')" class="driver-filter-btn px-4 py-1.5 rounded-full text-xs font-mono font-semibold bg-[#121A17] hover:bg-white/5 border border-[#1E2A26] text-[#8B9A8F] hover:text-white transition cursor-pointer">
          Monoplazas
        </button>
      </div>
    </section>

    <!-- Drivers Cards Container (Swipe horizontal en móvil, grid de 4 en desktop) -->
    <section>
      <div class="flex overflow-x-auto snap-x snap-mandatory no-scrollbar pb-6 -mx-4 px-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:overflow-visible gap-4 sm:gap-6" id="driversListContainer">
        {drivers.map(d => (
          <article 
            class="driver-card snap-center shrink-0 w-[85vw] sm:w-auto paddock-card p-6 flex flex-col justify-between group cursor-pointer relative" 
            data-cat={d.category}
          >
            <div>
              <!-- Top Card Info: Number + Rating -->
              <div class="flex items-center justify-between pb-3 border-b border-[#1E2A26] mb-4">
                <span class="text-sm font-mono font-extrabold text-[#00E699]">{d.num}</span>
                <span class="text-[10px] font-mono text-[#8B9A8F] uppercase">{d.rating}</span>
              </div>

              <!-- Driver Helmet / Silhouette Illustration (Grayscale to Color Accent on Hover) -->
              <div class="w-full aspect-[4/3] rounded-xl bg-[#080C0A] border border-[#1E2A26] overflow-hidden mb-4 relative flex items-center justify-center group-hover:border-[#00E699]/40 transition-colors">
                <svg class="w-20 h-20 text-[#8B9A8F]/30 group-hover:text-[#00E699]/70 transition-colors duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between text-[10px] font-mono text-neutral-300 px-2 py-1 rounded bg-[#121A17]/90 border border-[#1E2A26]">
                  <span class="truncate">{d.primaryCar}</span>
                </div>
              </div>

              <!-- Driver Name & Role -->
              <h2 class="text-xl font-bold text-white group-hover:text-[#00E699] transition-colors font-display tracking-tight">
                {d.name}
              </h2>
              <div class="text-[10px] font-mono uppercase tracking-wider text-[#8B9A8F] mt-0.5">
                {d.role}
              </div>

              <!-- 1-Line Bio on Hover -->
              <p class="text-xs text-[#8B9A8F] leading-relaxed mt-3 pt-3 border-t border-[#1E2A26] transition-opacity">
                {d.bio}
              </p>
            </div>

            <!-- 3 Minimalist Tags + Link -->
            <div class="pt-4 mt-4 border-t border-[#1E2A26] flex items-center justify-between">
              <div class="flex flex-wrap gap-1">
                {d.tags.map(t => (
                  <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#080C0A] text-[#8B9A8F] border border-[#1E2A26]">
                    {t}
                  </span>
                ))}
              </div>
              <a 
                href={`/p/${d.slug}`} 
                class="text-xs font-mono font-bold text-[#00E699] hover:underline shrink-0 ml-2"
                title={`Ver ficha completa de ${d.name}`}
              >
                &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Stats Bar Integration -->
    <section class="pt-6">
      <StatsBar />
    </section>

  </main>
</Layout>

<script is:inline>
  function filterDrivers(cat) {
    var buttons = document.querySelectorAll('.driver-filter-btn');
    buttons.forEach(function(btn) {
      btn.classList.remove('active', 'bg-[#00E699]', 'text-neutral-950');
      btn.classList.add('bg-[#121A17]', 'text-[#8B9A8F]');
    });
    
    // Set active button
    var activeBtn = event ? event.currentTarget : null;
    if (activeBtn) {
      activeBtn.classList.remove('bg-[#121A17]', 'text-[#8B9A8F]');
      activeBtn.classList.add('active', 'bg-[#00E699]', 'text-neutral-950');
    }

    var cards = document.querySelectorAll('.driver-card');
    cards.forEach(function(card) {
      if (cat === 'all') {
        card.style.display = '';
      } else {
        var cardCat = card.getAttribute('data-cat') || '';
        if (cardCat.indexOf(cat) !== -1) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }
  window.filterDrivers = filterDrivers;
</script>
