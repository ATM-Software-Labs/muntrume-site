---
import Layout from '../layouts/Layout.astro';
import StatsGrid from '../components/StatsGrid.astro';
import HelmetAvatar from '../components/HelmetAvatar.astro';

const pageTitle = "Pilotos Oficiales de Sim Racing | Plantilla iRacing — Muntrume Motorsport";
const pageDescription = "Alineación oficial de 4 pilotos de Muntrume Motorsport en iRacing: Alberto Trujillo, Mateo Berbis, Eduardo Chongkan y Juanlu Carrillo. Temporada 2026 Oficial.";

export const OFFICIAL_DRIVERS = [
  {
    num: "#01",
    name: "Alberto Trujillo",
    role: "Team Principal & Telemetry",
    bio: "Especialista en telemetría a 60Hz, arquitectura de suspensión y dinámicas de chasis.",
    season: "Temporada 2026 - Oficial",
    slug: "alberto-trujillo"
  },
  {
    num: "#02",
    name: "Mateo Berbis",
    role: "Endurance & GT3 Driver",
    bio: "Especialista en tandas largas de resistencia y gestión de desgaste de neumáticos GT3.",
    season: "Temporada 2026 - Oficial",
    slug: "mateo-berbis"
  },
  {
    num: "#03",
    name: "Eduardo Chongkan",
    role: "Prototype & Formula Driver",
    bio: "Análisis de alta carga aerodinámica en prototipos GTP/LMP2 y monoplazas.",
    season: "Temporada 2026 - Oficial",
    slug: "eduardo-chongkan"
  },
  {
    num: "#04",
    name: "Juanlu Carrillo",
    role: "Touring & Cup Driver",
    bio: "Especialista en combate cuerpo a cuerpo, trazadas en turismos y copas monomarca.",
    season: "Temporada 2026 - Oficial",
    slug: "juanlu-carrillo"
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="pt-24 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Header Hero -->
    <section class="text-center max-w-3xl mx-auto space-y-4 pt-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#121A17] border border-[#1E2A26] text-xs font-mono text-[#00E699]">
        <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
        <span>PLANTILLA OFICIAL &bull; TEMPORADA 2026</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight font-display">
        PILOTOS <span class="text-[#00E699]">DEL EQUIPO</span>
      </h1>
      <p class="text-sm sm:text-base text-[#8B9A8F] leading-relaxed max-w-xl mx-auto">
        Alineación oficial de Muntrume Motorsport para iRacing. Pilotos multidisciplinares para GT3, prototipos GTP y monoplazas.
      </p>
    </section>

    <!-- Drivers Cards Container (Grid de 4 en desktop, swipe horizontal suave en móvil) -->
    <section>
      <div class="flex overflow-x-auto snap-x snap-mandatory no-scrollbar pb-6 -mx-4 px-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:overflow-visible gap-4 sm:gap-6" id="driversListContainer">
        {OFFICIAL_DRIVERS.map(d => (
          <article class="driver-card snap-center shrink-0 w-[85vw] sm:w-auto p-6 rounded-2xl bg-[#121A17] border border-[#1E2A26] hover:border-[#00E699]/60 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
            
            <!-- Small green indicator dot top right -->
            <span class="absolute top-4 right-4 w-1.5 h-1.5 rounded-full bg-[#00E699] opacity-80 group-hover:scale-125 transition-transform"></span>

            <div>
              <!-- Top: Number in small green -->
              <div class="flex items-center justify-between pb-3 border-b border-[#1E2A26] mb-4">
                <span class="text-xs font-mono font-bold text-[#00E699] tracking-wider">{d.num}</span>
                <span class="text-[10px] font-mono text-[#8B9A8F] uppercase">{d.season}</span>
              </div>

              <!-- Center: Helmet Avatar Placeholder -->
              <div class="mb-4">
                <HelmetAvatar driverNumber={d.num} />
              </div>

              <!-- Bottom: Real Name & Real Role -->
              <h2 class="text-xl font-bold text-white group-hover:text-[#00E699] transition-colors font-display tracking-tight">
                {d.name}
              </h2>
              <div class="text-[11px] font-mono uppercase tracking-wider text-[#8B9A8F] mt-1 font-semibold">
                {d.role}
              </div>

              <!-- 1-line Real Description -->
              <p class="text-xs text-[#8B9A8F] leading-relaxed mt-3 pt-3 border-t border-[#1E2A26]">
                {d.bio}
              </p>
            </div>

            <!-- Profile Link -->
            <div class="pt-4 mt-4 border-t border-[#1E2A26] flex items-center justify-between">
              <span class="text-[10px] font-mono text-[#8B9A8F] uppercase">iRacing Driver</span>
              <a 
                href={`/p/${d.slug}`} 
                class="text-xs font-mono font-bold text-[#00E699] hover:underline flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                title={`Ver ficha oficial de ${d.name}`}
              >
                <span>Ficha</span>
                <span>&rarr;</span>
              </a>
            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- Stats Grid Integration (Single Source of Truth) -->
    <section class="pt-4">
      <StatsGrid />
    </section>

  </main>
</Layout>
