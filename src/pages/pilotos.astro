---
import Layout from '../layouts/Layout.astro';
import HelmetAvatar from '../components/HelmetAvatar.astro';
import { PILOTOS } from '../lib/pilotos';

const pageTitle = "Pilotos | Muntrume Motorsport — iRacing";
const pageDescription = "Plantilla oficial de Muntrume Motorsport en iRacing. Estadísticas reales de iRacing por piloto: iRating, licencia, coche favorito y categoría.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="r-section" style="border-top:0;padding-top:clamp(112px,14vw,160px)" aria-labelledby="plTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">Plantilla 2026</p>
          <h1 id="plTitle" class="r-h2">Pilotos</h1>
          <p class="r-lead">Cuatro pilotos oficiales compitiendo en iRacing. Las estadísticas se publican solo cuando proceden de iRacing; si no hay datos verificados se indica «Sin datos».</p>
        </div>
      </div>
      <div class="r-grid">
        {PILOTOS.map(p => (
          <a href={`/d/${p.slug}`} class="r-card" data-driver={p.slug}>
            <div class="r-card__top">
              <span class="r-card__num" aria-hidden="true">{p.dorsal.replace('#','')}</span>
              <span class="r-card__flag">{p.flag_code} · {p.country}</span>
              <HelmetAvatar driverNumber={p.dorsal} className="w-full h-full" />
            </div>
            <div class="r-card__body">
              <span class="r-card__role">{p.badge === 'FOUNDER' ? 'Fundador · ' : ''}{p.role}</span>
              <h2 class="r-card__name">{p.fullName}</h2>
              {p.bio && <p style="margin:0;color:var(--r-muted);font-size:14px;line-height:1.55">{p.bio}</p>}
            </div>
            <div class="r-card__stats">
              <div>iRating<strong data-f="irating" class="r-nodata">Sin datos</strong></div>
              <div>Licencia<strong data-f="license" class="r-nodata">Sin datos</strong></div>
              <div style="border-left:0;border-top:1px solid var(--r-line)">Coche favorito<strong data-f="fav_car" class="r-nodata" style="font-size:16px">Sin datos</strong></div>
              <div style="border-top:1px solid var(--r-line)">Categoría principal<strong data-f="top_category" class="r-nodata" style="font-size:16px">Sin datos</strong></div>
            </div>
          </a>
        ))}
      </div>
      <p class="r-meta" id="driversSource" style="margin-top:16px">Fuente: iRacing (API oficial o puente del equipo). Sin datos verificados todavía.</p>
    </div>
  </section>
  <script is:inline src="/assets/js/home-r.js?v=t265" defer></script>
</Layout>
