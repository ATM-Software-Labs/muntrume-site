---
import Layout from '../layouts/Layout.astro';
import DriverCard from '../components/DriverCard.astro';
import TeamBand from '../components/TeamBand.astro';
import { PILOTOS, LICENCE_UPDATED_LABEL } from '../lib/pilotos';

const pageTitle = "Pilotos | Muntrume Motorsport — iRacing";
const pageDescription = `Plantilla de Muntrume Motorsport: ${PILOTOS.map(p => p.fullName).join(", ")}. Licencia Sports Car aproximada, actualizada el ${LICENCE_UPDATED_LABEL}.`;
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/pilotos/">
  <section class="r-section" style="border-top:0;padding-top:clamp(112px,14vw,160px)" aria-labelledby="plTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">Plantilla 2026</p>
          <h1 id="plTitle" class="r-h2">Pilotos</h1>
          <p class="r-lead">{PILOTOS.length} pilotos oficiales. Licencia Sports Car, cifras aproximadas.</p>
<p class="r-meta" id="licenceUpdated">Actualizado: {LICENCE_UPDATED_LABEL}</p>
        </div>
      </div>
      <TeamBand />
      <div class="d-grid">
        {PILOTOS.map(p => (
          <DriverCard driver={p} heading="h2" />
        ))}
      </div>
    </div>
  </section>
  <script is:inline src="/assets/js/home-r.js?v=t283" defer></script>
</Layout>
