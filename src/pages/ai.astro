---
import Layout from '../layouts/Layout.astro';
import { MUNTRUME_KB } from '../data/muntrume-kb';

const pageTitle = "Muntrume AI · Pro Light Ultra Max (100 % Open Source) | Muntrume Motorsport";
const pageDescription = "Muntrume AI Pro Light Ultra Max: asistente 100 % Open Source (MIT) con motores Lite, Pro, Ultra Max (razonamiento paso a paso) y Local Ollama, streaming instantáneo y base de conocimiento verificada de Muntrume Motorsport e iRacing.";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/ai/" hideFooter>
  <div class="ai-shell" id="aiWorkspace" data-ai-theme="dark">
    <div id="aiScrim" class="ai-scrim" hidden></div>

    <!-- COLLAPSIBLE LEFT SIDEBAR (localStorage history) -->
    <aside id="aiSide" class="ai-side" aria-label="Historial de conversaciones">
      <div class="ai-side__head">
        <a href="/" class="ai-side__brand" title="Volver a Muntrume Motorsport">
          <img src="/assets/img/icon-192.png" alt="Muntrume AI" width="22" height="22" />
          <span>Muntrume AI</span>
        </a>
        <button type="button" id="aiSideClose" class="ai-icon-btn" aria-label="Ocultar barra lateral" title="Ocultar barra lateral">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="ai-side__actions">
        <button type="button" id="aiNewChatSide" class="ai-new-chat-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          <span>Nueva conversación</span>
          <kbd>Ctrl K</kbd>
        </button>
      </div>

      <div class="ai-side__section-label">Conversaciones guardadas</div>
      <div id="aiChatList" class="ai-chat-list" role="list"></div>

      <div class="ai-side__foot">
        <a
          href={MUNTRUME_KB.team.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ai-oss-badge"
          title="Ver código fuente en GitHub (Licencia MIT)"
        >
          <span class="ai-oss-dot"></span>
          <span>100 % Open Source · MIT</span>
          <span aria-hidden="true">↗</span>
        </a>
        <nav class="ai-side__links" aria-label="Ecosistema Muntrume">
          <a href="/garage/">Garage</a>
          <a href="/overlay/">Overlay</a>
          <a href="/wallpapers/">Wallpapers</a>
          <a href="/pilotos/">Pilotos</a>
        </nav>
      </div>
    </aside>

    <!-- MAIN FULLSCREEN 100dvh STAGE -->
    <div class="ai-main">
      <!-- COMPACT PRO HEADER -->
      <header class="ai-topbar">
        <div class="ai-topbar__left">
          <button type="button" id="aiSideToggle" class="ai-icon-btn" aria-expanded="true" aria-controls="aiSide" aria-label="Mostrar u ocultar historial" title="Historial">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
          </button>

          <!-- Mode Selector: Equipo & iRacing vs Open Source General -->
          <div class="ai-segmented" role="group" aria-label="Modo de conocimiento">
            <button type="button" class="ai-seg-btn is-active" data-ai-mode="team" aria-pressed="true">Equipo &amp; iRacing</button>
            <button type="button" class="ai-seg-btn" data-ai-mode="general" aria-pressed="false">Open Source General</button>
          </div>
        </div>

        <!-- 4-Tier Open Source Engine Selector -->
        <div class="ai-topbar__center">
          <div class="ai-tier-bar" role="group" aria-label="Selector de motor Open Source">
            <button type="button" class="ai-tier-btn" data-ai-tier="lite" aria-pressed="false" title="Lite · Instantáneo (respuestas en ms, cálculos y consultas rápidas)">
              <span class="ai-tier-dot ai-tier-dot--lite"></span>
              <span>Lite</span>
            </button>
            <button type="button" class="ai-tier-btn is-active" data-ai-tier="pro" aria-pressed="true" title="Pro · Equilibrado (ingeniería iRacing, código y análisis técnico)">
              <span class="ai-tier-dot ai-tier-dot--pro"></span>
              <span>Pro</span>
            </button>
            <button type="button" class="ai-tier-btn" data-ai-tier="ultra_max" aria-pressed="false" title="Ultra Max · Razonamiento profundo paso a paso">
              <span class="ai-tier-dot ai-tier-dot--ultra"></span>
              <span>Ultra Max</span>
            </button>
            <button type="button" class="ai-tier-btn" data-ai-tier="local" aria-pressed="false" title="Local Ollama · 100 % privado vía http://localhost:11434">
              <span class="ai-tier-dot ai-tier-dot--local"></span>
              <span>Local Ollama</span>
            </button>
          </div>
        </div>

        <div class="ai-topbar__right">
          <button type="button" id="aiThemeBtn" class="ai-theme-btn" aria-label="Cambiar entre Dark Pro y Light Pro" title="Cambiar entre Dark Pro y Light Pro">
            <span id="aiThemeIcon" aria-hidden="true">☀</span>
            <span id="aiThemeLabel">Light Pro</span>
          </button>
          <a
            href={MUNTRUME_KB.team.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ai-mit-pill"
            title="Repositorio Open Source MIT"
          >
            MIT ↗
          </a>
        </div>
      </header>

      <!-- OPTIONAL LOCAL OLLAMA BAR (shown only when Local Ollama tier is active) -->
      <div id="aiLocalBar" class="ai-local-bar" hidden>
        <div class="ai-local-bar__inner">
          <span class="ai-local-bar__badge">🔒 100 % Privado · Local</span>
          <label class="ai-local-bar__field">
            <span>Endpoint</span>
            <input type="url" id="aiOllamaUrl" value="http://localhost:11434/api/chat" spellcheck="false" />
          </label>
          <label class="ai-local-bar__field">
            <span>Modelo</span>
            <input type="text" id="aiOllamaModel" value="llama3.2" placeholder="llama3.2 / qwen2.5 / deepseek-r1" spellcheck="false" />
          </label>
          <span class="ai-local-bar__hint">Ningún dato sale de tu PC (con fallback local automático si Ollama está apagado).</span>
        </div>
      </div>

      <!-- SCROLLABLE CHAT VIEWPORT (SINGLE SCROLL, NO DOUBLE SCROLL) -->
      <div id="aiStage" class="ai-stage is-empty">
        <div id="aiEmpty" class="ai-empty">
          <div class="ai-hero">
            <div class="ai-hero__badge">
              <span class="ai-oss-dot"></span>
              <span>Muntrume AI · Pro Light Ultra Max</span>
            </div>
            <h1 class="ai-hero__title">Ingeniería de pista y código Open Source, al instante.</h1>
            <p class="ai-hero__sub">
              Elige potencia entre <strong>Lite</strong>, <strong>Pro</strong>, <strong>Ultra Max</strong> o <strong>Local Ollama</strong>. Cero paywalls, base oficial verificada de Muntrume Motorsport y calculadoras reales de iRacing.
            </p>
          </div>

          <!-- 4 QUICK START CHIPS -->
          <div class="ai-chips" id="aiQuickChips">
            <button type="button" class="ai-chip" data-mode="team" data-tier="lite" data-prompt="¿Quiénes son los pilotos oficiales de Muntrume Motorsport y cuáles son los correos de contacto?">
              <span class="ai-chip__eyebrow">Equipo &amp; Contacto</span>
              <strong>Pilotos oficiales y canales @muntru.me</strong>
              <span>#16 Alberto, #1 Mateo, #22 Eduardo, administración y series oficiales</span>
            </button>
            <button type="button" class="ai-chip" data-mode="team" data-tier="pro" data-prompt="Explica la arquitectura y características del MMT Sync Overlay Open Source (MIT, RAM, FPS e IRSDK)">
              <span class="ai-chip__eyebrow">MMT Sync Overlay</span>
              <strong>HUD 60 FPS Open Source (&lt; 80 MB RAM)</strong>
              <span>Licencia MIT, captura IRSDK, Setup Vault y wallpapers sincronizados</span>
            </button>
            <button type="button" class="ai-chip" data-mode="team" data-tier="ultra_max" data-prompt="Calcula combustible y estrategia detallada para una carrera GT3 de 45 minutos (vuelta 2:18, consumo 2.85 L/vuelta, depósito 104 L)">
              <span class="ai-chip__eyebrow">Estrategia GT3</span>
              <strong>Calculadora de combustible y ventana de pit</strong>
              <span>Litros exactos, vuelta de margen, parada y reparto de stints</span>
            </button>
            <button type="button" class="ai-chip" data-mode="general" data-tier="pro" data-prompt="Escribe una función en TypeScript limpia para calcular el ritmo medio por stint descartando vueltas de entrada y salida de boxes">
              <span class="ai-chip__eyebrow">Asistente Open Source</span>
              <strong>Código, arquitectura y razonamiento técnico</strong>
              <span>Markdown con resaltado de sintaxis y botón copiar en cada bloque</span>
            </button>
          </div>
        </div>

        <div id="aiLog" class="ai-log" role="log" aria-live="polite" aria-busy="false" hidden></div>
      </div>

      <button type="button" id="aiJump" class="ai-jump" hidden>↓ Ir al final</button>

      <!-- COMPOSER -->
      <form id="aiForm" class="ai-composer" autocomplete="off">
        <p id="aiLive" class="sr-only" aria-live="polite"></p>
        <div class="ai-composer__box">
          <label class="sr-only" for="aiInput">Escribe tu consulta para Muntrume AI</label>
          <textarea
            id="aiInput"
            rows="1"
            maxlength="3000"
            placeholder="Pregunta sobre Muntrume Motorsport, calcula combustible GT3 o pide código Open Source…"
          ></textarea>
          <button type="button" id="aiSend" class="ai-send-btn" aria-label="Enviar mensaje">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          </button>
        </div>
        <div class="ai-composer__meta">
          <span id="aiStatusChip" class="ai-status-chip">
            <span class="ai-oss-dot"></span>
            <span id="aiStatusText">Pro · Equipo &amp; iRacing</span>
          </span>
          <span class="ai-composer__hint">Enter para enviar · Shift+Enter nueva línea · 100 % Open Source</span>
        </div>
      </form>
    </div>
  </div>

  <script id="muntrumeKbData" type="application/json" set:html={JSON.stringify(MUNTRUME_KB)}></script>
  <script defer src="/assets/js/ai-chat.js?v=pluma1"></script>
</Layout>

<style is:global>
  /* Lock viewport to 100dvh on /ai/ for zero double scroll */
  html:has(#aiWorkspace),
  body:has(#aiWorkspace) {
    height: 100dvh;
    overflow: hidden;
  }
  body:has(#aiWorkspace) main {
    height: calc(100dvh - 60px);
    overflow: hidden;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ===== PRO LIGHT ULTRA MAX TOKENS ===== */
  .ai-shell {
    --ai-bg: #090b0f;
    --ai-surface: #0f131a;
    --ai-surface-2: #151b24;
    --ai-border: rgba(255, 255, 255, 0.08);
    --ai-border-strong: rgba(255, 255, 255, 0.16);
    --ai-text: #f3f6fa;
    --ai-muted: #93a1b5;
    --ai-accent: #10b981;
    --ai-accent-ink: #04130d;
    --ai-accent-soft: rgba(16, 185, 129, 0.13);
    --ai-code-bg: #0b0e14;
    --ai-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);

    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    background: var(--ai-bg);
    color: var(--ai-text);
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    overflow: hidden;
  }

  .ai-shell[data-ai-theme="light"] {
    --ai-bg: #f8fafc;
    --ai-surface: #ffffff;
    --ai-surface-2: #f1f5f9;
    --ai-border: rgba(15, 23, 42, 0.09);
    --ai-border-strong: rgba(15, 23, 42, 0.18);
    --ai-text: #0f172a;
    --ai-muted: #475569;
    --ai-accent: #059669;
    --ai-accent-ink: #ffffff;
    --ai-accent-soft: rgba(5, 150, 105, 0.1);
    --ai-code-bg: #0f172a;
    --ai-shadow: 0 10px 28px rgba(15, 23, 42, 0.07);
  }

  /* ===== SIDEBAR ===== */
  .ai-side {
    width: 264px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: var(--ai-surface);
    border-right: 1px solid var(--ai-border);
    transition: width 0.2s ease, transform 0.2s ease;
    z-index: 30;
  }
  .ai-side.is-collapsed {
    width: 0;
    overflow: hidden;
    border-right-width: 0;
  }
  .ai-side__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid var(--ai-border);
  }
  .ai-side__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: -0.02em;
    color: var(--ai-text);
    text-decoration: none;
  }
  .ai-side__brand img { border-radius: 6px; }
  .ai-side__actions { padding: 12px 12px 8px; }
  .ai-new-chat-btn {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 11px;
    border-radius: 10px;
    border: 1px solid var(--ai-border-strong);
    background: var(--ai-surface-2);
    color: var(--ai-text);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .ai-new-chat-btn:hover { border-color: var(--ai-accent); }
  .ai-new-chat-btn kbd {
    margin-left: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    color: var(--ai-muted);
    padding: 2px 5px;
    border-radius: 5px;
    border: 1px solid var(--ai-border);
  }
  .ai-side__section-label {
    padding: 8px 14px 4px;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ai-muted);
  }
  .ai-chat-list {
    flex: 1;
    overflow-y: auto;
    padding: 4px 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ai-chat-item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ai-muted);
    font-size: 12.5px;
    text-align: left;
    cursor: pointer;
    width: 100%;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .ai-chat-item:hover { background: var(--ai-surface-2); color: var(--ai-text); }
  .ai-chat-item.is-active {
    background: var(--ai-accent-soft);
    border-color: rgba(16, 185, 129, 0.28);
    color: var(--ai-text);
    font-weight: 600;
  }
  .ai-chat-item__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ai-chat-item__del {
    opacity: 0;
    border: 0;
    background: transparent;
    color: var(--ai-muted);
    cursor: pointer;
    font-size: 14px;
    line-height: 1;
    padding: 2px 4px;
    border-radius: 4px;
  }
  .ai-chat-item:hover .ai-chat-item__del,
  .ai-chat-item.is-active .ai-chat-item__del { opacity: 0.85; }
  .ai-chat-item__del:hover { color: #f43f5e; background: rgba(244, 63, 94, 0.12); }

  .ai-side__foot {
    padding: 12px;
    border-top: 1px solid var(--ai-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ai-oss-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 7px 10px;
    border-radius: 9px;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: var(--ai-accent-soft);
    color: var(--ai-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .ai-oss-badge:hover { opacity: 0.88; }
  .ai-oss-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--ai-accent);
    flex-shrink: 0;
  }
  .ai-side__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    justify-content: center;
    font-size: 11px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ai-side__links a { color: var(--ai-muted); text-decoration: none; }
  .ai-side__links a:hover { color: var(--ai-accent); }

  /* ===== MAIN AREA & TOPBAR ===== */
  .ai-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }
  .ai-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--ai-border);
    background: var(--ai-surface);
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .ai-topbar__left,
  .ai-topbar__center,
  .ai-topbar__right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ai-icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    border: 1px solid var(--ai-border);
    background: var(--ai-surface-2);
    color: var(--ai-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .ai-icon-btn:hover { border-color: var(--ai-accent); }

  .ai-segmented,
  .ai-tier-bar {
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border-radius: 10px;
    background: var(--ai-surface-2);
    border: 1px solid var(--ai-border);
    gap: 2px;
  }
  .ai-seg-btn,
  .ai-tier-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 7px;
    border: 0;
    background: transparent;
    color: var(--ai-muted);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.14s ease, color 0.14s ease;
  }
  .ai-seg-btn:hover,
  .ai-tier-btn:hover { color: var(--ai-text); }
  .ai-seg-btn.is-active,
  .ai-tier-btn.is-active {
    background: var(--ai-surface);
    color: var(--ai-text);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
  }
  .ai-tier-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
  }
  .ai-tier-dot--lite { background: #38bdf8; }
  .ai-tier-dot--pro { background: #10b981; }
  .ai-tier-dot--ultra { background: #a855f7; }
  .ai-tier-dot--local { background: #f59e0b; }

  .ai-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 9px;
    border: 1px solid var(--ai-border);
    background: var(--ai-surface-2);
    color: var(--ai-text);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .ai-theme-btn:hover { border-color: var(--ai-accent); }
  .ai-mit-pill {
    padding: 6px 9px;
    border-radius: 9px;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: var(--ai-accent-soft);
    color: var(--ai-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    text-decoration: none;
  }

  /* Local Ollama bar */
  .ai-local-bar {
    border-bottom: 1px solid var(--ai-border);
    background: var(--ai-surface-2);
    padding: 8px 16px;
    flex-shrink: 0;
  }
  .ai-local-bar__inner {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ai-local-bar__badge {
    color: #f59e0b;
    font-weight: 700;
  }
  .ai-local-bar__field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ai-muted);
  }
  .ai-local-bar__field input {
    background: var(--ai-surface);
    border: 1px solid var(--ai-border-strong);
    color: var(--ai-text);
    border-radius: 7px;
    padding: 4px 8px;
    font-size: 11.5px;
    font-family: inherit;
    width: 195px;
  }
  .ai-local-bar__hint { color: var(--ai-muted); font-size: 11px; }

  /* ===== STAGE & EMPTY HERO ===== */
  .ai-stage {
    flex: 1;
    overflow-y: auto;
    padding: 24px 16px 20px;
    scroll-behavior: smooth;
  }
  .ai-stage.is-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ai-empty {
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .ai-hero { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .ai-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: var(--ai-accent-soft);
    color: var(--ai-accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    font-weight: 700;
  }
  .ai-hero__title {
    margin: 0;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--ai-text);
  }
  .ai-hero__sub {
    margin: 0;
    max-width: 580px;
