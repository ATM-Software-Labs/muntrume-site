---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Muntrume AI · Pro Light Ultra Max";
const pageDescription = "Asistente open source de Muntrume Motorsport con motores Lite, Pro y Ultra Max, Ollama local y calculadoras de combustible para iRacing. Sin muros de pago.";
const repo = "https://github.com/ATM-Software-Labs/muntrume-site";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/ai/" hideNav hideFooter>
  <script is:inline>
    (function () {
      try {
        var theme = localStorage.getItem("muntrume-ai-theme");
        if (theme !== "light" && theme !== "dark") theme = "dark";
        document.documentElement.setAttribute("data-ai-theme", theme);
      } catch (e) {}
    })();
  </script>
  <div class="ai-app" data-theme="dark">
    <button type="button" id="aiScrim" class="ai-scrim" hidden aria-label="Cerrar historial"></button>
    <aside id="aiSide" class="ai-side" aria-label="Conversaciones">
      <div class="ai-side__bar">
        <p>Conversaciones</p>
        <button type="button" id="aiSideClose" class="ai-icon" aria-label="Cerrar historial">×</button>
      </div>
      <button type="button" id="aiNew" class="ai-new">Nueva conversación</button>
      <div id="aiChatList" class="ai-list" role="list"></div>
      <nav class="ai-side__links" aria-label="Sitio">
        <a href="/">Inicio</a>
        <a href="/contact/">Contacto</a>
        <a href="/overlay/">Overlay</a>
        <a href="/garage/">Setup Vault</a>
        <a href="/wallpapers/">Wallpapers</a>
      </nav>
    </aside>

    <div class="ai-main">
      <header class="ai-top">
        <button type="button" id="aiSideOpen" class="ai-icon" aria-expanded="false" aria-controls="aiSide" aria-label="Abrir historial">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <h1>Muntrume AI</h1>
        <div class="ai-selectors">
          <label>Modo
            <select id="aiMode" aria-label="Modo">
              <option value="team">Equipo &amp; iRacing</option>
              <option value="oss">Open Source General</option>
            </select>
          </label>
          <label>Potencia
            <select id="aiTier" aria-label="Potencia">
              <option value="lite">Lite</option>
              <option value="pro">Pro</option>
              <option value="ultra">Ultra Max</option>
              <option value="local">Local</option>
            </select>
          </label>
        </div>
        <p id="aiStatus" class="ai-status">Lite · listo</p>
        <button type="button" id="aiTheme" class="ai-theme" aria-pressed="false">Dark Pro</button>
        <a class="ai-oss" href={repo} target="_blank" rel="noopener noreferrer">100 % Open Source · MIT</a>
      </header>

      <div id="aiLocalBox" class="ai-local" hidden>
        <label>Modelo Ollama
          <select id="aiOllamaModel" aria-label="Modelo de Ollama"></select>
        </label>
        <p id="aiOllamaHint" class="ai-hint" role="status" hidden></p>
      </div>

      <div id="aiStage" class="ai-stage">
        <div id="aiEmpty" class="ai-empty">
          <p class="ai-kicker">Pro Light Ultra Max</p>
          <h2>Pregunta al equipo o calcula un stint</h2>
          <p>Lite, Pro y Ultra Max usan modelos open source. Local habla solo con Ollama en este navegador. Si el motor externo no responde, el cálculo sale de la base verificada.</p>
          <div class="ai-chips" role="group" aria-label="Preguntas rápidas">
            <button type="button" data-chip="¿Quiénes son los pilotos de Muntrume y cómo contacto con el equipo, administración, prensa y legal?" data-mode="team">Equipo/Contacto</button>
            <button type="button" data-chip="¿Qué es MMT Sync Overlay y dónde está en la web?" data-mode="team">MMT Sync Overlay</button>
            <button type="button" data-chip="Estrategia de combustible GT3: 2,8 L por vuelta, vuelta de 1:45, carrera de 45 minutos, margen de 1,5 vueltas. Calcula litros del stint, vueltas posibles y ventana de parada." data-mode="team">Estrategia/Combustible GT3</button>
            <button type="button" data-chip="Explícame el ecosistema open source de Muntrume: overlay, Setup Vault y wallpapers." data-mode="oss">Asistente Open Source</button>
          </div>
        </div>
        <div id="aiLog" class="ai-log" role="log" aria-busy="false" hidden></div>
      </div>

      <form id="aiForm" class="ai-composer" autocomplete="off">
        <p id="aiLive" class="sr-only" aria-live="polite"></p>
        <p id="aiNotice" class="ai-hint" role="status" hidden></p>
        <div class="ai-composer__box">
          <label class="sr-only" for="aiInput">Mensaje</label>
          <textarea id="aiInput" rows="1" maxlength="4000" placeholder="Escribe una pregunta…"></textarea>
          <button type="submit" id="aiSend" aria-label="Enviar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          </button>
        </div>
      </form>
    </div>
  </div>
  <noscript><p class="ai-noscript">Activa JavaScript para usar Muntrume AI.</p></noscript>
</Layout>

<script is:inline src="/assets/js/ai-chat.js?v=pro2" defer></script>

<style is:global>
  html[data-ai-theme="light"] .ai-app,
  .ai-app[data-theme="light"] {
    --ai-bg: #f4f7f6;
    --ai-surface: #ffffff;
    --ai-surface-2: #e7eeeb;
    --ai-text: #10211c;
    --ai-muted: #3d4f49;
    --ai-line: #c5d5ce;
    --ai-accent: #047857;
    --ai-accent-ink: #f4fffb;
    --ai-chip: #e8f6f1;
    --ai-code: #10211c;
    --ai-code-bg: #eef3f1;
    --ai-user: #d1fae5;
  }
  .ai-app {
    --ai-bg: #090b0f;
    --ai-surface: #11161c;
    --ai-surface-2: #1a2129;
    --ai-text: #e8eef2;
    --ai-muted: #b7c2ce;
    --ai-line: #24303a;
    --ai-accent: #10b981;
    --ai-accent-ink: #06281c;
    --ai-chip: #10241c;
    --ai-code: #d7efe4;
    --ai-code-bg: #0d1411;
    --ai-user: #12352a;
    color: var(--ai-text);
    background: var(--ai-bg);
    height: 100%;
    min-height: 0;
    display: flex;
    position: relative;
    overflow: hidden;
  }
  body:has(.ai-app) {
    height: 100dvh !important;
    max-height: 100dvh !important;
    overflow: hidden !important;
  }
  body:has(.ai-app) #main-content {
    height: 100dvh;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ai-scrim { position: absolute; inset: 0; z-index: 4; border: 0; background: rgba(0,0,0,.45); }
  .ai-side {
    width: min(260px, 86vw);
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 0;
    background: var(--ai-surface);
    border-right: 1px solid var(--ai-line);
    padding: 10px;
  }
  .ai-side__bar, .ai-top, .ai-msg__bar, .ai-local { display: flex; align-items: center; gap: 8px; }
  .ai-side__bar { justify-content: space-between; }
  .ai-side__bar p, .ai-kicker, .ai-status, .ai-oss { margin: 0; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; }
  .ai-new, .ai-icon, .ai-theme, .ai-chips button, .ai-copy, .ai-codecopy, .ai-row__icon, .ai-send, #aiSend {
    border: 1px solid var(--ai-line);
    background: var(--ai-surface-2);
    color: var(--ai-text);
    border-radius: 8px;
    min-height: 36px;
    cursor: pointer;
  }
  .ai-new { width: 100%; font-weight: 700; }
  .ai-icon { width: 36px; display: grid; place-items: center; padding: 0; }
  .ai-list { flex: 1; min-height: 0; overflow: auto; display: flex; flex-direction: column; gap: 4px; }
  .ai-row { display: grid; grid-template-columns: 1fr auto auto; gap: 4px; align-items: center; }
  .ai-row__open, .ai-row__icon { min-height: 34px; border: 0; background: transparent; color: var(--ai-muted); text-align: left; border-radius: 8px; cursor: pointer; }
  .ai-row__open { padding: 0 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ai-row__open[aria-current="true"] { background: var(--ai-chip); color: var(--ai-accent); font-weight: 700; }
  .ai-row__icon { font-size: 11px; padding: 0 6px; }
  .ai-rename { width: 100%; min-height: 34px; border-radius: 8px; border: 1px solid var(--ai-accent); background: var(--ai-bg); color: var(--ai-text); padding: 0 8px; }
  .ai-side__links { display: flex; flex-wrap: wrap; gap: 8px 12px; font-size: 12px; }
  .ai-side__links a { color: var(--ai-muted); }
  .ai-main { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
  .ai-top { flex-wrap: wrap; padding: 8px 10px; border-bottom: 1px solid var(--ai-line); background: var(--ai-surface); }
  .ai-top h1 { margin: 0; font-size: 16px; }
  .ai-selectors { display: flex; gap: 8px; flex: 1 1 280px; min-width: 0; }
  .ai-selectors label, .ai-local label { display: grid; gap: 2px; font-size: 11px; color: var(--ai-muted); flex: 1; min-width: 0; }
  .ai-selectors select, .ai-local select, .ai-composer textarea {
    width: 100%;
    max-width: 100%;
    border: 1px solid var(--ai-line);
    background: var(--ai-bg);
    color: var(--ai-text);
    border-radius: 8px;
    min-height: 36px;
    font: inherit;
  }
  .ai-status { color: var(--ai-muted); }
  .ai-theme { padding: 0 10px; font-weight: 700; }
  .ai-oss {
    color: var(--ai-accent-ink);
    background: var(--ai-accent);
    text-decoration: none;
    border-radius: 999px;
    padding: 6px 10px;
    font-weight: 800;
  }
  .ai-local { padding: 8px 10px; border-bottom: 1px solid var(--ai-line); }
  .ai-hint { margin: 0; color: var(--ai-muted); font-size: 13px; line-height: 1.4; }
  .ai-stage { flex: 1; min-height: 0; overflow: auto; padding: 16px 14px 8px; }
  .ai-empty { max-width: 760px; margin: 0 auto; display: grid; gap: 10px; }
  .ai-empty h2 { margin: 0; font-size: clamp(26px, 4vw, 40px); line-height: 1.05; }
  .ai-empty p { margin: 0; color: var(--ai-muted); }
  .ai-kicker { color: var(--ai-accent); font-weight: 800; }
  .ai-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .ai-chips button { padding: 8px 12px; background: var(--ai-chip); color: var(--ai-text); font-weight: 700; }
  .ai-log { display: flex; flex-direction: column; gap: 12px; max-width: 860px; margin: 0 auto; }
  .ai-msg { border: 1px solid var(--ai-line); border-radius: 12px; padding: 10px 12px; background: var(--ai-surface); }
  .ai-msg--user { background: var(--ai-user); margin-left: 12%; }
  .ai-msg--user p { margin: 0; white-space: pre-wrap; }
  .ai-msg--bot { margin-right: 4%; }
  .ai-msg__bar { justify-content: space-between; margin-bottom: 6px; color: var(--ai-muted); font-size: 12px; }
  .ai-copy, .ai-codecopy { min-height: 28px; padding: 0 8px; font-size: 12px; }
  .ai-think { margin: 0 0 8px; border: 1px solid var(--ai-line); border-radius: 8px; background: var(--ai-bg); }
  .ai-think summary { cursor: pointer; padding: 8px 10px; color: var(--ai-accent); font-weight: 700; }
  .ai-think-body { padding: 0 10px 10px; white-space: pre-wrap; color: var(--ai-muted); font-size: 13px; }
  .ai-md { display: grid; gap: 8px; }
  .ai-md :where(h1,h2,h3,p,ul,ol,pre) { margin: 0; }
  .ai-md :where(h2,h3) { font-size: 16px; }
  .ai-md a { color: var(--ai-accent); }
  .ai-md ul, .ai-md ol { padding-left: 18px; }
  .ai-table { overflow: auto; max-width: 100%; }
  .ai-md table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .ai-md th, .ai-md td { border: 1px solid var(--ai-line); padding: 6px 8px; text-align: left; }
  .ai-code { position: relative; }
  .ai-codecopy { position: absolute; top: 6px; right: 6px; }
  .ai-md pre { overflow: auto; background: var(--ai-code-bg); color: var(--ai-code); border-radius: 8px; padding: 28px 10px 10px; font-size: 13px; }
  .ai-md code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .tok-k { color: #34d399; }
  .tok-s { color: #fbbf24; }
  .tok-n { color: #93c5fd; }
  .tok-c { color: #94a3b8; }
  .ai-app[data-theme="light"] .tok-k { color: #047857; }
  .ai-app[data-theme="light"] .tok-s { color: #b45309; }
  .ai-app[data-theme="light"] .tok-n { color: #1d4ed8; }
  .ai-caret { display: inline-block; width: 7px; height: 1em; background: var(--ai-accent); margin-left: 2px; vertical-align: text-bottom; }
  .ai-composer { padding: 8px 10px 12px; border-top: 1px solid var(--ai-line); background: var(--ai-surface); display: grid; gap: 6px; }
  .ai-composer__box { display: flex; gap: 8px; align-items: flex-end; }
  .ai-composer textarea { resize: none; padding: 8px 10px; max-height: 140px; }
  #aiSend { width: 40px; background: var(--ai-accent); color: var(--ai-accent-ink); border-color: transparent; display: grid; place-items: center; }
  #aiSend.is-stop { width: auto; padding: 0 8px; background: transparent; color: var(--ai-text); border-color: var(--ai-line); }
  #aiSend.is-stop svg { display: none; }
  #aiSend.is-stop::before { content: "Stop"; font-size: 11px; font-weight: 800; }
  .ai-app :focus-visible { outline: 2px solid var(--ai-accent); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .ai-noscript { padding: 16px; }
  @media (max-width: 959px) {
    .ai-side { position: absolute; z-index: 5; inset: 0 auto 0 0; transform: translateX(-105%); transition: transform .18s ease; }
    .ai-app.is-side-open .ai-side { transform: none; }
    .ai-msg--user { margin-left: 0; }
    .ai-msg--bot { margin-right: 0; }
  }
  @media (max-width: 420px) {
    .ai-top h1 { font-size: 15px; }
    .ai-oss { letter-spacing: 0; }
    .ai-row { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-side { transition: none; }
    .ai-caret { display: none; }
  }
</style>
