  <!-- MODAL: PERSONALIZACIÓN Y MEMORIA -->
  <div id="aiPersonalizeModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Personalización y Memoria</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <form id="aiPersonalizeForm" class="ai-modal-form">
        <label for="aiCustomInstrInput">Instrucciones personalizadas</label>
        <textarea id="aiCustomInstrInput" rows="3" placeholder="Ej. Sé directo, usa tablas para setups y responde siempre en español…"></textarea>
        <label for="aiMemoryInput">Memoria persistente (hechos que recordará entre chats)</label>
        <textarea id="aiMemoryInput" rows="3" placeholder="Ej. Piloto GT3 en iRacing, Ferrari 296 GT3…"></textarea>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap">
          <button type="button" id="aiClearHistoryBtn" class="ai-mini-btn" style="color:#ef4444;border-color:rgba(239,68,68,.35)">Borrar historial local</button>
          <div style="display:flex;gap:8px">
            <button type="button" class="ai-mini-btn" data-close-ai-modal>Cancelar</button>
            <button type="submit" class="ai-btn-accent">Guardar preferencias</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <style is:global>
    /* Synced 100 % with the global header theme toggle (html.light / html[data-theme="light"]) */
    .ai-shell {
      --ai-bg: #111315;
      --ai-side: #0b0d0f;
      --ai-surface: #1a1d21;
      --ai-surface-2: #24282e;
      --ai-line: rgba(255, 255, 255, 0.09);
      --ai-text: #f3f4f6;
      --ai-muted: #9ca3af;
      --ai-accent: #10b981;
      --ai-accent-ink: #04130d;
      display: grid;
      grid-template-columns: 256px minmax(0, 1fr);
      height: calc(100dvh - 56px);
      background: var(--ai-bg);
      color: var(--ai-text);
      font-family: var(--r-sans, system-ui, -apple-system, sans-serif);
      overflow: hidden;
    }
    html.light .ai-shell,
    html[data-theme="light"] .ai-shell {
      --ai-bg: #f8f9fa;
      --ai-side: #f1f3f5;
      --ai-surface: #ffffff;
      --ai-surface-2: #e9ecef;
      --ai-line: rgba(15, 23, 42, 0.11);
      --ai-text: #111827;
      --ai-muted: #5b6470;
      --ai-accent: #059669;
      --ai-accent-ink: #ffffff;
    }
    .ai-shell.is-side-collapsed { grid-template-columns: 0px minmax(0, 1fr); }
    .ai-shell.has-artifact { grid-template-columns: 236px minmax(0, 1fr) minmax(380px, 46%); }
    .ai-shell.is-side-collapsed.has-artifact { grid-template-columns: 0px minmax(0, 1fr) minmax(380px, 48%); }

    /* Sidebar */
    .ai-side {
      background: var(--ai-side); border-right: 1px solid var(--ai-line);
      display: flex; flex-direction: column; padding: 12px 10px; gap: 6px;
      overflow: hidden; min-width: 0;
    }
    .ai-shell.is-side-collapsed .ai-side { padding: 0; border-right: 0; }
    .ai-side__head { display: flex; align-items: center; justify-content: space-between; padding: 4px 6px 8px; }
    .ai-brand { display: inline-flex; align-items: center; gap: 8px; color: var(--ai-text); text-decoration: none; font: 700 15.5px/1 var(--r-sans, system-ui, sans-serif); letter-spacing: -0.02em; }
    .ai-brand__ico { color: var(--ai-accent); flex-shrink: 0; }
    .ai-side__nav { display: flex; flex-direction: column; gap: 2px; }
    .ai-side-btn {
      width: 100%; display: flex; align-items: center; gap: 10px; padding: 8px 10px;
      border-radius: 9px; border: 0; background: transparent; color: var(--ai-muted);
      font: 500 13.5px/1.2 var(--r-sans, system-ui, sans-serif); text-align: left; cursor: pointer;
    }
    .ai-side-btn:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-side-btn--primary { background: var(--ai-surface); color: var(--ai-text); font-weight: 600; margin-bottom: 4px; border: 1px solid var(--ai-line); }
    .ai-kbd-pill, .ai-side-pill {
      margin-left: auto; font: 600 10.5px/1 var(--r-mono); padding: 2px 6px;
      border-radius: 5px; background: var(--ai-surface-2); color: var(--ai-muted);
    }
    .ai-side-pill { color: var(--ai-accent); }
    .ai-search-wrap input {
      width: 100%; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-text); font-size: 12.5px; margin: 4px 0;
    }
    .ai-side__label { font: 600 11px/1.2 var(--r-sans, system-ui, sans-serif); color: var(--ai-muted); padding: 12px 10px 4px; }
    .ai-chat-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }
    .ai-chat-empty { padding: 10px; font-size: 12px; color: var(--ai-muted); }
    .ai-chat-item { display: flex; align-items: center; border-radius: 8px; }
    .ai-chat-item:hover, .ai-chat-item.is-active { background: var(--ai-surface); }
    .ai-chat-item__btn {
      flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ai-text);
      padding: 7px 10px; font-size: 13px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;
    }
    .ai-chat-item__del { border: 0; background: transparent; color: var(--ai-muted); padding: 4px 8px; cursor: pointer; opacity: 0; }
    .ai-chat-item:hover .ai-chat-item__del { opacity: 1; }
    .ai-chat-item__del:hover { color: #ef4444; }
    .ai-side__foot { border-top: 1px solid var(--ai-line); padding-top: 8px; }
    .ai-mit-link { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 8px; font-size: 12px; color: var(--ai-muted); text-decoration: none; }
    .ai-mit-link:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ai-accent); flex-shrink: 0; }

    /* Main Stage */
    .ai-stage { display: flex; flex-direction: column; min-width: 0; height: 100%; overflow: hidden; position: relative; }
    .ai-topbar { display: flex; align-items: center; gap: 10px; padding: 10px 18px; flex-shrink: 0; }
    .ai-top-pill { font: 600 11.5px/1 var(--r-mono); padding: 5px 10px; border-radius: 999px; background: var(--ai-surface); border: 1px solid var(--ai-line); color: var(--ai-muted); }
    .ai-ico-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 0; background: transparent;
      color: var(--ai-muted); display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .ai-ico-btn:hover { background: var(--ai-surface); color: var(--ai-text); }

    .ai-local-bar {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px;
      padding: 8px 16px; background: var(--ai-surface); border-bottom: 1px solid var(--ai-line); font-size: 12px; color: var(--ai-accent);
    }
    .ai-local-bar input { padding: 5px 9px; border-radius: 7px; border: 1px solid var(--ai-line); background: var(--ai-bg); color: var(--ai-text); font: 500 12px var(--r-mono); }

    /* Centered Welcome vs Active Chat */
    .ai-composer-wrap {
      flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 16px 20px 36px; gap: 18px; width: 100%; max-width: 760px; margin: 0 auto;
    }
    .ai-stage.is-chatting .ai-composer-wrap { flex: 0 0 auto; padding: 10px 20px 16px; gap: 8px; }
    .ai-stage.is-chatting .ai-starters { display: none; }
    .ai-empty__title { display: flex; align-items: center; gap: 11px; }
    .ai-emblem { color: var(--ai-accent); flex-shrink: 0; }
    .ai-empty h1 {
      margin: 0;
      font: 600 clamp(24px, 3vw, 34px)/1.2 var(--r-sans, system-ui, sans-serif) !important;
      text-transform: none !important;
      letter-spacing: -0.025em !important;
      color: var(--ai-text);
    }

    /* Composer Card */
    .ai-composer {
      width: 100%; background: var(--ai-surface); border: 1px solid var(--ai-line);
      border-radius: 18px; padding: 12px 14px 10px; display: flex; flex-direction: column; gap: 8px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.14);
    }
    .ai-composer:focus-within { border-color: color-mix(in srgb, var(--ai-accent) 55%, var(--ai-line)); }
    .ai-ctx-bar { display: flex; flex-wrap: wrap; gap: 6px; }
    .ai-ctx-pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 999px;
      background: var(--ai-surface-2); border: 1px solid var(--ai-line); font-size: 11.5px; color: var(--ai-text);
    }
    .ai-ctx-pill--accent { border-color: color-mix(in srgb, var(--ai-accent) 45%, transparent); color: var(--ai-accent); }
    .ai-ctx-pill button { border: 0; background: transparent; color: inherit; cursor: pointer; font-weight: 700; padding: 0 2px; }

    .ai-composer textarea {
      width: 100%; border: 0; background: transparent; color: var(--ai-text);
      font: 400 15px/1.5 var(--r-sans, system-ui, sans-serif); resize: none; outline: none; max-height: 200px;
    }
    .ai-composer textarea::placeholder { color: var(--ai-muted); }
    .ai-composer__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding-top: 2px; }
    .ai-composer__left, .ai-composer__right { display: flex; align-items: center; gap: 6px; }

    .ai-plus-btn {
      width: 32px; height: 32px; border-radius: 9px; border: 1px solid var(--ai-line);
      background: var(--ai-surface-2); color: var(--ai-text);
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .ai-plus-btn:hover { border-color: var(--ai-accent); color: var(--ai-accent); }

    .ai-model-btn, .ai-effort-btn {
      border: 0; background: transparent; color: var(--ai-muted); padding: 6px 9px;
      border-radius: 8px; font: 600 12.5px/1 var(--r-sans, system-ui, sans-serif); cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
    }
    .ai-model-btn:hover, .ai-effort-btn:hover { background: var(--ai-surface-2); color: var(--ai-text); }
    .ai-send-btn {
      width: 34px; height: 34px; border-radius: 10px; border: 0;
      background: var(--ai-accent); color: var(--ai-accent-ink);
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .ai-send-btn[data-state="stop"] { background: #ef4444; color: #fff; }

    /* Popover Menus: Opens DOWNWARD in empty state, UPWARD when chatting — NEVER clips into header */
    .ai-pop-anchor { position: relative; }
    .ai-popover {
      position: absolute; top: calc(100% + 8px); left: 0; z-index: 45;
      min-width: 260px; max-height: 360px; overflow-y: auto; padding: 6px; border-radius: 14px;
      background: var(--ai-surface); border: 1px solid var(--ai-line);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3); display: flex; flex-direction: column; gap: 2px;
    }
    .ai-stage.is-chatting .ai-popover { top: auto; bottom: calc(100% + 8px); }
    .ai-popover--right { left: auto; right: 0; min-width: 276px; }
    .ai-popover[hidden] { display: none !important; }
    .ai-pop-item {
      width: 100%; display: flex; align-items: center; justify-content: flex-start; gap: 10px;
      padding: 8px 10px; border: 0; border-radius: 8px; background: transparent; color: var(--ai-text);
      font-size: 13px; text-align: left; cursor: pointer;
    }
    .ai-pop-item svg { flex-shrink: 0; color: var(--ai-muted); }
    .ai-pop-item:hover { background: var(--ai-surface-2); }
    .ai-pop-item:hover svg { color: var(--ai-text); }
    .ai-pop-txt { flex: 1; text-align: left; white-space: nowrap; }
    .ai-pop-kbd { margin-left: auto; font: 600 10.5px/1 var(--r-mono); color: var(--ai-muted); }
    .ai-pop-sep { height: 1px; background: var(--ai-line); margin: 4px 6px; }
    .ai-pop-label { font: 700 10px/1 var(--r-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ai-muted); padding: 4px 10px; }
    .ai-check-mark { margin-left: auto; color: transparent; font-weight: 800; font-size: 13px; }
    .ai-check-mark.is-on { color: var(--ai-accent); }
    .ai-model-opt {
      width: 100%; display: flex; flex-direction: column; gap: 2px; padding: 9px 11px;
      border: 0; border-radius: 9px; background: transparent; color: var(--ai-text); text-align: left; cursor: pointer;
    }
    .ai-model-opt strong { font-size: 13px; }
    .ai-model-opt span { font-size: 11.5px; color: var(--ai-muted); }
    .ai-model-opt:hover, .ai-model-opt.is-active { background: var(--ai-surface-2); }
    .ai-model-opt.is-active strong { color: var(--ai-accent); }

    /* Starters */
    .ai-starters { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .ai-starters button {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 8px 14px; border-radius: 999px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-muted); font-size: 12.5px; font-weight: 500; cursor: pointer;
    }
    .ai-starters button:hover { border-color: var(--ai-accent); color: var(--ai-text); }

    /* Chat Feed */
    .ai-feed {
      flex: 1; overflow-y: auto; padding: 12px 20px 24px;
      display: flex; flex-direction: column; gap: 20px;
      width: 100%; max-width: 820px; margin: 0 auto;
    }
    .ai-msg { display: flex; gap: 12px; }
    .ai-msg--user { justify-content: flex-end; }
    .ai-bubble--user {
      max-width: 78%; padding: 11px 15px; border-radius: 16px; border-top-right-radius: 4px;
      background: var(--ai-surface-2); color: var(--ai-text); font-size: 14.5px; line-height: 1.5;
    }
    .ai-msg-img { max-width: 240px; max-height: 160px; border-radius: 10px; margin-bottom: 8px; display: block; border: 1px solid var(--ai-line); }
    .ai-msg-att { font: 600 11.5px var(--r-mono); color: var(--ai-accent); margin-bottom: 6px; }
    .ai-bot-avatar {
      width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
      background: color-mix(in srgb, var(--ai-accent) 16%, transparent); color: var(--ai-accent);
      display: grid; place-items: center; margin-top: 2px;
    }
    .ai-bot-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
    .ai-bot-meta { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--ai-muted); }
    .ai-bot-meta strong { color: var(--ai-text); font-weight: 600; }
    .ai-meta-tag { font: 600 10.5px var(--r-mono); padding: 2px 7px; border-radius: 999px; background: var(--ai-surface); border: 1px solid var(--ai-line); color: var(--ai-accent); }
    .ai-think { border: 1px solid var(--ai-line); border-radius: 10px; background: var(--ai-surface); padding: 8px 12px; font-size: 12.5px; }
    .ai-think summary { cursor: pointer; color: var(--ai-muted); font-weight: 600; }
    .ai-think pre { margin: 8px 0 0; white-space: pre-wrap; color: var(--ai-muted); font: 400 12px/1.5 var(--r-mono); }

    /* Markdown inside AI */
    .ai-md { font-size: 14.5px; line-height: 1.65; color: var(--ai-text); }
    .ai-md h1, .ai-md h2, .ai-md h3 { margin: 14px 0 6px; font-weight: 700; color: var(--ai-text); text-transform: none !important; }
    .ai-md p { margin: 6px 0; }
    .ai-md ul, .ai-md ol { padding-left: 20px; margin: 6px 0; }
    .ai-md code { font-family: var(--r-mono); font-size: 12.5px; background: var(--ai-surface); padding: 2px 5px; border-radius: 5px; color: var(--ai-accent); }
    .ai-table-wrap { overflow-x: auto; margin: 10px 0; border: 1px solid var(--ai-line); border-radius: 10px; }
    .ai-md-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .ai-md-table th, .ai-md-table td { padding: 8px 12px; border-bottom: 1px solid var(--ai-line); text-align: left; }
    .ai-md-table th { background: var(--ai-surface); color: var(--ai-accent); font-size: 11.5px; text-transform: uppercase; }
    .ai-code-card { border: 1px solid var(--ai-line); border-radius: 12px; overflow: hidden; margin: 10px 0; background: #101113; }
    .ai-code-card__bar { display: flex; align-items: center; justify-content: space-between; padding: 7px 12px; background: #181a1e; border-bottom: 1px solid rgba(255,255,255,0.08); font: 700 11px var(--r-mono); color: #9ca3af; }
    .ai-code-card__btns { display: flex; gap: 6px; }
    .ai-code-card pre { margin: 0; padding: 12px 14px; overflow-x: auto; font: 400 12.5px/1.5 var(--r-mono); color: #e5e7eb; }
    .ai-code-card code { background: transparent; padding: 0; color: inherit; }

    .ai-msg-actions { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 2px; }
    .ai-act-btn, .ai-mini-btn {
      padding: 5px 10px; border-radius: 8px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-muted); font-size: 11.5px; font-weight: 600; cursor: pointer;
    }
    .ai-act-btn:hover, .ai-mini-btn:hover { border-color: var(--ai-accent); color: var(--ai-text); }
    .ai-mini-btn--accent { background: color-mix(in srgb, var(--ai-accent) 16%, transparent); border-color: color-mix(in srgb, var(--ai-accent) 50%, transparent); color: var(--ai-accent); }
    .ai-thinking-dots { display: inline-flex; align-items: center; gap: 6px; color: var(--ai-muted); font-size: 13px; }
    .ai-thinking-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--ai-accent); animation: aidot 1s infinite ease-in-out; }
    .ai-thinking-dots span:nth-child(2) { animation-delay: .15s; }
    .ai-thinking-dots span:nth-child(3) { animation-delay: .3s; }
    @keyframes aidot { 0%,80%,100% { opacity: .25; transform: scale(.8); } 40% { opacity: 1; transform: scale(1.2); } }

    /* Split-Screen Artifacts Studio */
    .ai-art-pane {
      border-left: 1px solid var(--ai-line); background: var(--ai-side);
      display: flex; flex-direction: column; height: 100%; overflow: hidden;
    }
