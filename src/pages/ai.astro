---
import Layout from '../layouts/Layout.astro';
import { MUNTRUME_KB } from '../data/muntrume-kb';

const pageTitle = "Muntrume AI · Studio Open Source | Muntrume Motorsport";
const pageDescription = "Muntrume AI Studio (100 % Open Source · MIT) en ai.muntru.me: asistente técnico con proyectos, artefactos interactivos, exportación DOC/PDF/Presentaciones/CSV, visión por imagen, búsqueda web en vivo y motores Muntrume 1.0 Lite, Pro, Ultra Max y Local.";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://ai.muntru.me/" hideFooter>
  <div class="ai-shell" id="aiWorkspace">
    <!-- LEFT SIDEBAR (100 % REAL OPEN-SOURCE TOOLS, ZERO EMOJIS) -->
    <aside id="aiSide" class="ai-side" aria-label="Navegación de Muntrume AI">
      <div class="ai-side__head">
        <a href="/" class="ai-brand">
          <span class="ai-brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </span>
          <span>Muntrume AI</span>
        </a>
        <button type="button" id="aiSideClose" class="ai-ico-btn" aria-label="Ocultar barra lateral" title="Ocultar barra lateral">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
        </button>
      </div>

      <nav class="ai-side__nav" aria-label="Herramientas">
        <button type="button" id="aiNewChatBtn" class="ai-side-btn ai-side-btn--primary">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span>Nuevo chat</span>
          <kbd class="ai-kbd-pill">Ctrl K</kbd>
        </button>
        <button type="button" id="aiSearchBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <span>Buscar</span>
        </button>
        <div id="aiSearchWrap" class="ai-search-wrap" hidden>
          <input type="search" id="aiSearchInput" placeholder="Filtrar conversaciones…" aria-label="Buscar conversaciones" />
        </div>
        <button type="button" id="aiProjectsBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Proyectos</span>
        </button>
        <button type="button" id="aiArtifactsBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <span>Artefactos</span>
        </button>
        <button type="button" id="aiCodeModeBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>Code</span>
          <span class="ai-side-pill">Live</span>
        </button>
        <button type="button" id="aiCalcBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="8.01" y2="10"/><line x1="12" y1="10" x2="12.01" y2="10"/><line x1="16" y1="10" x2="16.01" y2="10"/><line x1="8" y1="14" x2="8.01" y2="14"/><line x1="12" y1="14" x2="12.01" y2="14"/><line x1="16" y1="14" x2="16.01" y2="14"/><line x1="8" y1="18" x2="16" y2="18"/></svg>
          <span>Calculadoras</span>
        </button>
        <button type="button" id="aiPersonalizeBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09c-.66 0-1.25.4-1.51 1z"/></svg>
          <span>Personalización</span>
        </button>
      </nav>

      <div class="ai-side__label">Conversaciones</div>
      <div id="aiChatList" class="ai-chat-list"></div>

      <div class="ai-side__foot">
        <a href={MUNTRUME_KB.team.githubUrl} target="_blank" rel="noopener noreferrer" class="ai-mit-link">
          <span class="ai-dot"></span>
          <span>100 % Open Source · MIT</span>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:auto"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>
    </aside>

    <!-- MAIN CHAT STAGE -->
    <main class="ai-stage" id="aiStage">
      <div class="ai-stage-glow" aria-hidden="true"></div>

      <div class="ai-topbar">
        <div class="ai-topbar__left">
          <button type="button" id="aiSideToggle" class="ai-ico-btn" aria-label="Mostrar u ocultar barra lateral" title="Menú lateral">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
          </button>
          <span class="ai-top-pill">
            <span class="ai-dot"></span>
            <span id="aiTopLabel">ai.muntru.me</span>
          </span>
        </div>

        <div class="ai-topbar__right">
          <button type="button" id="aiPaceBtn" class="ai-pace-btn" title="Cambiar velocidad de lectura en vivo">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 14l4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
            <span id="aiPaceLabel">Ritmo: Lectura</span>
          </button>
        </div>
      </div>

      <!-- Local Ollama Bar (shown only when Muntrume Local is selected) -->
      <div id="aiLocalBar" class="ai-local-bar" hidden>
        <span>Muntrume Local (100 % privado)</span>
        <input type="url" id="aiOllamaUrl" value="http://localhost:11434/api/chat" aria-label="Endpoint Ollama" />
        <input type="text" id="aiOllamaModel" value="llama3.1:8b" aria-label="Modelo Ollama" style="max-width:150px" />
      </div>

      <!-- Messages Feed -->
      <div id="aiFeed" class="ai-feed" hidden></div>

      <!-- Scroll to bottom floating pill -->
      <button type="button" id="aiScrollDownBtn" class="ai-scroll-down" hidden aria-label="Bajar al final">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
        <span>Seguir lectura</span>
      </button>

      <!-- Centered Welcome + Pro Composer -->
      <div class="ai-composer-wrap">
        <div id="aiEmptyState" class="ai-empty">
          <div class="ai-empty__badge">
            <span class="ai-dot"></span>
            <span>Muntrume AI Studio · Open Source</span>
          </div>
          <div class="ai-empty__title">
            <span class="ai-emblem-ring" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" class="ai-emblem"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </span>
            <h1 id="aiGreeting">¿En qué trabajamos hoy?</h1>
          </div>
          <p class="ai-empty__sub">Ingeniería de setups iRacing, estrategia de stints, código interactivo, tablas, documentos y presentaciones.</p>
        </div>

        <!-- Live Pacing Status Bar (visible while typing) -->
        <div id="aiStreamBar" class="ai-stream-bar" hidden>
          <span class="ai-stream-bar__dot"></span>
          <span id="aiStreamBarText">Redactando a ritmo de lectura…</span>
          <button type="button" id="aiSkipAnimBtn" class="ai-stream-bar__skip">Mostrar todo</button>
        </div>

        <form id="aiComposerForm" class="ai-composer" autocomplete="off">
          <div id="aiContextPills" class="ai-ctx-bar" hidden></div>

          <textarea
            id="aiInput"
            rows="2"
            placeholder="Escribe una consulta, pega una captura (Ctrl+V) o adjunta un archivo…"
            aria-label="Mensaje para Muntrume AI"
          ></textarea>

          <input type="file" id="aiFileInput" class="hidden" accept="image/png,image/jpeg,image/webp,.txt,.md,.csv,.json,.js,.ts,.py,.html,.css,.sto,.xml,.yml,.yaml" />

          <div class="ai-composer__bar">
            <div class="ai-composer__left">
              <!-- Clean Monochrome "+" Tools Menu -->
              <div class="ai-pop-anchor">
                <button type="button" id="aiPlusBtn" class="ai-plus-btn" aria-label="Herramientas y adjuntos" title="Adjuntar y herramientas">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </button>
                <div id="aiPlusMenu" class="ai-popover" hidden>
                  <button type="button" id="aiActUpload" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    <span class="ai-pop-txt">Subir archivo o imagen</span>
                    <kbd class="ai-pop-kbd">Ctrl+U</kbd>
                  </button>
                  <button type="button" id="aiActGithub" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                    <span class="ai-pop-txt">Importar desde GitHub</span>
                  </button>
                  <button type="button" id="aiActProject" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span class="ai-pop-txt">Cambiar proyecto</span>
                  </button>
                  <div class="ai-pop-sep"></div>
                  <div class="ai-pop-label">Skills Open Source</div>
                  <button type="button" class="ai-pop-item" data-select-skill="setup">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    <span class="ai-pop-txt">Ingeniero de Setups iRacing</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="strategy">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    <span class="ai-pop-txt">Estrategia y combustible</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="code">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    <span class="ai-pop-txt">Código y artefacto HTML</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="slides">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    <span class="ai-pop-txt">Presentación Slides</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="doc">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span class="ai-pop-txt">Documento Word / PDF</span>
                  </button>
                  <div class="ai-pop-sep"></div>
                  <button type="button" id="aiActWebToggle" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span class="ai-pop-txt">Búsqueda web en vivo</span>
                    <span id="aiMenuWebCheck" class="ai-check-mark is-on">✓</span>
                  </button>
                  <button type="button" id="aiActMemToggle" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                    <span class="ai-pop-txt">Memoria persistente</span>
                    <span id="aiMenuMemCheck" class="ai-check-mark is-on">✓</span>
                  </button>
                </div>
              </div>
            </div>

            <div class="ai-composer__right">
              <!-- Racing-Branded Open Source Model Selector -->
              <div class="ai-pop-anchor">
                <button type="button" id="aiModelBtn" class="ai-model-btn" title="Cambiar motor Muntrume">
                  <span id="aiModelBtnLabel">Muntrume 1.0 Pro</span>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div id="aiModelMenu" class="ai-popover ai-popover--right" hidden>
                  <button type="button" class="ai-model-opt" data-select-tier="lite">
                    <strong>Muntrume 1.0 Lite</strong>
                    <span>Ágil · Respuestas rápidas y cálculos</span>
                  </button>
                  <button type="button" class="ai-model-opt is-active" data-select-tier="pro">
                    <strong>Muntrume 1.0 Pro</strong>
                    <span>Equilibrado · Setups iRacing, código y documentos</span>
                  </button>
                  <button type="button" class="ai-model-opt" data-select-tier="ultra_max">
                    <strong>Muntrume 1.0 Ultra Max</strong>
                    <span>Razonamiento profundo paso a paso</span>
                  </button>
                  <button type="button" class="ai-model-opt" data-select-tier="local">
                    <strong>Muntrume Local</strong>
                    <span>100 % Privado en tu PC (Ollama localhost:11434)</span>
                  </button>
                </div>
              </div>

              <button type="button" id="aiEffortBtn" class="ai-effort-btn" title="Nivel de detalle">Medio</button>
              <button type="submit" id="aiSendBtn" class="ai-send-btn" data-state="send" aria-label="Enviar">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
              </button>
            </div>
          </div>
        </form>

        <!-- Clean 2x2 Editorial Starter Cards (0 emojis) -->
        <div class="ai-starters-grid">
          <button type="button" class="ai-starter-card" data-starter-skill="setup" data-starter-prompt="Tengo subviraje en entrada de curva lenta y sobreviraje saliendo en Ferrari 296 GT3 en Spa. Dame diagnóstico con tabla de clics exactos y notas de telemetría.">
            <span class="ai-starter-card__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            <span class="ai-starter-card__body">
              <strong>Ingeniería de Setups</strong>
              <span>Diagnóstico GT3, tabla de clics y telemetría</span>
            </span>
          </button>
          <button type="button" class="ai-starter-card" data-starter-skill="strategy" data-starter-prompt="Calcula estrategia completa de combustible y paradas en tabla para una carrera de resistencia de 6 horas en GT3 (tanque 100 L, consumo 2.95 L/vuelta, vuelta de 2:17).">
            <span class="ai-starter-card__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </span>
            <span class="ai-starter-card__body">
              <strong>Estrategia y Stints</strong>
              <span>Plan de combustible, ventanas y neumáticos</span>
            </span>
          </button>
          <button type="button" class="ai-starter-card" data-starter-skill="code" data-starter-prompt="Crea un artefacto HTML interactivo de calculadora de combustible y stints para iRacing con modo oscuro limpio y resultados en tiempo real.">
            <span class="ai-starter-card__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </span>
            <span class="ai-starter-card__body">
              <strong>Código y Artefacto Live</strong>
              <span>Apps HTML, diagramas SVG y tablas CSV</span>
            </span>
          </button>
          <button type="button" class="ai-starter-card" data-starter-skill="slides" data-starter-prompt="Prepara una presentación ejecutiva de 5 diapositivas en bloque slides sobre Muntrume Motorsport, su ecosistema MMT Sync y la temporada IMSA 2026 S4.">
            <span class="ai-starter-card__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </span>
            <span class="ai-starter-card__body">
              <strong>Presentación y Docs</strong>
              <span>Slides 16:9 navegables, Word (.doc) y PDF</span>
            </span>
          </button>
        </div>
      </div>
    </main>

    <!-- SPLIT-SCREEN ARTIFACTS & EXPORT STUDIO -->
    <aside id="aiArtifactPane" class="ai-art-pane" hidden aria-label="Estudio de Artefactos">
      <div class="ai-art-head">
        <div style="min-width:0;display:flex;align-items:center;gap:8px">
          <span id="aiArtBadge" class="ai-art-badge">HTML</span>
          <strong id="aiArtTitle" class="ai-art-title">Artefacto</strong>
        </div>
        <div class="ai-art-tabs">
          <button type="button" id="aiArtTabPreview" class="is-active">Vista previa</button>
          <button type="button" id="aiArtTabCode">Código</button>
        </div>
        <button type="button" id="aiArtClose" class="ai-ico-btn" aria-label="Cerrar panel">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="ai-art-export-bar">
        <button type="button" id="aiArtExportDoc" class="ai-mini-btn">Exportar DOC</button>
        <button type="button" id="aiArtExportPdf" class="ai-mini-btn">Exportar PDF</button>
        <button type="button" id="aiArtExportSlides" class="ai-mini-btn">Presentación</button>
        <button type="button" id="aiArtExportMd" class="ai-mini-btn">Markdown</button>
        <button type="button" id="aiArtDownload" class="ai-mini-btn">Descargar</button>
        <button type="button" id="aiArtCopy" class="ai-mini-btn">Copiar</button>
      </div>
      <iframe id="aiArtFrame" class="ai-art-frame" sandbox="allow-scripts" title="Vista previa del artefacto"></iframe>
      <div id="aiArtCodeWrap" class="ai-art-code-wrap" hidden>
        <pre><code id="aiArtCode"></code></pre>
      </div>
    </aside>
  </div>

  <!-- MODAL: CALCULADORAS DE INGENIERÍA IRACING -->
  <div id="aiCalcModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card" style="width:min(620px,100%)">
      <div class="ai-modal__head">
        <h2>Calculadoras de Ingeniería iRacing</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <div class="ai-art-tabs" style="width:fit-content">
        <button type="button" id="calcTabFuel" class="is-active">Combustible y Stints</button>
        <button type="button" id="calcTabBalance">Diagnóstico Setup</button>
      </div>

      <div id="calcPanelFuel" class="ai-modal-form">
        <div class="ai-calc-grid">
          <div>
            <label for="calcRaceMins">Duración carrera (min)</label>
            <input type="number" id="calcRaceMins" value="45" min="5" max="1440" />
          </div>
          <div>
            <label for="calcLapTime">Tiempo de vuelta (m:ss)</label>
            <input type="text" id="calcLapTime" value="2:17.5" placeholder="2:17.5" />
          </div>
          <div>
            <label for="calcFuelLap">Consumo (L / vuelta)</label>
            <input type="number" id="calcFuelLap" value="2.95" step="0.05" min="0.2" max="20" />
          </div>
          <div>
            <label for="calcTankSize">Depósito máximo (L)</label>
            <input type="number" id="calcTankSize" value="100" step="1" min="10" max="200" />
          </div>
        </div>
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:12.5px;color:var(--ai-muted)">
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" id="calcFormLap" checked style="width:auto" /> +1 vuelta formación</label>
          <label style="display:inline-flex;align-items:center;gap:6px">Margen extra (vueltas): <input type="number" id="calcMarginLaps" value="1" min="0" max="5" step="0.5" style="width:64px;padding:4px 7px" /></label>
        </div>
        <div id="calcFuelResult" class="ai-calc-out"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:4px">
          <button type="button" class="ai-mini-btn" data-close-ai-modal>Cerrar</button>
          <button type="button" id="calcSendFuelToAi" class="ai-btn-accent">Analizar estrategia con Muntrume AI</button>
        </div>
      </div>

      <div id="calcPanelBalance" class="ai-modal-form" hidden>
        <div class="ai-calc-grid">
          <div>
            <label for="calcCarCat">Categoría / Coche</label>
            <select id="calcCarCat" class="ai-select">
              <option value="GT3">GT3 (Ferrari 296, Porsche 992, BMW M4…)</option>
              <option value="GTP">GTP / Hypercar (499P, 963, Valkyrie…)</option>
              <option value="Porsche Cup">Porsche 911 GT3 Cup (992)</option>
              <option value="GT4">GT4 / TCR</option>
            </select>
          </div>
          <div>
            <label for="calcSymptom">Síntoma principal en pista</label>
            <select id="calcSymptom" class="ai-select">
              <option value="entry_understeer">Subviraje en entrada (frenada / turn-in)</option>
              <option value="mid_understeer">Subviraje en vértice (mitad de curva)</option>
              <option value="exit_oversteer">Sobreviraje en salida (aceleración)</option>
              <option value="entry_oversteer">Sobreviraje en frenada / entrada</option>
              <option value="brake_lock">Bloqueo temprano de ruedas al frenar</option>
              <option value="rear_wear">Sobrecalentamiento / degradación trasera</option>
            </select>
          </div>
        </div>
        <div id="calcBalanceResult" class="ai-calc-out"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:4px">
          <button type="button" class="ai-mini-btn" data-close-ai-modal>Cerrar</button>
          <button type="button" id="calcSendBalanceToAi" class="ai-btn-accent">Pedir clics exactos a Muntrume 1.0 Pro</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: GITHUB IMPORT -->
  <div id="aiGithubModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Importar contexto desde GitHub</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <form id="aiGithubForm" class="ai-modal-form">
        <label for="aiGithubUrlInput">URL de repositorio o archivo público en GitHub</label>
        <input type="url" id="aiGithubUrlInput" required placeholder="https://github.com/ATM-Software-Labs/muntrume-site" />
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:4px">
          <button type="button" class="ai-mini-btn" data-close-ai-modal>Cancelar</button>
          <button type="submit" class="ai-btn-accent">Adjuntar al chat</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: PROYECTOS -->
  <div id="aiProjectsModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Proyectos</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <div id="aiProjectsList" class="ai-proj-list"></div>
      <form id="aiNewProjectForm" class="ai-modal-form">
        <input type="text" id="aiNewProjName" required placeholder="Nombre del nuevo proyecto…" />
        <textarea id="aiNewProjPrompt" rows="2" placeholder="Instrucciones fijas para este proyecto (opcional)…"></textarea>
        <button type="submit" class="ai-btn-accent">Crear y activar proyecto</button>
      </form>
    </div>
  </div>

  <!-- MODAL: ARTEFACTOS -->
  <div id="aiArtifactsModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Biblioteca de Artefactos</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <div id="aiArtifactsGallery" class="ai-proj-list"></div>
    </div>
  </div>

  <!-- MODAL: PERSONALIZACIÓN Y MEMORIA -->
  <div id="aiPersonalizeModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Personalización y Memoria</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <form id="aiPersonalizeForm" class="ai-modal-form">
        <label for="aiPaceSelect">Velocidad de escritura y animación en vivo</label>
        <select id="aiPaceSelect" class="ai-select">
          <option value="calm">Lectura pausada (recomendado para leer mientras escribe)</option>
          <option value="normal">Normal equilibrada</option>
          <option value="fast">Rápida</option>
        </select>
        <label for="aiCustomInstrInput">Instrucciones personalizadas</label>
        <textarea id="aiCustomInstrInput" rows="3" placeholder="Ej. Sé directo, usa tablas para setups y responde siempre en español…"></textarea>
        <label for="aiMemoryInput">Memoria persistente (hechos que recordará entre chats)</label>
        <textarea id="aiMemoryInput" rows="3" placeholder="Ej. Piloto GT3 en iRacing, Ferrari 296 GT3…"></textarea>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:4px;flex-wrap:wrap">
          <button type="button" id="aiClearHistoryBtn" class="ai-mini-btn" style="color:#ef4444;border-color:rgba(239,68,68,.35)">Borrar historial local</button>
          <div style="display:flex;gap:8px">
            <button type="button" class="ai-mini-btn" data-close-ai-modal>Cancelar</button>
            <button type="submit" class="ai-btn-accent">Guardar preferencias</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <style is:global>
    /* Synced 100 % with the global header theme toggle (html.light / html[data-theme="light"]) */
    .ai-shell {
      --ai-bg: #0f1114;
      --ai-side: #0a0c0e;
      --ai-surface: #171a1f;
      --ai-surface-2: #20242b;
      --ai-code-bg: #0c0e12;
      --ai-code-bar: #14171d;
      --ai-line: rgba(255, 255, 255, 0.085);
      --ai-line-strong: rgba(255, 255, 255, 0.16);
      --ai-text: #f3f5f8;
      --ai-text-soft: #cfd5df;
      --ai-muted: #8b94a3;
      --ai-accent: #10b981;
      --ai-accent-soft: rgba(16, 185, 129, 0.12);
      --ai-accent-ink: #04130d;
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      height: calc(100dvh - 56px);
      background: var(--ai-bg);
      color: var(--ai-text);
      font-family: var(--r-sans, system-ui, -apple-system, sans-serif);
      overflow: hidden;
      transition: grid-template-columns 0.22s cubic-bezier(0.22, 1, 0.36, 1);
    }
    html.light .ai-shell,
    html[data-theme="light"] .ai-shell {
      --ai-bg: #f9fafb;
      --ai-side: #f1f3f6;
      --ai-surface: #ffffff;
      --ai-surface-2: #eceff4;
      --ai-code-bg: #11141a;
      --ai-code-bar: #1a1f28;
      --ai-line: rgba(15, 23, 42, 0.10);
      --ai-line-strong: rgba(15, 23, 42, 0.18);
      --ai-text: #0f172a;
      --ai-text-soft: #334155;
      --ai-muted: #64748b;
      --ai-accent: #059669;
      --ai-accent-soft: rgba(5, 150, 105, 0.10);
      --ai-accent-ink: #ffffff;
    }
    .ai-shell.is-side-collapsed { grid-template-columns: 0px minmax(0, 1fr); }
    .ai-shell.has-artifact { grid-template-columns: 236px minmax(0, 1fr) minmax(400px, 47%); }
    .ai-shell.is-side-collapsed.has-artifact { grid-template-columns: 0px minmax(0, 1fr) minmax(400px, 49%); }

    /* Sidebar */
    .ai-side {
      background: var(--ai-side); border-right: 1px solid var(--ai-line);
      display: flex; flex-direction: column; padding: 12px 10px; gap: 6px;
      overflow: hidden; min-width: 0;
    }
    .ai-shell.is-side-collapsed .ai-side { padding: 0; border-right: 0; }
    .ai-side__head { display: flex; align-items: center; justify-content: space-between; padding: 2px 6px 8px; }
    .ai-brand { display: inline-flex; align-items: center; gap: 9px; color: var(--ai-text); text-decoration: none; font: 700 15px/1 var(--r-sans, system-ui, sans-serif); letter-spacing: -0.02em; }
    .ai-brand__mark {
      width: 28px; height: 28px; border-radius: 9px;
      background: var(--ai-accent-soft); border: 1px solid color-mix(in srgb, var(--ai-accent) 32%, transparent);
      color: var(--ai-accent); display: grid; place-items: center; flex-shrink: 0;
    }
    .ai-side__nav { display: flex; flex-direction: column; gap: 2px; }
    .ai-side-btn {
      width: 100%; display: flex; align-items: center; gap: 10px; padding: 8px 10px;
      border-radius: 9px; border: 1px solid transparent; background: transparent; color: var(--ai-muted);
      font: 500 13.5px/1.2 var(--r-sans, system-ui, sans-serif); text-align: left; cursor: pointer;
      transition: background 0.14s ease, color 0.14s ease, border-color 0.14s ease;
    }
    .ai-side-btn:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-side-btn--primary {
      background: var(--ai-surface); color: var(--ai-text); font-weight: 600; margin-bottom: 5px;
      border-color: var(--ai-line); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    .ai-side-btn--primary:hover { border-color: color-mix(in srgb, var(--ai-accent) 45%, var(--ai-line)); }
    .ai-kbd-pill, .ai-side-pill {
      margin-left: auto; font: 600 10px/1 var(--r-mono); padding: 3px 6px;
      border-radius: 5px; background: var(--ai-surface-2); color: var(--ai-muted);
    }
    .ai-side-pill { color: var(--ai-accent); background: var(--ai-accent-soft); }
    .ai-search-wrap input {
      width: 100%; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-text); font-size: 12.5px; margin: 4px 0; outline: none;
    }
    .ai-search-wrap input:focus { border-color: var(--ai-accent); }
    .ai-side__label { font: 600 10.5px/1.2 var(--r-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ai-muted); padding: 12px 10px 4px; }
    .ai-chat-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }
    .ai-chat-empty { padding: 10px; font-size: 12px; color: var(--ai-muted); }
    .ai-chat-item { display: flex; align-items: center; border-radius: 8px; transition: background 0.12s ease; }
    .ai-chat-item:hover, .ai-chat-item.is-active { background: var(--ai-surface); }
    .ai-chat-item.is-active { box-shadow: inset 2px 0 0 var(--ai-accent); }
    .ai-chat-item__btn {
      flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ai-text);
      padding: 7px 10px; font-size: 13px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;
    }
    .ai-chat-item__del { border: 0; background: transparent; color: var(--ai-muted); padding: 4px 8px; cursor: pointer; opacity: 0; transition: opacity 0.14s ease, color 0.14s ease; }
    .ai-chat-item:hover .ai-chat-item__del { opacity: 1; }
    .ai-chat-item__del:hover { color: #ef4444; }
    .ai-side__foot { border-top: 1px solid var(--ai-line); padding-top: 8px; }
    .ai-mit-link { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 8px; font-size: 12px; color: var(--ai-muted); text-decoration: none; transition: background 0.14s ease, color 0.14s ease; }
    .ai-mit-link:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ai-accent); flex-shrink: 0; }

    /* Main Stage */
    .ai-stage { display: flex; flex-direction: column; min-width: 0; height: 100%; overflow: hidden; position: relative; }
    .ai-stage-glow {
      position: absolute; top: -120px; left: 50%; transform: translateX(-50%);
      width: min(760px, 90%); height: 340px; pointer-events: none; z-index: 0;
      background: radial-gradient(ellipse at center, color-mix(in srgb, var(--ai-accent) 11%, transparent) 0%, transparent 70%);
      transition: opacity 0.35s ease;
    }
    .ai-stage.is-chatting .ai-stage-glow { opacity: 0.32; }
    .ai-topbar {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 10px 18px; flex-shrink: 0; position: relative; z-index: 2;
      border-bottom: 1px solid transparent;
    }
    .ai-stage.is-chatting .ai-topbar { border-bottom-color: var(--ai-line); background: color-mix(in srgb, var(--ai-bg) 88%, transparent); backdrop-filter: blur(8px); }
    .ai-topbar__left, .ai-topbar__right { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .ai-top-pill {
      display: inline-flex; align-items: center; gap: 7px;
      font: 600 11.5px/1 var(--r-mono); padding: 6px 11px; border-radius: 999px;
      background: var(--ai-surface); border: 1px solid var(--ai-line); color: var(--ai-muted);
      max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ai-pace-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 11px; border-radius: 999px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-muted);
      font: 600 11.5px/1 var(--r-sans, system-ui, sans-serif); cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .ai-pace-btn:hover { border-color: var(--ai-accent); color: var(--ai-text); }
    .ai-pace-btn svg { color: var(--ai-accent); }
    .ai-ico-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 0; background: transparent;
      color: var(--ai-muted); display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
      transition: background 0.14s ease, color 0.14s ease;
    }
    .ai-ico-btn:hover { background: var(--ai-surface); color: var(--ai-text); }

    .ai-local-bar {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px;
      padding: 8px 16px; background: var(--ai-surface); border-bottom: 1px solid var(--ai-line); font-size: 12px; color: var(--ai-accent);
      position: relative; z-index: 2;
    }
    .ai-local-bar input { padding: 5px 9px; border-radius: 7px; border: 1px solid var(--ai-line); background: var(--ai-bg); color: var(--ai-text); font: 500 12px var(--r-mono); }

    /* Centered Welcome vs Active Chat */
    .ai-composer-wrap {
      flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 18px 20px 36px; gap: 20px; width: 100%; max-width: 780px; margin: 0 auto;
      position: relative; z-index: 2;
    }
    .ai-stage.is-chatting .ai-composer-wrap { flex: 0 0 auto; padding: 8px 20px 16px; gap: 8px; }
    .ai-stage.is-chatting .ai-starters-grid { display: none; }
    .ai-empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; animation: aiMsgIn 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
    .ai-empty__badge {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 5px 12px; border-radius: 999px;
      background: var(--ai-surface); border: 1px solid var(--ai-line);
      font: 600 11px/1 var(--r-mono); letter-spacing: 0.04em; color: var(--ai-muted);
    }
    .ai-empty__title { display: flex; align-items: center; justify-content: center; gap: 12px; }
    .ai-emblem-ring {
      width: 40px; height: 40px; border-radius: 13px; flex-shrink: 0;
      background: var(--ai-accent-soft); border: 1px solid color-mix(in srgb, var(--ai-accent) 36%, transparent);
      display: grid; place-items: center; box-shadow: 0 0 28px color-mix(in srgb, var(--ai-accent) 22%, transparent);
    }
    .ai-emblem { color: var(--ai-accent); flex-shrink: 0; }
    .ai-empty h1 {
      margin: 0;
      font: 700 clamp(25px, 3.2vw, 36px)/1.16 var(--r-sans, system-ui, sans-serif) !important;
      text-transform: none !important;
      letter-spacing: -0.03em !important;
      color: var(--ai-text);
    }
    .ai-empty__sub { margin: 0; max-width: 560px; font-size: 14px; line-height: 1.55; color: var(--ai-muted); }

    /* Live Streaming Pacing Bar */
    .ai-stream-bar {
      width: 100%; display: flex; align-items: center; gap: 9px;
      padding: 6px 12px; border-radius: 999px;
      background: var(--ai-surface); border: 1px solid color-mix(in srgb, var(--ai-accent) 35%, var(--ai-line));
      font-size: 12px; color: var(--ai-muted);
      animation: aiMsgIn 0.2s ease;
    }
    .ai-stream-bar[hidden] { display: none !important; }
    .ai-stream-bar__dot {
      width: 7px; height: 7px; border-radius: 50%; background: var(--ai-accent);
      animation: aiPulseRing 1.4s infinite ease-in-out; flex-shrink: 0;
    }
    .ai-stream-bar__skip {
      margin-left: auto; border: 1px solid var(--ai-line); background: var(--ai-surface-2);
      color: var(--ai-text); border-radius: 999px; padding: 3px 10px;
      font: 600 11px/1.2 var(--r-sans, system-ui, sans-serif); cursor: pointer;
    }
    .ai-stream-bar__skip:hover { border-color: var(--ai-accent); color: var(--ai-accent); }

    /* Scroll down pill */
    .ai-scroll-down {
      position: absolute; left: 50%; bottom: 136px; transform: translateX(-50%); z-index: 15;
      display: inline-flex; align-items: center; gap: 6px; padding: 6px 13px; border-radius: 999px;
      background: var(--ai-surface); color: var(--ai-text); border: 1px solid var(--ai-line-strong);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28); font: 600 12px/1 var(--r-sans, system-ui, sans-serif);
      cursor: pointer; animation: aiMsgIn 0.18s ease;
    }
    .ai-scroll-down:hover { border-color: var(--ai-accent); color: var(--ai-accent); }
    .ai-scroll-down[hidden] { display: none !important; }

    /* Composer Card */
    .ai-composer {
      width: 100%; background: var(--ai-surface); border: 1px solid var(--ai-line);
      border-radius: 20px; padding: 13px 15px 11px; display: flex; flex-direction: column; gap: 8px;
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.14);
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .ai-composer:focus-within {
      border-color: color-mix(in srgb, var(--ai-accent) 55%, var(--ai-line));
      box-shadow: 0 12px 38px rgba(0, 0, 0, 0.18), 0 0 0 3px color-mix(in srgb, var(--ai-accent) 12%, transparent);
    }
    .ai-ctx-bar { display: flex; flex-wrap: wrap; gap: 6px; }
    .ai-ctx-pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
      background: var(--ai-surface-2); border: 1px solid var(--ai-line); font-size: 11.5px; color: var(--ai-text);
    }
    .ai-ctx-pill--accent { background: var(--ai-accent-soft); border-color: color-mix(in srgb, var(--ai-accent) 40%, transparent); color: var(--ai-accent); }
    .ai-ctx-pill button { border: 0; background: transparent; color: inherit; cursor: pointer; font-weight: 700; padding: 0 2px; }

    .ai-composer textarea {
      width: 100%; border: 0; background: transparent; color: var(--ai-text);
      font: 400 15px/1.55 var(--r-sans, system-ui, sans-serif); resize: none; outline: none; max-height: 220px;
    }
    .ai-composer textarea::placeholder { color: var(--ai-muted); }
    .ai-composer__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding-top: 2px; }
    .ai-composer__left, .ai-composer__right { display: flex; align-items: center; gap: 6px; }

    .ai-plus-btn {
      width: 34px; height: 34px; border-radius: 10px; border: 1px solid var(--ai-line);
      background: var(--ai-surface-2); color: var(--ai-text);
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
      transition: border-color 0.14s ease, color 0.14s ease, transform 0.14s ease;
    }
    .ai-plus-btn:hover { border-color: var(--ai-accent); color: var(--ai-accent); }

    .ai-model-btn, .ai-effort-btn {
      border: 1px solid transparent; background: transparent; color: var(--ai-muted); padding: 6px 10px;
      border-radius: 9px; font: 600 12.5px/1 var(--r-sans, system-ui, sans-serif); cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
      transition: background 0.14s ease, color 0.14s ease;
    }
    .ai-model-btn:hover, .ai-effort-btn:hover { background: var(--ai-surface-2); color: var(--ai-text); }
    .ai-send-btn {
      width: 35px; height: 35px; border-radius: 10px; border: 0;
      background: var(--ai-accent); color: var(--ai-accent-ink);
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
      transition: transform 0.14s ease, opacity 0.14s ease;
    }
    .ai-send-btn:hover { transform: translateY(-1px); }
    .ai-send-btn[data-state="stop"] { background: #ef4444; color: #fff; }

    /* Popover Menus */
    .ai-pop-anchor { position: relative; }
    .ai-popover {
      position: absolute; top: calc(100% + 8px); left: 0; z-index: 45;
      min-width: 268px; max-height: 360px; overflow-y: auto; padding: 6px; border-radius: 14px;
      background: var(--ai-surface); border: 1px solid var(--ai-line-strong);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.34); display: flex; flex-direction: column; gap: 2px;
      animation: aiPopIn 0.14s ease;
    }
    .ai-stage.is-chatting .ai-popover { top: auto; bottom: calc(100% + 8px); }
    .ai-popover--right { left: auto; right: 0; min-width: 282px; }
    .ai-popover[hidden] { display: none !important; }
    .ai-pop-item {
      width: 100%; display: flex; align-items: center; justify-content: flex-start; gap: 10px;
      padding: 8px 10px; border: 0; border-radius: 8px; background: transparent; color: var(--ai-text);
      font-size: 13px; text-align: left; cursor: pointer;
    }
    .ai-pop-item svg { flex-shrink: 0; color: var(--ai-muted); }
    .ai-pop-item:hover { background: var(--ai-surface-2); }
    .ai-pop-item:hover svg { color: var(--ai-text); }
    .ai-pop-txt { flex: 1; text-align: left; white-space: nowrap; }
    .ai-pop-kbd { margin-left: auto; font: 600 10.5px/1 var(--r-mono); color: var(--ai-muted); }
    .ai-pop-sep { height: 1px; background: var(--ai-line); margin: 4px 6px; }
    .ai-pop-label { font: 700 10px/1 var(--r-mono); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ai-muted); padding: 4px 10px; }
    .ai-check-mark { margin-left: auto; color: transparent; font-weight: 800; font-size: 13px; }
    .ai-check-mark.is-on { color: var(--ai-accent); }
    .ai-model-opt {
      width: 100%; display: flex; flex-direction: column; gap: 2px; padding: 9px 11px;
      border: 0; border-radius: 9px; background: transparent; color: var(--ai-text); text-align: left; cursor: pointer;
    }
    .ai-model-opt strong { font-size: 13px; }
    .ai-model-opt span { font-size: 11.5px; color: var(--ai-muted); }
    .ai-model-opt:hover, .ai-model-opt.is-active { background: var(--ai-surface-2); }
    .ai-model-opt.is-active strong { color: var(--ai-accent); }

    /* 2x2 Starter Cards */
    .ai-starters-grid {
      width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;
    }
    .ai-starter-card {
      display: flex; align-items: flex-start; gap: 11px; padding: 12px 14px;
      border-radius: 14px; border: 1px solid var(--ai-line); background: var(--ai-surface);
      text-align: left; cursor: pointer; transition: border-color 0.16s ease, transform 0.16s ease, background 0.16s ease;
    }
    .ai-starter-card:hover {
      border-color: color-mix(in srgb, var(--ai-accent) 55%, var(--ai-line));
      transform: translateY(-1px);
    }
    .ai-starter-card__ico {
      width: 32px; height: 32px; border-radius: 9px; flex-shrink: 0;
      background: var(--ai-accent-soft); color: var(--ai-accent);
      display: grid; place-items: center; margin-top: 1px;
    }
    .ai-starter-card__body { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .ai-starter-card__body strong { font-size: 13px; font-weight: 600; color: var(--ai-text); }
    .ai-starter-card__body span { font-size: 12px; line-height: 1.4; color: var(--ai-muted); }

    /* Chat Feed */
    .ai-feed {
      flex: 1; overflow-y: auto; padding: 20px 22px 28px;
      display: flex; flex-direction: column; gap: 24px;
      width: 100%; max-width: 820px; margin: 0 auto;
      position: relative; z-index: 1;
      scroll-behavior: smooth;
    }
    .ai-msg { display: flex; gap: 13px; animation: aiMsgIn 0.24s cubic-bezier(0.22, 1, 0.36, 1); }
    .ai-msg--user { justify-content: flex-end; }
    .ai-bubble--user {
      max-width: 78%; padding: 12px 16px; border-radius: 18px; border-top-right-radius: 5px;
      background: var(--ai-surface-2); border: 1px solid var(--ai-line);
      color: var(--ai-text); font-size: 14.5px; line-height: 1.58;
    }
    .ai-msg-img { max-width: 260px; max-height: 180px; border-radius: 10px; margin-bottom: 8px; display: block; border: 1px solid var(--ai-line); }
    .ai-msg-att { font: 600 11.5px var(--r-mono); color: var(--ai-accent); margin-bottom: 6px; }
    .ai-bot-avatar {
      width: 32px; height: 32px; border-radius: 10px; flex-shrink: 0;
      background: var(--ai-accent-soft); border: 1px solid color-mix(in srgb, var(--ai-accent) 28%, transparent);
      color: var(--ai-accent); display: grid; place-items: center; margin-top: 1px;
    }
    .ai-msg--streaming .ai-bot-avatar { animation: aiAvatarPulse 1.8s infinite ease-in-out; }
    .ai-bot-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
    .ai-bot-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; font-size: 12px; color: var(--ai-muted); }
    .ai-bot-meta strong { color: var(--ai-text); font-weight: 600; }
    .ai-meta-tag { font: 600 10.5px var(--r-mono); padding: 2px 8px; border-radius: 999px; background: var(--ai-surface); border: 1px solid var(--ai-line); color: var(--ai-accent); }

    /* Reasoning Accordion */
    .ai-think {
      border: 1px solid var(--ai-line); border-left: 3px solid var(--ai-accent);
      border-radius: 11px; background: var(--ai-surface); padding: 9px 13px; font-size: 12.5px;
    }
    .ai-think summary {
      cursor: pointer; color: var(--ai-muted); font-weight: 600;
      display: flex; align-items: center; gap: 8px; list-style: none;
    }
    .ai-think summary::-webkit-details-marker { display: none; }
    .ai-think__pulse {
      width: 7px; height: 7px; border-radius: 50%; background: var(--ai-accent);
      animation: aiPulseRing 1.3s infinite ease-in-out; flex-shrink: 0;
    }
    .ai-think pre {
      margin: 9px 0 0; padding-top: 8px; border-top: 1px solid var(--ai-line);
      white-space: pre-wrap; color: var(--ai-muted); font: 400 12px/1.58 var(--r-mono);
      max-height: 260px; overflow-y: auto;
    }

    /* Rich Editorial Markdown Typography */
    .ai-md { font-size: 15px; line-height: 1.72; color: var(--ai-text); word-wrap: break-word; }
    .ai-md > :first-child { margin-top: 0 !important; }
    .ai-md > :last-child { margin-bottom: 0 !important; }
    .ai-md h1 {
      margin: 18px 0 10px; font-size: 21px; line-height: 1.28; font-weight: 700;
      letter-spacing: -0.02em; color: var(--ai-text); text-transform: none !important;
    }
    .ai-md h2 {
      margin: 20px 0 9px; padding-bottom: 6px; border-bottom: 1px solid var(--ai-line);
      font-size: 17.5px; line-height: 1.32; font-weight: 700; letter-spacing: -0.015em;
      color: var(--ai-text); text-transform: none !important;
    }
    .ai-md h3 {
      margin: 16px 0 7px; font-size: 15.5px; line-height: 1.36; font-weight: 700;
      color: var(--ai-text); text-transform: none !important;
    }
    .ai-md h4 {
      margin: 14px 0 5px; font: 700 12px/1.3 var(--r-mono); letter-spacing: 0.05em;
      text-transform: uppercase !important; color: var(--ai-accent);
    }
    .ai-md p { margin: 9px 0; color: var(--ai-text-soft); }
    .ai-md strong { color: var(--ai-text); font-weight: 650; }
    .ai-md em { font-style: italic; }
    .ai-md del { color: var(--ai-muted); text-decoration: line-through; }
    .ai-md a { color: var(--ai-accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: color-mix(in srgb, var(--ai-accent) 45%, transparent); }
    .ai-md a:hover { text-decoration-color: var(--ai-accent); }
    .ai-md hr { border: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--ai-line-strong), transparent); margin: 18px 0; }
    .ai-md ul, .ai-md ol { padding-left: 22px; margin: 9px 0; color: var(--ai-text-soft); }
    .ai-md li { margin: 4px 0; }
    .ai-md li > ul, .ai-md li > ol { margin: 4px 0; }
    .ai-md img.ai-md-img { max-width: 100%; border-radius: 12px; border: 1px solid var(--ai-line); margin: 10px 0; display: block; }

    /* Task Checklists */
    .ai-md ul.ai-task-list { list-style: none; padding-left: 4px; }
    .ai-task-item { display: flex; align-items: flex-start; gap: 9px; margin: 6px 0; }
    .ai-task-box {
      width: 16px; height: 16px; margin-top: 4px; border-radius: 4px; flex-shrink: 0;
      border: 1.5px solid var(--ai-line-strong); display: grid; place-items: center; color: transparent;
    }
    .ai-task-item.is-done .ai-task-box { background: var(--ai-accent); border-color: var(--ai-accent); color: var(--ai-accent-ink); }
    .ai-task-item.is-done > span:last-child { color: var(--ai-muted); text-decoration: line-through; }

    /* Inline code & Math */
    .ai-md code {
      font-family: var(--r-mono, ui-monospace, monospace); font-size: 12.5px;
      background: var(--ai-surface-2); border: 1px solid var(--ai-line);
      padding: 1.5px 6px; border-radius: 6px; color: var(--ai-accent);
    }
    .ai-math-inline {
      font-family: "Cambria Math", Georgia, serif; font-style: italic; font-size: 15.5px;
      padding: 1px 5px; border-radius: 5px; background: var(--ai-surface); color: var(--ai-text);
    }
    .ai-math-block {
      margin: 12px 0; padding: 14px 18px; border-radius: 12px;
      background: var(--ai-surface); border: 1px solid var(--ai-line);
      font-family: "Cambria Math", Georgia, serif; font-size: 16.5px; text-align: center;
      color: var(--ai-text); overflow-x: auto;
    }

    /* Blockquotes & Admonition Callouts */
    .ai-md blockquote {
      margin: 12px 0; padding: 10px 15px; border-left: 3px solid var(--ai-accent);
      background: var(--ai-surface); border-radius: 0 11px 11px 0;
      color: var(--ai-text-soft);
    }
    .ai-md blockquote p { margin: 4px 0; }
    .ai-callout {
      margin: 12px 0; padding: 11px 15px; border-radius: 12px;
      border: 1px solid var(--ai-line); border-left: 3px solid var(--ai-accent);
      background: var(--ai-surface);
    }
    .ai-callout__head {
      display: flex; align-items: center; gap: 7px; margin-bottom: 5px;
      font: 700 11px/1 var(--r-mono); letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ai-accent);
    }
    .ai-callout__body { font-size: 14px; line-height: 1.6; color: var(--ai-text-soft); }
    .ai-callout__body p { margin: 4px 0; }
    .ai-callout--note { border-left-color: #3b82f6; }
    .ai-callout--note .ai-callout__head { color: #3b82f6; }
    .ai-callout--tip { border-left-color: #10b981; }
    .ai-callout--tip .ai-callout__head { color: #10b981; }
    .ai-callout--important { border-left-color: #8b5cf6; }
    .ai-callout--important .ai-callout__head { color: #8b5cf6; }
    .ai-callout--warning { border-left-color: #f59e0b; }
    .ai-callout--warning .ai-callout__head { color: #f59e0b; }
    .ai-callout--caution { border-left-color: #ef4444; }
    .ai-callout--caution .ai-callout__head { color: #ef4444; }

    /* Tables */
    .ai-table-card {
      margin: 14px 0; border: 1px solid var(--ai-line); border-radius: 13px;
      background: var(--ai-surface); overflow: hidden;
    }
    .ai-table-card__bar {
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding: 6px 12px; border-bottom: 1px solid var(--ai-line); background: var(--ai-side);
      font: 600 10.5px/1 var(--r-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--ai-muted);
    }
    .ai-table-wrap { overflow-x: auto; }
    .ai-md-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .ai-md-table th, .ai-md-table td { padding: 9px 13px; border-bottom: 1px solid var(--ai-line); vertical-align: top; }
    .ai-md-table tbody tr:last-child td { border-bottom: 0; }
    .ai-md-table tbody tr:nth-child(even) { background: color-mix(in srgb, var(--ai-surface-2) 38%, transparent); }
    .ai-md-table tbody tr:hover { background: color-mix(in srgb, var(--ai-accent) 7%, transparent); }
    .ai-md-table th {
      background: var(--ai-surface); color: var(--ai-text);
      font: 700 11.5px/1.3 var(--r-mono); text-transform: uppercase; letter-spacing: 0.04em;
      white-space: nowrap;
    }

    /* Code Cards & Lightweight Syntax Highlight */
    .ai-code-card {
      border: 1px solid var(--ai-line-strong); border-radius: 13px; overflow: hidden;
      margin: 14px 0; background: var(--ai-code-bg);
    }
    .ai-code-card__bar {
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
      padding: 7px 12px; background: var(--ai-code-bar);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font: 600 11px/1 var(--r-mono); color: #9ca3af;
    }
    .ai-code-card__lang { display: inline-flex; align-items: center; gap: 8px; }
    .ai-code-card__meta { color: #6b7280; font-weight: 500; }
    .ai-code-card__btns { display: flex; gap: 6px; }
    .ai-code-card pre {
      margin: 0; padding: 13px 15px; overflow-x: auto;
      font: 400 12.8px/1.58 var(--r-mono, ui-monospace, monospace); color: #e5e7eb;
    }
    .ai-code-card code { background: transparent; border: 0; padding: 0; color: inherit; font-size: inherit; }
    .ai-code-card .ai-mini-btn { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.14); color: #d1d5db; }
    .ai-code-card .ai-mini-btn:hover { border-color: #10b981; color: #fff; }
    .ai-code-card .ai-mini-btn--accent { background: rgba(16,185,129,0.18); border-color: rgba(16,185,129,0.45); color: #34d399; }
    .tok-kw { color: #c084fc; font-weight: 500; }
    .tok-str { color: #86efac; }
    .tok-num { color: #fbbf24; }
    .tok-com { color: #6b7280; font-style: italic; }
    .tok-key { color: #7dd3fc; }
    .tok-tag { color: #f472b6; }
    .tok-fn { color: #60a5fa; }

    /* Live Streaming Cursor & Thinking Indicators */
    .ai-caret {
      display: inline-block; width: 2.5px; height: 1.08em; margin-left: 3px;
      vertical-align: -0.16em; border-radius: 2px; background: var(--ai-accent);
      animation: aiCaretBlink 0.9s infinite ease-in-out;
    }
    .ai-thinking-dots {
      display: inline-flex; align-items: center; gap: 8px; padding: 8px 13px;
      border-radius: 11px; background: var(--ai-surface); border: 1px solid var(--ai-line);
      color: var(--ai-muted); font-size: 13px;
    }
    .ai-thinking-dots span {
      width: 6px; height: 6px; border-radius: 50%; background: var(--ai-accent);
      animation: aidot 1.15s infinite ease-in-out;
    }
    .ai-thinking-dots span:nth-child(2) { animation-delay: 0.16s; }
    .ai-thinking-dots span:nth-child(3) { animation-delay: 0.32s; }

    .ai-msg-actions { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 2px; }
    .ai-act-btn, .ai-mini-btn {
      padding: 5px 10px; border-radius: 8px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-muted); font-size: 11.5px; font-weight: 600; cursor: pointer;
      transition: border-color 0.14s ease, color 0.14s ease, background 0.14s ease;
    }
    .ai-act-btn:hover, .ai-mini-btn:hover { border-color: var(--ai-accent); color: var(--ai-text); }
    .ai-mini-btn--accent { background: var(--ai-accent-soft); border-color: color-mix(in srgb, var(--ai-accent) 48%, transparent); color: var(--ai-accent); }

    @keyframes aiMsgIn { from { opacity: 0; transform: translateY(7px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes aiPopIn { from { opacity: 0; transform: translateY(4px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @keyframes aidot { 0%,80%,100% { opacity: 0.25; transform: scale(0.78); } 40% { opacity: 1; transform: scale(1.18); } }
    @keyframes aiCaretBlink { 0%,100% { opacity: 1; } 50% { opacity: 0.15; } }
    @keyframes aiPulseRing { 0%,100% { opacity: 0.45; transform: scale(0.88); } 50% { opacity: 1; transform: scale(1.18); } }
    @keyframes aiAvatarPulse { 0%,100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ai-accent) 26%, transparent); } 50% { box-shadow: 0 0 0 6px transparent; } }

    /* Split-Screen Artifacts Studio */
    .ai-art-pane {
      border-left: 1px solid var(--ai-line); background: var(--ai-side);
      display: flex; flex-direction: column; height: 100%; overflow: hidden;
    }
    .ai-art-pane[hidden] { display: none !important; }
    .ai-art-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--ai-line); }
    .ai-art-badge { font: 700 10px var(--r-mono); padding: 3px 8px; border-radius: 999px; background: var(--ai-accent-soft); color: var(--ai-accent); }
    .ai-art-title { font-size: 13.5px; color: var(--ai-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ai-art-tabs { display: inline-flex; gap: 4px; background: var(--ai-surface); padding: 2px; border-radius: 8px; border: 1px solid var(--ai-line); }
    .ai-art-tabs button { border: 0; background: transparent; color: var(--ai-muted); padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; }
    .ai-art-tabs button.is-active { background: var(--ai-surface-2); color: var(--ai-text); }
    .ai-art-export-bar { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 14px; border-bottom: 1px solid var(--ai-line); background: var(--ai-surface); }
    .ai-art-frame { flex: 1; width: 100%; border: 0; background: #fff; }
    .ai-art-code-wrap { flex: 1; overflow: auto; padding: 16px; background: var(--ai-code-bg); color: #e5e7eb; font: 400 12.5px/1.55 var(--r-mono); }

    /* Modals */
    .ai-modal { position: fixed; inset: 0; z-index: 90; background: rgba(0, 0, 0, 0.62); backdrop-filter: blur(4px); display: grid; place-items: center; padding: 20px; }
    .ai-modal[hidden] { display: none !important; }
    .ai-modal__card {
      width: min(560px, 100%); max-height: 86vh; overflow-y: auto;
      background: var(--ai-surface); color: var(--ai-text); border: 1px solid var(--ai-line-strong);
      border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 14px;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.42);
      animation: aiPopIn 0.16s ease;
    }
    .ai-modal__head { display: flex; align-items: center; justify-content: space-between; }
    .ai-modal__head h2 { margin: 0; font-size: 17px; font-weight: 700; text-transform: none !important; }
    .ai-proj-list { display: flex; flex-direction: column; gap: 8px; }
    .ai-proj-card {
      display: flex; align-items: center; gap: 12px; padding: 11px 13px; border-radius: 12px;
      background: var(--ai-bg); border: 1px solid var(--ai-line);
    }
    .ai-proj-card.is-active { border-color: var(--ai-accent); }
    .ai-proj-card strong { display: block; font-size: 13.5px; }
    .ai-proj-card p { margin: 2px 0 0; font-size: 12px; color: var(--ai-muted); }
    .ai-modal-form { display: flex; flex-direction: column; gap: 8px; }
    .ai-modal-form label { font-size: 12px; font-weight: 600; color: var(--ai-muted); }
    .ai-modal-form input, .ai-modal-form textarea, .ai-select {
      width: 100%; padding: 9px 11px; border-radius: 10px; border: 1px solid var(--ai-line);
      background: var(--ai-bg); color: var(--ai-text); font-size: 13px;
    }
    .ai-calc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .ai-calc-out {
      padding: 12px 14px; border-radius: 12px; background: var(--ai-bg);
      border: 1px solid color-mix(in srgb, var(--ai-accent) 40%, var(--ai-line));
      font-size: 13px; line-height: 1.55; color: var(--ai-text);
    }
    .ai-calc-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .ai-calc-kpi { padding: 8px 10px; border-radius: 9px; background: var(--ai-surface); border: 1px solid var(--ai-line); }
    .ai-calc-kpi span { display: block; font: 600 10px/1.2 var(--r-mono); text-transform: uppercase; color: var(--ai-muted); }
    .ai-calc-kpi strong { display: block; margin-top: 3px; font: 700 15px/1.2 var(--r-mono); color: var(--ai-accent); }
    .ai-btn-accent {
      padding: 9px 16px; border-radius: 999px; border: 0;
