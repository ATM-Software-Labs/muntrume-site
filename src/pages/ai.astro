---
import Layout from '../layouts/Layout.astro';
import { MUNTRUME_KB } from '../data/muntrume-kb';

const pageTitle = "Muntrume AI · Studio Open Source | Muntrume Motorsport";
const pageDescription = "Muntrume AI Studio (100 % Open Source · MIT): interfaz avanzada con proyectos, artefactos interactivos, exportación a DOC/PDF/Presentaciones, visión por imagen, búsqueda web en vivo, GitHub y motores Muntrume 1.0 Lite, Pro, Ultra Max y Local.";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/ai/" hideFooter>
  <div class="ai-shell" id="aiWorkspace" data-ai-theme="dark">
    <!-- CLAUDE-STYLE LEFT SIDEBAR -->
    <aside id="aiSide" class="ai-side" aria-label="Navegación de Muntrume AI">
      <div class="ai-side__head">
        <a href="/" class="ai-brand" title="Volver a Muntrume Motorsport">
          <span class="ai-brand__mark" aria-hidden="true">✦</span>
          <span>Muntrume AI</span>
        </a>
        <button type="button" id="aiSideClose" class="ai-ico-btn" aria-label="Ocultar barra lateral" title="Ocultar barra lateral">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
        </button>
      </div>

      <nav class="ai-side__nav" aria-label="Herramientas">
        <button type="button" id="aiNewChatBtn" class="ai-side-btn ai-side-btn--primary">
          <span class="ai-side-ico">+</span>
          <span>Nuevo</span>
          <kbd>Ctrl K</kbd>
        </button>
        <button type="button" id="aiSearchBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <span>Buscar</span>
        </button>
        <div id="aiSearchWrap" class="ai-search-wrap" hidden>
          <input type="search" id="aiSearchInput" placeholder="Filtrar chats…" aria-label="Buscar conversaciones" />
        </div>
        <button type="button" id="aiProjectsBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Proyectos</span>
        </button>
        <button type="button" id="aiArtifactsBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <span>Artefactos</span>
        </button>
        <button type="button" id="aiCodeModeBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>Code</span>
          <span class="ai-side-pill">Live</span>
        </button>
        <button type="button" id="aiPersonalizeBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09c-.66 0-1.25.4-1.51 1z"/></svg>
          <span>Personalización</span>
        </button>
      </nav>

      <div class="ai-side__label">Chats y tareas</div>
      <div id="aiChatList" class="ai-chat-list"></div>

      <div class="ai-side__foot">
        <button type="button" id="aiThemeBtn" class="ai-side-btn">
          <span id="aiThemeIcon" aria-hidden="true">☀</span>
          <span id="aiThemeLabel">Modo claro</span>
        </button>
        <a href={MUNTRUME_KB.team.githubUrl} target="_blank" rel="noopener noreferrer" class="ai-mit-link">
          <span class="ai-dot"></span>
          <span>100 % Open Source · MIT</span>
          <span>↗</span>
        </a>
      </div>
    </aside>

    <!-- MAIN CHAT STAGE -->
    <main class="ai-stage" id="aiStage">
      <header class="ai-topbar">
        <div class="ai-topbar__left">
          <button type="button" id="aiSideToggle" class="ai-ico-btn" aria-label="Mostrar u ocultar barra lateral" title="Menú lateral">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
          </button>
          <span class="ai-top-pill">100 % Open Source · Sin límites de pago</span>
        </div>
        <div class="ai-topbar__right">
          <a href="/garage/" class="ai-top-link">Garage</a>
          <a href="/drivers/" class="ai-top-link">Pilotos</a>
          <a href="/app/" class="ai-top-link">MMT Sync</a>
        </div>
      </header>

      <!-- Local Ollama Bar -->
      <div id="aiLocalBar" class="ai-local-bar" hidden>
        <span>🔒 Muntrume Local (100 % privado)</span>
        <input type="url" id="aiOllamaUrl" value="http://localhost:11434/api/chat" aria-label="Endpoint Ollama" />
        <input type="text" id="aiOllamaModel" value="llama3.1:8b" aria-label="Modelo Ollama" style="max-width:150px" />
      </div>

      <!-- Messages Feed -->
      <div id="aiFeed" class="ai-feed" hidden></div>

      <!-- Centered Empty Greeting + Composer Wrapper -->
      <div class="ai-composer-wrap">
        <div id="aiEmptyState" class="ai-empty">
          <div class="ai-empty__title">
            <span class="ai-emblem" aria-hidden="true">✦</span>
            <h1 id="aiGreeting">Pensamientos de la noche</h1>
          </div>
        </div>

        <form id="aiComposerForm" class="ai-composer" autocomplete="off">
          <div id="aiContextPills" class="ai-ctx-bar" hidden></div>

          <textarea
            id="aiInput"
            rows="2"
            placeholder="¿En qué puedo ayudarte hoy?"
            aria-label="Escribe tu mensaje para Muntrume AI"
          ></textarea>

          <input type="file" id="aiFileInput" class="hidden" accept="image/png,image/jpeg,image/webp,.txt,.md,.csv,.json,.js,.ts,.py,.html,.css,.sto,.xml,.yml,.yaml" />

          <div class="ai-composer__bar">
            <div class="ai-composer__left">
              <!-- Claude-style "+" Action Menu -->
              <div class="ai-pop-anchor">
                <button type="button" id="aiPlusBtn" class="ai-plus-btn" aria-label="Añadir archivos, GitHub, skills o búsqueda web" title="Adjuntar y herramientas">+</button>
                <div id="aiPlusMenu" class="ai-popover" hidden>
                  <button type="button" id="aiActUpload" class="ai-pop-item"><span>📎</span><span>Subir o añadir archivos</span><kbd>Ctrl+U</kbd></button>
                  <button type="button" id="aiActPaste" class="ai-pop-item"><span>📷</span><span>Pegar captura de pantalla</span><kbd>Ctrl+V</kbd></button>
                  <button type="button" id="aiActProject" class="ai-pop-item"><span>📁</span><span>Añadir al proyecto</span><span>›</span></button>
                  <button type="button" id="aiActGithub" class="ai-pop-item"><span>🐙</span><span>Añadir desde GitHub</span></button>
                  <div class="ai-pop-sep"></div>
                  <div class="ai-pop-label">Skills rápidas</div>
                  <button type="button" class="ai-pop-item" data-select-skill="setup"><span>🏎️</span><span>Ingeniero de Setups iRacing</span></button>
                  <button type="button" class="ai-pop-item" data-select-skill="strategy"><span>📊</span><span>Estrategia &amp; Combustible</span></button>
                  <button type="button" class="ai-pop-item" data-select-skill="code"><span>💻</span><span>Código &amp; Artefactos UI</span></button>
                  <button type="button" class="ai-pop-item" data-select-skill="slides"><span>📽️</span><span>Presentación Slides</span></button>
                  <button type="button" class="ai-pop-item" data-select-skill="doc"><span>📄</span><span>Documento Word / PDF</span></button>
                  <div class="ai-pop-sep"></div>
                  <button type="button" id="aiActWebToggle" class="ai-pop-item"><span>🌐</span><span>Búsqueda web</span><span id="aiMenuWebCheck" class="ai-check-mark is-on">✓</span></button>
                  <button type="button" id="aiActMemToggle" class="ai-pop-item"><span>🧠</span><span>Memoria</span><span id="aiMenuMemCheck" class="ai-check-mark is-on">✓</span></button>
                </div>
              </div>

              <!-- Chat / Cowork Segmented Switch -->
              <div class="ai-seg">
                <button type="button" id="aiModeChatBtn" class="is-active">Chat</button>
                <button type="button" id="aiModeCoworkBtn">Cowork</button>
              </div>
            </div>

            <div class="ai-composer__right">
              <!-- Racing Model Selector -->
              <div class="ai-pop-anchor">
                <button type="button" id="aiModelBtn" class="ai-model-btn" title="Cambiar motor Muntrume">
                  <span id="aiModelBtnLabel">Muntrume 1.0 Pro</span>
                  <span aria-hidden="true">▾</span>
                </button>
                <div id="aiModelMenu" class="ai-popover ai-popover--right" hidden>
                  <button type="button" class="ai-model-opt" data-select-tier="lite">
                    <strong>Muntrume 1.0 Lite</strong>
                    <span>Instantáneo · Respuestas en milisegundos y cálculos</span>
                  </button>
                  <button type="button" class="ai-model-opt is-active" data-select-tier="pro">
                    <strong>Muntrume 1.0 Pro</strong>
                    <span>Equilibrado · Setups iRacing, código y documentos</span>
                  </button>
                  <button type="button" class="ai-model-opt" data-select-tier="ultra_max">
                    <strong>Muntrume 1.0 Ultra Max</strong>
                    <span>Razonamiento profundo paso a paso con análisis</span>
                  </button>
                  <button type="button" class="ai-model-opt" data-select-tier="local">
                    <strong>Muntrume Local</strong>
                    <span>100 % Privado en tu PC (Ollama localhost:11434)</span>
                  </button>
                </div>
              </div>

              <button type="button" id="aiEffortBtn" class="ai-effort-btn" title="Nivel de detalle">Medio</button>
              <button type="button" id="aiVoiceBtn" class="ai-ico-btn" aria-label="Dictar por voz" title="Dictado por voz">🎤</button>
              <button type="submit" id="aiSendBtn" class="ai-send-btn" data-state="send" aria-label="Enviar">↑</button>
            </div>
          </div>
        </form>

        <!-- Quick Starter Chips (shown when empty) -->
        <div class="ai-starters">
          <button type="button" data-starter-skill="setup" data-starter-prompt="Tengo subviraje en entrada de curva lenta y sobreviraje saliendo en Ferrari 296 GT3 en Spa. Dame diagnóstico y clics exactos.">🏎️ Ingeniería iRacing</button>
          <button type="button" data-starter-skill="strategy" data-starter-prompt="Calcula estrategia completa de combustible y paradas para una carrera de resistencia de 6 horas en GT3 (tanque 100 L, consumo 2.95 L/vuelta, vuelta de 2:17).">📊 Estrategia &amp; Fuel</button>
          <button type="button" data-starter-skill="code" data-starter-prompt="Crea un artefacto HTML interactivo de calculadora de combustible y stints para iRacing con modo oscuro limpio.">💻 Código &amp; Artefacto</button>
          <button type="button" data-starter-skill="slides" data-starter-prompt="Prepara una presentación ejecutiva de 5 diapositivas sobre Muntrume Motorsport, su ecosistema MMT Sync y la temporada IMSA 2026 S4.">📽️ Presentación</button>
        </div>
      </div>
    </main>

    <!-- SPLIT-SCREEN ARTIFACTS & EXPORT STUDIO -->
    <aside id="aiArtifactPane" class="ai-art-pane" hidden aria-label="Estudio de Artefactos">
      <div class="ai-art-head">
        <div style="min-width:0">
          <span id="aiArtBadge" class="ai-art-badge">HTML</span>
          <strong id="aiArtTitle" class="ai-art-title">Artefacto</strong>
        </div>
        <div class="ai-art-tabs">
          <button type="button" id="aiArtTabPreview" class="is-active">Vista previa</button>
          <button type="button" id="aiArtTabCode">Código</button>
        </div>
        <button type="button" id="aiArtClose" class="ai-ico-btn" aria-label="Cerrar panel">×</button>
      </div>
      <div class="ai-art-export-bar">
        <button type="button" id="aiArtExportDoc" class="ai-mini-btn">📄 Word (.doc)</button>
        <button type="button" id="aiArtExportPdf" class="ai-mini-btn">🖨️ PDF</button>
        <button type="button" id="aiArtExportSlides" class="ai-mini-btn">📽️ Slides</button>
        <button type="button" id="aiArtDownload" class="ai-mini-btn">⬇ Archivo</button>
        <button type="button" id="aiArtCopy" class="ai-mini-btn">📋 Copiar</button>
      </div>
      <iframe id="aiArtFrame" class="ai-art-frame" sandbox="allow-scripts" title="Vista previa del artefacto"></iframe>
      <div id="aiArtCodeWrap" class="ai-art-code-wrap" hidden>
        <pre><code id="aiArtCode"></code></pre>
      </div>
    </aside>
  </div>

  <!-- MODAL: PROYECTOS -->
  <div id="aiProjectsModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Proyectos</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal>×</button>
      </div>
      <div id="aiProjectsList" class="ai-proj-list"></div>
      <form id="aiNewProjectForm" class="ai-modal-form">
        <input type="text" id="aiNewProjName" required placeholder="Nombre del nuevo proyecto…" />
        <textarea id="aiNewProjPrompt" rows="2" placeholder="Instrucciones fijas para este proyecto (opcional)…"></textarea>
        <button type="submit" class="ai-btn-accent">+ Crear y activar proyecto</button>
      </form>
    </div>
  </div>

  <!-- MODAL: ARTEFACTOS GUARDADOS -->
  <div id="aiArtifactsModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Biblioteca de Artefactos</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal>×</button>
      </div>
      <div id="aiArtifactsGallery" class="ai-proj-list"></div>
    </div>
  </div>

  <!-- MODAL: PERSONALIZACIÓN Y MEMORIA -->
  <div id="aiPersonalizeModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card">
      <div class="ai-modal__head">
        <h2>Personalización &amp; Memoria</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal>×</button>
      </div>
      <form id="aiPersonalizeForm" class="ai-modal-form">
        <label>Instrucciones personalizadas (cómo quieres que responda Muntrume AI)</label>
        <textarea id="aiCustomInstrInput" rows="3" placeholder="Ej. Sé directo, usa tablas para setups y responde siempre en español…"></textarea>
        <label>Memoria persistente (hechos que recordará entre chats)</label>
        <textarea id="aiMemoryInput" rows="3" placeholder="Ej. Piloto GT3 en iRacing, Ferrari 296 GT3, volante Fanatec…"></textarea>
        <div style="display:flex;justify-content:flex-end;gap:8px">
          <button type="button" class="ai-mini-btn" data-close-ai-modal>Cancelar</button>
          <button type="submit" class="ai-btn-accent">Guardar preferencias</button>
        </div>
      </form>
    </div>
  </div>

  <style is:global>
    .ai-shell {
      --ai-bg: #1a1917;
      --ai-side: #141311;
      --ai-surface: #252421;
      --ai-surface-2: #2f2e2a;
      --ai-line: rgba(255, 255, 255, 0.09);
      --ai-text: #f3f1ec;
      --ai-muted: #9e9a92;
      --ai-accent: #10b981;
      --ai-accent-ink: #04130d;
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      height: calc(100dvh - 60px);
      background: var(--ai-bg);
      color: var(--ai-text);
      font-family: var(--r-sans, system-ui, -apple-system, sans-serif);
      overflow: hidden;
    }
    .ai-shell[data-ai-theme="light"] {
      --ai-bg: #f8f7f4;
      --ai-side: #f1efe9;
      --ai-surface: #ffffff;
      --ai-surface-2: #edeae2;
      --ai-line: rgba(15, 23, 42, 0.1);
      --ai-text: #1c1b18;
      --ai-muted: #64615a;
      --ai-accent: #059669;
      --ai-accent-ink: #ffffff;
    }
    .ai-shell.is-side-collapsed { grid-template-columns: 0px minmax(0, 1fr); }
    .ai-shell.has-artifact { grid-template-columns: 240px minmax(0, 1fr) minmax(380px, 46%); }
    .ai-shell.is-side-collapsed.has-artifact { grid-template-columns: 0px minmax(0, 1fr) minmax(380px, 48%); }

    /* Sidebar */
    .ai-side {
      background: var(--ai-side); border-right: 1px solid var(--ai-line);
      display: flex; flex-direction: column; padding: 12px 10px; gap: 6px;
      overflow: hidden; min-width: 0;
    }
    .ai-shell.is-side-collapsed .ai-side { padding: 0; border-right: 0; }
    .ai-side__head { display: flex; align-items: center; justify-content: space-between; padding: 4px 6px 8px; }
    .ai-brand { display: inline-flex; align-items: center; gap: 8px; color: var(--ai-text); text-decoration: none; font: 700 16px/1 var(--r-sans, system-ui, sans-serif); letter-spacing: -0.02em; }
    .ai-brand__mark { color: var(--ai-accent); font-size: 18px; }
    .ai-side__nav { display: flex; flex-direction: column; gap: 2px; }
    .ai-side-btn {
      width: 100%; display: flex; align-items: center; gap: 10px; padding: 8px 10px;
      border-radius: 9px; border: 0; background: transparent; color: var(--ai-muted);
      font: 500 13.5px/1.2 var(--r-sans, system-ui, sans-serif); text-align: left; cursor: pointer;
    }
    .ai-side-btn:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-side-btn--primary { background: var(--ai-surface); color: var(--ai-text); font-weight: 600; margin-bottom: 4px; }
    .ai-side-btn kbd, .ai-side-pill {
      margin-left: auto; font: 600 10.5px/1 var(--r-mono); padding: 2px 6px;
      border-radius: 5px; background: var(--ai-surface-2); color: var(--ai-muted);
    }
    .ai-side-pill { color: var(--ai-accent); }
    .ai-side-ico { width: 15px; text-align: center; font-weight: 700; font-size: 16px; }
    .ai-search-wrap input {
      width: 100%; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--ai-line);
      background: var(--ai-surface); color: var(--ai-text); font-size: 12.5px; margin: 4px 0;
    }
    .ai-side__label { font: 600 11px/1.2 var(--r-sans, system-ui, sans-serif); color: var(--ai-muted); padding: 12px 10px 4px; }
    .ai-chat-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }
    .ai-chat-empty { padding: 12px 10px; font-size: 12px; color: var(--ai-muted); }
    .ai-chat-item { display: flex; align-items: center; border-radius: 8px; }
    .ai-chat-item:hover, .ai-chat-item.is-active { background: var(--ai-surface); }
    .ai-chat-item__btn {
      flex: 1; min-width: 0; border: 0; background: transparent; color: var(--ai-text);
      padding: 7px 10px; font-size: 13px; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;
    }
    .ai-chat-item__del { border: 0; background: transparent; color: var(--ai-muted); padding: 4px 8px; cursor: pointer; opacity: 0; }
    .ai-chat-item:hover .ai-chat-item__del { opacity: 1; }
    .ai-chat-item__del:hover { color: #ef4444; }
    .ai-side__foot { border-top: 1px solid var(--ai-line); padding-top: 8px; display: flex; flex-direction: column; gap: 4px; }
    .ai-mit-link { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 8px; font-size: 12px; color: var(--ai-muted); text-decoration: none; }
    .ai-mit-link:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ai-accent); }

    /* Main Stage */
    .ai-stage { display: flex; flex-direction: column; min-width: 0; height: 100%; overflow: hidden; position: relative; }
    .ai-topbar {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 18px; flex-shrink: 0;
    }
    .ai-topbar__left, .ai-topbar__right { display: flex; align-items: center; gap: 10px; }
    .ai-top-pill { font: 600 11.5px/1 var(--r-sans, system-ui, sans-serif); padding: 5px 11px; border-radius: 999px; background: var(--ai-surface); border: 1px solid var(--ai-line); color: var(--ai-muted); }
    .ai-top-link { font-size: 12.5px; color: var(--ai-muted); text-decoration: none; padding: 5px 8px; border-radius: 7px; }
    .ai-top-link:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-ico-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 0; background: transparent;
      color: var(--ai-muted); display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    }
    .ai-ico-btn:hover { background: var(--ai-surface); color: var(--ai-text); }
    .ai-ico-btn.is-rec { color: #ef4444; background: rgba(239, 68, 68, 0.14); }

    .ai-local-bar {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px;
      padding: 8px 16px; background: var(--ai-surface); border-bottom: 1px solid var(--ai-line); font-size: 12px; color: var(--ai-accent);
    }
