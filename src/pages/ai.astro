---
import Layout from '../layouts/Layout.astro';
import { MUNTRUME_KB } from '../data/muntrume-kb';

const pageTitle = "Muntrume AI · Copiloto Open Source & Conocimiento MMT | Muntrume Motorsport";
const pageDescription = "Asistente híbrido 100 % Open Source (Licencia MIT) de Muntrume Motorsport: base de conocimiento oficial instantánea del equipo, estrategia GT3/Endurance y motor IA en streaming.";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/ai/" hideFooter>
  <div class="ai-app">
    <div id="aiScrim" class="ai-scrim" hidden></div>
    <aside id="aiSide" class="ai-side" aria-label="Conversaciones" hidden>
      <div class="ai-side__bar">
        <div class="ai-side__brand">
          <img src="/assets/img/icon-192.png" alt="Muntrume AI" width="24" height="24" />
          <p>Historial</p>
        </div>
        <button type="button" id="aiSideClose" class="ai-icon" aria-label="Cerrar historial">×</button>
      </div>
      <div class="ai-side__new">
        <button type="button" class="ai-side__newbtn" onclick="document.getElementById('aiNew')?.click()">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Nueva conversación</span>
        </button>
      </div>
      <div id="aiChatList" class="ai-list" role="list"></div>
      <div class="ai-side__foot">
        <a href="/overlay/">MMT Sync Overlay</a>
        <a href="/garage/">Setup Vault (.sto)</a>
        <a href="/wallpapers/">Wallpapers HD</a>
        <a href="/gallery/">Galería Paddock</a>
      </div>
    </aside>

    <div class="ai-main">
      <header class="ai-top">
        <div class="ai-top__left">
          <button type="button" id="aiSideOpen" class="ai-icon" aria-expanded="false" aria-controls="aiSide" aria-label="Abrir historial">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <div class="ai-top__brand">
            <img src="/assets/img/icon-192.png" alt="Muntrume AI" width="28" height="28" class="ai-top__logo" />
            <h1>Muntrume AI</h1>
            <a href="https://github.com/ATM-Software-Labs/muntrume-site" target="_blank" rel="noopener noreferrer" class="ai-oss-badge" title="Código fuente abierto en GitHub (MIT)">
              100 % Open Source · Licencia MIT
            </a>
          </div>
        </div>

        <div class="ai-mode-tabs" role="group" aria-label="Selector de modo">
          <button type="button" class="ai-mode-tab is-active" data-ai-mode="team" aria-pressed="true">Equipo &amp; iRacing</button>
          <button type="button" class="ai-mode-tab" data-ai-mode="assistant" aria-pressed="false">Asistente Open Source</button>
        </div>

        <div class="ai-top__actions">
          <button type="button" id="aiOllamaToggle" class="ai-ollama-btn" aria-pressed="false" title="Usar Ollama local (http://localhost:11434) en modo privacidad total">
            Ollama Local: Off
          </button>
          <div id="aiEngineStatus" class="ai-status-badge" title="Estado de Muntrume AI">
            <span class="ai-status-dot"></span>
            <span id="aiStatusText">KB + Open Source</span>
          </div>
          <button type="button" id="aiNew" class="ai-new-btn" title="Nueva conversación">
            + Nueva conversación
          </button>
        </div>
      </header>

      <div id="aiStage" class="ai-stage is-empty">
        <div id="aiEmpty" class="ai-empty">
          <div class="ai-hero">
            <div class="ai-hero__emblem">
              <img src="/assets/img/icon-192.png" alt="Muntrume Motorsport" width="48" height="48" />
            </div>
            <p class="ai-kicker">MUNTRUME MOTORSPORT · OPEN SOURCE AI</p>
            <h2 class="ai-hero__title">¿En qué te ayudo hoy?</h2>
            <p class="ai-empty__lead">
              Respuestas instantáneas sobre el equipo, pilotos, <strong>MMT Sync Overlay</strong> y setups, más asistente Open Source en streaming (sin paywalls).
            </p>
          </div>

          <div class="ai-starters" id="aiTopicButtons">
            <button type="button" data-prompt="¿Quiénes son los pilotos y cómo contacto con el equipo?">
              <span class="ai-starter__tag">Conocimiento Oficial · 0 ms</span>
              <strong>¿Quiénes son los pilotos y cómo contacto con el equipo?</strong>
              <span>Dorsales #16, #1, #22 y correos oficiales @muntru.me</span>
            </button>
            <button type="button" data-prompt="¿Cómo instalo y uso el MMT Sync Overlay Open Source?">
              <span class="ai-starter__tag">Overlay MIT · 60 FPS</span>
              <strong>¿Cómo instalo y uso el MMT Sync Overlay Open Source?</strong>
              <span>Requisitos, Pit Strategy, Tire Monitor y presets 1-clic</span>
            </button>
            <button type="button" data-prompt="Calcula combustible y estrategia para una carrera GT3 de 45 min">
              <span class="ai-starter__tag">Ingeniería · Estrategia</span>
              <strong>Calcula combustible y estrategia para una carrera GT3 de 45 min</strong>
              <span>Litros totales, consumo por vuelta, ventana de box y presiones</span>
            </button>
            <button type="button" data-prompt="Ayúdame como asistente Open Source general" data-switch-mode="assistant">
              <span class="ai-starter__tag">Asistente Open Source</span>
              <strong>Ayúdame como asistente Open Source general</strong>
              <span>Código, dudas técnicas, análisis y redacción en streaming</span>
            </button>
          </div>
        </div>
        <div id="aiLog" class="ai-log" role="log" aria-busy="false" hidden></div>
      </div>

      <button type="button" id="aiJump" class="ai-jump" hidden>Ir al final ↓</button>

      <form id="aiForm" class="ai-composer" autocomplete="off">
        <p id="aiLive" class="sr-only" aria-live="polite"></p>
        <div class="ai-composer__box">
          <label class="sr-only" for="aiInput">Escribe tu consulta para Muntrume AI</label>
          <textarea id="aiInput" rows="1" maxlength="1200" placeholder="Pregunta sobre Muntrume Motorsport, iRacing, setups o cualquier duda técnica…"></textarea>
          <button type="button" id="aiSend" aria-label="Enviar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
          </button>
        </div>
        <p class="ai-note">
          Modo <strong>Equipo &amp; iRacing</strong> (KB verificada + estrategia) · Modo <strong>Asistente Open Source</strong> (Llama/Qwen/Ollama). <a href="/overlay/">Overlay</a> · <a href="/garage/">Setups</a> · <a href="/wallpapers/">Wallpapers</a> · <a href="/gallery/">Galería</a>
        </p>
      </form>
    </div>
  </div>
</Layout>

<script type="application/json" id="muntrumeKbData" set:html={JSON.stringify(MUNTRUME_KB)}></script>

<style is:global>
  body:has(.ai-app) { height: 100dvh; min-height: 0; overflow: hidden; }
  body:has(.ai-app) #main-content { flex: 1; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
  .ai-app { flex: 1; min-height: 0; display: flex; background: #090b0f; color: #e2e8f0; }
  .ai-scrim { position: fixed; inset: var(--site-header, 56px) 0 0 0; background: rgba(4, 8, 7, .65); backdrop-filter: blur(4px); z-index: 30; }
  .ai-scrim[hidden], .ai-side[hidden], .ai-jump[hidden], .ai-actions[hidden] { display: none !important; }

  .ai-side { width: min(264px, 86vw); flex: 0 0 auto; display: flex; flex-direction: column; min-height: 0; background: #0c0f15; border-right: 1px solid rgba(255,255,255,.08); }
  .ai-side__bar { display: flex; align-items: center; justify-content: space-between; min-height: 52px; padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .ai-side__brand { display: flex; align-items: center; gap: 8px; }
  .ai-side__brand img { width: 22px; height: 22px; border-radius: 6px; object-fit: contain; }
  .ai-side__bar p { margin: 0; font: 700 11px/1 ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; color: #94a3b8; }
  .ai-side__new { padding: 10px 10px 4px; }
  .ai-side__newbtn { width: 100%; display: flex; align-items: center; gap: 8px; min-height: 38px; padding: 0 12px; border-radius: 10px; border: 1px solid rgba(255,255,255,.12); background: #090b0f; color: #f8fafc; font: 600 12.5px/1 sans-serif; cursor: pointer; }
  .ai-side__newbtn:hover { border-color: #10b981; color: #10b981; }
  .ai-list { flex: 1; min-height: 0; overflow: auto; padding: 8px; display: grid; align-content: start; gap: 4px; }
  .ai-list__empty { margin: 8px; color: #64748b; font-size: 12.5px; }
  .ai-chat { display: grid; grid-template-columns: 1fr auto auto; gap: 2px; align-items: center; }
  .ai-chat__open, .ai-rename { min-height: 36px; border: 0; border-radius: 8px; background: transparent; color: #cbd5e1; text-align: left; padding: 0 10px; cursor: pointer; font: 500 13px/1.3 sans-serif; }
  .ai-chat__open { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ai-chat__open[aria-current="true"] { background: rgba(16, 185, 129, .14); color: #34d399; font-weight: 600; }
  .ai-side__foot { padding: 10px 12px; border-top: 1px solid rgba(255,255,255,.08); display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ai-side__foot a { font: 600 11px/1.2 ui-monospace, monospace; color: #94a3b8; text-decoration: none; padding: 5px 6px; border-radius: 6px; }
  .ai-side__foot a:hover { color: #10b981; background: rgba(255,255,255,.04); }

  .ai-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; min-height: 56px; padding: 8px 16px; border-bottom: 1px solid rgba(255,255,255,.08); background: #0c0f15; }
  .ai-top__left { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ai-top__brand { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .ai-top__logo { width: 26px; height: 26px; border-radius: 7px; object-fit: contain; }
  .ai-top h1 { margin: 0; font-size: 15px; font-weight: 800; color: #ffffff; white-space: nowrap; }
  .ai-oss-badge { font: 700 10.5px/1 ui-monospace, monospace; padding: 5px 9px; border-radius: 999px; background: rgba(16, 185, 129, .12); border: 1px solid rgba(16, 185, 129, .35); color: #34d399; text-decoration: none; white-space: nowrap; }
  .ai-oss-badge:hover { background: rgba(16, 185, 129, .2); }

  .ai-mode-tabs { display: inline-flex; padding: 3px; border-radius: 10px; background: #090b0f; border: 1px solid rgba(255,255,255,.1); gap: 4px; }
  .ai-mode-tab { padding: 6px 12px; border-radius: 7px; border: 0; background: transparent; color: #94a3b8; font: 700 12px/1 ui-monospace, monospace; cursor: pointer; transition: background .15s, color .15s; }
  .ai-mode-tab.is-active { background: #10b981; color: #04130d; }
  .ai-mode-tab:not(.is-active):hover { color: #ffffff; }

  .ai-top__actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .ai-ollama-btn { padding: 6px 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,.12); background: #090b0f; color: #94a3b8; font: 700 11px/1 ui-monospace, monospace; cursor: pointer; }
  .ai-ollama-btn[aria-pressed="true"] { border-color: #10b981; color: #34d399; background: rgba(16, 185, 129, .1); }
  .ai-status-badge { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 999px; background: rgba(16, 185, 129, .08); border: 1px solid rgba(16, 185, 129, .28); color: #34d399; font: 700 11px/1 ui-monospace, monospace; white-space: nowrap; }
  .ai-status-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }
  .ai-status-badge.is-busy { border-color: rgba(250, 204, 21, .35); color: #facc15; }
  .ai-status-badge.is-busy .ai-status-dot { background: #facc15; animation: ai-dot .9s infinite ease-in-out; }
  .ai-new-btn { height: 32px; padding: 0 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,.14); background: #090b0f; color: #e2e8f0; font: 700 11.5px/1 ui-monospace, monospace; cursor: pointer; }
  .ai-new-btn:hover { border-color: #10b981; color: #10b981; }

  .ai-icon, .ai-action, .ai-codecopy, .ai-jump { min-height: 32px; border-radius: 8px; border: 1px solid rgba(255,255,255,.12); background: #0d1118; color: #e2e8f0; cursor: pointer; font: 600 12px/1 sans-serif; }
  .ai-icon { width: 34px; display: inline-grid; place-items: center; }
  .ai-icon:hover, .ai-action:hover, .ai-codecopy:hover { border-color: #10b981; color: #10b981; }

  .ai-main { position: relative; flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; }
  .ai-stage { flex: 1; min-height: 0; overflow: auto; scroll-behavior: smooth; }
  .ai-stage.is-empty { display: grid; place-items: center; padding: 16px 0; }
  .ai-empty { width: min(760px, calc(100% - 32px)); display: grid; gap: 22px; padding: 12px 0; }
  .ai-hero { text-align: center; display: grid; justify-items: center; gap: 8px; }
  .ai-hero__emblem { width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; background: rgba(16, 185, 129, .1); border: 1px solid rgba(16, 185, 129, .35); }
  .ai-kicker { margin: 0; font: 700 11px/1 ui-monospace, monospace; letter-spacing: .12em; color: #10b981; }
  .ai-hero__title { margin: 0; font-size: clamp(22px, 3vw, 30px); font-weight: 800; color: #ffffff; }
  .ai-empty__lead { margin: 0; max-width: 560px; color: #94a3b8; font-size: 14.5px; line-height: 1.5; }

  .ai-starters { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ai-starters button { text-align: left; padding: 14px 16px; border: 1px solid rgba(255,255,255,.1); border-radius: 14px; background: #0d1118; cursor: pointer; display: grid; gap: 5px; color: #f1f5f9; transition: border-color .15s, transform .15s; }
  .ai-starters button:hover { border-color: #10b981; transform: translateY(-1px); }
  .ai-starter__tag { font: 700 10px/1 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .08em; color: #10b981; }
  .ai-starters strong { font-size: 14px; font-weight: 700; line-height: 1.3; }
  .ai-starters span:last-child { color: #94a3b8; font-size: 12.5px; line-height: 1.4; }

  .ai-log { width: min(780px, calc(100% - 32px)); margin: 0 auto; padding: 24px 0 18px; display: flex; flex-direction: column; gap: 20px; }
  .ai-turn { display: grid; gap: 8px; }
  .ai-turn--user .ai-turn__body { justify-items: end; }
  .ai-turn--bot { grid-template-columns: 34px minmax(0, 1fr); column-gap: 12px; align-items: start; }
  .ai-avatar { width: 34px; height: 34px; border-radius: 9px; object-fit: contain; background: rgba(16, 185, 129, .08); border: 1px solid rgba(16, 185, 129, .3); padding: 4px; }
  .ai-bubble { max-width: min(82%, 560px); padding: 10px 15px; border-radius: 18px 18px 4px 18px; background: rgba(16, 185, 129, .15); border: 1px solid rgba(16, 185, 129, .35); color: #f8fafc; white-space: pre-wrap; font-size: 14.5px; line-height: 1.5; }
  .ai-turn__body { min-width: 0; display: grid; gap: 8px; }
  .ai-actions { display: flex; gap: 6px; opacity: .8; }
  .ai-action { padding: 0 10px; font-size: 11.5px; }

  .ai-md { min-width: 0; font-size: 15px; line-height: 1.65; color: #e2e8f0; }
  .ai-md :is(h1, h2, h3, h4) { font-weight: 700; margin: 14px 0 6px; color: #ffffff; }
  .ai-md h3, .ai-md h4 { color: #34d399; font-size: 1rem; }
  .ai-md p { margin: 8px 0; }
  .ai-md ul, .ai-md ol { margin: 8px 0 8px 1.2em; padding-left: 1em; }
  .ai-md ul { list-style: disc; }
  .ai-md ol { list-style: decimal; }
  .ai-md a { color: #34d399; text-underline-offset: 3px; }
  .ai-md :not(pre) > code { font-family: ui-monospace, monospace; font-size: .86em; background: #0d1118; border: 1px solid rgba(255,255,255,.12); padding: 1px 6px; border-radius: 5px; color: #34d399; }
  .ai-code { position: relative; margin: 12px 0; }
  .ai-code pre, .ai-plain { margin: 0; padding: 14px 12px; overflow: auto; background: #0d1118; border: 1px solid rgba(255,255,255,.12); border-radius: 10px; font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.45; white-space: pre; }
  .ai-codecopy { position: absolute; top: 8px; right: 8px; padding: 0 10px; }
  .ai-table { overflow-x: auto; margin: 12px 0; border: 1px solid rgba(255,255,255,.12); border-radius: 10px; }
  .ai-table table { width: 100%; border-collapse: collapse; }
  .ai-table th, .ai-table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid rgba(255,255,255,.08); font-size: 13.5px; }
  .ai-table th { background: #0d1118; font: 700 11.5px/1.2 ui-monospace, monospace; color: #34d399; }

  .ai-dots { display: inline-flex; gap: 5px; padding: 8px 0; }
  .ai-dots i { width: 7px; height: 7px; border-radius: 50%; background: #10b981; animation: ai-dot .9s infinite ease-in-out; }
  .ai-dots i:nth-child(2) { animation-delay: .15s; }
  .ai-dots i:nth-child(3) { animation-delay: .3s; }
  .ai-jump { position: absolute; left: 50%; bottom: 108px; transform: translateX(-50%); z-index: 5; padding: 0 14px; border-radius: 999px; }

  .ai-composer { width: min(780px, calc(100% - 24px)); margin: 0 auto; padding: 8px 0 max(12px, env(safe-area-inset-bottom)); }
  .ai-composer__box { display: flex; align-items: flex-end; gap: 8px; padding: 8px 10px 8px 14px; border: 1px solid rgba(255,255,255,.12); border-radius: 22px; background: #0d1118; }
  .ai-composer__box:focus-within { border-color: #10b981; }
  .ai-composer textarea { flex: 1; min-height: 38px; max-height: 150px; resize: none; border: 0; background: transparent; color: #f8fafc; font-size: 14.5px; line-height: 1.45; padding: 7px 4px; }
  .ai-composer textarea:focus { outline: none; }
  #aiSend { width: 38px; height: 38px; min-width: 38px; padding: 0; border-radius: 999px; border: 0; background: #10b981; color: #04130d; cursor: pointer; display: inline-grid; place-items: center; }
  #aiSend:disabled { opacity: .35; cursor: default; }
  #aiSend[data-mode="stop"] { background: #0d1118; color: #f8fafc; border: 1px solid rgba(255,255,255,.15); width: auto; padding: 0 12px; font: 700 12px/1 ui-monospace, monospace; }
  .ai-note { margin: 8px 6px 0; text-align: center; color: #64748b; font-size: 11.5px; line-height: 1.4; }
  .ai-note a { color: #34d399; text-decoration: none; }
  .ai-note a:hover { text-decoration: underline; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @keyframes ai-dot { 0%, 80%, 100% { opacity: .25; } 40% { opacity: 1; } }

  @media (min-width: 960px) { .ai-scrim { display: none !important; } }
  @media (max-width: 720px) {
    .ai-starters { grid-template-columns: 1fr; }
    .ai-oss-badge, .ai-ollama-btn { display: none; }
  }
  @media (max-width: 959px) { .ai-side { position: fixed; z-index: 35; top: var(--site-header, 56px); bottom: 0; left: 0; } }
</style>

<script is:inline src="/assets/js/ai-chat.js?v=t400" defer></script>
