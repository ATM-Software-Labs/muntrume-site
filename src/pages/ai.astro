---
import Layout from '../layouts/Layout.astro';
import { MUNTRUME_KB } from '../data/muntrume-kb';

const pageTitle = "Muntrume AI · Studio Open Source | Muntrume Motorsport";
const pageDescription = "Muntrume AI Studio (100 % Open Source · MIT): asistente técnico con proyectos, artefactos interactivos, exportación DOC/PDF/Presentaciones, visión por imagen, búsqueda web en vivo, GitHub y motores Muntrume 1.0 Lite, Pro, Ultra Max y Local.";
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/ai/" hideFooter>
  <div class="ai-shell" id="aiWorkspace">
    <!-- LEFT SIDEBAR (100 % REAL OPEN-SOURCE TOOLS, ZERO EMOJIS) -->
    <aside id="aiSide" class="ai-side" aria-label="Navegación de Muntrume AI">
      <div class="ai-side__head">
        <a href="/ai/" class="ai-brand">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="ai-brand__ico" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <span>Muntrume AI</span>
        </a>
        <button type="button" id="aiSideClose" class="ai-ico-btn" aria-label="Ocultar barra lateral" title="Ocultar barra lateral">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
        </button>
      </div>

      <nav class="ai-side__nav" aria-label="Herramientas">
        <button type="button" id="aiNewChatBtn" class="ai-side-btn ai-side-btn--primary">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span>Nuevo chat</span>
          <kbd class="ai-kbd-pill">Ctrl K</kbd>
        </button>
        <button type="button" id="aiSearchBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <span>Buscar</span>
        </button>
        <div id="aiSearchWrap" class="ai-search-wrap" hidden>
          <input type="search" id="aiSearchInput" placeholder="Filtrar conversaciones…" aria-label="Buscar conversaciones" />
        </div>
        <button type="button" id="aiProjectsBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          <span>Proyectos</span>
        </button>
        <button type="button" id="aiArtifactsBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <span>Artefactos</span>
        </button>
        <button type="button" id="aiCodeModeBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          <span>Code</span>
          <span class="ai-side-pill">Live</span>
        </button>
        <button type="button" id="aiCalcBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="8.01" y2="10"/><line x1="12" y1="10" x2="12.01" y2="10"/><line x1="16" y1="10" x2="16.01" y2="10"/><line x1="8" y1="14" x2="8.01" y2="14"/><line x1="12" y1="14" x2="12.01" y2="14"/><line x1="16" y1="14" x2="16.01" y2="14"/><line x1="8" y1="18" x2="16" y2="18"/></svg>
          <span>Calculadoras</span>
        </button>
        <button type="button" id="aiPersonalizeBtn" class="ai-side-btn">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.26.6.85 1 1.51 1H21a2 2 0 1 1 0 4h-.09c-.66 0-1.25.4-1.51 1z"/></svg>
          <span>Personalización</span>
        </button>
      </nav>

      <div class="ai-side__label">Chats</div>
      <div id="aiChatList" class="ai-chat-list"></div>

      <div class="ai-side__foot">
        <a href={MUNTRUME_KB.team.githubUrl} target="_blank" rel="noopener noreferrer" class="ai-mit-link">
          <span class="ai-dot"></span>
          <span>100 % Open Source · MIT</span>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:auto"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>
    </aside>

    <!-- MAIN CHAT STAGE -->
    <main class="ai-stage" id="aiStage">
      <div class="ai-topbar">
        <button type="button" id="aiSideToggle" class="ai-ico-btn" aria-label="Mostrar u ocultar barra lateral" title="Menú lateral">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
        </button>
        <span class="ai-top-pill">Open Source · MIT</span>
      </div>

      <!-- Local Ollama Bar (shown only when Muntrume Local is selected) -->
      <div id="aiLocalBar" class="ai-local-bar" hidden>
        <span>Muntrume Local (100 % privado)</span>
        <input type="url" id="aiOllamaUrl" value="http://localhost:11434/api/chat" aria-label="Endpoint Ollama" />
        <input type="text" id="aiOllamaModel" value="llama3.1:8b" aria-label="Modelo Ollama" style="max-width:150px" />
      </div>

      <!-- Messages Feed -->
      <div id="aiFeed" class="ai-feed" hidden></div>

      <!-- Centered Welcome + Pro Composer -->
      <div class="ai-composer-wrap">
        <div id="aiEmptyState" class="ai-empty">
          <div class="ai-empty__title">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" class="ai-emblem" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <h1 id="aiGreeting">¿En qué trabajamos hoy?</h1>
          </div>
        </div>

        <form id="aiComposerForm" class="ai-composer" autocomplete="off">
          <div id="aiContextPills" class="ai-ctx-bar" hidden></div>

          <textarea
            id="aiInput"
            rows="2"
            placeholder="Escribe una consulta, pega una captura (Ctrl+V) o adjunta un archivo…"
            aria-label="Mensaje para Muntrume AI"
          ></textarea>

          <input type="file" id="aiFileInput" class="hidden" accept="image/png,image/jpeg,image/webp,.txt,.md,.csv,.json,.js,.ts,.py,.html,.css,.sto,.xml,.yml,.yaml" />

          <div class="ai-composer__bar">
            <div class="ai-composer__left">
              <!-- Clean Monochrome "+" Tools Menu -->
              <div class="ai-pop-anchor">
                <button type="button" id="aiPlusBtn" class="ai-plus-btn" aria-label="Herramientas y adjuntos" title="Adjuntar y herramientas">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                </button>
                <div id="aiPlusMenu" class="ai-popover" hidden>
                  <button type="button" id="aiActUpload" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                    <span class="ai-pop-txt">Subir archivo o imagen</span>
                    <kbd class="ai-pop-kbd">Ctrl+U</kbd>
                  </button>
                  <button type="button" id="aiActGithub" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                    <span class="ai-pop-txt">Importar desde GitHub</span>
                  </button>
                  <button type="button" id="aiActProject" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                    <span class="ai-pop-txt">Cambiar proyecto</span>
                  </button>
                  <div class="ai-pop-sep"></div>
                  <div class="ai-pop-label">Skills Open Source</div>
                  <button type="button" class="ai-pop-item" data-select-skill="setup">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    <span class="ai-pop-txt">Ingeniero de Setups iRacing</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="strategy">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                    <span class="ai-pop-txt">Estrategia y combustible</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="code">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                    <span class="ai-pop-txt">Código y artefacto HTML</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="slides">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    <span class="ai-pop-txt">Presentación Slides</span>
                  </button>
                  <button type="button" class="ai-pop-item" data-select-skill="doc">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    <span class="ai-pop-txt">Documento Word / PDF</span>
                  </button>
                  <div class="ai-pop-sep"></div>
                  <button type="button" id="aiActWebToggle" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    <span class="ai-pop-txt">Búsqueda web en vivo</span>
                    <span id="aiMenuWebCheck" class="ai-check-mark is-on">✓</span>
                  </button>
                  <button type="button" id="aiActMemToggle" class="ai-pop-item">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
                    <span class="ai-pop-txt">Memoria persistente</span>
                    <span id="aiMenuMemCheck" class="ai-check-mark is-on">✓</span>
                  </button>
                </div>
              </div>
            </div>

            <div class="ai-composer__right">
              <!-- Racing-Branded Open Source Model Selector -->
              <div class="ai-pop-anchor">
                <button type="button" id="aiModelBtn" class="ai-model-btn" title="Cambiar motor Muntrume">
                  <span id="aiModelBtnLabel">Muntrume 1.0 Pro</span>
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div id="aiModelMenu" class="ai-popover ai-popover--right" hidden>
                  <button type="button" class="ai-model-opt" data-select-tier="lite">
                    <strong>Muntrume 1.0 Lite</strong>
                    <span>Instantáneo · Respuestas rápidas y cálculos</span>
                  </button>
                  <button type="button" class="ai-model-opt is-active" data-select-tier="pro">
                    <strong>Muntrume 1.0 Pro</strong>
                    <span>Equilibrado · Setups iRacing, código y documentos</span>
                  </button>
                  <button type="button" class="ai-model-opt" data-select-tier="ultra_max">
                    <strong>Muntrume 1.0 Ultra Max</strong>
                    <span>Razonamiento profundo paso a paso</span>
                  </button>
                  <button type="button" class="ai-model-opt" data-select-tier="local">
                    <strong>Muntrume Local</strong>
                    <span>100 % Privado en tu PC (Ollama localhost:11434)</span>
                  </button>
                </div>
              </div>

              <button type="button" id="aiEffortBtn" class="ai-effort-btn" title="Nivel de detalle">Medio</button>
              <button type="submit" id="aiSendBtn" class="ai-send-btn" data-state="send" aria-label="Enviar">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
              </button>
            </div>
          </div>
        </form>

        <!-- Clean Monochrome Starter Chips (0 emojis) -->
        <div class="ai-starters">
          <button type="button" data-starter-skill="setup" data-starter-prompt="Tengo subviraje en entrada de curva lenta y sobreviraje saliendo en Ferrari 296 GT3 en Spa. Dame diagnóstico y clics exactos.">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            <span>Ingeniería iRacing</span>
          </button>
          <button type="button" data-starter-skill="strategy" data-starter-prompt="Calcula estrategia completa de combustible y paradas para una carrera de resistencia de 6 horas en GT3 (tanque 100 L, consumo 2.95 L/vuelta, vuelta de 2:17).">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <span>Estrategia y combustible</span>
          </button>
          <button type="button" data-starter-skill="code" data-starter-prompt="Crea un artefacto HTML interactivo de calculadora de combustible y stints para iRacing con modo oscuro limpio.">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span>Código y artefacto</span>
          </button>
          <button type="button" data-starter-skill="slides" data-starter-prompt="Prepara una presentación ejecutiva de 5 diapositivas sobre Muntrume Motorsport, su ecosistema MMT Sync y la temporada IMSA 2026 S4.">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>Presentación</span>
          </button>
        </div>
      </div>
    </main>

    <!-- SPLIT-SCREEN ARTIFACTS & EXPORT STUDIO -->
    <aside id="aiArtifactPane" class="ai-art-pane" hidden aria-label="Estudio de Artefactos">
      <div class="ai-art-head">
        <div style="min-width:0;display:flex;align-items:center;gap:6px">
          <span id="aiArtBadge" class="ai-art-badge">HTML</span>
          <strong id="aiArtTitle" class="ai-art-title">Artefacto</strong>
        </div>
        <div class="ai-art-tabs">
          <button type="button" id="aiArtTabPreview" class="is-active">Vista previa</button>
          <button type="button" id="aiArtTabCode">Código</button>
        </div>
        <button type="button" id="aiArtClose" class="ai-ico-btn" aria-label="Cerrar panel">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="ai-art-export-bar">
        <button type="button" id="aiArtExportDoc" class="ai-mini-btn">Exportar DOC</button>
        <button type="button" id="aiArtExportPdf" class="ai-mini-btn">Exportar PDF</button>
        <button type="button" id="aiArtExportSlides" class="ai-mini-btn">Presentación</button>
        <button type="button" id="aiArtExportMd" class="ai-mini-btn">Markdown</button>
        <button type="button" id="aiArtDownload" class="ai-mini-btn">Descargar</button>
        <button type="button" id="aiArtCopy" class="ai-mini-btn">Copiar</button>
      </div>
      <iframe id="aiArtFrame" class="ai-art-frame" sandbox="allow-scripts" title="Vista previa del artefacto"></iframe>
      <div id="aiArtCodeWrap" class="ai-art-code-wrap" hidden>
        <pre><code id="aiArtCode"></code></pre>
      </div>
    </aside>
  </div>

  <!-- MODAL: CALCULADORAS DE INGENIERÍA IRACING -->
  <div id="aiCalcModal" class="ai-modal" hidden role="dialog" aria-modal="true">
    <div class="ai-modal__card" style="width:min(620px,100%)">
      <div class="ai-modal__head">
        <h2>Calculadoras de Ingeniería iRacing</h2>
        <button type="button" class="ai-ico-btn" data-close-ai-modal aria-label="Cerrar">×</button>
      </div>
      <div class="ai-art-tabs" style="width:fit-content">
        <button type="button" id="calcTabFuel" class="is-active">Combustible y Stints</button>
        <button type="button" id="calcTabBalance">Diagnóstico Setup</button>
      </div>

      <div id="calcPanelFuel" class="ai-modal-form">
        <div class="ai-calc-grid">
          <div>
            <label for="calcRaceMins">Duración carrera (min)</label>
            <input type="number" id="calcRaceMins" value="45" min="5" max="1440" />
          </div>
          <div>
            <label for="calcLapTime">Tiempo de vuelta (m:ss)</label>
            <input type="text" id="calcLapTime" value="2:17.5" placeholder="2:17.5" />
          </div>
          <div>
            <label for="calcFuelLap">Consumo (L / vuelta)</label>
            <input type="number" id="calcFuelLap" value="2.95" step="0.05" min="0.2" max="20" />
          </div>
          <div>
            <label for="calcTankSize">Depósito máximo (L)</label>
            <input type="number" id="calcTankSize" value="100" step="1" min="10" max="200" />
          </div>
        </div>
        <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;font-size:12.5px;color:var(--ai-muted)">
          <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer"><input type="checkbox" id="calcFormLap" checked style="width:auto" /> +1 vuelta formación</label>
          <label style="display:inline-flex;align-items:center;gap:6px">Margen extra (vueltas): <input type="number" id="calcMarginLaps" value="1" min="0" max="5" step="0.5" style="width:64px;padding:4px 7px" /></label>
        </div>
        <div id="calcFuelResult" class="ai-calc-out"></div>
        <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:4px">
          <button type="button" class="ai-mini-btn" data-close-ai-modal>Cerrar</button>
          <button type="button" id="calcSendFuelToAi" class="ai-btn-accent">Analizar estrategia con Muntrume AI</button>
        </div>
      </div>

      <div id="calcPanelBalance" class="ai-modal-form" hidden>
        <div class="ai-calc-grid">
          <div>
            <label for="calcCarCat">Categoría / Coche</label>
            <select id="calcCarCat" class="ai-select">
              <option value="GT3">GT3 (Ferrari 296, Porsche 992, BMW M4…)</option>
              <option value="GTP">GTP / Hypercar (499P, 963, Valkyrie…)</option>
