                  title="Conectar tu Token personal de Garage 61 para consultas en vivo"
                >
                  <span>🔑 Mi token G61</span>
                </button>
                <a
                  id="g61ExternalSearchLink"
                  href="https://garage61.net/app/laps"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3.5 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-[11px] font-bold text-emerald-400 transition flex items-center gap-1.5"
                >
                  <span>Abrir en Garage 61</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
              </div>
            </div>

            <!-- Laps Table -->
            <div class="bg-[#0e1217] border border-white/10 rounded-2xl overflow-hidden">
