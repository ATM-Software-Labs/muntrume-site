            >
              <span>🔧 Archivo .sto</span>
            </button>
            <button
              type="button"
              id="previewTabG61Btn"
              onclick="switchPreviewTab('g61')"
              class="flex-1 py-2.5 px-3 rounded-lg text-neutral-400 hover:text-white flex items-center justify-center gap-2 transition"
            >
              <span>🏆 Garage 61</span>
              <span id="previewG61CountBadge" class="text-[10px] px-1.5 py-0.5 rounded-full bg-white/10 text-neutral-300">—</span>
            </button>
          </div>

          <!-- TAB 1: TECHNICAL SETUP PREVIEW -->
          <div id="previewTabSpecs" class="space-y-4 max-h-[65vh] overflow-y-auto pr-1">
            <!-- Datos reales del archivo -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5" id="previewSpecsGrid">
              <!-- Populated dynamically via setups.js -->
            </div>

            <!-- Notas internas del .sto -->
            <div class="bg-[#0e1217] border border-emerald-500/20 rounded-2xl p-4">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-400">
                    Notas del setup
                  </span>
                </div>
                <span id="previewBinarySizeInfo" class="text-[10px] font-mono text-neutral-500"></span>
              </div>
              <div id="previewStoNotesText" class="p-3 rounded-xl bg-[#161c24] border border-white/5 font-mono text-xs text-white select-all whitespace-pre-wrap break-words"></div>
            </div>
          </div>

          <!-- TAB 2: GARAGE 61 BEST LAPS LEADERBOARD -->
          <div id="previewTabG61" class="hidden space-y-4 max-h-[65vh] overflow-y-auto pr-1">
            <!-- Garage 61 Header & Search Bar -->
            <div class="bg-[#0e1217] border border-white/10 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-extrabold text-white">Mejores vueltas en Garage 61</span>
                  <span id="g61LiveStatusBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/5 text-neutral-400 border border-white/10">—</span>
                </div>
                <p class="text-[11px] text-neutral-400 mt-0.5">
