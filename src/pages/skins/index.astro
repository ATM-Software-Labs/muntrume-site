---
import Layout from "../../layouts/Layout.astro";
import "../../styles/skins-studio.css";

const title = "Skins Studio · Muntrume Motorsport (skins.muntru.me)";
const description =
  "Estudio web local-first de skins y liveries para iRacing de Muntrume Motorsport: detección asistida de zonas sobre plantillas oficiales, compositor 2K/4K, visor WebGL 3D, copiloto Gemini y exportación directa TGA/Spec Map + ZIP para Trading Paints.";
const canonical = "https://skins.muntru.me/";
---

<Layout title={title} description={description} canonical={canonical}>
  <main id="mmtSkinsStudio" class="sk-root">
    <!-- Private Auth Gate Landing Page (shown when unauthenticated; unlocks Studio only with valid muntru.me session) -->
    <section id="skAuthGate" class="sk-landing">
      <div class="sk-landing-wrap">
        <div class="sk-landing-hero">
          <div class="sk-landing-copy">
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
              <span class="sk-brand-badge">MUNTRUME MOTORSPORT (MMT) · SKINS STUDIO</span>
              <span class="sk-tag" style="border-color:rgba(0,230,153,0.42);color:#6ee7b7;background:rgba(0,230,153,0.10);">39 COCHES 3D PBR · 2K/4K</span>
              <span class="sk-tag" style="border-color:rgba(245,158,11,0.4);color:#fcd34d;background:rgba(245,158,11,0.10);">ACCESO PRIVADO · EQUIPO MMT</span>
            </div>
            <h1 class="sk-landing-title">
              Estudio 2D/3D de <span>liveries y skins</span> para iRacing
            </h1>
            <p class="sk-landing-lead">
              Diseña desde cero o sube una skin <code>.TGA/.PNG/.PSD</code> ya hecha para editar logos, aplicar kits por campeonato (IMSA, GT3, Porsche Cup, Fórmula, TCR), previsualizar acabados PBR en Three.js y exportar en local listas para Trading Paints.
            </p>

            <!-- Inline Synchronized Login Form (syncs localStorage + .muntru.me SSO cookie automatically) -->
            <form id="skInlineLoginForm" class="sk-card" style="margin:6px 0 4px;padding:14px 16px;border-color:rgba(0,230,153,0.28);background:rgba(13,20,31,0.88);max-width:520px;">
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;">
                <strong style="font-size:12.5px;letter-spacing:0.04em;text-transform:uppercase;color:#e2e8f0;">Acceso de piloto muntru.me</strong>
                <span style="font-size:11px;color:var(--sk-accent);">Sesión sincronizada SSO ✓</span>
              </div>
              <div id="skAuthError" class="sk-landing-status" style="margin-bottom:10px;">Inicia sesión con tu cuenta de muntru.me para desbloquear el estudio.</div>
              <div class="sk-row" style="gap:8px;flex-wrap:wrap;">
                <input id="skLoginEmail" type="email" class="sk-input" placeholder="Email de piloto (ej. piloto@muntru.me)" autocomplete="username" required style="flex:1;min-width:190px;" />
                <input id="skLoginPass" type="password" class="sk-input" placeholder="Contraseña" autocomplete="current-password" required style="flex:1;min-width:160px;" />
              </div>
              <div class="sk-row" style="gap:8px;margin-top:10px;flex-wrap:wrap;">
                <button type="submit" id="skInlineLoginBtn" class="sk-btn sk-btn-primary sk-btn-lg" style="flex:1;min-width:180px;">
                  Entrar al Estudio →
                </button>
                <a
                  href="https://muntru.me/login/?redirect=https://skins.muntru.me/"
                  class="sk-btn sk-btn-lg"
                  style="text-decoration:none;"
                >
                  Login en muntru.me
                </a>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:8px;font-size:11px;color:var(--sk-muted);">
                <span>Procesado 100 % local · Sin almacenamiento de skins</span>
                <a href="mailto:admin@muntru.me?subject=Solicitud%20de%20acceso%20a%20skins.muntru.me" style="color:var(--sk-accent);text-decoration:underline;">Solicitar acceso</a>
              </div>
            </form>

            <details class="sk-token-details" style="max-width:520px;">
              <summary>Acceso alternativo con token de sesión (<code>mrt_vault_token</code>)</summary>
              <div class="sk-row" style="margin-top:10px;">
                <input id="skAuthTokenInput" type="password" class="sk-input" placeholder="Pega aquí tu token JWT del Vault..." autocomplete="off" />
                <button type="button" id="skAuthVerifyBtn" class="sk-btn sk-btn-sm">Validar</button>
              </div>
            </details>
          </div>

          <!-- Clean Conceptual 3-Step Visual Preview Mockup (zero private data exposed) -->
          <div class="sk-landing-visual" aria-hidden="true">
            <div class="sk-visual-chrome">
              <span class="sk-dot"></span><span class="sk-dot"></span><span class="sk-dot"></span>
              <span class="sk-visual-url">skins.muntru.me · 39 Coches 3D PBR → Editor UV 2K/4K → Trading Paints</span>
            </div>
            <div class="sk-visual-grid">
              <div class="sk-visual-uv">
                <div class="sk-uv-zone sk-uv-hood"><span>CAPÓ · #16 / #1 / #22</span></div>
                <div class="sk-uv-zone sk-uv-roof"><span>TECHO · DORSAL</span></div>
                <div class="sk-uv-zone sk-uv-left"><span>LATERAL IZQ.</span></div>
                <div class="sk-uv-zone sk-uv-right"><span>LATERAL DER.</span></div>
                <div class="sk-uv-zone sk-uv-wing"><span>ALERÓN · MMT</span></div>
              </div>
              <div class="sk-visual-specs">
                <div class="sk-spec-chip"><strong>39 Coches 3D</strong><span>GT3 · GTP · LMP · F3/F4 · TCR</span></div>
                <div class="sk-spec-chip"><strong>21 Patrones PBR</strong><span>Mate · Metálico · Carbono</span></div>
                <div class="sk-spec-chip"><strong>Editor .TGA/.PSD</strong><span>Tapa y reemplaza logos</span></div>
                <div class="sk-spec-chip"><strong>Kits por Serie</strong><span>IMSA · PCup · F3/F4 · TCR</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3-Step Studio Workflow Bento Grid -->
        <div class="sk-bento">
          <article class="sk-bento-card">
            <span class="sk-bento-kicker">PASO 01 · COMPOSICIÓN UV 2K/4K Y EDITOR DE SKINS</span>
            <h3>Crea desde cero o edita cualquier .TGA / .PNG / .PSD</h3>
            <p>Arrastra logos sobre coordenadas UV calibradas, cubre marcas previas con parche inteligente, ajusta color/saturación y aplica kits propios de cada campeonato.</p>
          </article>
          <article class="sk-bento-card">
            <span class="sk-bento-kicker">PASO 02 · VISOR 3D WEBGL PBR &amp; SPEC MAP</span>
            <h3>39 modelos 3D dedicados con acabados reales</h3>
            <p>Previsualiza pintura sólida, metalizada, mate, satinada o fibra de carbono en Three.js con cristales oscuros, iluminación de estudio y mapa especular RGB en vivo.</p>
          </article>
          <article class="sk-bento-card">
            <span class="sk-bento-kicker">PASO 03 · EXPORTACIÓN .TGA + PUENTE LIVE iRACING</span>
            <h3>Listo para Documents\iRacing\paint\ y Trading Paints</h3>
            <p>Generación binaria 100 % local de <code>car_&lt;id&gt;.tga</code>, <code>car_spec_&lt;id&gt;.tga</code> y paquete <code>.zip</code>, o envío directo a tu carpeta de iRacing para ver con <code>Ctrl+R</code>.</p>
          </article>
        </div>

        <p style="margin:18px 0 0;font-size:11px;color:var(--sk-muted);text-align:center;">
          Uso interno exclusivo de Muntrume Motorsport (MMT) · Sin afiliación con iRacing.com Motorsport Simulations, LLC, Trading Paints, IMSA ni fabricantes ·
          <a href="https://muntru.me/aviso-legal" style="color:var(--sk-accent);text-decoration:underline;">Aviso legal</a> ·
          <a href="https://muntru.me/legal/retirada" style="color:var(--sk-accent);text-decoration:underline;">DMCA</a>
        </p>
      </div>
    </section>

    <div id="skStudioShell" class="sk-hidden" style="display:flex;flex-direction:column;flex:1;min-height:0;">
    <!-- Compact Fixed 48px Studio Header -->
    <header class="sk-topbar">
      <div class="sk-brand">
        <span class="sk-brand-badge">
          <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L4 5v6c0 5.25 3.4 9.74 8 11 4.6-1.26 8-5.75 8-11V5l-8-3z"/></svg>
          MMT Skins Studio
        </span>
        <span id="skStatusPill" class="sk-status-pill is-ok">Listo · 100 % local</span>
      </div>

      <!-- Quick Official Pilot Selector in Header -->
      <div id="skQuickDriverBar" class="sk-row" style="gap:4px;flex-shrink:0;" aria-label="Piloto oficial rápido"></div>

      <!-- Quick View & Export Controls -->
      <div class="sk-top-actions">
        <div class="sk-seg" role="tablist" aria-label="Vista principal">
          <button type="button" data-view-mode="3d">3D</button>
          <button type="button" data-view-mode="uv" class="is-active">UV 2D</button>
          <button type="button" data-view-mode="showroom">GT</button>
          <button type="button" data-view-mode="spec">Spec</button>
        </div>
        <button type="button" id="skTopResetCamBtn" class="sk-btn sk-btn-sm" title="Centrar vista / cámara">
          <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          Reset
        </button>
        <div class="sk-seg" role="group" aria-label="Resolución">
          <button type="button" data-res-mode="2048" class="is-active">2K</button>
          <button type="button" data-res-mode="4096">4K</button>
        </div>
        <button type="button" id="skUndoBtn" class="sk-btn sk-btn-sm" title="Deshacer (Ctrl+Z)" aria-label="Deshacer">
          <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14L4 9l5-5"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
        </button>
        <button type="button" id="skRedoBtn" class="sk-btn sk-btn-sm" title="Rehacer (Ctrl+Y)" aria-label="Rehacer">
          <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14l5-5-5-5"/><path d="M4 20v-7a4 4 0 0 1 4-4h12"/></svg>
        </button>
        <button type="button" id="skHeaderExportTgaBtn" class="sk-btn sk-btn-primary sk-btn-sm" title="Exportar .TGA a resolución completa para iRacing">
          <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Exportar .TGA
        </button>
        <button type="button" id="skCleanCanvasBtn" class="sk-btn sk-btn-sm" title="Limpiar lienzo">Limpiar</button>
        <button type="button" id="skSaveLocalBtn" class="sk-btn sk-btn-sm sk-hidden">Guardar</button>
        <span id="skSessionUserPill" class="sk-tag" style="border-color:rgba(0,230,153,0.35);color:#a7f3d0;background:rgba(0,230,153,0.08);font-size:10px;" title="Sesión sincronizada con muntru.me">MMT ✓</span>
        <button type="button" id="skLogoutBtn" class="sk-btn sk-btn-sm" title="Cerrar sesión">Salir</button>
      </div>
    </header>

    <!-- 3-Column Symmetrical Fullscreen Workstation (270px | flex:1 | 294px) -->
    <div id="skWorkspace" class="sk-workspace">
      <!-- LEFT COLUMN (270px): Strictly 2 Compact Balanced Blocks -->
      <aside class="sk-sidebar">
        <!-- BLOCK 1: COCHE & DORSAL -->
        <section class="sk-card">
          <h2 class="sk-card-title">
            <span class="sk-row" style="gap:5px;">
              <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9L18 10l-2-4H8L6 10l-2.5 1.1C2.7 11.3 2 12.1 2 13v3c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
              Coche &amp; Dorsal
            </span>
          </h2>
          <input id="skCarSearch" type="search" class="sk-input" placeholder="Buscar GT3, GTP, F4, NASCAR..." autocomplete="off" />
          <select id="skCarSelect" class="sk-select" aria-label="Coche iRacing"></select>
          <p id="skCarNotes" class="sk-help" style="margin:0;font-size:10.5px;"></p>

          <div class="sk-grid-2">
            <label class="sk-label">
              Dorsal
              <input id="skDriverNumber" type="text" class="sk-input" maxlength="4" value="16" />
            </label>
            <label class="sk-label">
              iRacing ID
              <input id="skCustomerId" type="text" class="sk-input" placeholder="994512" value="994512" />
            </label>
          </div>

          <div class="sk-grid-2">
            <label class="sk-label">
              Piloto MMT
              <select id="skDriverSelect" class="sk-select"></select>
            </label>
            <label class="sk-label">
              Nombre techo
              <input id="skDriverName" type="text" class="sk-input" maxlength="28" value="Alberto Trujillo" />
            </label>
          </div>

          <label class="sk-label">
            Nombre del diseño
            <input id="skDesignName" type="text" class="sk-input" />
          </label>
        </section>

        <!-- BLOCK 2: BASE & PLANTILLA (Exclusive 2-subtab switch: zero vertical overflow) -->
        <section class="sk-card" style="flex:1;min-height:0;">
          <h2 class="sk-card-title">
            <span class="sk-row" style="gap:5px;">
              <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              Base &amp; Plantilla
            </span>
            <button type="button" id="skResetZones" class="sk-btn sk-btn-sm" style="padding:2px 6px;font-size:10px;">Reset UV</button>
          </h2>

          <div class="sk-left-tabs" role="tablist" aria-label="Base o plantilla">
            <button type="button" data-left-tab="template" class="is-active">Plantilla UV</button>
            <button type="button" data-left-tab="import">Editar .TGA</button>
          </div>

          <!-- Sub-panel A: Official UV Template & Guides -->
          <div id="skLeftPanel-template" style="display:flex;flex-direction:column;gap:7px;">
            <label class="sk-btn sk-btn-sm sk-btn-primary" style="cursor:pointer;width:100%;">
              <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Cargar .PSD / .PNG / .TGA
              <input id="skTemplateInput" type="file" accept=".psd,.png,.tga,.webp,.jpg,.jpeg" class="sk-hidden" />
            </label>
            <p id="skTemplateSummary" class="sk-help" style="margin:0;font-size:10.5px;">
              Suelta tu <code>.PSD</code> oficial de iRacing en local para separar wireframe y patrones 1:1.
            </p>
            <div class="sk-grid-2">
              <label class="sk-row" style="font-size:11px;cursor:pointer;"><input id="skToggleWireframe" type="checkbox" checked /> Guía UV</label>
              <label class="sk-row" style="font-size:11px;cursor:pointer;"><input id="skToggleZones" type="checkbox" checked /> Zonas</label>
            </div>
            <label class="sk-label" style="font-size:10.5px;">
              Opacidad guía UV
              <input id="skWireOpacity" type="range" min="10" max="100" value="85" />
            </label>
            <div class="sk-grid-2">
              <button type="button" id="skEditZonesBtn" class="sk-btn sk-btn-sm">Ajustar cajas</button>
              <button type="button" id="skSaveCalibLocalBtn" class="sk-btn sk-btn-sm">Guardar UV</button>
            </div>
            <button type="button" id="skExportCalibratedUvBtn" class="sk-btn sk-btn-sm" style="width:100%;">Exportar JSON UV</button>
            <div id="skZoneList" class="sk-hidden"></div>
          </div>

          <!-- Sub-panel B: Edit Existing .TGA/.PNG/.PSD Skin -->
          <div id="skLeftPanel-import" class="sk-hidden" style="display:flex;flex-direction:column;gap:7px;">
            <div class="sk-row" style="justify-content:space-between;">
              <label class="sk-btn sk-btn-sm sk-btn-primary" style="flex:1;cursor:pointer;">
                Subir Skin (.TGA/.PNG/.PSD)
                <input id="skImportSkinInput" type="file" accept=".tga,.png,.jpg,.jpeg,.webp,.psd" class="sk-hidden" />
              </label>
              <button type="button" id="skImpClearBtn" class="sk-btn sk-btn-sm sk-btn-danger sk-hidden">Quitar</button>
            </div>
            <p id="skImportedSkinStatus" class="sk-help" style="margin:0;font-size:10.5px;">
              Sube cualquier skin de Trading Paints para tapar logos viejos y poner tu identidad MMT.
            </p>
            <div id="skImportedSkinTools" class="sk-hidden" style="display:flex;flex-direction:column;gap:6px;">
              <div class="sk-grid-2">
                <button type="button" id="skPatchModeBtn" class="sk-btn sk-btn-primary sk-btn-sm">Tapar logo</button>
                <button type="button" id="skImportReplaceTextBtn" class="sk-btn sk-btn-sm">+ Texto / Web</button>
              </div>
              <div class="sk-grid-2" style="gap:5px;">
                <label class="sk-label" style="font-size:10px;">Tono (<span id="skImpHueVal">0°</span>)<input id="skImpHue" type="range" min="-180" max="180" value="0" /></label>
                <label class="sk-label" style="font-size:10px;">Sat (<span id="skImpSatVal">100%</span>)<input id="skImpSat" type="range" min="0" max="200" value="100" /></label>
                <label class="sk-label" style="font-size:10px;">Brillo (<span id="skImpBrightVal">100%</span>)<input id="skImpBright" type="range" min="50" max="150" value="100" /></label>
                <button type="button" id="skImpResetFilterBtn" class="sk-btn sk-btn-sm" style="align-self:end;">Reset color</button>
              </div>
              <button type="button" id="skImportAddBrandBtn" class="sk-hidden"></button>
              <button type="button" id="skImportAddImsaBtn" class="sk-hidden"></button>
              <button type="button" id="skImportAddSeriesBtn" class="sk-hidden"></button>
            </div>
          </div>

          <div id="skPresetList" class="sk-hidden"></div>
          <div id="skSavedLibrary" class="sk-hidden"></div>
          <button type="button" id="skExportJsonBtn" class="sk-hidden"></button>
          <input id="skImportJsonInput" type="file" accept=".json" class="sk-hidden" />
        </section>
      </aside>

      <!-- CENTER VIEWPORT (flex: 1): Clean, Unobstructed 3D / UV 2D Stage -->
      <section class="sk-stage-col">
        <div class="sk-stage-bar" style="padding:5px 10px;">
          <div id="skShowroomControls" class="sk-row sk-hidden">
            <div class="sk-seg" role="group" aria-label="Ángulo GT">
              <button type="button" data-showroom-angle="side" class="is-active">Lateral</button>
              <button type="button" data-showroom-angle="top">Superior</button>
              <button type="button" data-showroom-angle="front">Frontal</button>
              <button type="button" data-showroom-angle="rear">Trasera</button>
            </div>
          </div>

          <div id="skUvControls" class="sk-row">
            <button type="button" id="skZoomOut" class="sk-btn sk-btn-sm" aria-label="Alejar">−</button>
            <span id="skZoomLabel" style="font-size:11px;font-family:monospace;min-width:38px;text-align:center;">100%</span>
            <button type="button" id="skZoomIn" class="sk-btn sk-btn-sm" aria-label="Acercar">+</button>
            <button type="button" id="skZoomReset" class="sk-btn sk-btn-sm">Centrar</button>
          </div>

          <div class="sk-row" style="gap:5px;margin-left:auto;">
            <button type="button" id="skApplyTeamKitBtn" class="sk-btn sk-btn-sm" title="Añade el kit de logos MMT y muntru.me sobre el coche">
              <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              Kit MMT
            </button>
            <button type="button" id="skExpandStageBtn" class="sk-btn sk-btn-sm" title="Ampliar visor (Esc para salir)">
              <svg class="sk-svg-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              Ampliar
            </button>
          </div>
        </div>

        <div id="skCanvasWrap" class="sk-canvas-wrap" style="min-height:0;">
          <canvas id="skShowroomCanvas" class="sk-hidden" width="1024" height="640" style="width:100%;max-width:960px;height:auto;border-radius:10px;border:1px solid rgba(255,255,255,0.08);box-shadow:0 20px 54px rgba(0,0,0,0.65);"></canvas>
          <canvas id="skUvCanvas" class="sk-uv-canvas" width="1024" height="1024"></canvas>
          <canvas id="skGlCanvas" class="sk-gl-canvas sk-hidden"></canvas>

          <div id="skGlOverlay" class="sk-gl-overlay sk-hidden">
            <div id="skGlSpeedformCta" class="sk-hidden" style="display:flex;align-items:center;gap:10px;padding:6px 10px;margin-bottom:4px;border-radius:8px;background:rgba(9,13,20,0.88);border:1px solid rgba(0,230,153,0.42);">
              <span style="font-size:11px;color:#cbd5e1;">Carga un modelo 3D (.GLB / .GLTF):</span>
              <label for="skObjInput" class="sk-btn sk-btn-primary sk-btn-sm" style="cursor:pointer;">Cargar .GLB</label>
            </div>
            <div id="skGlNotice" class="sk-gl-notice">
              Showroom 3D Three.js PBR · Arrastra para orbitar · Rueda para zoom
            </div>
            <div class="sk-row" style="flex-wrap:wrap;gap:4px;">
              <button type="button" class="sk-btn sk-btn-sm" data-gl-cam="front34">Frontal</button>
              <button type="button" class="sk-btn sk-btn-sm" data-gl-cam="side">Lateral</button>
              <button type="button" class="sk-btn sk-btn-sm" data-gl-cam="rear34">Trasera</button>
              <button type="button" class="sk-btn sk-btn-sm" data-gl-cam="top">Cenital</button>
              <button type="button" id="skGlAutoRotateBtn" class="sk-btn sk-btn-sm" title="Girar automáticamente">Girar</button>
