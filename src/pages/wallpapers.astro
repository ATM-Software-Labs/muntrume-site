              </div>
              <div class="p-3 flex items-center justify-between gap-2 font-mono">
                <div class="min-w-0">
                  <div class="text-xs font-bold text-white truncate">{w.model}</div>
                  <div class="text-[10px] text-slate-400 truncate">{w.carClass} · {w.circuit}</div>
                </div>
                <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background:${w.accentColor}`}></span>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>

    <!-- PREVIEW MODAL -->
    <div id="wpModal" hidden class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true">
      <div class="w-full max-w-4xl rounded-xl border border-white/15 bg-[#0d1118] overflow-hidden shadow-2xl">
        <div class="flex items-center justify-between px-4 py-3 border-b border-white/10 font-mono">
          <div>
            <h3 id="wpModalTitle" class="text-sm font-bold text-white"></h3>
