                </label>
                <button type="button" data-preview-id={w.id} class="absolute bottom-2 left-2 px-2 py-1 rounded bg-black/80 border border-white/15 text-[10px] font-mono text-slate-200 font-bold cursor-pointer">
                  Vista Previa ⤢
                </button>
                <button type="button" data-direct-dl={w.id} class="absolute bottom-2 right-2 px-2.5 py-1 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] text-[10px] font-mono font-extrabold cursor-pointer shadow">
                  ↓ .JPG
