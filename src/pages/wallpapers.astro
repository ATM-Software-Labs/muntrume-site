---
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { loadOfficialMediaCatalog, type MediaCatalogItem as WallpaperItem } from "../lib/media-catalog";

const publicDir = path.join(process.cwd(), "public");
const { items: allWallpapers, albums: apiAlbums, audit: mediaAudit } = await loadOfficialMediaCatalog(publicDir);

// Official iRacing Series Roster Matchers (reads ALL metadata together: album + folder + category + car + title + filename)
function itemText(w: WallpaperItem): string {
  return `${w.album} ${w.folder} ${w.rawCategory} ${w.carClass} ${w.brand} ${w.model} ${w.carSlug} ${w.title} ${w.circuit} ${w.filename}`.toLowerCase();
}
function isLegacyCar(t: string): boolean {
  return /\blegacy\b|ford\s*gt\s*gt3|mp4-?12c|bmw\s*z4|z4\s*gt3|audi\s*r8.*2016|r8\s*lms.*2016/i.test(t);
}
function isFerrari296Challenge(t: string): boolean {
  return /296\s*challenge|ferrari.*challenge/i.test(t);
}
function isAudiOrMcLarenGt3(t: string): boolean {
  return (/audi|r8\s*lms/i.test(t) || /mclaren|720s/i.test(t)) && !/gt4|570s|tcr|rs\s*3|rs3|mp4-?12c|2016/i.test(t);
}
function isGtp(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /porsche\s*963|cadillac\s*v-?series|bmw\s*m\s*hybrid|ferrari\s*499p|acura\s*arx-?06|valkyrie|\bgtp\b|lmdh|hypercar/i.test(t);
}
function isLmp2(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /dallara\s*p217|p217|\blmp2\b/i.test(t);
}
function isLmp3(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /ligier|js\s*p320|jsp320|\blmp3\b/i.test(t);
}
function isPcup(w: WallpaperItem): boolean {
  const t = itemText(w);
  if (/(gt3\s*r|gt4|963|rsr|cayman|mission\s*r|bmw|\bm2\b|mx-?5|clio|nascar)/i.test(t)) return false;
  return /\bporsche\b/i.test(t) && /(911\s*gt3\s*cup|992(\.?[12])?\s*cup|991\s*cup|\bpcup\b)/i.test(t);
}
function isGt4(w: WallpaperItem): boolean {
  const t = itemText(w);
  if (/\bm2\b|bmw\s*m2/i.test(t)) return false;
  return /cayman\s*gt4|718\s*cayman|m4\s*gt4|amg\s*gt4|vantage\s*gt4|570s\s*gt4|\bgt4\b/i.test(t);
}
function isTcr(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /elantra|veloster|civic\s*type\s*r|rs\s*3\s*lms|rs3\s*lms|touring\s*car|\btcr\b/i.test(t);
}
function isEnduranceRaceAlbum(t: string): boolean {
  return /(24h\s*spa|spa-?francorchamps|daytona|sebring|imsa|le\s*mans|watkins\s*glen|endurance|resistencia)/i.test(t);
}
function isGt3Imsa(w: WallpaperItem): boolean {
  const t = itemText(w);
  if (isLegacyCar(t) || isFerrari296Challenge(t) || isAudiOrMcLarenGt3(t)) return false;
  if (/(gt4|tcr|\bm2\b|gt3\s*cup)/i.test(t)) return false;
  return /mustang\s*gt3|911\s*gt3\s*r|992\s*r?\s*gt3|296\s*gt3|corvette\s*z06\s*gt3|m4\s*gt3|mercedes.*gt3|amg\s*gt3|hurac[aá]n\s*gt3|vantage\s*gt3|nsx\s*gt3|\bgt3\b/i.test(t);
}
function isGt3All(w: WallpaperItem): boolean {
  const t = itemText(w);
  if (isLegacyCar(t) || isFerrari296Challenge(t)) return false;
  if (/(gt4|tcr|\bm2\b|gt3\s*cup)/i.test(t)) return false;
  return isGt3Imsa(w) || isAudiOrMcLarenGt3(t);
}
function isFormulas(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /formula|sf23|\bsfl\b|super\s*formula|ir18|indycar|fia\s*f4|\bf4\b|\bf3\b|formula\s*vee|ff1600|ray\s*ff|dallara\s*ir-?01/i.test(t);
}
function isPccRookie(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /bmw\s*m2|m2\s*cs|m2\s*racing|mx-?5|miata|gr86|clio/i.test(t);
}
function isNascar(w: WallpaperItem): boolean {
  const t = itemText(w);
  return /nascar|stock\s*car|xfinity|truck|cup\s*series|camaro|silverado|tundra|arca|late\s*model|gen\s*4|taurus|pontiac\s*grand\s*prix/i.test(t);
}

const SERIES_DEFS = [
  { id: "imsa", slug: "IMSA", title: "IMSA iRacing Series / IMSA Endurance (GTP + LMP2 + GT3)", badge: "IMSA", accent: "#facc15", match: (w: WallpaperItem) => isGtp(w) || isLmp2(w) || isGt3All(w) || (!isPcup(w) && !isGt4(w) && !isTcr(w) && !isFormulas(w) && !isNascar(w) && !isPccRookie(w) && isEnduranceRaceAlbum(itemText(w))), coverSlots: [isGtp, isLmp2, isGt3All, (w: WallpaperItem) => isAudiOrMcLarenGt3(itemText(w))] },
  { id: "gt-sprint", slug: "GTSprint", title: "GT Sprint / GT Endurance (Solo GT3)", badge: "GT3", accent: "#a855f7", match: (w: WallpaperItem) => isGt3All(w), coverSlots: [(w: WallpaperItem) => isAudiOrMcLarenGt3(itemText(w)), isGt3All, isGt3All, isGt3All] },
  { id: "nec", slug: "NEC", title: "Nürburgring Endurance Championship (NEC)", badge: "NEC", accent: "#ef4444", match: (w: WallpaperItem) => !isGtp(w) && !isLmp2(w) && !isLmp3(w) && !isFormulas(w) && (isGt3All(w) || isPcup(w) || isGt4(w) || isTcr(w) || /n[uü]rburgring|nordschleife|\bnec\b/i.test(itemText(w))), coverSlots: [isGt3All, isPcup, isGt4, isTcr] },
  { id: "pcup", slug: "PCup", title: "Porsche Cup (PCup)", badge: "PCUP", accent: "#e2e8f0", match: (w: WallpaperItem) => isPcup(w), coverSlots: [isPcup, isPcup, isPcup, isPcup] },
  { id: "ferrari-challenge", slug: "FerrariChallenge", title: "Ferrari 296 Challenge", badge: "CHALLENGE", accent: "#ef4444", match: (w: WallpaperItem) => isFerrari296Challenge(itemText(w)), coverSlots: [] },
  { id: "falken-gt4", slug: "FalkenGT4", title: "Falken Tyre Sports Car Challenge (GT4 + LMP3)", badge: "GT4 + LMP3", accent: "#fb923c", match: (w: WallpaperItem) => isLmp3(w) || isGt4(w), coverSlots: [isLmp3, isGt4, isGt4, isGt4] },
  { id: "tcr", slug: "TCR", title: "Touring Car Challenge (TCR)", badge: "TCR", accent: "#22c55e", match: (w: WallpaperItem) => isTcr(w), coverSlots: [isTcr, isTcr, isTcr, isTcr] },
  { id: "formulas", slug: "Formulas", title: "Fórmulas (SF23 / SFL / IR18 / F4)", badge: "FORMULA", accent: "#10b981", match: (w: WallpaperItem) => isFormulas(w), coverSlots: [isFormulas, isFormulas, isFormulas, isFormulas] },
  { id: "pcc", slug: "PCC", title: "Monomarca / Rookie (M2 / MX-5 / GR86 / Clio)", badge: "PCC", accent: "#38bdf8", match: (w: WallpaperItem) => isPccRookie(w), coverSlots: [isPccRookie, isPccRookie, isPccRookie, isPccRookie] },
  { id: "nascar", slug: "NASCAR", title: "NASCAR / Oval & Stock Car", badge: "NASCAR", accent: "#fbbf24", match: (w: WallpaperItem) => isNascar(w), coverSlots: [isNascar, isNascar, isNascar, isNascar] },
  { id: "all", slug: "Muntrume", title: "Colección Completa Muntrume Motorsport", badge: "ALL TRACK", accent: "#10b981", match: () => true, coverSlots: [] },
];

const usedSeriesCoverImgs = new Set<string>();
function pickUniqueSeriesCovers(items: WallpaperItem[], slots: Array<(w: WallpaperItem) => boolean>): WallpaperItem[] {
  const chosen: WallpaperItem[] = [];
  const chosenIds = new Set<string>();
  const pickOne = (pred: (w: WallpaperItem) => boolean, preferUnused: boolean): WallpaperItem | undefined =>
    items.find((w) => !chosenIds.has(w.id) && pred(w) && (!preferUnused || !usedSeriesCoverImgs.has(w.img)));

  for (const slotPred of slots) {
    if (chosen.length >= 4) break;
    const hit = pickOne(slotPred, true) || pickOne(slotPred, false);
    if (hit) {
      chosen.push(hit);
      chosenIds.add(hit.id);
      usedSeriesCoverImgs.add(hit.img);
    }
  }
  while (chosen.length < Math.min(4, items.length)) {
    const hit = pickOne(() => true, true) || pickOne(() => true, false);
    if (!hit) break;
    chosen.push(hit);
    chosenIds.add(hit.id);
    usedSeriesCoverImgs.add(hit.img);
  }
  return chosen;
}

const categoryPacks = SERIES_DEFS.map((d) => {
  const items = allWallpapers.filter(d.match);
  return {
    ...d,
    items,
    coverThumbs: pickUniqueSeriesCovers(items, d.coverSlots),
  };
}).filter((p) => p.items.length > 0);

// Per-car Packs
const carMap = new Map<string, WallpaperItem[]>();
for (const w of allWallpapers) {
  const arr = carMap.get(w.model) || [];
  arr.push(w);
  carMap.set(w.model, arr);
}
const carPacks = Array.from(carMap.entries())
  .map(([model, items]) => ({
    id: `car-${items[0].carSlug}`,
    slug: items[0].cleanFileBase,
    title: model,
    badge: items[0].carClass,
    accent: items[0].accentColor,
    items,
  }))
  .sort((a, b) => b.items.length - a.items.length);

// Mandatory 3-part Console Build Audit
const assignedIds = new Set<string>();
for (const p of categoryPacks) {
  if (p.id !== "all") p.items.forEach((item) => assignedIds.add(item.id));
}
const unassignedItems = allWallpapers.filter((w) => !assignedIds.has(w.id));

console.log(`[wallpapers] 1. Total bruto obtenido desde gallery + albums: ${mediaAudit.rawTotal}`);
console.log(`[wallpapers] 2. Total tras quitar solo previews/interiores (descartadas ${mediaAudit.filteredStudioInteriorCount}): ${mediaAudit.afterFilterTotal}`);
console.log(`[wallpapers] 3. Desglose por serie:`);
for (const p of categoryPacks) console.log(`[wallpapers]    - ${p.slug} (${p.title}): ${p.items.length}`);
console.log(`[wallpapers]    - Sin asignar a serie específica (solo en Colección Completa): ${unassignedItems.length}`);
console.log(`[wallpapers]    - Coches con fotos: ${carPacks.length}, Álbumes sincronizados: ${apiAlbums.length}`);

const brandsList = Array.from(new Set(allWallpapers.map((w) => w.brand))).sort();
const pageTitle = "Wallpapers Reales en Pista (JPG Windows 16:9 & Móvil 9:16 4K) · Muntrume Motorsport";
const pageDescription = `Descarga ${allWallpapers.length} wallpapers reales de iRacing en .JPG nativo para Windows (16:9) y Móvil (9:16 4K) por categoría, coche y álbum.`;
const pageUrl = "https://muntru.me/wallpapers/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl} ogImage={ogImage}>
  <main class="min-h-screen bg-[#090b0f] text-slate-100 py-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto space-y-8">
      <!-- HERO + FORMAT SWITCHER -->
      <header class="border-b border-white/10 pb-6 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-2.5">
          <div class="font-mono text-[11px] uppercase tracking-widest text-emerald-400 font-bold">
            Muntrume Motorsport · {allWallpapers.length} Fotos Reales Indexadas (Gallery + Albums)
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Wallpapers en Pista · Windows &amp; Móvil
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 max-w-2xl font-mono leading-relaxed">
            Conectado directamente a <a href="/gallery/" class="text-emerald-400 hover:underline">/gallery/</a> y <a href="/albums/" class="text-emerald-400 hover:underline">/albums/</a>. Conversión en cliente a <code class="text-emerald-400">.JPG</code> nativo para Windows (16:9) y Móvil (<span class="text-white font-semibold">2160×3840 4K</span>).
          </p>
        </div>

        <div class="flex flex-col items-start lg:items-end gap-2.5">
          <button
            type="button"
            id="wpOpenSubmitBtn"
            class="px-3.5 py-2 rounded-lg border border-emerald-500/45 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 font-mono text-xs font-extrabold tracking-wide transition cursor-pointer"
          >
            + Sugerir captura
          </button>
          <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400">Formato de salida (.JPG nativo)</span>
          <div class="inline-flex p-1 rounded-lg bg-[#0d1118] border border-white/15 font-mono text-xs" role="group">
            <button type="button" id="fmtDesktopBtn" class="px-3.5 py-2 rounded-md font-bold bg-emerald-500 text-[#04130d] transition cursor-pointer" aria-pressed="true">
              Escritorio · 16:9 (.JPG)
            </button>
            <button type="button" id="fmtMobileBtn" class="px-3.5 py-2 rounded-md font-bold text-slate-300 hover:text-white transition cursor-pointer" aria-pressed="false">
              Móvil · 9:16 (2160×3840 4K)
            </button>
          </div>
        </div>
      </header>

      <!-- PROGRESS BAR -->
      <section id="zipProgressBarWrap" hidden class="rounded-lg border border-emerald-500/40 bg-[#0d1118] p-4 space-y-2 font-mono">
        <div class="flex items-center justify-between text-xs">
          <span id="zipProgressLabel" class="text-emerald-400 font-bold">Convirtiendo a .JPG...</span>
          <span id="zipProgressPct" class="tabular-nums text-white font-bold">0%</span>
        </div>
        <div class="w-full h-2 rounded-full bg-black/60 overflow-hidden border border-white/10">
          <div id="zipProgressFill" class="h-full bg-emerald-500 transition-all duration-150" style="width:0%"></div>
        </div>
      </section>

      <!-- SECTION TABS + WINDOWS SLIDESHOW INTERVAL -->
      <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs border-b border-white/10 pb-3">
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-view-tab="categories" class="wp-tab px-3.5 py-2 rounded-md bg-emerald-500 text-[#04130d] font-extrabold cursor-pointer">
            Por Serie Oficial ({categoryPacks.length})
          </button>
          <button type="button" data-view-tab="cars" class="wp-tab px-3.5 py-2 rounded-md bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold cursor-pointer">
            Por Coche ({carPacks.length})
          </button>
          <button type="button" data-view-tab="albums" class="wp-tab px-3.5 py-2 rounded-md bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold cursor-pointer">
            Álbumes / Eventos ({apiAlbums.length})
          </button>
        </div>

        <div class="flex items-center gap-2 bg-[#0d1118] border border-white/10 rounded-lg px-2.5 py-1.5">
          <span class="text-[10px] uppercase tracking-wider text-slate-400">Slideshow Windows:</span>
          <div class="inline-flex items-center gap-1" id="wpIntervalGroup" role="group" aria-label="Intervalo de slideshow">
            <button type="button" data-interval-sec="15" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-bold text-slate-300 hover:text-white cursor-pointer" aria-pressed="false">15s</button>
            <button type="button" data-interval-sec="20" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-extrabold bg-emerald-500 text-[#04130d] cursor-pointer" aria-pressed="true">20s</button>
            <button type="button" data-interval-sec="30" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-bold text-slate-300 hover:text-white cursor-pointer" aria-pressed="false">30s</button>
            <button type="button" data-interval-sec="60" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-bold text-slate-300 hover:text-white cursor-pointer" aria-pressed="false">60s</button>
          </div>
        </div>
      </div>

      <!-- MULTI-MONITOR ZERO-DELAY SYNC GUIDE + QUICK DOWNLOAD -->
      <div class="rounded-lg border border-emerald-500/25 bg-[#0d1118]/90 px-4 py-3 flex flex-col lg:flex-row lg:items-center justify-between gap-3 font-mono text-xs">
        <div class="space-y-1">
          <p class="text-emerald-300 font-bold">⚡ Sincronización Exacta Multi-Monitor Windows (0 ms de desfase · Sin Admin HKCU)</p>
          <p class="text-[11px] text-slate-300 leading-relaxed">
            El modo <em>Presentación</em> nativo de Windows cambia cada monitor por separado con desfase. Nuestro script <code class="text-emerald-300">Sincronizar_Monitores_<span class="wp-sec-lbl">20s</span>.bat</code> usa <code class="text-white/90">SystemParametersInfo</code> (<code class="text-white/90">user32.dll</code>) en segundo plano (&lt; 5 MB RAM) con <code class="text-white/90">JPEGImportQuality = 100</code> para aplicar la misma imagen 4K simultáneamente en todas las pantallas.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <button type="button" id="wpDownloadSyncBatBtn" class="px-3 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold text-[11px] transition cursor-pointer">
            ⬇ Sincronizar_Monitores_<span class="wp-sec-lbl">20s</span>.bat
          </button>
          <button type="button" id="wpDownloadStopBatBtn" class="px-3 py-1.5 rounded border border-white/15 hover:border-rose-400/60 text-slate-200 hover:text-rose-300 font-bold text-[11px] transition cursor-pointer">
            ⏹ Detener_Sync_Wallpapers.bat
          </button>
        </div>
      </div>

      <!-- TAB 1: CATEGORY PACKS -->
      <section id="tab-categories" class="wp-tab-panel grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {categoryPacks.map((pack) => {
          const thumbs = pack.coverThumbs;
          const isThree = thumbs.length === 3;
          const gridClass =
            thumbs.length === 1
              ? "grid-cols-1 grid-rows-1"
              : thumbs.length === 2
                ? "grid-cols-2 grid-rows-1"
                : isThree
                  ? "grid-cols-3 grid-rows-2"
                  : "grid-cols-2 grid-rows-2";
          return (
            <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
              <div class={`aspect-video grid ${gridClass} gap-0.5 bg-[#090b0f] p-1 overflow-hidden`}>
                {thumbs.map((t, idx) => (
                  <div class={`${isThree && idx === 0 ? "col-span-2 row-span-2" : ""} w-full h-full bg-[#090b0f] overflow-hidden rounded-[2px]`}>
                    <img src={t.img} alt={t.model} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
                  </div>
                ))}
              </div>
              <div class="p-3.5 space-y-2.5 flex-1 flex flex-col justify-between">
                <div class="flex items-center justify-between gap-2 font-mono">
                  <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-[3px] border border-white/10" style={`color:${pack.accent};background:${pack.accent}18`}>{pack.badge}</span>
                  <span class="text-[11px] text-slate-400 tabular-nums">{pack.items.length} fotos .JPG</span>
                </div>
                <h3 class="text-sm sm:text-base font-extrabold text-white leading-snug">{pack.title}</h3>
                <div class="flex items-center gap-1.5 pt-1 font-mono text-[11px]">
                  <button type="button" data-pack-download={pack.id} class="flex-1 px-2.5 py-2 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold transition cursor-pointer whitespace-nowrap">
                    Descargar .ZIP
                  </button>
                  <button type="button" data-pack-slideshow={pack.id} class="px-2.5 py-2 rounded border border-emerald-500/40 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 font-bold transition cursor-pointer whitespace-nowrap" title="Previsualizar Slideshow">
                    Slideshow <span class="wp-sec-lbl">20s</span>
                  </button>
                  <button type="button" data-pack-filter={pack.id} class="px-2.5 py-2 rounded border border-white/15 hover:border-emerald-500/50 text-slate-200 font-semibold transition cursor-pointer whitespace-nowrap">
                    Explorar
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </section>

      <!-- TAB 2: CAR PACKS -->
      <section id="tab-cars" hidden class="wp-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
        {carPacks.map((pack) => {
          const thumbs = pack.items.slice(0, 4);
          const gridCols = thumbs.length === 1 ? "grid-cols-1" : thumbs.length === 3 ? "grid-cols-3" : "grid-cols-2";
          return (
            <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
              <div class={`grid ${gridCols} gap-0.5 bg-[#090b0f] p-1`}>
                {thumbs.map((t) => (
                  <div class="aspect-video bg-[#090b0f] overflow-hidden rounded-[2px]">
                    <img src={t.img} alt={t.model} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
                  </div>
                ))}
              </div>
              <div class="p-3 space-y-2 flex-1 flex flex-col justify-between font-mono">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[9.5px] font-extrabold px-1.5 py-0.5 rounded border border-white/10" style={`color:${pack.accent}`}>{pack.badge}</span>
                  <span class="text-[10px] text-slate-400 tabular-nums">{pack.items.length} fotos</span>
                </div>
                <h3 class="text-xs font-extrabold text-white truncate">{pack.title}</h3>
                <div class="flex items-center gap-1.5 pt-1 text-[11px]">
                  <button type="button" data-pack-download={pack.id} class="flex-1 px-2.5 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">
                    .ZIP (.JPG)
                  </button>
                  <button type="button" data-pack-slideshow={pack.id} class="px-2 py-1.5 rounded border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 font-bold cursor-pointer" title="Previsualizar Slideshow">
                    ▶
                  </button>
                  <button type="button" data-pack-filter={pack.id} class="px-2.5 py-1.5 rounded border border-white/15 text-slate-200 cursor-pointer">
                    Ver
                  </button>
                </div>
              </div>
            </article>
