          </div>
          <button type="button" id="wpModalClose" class="px-2.5 py-1 rounded border border-white/15 text-xs text-slate-300 hover:text-white cursor-pointer">Cerrar ✕</button>
        </div>
        <div class="p-4 bg-[#090b0f] flex items-center justify-center max-h-[68vh] overflow-hidden">
          <img id="wpModalImg" src="" alt="" referrerpolicy="no-referrer" class="max-h-[62vh] w-auto object-contain rounded border border-white/10" />
        </div>
        <div class="px-4 py-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
          <span class="text-slate-400">Exportado a .JPG estándar nativo para Windows (16:9) o Móvil (9:16 4K).</span>
          <div class="flex items-center gap-2">
            <button type="button" id="wpModalDownloadDesktop" class="px-3.5 py-2 rounded border border-white/20 hover:border-emerald-500 text-white font-bold cursor-pointer">Descargar 16:9 (.JPG)</button>
            <button type="button" id="wpModalDownloadMobile" class="px-3.5 py-2 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">Descargar Foto Móvil (9:16 4K .JPG)</button>
          </div>
        </div>
      </div>
    </div>

    <!-- SUBMIT / SUGGEST MODAL -->
    <div id="wpSubmitModal" hidden class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true">
      <div class="w-full max-w-lg rounded-xl border border-white/15 bg-[#0d1118] overflow-hidden shadow-2xl font-mono">
        <div class="flex items-center justify-between px-4 py-3 border-b border-white/10">
          <div>
            <h3 class="text-sm font-extrabold text-white">Subir / Sugerir Wallpaper</h3>
            <p class="text-[10px] text-slate-400">Solo capturas en pista (mín. 1920×1080 · JPG, PNG o WebP)</p>
          </div>
          <button type="button" id="wpSubmitClose" class="px-2.5 py-1 rounded border border-white/15 text-xs text-slate-300 hover:text-white cursor-pointer">Cerrar ✕</button>
        </div>
        <form id="wpSubmitForm" class="p-4 space-y-3 text-xs">
          <div class="grid grid-cols-2 gap-1.5 p-1 rounded-lg bg-[#090b0f] border border-white/10">
            <button type="button" id="wpModeCommunityBtn" class="py-1.5 rounded font-bold bg-emerald-500 text-[#04130d] cursor-pointer">Comunidad (Sugerir)</button>
            <button type="button" id="wpModeTeamBtn" class="py-1.5 rounded font-bold text-slate-300 hover:text-white cursor-pointer">Equipo MMT (Directo)</button>
          </div>
          <input type="hidden" id="wpSubmitMode" name="mode" value="community" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubCar">Coche</label><input id="wpSubCar" name="car" required placeholder="ej. Ford Mustang GT3" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
            <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubTrack">Circuito</label><input id="wpSubTrack" name="track" required placeholder="ej. Spa-Francorchamps" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[10px] text-slate-400 mb-1" for="wpSubCategory">Categoría</label>
              <select id="wpSubCategory" name="category" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white">
                <option value="GT3 2026">GT3 2026</option><option value="GTP">GTP / Hypercar</option><option value="LMP2">LMP2 &amp; Prototipos</option><option value="PCup">Porsche Cup</option><option value="Fórmulas">Fórmulas</option><option value="Equipo MMT">Equipo MMT</option>
              </select>
            </div>
            <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubAuthor">Piloto (iRacing / Discord)</label><input id="wpSubAuthor" name="author" required placeholder="ej. A. Trujillo" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
          </div>
          <div id="wpTeamTokenWrap" hidden><label class="block text-[10px] text-slate-400 mb-1" for="wpSubToken">Token de Equipo</label><input id="wpSubToken" name="teamToken" type="password" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
          <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubFile">Captura (mín. 1920×1080)</label><input id="wpSubFile" name="file" type="file" accept="image/jpeg,image/png,image/webp" required class="w-full bg-[#090b0f] border border-dashed border-white/25 rounded p-2.5 text-slate-300" /><p id="wpSubFileInfo" class="text-[10px] text-slate-400 mt-1"></p></div>
          <p id="wpSubmitStatus" hidden class="p-2.5 rounded border text-[11px]"></p>
          <button type="submit" id="wpSubmitSendBtn" class="w-full py-2.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">Enviar Captura</button>
        </form>
      </div>
    </div>
  </main>

  <script
    type="application/json"
    id="wpCatalogData"
    set:html={JSON.stringify({
      allWallpapers,
      packs: [...categoryPacks, ...carPacks].map((p) => ({ id: p.id, slug: p.slug, title: p.title, itemIds: p.items.map((i) => i.id) })),
    })}
  ></script>

  <script>
    import JSZip from "jszip";

    const PROXY_BASE = "https://muntrume.atrumin16.workers.dev/api/media/proxy?url=";
    const payload = JSON.parse(document.getElementById("wpCatalogData")?.textContent || "{}");
    const allItems: Array<{ id: string; brand: string; model: string; carClass: string; circuit: string; img: string; cleanFileBase: string }> = payload.allWallpapers || [];
    const packsMeta: Array<{ id: string; slug: string; title: string; itemIds: string[] }> = payload.packs || [];
    const itemById = new Map(allItems.map((i) => [i.id, i]));

    let outputFormat: "desktop" | "mobile" = "desktop";
    let activePackFilter: string | null = null;
    const selectedIds = new Set<string>();

    const fmtDesktopBtn = document.getElementById("fmtDesktopBtn") as HTMLButtonElement | null;
    const fmtMobileBtn = document.getElementById("fmtMobileBtn") as HTMLButtonElement | null;
    const brandSelect = document.getElementById("wpBrandFilter") as HTMLSelectElement | null;
    const searchInput = document.getElementById("wpSearchInput") as HTMLInputElement | null;
    const clearSelBtn = document.getElementById("wpClearSelBtn") as HTMLButtonElement | null;
    const dlSelBtn = document.getElementById("wpDownloadSelBtn") as HTMLButtonElement | null;
    const selCountEl = document.getElementById("wpSelCount");
    const progressWrap = document.getElementById("zipProgressBarWrap");
    const progressLabel = document.getElementById("zipProgressLabel");
    const progressPct = document.getElementById("zipProgressPct");
    const progressFill = document.getElementById("zipProgressFill") as HTMLElement | null;

    // Tabs
    document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.viewTab;
        document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((b) => {
          const on = b === btn;
          b.className = `wp-tab px-3.5 py-2 rounded-md cursor-pointer ${on ? "bg-emerald-500 text-[#04130d] font-extrabold" : "bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold"}`;
        });
        document.querySelectorAll<HTMLElement>(".wp-tab-panel").forEach((p) => {
          p.hidden = p.id !== `tab-${target}`;
        });
      });
    });
    if (location.hash === "#albums") {
      document.querySelector<HTMLButtonElement>('[data-view-tab="albums"]')?.click();
    }

    function setFormat(fmt: "desktop" | "mobile") {
      outputFormat = fmt;
      const isMob = fmt === "mobile";
      if (fmtDesktopBtn && fmtMobileBtn) {
        fmtDesktopBtn.className = `px-3.5 py-2 rounded-md font-bold transition cursor-pointer ${!isMob ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
        fmtMobileBtn.className = `px-3.5 py-2 rounded-md font-bold transition cursor-pointer ${isMob ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
      }
      document.querySelectorAll(".wp-thumb-wrap").forEach((el) => {
        el.classList.toggle("aspect-video", !isMob);
        el.classList.toggle("aspect-[9/16]", isMob);
      });
    }
    fmtDesktopBtn?.addEventListener("click", () => setFormat("desktop"));
    fmtMobileBtn?.addEventListener("click", () => setFormat("mobile"));

    function applyFilters() {
      const brand = brandSelect?.value || "all";
      const q = (searchInput?.value || "").trim().toLowerCase();
      const packIds = activePackFilter ? new Set(packsMeta.find((p) => p.id === activePackFilter)?.itemIds || []) : null;
      document.querySelectorAll<HTMLElement>(".wp-card").forEach((card) => {
        const ok = (brand === "all" || card.dataset.brand === brand) && (!q || (card.dataset.search || "").includes(q)) && (!packIds || packIds.has(card.dataset.id || ""));
        card.style.display = ok ? "" : "none";
      });
    }
    brandSelect?.addEventListener("change", () => { activePackFilter = null; applyFilters(); });
    searchInput?.addEventListener("input", applyFilters);
    document.querySelectorAll<HTMLButtonElement>("[data-pack-filter]").forEach((btn) => {
      btn.addEventListener("click", () => {
        activePackFilter = btn.dataset.packFilter || null;
        if (brandSelect) brandSelect.value = "all";
        applyFilters();
        document.getElementById("galleryHeading")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    function syncSelectionUi() {
      if (selCountEl) selCountEl.textContent = String(selectedIds.size);
      if (dlSelBtn) dlSelBtn.disabled = selectedIds.size === 0;
    }
    document.querySelectorAll<HTMLInputElement>(".wp-chk").forEach((chk) => {
      chk.addEventListener("change", () => {
        if (chk.checked) selectedIds.add(chk.value);
        else selectedIds.delete(chk.value);
        syncSelectionUi();
      });
    });
    clearSelBtn?.addEventListener("click", () => {
      selectedIds.clear();
      document.querySelectorAll<HTMLInputElement>(".wp-chk").forEach((c) => (c.checked = false));
      syncSelectionUi();
    });

    async function loadImage(url: string): Promise<HTMLImageElement> {
      const tryLoad = (src: string) =>
        new Promise<HTMLImageElement>((resolve, reject) => {
          const img = new Image();
          img.crossOrigin = "anonymous";
          img.onload = () => resolve(img);
          img.onerror = () => reject(new Error(`Failed ${src}`));
          img.src = src;
        });
      try {
        return await tryLoad(url);
      } catch {
        return await tryLoad(`${PROXY_BASE}${encodeURIComponent(url)}`);
      }
    }

    async function renderNativeJpgBlob(url: string, fmt: "desktop" | "mobile"): Promise<Blob> {
      const img = await loadImage(url);
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";

      if (fmt === "mobile") {
        const W = 2160, H = 3840;
        canvas.width = W; canvas.height = H;
        const scale = Math.max(W / img.naturalWidth, H / img.naturalHeight);
        const dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
        ctx.drawImage(img, (W - dw) * 0.5, (H - dh) * 0.5, dw, dh);
        const grad = ctx.createLinearGradient(0, 0, 0, H * 0.18);
        grad.addColorStop(0, "rgba(5,7,11,0.55)");
        grad.addColorStop(1, "rgba(5,7,11,0)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H * 0.18);
      } else {
        canvas.width = img.naturalWidth || 1920;
        canvas.height = img.naturalHeight || 1080;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      }

      return await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("toBlob failed"))), "image/jpeg", 0.96);
      });
    }

    function triggerDownload(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 4000);
    }

    async function downloadZipPack(items: typeof allItems, slug: string) {
      if (!items.length) return;
      const zip = new JSZip();
      const suffix = outputFormat === "mobile" ? "Mobile" : "Desktop";
      const zipName = `Muntrume-Wallpapers-${slug}-${suffix}.zip`;
      if (progressWrap) progressWrap.hidden = false;
      const updateProg = (done: number, total: number, text: string) => {
        const pct = Math.round((done / Math.max(1, total)) * 100);
        if (progressLabel) progressLabel.textContent = text;
        if (progressPct) progressPct.textContent = `${pct}%`;
        if (progressFill) progressFill.style.width = `${pct}%`;
      };
      zip.file("README_Windows_Slideshow.txt", "MUNTRUME MOTORSPORT WALLPAPERS (.JPG nativo)\r\nDescomprime en Windows -> Personalizar -> Fondo -> Presentacion -> Examinar.");
      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        updateProg(i, items.length, `Convirtiendo ${i + 1}/${items.length} a .JPG estándar (${suffix})...`);
        try {
          const jpgBlob = await renderNativeJpgBlob(item.img, outputFormat);
          zip.file(`Muntrume_${slug}_${String(i + 1).padStart(2, "0")}_${item.cleanFileBase}${outputFormat === "mobile" ? "_9x16_4K" : ""}.jpg`, jpgBlob);
        } catch {}
      }
      updateProg(items.length, items.length, `Comprimiendo ${zipName}...`);
      triggerDownload(await zip.generateAsync({ type: "blob" }), zipName);
      setTimeout(() => { if (progressWrap) progressWrap.hidden = true; }, 1500);
    }

    document.querySelectorAll<HTMLButtonElement>("[data-pack-download]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pack = packsMeta.find((p) => p.id === btn.dataset.packDownload);
        if (!pack) return;
        downloadZipPack(pack.itemIds.map((id) => itemById.get(id)).filter(Boolean) as typeof allItems, pack.slug);
      });
    });

    dlSelBtn?.addEventListener("click", () => {
      downloadZipPack(Array.from(selectedIds).map((id) => itemById.get(id)).filter(Boolean) as typeof allItems, "Seleccion");
    });

    const modalEl = document.getElementById("wpModal");
    const modalTitle = document.getElementById("wpModalTitle");
    const modalSub = document.getElementById("wpModalSub");
    const modalImg = document.getElementById("wpModalImg") as HTMLImageElement | null;
    let activeModalItem: (typeof allItems)[number] | null = null;

    document.querySelectorAll<HTMLButtonElement>("[data-preview-id]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = itemById.get(btn.dataset.previewId || "");
        if (!item || !modalEl) return;
        activeModalItem = item;
        if (modalTitle) modalTitle.textContent = item.model;
        if (modalSub) modalSub.textContent = `${item.carClass} · ${item.circuit}`;
        if (modalImg) { modalImg.src = item.img; modalImg.alt = item.model; }
        modalEl.hidden = false;
      });
    });
    document.getElementById("wpModalClose")?.addEventListener("click", () => { if (modalEl) modalEl.hidden = true; });
    modalEl?.addEventListener("click", (e) => { if (e.target === modalEl) modalEl.hidden = true; });

    async function downloadSingleItem(item: (typeof allItems)[number], fmt: "desktop" | "mobile") {
      const jpgBlob = await renderNativeJpgBlob(item.img, fmt);
      triggerDownload(jpgBlob, `Muntrume_${item.cleanFileBase}${fmt === "mobile" ? "_9x16_4K" : "_16x9"}.jpg`);
    }
    document.querySelectorAll<HTMLButtonElement>("[data-direct-dl]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = itemById.get(btn.dataset.directDl || "");
        if (item) downloadSingleItem(item, outputFormat);
      });
    });
    document.getElementById("wpModalDownloadDesktop")?.addEventListener("click", () => { if (activeModalItem) downloadSingleItem(activeModalItem, "desktop"); });
    document.getElementById("wpModalDownloadMobile")?.addEventListener("click", () => { if (activeModalItem) downloadSingleItem(activeModalItem, "mobile"); });

    // Submit Modal
    const subModal = document.getElementById("wpSubmitModal");
    document.getElementById("wpOpenSubmitBtn")?.addEventListener("click", () => { if (subModal) subModal.hidden = false; });
    document.getElementById("wpSubmitClose")?.addEventListener("click", () => { if (subModal) subModal.hidden = true; });
    subModal?.addEventListener("click", (e) => { if (e.target === subModal) subModal.hidden = true; });
    const subModeInput = document.getElementById("wpSubmitMode") as HTMLInputElement | null;
    const modeCommBtn = document.getElementById("wpModeCommunityBtn");
    const modeTeamBtn = document.getElementById("wpModeTeamBtn");
    const tokenWrap = document.getElementById("wpTeamTokenWrap");
    const setSubmitMode = (mode: "community" | "team") => {
      if (subModeInput) subModeInput.value = mode;
      const isTeam = mode === "team";
      if (tokenWrap) tokenWrap.hidden = !isTeam;
      if (modeCommBtn && modeTeamBtn) {
        modeCommBtn.className = `py-1.5 rounded font-bold cursor-pointer ${!isTeam ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
        modeTeamBtn.className = `py-1.5 rounded font-bold cursor-pointer ${isTeam ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
      }
    };
    modeCommBtn?.addEventListener("click", () => setSubmitMode("community"));
    modeTeamBtn?.addEventListener("click", () => setSubmitMode("team"));

    const fileInput = document.getElementById("wpSubFile") as HTMLInputElement | null;
    const fileInfo = document.getElementById("wpSubFileInfo");
    const subStatus = document.getElementById("wpSubmitStatus");
    const subForm = document.getElementById("wpSubmitForm") as HTMLFormElement | null;
    let fileDimsValid = false;
    fileInput?.addEventListener("change", () => {
      fileDimsValid = false;
      const f = fileInput.files?.[0];
      if (!f) return;
      const objUrl = URL.createObjectURL(f);
      const probe = new Image();
      probe.onload = () => {
        URL.revokeObjectURL(objUrl);
        fileDimsValid = probe.naturalWidth >= 1920 && probe.naturalHeight >= 1080;
        if (fileInfo) {
          fileInfo.textContent = fileDimsValid ? `OK: ${probe.naturalWidth}×${probe.naturalHeight} px` : `Insuficiente (${probe.naturalWidth}×${probe.naturalHeight}). Mínimo 1920×1080.`;
          fileInfo.className = `text-[10px] mt-1 ${fileDimsValid ? "text-emerald-400" : "text-rose-400"}`;
        }
      };
      probe.src = objUrl;
    });
    subForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!fileDimsValid) {
        if (subStatus) { subStatus.hidden = false; subStatus.textContent = "Resolución mínima 1920×1080 requerida."; }
        return;
      }
      const resp = await fetch("/api/wallpapers/submit", { method: "POST", body: new FormData(subForm) }).catch(() => null);
      const data = resp ? await resp.json().catch(() => ({})) : { error: "Error de red." };
      if (subStatus) {
        subStatus.hidden = false;
        subStatus.textContent = resp?.ok && data.ok ? data.message : (data.error || "Error enviando.");
      }
    });
  </script>
</Layout>
