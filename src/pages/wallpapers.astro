        <div id="wpGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {allWallpapers.slice(0, 60).map((w) => (
            <article class="wp-card group rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col hover:border-emerald-500/40 transition" data-id={w.id} data-brand={w.brand} data-search={`${w.brand} ${w.model} ${w.carClass} ${w.circuit}`.toLowerCase()}>
              <div class="wp-thumb-wrap relative aspect-video bg-[#090b0f] overflow-hidden">
                <img src={w.img} alt={w.model} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                <label class="absolute top-2 left-2 z-10 inline-flex items-center gap-1.5 px-2 py-1 rounded bg-black/75 border border-white/15 text-[10px] font-mono text-white cursor-pointer select-none">
                  <input type="checkbox" class="wp-chk accent-emerald-500" value={w.id} />
