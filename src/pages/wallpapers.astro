---
import fs from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";
import { TRACK_GALLERY_PHOTOS, PADDOCK_ALBUMS } from "../data/paddock-gallery";

interface WallpaperItem {
  id: string;
  brand: string;
  model: string;
  carSlug: string;
  carClass: string;
  categoryKey: string;
  circuit: string;
  img: string;
  cleanFileBase: string;
  accentColor: string;
}

const API_BASE = "https://muntrume.atrumin16.workers.dev";
const publicDir = path.join(process.cwd(), "public");
const seenImgs = new Set<string>();
const allWallpapers: WallpaperItem[] = [];

function isStudioOrBanner(src: string): boolean {
  const lower = src.toLowerCase();
  if (lower.startsWith("/assets/cars/")) return true;
  if (/(series[-_]?banner|brand[-_]?logo|\/logo[._-]|thumb|main\.(webp|jpg|png)|badge|og-)/i.test(lower)) return true;
  return false;
}

function mapCategoryKey(rawCat: string, carName = "", title = ""): { key: string; label: string; accent: string } {
  const s = `${rawCat} ${carName} ${title}`.toLowerCase();
  if (/296\s*challenge|ferrari.*challenge/i.test(s)) return { key: "ferrari_challenge", label: "Challenge", accent: "#ef4444" };
  if (/\bcup\b|992\.?1|992\.?2|porsche.*cup/i.test(s)) return { key: "pcup", label: "PCup", accent: "#e2e8f0" };
  if (/\bgtp\b|hypercar|lmdh|lmh|499p|963|v-series|arx-06|hybrid\s*v8|valkyrie/i.test(s)) return { key: "gtp", label: "GTP", accent: "#facc15" };
  if (/\blmp2\b|p217/i.test(s)) return { key: "lmp2", label: "LMP2", accent: "#38bdf8" };
  if (/\blmp3\b|ligier|jsp320|js\s*p320/i.test(s)) return { key: "lmp3", label: "LMP3", accent: "#06b6d4" };
  if (/\bgte\b|c8\.r|488\s*gte|911\s*rsr|m8\s*gte/i.test(s)) return { key: "gte", label: "GTE", accent: "#ef4444" };
  if (/\bgt4\b|570s|718\s*cayman/i.test(s)) return { key: "gt4", label: "GT4", accent: "#fb923c" };
  if (/\btcr\b|touring|rs\s*3|rs3|elantra|veloster|civic/i.test(s)) return { key: "tcr", label: "TCR", accent: "#22c55e" };
  if (/formula|sf23|\bsfl\b|ir18|ir04|\bf4\b|\bf3\b|ff1600|super\s*formula|vee/i.test(s)) return { key: "formulas", label: "Formula", accent: "#10b981" };
  if (/nascar|stock|oval|camaro|silverado|tundra|arca|late\s*model/i.test(s)) return { key: "oval", label: "Oval", accent: "#fbbf24" };
  if (/mx-?5|miata|gr86|clio|production/i.test(s)) return { key: "rookie", label: "PCC", accent: "#38bdf8" };
  if (/\bgt3\b/i.test(s)) return { key: "gt3", label: "GT3", accent: "#a855f7" };
  return { key: "gt3", label: "GT3", accent: "#a855f7" };
}

function addPhoto(item: {
  id: string;
  brand: string;
  model: string;
  carSlug: string;
  carClass: string;
  categoryKey: string;
  circuit: string;
  img: string;
  accentColor: string;
}) {
  if (!item.img || isStudioOrBanner(item.img)) return;
  if (seenImgs.has(item.img)) return;
  if (item.img.startsWith("/") && !fs.existsSync(path.join(publicDir, item.img))) return;
  seenImgs.add(item.img);

  const cleanFileBase = `${item.brand}_${item.model}`
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-zA-Z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "");

  allWallpapers.push({
    ...item,
    cleanFileBase: cleanFileBase || item.id,
  });
}

// 1. Fetch ALL published photos from live gallery API (/api/gallery)
for (let offset = 0; offset <= 1000; offset += 200) {
  try {
    const res = await fetch(`${API_BASE}/api/gallery?status=published&sort=popular&limit=200&offset=${offset}`);
    if (!res.ok) break;
    const data = await res.json();
    const list = Array.isArray(data?.items) ? data.items : Array.isArray(data?.photos) ? data.photos : [];
    if (!list.length) break;
    for (const p of list) {
      const url = String(p.imageUrl || p.url || "");
      const carName = String(p.car || p.title || "iRacing").trim();
      const brand = carName.split(" ")[0] || "Muntrume";
      const mapped = mapCategoryKey(String(p.category || ""), carName, String(p.title || ""));
      addPhoto({
        id: String(p.id || `gal_${allWallpapers.length}`),
        brand,
        model: carName,
        carSlug: String(p.carSlug || carName.toLowerCase().replace(/[^a-z0-9]+/g, "-")),
        carClass: mapped.label,
        categoryKey: mapped.key,
        circuit: String(p.track || p.authorName || "Circuito Oficial iRacing"),
        img: url,
        accentColor: mapped.accent,
      });
    }
    if (list.length < 200) break;
  } catch {
    break;
  }
}

// 2. Fetch live albums from /v1/albums
interface AlbumPack {
  slug: string;
  title: string;
  carClass: string;
  count: number;
  cover: string;
  items: WallpaperItem[];
}
const apiAlbums: AlbumPack[] = [];
try {
  const res = await fetch(`${API_BASE}/v1/albums`);
  if (res.ok) {
    const data = await res.json();
    const rawAlbums = Array.isArray(data?.albums) ? data.albums : [];
    for (const a of rawAlbums) {
      const slug = String(a.slug || "").toLowerCase();
      const carName = String(a.car || a.title || slug);
      const matched = allWallpapers.filter(
        (w) => w.carSlug === slug || w.model.toLowerCase() === carName.toLowerCase()
      );
      if (matched.length > 0) {
        apiAlbums.push({
          slug,
          title: carName,
          carClass: String(a.category || matched[0].carClass).toUpperCase(),
          count: matched.length,
          cover: matched[0].img,
          items: matched,
        });
      }
    }
  }
} catch {}

// 3. Static local on-track fallback photos (TRACK_GALLERY_PHOTOS + non-studio PADDOCK_ALBUMS)
for (const p of TRACK_GALLERY_PHOTOS) {
  const mapped = mapCategoryKey(p.category, p.title, p.caption);
  addPhoto({
    id: p.id,
    brand: p.title.includes("Porsche") ? "Porsche" : p.title.includes("Cadillac") ? "Cadillac" : "Ferrari",
    model: p.title.replace(/·/g, "-"),
    carSlug: p.id,
    carClass: mapped.label,
    categoryKey: mapped.key,
    circuit: p.circuit,
    img: p.img,
    accentColor: mapped.accent,
  });
}
for (const album of PADDOCK_ALBUMS) {
  const mapped = mapCategoryKey(album.carClass, album.title, "");
  for (const ph of album.photos) {
    addPhoto({
      id: ph.id,
      brand: album.brand,
      model: album.title,
      carSlug: album.slug,
      carClass: mapped.label,
      categoryKey: mapped.key,
      circuit: ph.subtitle || "Circuito Oficial iRacing",
      img: ph.img,
      accentColor: mapped.accent,
    });
  }
}

// Official iRacing Series Roster Matchers
function itemText(w: WallpaperItem): string {
  return `${w.brand} ${w.model} ${w.carSlug} ${w.carClass}`.toLowerCase();
}
function isLegacyCar(t: string): boolean {
  return /\blegacy\b/i.test(t);
}
function isFerrari296Challenge(t: string): boolean {
  return /296\s*challenge|ferrari.*challenge/i.test(t);
}
function isAudiOrMcLarenGt3(t: string): boolean {
  return (/audi|r8\s*lms/i.test(t) || /mclaren|720s|mp4-12c/i.test(t)) && !/gt4|570s|tcr|rs\s*3|rs3/i.test(t);
}
function isGtp(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "gtp" || /porsche\s*963|cadillac\s*v-?series|bmw\s*m\s*hybrid|ferrari\s*499p|acura\s*arx-?06|valkyrie/i.test(t);
}
function isLmp2(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "lmp2" || /dallara\s*p217|p217/i.test(t);
}
function isLmp3(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "lmp3" || /ligier|js\s*p320|jsp320/i.test(t);
}
function isPcup(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "pcup" || /porsche.*cup|911\s*gt3\s*cup|992\.?2?\s*cup/i.test(t);
}
function isGt4(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "gt4" || /cayman\s*gt4|718\s*cayman|570s\s*gt4|m4\s*gt4|vantage\s*gt4|amg\s*gt4/i.test(t);
}
function isTcr(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "tcr" || /elantra|veloster|civic\s*type\s*r|rs\s*3\s*lms|rs3\s*lms|touring\s*car/i.test(t);
}
function isGt3Imsa(w: WallpaperItem): boolean {
  const t = itemText(w);
  if (isLegacyCar(t) || isFerrari296Challenge(t) || isAudiOrMcLarenGt3(t)) return false;
  return (
    /mustang\s*gt3|911\s*gt3\s*r|992\s*r?\s*gt3|296\s*gt3|corvette\s*z06\s*gt3|m4\s*gt3|mercedes.*gt3|amg\s*gt3|hurac[aá]n\s*gt3|vantage\s*gt3|nsx\s*gt3/i.test(t) ||
    w.categoryKey === "gt3"
  );
}
function isGt3All(w: WallpaperItem): boolean {
  const t = itemText(w);
  if (isLegacyCar(t) || isFerrari296Challenge(t)) return false;
  return isGt3Imsa(w) || isAudiOrMcLarenGt3(t) || w.categoryKey === "gt3";
}
function isFormulas(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "formulas" || /formula|sf23|\bsfl\b|super\s*formula|ir18|indycar|fia\s*f4|\bf4\b|formula\s*vee|ff1600|ray\s*ff/i.test(t);
}
function isPccRookie(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "rookie" || /mx-?5|miata|gr86|clio|production\s*car/i.test(t);
}
function isNascar(w: WallpaperItem): boolean {
  const t = itemText(w);
  return w.categoryKey === "oval" || /nascar|stock\s*car|xfinity|truck|cup\s*series|camaro|silverado|tundra|arca|late\s*model/i.test(t);
}

const SERIES_DEFS = [
  { id: "imsa", slug: "IMSA", title: "IMSA iRacing Series (GTP + LMP2 + GT3)", badge: "IMSA", accent: "#facc15", match: (w: WallpaperItem) => isGtp(w) || isLmp2(w) || isGt3Imsa(w) },
  { id: "gt-sprint", slug: "GTSprint", title: "GT Sprint / GT Endurance Series", badge: "GT3", accent: "#a855f7", match: (w: WallpaperItem) => isGt3All(w) },
  { id: "nec", slug: "NEC", title: "Nürburgring Endurance Championship (NEC)", badge: "NEC", accent: "#ef4444", match: (w: WallpaperItem) => isGt3All(w) || isPcup(w) || isGt4(w) || isTcr(w) },
  { id: "pcup", slug: "PCup", title: "Porsche Cup (PCup)", badge: "PCUP", accent: "#e2e8f0", match: (w: WallpaperItem) => isPcup(w) },
  { id: "ferrari-challenge", slug: "FerrariChallenge", title: "Ferrari 296 Challenge", badge: "CHALLENGE", accent: "#ef4444", match: (w: WallpaperItem) => isFerrari296Challenge(itemText(w)) },
  { id: "falken-gt4", slug: "FalkenGT4", title: "Falken Tyre Sports Car Challenge (GT4 + LMP3)", badge: "GT4 + LMP3", accent: "#fb923c", match: (w: WallpaperItem) => isLmp3(w) || isGt4(w) },
  { id: "tcr", slug: "TCR", title: "Touring Car Challenge (TCR)", badge: "TCR", accent: "#22c55e", match: (w: WallpaperItem) => isTcr(w) },
  { id: "formulas", slug: "Formulas", title: "Fórmulas (SF23 / SFL / IR18 / F4)", badge: "FORMULA", accent: "#10b981", match: (w: WallpaperItem) => isFormulas(w) },
  { id: "pcc", slug: "PCC", title: "Production Car Challenge / Rookie", badge: "PCC", accent: "#38bdf8", match: (w: WallpaperItem) => isPccRookie(w) },
  { id: "nascar", slug: "NASCAR", title: "NASCAR / Oval & Stock Car", badge: "NASCAR", accent: "#fbbf24", match: (w: WallpaperItem) => isNascar(w) },
  { id: "all", slug: "Muntrume", title: "Colección Completa Muntrume Motorsport", badge: "ALL TRACK", accent: "#10b981", match: () => true },
];

const categoryPacks = SERIES_DEFS.map((d) => ({
  ...d,
  items: allWallpapers.filter(d.match),
})).filter((p) => p.items.length > 0);

// Per-car Packs
const carMap = new Map<string, WallpaperItem[]>();
for (const w of allWallpapers) {
  const arr = carMap.get(w.model) || [];
  arr.push(w);
  carMap.set(w.model, arr);
}
const carPacks = Array.from(carMap.entries())
  .map(([model, items]) => ({
    id: `car-${items[0].carSlug}`,
    slug: items[0].cleanFileBase,
    title: model,
    badge: items[0].carClass,
    accent: items[0].accentColor,
    items,
  }))
  .sort((a, b) => b.items.length - a.items.length);

// Console build audit
console.log(`[wallpapers] Total real photos indexed (gallery + albums + track): ${allWallpapers.length}`);
for (const p of categoryPacks) console.log(`[wallpapers]   Series ${p.slug} (${p.title}): ${p.items.length}`);
console.log(`[wallpapers]   Cars with track photos: ${carPacks.length}, Albums: ${apiAlbums.length}`);

const brandsList = Array.from(new Set(allWallpapers.map((w) => w.brand))).sort();
const pageTitle = "Wallpapers Reales en Pista (JPG Windows 16:9 & Móvil 9:16 4K) · Muntrume Motorsport";
const pageDescription = `Descarga ${allWallpapers.length} wallpapers reales de iRacing en .JPG nativo para Windows (16:9) y Móvil (9:16 4K) por categoría, coche y álbum.`;
const pageUrl = "https://muntru.me/wallpapers/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl} ogImage={ogImage}>
  <main class="min-h-screen bg-[#090b0f] text-slate-100 py-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto space-y-8">
      <!-- HERO + FORMAT SWITCHER -->
      <header class="border-b border-white/10 pb-6 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-2.5">
          <div class="font-mono text-[11px] uppercase tracking-widest text-emerald-400 font-bold">
            Muntrume Motorsport · {allWallpapers.length} Fotos Reales Indexadas (Gallery + Albums)
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
            Wallpapers en Pista · Windows &amp; Móvil
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 max-w-2xl font-mono leading-relaxed">
            Conectado directamente a <a href="/gallery/" class="text-emerald-400 hover:underline">/gallery/</a> y <a href="/albums/" class="text-emerald-400 hover:underline">/albums/</a>. Conversión en cliente a <code class="text-emerald-400">.JPG</code> nativo para Windows (16:9) y Móvil (<span class="text-white font-semibold">2160×3840 4K</span>).
          </p>
        </div>

        <div class="flex flex-col items-start lg:items-end gap-2.5">
          <button
            type="button"
            id="wpOpenSubmitBtn"
            class="px-3.5 py-2 rounded-lg border border-emerald-500/45 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 font-mono text-xs font-extrabold tracking-wide transition cursor-pointer"
          >
            + Subir / Sugerir Wallpaper
          </button>
          <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400">Formato de salida (.JPG nativo)</span>
          <div class="inline-flex p-1 rounded-lg bg-[#0d1118] border border-white/15 font-mono text-xs" role="group">
            <button type="button" id="fmtDesktopBtn" class="px-3.5 py-2 rounded-md font-bold bg-emerald-500 text-[#04130d] transition cursor-pointer" aria-pressed="true">
              Escritorio · 16:9 (.JPG)
            </button>
            <button type="button" id="fmtMobileBtn" class="px-3.5 py-2 rounded-md font-bold text-slate-300 hover:text-white transition cursor-pointer" aria-pressed="false">
              Móvil · 9:16 (2160×3840 4K)
            </button>
          </div>
        </div>
      </header>

      <!-- PROGRESS BAR -->
      <section id="zipProgressBarWrap" hidden class="rounded-lg border border-emerald-500/40 bg-[#0d1118] p-4 space-y-2 font-mono">
        <div class="flex items-center justify-between text-xs">
          <span id="zipProgressLabel" class="text-emerald-400 font-bold">Convirtiendo a .JPG...</span>
          <span id="zipProgressPct" class="tabular-nums text-white font-bold">0%</span>
        </div>
        <div class="w-full h-2 rounded-full bg-black/60 overflow-hidden border border-white/10">
          <div id="zipProgressFill" class="h-full bg-emerald-500 transition-all duration-150" style="width:0%"></div>
        </div>
      </section>

      <!-- SECTION TABS: Series Oficiales | Por Coche | Álbumes -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs border-b border-white/10 pb-3">
        <button type="button" data-view-tab="categories" class="wp-tab px-3.5 py-2 rounded-md bg-emerald-500 text-[#04130d] font-extrabold cursor-pointer">
          Por Serie Oficial ({categoryPacks.length})
        </button>
        <button type="button" data-view-tab="cars" class="wp-tab px-3.5 py-2 rounded-md bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold cursor-pointer">
          Por Coche ({carPacks.length})
        </button>
        <button type="button" data-view-tab="albums" class="wp-tab px-3.5 py-2 rounded-md bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold cursor-pointer">
          Álbumes / Eventos ({apiAlbums.length})
        </button>
      </div>

      <!-- TAB 1: CATEGORY PACKS -->
      <section id="tab-categories" class="wp-tab-panel grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        {categoryPacks.map((pack) => {
          const thumbs = pack.items.slice(0, 4);
          const gridCols = thumbs.length === 1 ? "grid-cols-1" : thumbs.length === 3 ? "grid-cols-3" : "grid-cols-2";
          return (
            <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
              <div class={`grid ${gridCols} gap-0.5 bg-[#090b0f] p-1`}>
                {thumbs.map((t) => (
                  <div class="aspect-video bg-[#090b0f] overflow-hidden rounded-[2px]">
                    <img src={t.img} alt={t.model} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
                  </div>
                ))}
              </div>
              <div class="p-4 space-y-3 flex-1 flex flex-col justify-between">
                <div class="flex items-center justify-between gap-2 font-mono">
                  <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-[3px] border border-white/10" style={`color:${pack.accent};background:${pack.accent}18`}>{pack.badge}</span>
                  <span class="text-[11px] text-slate-400 tabular-nums">{pack.items.length} fotos .JPG</span>
                </div>
                <h3 class="text-base font-extrabold text-white">{pack.title}</h3>
                <div class="flex items-center gap-2 pt-2 font-mono text-xs">
                  <button type="button" data-pack-download={pack.id} class="flex-1 px-3 py-2 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold transition cursor-pointer">
                    Descargar Pack .ZIP (.JPG)
                  </button>
                  <button type="button" data-pack-filter={pack.id} class="px-3 py-2 rounded border border-white/15 hover:border-emerald-500/50 text-slate-200 font-semibold transition cursor-pointer">
                    Explorar
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </section>

      <!-- TAB 2: CAR PACKS -->
      <section id="tab-cars" hidden class="wp-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
        {carPacks.map((pack) => {
          const thumbs = pack.items.slice(0, 4);
          const gridCols = thumbs.length === 1 ? "grid-cols-1" : thumbs.length === 3 ? "grid-cols-3" : "grid-cols-2";
          return (
            <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
              <div class={`grid ${gridCols} gap-0.5 bg-[#090b0f] p-1`}>
                {thumbs.map((t) => (
                  <div class="aspect-video bg-[#090b0f] overflow-hidden rounded-[2px]">
                    <img src={t.img} alt={t.model} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
                  </div>
                ))}
              </div>
              <div class="p-3 space-y-2 flex-1 flex flex-col justify-between font-mono">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[9.5px] font-extrabold px-1.5 py-0.5 rounded border border-white/10" style={`color:${pack.accent}`}>{pack.badge}</span>
                  <span class="text-[10px] text-slate-400 tabular-nums">{pack.items.length} fotos</span>
                </div>
                <h3 class="text-xs font-extrabold text-white truncate">{pack.title}</h3>
                <div class="flex items-center gap-1.5 pt-1 text-[11px]">
                  <button type="button" data-pack-download={pack.id} class="flex-1 px-2.5 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">
                    .ZIP (.JPG)
                  </button>
                  <button type="button" data-pack-filter={pack.id} class="px-2.5 py-1.5 rounded border border-white/15 text-slate-200 cursor-pointer">
                    Ver
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </section>

      <!-- TAB 3: ALBUMS -->
      <section id="tab-albums" hidden class="wp-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {apiAlbums.map((alb) => (
          <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
            <div class="aspect-video bg-[#090b0f] overflow-hidden">
              <img src={alb.cover} alt={alb.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 space-y-2.5 font-mono">
              <div class="flex items-center justify-between text-[10px]">
                <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-bold">{alb.carClass}</span>
                <span class="text-slate-400 tabular-nums">{alb.count} fotos reales</span>
              </div>
              <h3 class="text-sm font-extrabold text-white truncate">{alb.title}</h3>
              <button type="button" data-pack-download={`car-${alb.slug}`} class="w-full py-2 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold text-xs cursor-pointer">
                Descargar Álbum .ZIP (.JPG)
              </button>
            </div>
          </article>
        ))}
      </section>

      <!-- GALLERY + INDIVIDUAL SELECTION -->
      <section aria-labelledby="galleryHeading" class="space-y-4 pt-4 border-t border-white/10">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
          <div>
            <h2 id="galleryHeading" class="font-mono text-xs uppercase tracking-widest text-slate-300 font-bold">
              Todas las Capturas Reales en Pista ({allWallpapers.length})
            </h2>
            <p class="text-xs text-slate-400 font-mono mt-0.5">
              Descarga individual en .JPG o marca varias capturas para crear tu propio .ZIP.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <select id="wpBrandFilter" class="bg-[#0d1118] border border-white/15 rounded px-2.5 py-1.5 text-slate-200 outline-none">
              <option value="all">Todas las marcas ({allWallpapers.length})</option>
              {brandsList.map((brand) => <option value={brand}>{brand}</option>)}
            </select>
            <input id="wpSearchInput" type="search" placeholder="Buscar coche o circuito..." class="bg-[#0d1118] border border-white/15 rounded px-3 py-1.5 text-slate-100 placeholder-slate-500 outline-none w-52" />
            <button type="button" id="wpClearSelBtn" class="px-2.5 py-1.5 rounded border border-white/15 text-slate-400 hover:text-white cursor-pointer">Limpiar</button>
            <button type="button" id="wpDownloadSelBtn" disabled class="px-3.5 py-1.5 rounded bg-emerald-500 disabled:bg-white/10 disabled:text-slate-500 text-[#04130d] font-extrabold cursor-pointer tabular-nums">
              Descargar Selección (<span id="wpSelCount">0</span>)
