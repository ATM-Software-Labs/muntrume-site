  <script>
    import JSZip from "jszip";

    const PROXY_BASE = "https://muntrume.atrumin16.workers.dev/api/media/proxy?url=";
    const payload = JSON.parse(document.getElementById("wpCatalogData")?.textContent || "{}");
    const allItems: Array<{ id: string; slugId: string; brand: string; model: string; carClass: string; circuit: string; img: string; cleanFileBase: string; width: number; height: number; aspectRatio: string }> = payload.allWallpapers || [];
    const packsMeta: Array<{ id: string; slug: string; title: string; itemIds: string[] }> = payload.packs || [];
    const itemById = new Map(allItems.map((i) => [i.id, i]));
    const itemBySlug = new Map(allItems.map((i) => [i.slugId, i]));

    let outputFormat: "desktop" | "mobile" = "desktop";
    let slideshowSec = 20;
    let activePackFilter: string | null = null;
    const selectedIds = new Set<string>();

    document.querySelectorAll<HTMLButtonElement>(".wp-int-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const sec = Number(btn.dataset.intervalSec || "20");
        slideshowSec = Number.isFinite(sec) && sec > 0 ? sec : 20;
        document.querySelectorAll<HTMLButtonElement>(".wp-int-btn").forEach((b) => {
          const on = b === btn;
          b.setAttribute("aria-pressed", String(on));
          b.className = `wp-int-btn px-2 py-0.5 rounded text-[11px] cursor-pointer ${on ? "font-extrabold bg-emerald-500 text-[#04130d]" : "font-bold text-slate-300 hover:text-white"}`;
        });
        document.querySelectorAll(".wp-sec-lbl").forEach((el) => {
          el.textContent = `${slideshowSec}s`;
        });
        document.documentElement.style.setProperty("--wp-kb-dur", `${slideshowSec}s`);
      });
    });

    const fmtDesktopBtn = document.getElementById("fmtDesktopBtn") as HTMLButtonElement | null;
    const fmtMobileBtn = document.getElementById("fmtMobileBtn") as HTMLButtonElement | null;
    const brandSelect = document.getElementById("wpBrandFilter") as HTMLSelectElement | null;
    const searchInput = document.getElementById("wpSearchInput") as HTMLInputElement | null;
    const clearSelBtn = document.getElementById("wpClearSelBtn") as HTMLButtonElement | null;
    const dlSelBtn = document.getElementById("wpDownloadSelBtn") as HTMLButtonElement | null;
    const selCountEl = document.getElementById("wpSelCount");
    const progressWrap = document.getElementById("zipProgressBarWrap");
    const progressLabel = document.getElementById("zipProgressLabel");
    const progressPct = document.getElementById("zipProgressPct");
    const progressFill = document.getElementById("zipProgressFill") as HTMLElement | null;

    // Tabs
    document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.viewTab;
        document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((b) => {
          const on = b === btn;
          b.className = `wp-tab px-3.5 py-2 rounded-md cursor-pointer ${on ? "bg-emerald-500 text-[#04130d] font-extrabold" : "bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold"}`;
        });
        document.querySelectorAll<HTMLElement>(".wp-tab-panel").forEach((p) => {
          p.hidden = p.id !== `tab-${target}`;
        });
      });
    });
    if (location.hash === "#albums") {
      document.querySelector<HTMLButtonElement>('[data-view-tab="albums"]')?.click();
    }

    function setFormat(fmt: "desktop" | "mobile") {
      outputFormat = fmt;
      const isMob = fmt === "mobile";
      if (fmtDesktopBtn && fmtMobileBtn) {
        fmtDesktopBtn.className = `px-3.5 py-2 rounded-md font-bold transition cursor-pointer ${!isMob ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
        fmtMobileBtn.className = `px-3.5 py-2 rounded-md font-bold transition cursor-pointer ${isMob ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
      }
      document.querySelectorAll(".wp-thumb-wrap").forEach((el) => {
        el.classList.toggle("aspect-video", !isMob);
        el.classList.toggle("aspect-[9/16]", isMob);
      });
    }
    fmtDesktopBtn?.addEventListener("click", () => setFormat("desktop"));
    fmtMobileBtn?.addEventListener("click", () => setFormat("mobile"));

    function applyFilters() {
      const brand = brandSelect?.value || "all";
      const q = (searchInput?.value || "").trim().toLowerCase();
      const packIds = activePackFilter ? new Set(packsMeta.find((p) => p.id === activePackFilter)?.itemIds || []) : null;
      document.querySelectorAll<HTMLElement>(".wp-card").forEach((card) => {
        const ok = (brand === "all" || card.dataset.brand === brand) && (!q || (card.dataset.search || "").includes(q)) && (!packIds || packIds.has(card.dataset.id || ""));
        card.style.display = ok ? "" : "none";
      });
    }
    brandSelect?.addEventListener("change", () => { activePackFilter = null; applyFilters(); });
    searchInput?.addEventListener("input", applyFilters);
    document.querySelectorAll<HTMLButtonElement>("[data-pack-filter]").forEach((btn) => {
      btn.addEventListener("click", () => {
        activePackFilter = btn.dataset.packFilter || null;
        if (brandSelect) brandSelect.value = "all";
        applyFilters();
        document.getElementById("galleryHeading")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    function syncSelectionUi() {
      if (selCountEl) selCountEl.textContent = String(selectedIds.size);
      if (dlSelBtn) dlSelBtn.disabled = selectedIds.size === 0;
    }
    document.querySelectorAll<HTMLInputElement>(".wp-chk").forEach((chk) => {
      chk.addEventListener("change", () => {
        if (chk.checked) selectedIds.add(chk.value);
        else selectedIds.delete(chk.value);
        syncSelectionUi();
      });
    });
    clearSelBtn?.addEventListener("click", () => {
      selectedIds.clear();
      document.querySelectorAll<HTMLInputElement>(".wp-chk").forEach((c) => (c.checked = false));
      syncSelectionUi();
    });

    async function loadImage(url: string): Promise<HTMLImageElement> {
      const tryLoad = (src: string) =>
        new Promise<HTMLImageElement>((resolve, reject) => {
          const img = new Image();
          img.crossOrigin = "anonymous";
          img.onload = () => resolve(img);
          img.onerror = () => reject(new Error(`Failed ${src}`));
          img.src = src;
        });
      try {
        return await tryLoad(url);
      } catch {
        return await tryLoad(`${PROXY_BASE}${encodeURIComponent(url)}`);
      }
    }

    async function renderNativeJpgBlob(url: string, fmt: "desktop" | "mobile"): Promise<Blob> {
      const img = await loadImage(url);
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";

      if (fmt === "mobile") {
        const W = 2160, H = 3840;
        canvas.width = W; canvas.height = H;
        const scale = Math.max(W / img.naturalWidth, H / img.naturalHeight);
        const dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
        ctx.drawImage(img, (W - dw) * 0.5, (H - dh) * 0.5, dw, dh);
        const grad = ctx.createLinearGradient(0, 0, 0, H * 0.18);
        grad.addColorStop(0, "rgba(5,7,11,0.55)");
        grad.addColorStop(1, "rgba(5,7,11,0)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H * 0.18);
      } else {
        canvas.width = img.naturalWidth || 1920;
        canvas.height = img.naturalHeight || 1080;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      }

      return await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("toBlob failed"))), "image/jpeg", 0.98);
      });
    }

    function triggerDownload(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 4000);
    }

    async function downloadZipPack(items: typeof allItems, slug: string) {
      if (!items.length) return;
      const zip = new JSZip();
      const suffix = outputFormat === "mobile" ? "Mobile" : "Desktop";
      const zipName = `Muntrume-Wallpapers-${slug}-${suffix}.zip`;
      if (progressWrap) progressWrap.hidden = false;
      const updateProg = (done: number, total: number, text: string) => {
        const pct = Math.round((done / Math.max(1, total)) * 100);
        if (progressLabel) progressLabel.textContent = text;
        if (progressPct) progressPct.textContent = `${pct}%`;
        if (progressFill) progressFill.style.width = `${pct}%`;
      };
      const buildSyncBatContent = (sec: number) => [
        "@echo off",
        "chcp 65001 >nul",
        'reg add "HKCU\\Control Panel\\Desktop" /v WallpaperStyle /t REG_SZ /d 10 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v TileWallpaper /t REG_SZ /d 0 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v JPEGImportQuality /t REG_DWORD /d 100 /f >nul',
        `start "" /min powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command "$dir='%~dp0'; Add-Type -TypeDefinition 'using System.Runtime.InteropServices; public class W { [DllImport(\\"user32.dll\\", CharSet=CharSet.Auto)] public static extern int SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni); }'; while($true){$imgs = Get-ChildItem -Path $dir -Include *.jpg,*.jpeg,*.png -File | Get-Random -Count 999; foreach($img in $imgs){ [W]::SystemParametersInfo(20, 0, $img.FullName, 3) | Out-Null; Start-Sleep -Seconds ${sec} } }"`,
      ].join("\r\n");

      const buildStopBatContent = () => [
        "@echo off",
        "chcp 65001 >nul",
        `powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process -Filter \\"Name='powershell.exe'\\" | Where-Object { $_.CommandLine -like '*SystemParametersInfo*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"`,
      ].join("\r\n");

      zip.file("README_Windows_Slideshow.txt", `MUNTRUME MOTORSPORT WALLPAPERS (.JPG nativo 4K)\r\nIntervalo configurado: ${slideshowSec}s · Sincronizacion simultanea 0 ms entre monitores.\r\n1. Descomprime la carpeta.\r\n2. Ejecuta Sincronizar_Monitores_${slideshowSec}s.bat (sin permisos de administrador, < 5 MB RAM).\r\n3. Para detener la rotacion en cualquier momento, ejecuta Detener_Sync_Wallpapers.bat.`);
      if (outputFormat === "desktop") {
        zip.file(`Sincronizar_Monitores_${slideshowSec}s.bat`, buildSyncBatContent(slideshowSec));
        zip.file("Detener_Sync_Wallpapers.bat", buildStopBatContent());
      }
      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        updateProg(i, items.length, `Convirtiendo ${i + 1}/${items.length} a .JPG estándar (${suffix})...`);
        try {
          const jpgBlob = await renderNativeJpgBlob(item.img, outputFormat);
          zip.file(`Muntrume_${slug}_${String(i + 1).padStart(2, "0")}_${item.cleanFileBase}${outputFormat === "mobile" ? "_9x16_4K" : ""}.jpg`, jpgBlob);
        } catch {}
      }
      updateProg(items.length, items.length, `Comprimiendo ${zipName}...`);
      triggerDownload(await zip.generateAsync({ type: "blob" }), zipName);
      setTimeout(() => { if (progressWrap) progressWrap.hidden = true; }, 1500);
    }

    document.querySelectorAll<HTMLButtonElement>("[data-pack-download]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pack = packsMeta.find((p) => p.id === btn.dataset.packDownload);
        if (!pack) return;
        downloadZipPack(pack.itemIds.map((id) => itemById.get(id)).filter(Boolean) as typeof allItems, pack.slug);
      });
    });

    dlSelBtn?.addEventListener("click", () => {
      downloadZipPack(Array.from(selectedIds).map((id) => itemById.get(id)).filter(Boolean) as typeof allItems, "Seleccion");
    });

    document.getElementById("wpDownloadSyncBatBtn")?.addEventListener("click", () => {
      const bat = [
        "@echo off",
        "chcp 65001 >nul",
        'reg add "HKCU\\Control Panel\\Desktop" /v WallpaperStyle /t REG_SZ /d 10 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v TileWallpaper /t REG_SZ /d 0 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v JPEGImportQuality /t REG_DWORD /d 100 /f >nul',
        `start "" /min powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command "$dir='%~dp0'; Add-Type -TypeDefinition 'using System.Runtime.InteropServices; public class W { [DllImport(\\"user32.dll\\", CharSet=CharSet.Auto)] public static extern int SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni); }'; while($true){$imgs = Get-ChildItem -Path $dir -Include *.jpg,*.jpeg,*.png -File | Get-Random -Count 999; foreach($img in $imgs){ [W]::SystemParametersInfo(20, 0, $img.FullName, 3) | Out-Null; Start-Sleep -Seconds ${slideshowSec} } }"`,
      ].join("\r\n");
      triggerDownload(new Blob([bat], { type: "text/plain;charset=utf-8" }), `Sincronizar_Monitores_${slideshowSec}s.bat`);
    });

    document.getElementById("wpDownloadStopBatBtn")?.addEventListener("click", () => {
      const stopBat = [
        "@echo off",
        "chcp 65001 >nul",
        `powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process -Filter \\"Name='powershell.exe'\\" | Where-Object { $_.CommandLine -like '*SystemParametersInfo*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"`,
      ].join("\r\n");
      triggerDownload(new Blob([stopBat], { type: "text/plain;charset=utf-8" }), "Detener_Sync_Wallpapers.bat");
    });

    const modalEl = document.getElementById("wpModal");
    const modalTitle = document.getElementById("wpModalTitle");
    const modalSub = document.getElementById("wpModalSub");
    const modalMeta = document.getElementById("wpModalMeta");
    const modalCopyUrlBtn = document.getElementById("wpModalCopyUrl");
    const modalImgA = document.getElementById("wpModalImgA") as HTMLImageElement | null;
    const modalImgB = document.getElementById("wpModalImgB") as HTMLImageElement | null;
    const slideProgress = document.getElementById("wpSlideProgress") as HTMLElement | null;
    const slideToggleBtn = document.getElementById("wpSlideToggle");
    const slideCounter = document.getElementById("wpSlideCounter");
    let activeModalItem: (typeof allItems)[number] | null = null;
    let slideItems: (typeof allItems) = [];
    let slideIndex = 0;
    let slidePlaying = false;
    let slideTimer: number | null = null;
    let activeLayerA = true;

    function stopSlideshow() {
      slidePlaying = false;
      if (slideTimer !== null) {
        clearTimeout(slideTimer);
        slideTimer = null;
      }
      if (slideToggleBtn) {
        slideToggleBtn.innerHTML = `▶ Slideshow (<span class="wp-sec-lbl">${slideshowSec}s</span>)`;
      }
      if (slideProgress) {
        slideProgress.style.transition = "none";
        slideProgress.style.width = "0%";
      }
    }

    function showSlideAt(idx: number, animateKenBurns: boolean) {
      if (!slideItems.length || !modalImgA || !modalImgB) return;
      slideIndex = ((idx % slideItems.length) + slideItems.length) % slideItems.length;
      const item = slideItems[slideIndex];
      activeModalItem = item;
      if (modalTitle) modalTitle.textContent = item.model;
      if (modalSub) modalSub.textContent = `${item.carClass} · ${item.circuit}`;
      if (modalMeta) modalMeta.textContent = `${item.carClass} · ${item.model} · ${item.width}×${item.height} (${item.aspectRatio}) · #${item.slugId}`;
      if (slideCounter) slideCounter.textContent = `${slideIndex + 1}/${slideItems.length}`;
      if (item.slugId && window.location.hash !== `#${item.slugId}`) {
        window.history.replaceState(null, "", `#${item.slugId}`);
      }

      const incoming = activeLayerA ? modalImgA : modalImgB;
      const outgoing = activeLayerA ? modalImgB : modalImgA;
      activeLayerA = !activeLayerA;

      incoming.classList.remove("wp-kb-active");
      incoming.style.setProperty("--wp-kb-dur", `${slideshowSec}s`);
      incoming.src = item.img;
      incoming.alt = item.model;

      const reveal = () => {
        if (animateKenBurns) {
          void incoming.offsetWidth;
          incoming.classList.add("wp-kb-active");
        }
        incoming.style.opacity = "1";
        incoming.style.zIndex = "2";
        outgoing.style.opacity = "0";
        outgoing.style.zIndex = "1";
      };

      if (incoming.complete) reveal();
      else incoming.onload = reveal;

      if (slideProgress) {
        slideProgress.style.transition = "none";
        slideProgress.style.width = "0%";
        if (animateKenBurns) {
          void slideProgress.offsetWidth;
          slideProgress.style.transition = `width ${slideshowSec}s linear`;
          slideProgress.style.width = "100%";
        }
      }
    }

    function scheduleNextSlide() {
      if (!slidePlaying) return;
      if (slideTimer !== null) clearTimeout(slideTimer);
      slideTimer = window.setTimeout(() => {
        if (!slidePlaying) return;
        showSlideAt(slideIndex + 1, true);
        scheduleNextSlide();
      }, slideshowSec * 1000);
    }

    function startSlideshow() {
      if (!slideItems.length) return;
      slidePlaying = true;
      if (slideToggleBtn) {
        slideToggleBtn.innerHTML = `⏸ Pausar (<span class="wp-sec-lbl">${slideshowSec}s</span>)`;
      }
      showSlideAt(slideIndex, true);
      scheduleNextSlide();
    }

    function openPreviewModal(items: typeof allItems, startIdx: number, autoPlay: boolean) {
      if (!items.length || !modalEl) return;
      stopSlideshow();
      slideItems = items;
      slideIndex = startIdx;
      modalEl.hidden = false;
      if (autoPlay) startSlideshow();
      else showSlideAt(startIdx, false);
    }

    function closePreviewModal() {
      stopSlideshow();
      if (modalEl) modalEl.hidden = true;
      if (window.location.hash && itemBySlug.has(window.location.hash.slice(1).replace(/^img-/, ""))) {
        window.history.replaceState(null, "", window.location.pathname + window.location.search);
      }
    }

    async function copyShareUrl(slugId: string, btnEl: HTMLElement | null) {
      const shareUrl = `${window.location.origin}/wallpapers#${slugId}`;
      try {
        await navigator.clipboard.writeText(shareUrl);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = shareUrl;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      if (btnEl) {
        const prev = btnEl.textContent;
        btnEl.textContent = "¡Enlace copiado!";
        btnEl.classList.add("border-emerald-400", "text-emerald-300");
        window.setTimeout(() => {
          btnEl.textContent = prev;
          btnEl.classList.remove("border-emerald-400", "text-emerald-300");
        }, 2000);
      }
    }

    document.querySelectorAll<HTMLElement>("[data-preview-id]").forEach((el) => {
      el.addEventListener("click", () => {
        const id = el.dataset.previewId || "";
        const idx = allItems.findIndex((i) => i.id === id);
        if (idx >= 0) openPreviewModal(allItems, idx, false);
      });
    });
    document.querySelectorAll<HTMLButtonElement>("[data-copy-slug]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const slug = btn.dataset.copySlug || "";
        if (slug) copyShareUrl(slug, btn);
      });
    });
    modalCopyUrlBtn?.addEventListener("click", () => {
      if (activeModalItem?.slugId) copyShareUrl(activeModalItem.slugId, modalCopyUrlBtn);
    });

    // Auto-open direct shareable URL hash (#mmt-... or #img-mmt-...) on load
    const initSlug = window.location.hash.replace(/^#/, "").replace(/^img-/, "");
    if (initSlug && itemBySlug.has(initSlug)) {
      const targetItem = itemBySlug.get(initSlug)!;
      const idx = allItems.findIndex((i) => i.id === targetItem.id);
      if (idx >= 0) openPreviewModal(allItems, idx, false);
    }
    document.querySelectorAll<HTMLButtonElement>("[data-pack-slideshow]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pack = packsMeta.find((p) => p.id === btn.dataset.packSlideshow);
        if (!pack) return;
        const items = pack.itemIds.map((id) => itemById.get(id)).filter(Boolean) as typeof allItems;
        openPreviewModal(items, 0, true);
      });
    });
    slideToggleBtn?.addEventListener("click", () => {
      if (slidePlaying) stopSlideshow();
      else startSlideshow();
    });
    document.getElementById("wpSlidePrev")?.addEventListener("click", () => {
      showSlideAt(slideIndex - 1, slidePlaying);
      if (slidePlaying) scheduleNextSlide();
    });
    document.getElementById("wpSlideNext")?.addEventListener("click", () => {
      showSlideAt(slideIndex + 1, slidePlaying);
      if (slidePlaying) scheduleNextSlide();
    });
    document.getElementById("wpModalClose")?.addEventListener("click", closePreviewModal);
    modalEl?.addEventListener("click", (e) => { if (e.target === modalEl) closePreviewModal(); });

    async function downloadSingleItem(item: (typeof allItems)[number], fmt: "desktop" | "mobile") {
      const jpgBlob = await renderNativeJpgBlob(item.img, fmt);
      triggerDownload(jpgBlob, `Muntrume_${item.cleanFileBase}${fmt === "mobile" ? "_9x16_4K" : "_16x9"}.jpg`);
    }
    document.querySelectorAll<HTMLButtonElement>("[data-direct-dl]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = itemById.get(btn.dataset.directDl || "");
        if (item) downloadSingleItem(item, outputFormat);
      });
    });
    document.getElementById("wpModalDownloadDesktop")?.addEventListener("click", () => { if (activeModalItem) downloadSingleItem(activeModalItem, "desktop"); });
    document.getElementById("wpModalDownloadMobile")?.addEventListener("click", () => { if (activeModalItem) downloadSingleItem(activeModalItem, "mobile"); });

    // Submit Modal (cola privada de revisión)
    const subModal = document.getElementById("wpSubmitModal");
    document.getElementById("wpOpenSubmitBtn")?.addEventListener("click", () => { if (subModal) subModal.hidden = false; });
    document.getElementById("wpSubmitClose")?.addEventListener("click", () => { if (subModal) subModal.hidden = true; });
    subModal?.addEventListener("click", (e) => { if (e.target === subModal) subModal.hidden = true; });

    const fileInput = document.getElementById("wpSubFile") as HTMLInputElement | null;
    const fileInfo = document.getElementById("wpSubFileInfo");
    const subStatus = document.getElementById("wpSubmitStatus");
    const subForm = document.getElementById("wpSubmitForm") as HTMLFormElement | null;
    let fileDimsValid = false;
    fileInput?.addEventListener("change", () => {
      fileDimsValid = false;
      const f = fileInput.files?.[0];
      if (!f) return;
      const objUrl = URL.createObjectURL(f);
      const probe = new Image();
      probe.onload = () => {
        URL.revokeObjectURL(objUrl);
        fileDimsValid = probe.naturalWidth >= 1920 && probe.naturalHeight >= 1080;
        if (fileInfo) {
          fileInfo.textContent = fileDimsValid ? `OK: ${probe.naturalWidth}×${probe.naturalHeight} px` : `Insuficiente (${probe.naturalWidth}×${probe.naturalHeight}). Mínimo 1920×1080.`;
          fileInfo.className = `text-[10px] mt-1 ${fileDimsValid ? "text-emerald-400" : "text-rose-400"}`;
        }
      };
      probe.src = objUrl;
    });
    subForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!fileDimsValid) {
        if (subStatus) { subStatus.hidden = false; subStatus.textContent = "Resolución mínima 1920×1080 requerida."; }
        return;
      }
      const resp = await fetch("/api/wallpapers/submit", { method: "POST", body: new FormData(subForm) }).catch(() => null);
      const data = resp ? await resp.json().catch(() => ({})) : { error: "Error de red." };
      if (subStatus) {
        subStatus.hidden = false;
        subStatus.textContent = resp?.ok && data.ok ? data.message : (data.error || "Error enviando.");
      }
    });
  </script>
</Layout>
