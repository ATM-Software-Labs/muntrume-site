---
import Layout from "../layouts/Layout.astro";
import { absoluteWallpaperUrl, getWallpaperCatalog } from "../lib/wallpaper-catalog";

const catalog = await getWallpaperCatalog();
const allWallpapers = catalog.items;
const seriesGroups = catalog.series;
const apiAlbums = catalog.albums;

const carMap = new Map<string, typeof allWallpapers>();
for (const item of allWallpapers) {
  const key = item.model;
  const arr = carMap.get(key) || [];
  arr.push(item);
  carMap.set(key, arr);
}
const carPacks = [...carMap.entries()]
  .map(([model, items]) => ({
    id: `car-${items[0].carSlug}`,
    slug: items[0].cleanFileBase,
    title: model,
    badge: items[0].carClass,
    accent: items[0].accentColor,
    seriesOrder: Math.min(...items.map((item) => item.seriesOrder)),
    items,
  }))
  .sort((a, b) => a.seriesOrder - b.seriesOrder || a.title.localeCompare(b.title, "es"));

const packs = [
  ...seriesGroups.map((group) => ({
    id: group.id,
    slug: group.slug,
    title: group.name,
    itemIds: group.items.map((item) => item.id),
  })),
  ...carPacks.map((pack) => ({
    id: pack.id,
    slug: pack.slug,
    title: pack.title,
    itemIds: pack.items.map((item) => item.id),
  })),
  ...apiAlbums.map((album) => ({
    id: `album-${album.slug}`,
    slug: album.slug,
    title: album.title,
    itemIds: album.items.map((item) => item.id),
  })),
  {
    id: "all",
    slug: "Muntrume",
    title: "Todos los wallpapers",
    itemIds: allWallpapers.map((item) => item.id),
  },
];

const brandsList = [...new Set(allWallpapers.map((item) => item.brand).filter(Boolean))].sort((a, b) => a.localeCompare(b, "es"));
const pageTitle = "iRacing Wallpapers by Series (16:9 & Mobile)";
const pageDescription = `Download ${allWallpapers.length} high-resolution iRacing wallpapers grouped by official series, available in 16:9 desktop and 9:16 mobile formats. MMT Team.`;
const pageUrl = "https://muntru.me/wallpapers/";
const ogImage = absoluteWallpaperUrl(allWallpapers[0]?.img || "/assets/img/coche2.webp");
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: "es",
      hasPart: seriesGroups.map((group) => ({
        "@type": "ImageGallery",
        name: group.name,
        url: `https://muntru.me/wallpapers/${group.slug}/`,
      })),
    },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl} ogImage={ogImage} ogImageAlt={allWallpapers[0]?.alt || pageTitle} schemaJson={pageSchema}>
  <main class="min-h-screen bg-[var(--r-bg)] text-[var(--r-text)] py-10 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto space-y-8">
      <!-- HERO + FORMAT SWITCHER -->
      <header class="border-b border-[var(--r-line)] pb-6 flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="space-y-2.5">
          <div class="font-mono text-[11px] uppercase tracking-widest text-[var(--r-accent)] font-bold">
            Muntrume Motorsport · {allWallpapers.length} wallpapers · {seriesGroups.length} grupos
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight text-[var(--r-text)]">
            Wallpapers en pista, serie por serie
          </h1>
          <p class="text-xs sm:text-sm text-[var(--r-muted)] max-w-2xl font-mono leading-relaxed">
            Solo media oficial de iRacing y las capturas en pista del manifiesto. JPG en el navegador para Windows (16:9) y móvil (<span class="text-[var(--r-text)] font-semibold">2160×3840</span>).
          </p>
        </div>

        <div class="flex flex-col items-start lg:items-end gap-2.5">
          <button
            type="button"
            id="wpOpenSubmitBtn"
            class="px-3.5 py-2 rounded-lg border border-emerald-500/45 bg-emerald-500/10 hover:bg-emerald-500/20 text-[var(--r-accent)] font-mono text-xs font-extrabold tracking-wide transition cursor-pointer"
          >
            + Subir / Sugerir Wallpaper
          </button>
          <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--r-muted)]">Formato de salida (.JPG nativo)</span>
          <div class="inline-flex flex-wrap p-1 rounded-lg bg-[var(--r-surface)] border border-[var(--r-line)] font-mono text-xs max-w-full" role="group">
            <button type="button" id="fmtDesktopBtn" class="px-3.5 py-2 rounded-md font-bold bg-emerald-500 text-[#04130d] transition cursor-pointer" aria-pressed="true">
              Escritorio · 16:9 (.JPG)
            </button>
            <button type="button" id="fmtMobileBtn" class="px-3.5 py-2 rounded-md font-bold text-[var(--r-muted)] hover:text-[var(--r-text)] transition cursor-pointer" aria-pressed="false">
              Móvil · 9:16 (2160×3840 4K)
            </button>
          </div>
        </div>
      </header>

      <!-- PROGRESS BAR -->
      <section id="zipProgressBarWrap" hidden class="rounded-lg border border-emerald-500/40 bg-[#0d1118] p-4 space-y-2 font-mono">
        <div class="flex items-center justify-between text-xs">
          <span id="zipProgressLabel" class="text-emerald-400 font-bold">Convirtiendo a .JPG...</span>
          <span id="zipProgressPct" class="tabular-nums text-white font-bold">0%</span>
        </div>
        <div class="w-full h-2 rounded-full bg-black/60 overflow-hidden border border-white/10">
          <div id="zipProgressFill" class="h-full bg-emerald-500 transition-all duration-150" style="width:0%"></div>
        </div>
      </section>

      <!-- SECTION TABS + WINDOWS SLIDESHOW INTERVAL -->
      <div class="flex flex-wrap items-center justify-between gap-3 font-mono text-xs border-b border-white/10 pb-3">
        <div class="flex flex-wrap items-center gap-2">
          <button type="button" data-view-tab="categories" class="wp-tab px-3.5 py-2 rounded-md bg-emerald-500 text-[#04130d] font-extrabold cursor-pointer">
            Por serie ({seriesGroups.length})
          </button>
          <button type="button" data-view-tab="cars" class="wp-tab px-3.5 py-2 rounded-md bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold cursor-pointer">
            Por Coche ({carPacks.length})
          </button>
          <button type="button" data-view-tab="albums" class="wp-tab px-3.5 py-2 rounded-md bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold cursor-pointer">
            Álbumes / Eventos ({apiAlbums.length})
          </button>
        </div>

        <div class="flex items-center gap-2 bg-[#0d1118] border border-white/10 rounded-lg px-2.5 py-1.5">
          <span class="text-[10px] uppercase tracking-wider text-slate-400">Slideshow Windows:</span>
          <div class="inline-flex items-center gap-1" id="wpIntervalGroup" role="group" aria-label="Intervalo de slideshow">
            <button type="button" data-interval-sec="15" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-bold text-slate-300 hover:text-white cursor-pointer" aria-pressed="false">15s</button>
            <button type="button" data-interval-sec="20" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-extrabold bg-emerald-500 text-[#04130d] cursor-pointer" aria-pressed="true">20s</button>
            <button type="button" data-interval-sec="30" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-bold text-slate-300 hover:text-white cursor-pointer" aria-pressed="false">30s</button>
            <button type="button" data-interval-sec="60" class="wp-int-btn px-2 py-0.5 rounded text-[11px] font-bold text-slate-300 hover:text-white cursor-pointer" aria-pressed="false">60s</button>
          </div>
        </div>
      </div>

      <!-- MULTI-MONITOR ZERO-DELAY SYNC GUIDE + QUICK DOWNLOAD -->
      <div class="rounded-lg border border-emerald-500/25 bg-[#0d1118]/90 px-4 py-3 flex flex-col lg:flex-row lg:items-center justify-between gap-3 font-mono text-xs">
        <div class="space-y-1">
          <p class="text-emerald-300 font-bold">⚡ Sincronización Exacta Multi-Monitor Windows (0 ms de desfase · Sin Admin HKCU)</p>
          <p class="text-[11px] text-slate-300 leading-relaxed">
            El modo <em>Presentación</em> nativo de Windows cambia cada monitor por separado con desfase. Nuestro script <code class="text-emerald-300">Sincronizar_Monitores_<span class="wp-sec-lbl">20s</span>.bat</code> usa <code class="text-white/90">SystemParametersInfo</code> (<code class="text-white/90">user32.dll</code>) en segundo plano (&lt; 5 MB RAM) con <code class="text-white/90">JPEGImportQuality = 100</code> para aplicar la misma imagen 4K simultáneamente en todas las pantallas.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <button type="button" id="wpDownloadSyncBatBtn" class="px-3 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold text-[11px] transition cursor-pointer">
            ⬇ Sincronizar_Monitores_<span class="wp-sec-lbl">20s</span>.bat
          </button>
          <button type="button" id="wpDownloadStopBatBtn" class="px-3 py-1.5 rounded border border-white/15 hover:border-rose-400/60 text-slate-200 hover:text-rose-300 font-bold text-[11px] transition cursor-pointer">
            ⏹ Detener_Sync_Wallpapers.bat
          </button>
        </div>
      </div>

      <nav id="tab-categories" class="wp-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2" aria-label="Series">
        {seriesGroups.map((group) => (
          <div class="rounded-lg border border-white/10 bg-[#0d1118] px-3 py-2.5 flex flex-col gap-2">
            <div class="flex items-start justify-between gap-2">
              <a href={`/wallpapers/${group.slug}/`} class="text-sm font-extrabold text-white hover:text-emerald-300">{group.name}</a>
              <span class="font-mono text-[10px] text-slate-400 tabular-nums shrink-0">{group.items.length}</span>
            </div>
            <p class="font-mono text-[10px] uppercase tracking-wider text-slate-500">{group.kind === "series" ? "Serie del calendario" : "Categoría del archivo"}</p>
            <div class="flex flex-wrap gap-1.5 font-mono text-[11px]">
              <button type="button" data-pack-download={group.id} class="px-2 py-1 rounded bg-emerald-500 text-[#04130d] font-extrabold cursor-pointer">.ZIP</button>
              <button type="button" data-pack-slideshow={group.id} class="px-2 py-1 rounded border border-emerald-500/40 text-emerald-300 cursor-pointer">Slideshow</button>
              <button type="button" data-pack-filter={group.id} class="px-2 py-1 rounded border border-white/15 text-slate-200 cursor-pointer">Ver aquí</button>
            </div>
          </div>
        ))}
      </nav>

      <!-- TAB 2: CAR PACKS -->
      <section id="tab-cars" hidden class="wp-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
        {carPacks.map((pack) => {
          const thumbs = pack.items.slice(0, 1);
          const gridCols = thumbs.length === 1 ? "grid-cols-1" : thumbs.length === 3 ? "grid-cols-3" : "grid-cols-2";
          return (
            <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
              <div class={`grid ${gridCols} gap-0.5 bg-[var(--r-bg-2)] p-1`}>
                {thumbs.map((t) => (
                  <div class="aspect-video bg-[var(--r-bg-2)] overflow-hidden rounded-[2px]">
                    <img src={t.img} alt={t.model} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.closest('article')?.remove()" class="w-full h-full object-cover object-center" />
                  </div>
                ))}
              </div>
              <div class="p-3 space-y-2 flex-1 flex flex-col justify-between font-mono">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[9.5px] font-extrabold px-1.5 py-0.5 rounded border border-white/10" style={`color:${pack.accent}`}>{pack.badge}</span>
                  <span class="text-[10px] text-slate-400 tabular-nums">{pack.items.length} fotos</span>
                </div>
                <h3 class="text-xs font-extrabold text-white truncate">{pack.title}</h3>
                <div class="flex items-center gap-1.5 pt-1 text-[11px]">
                  <button type="button" data-pack-download={pack.id} class="flex-1 px-2.5 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">
                    .ZIP (.JPG)
                  </button>
                  <button type="button" data-pack-slideshow={pack.id} class="px-2 py-1.5 rounded border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 font-bold cursor-pointer" title="Previsualizar Slideshow">
                    ▶
                  </button>
                  <button type="button" data-pack-filter={pack.id} class="px-2.5 py-1.5 rounded border border-white/15 text-slate-200 cursor-pointer">
                    Ver
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </section>

      <!-- TAB 3: ALBUMS -->
      <section id="tab-albums" hidden class="wp-tab-panel grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {apiAlbums.map((alb) => (
          <article class="rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col justify-between hover:border-white/25 transition">
            <div class="aspect-video bg-[#090b0f] overflow-hidden">
              <img src={alb.cover} alt={alb.title} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 space-y-2.5 font-mono">
              <div class="flex items-center justify-between text-[10px]">
                <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-bold">{alb.carClass}</span>
                <span class="text-slate-400 tabular-nums">{alb.count} fotos reales</span>
              </div>
              <h3 class="text-sm font-extrabold text-white truncate">{alb.title}</h3>
              <button type="button" data-pack-download={`album-${alb.slug}`} class="w-full py-2 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold text-xs cursor-pointer">
                Descargar Álbum .ZIP (.JPG)
              </button>
            </div>
          </article>
        ))}
      </section>

      <!-- GALLERY + INDIVIDUAL SELECTION -->
      <section aria-labelledby="galleryHeading" class="space-y-4 pt-4 border-t border-white/10">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
          <div>
            <h2 id="galleryHeading" class="font-mono text-xs uppercase tracking-widest text-slate-300 font-bold">
              Wallpapers por serie ({allWallpapers.length})
            </h2>
            <p class="text-xs text-slate-400 font-mono mt-0.5">
              Descarga individual en .JPG o marca varias capturas para crear tu propio .ZIP.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            <select id="wpBrandFilter" class="bg-[#0d1118] border border-white/15 rounded px-2.5 py-1.5 text-slate-200 outline-none">
              <option value="all">Todas las marcas ({allWallpapers.length})</option>
              {brandsList.map((brand) => <option value={brand}>{brand}</option>)}
            </select>
            <input id="wpSearchInput" type="search" placeholder="Buscar coche o circuito..." class="bg-[#0d1118] border border-white/15 rounded px-3 py-1.5 text-slate-100 placeholder-slate-500 outline-none w-full sm:w-52 max-w-full" />
            <button type="button" id="wpClearSelBtn" class="px-2.5 py-1.5 rounded border border-white/15 text-slate-400 hover:text-white cursor-pointer">Limpiar</button>
            <button type="button" id="wpDownloadSelBtn" disabled class="px-3.5 py-1.5 rounded bg-emerald-500 disabled:bg-white/10 disabled:text-slate-500 text-[#04130d] font-extrabold cursor-pointer tabular-nums">
              Descargar Selección (<span id="wpSelCount">0</span>)
            </button>
          </div>
        </div>

        <div id="wpGrid" class="space-y-8">
          {seriesGroups.map((group) => (
            <section class="wp-series space-y-3" data-series={group.id}>
              <div class="flex items-end justify-between gap-3 border-b border-white/10 pb-2">
                <h3 id={`serie-${group.slug}`} class="text-lg font-extrabold text-white">
                  <a href={`/wallpapers/${group.slug}/`} class="hover:text-emerald-300">{group.name}</a>
                </h3>
                <span class="font-mono text-[11px] text-slate-400 tabular-nums">{group.items.length}</span>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {group.items.map((w) => (
                  <article class="wp-card group rounded-lg border border-white/10 bg-[#0d1118] overflow-hidden flex flex-col hover:border-emerald-500/40 transition" data-id={w.id} data-brand={w.brand} data-search={`${w.brand} ${w.model} ${w.title} ${w.seriesName} ${w.carClass} ${w.circuit}`.toLowerCase()}>
                    <div class="wp-thumb-wrap relative aspect-video bg-[#090b0f] overflow-hidden">
                      <img src={w.img} alt={w.alt} width="640" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover" />
                      <label class="absolute top-2 left-2 z-10 inline-flex items-center gap-1.5 px-2 py-1 rounded bg-black/75 border border-white/15 text-[10px] font-mono text-white cursor-pointer select-none">
                        <input type="checkbox" class="wp-chk accent-emerald-500" value={w.id} />
                        <span>Elegir</span>
                      </label>
                      <button type="button" data-preview-id={w.id} class="absolute bottom-2 left-2 px-2 py-1 rounded bg-black/80 border border-white/15 text-[10px] font-mono text-slate-200 font-bold cursor-pointer">
                        Vista Previa
                      </button>
                      <button type="button" data-direct-dl={w.id} class="absolute bottom-2 right-2 px-2.5 py-1 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] text-[10px] font-mono font-extrabold cursor-pointer shadow">
                        .JPG
                      </button>
                    </div>
                    <div class="p-3 font-mono">
                      <div class="text-xs font-bold text-white">{w.title || w.model}</div>
                      <div class="text-[10px] text-slate-400">{w.model}{w.circuit ? ` · ${w.circuit}` : ""}</div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    </div>

    <!-- PREVIEW & SLIDESHOW MODAL (Crossfade + Ken Burns GPU) -->
    <div id="wpModal" hidden class="fixed inset-0 z-50 bg-black/92 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true">
      <div class="w-full max-w-5xl rounded-xl border border-white/15 bg-[#0d1118] overflow-hidden shadow-2xl">
        <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-white/10 font-mono">
          <div class="min-w-0">
            <h3 id="wpModalTitle" class="text-sm font-bold text-white truncate"></h3>
            <p id="wpModalSub" class="text-[11px] text-slate-400 truncate"></p>
          </div>
          <div class="flex items-center gap-2 shrink-0 text-xs">
            <button type="button" id="wpSlidePrev" class="px-2 py-1 rounded border border-white/15 text-slate-300 hover:text-white cursor-pointer" aria-label="Anterior">‹</button>
            <button type="button" id="wpSlideToggle" class="px-2.5 py-1 rounded border border-emerald-500/45 bg-emerald-500/15 text-emerald-300 font-bold cursor-pointer">
              ▶ Slideshow (<span class="wp-sec-lbl">20s</span>)
            </button>
            <button type="button" id="wpSlideNext" class="px-2 py-1 rounded border border-white/15 text-slate-300 hover:text-white cursor-pointer" aria-label="Siguiente">›</button>
            <span id="wpSlideCounter" class="text-[11px] text-slate-400 tabular-nums px-1">1/1</span>
            <button type="button" id="wpModalClose" class="px-2.5 py-1 rounded border border-white/15 text-slate-300 hover:text-white cursor-pointer">Cerrar ✕</button>
          </div>
        </div>
        <div class="relative w-full aspect-video max-h-[68vh] bg-[#05070b] overflow-hidden flex items-center justify-center">
          <img id="wpModalImgA" src="" alt="" referrerpolicy="no-referrer" class="wp-kb-layer absolute inset-0 w-full h-full object-cover opacity-0" />
          <img id="wpModalImgB" src="" alt="" referrerpolicy="no-referrer" class="wp-kb-layer absolute inset-0 w-full h-full object-cover opacity-0" />
          <div class="absolute inset-x-0 bottom-0 h-[3px] bg-white/10 z-20 pointer-events-none">
            <div id="wpSlideProgress" class="h-full bg-emerald-500 origin-left" style="width: 0%;"></div>
          </div>
        </div>
        <div class="px-4 py-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
          <span class="text-slate-400">Transición Crossfade 900ms + Ken Burns (GPU) · Exportado a .JPG estándar para Windows/Móvil.</span>
          <div class="flex items-center gap-2">
            <button type="button" id="wpModalDownloadDesktop" class="px-3.5 py-2 rounded border border-white/20 hover:border-emerald-500 text-white font-bold cursor-pointer">Descargar 16:9 (.JPG)</button>
            <button type="button" id="wpModalDownloadMobile" class="px-3.5 py-2 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">Descargar Foto Móvil (9:16 4K .JPG)</button>
          </div>
        </div>
      </div>

      <!-- MULTI-MONITOR ZERO-DELAY SYNC GUIDE + QUICK DOWNLOAD -->
      <div class="rounded-lg border border-emerald-500/25 bg-[#0d1118]/90 px-4 py-3 flex flex-col lg:flex-row lg:items-center justify-between gap-3 font-mono text-xs">
        <div class="space-y-1">
          <p class="text-emerald-300 font-bold">⚡ Sincronización Exacta Multi-Monitor Windows (0 ms de desfase · Sin Admin HKCU)</p>
          <p class="text-[11px] text-slate-300 leading-relaxed">
            El modo <em>Presentación</em> nativo de Windows cambia cada monitor por separado con desfase. Nuestro script <code class="text-emerald-300">Sincronizar_Monitores_<span class="wp-sec-lbl">20s</span>.bat</code> usa <code class="text-white/90">SystemParametersInfo</code> (<code class="text-white/90">user32.dll</code>) en segundo plano (&lt; 5 MB RAM) con <code class="text-white/90">JPEGImportQuality = 100</code> para aplicar la misma imagen 4K simultáneamente en todas las pantallas.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <button type="button" id="wpDownloadSyncBatBtn" class="px-3 py-1.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold text-[11px] transition cursor-pointer">
            ⬇ Sincronizar_Monitores_<span class="wp-sec-lbl">20s</span>.bat
          </button>
          <button type="button" id="wpDownloadStopBatBtn" class="px-3 py-1.5 rounded border border-white/15 hover:border-rose-400/60 text-slate-200 hover:text-rose-300 font-bold text-[11px] transition cursor-pointer">
            ⏹ Detener_Sync_Wallpapers.bat
          </button>
        </div>
      </div>
    </div>

    <style>
      .wp-kb-layer {
        transition: opacity 900ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: transform, opacity;
        transform: scale(1);
      }
      @keyframes wpKenBurns {
        0% { transform: scale(1) translate3d(0, 0, 0); }
        100% { transform: scale(1.04) translate3d(-0.6%, -0.4%, 0); }
      }
      .wp-kb-active {
        animation: wpKenBurns var(--wp-kb-dur, 20s) linear forwards;
      }
    </style>

    <!-- SUBMIT / SUGGEST MODAL -->
    <div id="wpSubmitModal" hidden class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true">
      <div class="w-full max-w-lg rounded-xl border border-white/15 bg-[#0d1118] overflow-hidden shadow-2xl font-mono">
        <div class="flex items-center justify-between px-4 py-3 border-b border-white/10">
          <div>
            <h3 class="text-sm font-extrabold text-white">Subir / Sugerir Wallpaper</h3>
            <p class="text-[10px] text-slate-400">Solo capturas en pista (mín. 1920×1080 · JPG, PNG o WebP)</p>
          </div>
          <button type="button" id="wpSubmitClose" class="px-2.5 py-1 rounded border border-white/15 text-xs text-slate-300 hover:text-white cursor-pointer">Cerrar ✕</button>
        </div>
        <form id="wpSubmitForm" class="p-4 space-y-3 text-xs">
          <div class="grid grid-cols-2 gap-1.5 p-1 rounded-lg bg-[#090b0f] border border-white/10">
            <button type="button" id="wpModeCommunityBtn" class="py-1.5 rounded font-bold bg-emerald-500 text-[#04130d] cursor-pointer">Comunidad (Sugerir)</button>
            <button type="button" id="wpModeTeamBtn" class="py-1.5 rounded font-bold text-slate-300 hover:text-white cursor-pointer">Equipo MMT (Directo)</button>
          </div>
          <input type="hidden" id="wpSubmitMode" name="mode" value="community" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubCar">Coche</label><input id="wpSubCar" name="car" required placeholder="ej. Ford Mustang GT3" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
            <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubTrack">Circuito</label><input id="wpSubTrack" name="track" required placeholder="ej. Spa-Francorchamps" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <div>
              <label class="block text-[10px] text-slate-400 mb-1" for="wpSubCategory">Categoría</label>
              <select id="wpSubCategory" name="category" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white">
                <option value="GT3 2026">GT3 2026</option><option value="GTP">GTP / Hypercar</option><option value="LMP2">LMP2 &amp; Prototipos</option><option value="PCup">Porsche Cup</option><option value="Fórmulas">Fórmulas</option><option value="Equipo MMT">Equipo MMT</option>
              </select>
            </div>
            <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubAuthor">Piloto (iRacing / Discord)</label><input id="wpSubAuthor" name="author" required placeholder="ej. A. Trujillo" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
          </div>
          <div id="wpTeamTokenWrap" hidden><label class="block text-[10px] text-slate-400 mb-1" for="wpSubToken">Token de Equipo</label><input id="wpSubToken" name="teamToken" type="password" class="w-full bg-[#090b0f] border border-white/15 rounded px-2.5 py-1.5 text-white" /></div>
          <div><label class="block text-[10px] text-slate-400 mb-1" for="wpSubFile">Captura (mín. 1920×1080)</label><input id="wpSubFile" name="file" type="file" accept="image/jpeg,image/png,image/webp" required class="w-full bg-[#090b0f] border border-dashed border-white/25 rounded p-2.5 text-slate-300" /><p id="wpSubFileInfo" class="text-[10px] text-slate-400 mt-1"></p></div>
          <p id="wpSubmitStatus" hidden class="p-2.5 rounded border text-[11px]"></p>
          <button type="submit" id="wpSubmitSendBtn" class="w-full py-2.5 rounded bg-emerald-500 hover:bg-emerald-400 text-[#04130d] font-extrabold cursor-pointer">Enviar Captura</button>
        </form>
      </div>
    </div>
  </main>

  <script
    type="application/json"
    id="wpCatalogData"
    set:html={JSON.stringify({
      allWallpapers,
      packs,
    })}
  ></script>

  <script>
    import JSZip from "jszip";

    const PROXY_BASE = "https://muntrume.atrumin16.workers.dev/api/media/proxy?url=";
    const payload = JSON.parse(document.getElementById("wpCatalogData")?.textContent || "{}");
    const allItems: Array<{ id: string; brand: string; model: string; carClass: string; circuit: string; img: string; cleanFileBase: string }> = payload.allWallpapers || [];
    const packsMeta: Array<{ id: string; slug: string; title: string; itemIds: string[] }> = payload.packs || [];
    const itemById = new Map(allItems.map((i) => [i.id, i]));

    let outputFormat: "desktop" | "mobile" = "desktop";
    let slideshowSec = 20;
    let activePackFilter: string | null = null;
    const selectedIds = new Set<string>();

    document.querySelectorAll<HTMLButtonElement>(".wp-int-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const sec = Number(btn.dataset.intervalSec || "20");
        slideshowSec = Number.isFinite(sec) && sec > 0 ? sec : 20;
        document.querySelectorAll<HTMLButtonElement>(".wp-int-btn").forEach((b) => {
          const on = b === btn;
          b.setAttribute("aria-pressed", String(on));
          b.className = `wp-int-btn px-2 py-0.5 rounded text-[11px] cursor-pointer ${on ? "font-extrabold bg-emerald-500 text-[#04130d]" : "font-bold text-slate-300 hover:text-white"}`;
        });
        document.querySelectorAll(".wp-sec-lbl").forEach((el) => {
          el.textContent = `${slideshowSec}s`;
        });
        document.documentElement.style.setProperty("--wp-kb-dur", `${slideshowSec}s`);
      });
    });

    const fmtDesktopBtn = document.getElementById("fmtDesktopBtn") as HTMLButtonElement | null;
    const fmtMobileBtn = document.getElementById("fmtMobileBtn") as HTMLButtonElement | null;
    const brandSelect = document.getElementById("wpBrandFilter") as HTMLSelectElement | null;
    const searchInput = document.getElementById("wpSearchInput") as HTMLInputElement | null;
    const clearSelBtn = document.getElementById("wpClearSelBtn") as HTMLButtonElement | null;
    const dlSelBtn = document.getElementById("wpDownloadSelBtn") as HTMLButtonElement | null;
    const selCountEl = document.getElementById("wpSelCount");
    const progressWrap = document.getElementById("zipProgressBarWrap");
    const progressLabel = document.getElementById("zipProgressLabel");
    const progressPct = document.getElementById("zipProgressPct");
    const progressFill = document.getElementById("zipProgressFill") as HTMLElement | null;

    // Tabs
    document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.viewTab;
        document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((b) => {
          const on = b === btn;
          b.className = `wp-tab px-3.5 py-2 rounded-md cursor-pointer ${on ? "bg-emerald-500 text-[#04130d] font-extrabold" : "bg-[#0d1118] border border-white/10 text-slate-300 hover:text-white font-bold"}`;
        });
        document.querySelectorAll<HTMLElement>(".wp-tab-panel").forEach((p) => {
          p.hidden = p.id !== `tab-${target}`;
        });
      });
    });
    if (location.hash === "#albums") {
      document.querySelector<HTMLButtonElement>('[data-view-tab="albums"]')?.click();
    }

    function setFormat(fmt: "desktop" | "mobile") {
      outputFormat = fmt;
      const isMob = fmt === "mobile";
      if (fmtDesktopBtn && fmtMobileBtn) {
        fmtDesktopBtn.className = `px-3.5 py-2 rounded-md font-bold transition cursor-pointer ${!isMob ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
        fmtMobileBtn.className = `px-3.5 py-2 rounded-md font-bold transition cursor-pointer ${isMob ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
      }
      document.querySelectorAll(".wp-thumb-wrap").forEach((el) => {
        el.classList.toggle("aspect-video", !isMob);
        el.classList.toggle("aspect-[9/16]", isMob);
      });
    }
    fmtDesktopBtn?.addEventListener("click", () => setFormat("desktop"));
    fmtMobileBtn?.addEventListener("click", () => setFormat("mobile"));

    function applyFilters() {
      const brand = brandSelect?.value || "all";
      const q = (searchInput?.value || "").trim().toLowerCase();
      const packIds = activePackFilter ? new Set(packsMeta.find((p) => p.id === activePackFilter)?.itemIds || []) : null;
      document.querySelectorAll<HTMLElement>(".wp-card").forEach((card) => {
        const ok = (brand === "all" || card.dataset.brand === brand) && (!q || (card.dataset.search || "").includes(q)) && (!packIds || packIds.has(card.dataset.id || ""));
        card.style.display = ok ? "" : "none";
      });
      document.querySelectorAll<HTMLElement>(".wp-series").forEach((section) => {
        const visible = [...section.querySelectorAll<HTMLElement>(".wp-card")].some((card) => card.style.display !== "none");
        section.hidden = !visible;
      });
    }
    brandSelect?.addEventListener("change", () => { activePackFilter = null; applyFilters(); });
    searchInput?.addEventListener("input", applyFilters);
    document.querySelectorAll<HTMLButtonElement>("[data-pack-filter]").forEach((btn) => {
      btn.addEventListener("click", () => {
        activePackFilter = btn.dataset.packFilter || null;
        if (brandSelect) brandSelect.value = "all";
        applyFilters();
        document.getElementById("galleryHeading")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    function syncSelectionUi() {
      if (selCountEl) selCountEl.textContent = String(selectedIds.size);
      if (dlSelBtn) dlSelBtn.disabled = selectedIds.size === 0;
    }
    document.querySelectorAll<HTMLInputElement>(".wp-chk").forEach((chk) => {
      chk.addEventListener("change", () => {
        if (chk.checked) selectedIds.add(chk.value);
        else selectedIds.delete(chk.value);
        syncSelectionUi();
      });
    });
    clearSelBtn?.addEventListener("click", () => {
      selectedIds.clear();
      document.querySelectorAll<HTMLInputElement>(".wp-chk").forEach((c) => (c.checked = false));
      syncSelectionUi();
    });

    async function loadImage(url: string): Promise<HTMLImageElement> {
      const tryLoad = (src: string) =>
        new Promise<HTMLImageElement>((resolve, reject) => {
          const img = new Image();
          img.crossOrigin = "anonymous";
          img.onload = () => resolve(img);
          img.onerror = () => reject(new Error(`Failed ${src}`));
          img.src = src;
        });
      try {
        return await tryLoad(url);
      } catch {
        return await tryLoad(`${PROXY_BASE}${encodeURIComponent(url)}`);
      }
    }

    async function renderNativeJpgBlob(url: string, fmt: "desktop" | "mobile"): Promise<Blob> {
      const img = await loadImage(url);
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d")!;
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";

      if (fmt === "mobile") {
        const W = 2160, H = 3840;
        canvas.width = W; canvas.height = H;
        const scale = Math.max(W / img.naturalWidth, H / img.naturalHeight);
        const dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
        ctx.drawImage(img, (W - dw) * 0.5, (H - dh) * 0.5, dw, dh);
        const grad = ctx.createLinearGradient(0, 0, 0, H * 0.18);
        grad.addColorStop(0, "rgba(5,7,11,0.55)");
        grad.addColorStop(1, "rgba(5,7,11,0)");
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, W, H * 0.18);
      } else {
        canvas.width = img.naturalWidth || 1920;
        canvas.height = img.naturalHeight || 1080;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      }

      return await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("toBlob failed"))), "image/jpeg", 0.96);
      });
    }

    function triggerDownload(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 4000);
    }

    async function downloadZipPack(items: typeof allItems, slug: string) {
      if (!items.length) return;
      const zip = new JSZip();
      const suffix = outputFormat === "mobile" ? "Mobile" : "Desktop";
      const zipName = `Muntrume-Wallpapers-${slug}-${suffix}.zip`;
      if (progressWrap) progressWrap.hidden = false;
      const updateProg = (done: number, total: number, text: string) => {
        const pct = Math.round((done / Math.max(1, total)) * 100);
        if (progressLabel) progressLabel.textContent = text;
        if (progressPct) progressPct.textContent = `${pct}%`;
        if (progressFill) progressFill.style.width = `${pct}%`;
      };
      const buildSyncBatContent = (sec: number) => [
        "@echo off",
        "chcp 65001 >nul",
        'reg add "HKCU\\Control Panel\\Desktop" /v WallpaperStyle /t REG_SZ /d 10 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v TileWallpaper /t REG_SZ /d 0 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v JPEGImportQuality /t REG_DWORD /d 100 /f >nul',
        `start "" /min powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command "$dir='%~dp0'; Add-Type -TypeDefinition 'using System.Runtime.InteropServices; public class W { [DllImport(\\"user32.dll\\", CharSet=CharSet.Auto)] public static extern int SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni); }'; while($true){$imgs = Get-ChildItem -Path $dir -Include *.jpg,*.jpeg,*.png -File | Get-Random -Count 999; foreach($img in $imgs){ [W]::SystemParametersInfo(20, 0, $img.FullName, 3) | Out-Null; Start-Sleep -Seconds ${sec} } }"`,
      ].join("\r\n");

      const buildStopBatContent = () => [
        "@echo off",
        "chcp 65001 >nul",
        `powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process -Filter \\"Name='powershell.exe'\\" | Where-Object { $_.CommandLine -like '*SystemParametersInfo*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"`,
      ].join("\r\n");

      zip.file("README_Windows_Slideshow.txt", `MUNTRUME MOTORSPORT WALLPAPERS (.JPG nativo 4K)\r\nIntervalo configurado: ${slideshowSec}s · Sincronizacion simultanea 0 ms entre monitores.\r\n1. Descomprime la carpeta.\r\n2. Ejecuta Sincronizar_Monitores_${slideshowSec}s.bat (sin permisos de administrador, < 5 MB RAM).\r\n3. Para detener la rotacion en cualquier momento, ejecuta Detener_Sync_Wallpapers.bat.`);
      if (outputFormat === "desktop") {
        zip.file(`Sincronizar_Monitores_${slideshowSec}s.bat`, buildSyncBatContent(slideshowSec));
        zip.file("Detener_Sync_Wallpapers.bat", buildStopBatContent());
      }
      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        updateProg(i, items.length, `Convirtiendo ${i + 1}/${items.length} a .JPG estándar (${suffix})...`);
        try {
          const jpgBlob = await renderNativeJpgBlob(item.img, outputFormat);
          zip.file(`Muntrume_${slug}_${String(i + 1).padStart(2, "0")}_${item.cleanFileBase}${outputFormat === "mobile" ? "_9x16_4K" : ""}.jpg`, jpgBlob);
        } catch {}
      }
      updateProg(items.length, items.length, `Comprimiendo ${zipName}...`);
      triggerDownload(await zip.generateAsync({ type: "blob" }), zipName);
      setTimeout(() => { if (progressWrap) progressWrap.hidden = true; }, 1500);
    }

    document.querySelectorAll<HTMLButtonElement>("[data-pack-download]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pack = packsMeta.find((p) => p.id === btn.dataset.packDownload);
        if (!pack) return;
        downloadZipPack(pack.itemIds.map((id) => itemById.get(id)).filter(Boolean) as typeof allItems, pack.slug);
      });
    });

    dlSelBtn?.addEventListener("click", () => {
      downloadZipPack(Array.from(selectedIds).map((id) => itemById.get(id)).filter(Boolean) as typeof allItems, "Seleccion");
    });

    document.getElementById("wpDownloadSyncBatBtn")?.addEventListener("click", () => {
      const bat = [
        "@echo off",
        "chcp 65001 >nul",
        'reg add "HKCU\\Control Panel\\Desktop" /v WallpaperStyle /t REG_SZ /d 10 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v TileWallpaper /t REG_SZ /d 0 /f >nul',
        'reg add "HKCU\\Control Panel\\Desktop" /v JPEGImportQuality /t REG_DWORD /d 100 /f >nul',
        `start "" /min powershell -WindowStyle Hidden -NoProfile -ExecutionPolicy Bypass -Command "$dir='%~dp0'; Add-Type -TypeDefinition 'using System.Runtime.InteropServices; public class W { [DllImport(\\"user32.dll\\", CharSet=CharSet.Auto)] public static extern int SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni); }'; while($true){$imgs = Get-ChildItem -Path $dir -Include *.jpg,*.jpeg,*.png -File | Get-Random -Count 999; foreach($img in $imgs){ [W]::SystemParametersInfo(20, 0, $img.FullName, 3) | Out-Null; Start-Sleep -Seconds ${slideshowSec} } }"`,
      ].join("\r\n");
      triggerDownload(new Blob([bat], { type: "text/plain;charset=utf-8" }), `Sincronizar_Monitores_${slideshowSec}s.bat`);
    });

    document.getElementById("wpDownloadStopBatBtn")?.addEventListener("click", () => {
      const stopBat = [
        "@echo off",
        "chcp 65001 >nul",
        `powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process -Filter \\"Name='powershell.exe'\\" | Where-Object { $_.CommandLine -like '*SystemParametersInfo*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"`,
      ].join("\r\n");
      triggerDownload(new Blob([stopBat], { type: "text/plain;charset=utf-8" }), "Detener_Sync_Wallpapers.bat");
    });

    const modalEl = document.getElementById("wpModal");
    const modalTitle = document.getElementById("wpModalTitle");
    const modalSub = document.getElementById("wpModalSub");
    const modalImgA = document.getElementById("wpModalImgA") as HTMLImageElement | null;
    const modalImgB = document.getElementById("wpModalImgB") as HTMLImageElement | null;
    const slideProgress = document.getElementById("wpSlideProgress") as HTMLElement | null;
    const slideToggleBtn = document.getElementById("wpSlideToggle");
    const slideCounter = document.getElementById("wpSlideCounter");
    let activeModalItem: (typeof allItems)[number] | null = null;
    let slideItems: (typeof allItems) = [];
    let slideIndex = 0;
    let slidePlaying = false;
    let slideTimer: number | null = null;
    let activeLayerA = true;

    function stopSlideshow() {
      slidePlaying = false;
      if (slideTimer !== null) {
        clearTimeout(slideTimer);
        slideTimer = null;
      }
      if (slideToggleBtn) {
        slideToggleBtn.innerHTML = `▶ Slideshow (<span class="wp-sec-lbl">${slideshowSec}s</span>)`;
      }
      if (slideProgress) {
        slideProgress.style.transition = "none";
        slideProgress.style.width = "0%";
      }
    }

    function showSlideAt(idx: number, animateKenBurns: boolean) {
      if (!slideItems.length || !modalImgA || !modalImgB) return;
      slideIndex = ((idx % slideItems.length) + slideItems.length) % slideItems.length;
      const item = slideItems[slideIndex];
      activeModalItem = item;
      if (modalTitle) modalTitle.textContent = item.model;
      if (modalSub) modalSub.textContent = `${item.carClass} · ${item.circuit}`;
      if (slideCounter) slideCounter.textContent = `${slideIndex + 1}/${slideItems.length}`;

      const incoming = activeLayerA ? modalImgA : modalImgB;
      const outgoing = activeLayerA ? modalImgB : modalImgA;
      activeLayerA = !activeLayerA;

      incoming.classList.remove("wp-kb-active");
      incoming.style.setProperty("--wp-kb-dur", `${slideshowSec}s`);
      incoming.src = item.img;
      incoming.alt = item.model;

      const reveal = () => {
        if (animateKenBurns) {
          void incoming.offsetWidth;
          incoming.classList.add("wp-kb-active");
        }
        incoming.style.opacity = "1";
        incoming.style.zIndex = "2";
        outgoing.style.opacity = "0";
        outgoing.style.zIndex = "1";
      };

      if (incoming.complete) reveal();
      else incoming.onload = reveal;

      if (slideProgress) {
        slideProgress.style.transition = "none";
        slideProgress.style.width = "0%";
        if (animateKenBurns) {
          void slideProgress.offsetWidth;
          slideProgress.style.transition = `width ${slideshowSec}s linear`;
          slideProgress.style.width = "100%";
        }
      }
    }

    function scheduleNextSlide() {
      if (!slidePlaying) return;
      if (slideTimer !== null) clearTimeout(slideTimer);
      slideTimer = window.setTimeout(() => {
        if (!slidePlaying) return;
        showSlideAt(slideIndex + 1, true);
        scheduleNextSlide();
      }, slideshowSec * 1000);
    }

    function startSlideshow() {
      if (!slideItems.length) return;
      slidePlaying = true;
      if (slideToggleBtn) {
        slideToggleBtn.innerHTML = `⏸ Pausar (<span class="wp-sec-lbl">${slideshowSec}s</span>)`;
      }
      showSlideAt(slideIndex, true);
      scheduleNextSlide();
    }

    function openPreviewModal(items: typeof allItems, startIdx: number, autoPlay: boolean) {
      if (!items.length || !modalEl) return;
      stopSlideshow();
      slideItems = items;
      slideIndex = startIdx;
      modalEl.hidden = false;
      if (autoPlay) startSlideshow();
      else showSlideAt(startIdx, false);
    }

    function closePreviewModal() {
      stopSlideshow();
      if (modalEl) modalEl.hidden = true;
    }

    document.querySelectorAll<HTMLButtonElement>("[data-preview-id]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.previewId || "";
        const idx = allItems.findIndex((i) => i.id === id);
        if (idx >= 0) openPreviewModal(allItems, idx, false);
      });
    });
    document.querySelectorAll<HTMLButtonElement>("[data-pack-slideshow]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const pack = packsMeta.find((p) => p.id === btn.dataset.packSlideshow);
        if (!pack) return;
        const items = pack.itemIds.map((id) => itemById.get(id)).filter(Boolean) as typeof allItems;
        openPreviewModal(items, 0, true);
      });
    });
    slideToggleBtn?.addEventListener("click", () => {
      if (slidePlaying) stopSlideshow();
      else startSlideshow();
    });
    document.getElementById("wpSlidePrev")?.addEventListener("click", () => {
      showSlideAt(slideIndex - 1, slidePlaying);
      if (slidePlaying) scheduleNextSlide();
    });
    document.getElementById("wpSlideNext")?.addEventListener("click", () => {
      showSlideAt(slideIndex + 1, slidePlaying);
      if (slidePlaying) scheduleNextSlide();
    });
    document.getElementById("wpModalClose")?.addEventListener("click", closePreviewModal);
    modalEl?.addEventListener("click", (e) => { if (e.target === modalEl) closePreviewModal(); });

    async function downloadSingleItem(item: (typeof allItems)[number], fmt: "desktop" | "mobile") {
      const jpgBlob = await renderNativeJpgBlob(item.img, fmt);
      triggerDownload(jpgBlob, `Muntrume_${item.cleanFileBase}${fmt === "mobile" ? "_9x16_4K" : "_16x9"}.jpg`);
    }
    document.querySelectorAll<HTMLButtonElement>("[data-direct-dl]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = itemById.get(btn.dataset.directDl || "");
        if (item) downloadSingleItem(item, outputFormat);
      });
    });
    document.getElementById("wpModalDownloadDesktop")?.addEventListener("click", () => { if (activeModalItem) downloadSingleItem(activeModalItem, "desktop"); });
    document.getElementById("wpModalDownloadMobile")?.addEventListener("click", () => { if (activeModalItem) downloadSingleItem(activeModalItem, "mobile"); });

    // Submit Modal
    const subModal = document.getElementById("wpSubmitModal");
    document.getElementById("wpOpenSubmitBtn")?.addEventListener("click", () => { if (subModal) subModal.hidden = false; });
    document.getElementById("wpSubmitClose")?.addEventListener("click", () => { if (subModal) subModal.hidden = true; });
    subModal?.addEventListener("click", (e) => { if (e.target === subModal) subModal.hidden = true; });
    const subModeInput = document.getElementById("wpSubmitMode") as HTMLInputElement | null;
    const modeCommBtn = document.getElementById("wpModeCommunityBtn");
    const modeTeamBtn = document.getElementById("wpModeTeamBtn");
    const tokenWrap = document.getElementById("wpTeamTokenWrap");
    const setSubmitMode = (mode: "community" | "team") => {
      if (subModeInput) subModeInput.value = mode;
      const isTeam = mode === "team";
      if (tokenWrap) tokenWrap.hidden = !isTeam;
      if (modeCommBtn && modeTeamBtn) {
        modeCommBtn.className = `py-1.5 rounded font-bold cursor-pointer ${!isTeam ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
        modeTeamBtn.className = `py-1.5 rounded font-bold cursor-pointer ${isTeam ? "bg-emerald-500 text-[#04130d]" : "text-slate-300 hover:text-white"}`;
      }
    };
    modeCommBtn?.addEventListener("click", () => setSubmitMode("community"));
    modeTeamBtn?.addEventListener("click", () => setSubmitMode("team"));

    const fileInput = document.getElementById("wpSubFile") as HTMLInputElement | null;
    const fileInfo = document.getElementById("wpSubFileInfo");
    const subStatus = document.getElementById("wpSubmitStatus");
    const subForm = document.getElementById("wpSubmitForm") as HTMLFormElement | null;
    let fileDimsValid = false;
    fileInput?.addEventListener("change", () => {
      fileDimsValid = false;
      const f = fileInput.files?.[0];
      if (!f) return;
      const objUrl = URL.createObjectURL(f);
      const probe = new Image();
      probe.onload = () => {
        URL.revokeObjectURL(objUrl);
        fileDimsValid = probe.naturalWidth >= 1920 && probe.naturalHeight >= 1080;
        if (fileInfo) {
          fileInfo.textContent = fileDimsValid ? `OK: ${probe.naturalWidth}×${probe.naturalHeight} px` : `Insuficiente (${probe.naturalWidth}×${probe.naturalHeight}). Mínimo 1920×1080.`;
          fileInfo.className = `text-[10px] mt-1 ${fileDimsValid ? "text-emerald-400" : "text-rose-400"}`;
        }
      };
      probe.src = objUrl;
    });
    subForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!fileDimsValid) {
        if (subStatus) { subStatus.hidden = false; subStatus.textContent = "Resolución mínima 1920×1080 requerida."; }
        return;
      }
      const resp = await fetch("/api/wallpapers/submit", { method: "POST", body: new FormData(subForm) }).catch(() => null);
      const data = resp ? await resp.json().catch(() => ({})) : { error: "Error de red." };
      if (subStatus) {
        subStatus.hidden = false;
        subStatus.textContent = resp?.ok && data.ok ? data.message : (data.error || "Error enviando.");
      }
    });
  </script>
</Layout>
