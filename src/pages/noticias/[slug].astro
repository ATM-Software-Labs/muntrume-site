---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';


function renderMarkdownToHtml(md: string) {
  if (!md) return '';
  const lines = md.split(/\r?\n/);
  let html = '';
  let inList = false;

  const formatInline = (text: string) => {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-[var(--r-text)]">$1</strong>')
      .replace(/\*(.+?)\*/g, '<em class="italic text-[var(--r-muted)]">$1</em>')
      .replace(/`(.+?)`/g, '<code class="px-1.5 py-0.5 rounded bg-[var(--r-bg-2)] text-[var(--r-accent)] font-mono text-xs border border-[var(--r-line)]">$1</code>');
  };

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();

    if (!line) {
      if (inList) { html += '</ul>'; inList = false; }
      continue;
    }

    if (line.startsWith('### ')) {
      if (inList) { html += '</ul>'; inList = false; }
      html += `<h3 class="text-lg sm:text-xl font-extrabold text-[var(--r-text)] mt-8 mb-3 tracking-tight font-display flex items-center gap-2"><span class="text-[var(--r-accent)]">▸</span>${formatInline(line.substring(4))}</h3>`;
      continue;
    }
    if (line.startsWith('## ')) {
      if (inList) { html += '</ul>'; inList = false; }
      html += `<h2 class="text-xl sm:text-2xl font-extrabold text-[var(--r-text)] mt-10 mb-4 tracking-tight border-b border-[var(--r-line)] pb-3 font-display">${formatInline(line.substring(3))}</h2>`;
      continue;
    }
    if (line.startsWith('> ')) {
      if (inList) { html += '</ul>'; inList = false; }
      html += `<blockquote class="p-4 sm:p-5 my-6 border-l-4 border-[var(--r-accent)] bg-[var(--r-bg-2)] rounded-r-2xl text-[var(--r-text)] italic leading-relaxed shadow-sm">${formatInline(line.substring(2))}</blockquote>`;
      continue;
    }
    if (line.startsWith('- ') || line.startsWith('* ')) {
      if (!inList) { html += '<ul class="space-y-2.5 my-5 list-none text-[var(--r-text)] pl-1">'; inList = true; }
      html += `<li class="flex items-start gap-2.5 leading-relaxed"><span class="text-[var(--r-accent)] font-bold mt-1 select-none">▪</span><span class="flex-1">${formatInline(line.substring(2))}</span></li>`;
      continue;
    }

    if (inList) { html += '</ul>'; inList = false; }
    html += `<p class="leading-relaxed text-[var(--r-text)] opacity-95 my-4 text-base sm:text-[16.5px]">${formatInline(line)}</p>`;
  }

  if (inList) html += '</ul>';
  return html;
}

function getAuthorInitials(name: string) {
  if (!name) return 'MM';
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
  return name.substring(0, 2).toUpperCase();
}

function getAuthorRole(author: string) {
  const a = (author || '').toLowerCase();
  if (a.includes('trujillo')) return 'Fundador & Ingeniero de Telemetría (#16)';
  if (a.includes('berbis')) return 'Piloto Oficial GT3 & Resistencia (#1)';
  if (a.includes('chongkan')) return 'Piloto Oficial GT3 & Resistencia (#22)';
  if (a.includes('engineering') || a.includes('ingenier')) return 'Laboratorio de Puesta a Punto y Telemetría';
  return 'Muntrume Motorsport Official';
}

export async function getStaticPaths() {
  function slugify(text: string): string {
    return (text || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }
  const paths: any[] = [];
  const seenSlugs = new Set<string>();

  // 1. Cargar noticias oficiales de equipo desde public/noticias-equipo.md
  try {
    const mdPath = path.resolve('./public/noticias-equipo.md');
    if (fs.existsSync(mdPath)) {
      const rawMd: string = String(fs.readFileSync(mdPath, 'utf8') || '');
      const blocks = rawMd.split(/^---\s*$/m).filter(b => b.trim().length > 0);
      blocks.forEach((block: string) => {
        const lines = block.trim().split(/\r?\n/);
        let title = '', date = '', author = '', category = 'General', image = '', contentLines: string[] = [];
        const titleLine = lines.find((l: string) => /^#\s+/.test(l));
        if (titleLine) title = titleLine.replace(/^#\s+/, '').trim();
        lines.forEach((l: string) => {
          const trimmed = l.trim();
          const match = trimmed.match(/^\*\*(Date|Fecha|Author|Autor|Category|Categor[ií]a|Image|Imagen):\*\*\s*(.+)$/i);
          if (match) {
            const key = match[1].toLowerCase();
            const value = match[2].trim();
            if (key.includes('fecha') || key === 'date') date = value;
            else if (key.includes('autor') || key === 'author') author = value;
            else if (key.includes('categor') || key === 'category') category = value;
            else if (key.includes('imagen') || key === 'image') image = value;
          } else if (!/^#\s+/.test(trimmed) && trimmed.length > 0) {
            contentLines.push(trimmed);
          }
        });

        if (title) {
          const slug = slugify(title);
          seenSlugs.add(slug);
          const fullContent = contentLines.join('\n');
          const firstPara = contentLines.find((l: string) => !l.startsWith('#') && !l.startsWith('-') && !l.startsWith('>')) || '';

          paths.push({
            params: { slug },
            props: {
              dispatch: {
                slug,
                title_original: title,
                excerpt_short: firstPara.length > 200 ? firstPara.substring(0, 197) + '...' : firstPara,
                context_note: 'Despacho institucional emitido por la dirección técnica de Muntrume Motorsport.',
                body_markdown: fullContent,
                url_original: `https://muntru.me/noticias/${slug}`,
                source_name: 'Muntrume Motorsport',
                source_domain: 'muntru.me',
                published_at: date || '2026-11-01',
                image_url_original: image || '/assets/img/race1.webp',
                author: author || 'Muntrume Motorsport',
                category: category || 'General',
                isTeam: true
              }
            }
          });
        }
      });
    }
  } catch (err) {
    console.warn('[noticias-ssg] Error leyendo noticias-equipo.md:', err);
  }

  // 2. Cargar despachos externos desde el Worker API
  try {
    const res = await fetch('https://muntrume.atrumin16.workers.dev/api/dispatches');
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data.dispatches) && data.dispatches.length > 0) {
        data.dispatches.forEach((d: any) => {
          if (!seenSlugs.has(d.slug)) {
            seenSlugs.add(d.slug);
            paths.push({
              params: { slug: d.slug },
              props: { dispatch: { ...d, isTeam: false } }
            });
          }
        });
      }
    }
  } catch (e) {
    console.warn('[noticias-ssg] API fetch failed during build:', e);
  }

  if (paths.length === 0) {
    paths.push({
      params: { slug: 'iracing-season-update-26s4' },
      props: {
        dispatch: {
          slug: 'iracing-season-update-26s4',
          title_original: 'iRacing 2026 Season Update: GT3 BoP and Tire Model v8',
          excerpt_short: 'Official release notes for the new GT3 Balance of Performance and improved dynamic tire carcass compliance in endurance events.',
          context_note: 'Despacho técnico analizado por el departamento de ingeniería y competición de Muntrume Motorsport para eventos de resistencia.',
          url_original: 'https://www.iracing.com/feed/',
          source_name: 'iRacing Official',
          source_domain: 'iracing.com',
          published_at: new Date().toISOString(),
          image_url_original: null,
          isTeam: false
        }
      }
    });
  }

  return paths;
}

interface Props {
  dispatch: any;
}

const { dispatch } = Astro.props as Props;
const { slug } = Astro.params;

const isTeam = Boolean(dispatch?.isTeam);
const title = dispatch?.title_original || 'Despacho Técnico · Muntrume Motorsport';
const pageTitle = isTeam ? `${title} · Muntrume Motorsport` : `${title} · Sala de Prensa Muntrume`;
const pageDescription = dispatch?.excerpt_short || 'Noticias oficiales y técnica de simracing de Muntrume Motorsport.';
const urlOriginal = isTeam ? `https://muntru.me/noticias/${slug}` : (dispatch?.url_original || 'https://muntru.me');
const sourceName = dispatch?.source_name || (isTeam ? 'Muntrume Motorsport' : 'Fuente Oficial');
const excerpt = dispatch?.excerpt_short || '';
const contextNote = dispatch?.context_note || 'Despacho técnico monitorizado por Muntrume Motorsport para análisis de telemetría y ritmo de carrera.';
const pubDate = dispatch?.published_at ? new Date(dispatch.published_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
const imageUrl = dispatch?.image_url_original || (isTeam ? '/assets/img/coche1.webp' : null);
const authorName = dispatch?.author || 'Muntrume Motorsport';
const authorRole = getAuthorRole(authorName);
const authorInitials = getAuthorInitials(authorName);
const category = dispatch?.category || 'Despacho Oficial';
const bodyMarkdown = dispatch?.body_markdown || '';
const bodyHtml = isTeam ? renderMarkdownToHtml(bodyMarkdown) : '';

// Estimated Reading Time and Word Count
const wordCount = ((bodyMarkdown || '') + ' ' + (dispatch?.excerpt_short || '')).trim().split(/\s+/).filter(Boolean).length;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));
---

<Layout title={pageTitle} description={pageDescription} canonical={urlOriginal}>
  
  <Fragment slot="head">
    <link rel="canonical" href={urlOriginal} />
    {isTeam ? (
      <>
        <meta name="robots" content="index, follow" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        {imageUrl && <meta property="og:image" content={imageUrl} />}
        <meta property="og:url" content={urlOriginal} />
        <meta property="og:type" content="article" />
      </>
    ) : (
      <meta name="robots" content="noindex, follow" />
    )}
  </Fragment>

  <div class="min-h-screen bg-[var(--r-bg)] text-[var(--r-text)] pt-20 pb-20 selection:bg-[var(--r-accent)] selection:text-[var(--r-accent-ink)] transition-colors duration-200">
    <div id="dispatchContainer" class="max-w-3xl mx-auto px-4 sm:px-6 space-y-8">
      
      <!-- Breadcrumb & Back Navigation -->
      <div class="flex items-center justify-between text-xs font-mono pb-3 border-b border-[var(--r-line)]">
        <nav class="flex items-center gap-2 text-[var(--r-muted)]">
          <a href="/" class="hover:text-[var(--r-text)] transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span>Inicio</span>
          </a>
          <span>/</span>
          <a href="/news" class="hover:text-[var(--r-accent)] transition">Sala de Prensa</a>
          <span>/</span>
          <span class="text-[var(--r-accent)] font-semibold truncate max-w-[200px]">{category}</span>
        </nav>
        <a 
          href="/news" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--r-bg-2)] border border-[var(--r-line)] text-[var(--r-muted)] hover:text-[var(--r-text)] hover:border-[var(--r-accent)] transition font-mono shadow-sm"
        >
          <span>&larr;</span>
          <span>Volver a Noticias</span>
        </a>
      </div>

      {isTeam ? (
        <article class="space-y-8">
          
          <!-- Badges & Reading Meta -->
          <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--r-accent)]/15 text-[var(--r-accent)] border border-[var(--r-accent)]/30 font-bold uppercase tracking-wider text-[11px]">
              <span class="w-2 h-2 rounded-full bg-[var(--r-accent)] animate-pulse"></span>
              <span>Despacho Oficial · Muntrume</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--r-bg-2)] text-[var(--r-muted)] border border-[var(--r-line)] uppercase font-semibold text-[11px] shadow-sm">
              <svg class="w-3.5 h-3.5 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <span>{category}</span>
            </span>
            {pubDate && (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--r-bg-2)] text-[var(--r-muted)] border border-[var(--r-line)] text-[11px] shadow-sm">
                <svg class="w-3.5 h-3.5 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{pubDate}</span>
              </span>
            )}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--r-bg-2)] text-[var(--r-muted)] border border-[var(--r-line)] text-[11px] shadow-sm">
              <svg class="w-3.5 h-3.5 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{readTimeMinutes} min de lectura</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--r-bg-2)] text-[var(--r-muted)] border border-[var(--r-line)] text-[11px] shadow-sm">
              <svg class="w-3.5 h-3.5 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>{wordCount} palabras</span>
            </span>
          </div>

          <!-- Main Title -->
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--r-text)] tracking-tight leading-[1.18] font-display">
            {title}
          </h1>

          <!-- Author & Meta bar -->
          <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-4 py-4 border-y border-[var(--r-line)] text-xs">
            <div class="flex items-center gap-3">
              <div class="w-11 h-11 rounded-full bg-[var(--r-bg-2)] border border-[var(--r-accent)]/40 flex items-center justify-center font-extrabold text-[var(--r-accent)] text-sm shadow-sm">
                {authorInitials}
              </div>
              <div>
                <div class="font-bold text-[var(--r-text)] text-sm sm:text-base flex items-center gap-2">
                  <span>{authorName}</span>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-semibold bg-[var(--r-accent)]/15 text-[var(--r-accent)] border border-[var(--r-accent)]/30">Oficial MMT</span>
                </div>
                <div class="text-[var(--r-muted)] text-xs mt-0.5 flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-[var(--r-accent)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  <span>{authorRole}</span>
                </div>
              </div>
            </div>

            <button 
              id="teamShareBtn" 
              onclick="if(navigator.clipboard){navigator.clipboard.writeText(window.location.href);var t=document.getElementById('teamShareText');if(t){t.textContent='¡Enlace Copiado!';setTimeout(()=>t.textContent='Compartir',2000);}}"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-[var(--r-accent)] text-[var(--r-text)] hover:text-[var(--r-accent)] transition text-xs font-mono font-semibold cursor-pointer shadow-sm ml-auto sm:ml-0"
              title="Compartir este despacho técnico"
            >
              <svg class="w-4 h-4 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
              </svg>
              <span id="teamShareText">Compartir</span>
            </button>
          </div>

          <!-- Featured Image -->
          {imageUrl && (
            <figure class="rounded-2xl overflow-hidden border border-[var(--r-line)] bg-[var(--r-surface)] relative shadow-lg">
              <img
                src={imageUrl}
                alt={title}
                loading="eager"
                decoding="async"
                class="w-full max-h-[480px] object-cover"
              />
              <figcaption class="p-3 text-[11px] font-mono text-[var(--r-muted)] bg-[var(--r-surface)]/95 border-t border-[var(--r-line)] flex items-center justify-between">
                <span>Fotografía oficial · {category} · Muntrume Motorsport</span>
                <span class="text-[var(--r-accent)] font-semibold">iRacing Official Series</span>
              </figcaption>
            </figure>
          )}

          <!-- Article Content Card (Theme-Adaptive for Light & Dark Mode) -->
          <div class="space-y-4 text-[var(--r-text)] text-base sm:text-[17px] leading-relaxed bg-[var(--r-surface)] p-6 sm:p-10 rounded-2xl border border-[var(--r-line)] shadow-sm">
            <div class="article-prose" set:html={bodyHtml} />
          </div>

          <!-- Resources & Links Card -->
          <div class="p-6 sm:p-8 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] space-y-4 shadow-sm">
            <div class="flex items-center gap-2 text-[var(--r-text)] font-bold font-mono text-sm sm:text-base">
              <span class="text-[var(--r-accent)]">⚡</span>
              <span>Recursos Técnicos y Telemetría del Equipo</span>
            </div>
            <p class="text-xs sm:text-sm text-[var(--r-muted)] leading-relaxed">
              Consulta las configuraciones .STO verificadas para esta prueba o compara tus vueltas con la telemetría a 60 Hz registrada por nuestros ingenieros:
            </p>
            <div class="flex flex-wrap gap-3 pt-2">
              <a 
                href="/garage" 
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--r-accent)] text-[var(--r-accent-ink)] font-bold font-mono text-xs hover:brightness-110 shadow-sm transition"
              >
                <span>📂 Sincronizar Setup Vault</span>
                <span>&rarr;</span>
              </a>
              <a 
                href="https://garage61.net/app/teams/muntrume" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--r-bg-2)] text-[var(--r-text)] hover:border-[var(--r-accent)] border border-[var(--r-line)] font-mono text-xs transition shadow-sm"
              >
                <span>📊 Telemetría Garage 61</span>
                <span>&nearr;</span>
              </a>
              <a 
                href="/paddock" 
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--r-bg-2)] text-[var(--r-text)] hover:border-[var(--r-accent)] border border-[var(--r-line)] font-mono text-xs transition shadow-sm"
              >
                <span>🏎️ Paddock &amp; Discord</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      ) : (
        <article class="space-y-8">
          <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 rounded bg-[var(--r-bg-2)] text-[var(--r-accent)] border border-[var(--r-line)] font-semibold shadow-sm">
              Vía <a href={urlOriginal} target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--r-text)]">{sourceName}</a>
            </span>
            {pubDate && <span class="text-[var(--r-muted)]">• {pubDate}</span>}
            <span class="px-2.5 py-1 rounded bg-[var(--r-bg-2)] text-[var(--r-muted)] border border-[var(--r-line)] text-[10px] uppercase font-semibold shadow-sm">
              Despacho Agregado
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-[var(--r-bg-2)] text-[var(--r-muted)] border border-[var(--r-line)] text-[10px] shadow-sm">
              ⏱️ {readTimeMinutes} min de lectura
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--r-text)] tracking-tight leading-[1.18] font-display">
            {title}
          </h1>

          {imageUrl && (
            <figure class="rounded-2xl overflow-hidden border border-[var(--r-line)] bg-[var(--r-surface)] relative shadow-lg">
              <img
                src={imageUrl}
                alt={title}
                referrerpolicy="no-referrer"
                loading="lazy"
                class="w-full max-h-[440px] object-cover opacity-95 hover:opacity-100 transition"
              />
              <figcaption class="p-3 text-[11px] font-mono text-[var(--r-muted)] bg-[var(--r-surface)]/95 border-t border-[var(--r-line)]">
                Fotografía e imagen vía {sourceName}
              </figcaption>
            </figure>
          )}

          <div class="space-y-6 text-[var(--r-text)] text-base leading-relaxed bg-[var(--r-surface)] p-6 sm:p-8 rounded-2xl border border-[var(--r-line)] shadow-sm">
            <div>
              <h2 class="text-xs font-mono uppercase tracking-wider text-[var(--r-muted)] mb-2 font-semibold">Resumen de la noticia</h2>
              <p class="text-[var(--r-text)] text-base sm:text-lg font-medium italic border-l-3 border-[var(--r-accent)] pl-4 py-1.5 bg-[var(--r-bg-2)] rounded-r-xl">
                "{excerpt}"
              </p>
            </div>

            <div class="pt-4 border-t border-[var(--r-line)]">
              <h2 class="text-xs font-mono uppercase tracking-wider text-[var(--r-accent)] mb-2 font-semibold">Contexto Muntrume Motorsport</h2>
              <p class="text-sm sm:text-base text-[var(--r-muted)] leading-relaxed">
                {contextNote}
              </p>
            </div>
          </div>

          <div class="pt-2 text-center sm:text-left">
            <a
              href={urlOriginal}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 w-full sm:w-auto px-8 py-4 rounded-xl bg-[var(--r-accent)] text-[var(--r-accent-ink)] font-bold font-mono text-sm sm:text-base hover:brightness-110 shadow-lg shadow-[var(--r-accent)]/15 transition transform hover:-translate-y-0.5"
            >
              <span>Leer noticia completa en {sourceName}</span>
              <span class="text-lg">&rarr;</span>
            </a>
            <p class="text-[11px] font-mono text-[var(--r-muted)] mt-2">
              Enlace directo al artículo original en {sourceName} (se abre en nueva ventana).
            </p>
          </div>

          <div class="p-5 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] text-xs font-mono text-[var(--r-muted)] space-y-2 mt-12 shadow-sm">
            <div class="flex items-center gap-2 text-[var(--r-text)] font-semibold">
              <svg class="w-4 h-4 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Aviso Legal y Atribución Editorial</span>
            </div>
            <p>
              Este contenido es un resumen técnico agregado vía RSS público con fines informativos y de cita (Art. 32 LPI / Directiva UE 2019/790). La noticia original fue publicada por <strong>{sourceName}</strong> y todos los derechos pertenecen a sus respectivos autores.
            </p>
            <p>
              Fuente original: <a href={urlOriginal} target="_blank" rel="noopener noreferrer" class="text-[var(--r-accent)] underline break-all">{urlOriginal}</a>
            </p>
            <div class="pt-2 flex flex-wrap items-center gap-4 text-[11px] text-[var(--r-muted)]">
              <a href="/legal/fuentes" class="hover:text-[var(--r-text)] underline">Directorio de Fuentes y Contacto 24h</a>
              <span>•</span>
              <a href="/legal/retirada" class="hover:text-[var(--r-text)] underline">Solicitar Retirada Inmediata (Takedown)</a>
            </div>
          </div>
        </article>
      )}

    </div>

    {!isTeam && (
      <div id="takedownAlert" class="hidden max-w-md mx-auto p-8 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] text-center space-y-4 my-16 font-mono text-[var(--r-text)] shadow-sm">
        <div class="w-12 h-12 rounded-full bg-red-500/10 text-red-500 mx-auto flex items-center justify-center font-bold text-xl border border-red-500/20">
          410
        </div>
        <h2 class="text-xl font-bold text-[var(--r-text)]">Contenido Retirado</h2>
        <p class="text-xs text-[var(--r-muted)] leading-relaxed">
          Este despacho ha sido retirado permanentemente a petición del titular de derechos conforme a la normativa legal (Art. 32 LPI / DMCA).
        </p>
        <div class="pt-4">
          <a href="/news" class="inline-block px-4 py-2 rounded-xl bg-[var(--r-bg-2)] hover:border-[var(--r-accent)] border border-[var(--r-line)] text-xs text-[var(--r-text)] transition shadow-sm">
            &larr; Volver a la Sala de Prensa
          </a>
        </div>
      </div>
    )}
  </div>

  {!isTeam && (
    <script define:vars={{ slug }}>
      if (slug) {
        fetch('https://muntrume.atrumin16.workers.dev/api/dispatches/' + slug)
          .then(function(r) {
            if (r.status === 410) {
              var c = document.getElementById('dispatchContainer');
              var a = document.getElementById('takedownAlert');
              if (c) c.style.display = 'none';
              if (a) a.classList.remove('hidden');
            }
          })
          .catch(function() {});
      }
    </script>
  )}
</Layout>
