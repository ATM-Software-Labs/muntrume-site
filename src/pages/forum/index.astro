---
import Layout from "../../layouts/Layout.astro";
import { SIM_BADGES } from "../../lib/sim-badges";

const SEED_POSTS = [
  {
    id: "seed-sebring-w11",
    slug: "sebring-2026-s4-w11-guia-baches-degradacion-gt3-imsa",
    title: "Sebring 2026 S4 W11 — Guía de trazada, baches y degradación GT3 / IMSA",
    category: "analisis",
    sim: "iracing",
    author_name: "Alberto Trujillo",
    author_role: "FOUNDER",
    summary: "Puntos clave de frenada en Sunset Bend y Tower Turn, presiones en caliente para stints de 45 min y dónde evitar los baches de hormigón para no sobrecalentar el neumático delantero derecho.",
    body: "Resumen técnico tras las tandas de entrenamiento en Sebring International Raceway (Semana 11):\n\n1. Sunset Bend (T17): entrar ligeramente abierto sobre el hormigón para esquivar el bache central y aplicar gas progresivo al pasar el ápice interior. Un toque de brake bias +0.4% hacia delante estabiliza el tren trasero.\n2. Presiones GT3: objetivo 165–168 kPa en caliente tras 4 vueltas. En el Mustang GT3 y McLaren 720S GT3 EVO el delantero izquierdo sufre en T1 y Bishop Bend.\n3. Tráfico multiclase IMSA: en las eses rápidas (T3-T5) mantener siempre línea predecible; los GTP pierden menos tiempo pasando por exterior a la salida de T5.\n\nDejad vuestras notas de telemetría de Garage 61 o sensaciones de setup en los comentarios.",
    tags: ["Sebring", "IMSA", "GT3", "2026-S4"],
    likes: 24,
    comment_count: 2,
    pinned: 1,
    created_at: "2026-11-23T18:30:00.000Z",
    seedComments: [
      {
        id: "sc-1",
        parent_id: "",
        author_name: "Mateo B.",
        author_role: "DRIVER",
        likes: 6,
        body: "Confirmo lo de T17: subiendo 0.5% el brake bias a partir de mitad de stint el coche deja de rebotar en la entrada.",
        created_at: "2026-11-23T20:10:00.000Z",
      },
      {
        id: "sc-2",
        parent_id: "sc-1",
        author_name: "Eduardo C.",
        author_role: "DRIVER",
        likes: 4,
        body: "Con el 720S GT3 EVO bajar 1 click el ala trasera ayuda muchísimo en la recta de Ullman sin perder estabilidad en T1.",
        created_at: "2026-11-24T09:15:00.000Z",
      },
    ],
  },
  {
    id: "seed-lmu-ffb-braking",
    slug: "le-mans-ultimate-vs-iracing-configuracion-ffb-frenada-lmgt3",
    title: "Le Mans Ultimate vs iRacing — Ajuste de FFB, ABS y frenada en Hypercar y LMGT3",
    category: "multisim",
    sim: "lmu",
    author_name: "Alberto Trujillo",
    author_role: "FOUNDER",
    summary: "Comparativa práctica para pilotos del equipo que alternan entre iRacing y Le Mans Ultimate: curva de freno, gestión de temperatura de neumáticos y perfiles Direct Drive.",
    body: "Cada vez más pilotos de Muntrume Motorsport alternan iRacing con Le Mans Ultimate (LMU) para preparar resistencia WEC.\n\nDiferencias clave a tener en cuenta al cambiar de simulador:\n- Frenada y ABS: en LMGT3 de LMU el ABS permite entrar más profundo con trail-braking; en iRacing un bloqueo prolongado dispara la temperatura superficial y te penaliza las 2 vueltas siguientes.\n- Force Feedback: recomendamos bajar ligeramente el smoothing en LMU (1–2) para sentir el límite de deslizamiento lateral en los pianos de Le Mans y Spa.\n- Gestión de energía (Hypercar): mapear en el volante el botón de motor map y regeneración desde el primer entrenamiento.\n\nSi alguien quiere compartir su perfil de volante para LMU o montar sala de equipo, comentad aquí.",
    tags: ["LMU", "iRacing", "LMGT3", "Hypercar"],
    likes: 18,
    comment_count: 1,
    pinned: 0,
    created_at: "2026-11-22T15:00:00.000Z",
    seedComments: [
      {
        id: "sc-3",
        parent_id: "",
        author_name: "Mateo B.",
        author_role: "DRIVER",
        likes: 5,
        body: "Buenísima guía. En LMU noté muchísimo la diferencia bajando la sensibilidad del pedal al 100% lineal sin curvas.",
        created_at: "2026-11-22T18:45:00.000Z",
      },
    ],
  },
  {
    id: "seed-ac-evo-impresiones",
    slug: "assetto-corsa-evo-primeras-impresiones-fisicas-telemetria-equipo",
    title: "Assetto Corsa EVO — Primeras impresiones de físicas, neumáticos y planes del equipo",
    category: "multisim",
    sim: "ac_evo",
    author_name: "Muntrume Engineering",
    author_role: "STAFF",
    summary: "Evaluación técnica de Assetto Corsa EVO para futuras ligas y eventos internos del equipo, incluyendo compatibilidad de periféricos y objetivos de telemetría.",
    body: "Abrimos hilo oficial para recopilar sensaciones, benchmarks de rendimiento y configuraciones de volante en Assetto Corsa EVO.\n\nPuntos que estamos probando desde Ingeniería MMT:\n1. Modelo de neumáticos y transferencia de pesos en curvas enlazadas (Imola / Brands Hatch).\n2. Rendimiento en triple screen y VR con el motor propio de Kunos.\n3. Futura integración de telemetría para que los pilotos multi-sim también sumen estadísticas y logros en su ficha oficial de muntru.me.\n\n¿Qué coches y circuitos os gustaría ver en las pachangas internas de AC EVO?",
    tags: ["AC EVO", "Multi-Sim", "Ingeniería"],
    likes: 14,
    comment_count: 0,
    pinned: 0,
    created_at: "2026-11-20T12:00:00.000Z",
    seedComments: [],
  },
  {
    id: "seed-mmt-sync-overlays",
    slug: "mmt-sync-v067-configuracion-15-overlays-hud-abiertos",
    title: "MMT Sync v0.6.7 — Configuración recomendada de los 15 overlays HUD abiertos",
    category: "overlays",
    sim: "staff",
    author_name: "Alberto Trujillo",
    author_role: "FOUNDER",
    summary: "Cómo colocar Tempest Weather, Radar/Spotter, Relative y Calculadora de Fuel sin saturar la pantalla y sincronizar tu preset con la nube de Muntrume.",
    body: "Con MMT Sync v0.6.7 hemos añadido 4 nuevos módulos Pro-Free basados en estándares open-source: Tempest Weather, Blind Spot / Spotter, Session & Incidents e In-Car Electronics.\n\nLayout recomendado para 1440p / 1080p:\n- Superior izquierda: Session & Incidents + Tempest Weather compacto.\n- Inferior izquierda: Relative (7 filas) con emblemas oficiales de fabricante.\n- Centro inferior: Input Telemetry + In-Car Electronics (TC / ABS / BB).\n- Inferior derecha: Calculadora de Fuel + Blind Spot lateral.\n\nRecuerda que puedes guardar tu layout en la nube desde el botón de sincronización y recuperarlo en cualquier PC.",
    tags: ["MMT Sync", "Overlays", "HUD", "Open Source"],
    likes: 31,
    comment_count: 0,
    pinned: 0,
    created_at: "2026-11-24T11:00:00.000Z",
    seedComments: [],
  },
];

const FLAIRS: Record<string, { label: string; color: string; bg: string }> = {
  analisis: { label: "Análisis de Carrera", color: "#00e699", bg: "rgba(0, 230, 153, 0.14)" },
  setups: { label: "Setups & Telemetría", color: "#38bdf8", bg: "rgba(56, 189, 248, 0.14)" },
  multisim: { label: "Multi-Sim", color: "#f43f5e", bg: "rgba(244, 63, 94, 0.14)" },
  overlays: { label: "Hardware & Overlays", color: "#f59e0b", bg: "rgba(245, 158, 11, 0.14)" },
  debate: { label: "Debate", color: "#a78bfa", bg: "rgba(167, 139, 250, 0.14)" },
};

const forumSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Foro Técnico y Comunidad · Muntrume Motorsport",
  url: "https://forum.muntru.me/",
  description: "Foro estilo comunidad de Muntrume Motorsport: análisis de carreras, setups, telemetría y debates de iRacing, Le Mans Ultimate, Assetto Corsa EVO, ACC, rFactor 2, AMS2 y F1.",
  publisher: {
    "@type": "SportsTeam",
    name: "Muntrume Motorsport",
    url: "https://muntru.me/",
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: SEED_POSTS.map((p, idx) => ({
      "@type": "ListItem",
      position: idx + 1,
      item: {
        "@type": "DiscussionForumPosting",
        headline: p.title,
        text: p.summary,
        datePublished: p.created_at,
        url: `https://forum.muntru.me/#${p.slug}`,
        author: { "@type": "Person", name: p.author_name },
        interactionStatistic: [
          { "@type": "InteractionCounter", interactionType: "https://schema.org/LikeAction", userInteractionCount: p.likes },
          { "@type": "InteractionCounter", interactionType: "https://schema.org/CommentAction", userInteractionCount: p.comment_count },
        ],
      },
    })),
  },
};

const simList = Object.values(SIM_BADGES);
---

<Layout
  title="Muntrume Forum · Comunidad Sim Racing (forum.muntru.me)"
  description="Foro oficial de Muntrume Motorsport al estilo comunidad: análisis de carrera, setups, telemetría y debates de iRacing, Le Mans Ultimate, Assetto Corsa EVO, ACC, rFactor 2 y AMS2."
  canonical="https://forum.muntru.me/"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(forumSchema)} />

  <div class="rd-shell">
    <!-- LEFT SIDEBAR: Feeds & Game Communities with Real Official Logos -->
    <aside class="rd-left" aria-label="Comunidades y feeds">
      <div class="rd-nav-group">
        <span class="rd-nav-label">FEEDS</span>
        <button type="button" class="rd-nav-item is-active" data-feed="all">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Inicio</span>
        </button>
        <button type="button" class="rd-nav-item" data-feed="popular">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c.5 4-2 6-2 9a4 4 0 0 0 8 0c0-3-2-5-3-9-1 2-2 3-3 0z"/><path d="M8.5 14.5A2.5 2.5 0 0 0 11 17c1.4 0 2.5-1.1 2.5-2.5"/></svg>
          <span>Populares</span>
        </button>
        <button type="button" class="rd-nav-item" data-feed="saved">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span>Guardados</span>
          <span class="rd-nav-badge" id="rdSavedCount">0</span>
        </button>
      </div>

      <div class="rd-nav-group">
        <span class="rd-nav-label">COMUNIDADES (SIMS)</span>
        {simList.map((s) => (
          <button type="button" class="rd-comm-item" data-sim={s.id} title={s.name}>
            <span class="rd-logo-box">
              <img src={s.logoUrl} alt={s.name} class="rd-real-logo" loading="lazy" decoding="async" />
            </span>
            <span class="rd-comm-meta">
              <strong>{s.community}</strong>
              <small>{s.name}</small>
            </span>
          </button>
        ))}
      </div>
    </aside>

    <!-- CENTER COLUMN: Quick Composer, Search/Sort Bar, Reddit Post Cards -->
    <main class="rd-main">
      <!-- Quick Create Post Bar (Reddit-style) -->
      <div class="rd-create-bar">
        <img src="/assets/img/logo-64.webp" alt="Muntrume" width="34" height="34" class="rd-create-avatar" />
        <button type="button" id="rdQuickCreate" class="rd-create-input">
          Publicar análisis de carrera, setup, telemetría o debate...
        </button>
        <button type="button" id="rdNewBtn" class="rd-btn rd-btn--primary">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
          <span>Crear</span>
        </button>
      </div>

      <!-- Full Composer (Collapsible) -->
      <section id="rdComposer" class="rd-composer" hidden aria-label="Crear nueva publicación">
        <div class="rd-composer__head">
          <h2>Crear publicación en Muntrume Forum</h2>
          <button type="button" id="rdCloseComposer" class="rd-icon-btn" aria-label="Cerrar">✕</button>
        </div>
        <form id="rdPostForm" class="rd-form">
          <div class="rd-form-row">
            <label class="rd-field">
              <span>Comunidad (Simulador)</span>
              <select name="sim">
                {simList.map((s) => <option value={s.id}>{s.community} — {s.name}</option>)}
              </select>
            </label>
            <label class="rd-field">
              <span>Flair / Categoría</span>
              <select name="category">
                <option value="analisis">Análisis de Carrera</option>
                <option value="setups">Setups &amp; Telemetría</option>
                <option value="multisim">Multi-Sim</option>
                <option value="overlays">Hardware &amp; Overlays</option>
                <option value="debate">Debate</option>
              </select>
            </label>
          </div>
          <label class="rd-field">
            <span>Título</span>
            <input type="text" name="title" required minlength="4" maxlength="140" placeholder="Ej: Telemetría Spa 24h con Porsche 992 GT3 R — dónde ganamos 0.4s en el sector 2" />
          </label>
          <label class="rd-field">
            <span>Contenido del análisis</span>
            <textarea name="body" required minlength="12" rows="6" placeholder="Comparte tiempos, presiones, configuraciones de FFB/setup o preguntas para la comunidad..."></textarea>
          </label>
          <label class="rd-field">
            <span>Etiquetas (separadas por coma)</span>
            <input type="text" name="tags" placeholder="Spa, GT3, Telemetría, Setup" />
          </label>
          <div class="rd-form-foot">
            <p id="rdPostMsg" class="rd-msg" role="status"></p>
            <div class="rd-form-btns">
              <button type="button" id="rdCancelPost" class="rd-btn rd-btn--ghost">Cancelar</button>
              <button type="submit" class="rd-btn rd-btn--primary">Publicar hilo</button>
            </div>
          </div>
        </form>
      </section>

      <!-- Sort + Search Toolbar -->
      <div class="rd-toolbar">
        <div class="rd-sorts" role="tablist" aria-label="Ordenar publicaciones">
          <button type="button" class="rd-sort-btn is-active" data-sort="hot" role="tab" aria-selected="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c.5 4-2 6-2 9a4 4 0 0 0 8 0c0-3-2-5-3-9-1 2-2 3-3 0z"/></svg>
            <span>Destacados</span>
          </button>
          <button type="button" class="rd-sort-btn" data-sort="new" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span>Nuevos</span>
          </button>
          <button type="button" class="rd-sort-btn" data-sort="top" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            <span>Top</span>
          </button>
          <button type="button" class="rd-sort-btn" data-sort="discussed" role="tab" aria-selected="false">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>Más debatidos</span>
          </button>
        </div>

        <label class="rd-search">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          <input type="search" id="rdSearchInput" placeholder="Buscar hilos, circuitos, coches..." />
        </label>
      </div>

      <!-- Active Filter Banner (shown when filtering by sim/flair/saved) -->
      <div id="rdActiveFilter" class="rd-active-filter" hidden>
        <span id="rdActiveFilterText"></span>
        <button type="button" id="rdClearFilter" class="rd-clear-btn">Limpiar filtro ✕</button>
      </div>

      <!-- Mobile Horizontal Game Logos Strip -->
      <div class="rd-mobile-sims" aria-label="Simuladores">
        <button type="button" class="rd-msim is-active" data-sim="all">Todos</button>
        {simList.map((s) => (
          <button type="button" class="rd-msim" data-sim={s.id} title={s.name}>
            <span class="rd-logo-box rd-logo-box--xs">
              <img src={s.logoUrl} alt={s.name} class="rd-real-logo" loading="lazy" decoding="async" />
            </span>
            <span>{s.short}</span>
          </button>
        ))}
      </div>

      <!-- Feed List -->
      <div id="rdFeed" class="rd-feed">
        {SEED_POSTS.map((post) => {
          const simMeta = SIM_BADGES[post.sim as keyof typeof SIM_BADGES] || SIM_BADGES.iracing;
          const flair = FLAIRS[post.category] || FLAIRS.analisis;
          return (
            <article
              id={post.slug}
              class="rd-post"
              data-post-slug={post.slug}
              data-cat={post.category}
              data-sim={post.sim}
              data-likes={post.likes}
              data-comments={post.comment_count}
              data-date={post.created_at}
              data-pinned={post.pinned}
              itemscope
              itemtype="https://schema.org/DiscussionForumPosting"
            >
              <!-- Reddit Left Vote Rail -->
              <div class="rd-vote-rail" aria-label="Votar publicación">
                <button type="button" class="rd-vote-btn" data-vote={post.slug} data-dir="1" aria-label="Voto positivo">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5l7 8H5l7-8z"/></svg>
                </button>
                <span class="rd-score" data-score={post.slug}>{post.likes}</span>
                <button type="button" class="rd-vote-btn" data-vote={post.slug} data-dir="-1" aria-label="Voto negativo">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 19l-7-8h14l-7 8z"/></svg>
                </button>
              </div>

              <!-- Post Body -->
              <div class="rd-post-body">
                <div class="rd-post-meta">
                  <button type="button" class="rd-comm-pill" data-sim={post.sim} title={`Filtrar por ${simMeta.name}`}>
                    <span class="rd-logo-box rd-logo-box--xs">
                      <img src={simMeta.logoUrl} alt={simMeta.name} class="rd-real-logo" loading="lazy" decoding="async" />
                    </span>
                    <strong>{simMeta.community}</strong>
                  </button>
                  <span class="rd-dot">·</span>
                  <span class="rd-by" itemprop="author" itemscope itemtype="https://schema.org/Person">
                    u/<strong itemprop="name">{post.author_name}</strong>
                  </span>
                  <span class="rd-role-badge">{post.author_role}</span>
                  <span class="rd-dot">·</span>
                  <time datetime={post.created_at} itemprop="datePublished">
                    {new Date(post.created_at).toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" })}
                  </time>
                  {post.pinned === 1 && <span class="rd-pin">FIJADO</span>}
                </div>

                <div class="rd-post-headline-row">
                  <button
                    type="button"
                    class="rd-flair"
                    data-cat={post.category}
                    style={`color:${flair.color};background:${flair.bg};border-color:${flair.color}44;`}
                  >
                    {flair.label}
                  </button>
                  <h2 class="rd-post-title" itemprop="headline">
                    <button type="button" class="rd-title-btn" data-open-thread={post.slug}>{post.title}</button>
                  </h2>
                </div>

                <p class="rd-post-summary" itemprop="text">{post.summary}</p>

                <div class="rd-post-tags">
                  {post.tags.map((t) => <span class="rd-tag">#{t}</span>)}
                </div>

                <!-- Reddit Action Footer -->
                <div class="rd-actions">
                  <button type="button" class="rd-act-btn rd-act-btn--accent" data-open-thread={post.slug}>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    <span data-comment-count={post.slug}>{post.comment_count}</span>
                    <span>Comentarios</span>
                  </button>
                  <button type="button" class="rd-act-btn" data-share={post.slug}>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    <span data-share-lbl={post.slug}>Compartir</span>
                  </button>
                  <button type="button" class="rd-act-btn" data-save={post.slug}>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                    <span data-save-lbl={post.slug}>Guardar</span>
                  </button>
                </div>

                <!-- Expandable Full Thread & Reddit-Style Nested Comments -->
                <div class="rd-thread" data-thread-body={post.slug} hidden>
                  <div class="rd-thread-full">{post.body}</div>

                  <div class="rd-comments-sec">
                    <form class="rd-comment-form" data-comment-form={post.slug} data-parent-id="">
                      <textarea name="body" rows="2" required minlength="2" placeholder="¿Qué opinas? Comparte tu telemetría, setup o experiencia..."></textarea>
                      <div class="rd-comment-bar">
                        <span class="rd-msg" data-comment-msg={post.slug}></span>
                        <button type="submit" class="rd-btn rd-btn--primary rd-btn--sm">Comentar</button>
                      </div>
                    </form>

                    <div class="rd-comments-tree" data-comments-for={post.slug}>
                      {post.seedComments.length > 0 ? (
                        post.seedComments.map((c) => (
                          <div class:list={["rd-comment", c.parent_id && "rd-comment--nested"]} data-cid={c.id}>
                            <div class="rd-comment__line" aria-hidden="true"></div>
                            <div class="rd-comment__box">
                              <div class="rd-comment__head">
                                <strong>u/{c.author_name}</strong>
                                <span class="rd-role-badge">{c.author_role}</span>
                                <span class="rd-dot">·</span>
                                <time datetime={c.created_at}>
                                  {new Date(c.created_at).toLocaleDateString("es-ES", { day: "2-digit", month: "short" })}
                                </time>
                              </div>
                              <p class="rd-comment__text">{c.body}</p>
                              <div class="rd-comment__acts">
                                <button type="button" class="rd-cact" data-cvote={c.id} data-dir="1">▲ <span data-cscore={c.id}>{c.likes}</span></button>
                                <button type="button" class="rd-cact" data-reply-btn={c.id} data-reply-slug={post.slug} data-reply-user={c.author_name}>Responder</button>
                              </div>
                              <div class="rd-reply-slot" data-reply-slot={c.id}></div>
                            </div>
                          </div>
                        ))
                      ) : (
                        <p class="rd-empty-c">Sin comentarios todavía. Abre el debate técnico arriba.</p>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </main>

    <!-- RIGHT SIDEBAR: About Community, Stats, Flairs & Rules -->
    <aside class="rd-right" aria-label="Información de la comunidad">
      <div class="rd-side-card rd-about-card">
        <div class="rd-about-banner">
          <img src="/assets/img/logo-64.webp" alt="Muntrume Motorsport" width="38" height="38" />
          <div>
            <strong>m/muntrume</strong>
            <span>Foro Oficial · Sim Racing</span>
          </div>
        </div>
        <p class="rd-about-desc">
          Comunidad técnica de <strong>Muntrume Motorsport</strong>. Debriefs de resistencia, telemetría de Garage 61, setups, overlays open-source y debates multi-sim.
        </p>
        <div class="rd-about-stats">
          <div>
            <strong id="rdStatPosts">{SEED_POSTS.length}</strong>
            <span>Hilos</span>
          </div>
          <div>
            <strong>{simList.length}</strong>
            <span>Simuladores</span>
          </div>
          <div>
            <strong class="rd-online-dot">Online</strong>
            <span>Indexado SEO</span>
          </div>
        </div>
        <div class="rd-about-btns">
          <button type="button" id="rdSideCreateBtn" class="rd-btn rd-btn--primary rd-btn--full">Crear publicación</button>
          <a href="https://muntru.me/pilotos/" class="rd-btn rd-btn--ghost rd-btn--full">Roster y Logros →</a>
        </div>
      </div>

      <div class="rd-side-card">
        <h3 class="rd-side-title">Filtrar por Flair</h3>
        <div class="rd-flair-cloud">
          {Object.entries(FLAIRS).map(([id, f]) => (
            <button
              type="button"
              class="rd-flair"
              data-cat={id}
              style={`color:${f.color};background:${f.bg};border-color:${f.color}44;`}
            >
              {f.label}
            </button>
          ))}
        </div>
      </div>

      <div class="rd-side-card">
        <h3 class="rd-side-title">Reglas del Paddock</h3>
        <ol class="rd-rules">
          <li>
            <details>
              <summary>1. Respeto en pista y en el foro</summary>
              <p>Debates técnicos y constructivos. Cero ataques personales o toxicidad hacia pilotos o equipos.</p>
            </details>
          </li>
          <li>
            <details>
              <summary>2. Selecciona el simulador correcto</summary>
              <p>Usa la comunidad exacta (<code>m/iRacing</code>, <code>m/LeMansUltimate</code>, <code>m/AssettoCorsaEVO</code>...) para que los demás encuentren rápido tu análisis.</p>
            </details>
          </li>
          <li>
            <details>
              <summary>3. Aporta contexto técnico</summary>
              <p>Al comentar un setup o debrief, indica coche, circuito, combustible aproximado y versión/temporada.</p>
            </details>
          </li>
          <li>
            <details>
              <summary>4. Contenido indexable y útil</summary>
              <p>Los hilos públicos se indexan en Google y Brave Search para ayudar a toda la comunidad de sim racing.</p>
            </details>
          </li>
        </ol>
      </div>
    </aside>
  </div>

  <script is:inline define:vars={{ SIM_BADGES, FLAIRS }}>
    (function () {
      const API = "https://api.muntru.me";
      const feedEl = document.getElementById("rdFeed");
      const composer = document.getElementById("rdComposer");
      const postForm = document.getElementById("rdPostForm");
      const postMsg = document.getElementById("rdPostMsg");
      const searchInput = document.getElementById("rdSearchInput");
      const activeFilterBar = document.getElementById("rdActiveFilter");
      const activeFilterText = document.getElementById("rdActiveFilterText");
      const savedCountEl = document.getElementById("rdSavedCount");
      const statPostsEl = document.getElementById("rdStatPosts");

      let activeFeed = "all"; // all | popular | saved
      let activeSim = "all";
      let activeCat = "all";
      let activeSort = "hot"; // hot | new | top | discussed
      let query = "";

      function getToken() {
        try { return localStorage.getItem("mmt_session_token") || localStorage.getItem("mmt_token") || ""; }
        catch { return ""; }
      }
      function readStore(key, fallback) {
        try { return JSON.parse(localStorage.getItem(key) || "null") ?? fallback; }
        catch { return fallback; }
      }
      function writeStore(key, val) {
        try { localStorage.setItem(key, JSON.stringify(val)); } catch {}
      }

      const votes = readStore("mmt_forum_votes", {});
      const saved = new Set(readStore("mmt_forum_saved", []));

      function esc(s) {
        return String(s || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m]));
      }

      function syncSavedUI() {
        if (savedCountEl) savedCountEl.textContent = String(saved.size);
        document.querySelectorAll("[data-save]").forEach((btn) => {
          const slug = btn.getAttribute("data-save");
          const isSaved = saved.has(slug);
          btn.classList.toggle("is-saved", isSaved);
          const lbl = document.querySelector(`[data-save-lbl="${CSS.escape(slug)}"]`);
          if (lbl) lbl.textContent = isSaved ? "Guardado" : "Guardar";
        });
      }

      function syncVoteUI() {
        document.querySelectorAll("[data-vote]").forEach((btn) => {
          const slug = btn.getAttribute("data-vote");
          const dir = Number(btn.getAttribute("data-dir"));
          const cur = Number(votes[slug] || 0);
          btn.classList.toggle("is-up", cur === 1 && dir === 1);
          btn.classList.toggle("is-down", cur === -1 && dir === -1);
        });
      }

      function applyView() {
        if (!feedEl) return;
        const cards = Array.from(feedEl.querySelectorAll(".rd-post"));
        const q = query.trim().toLowerCase();

        // Sort cards in DOM
        cards.sort((a, b) => {
          const pinA = Number(a.getAttribute("data-pinned") || 0);
          const pinB = Number(b.getAttribute("data-pinned") || 0);
          if (activeSort === "hot" && pinA !== pinB) return pinB - pinA;
          const likesA = Number(a.getAttribute("data-likes") || 0);
          const likesB = Number(b.getAttribute("data-likes") || 0);
          const comA = Number(a.getAttribute("data-comments") || 0);
          const comB = Number(b.getAttribute("data-comments") || 0);
          const dateA = new Date(a.getAttribute("data-date") || 0).getTime();
          const dateB = new Date(b.getAttribute("data-date") || 0).getTime();
          if (activeSort === "new") return dateB - dateA;
          if (activeSort === "top") return likesB - likesA;
          if (activeSort === "discussed") return comB - comA;
          // hot score
          return (likesB * 2 + comB * 3) - (likesA * 2 + comA * 3);
        });
        cards.forEach((c) => feedEl.appendChild(c));

        // Filter visibility
        cards.forEach((card) => {
          const slug = card.getAttribute("data-post-slug") || "";
          const sim = (card.getAttribute("data-sim") || "").toLowerCase();
          const cat = (card.getAttribute("data-cat") || "").toLowerCase();
          const text = (card.textContent || "").toLowerCase();
          const okSim = activeSim === "all" || sim === activeSim;
          const okCat = activeCat === "all" || cat === activeCat;
          const okSaved = activeFeed !== "saved" || saved.has(slug);
          const okQuery = !q || text.includes(q);
          card.hidden = !(okSim && okCat && okSaved && okQuery);
        });

        // Update active filter indicator
        const parts = [];
        if (activeFeed === "saved") parts.push("Guardados");
        if (activeSim !== "all") parts.push(SIM_BADGES[activeSim]?.community || activeSim);
        if (activeCat !== "all") parts.push(FLAIRS[activeCat]?.label || activeCat);
        if (q) parts.push(`"${query.trim()}"`);
        if (activeFilterBar && activeFilterText) {
          activeFilterBar.hidden = parts.length === 0;
          activeFilterText.textContent = parts.length ? `Mostrando: ${parts.join(" · ")}` : "";
        }
        if (statPostsEl) statPostsEl.textContent = String(cards.length);
      }

      function openComposer() {
        if (!composer) return;
        composer.hidden = false;
        composer.scrollIntoView({ behavior: "smooth", block: "nearest" });
        composer.querySelector('input[name="title"]')?.focus();
      }

      document.getElementById("rdQuickCreate")?.addEventListener("click", openComposer);
      document.getElementById("rdNewBtn")?.addEventListener("click", openComposer);
      document.getElementById("rdSideCreateBtn")?.addEventListener("click", openComposer);
      document.getElementById("rdCloseComposer")?.addEventListener("click", () => { if (composer) composer.hidden = true; });
      document.getElementById("rdCancelPost")?.addEventListener("click", () => { if (composer) composer.hidden = true; });

      document.getElementById("rdClearFilter")?.addEventListener("click", () => {
        activeFeed = "all"; activeSim = "all"; activeCat = "all"; query = "";
        if (searchInput) searchInput.value = "";
        document.querySelectorAll(".rd-nav-item").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-feed") === "all"));
        document.querySelectorAll(".rd-comm-item, .rd-msim").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-sim") === "all"));
        applyView();
      });

      document.querySelectorAll("[data-feed]").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeFeed = btn.getAttribute("data-feed") || "all";
          if (activeFeed === "popular") activeSort = "top";
          if (activeFeed === "all") { activeSim = "all"; activeCat = "all"; }
          document.querySelectorAll("[data-feed]").forEach((b) => b.classList.toggle("is-active", b === btn));
          document.querySelectorAll("[data-sort]").forEach((b) => {
            const on = b.getAttribute("data-sort") === activeSort;
            b.classList.toggle("is-active", on);
            b.setAttribute("aria-selected", on ? "true" : "false");
          });
          applyView();
        });
      });

      document.querySelectorAll("[data-sort]").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeSort = btn.getAttribute("data-sort") || "hot";
          document.querySelectorAll("[data-sort]").forEach((b) => {
            b.classList.toggle("is-active", b === btn);
            b.setAttribute("aria-selected", b === btn ? "true" : "false");
          });
          applyView();
        });
      });

      searchInput?.addEventListener("input", () => {
        query = searchInput.value || "";
        applyView();
      });

      function renderCommentHtml(c, slug) {
        const isNested = Boolean(c.parent_id);
        return `
          <div class="rd-comment ${isNested ? "rd-comment--nested" : ""}" data-cid="${esc(c.id)}">
            <div class="rd-comment__line" aria-hidden="true"></div>
            <div class="rd-comment__box">
              <div class="rd-comment__head">
                <strong>u/${esc(c.author_name)}</strong>
                <span class="rd-role-badge">${esc(c.author_role || "DRIVER")}</span>
                <span class="rd-dot">·</span>
                <time>${new Date(c.created_at || Date.now()).toLocaleDateString("es-ES", { day: "2-digit", month: "short" })}</time>
              </div>
              <p class="rd-comment__text">${esc(c.body)}</p>
              <div class="rd-comment__acts">
                <button type="button" class="rd-cact" data-cvote="${esc(c.id)}" data-dir="1">▲ <span data-cscore="${esc(c.id)}">${Number(c.likes || 0)}</span></button>
                <button type="button" class="rd-cact" data-reply-btn="${esc(c.id)}" data-reply-slug="${esc(slug)}" data-reply-user="${esc(c.author_name)}">Responder</button>
              </div>
              <div class="rd-reply-slot" data-reply-slot="${esc(c.id)}"></div>
            </div>
          </div>
        `;
      }

      function renderPostCard(p) {
        const simMeta = SIM_BADGES[p.sim] || SIM_BADGES.iracing;
        const flair = FLAIRS[p.category] || FLAIRS.analisis;
        const dateStr = new Date(p.created_at || Date.now()).toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" });
        const tagsHtml = (p.tags || []).map((t) => `<span class="rd-tag">#${esc(t)}</span>`).join("");
        const el = document.createElement("article");
        el.id = p.slug;
        el.className = "rd-post";
        el.setAttribute("data-post-slug", p.slug);
        el.setAttribute("data-cat", p.category || "analisis");
        el.setAttribute("data-sim", p.sim || "iracing");
        el.setAttribute("data-likes", String(Number(p.likes || 0)));
        el.setAttribute("data-comments", String(Number(p.comment_count || 0)));
        el.setAttribute("data-date", p.created_at || new Date().toISOString());
        el.setAttribute("data-pinned", String(Number(p.pinned || 0)));
        el.innerHTML = `
          <div class="rd-vote-rail">
            <button type="button" class="rd-vote-btn" data-vote="${esc(p.slug)}" data-dir="1" aria-label="Voto positivo">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5l7 8H5l7-8z"/></svg>
            </button>
            <span class="rd-score" data-score="${esc(p.slug)}">${Number(p.likes || 0)}</span>
            <button type="button" class="rd-vote-btn" data-vote="${esc(p.slug)}" data-dir="-1" aria-label="Voto negativo">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 19l-7-8h14l-7 8z"/></svg>
            </button>
          </div>
          <div class="rd-post-body">
            <div class="rd-post-meta">
              <button type="button" class="rd-comm-pill" data-sim="${esc(p.sim || "iracing")}">
                <span class="rd-logo-box rd-logo-box--xs"><img src="${simMeta.logoUrl}" alt="${esc(simMeta.name)}" class="rd-real-logo" /></span>
                <strong>${esc(simMeta.community)}</strong>
              </button>
              <span class="rd-dot">·</span>
              <span class="rd-by">u/<strong>${esc(p.author_name || "Piloto MMT")}</strong></span>
              <span class="rd-role-badge">${esc(p.author_role || "DRIVER")}</span>
              <span class="rd-dot">·</span>
              <time>${dateStr}</time>
            </div>
            <div class="rd-post-headline-row">
              <button type="button" class="rd-flair" data-cat="${esc(p.category || "analisis")}" style="color:${flair.color};background:${flair.bg};border-color:${flair.color}44;">${esc(flair.label)}</button>
              <h2 class="rd-post-title"><button type="button" class="rd-title-btn" data-open-thread="${esc(p.slug)}">${esc(p.title)}</button></h2>
            </div>
            <p class="rd-post-summary">${esc(p.summary || "")}</p>
            <div class="rd-post-tags">${tagsHtml}</div>
            <div class="rd-actions">
              <button type="button" class="rd-act-btn rd-act-btn--accent" data-open-thread="${esc(p.slug)}">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span data-comment-count="${esc(p.slug)}">${Number(p.comment_count || 0)}</span>
                <span>Comentarios</span>
              </button>
              <button type="button" class="rd-act-btn" data-share="${esc(p.slug)}">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                <span data-share-lbl="${esc(p.slug)}">Compartir</span>
              </button>
              <button type="button" class="rd-act-btn" data-save="${esc(p.slug)}">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                <span data-save-lbl="${esc(p.slug)}">Guardar</span>
              </button>
            </div>
            <div class="rd-thread" data-thread-body="${esc(p.slug)}" hidden>
              <div class="rd-thread-full">${esc(p.body || "")}</div>
              <div class="rd-comments-sec">
                <form class="rd-comment-form" data-comment-form="${esc(p.slug)}" data-parent-id="">
                  <textarea name="body" rows="2" required minlength="2" placeholder="¿Qué opinas? Comparte tu telemetría, setup o experiencia..."></textarea>
                  <div class="rd-comment-bar">
                    <span class="rd-msg" data-comment-msg="${esc(p.slug)}"></span>
                    <button type="submit" class="rd-btn rd-btn--primary rd-btn--sm">Comentar</button>
                  </div>
                </form>
                <div class="rd-comments-tree" data-comments-for="${esc(p.slug)}"><p class="rd-empty-c">Cargando comentarios...</p></div>
              </div>
            </div>
          </div>
        `;
        return el;
      }

      async function loadComments(slug) {
        const box = document.querySelector(`[data-comments-for="${CSS.escape(slug)}"]`);
        if (!box) return;
        try {
          const res = await fetch(`${API}/api/forum/post?slug=${encodeURIComponent(slug)}`);
          const data = await res.json();
          if (data.success && Array.isArray(data.comments)) {
            if (data.comments.length === 0 && box.querySelector(".rd-empty-c")) {
              box.innerHTML = '<p class="rd-empty-c">Sin comentarios todavía. Abre el debate técnico arriba.</p>';
              return;
            }
            const existingIds = new Set(Array.from(box.querySelectorAll("[data-cid]")).map((n) => n.getAttribute("data-cid")));
            if (data.comments.length > 0 && box.querySelector(".rd-empty-c")) box.innerHTML = "";
            data.comments.forEach((c) => {
              if (existingIds.has(c.id)) return;
              box.insertAdjacentHTML("beforeend", renderCommentHtml(c, slug));
            });
            const total = box.querySelectorAll("[data-cid]").length;
            const cnt = document.querySelector(`[data-comment-count="${CSS.escape(slug)}"]`);
            if (cnt) cnt.textContent = String(total);
            const card = document.querySelector(`[data-post-slug="${CSS.escape(slug)}"]`);
            if (card) card.setAttribute("data-comments", String(total));
          }
        } catch {}
      }

      document.addEventListener("click", async (e) => {
        const simBtn = e.target?.closest?.("[data-sim]");
        if (simBtn && !simBtn.closest("form")) {
          const s = simBtn.getAttribute("data-sim") || "all";
          activeSim = (activeSim === s && s !== "all") ? "all" : s;
          document.querySelectorAll(".rd-comm-item, .rd-msim").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-sim") === activeSim));
          applyView();
          return;
        }

        const catBtn = e.target?.closest?.("[data-cat]");
        if (catBtn && catBtn.tagName === "BUTTON") {
          const c = catBtn.getAttribute("data-cat") || "all";
          activeCat = activeCat === c ? "all" : c;
          applyView();
          return;
        }

        const openBtn = e.target?.closest?.("[data-open-thread]");
        if (openBtn) {
          const slug = openBtn.getAttribute("data-open-thread");
          const detail = document.querySelector(`[data-thread-body="${CSS.escape(slug)}"]`);
          if (detail) {
            detail.hidden = !detail.hidden;
            if (!detail.hidden) loadComments(slug);
          }
          return;
        }

        const voteBtn = e.target?.closest?.("[data-vote]");
        if (voteBtn) {
          const slug = voteBtn.getAttribute("data-vote");
          const dir = Number(voteBtn.getAttribute("data-dir") || 1);
          const prev = Number(votes[slug] || 0);
          const next = prev === dir ? 0 : dir;
          const delta = next - prev;
          votes[slug] = next;
          writeStore("mmt_forum_votes", votes);
          syncVoteUI();
          const scoreEl = document.querySelector(`[data-score="${CSS.escape(slug)}"]`);
          const card = document.querySelector(`[data-post-slug="${CSS.escape(slug)}"]`);
          if (scoreEl) {
            const val = Number(scoreEl.textContent || "0") + delta;
            scoreEl.textContent = String(val);
            if (card) card.setAttribute("data-likes", String(val));
          }
          try {
            await fetch(`${API}/api/forum/vote`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ slug, delta }),
            });
          } catch {}
          return;
        }

        const cvoteBtn = e.target?.closest?.("[data-cvote]");
        if (cvoteBtn) {
          const cid = cvoteBtn.getAttribute("data-cvote");
          const cscore = document.querySelector(`[data-cscore="${CSS.escape(cid)}"]`);
          if (cscore && !cvoteBtn.classList.contains("is-up")) {
            cvoteBtn.classList.add("is-up");
            cscore.textContent = String(Number(cscore.textContent || "0") + 1);
            try {
              await fetch(`${API}/api/forum/vote`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ comment_id: cid, delta: 1 }),
              });
            } catch {}
          }
          return;
        }

        const replyBtn = e.target?.closest?.("[data-reply-btn]");
        if (replyBtn) {
          const cid = replyBtn.getAttribute("data-reply-btn");
          const slug = replyBtn.getAttribute("data-reply-slug");
          const user = replyBtn.getAttribute("data-reply-user");
          const slot = document.querySelector(`[data-reply-slot="${CSS.escape(cid)}"]`);
          if (slot) {
            if (slot.innerHTML) { slot.innerHTML = ""; return; }
            slot.innerHTML = `
              <form class="rd-comment-form rd-comment-form--reply" data-comment-form="${esc(slug)}" data-parent-id="${esc(cid)}">
                <textarea name="body" rows="2" required minlength="2" placeholder="Responder a u/${esc(user)}..."></textarea>
                <div class="rd-comment-bar">
                  <span class="rd-msg" data-comment-msg="${esc(slug)}-${esc(cid)}"></span>
                  <button type="submit" class="rd-btn rd-btn--primary rd-btn--sm">Responder</button>
                </div>
              </form>
            `;
            slot.querySelector("textarea")?.focus();
          }
          return;
        }

        const shareBtn = e.target?.closest?.("[data-share]");
        if (shareBtn) {
          const slug = shareBtn.getAttribute("data-share");
          const url = `https://forum.muntru.me/#${slug}`;
          navigator.clipboard?.writeText(url).catch(() => {});
          const lbl = document.querySelector(`[data-share-lbl="${CSS.escape(slug)}"]`);
          if (lbl) {
            lbl.textContent = "¡Copiado!";
            setTimeout(() => { lbl.textContent = "Compartir"; }, 1800);
          }
          return;
        }

        const saveBtn = e.target?.closest?.("[data-save]");
        if (saveBtn) {
          const slug = saveBtn.getAttribute("data-save");
          if (saved.has(slug)) saved.delete(slug); else saved.add(slug);
          writeStore("mmt_forum_saved", Array.from(saved));
          syncSavedUI();
          if (activeFeed === "saved") applyView();
        }
      });

      document.addEventListener("submit", async (e) => {
        const cForm = e.target?.closest?.("[data-comment-form]");
        if (cForm) {
          e.preventDefault();
          const slug = cForm.getAttribute("data-comment-form");
          const parentId = cForm.getAttribute("data-parent-id") || "";
          const ta = cForm.querySelector("textarea");
          const msgKey = parentId ? `${slug}-${parentId}` : slug;
          const msg = document.querySelector(`[data-comment-msg="${CSS.escape(msgKey)}"]`);
          const token = getToken();
          if (!token) {
            if (msg) msg.innerHTML = 'Inicia sesión en <a href="https://muntru.me/login/" style="color:var(--r-accent);text-decoration:underline;">muntru.me/login</a> para comentar.';
            return;
          }
          if (msg) msg.textContent = "Enviando...";
          try {
            const res = await fetch(`${API}/api/forum/comment`, {
              method: "POST",
              headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
              body: JSON.stringify({ post_slug: slug, parent_id: parentId, body: ta.value.trim() }),
            });
            const data = await res.json();
            if (!data.success) {
              if (msg) msg.textContent = data.error || "No se pudo publicar.";
              return;
            }
            ta.value = "";
            if (parentId) {
              const slot = cForm.closest(".rd-reply-slot");
              if (slot) slot.innerHTML = "";
            } else if (msg) {
              msg.textContent = "¡Publicado!";
            }
            loadComments(slug);
          } catch {
            if (msg) msg.textContent = "Error de conexión.";
          }
        }
      });

      postForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const token = getToken();
        if (!token) {
          if (postMsg) postMsg.innerHTML = 'Necesitas iniciar sesión en <a href="https://muntru.me/login/" style="color:var(--r-accent);text-decoration:underline;">muntru.me/login</a> para publicar.';
          return;
        }
        const fd = new FormData(postForm);
        const tags = String(fd.get("tags") || "").split(",").map((s) => s.trim()).filter(Boolean);
        if (postMsg) postMsg.textContent = "Publicando...";
        try {
          const res = await fetch(`${API}/api/forum/posts`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
            body: JSON.stringify({
              title: fd.get("title"),
              category: fd.get("category"),
              sim: fd.get("sim"),
              tags,
              body: fd.get("body"),
            }),
          });
          const data = await res.json();
          if (!data.success) {
            if (postMsg) postMsg.textContent = data.error || "Error al publicar.";
            return;
          }
          if (feedEl && data.post) {
            feedEl.prepend(renderPostCard(data.post));
            syncVoteUI();
            syncSavedUI();
            applyView();
          }
          postForm.reset();
          if (postMsg) postMsg.textContent = "";
          if (composer) composer.hidden = true;
        } catch {
          if (postMsg) postMsg.textContent = "Error de conexión con api.muntru.me.";
        }
      });

      // Hydrate live D1 posts
      fetch(`${API}/api/forum/posts`)
        .then((r) => r.json())
        .then((data) => {
          if (!data.success || !Array.isArray(data.posts) || !feedEl) return;
          const existing = new Set(Array.from(document.querySelectorAll("[data-post-slug]")).map((el) => el.getAttribute("data-post-slug")));
          data.posts.forEach((p) => {
            if (!existing.has(p.slug)) feedEl.prepend(renderPostCard(p));
          });
          syncVoteUI();
          syncSavedUI();
          applyView();
        })
        .catch(() => {});

      syncVoteUI();
      syncSavedUI();
      applyView();

      if (location.hash && location.hash.length > 1) {
        const targetSlug = decodeURIComponent(location.hash.slice(1));
        const detail = document.querySelector(`[data-thread-body="${CSS.escape(targetSlug)}"]`);
        if (detail) {
          detail.hidden = false;
          loadComments(targetSlug);
        }
      }
    })();
  </script>
</Layout>

