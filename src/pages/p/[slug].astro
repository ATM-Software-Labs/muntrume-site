---
import Layout from '../../layouts/Layout.astro';

interface DriverProfile {
  slug: string;
  number: string;
  name: string;
  badge: string;
  badgeColor: string;
  avatarColor: string;
  role: string;
  team: string;
  categories: string[];
  focus: string;
  hardware: string;
  competitions: string[];
  bio: string;
  email: string;
  initials: string;
  carName: string;
  carClass: string;
  carImg: string;
  telemetryMetrics: { label: string; value: string }[];
  careerHighlights: string[];
}

const DRIVERS: Record<string, DriverProfile> = {
  "alberto-trujillo": {
    slug: "alberto-trujillo",
    number: "#1",
    name: "Alberto Trujillo",
    badge: "FOUNDER & TEAM PRINCIPAL",
    badgeColor: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20",
    avatarColor: "border-emerald-500 bg-emerald-950/60 text-emerald-400",
    role: "Team Principal · Setup Engineer & Telemetry",
    team: "Muntrume Motorsport",
    categories: ["GTP (Aston Martin Valkyrie AMR Pro)", "GTP (Cadillac V-Series.R)", "GT3 (Ferrari 296 GT3)", "GT3 (Porsche 992 GT3 R)"],
    focus: "Vehicle Dynamics, 60 Hz MoTeC Telemetry Analysis & 24H Endurance Strategy",
    hardware: "Direct Drive 25Nm · Loadcell Hydraulic Pedals · Triple Screen Sim Rig",
    competitions: ["iRacing 24H Le Mans", "24H Spa-Francorchamps", "Sebring 12H", "IMSA Michelin Endurance Cup"],
    bio: "Fundador y Team Principal de Muntrume Motorsport. Especialista en arquitectura de amortiguadores, telemetría a 60 Hz y estrategias de paradas para pruebas de resistencia de 24 horas en prototipos GTP y GT3.",
    email: "alberto@muntru.me",
    initials: "AT",
    carName: "Aston Martin Valkyrie AMR Pro & Ferrari 296 GT3",
    carClass: "GTP Prototype & GT3 Endurance",
    carImg: "/assets/img/coche1-640.webp",
    telemetryMetrics: [
      { label: "Frecuencia MoTeC", value: "60 Hz can-bus i2 Pro" },
      { label: "Brake Bias Típico", value: "53.6% - 54.2% con Trail" },
      { label: "FFB Torque Directo", value: "25 Nm Lineal 1:1" },
      { label: "Gestión Neumático", value: "Preservación térmica en doble stint" }
    ],
    careerHighlights: [
      "Líder del programa de telemetría y desarrollo de más de 239.539 setups en Muntrume Vault.",
      "Finalista en competiciones oficiales iRacing Special Events 24H Le Mans y Spa 24H.",
      "Arquitecto del pipeline de sincronización local directa con Garage 61 para el equipo."
    ]
  },
  "mateo-berbis": {
    slug: "mateo-berbis",
    number: "#2",
    name: "Mateo Berbis",
    badge: "OFFICIAL DRIVER",
    badgeColor: "text-amber-400 bg-amber-500/10 border-amber-500/20",
    avatarColor: "border-amber-400 bg-amber-950/60 text-amber-300",
    role: "Lead Qualifying & Sprint Driver",
    team: "Muntrume Motorsport",
    categories: ["GT3 (Ferrari 296 GT3)", "GT3 (BMW M4 GT3)", "GT3 Sprint Challenge"],
    focus: "One-Lap Qualifying Pace, Apex Precision & High-Pressure Overtaking",
    hardware: "Direct Drive Wheel · Loadcell Pedals · Ultrawide Curved Display",
    competitions: ["GT3 Sprint Series", "Bathurst 12H", "Watkins Glen 6H", "VRS GT Challenge"],
    bio: "Piloto oficial de velocidad pura y clasificación. Especialista en vuelta rápida bajo presión, frenadas al límite sin bloqueo y gestión quirúrgica del tráfico en parrillas GT3 de máxima exigencia.",
    email: "mateo@muntru.me",
    initials: "MB",
    carName: "Ferrari 296 GT3 & BMW M4 GT3",
    carClass: "GT3 Sprint & VRS Challenge",
    carImg: "/assets/img/coche2-640.webp",
    telemetryMetrics: [
      { label: "Especialidad Vuelta", value: "Clasificación con gomas nuevas" },
      { label: "Velocidad en Vértice", value: "+2.4 km/h delta en curvas medias" },
      { label: "Trail Braking", value: "Liberación gradual de 85% a 15%" },
      { label: "Coches Homologados", value: "Ferrari 296 · BMW M4 GT3" }
    ],
    careerHighlights: [
      "Pole positions consecutivas en series de clasificación GT3 en iRacing.",
      "Top split en las 12 Horas de Bathurst al volante del Ferrari 296 GT3.",
      "Desarrollo de los paquetes de clasificación rápida (Q-Trim) para el Setup Vault."
    ]
  },
  "eduardo-chongkan": {
    slug: "eduardo-chongkan",
    number: "#3",
    name: "Eduardo Chongkan",
    badge: "DRIVER & RACE ENGINEER",
    badgeColor: "text-slate-300 bg-slate-500/15 border-slate-400/30",
    avatarColor: "border-slate-400 bg-slate-900/60 text-slate-200",
    role: "Race Engineer & Prototype Pilot",
    team: "Muntrume Motorsport",
    categories: ["GTP (Cadillac V-Series.R)", "LMP2 Prototype (Dallara P217)", "GT3 (Porsche 992 GT3 R)"],
    focus: "Damper Velocity Curves, Tire Degradation Modeling & Stint Consistency",
    hardware: "Direct Drive Pro · Inverted Hydraulic Pedals · Dedicated MoTeC Telemetry Dash",
    competitions: ["Petit Le Mans", "24H Nürburgring Nordschleife", "Glen 6H", "Global Endurance Series"],
    bio: "Ingeniero de pista y piloto de prototipos. Especialista en curvas de amortiguación hidráulica, optimización del desgaste de neumáticos y mantenimiento de ritmos constantes vuelta tras vuelta en relevos triples.",
    email: "eduardo@muntru.me",
    initials: "EC",
    carName: "Cadillac V-Series.R GTP & Dallara P217",
    carClass: "GTP Hypercar & LMP2 Prototype",
    carImg: "/assets/img/coche3-640.webp",
    telemetryMetrics: [
      { label: "Curva de Amortiguación", value: "Compresión rápida diferenciada" },
      { label: "Desgaste Stint Largo", value: "Delta < 0.18s por vuelta" },
      { label: "Freno Hidráulico", value: "Sensor de presión 100 bar" },
      { label: "Aero Balance", value: "Ajuste milimétrico de flap trasero" }
    ],
    careerHighlights: [
      "Ingeniero de pista principal para los programas de resistencia en prototipos GTP.",
      "Participación en Petit Le Mans y las 24H de Nürburgring Nordschleife.",
      "Calibración de mapas de amortiguación para trazados bacheados como Sebring."
    ]
  },
  "juanlu-carrillo": {
    slug: "juanlu-carrillo",
    number: "#4",
    name: "Juanlu Carrillo",
    badge: "OFFICIAL DRIVER",
    badgeColor: "text-orange-400 bg-orange-500/10 border-orange-500/20",
    avatarColor: "border-orange-500 bg-orange-950/60 text-orange-400",
    role: "Single-Seater & Formula Specialist",
    team: "Muntrume Motorsport",
    categories: ["Super Formula Lights (SFL 324)", "FIA Formula 4", "GT3 Endurance"],
    focus: "High-Downforce Aero Balance, Single-Seater Racecraft & Wheel-to-Wheel Combat",
    hardware: "Direct Drive Pro · Dual Clutch Formula Wheel · Loadcell Pedals",
    competitions: ["Super Formula Lights Championship", "FIA F4 Regional", "24H Daytona", "Formula Sprint"],
    bio: "Especialista en monoplazas y alta carga aerodinámica. Su precisión milimétrica en curvas rápidas y su capacidad de defensa cuerpo a cuerpo aportan versatilidad competitiva al equipo en circuitos internacionales.",
    email: "juanlu@muntru.me",
    initials: "JC",
    carName: "Super Formula Lights (SFL 324) & FIA F4",
    carClass: "High-Downforce Open Wheel",
    carImg: "/assets/img/coche4-640.webp",
    telemetryMetrics: [
      { label: "Carga Aerodinámica", value: "Sensibilidad a la altura del splitter" },
      { label: "Embrague Dual", value: "Launch control calibrado para salida" },
      { label: "Fuerza G Lateral", value: "Picos de 3.8G en curvas de alta" },
      { label: "Especialidad", value: "Monoplazas SFL y Fórmula 4" }
    ],
    careerHighlights: [
      "Líder del programa de monoplazas Super Formula Lights en trazados asiáticos y europeos.",
      "Especialista en salidas de carrera y maniobras de adelantamiento en chicane.",
      "Desarrollador de los setups oficiales de SFL en el Vault de Muntrume."
    ]
  }
};

export function getStaticPaths() {
  return [
    { params: { slug: "alberto-trujillo" } },
    { params: { slug: "mateo-berbis" } },
    { params: { slug: "eduardo-chongkan" } },
    { params: { slug: "juanlu-carrillo" } }
  ];
}

const { slug } = Astro.params;
const driver = DRIVERS[slug as string] || DRIVERS["alberto-trujillo"];

const pageTitle = `${driver.name} (${driver.number}) · Ficha Oficial del Piloto — Muntrume Motorsport`;
const pageDescription = `${driver.name} (${driver.number}), ${driver.role} en Muntrume Motorsport. Ficha técnica, telemetría y coche principal: ${driver.carName}.`;
const pageUrl = `https://muntru.me/p/${driver.slug}/`;

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "url": pageUrl,
      "name": pageTitle,
      "mainEntity": { "@id": `${pageUrl}#person` }
    },
    {
      "@type": "Person",
      "@id": `${pageUrl}#person`,
      "name": driver.name,
      "url": pageUrl,
      "description": driver.bio,
      "memberOf": {
        "@type": "SportsTeam",
        "name": "Muntrume Motorsport",
        "url": "https://muntru.me/"
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl} schemaJson={personSchema}>
  <main class="pt-28 pb-16 bg-[#0e1217]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <!-- Breadcrumb & Back Navigation -->
      <div class="flex items-center justify-between gap-4 pb-4 border-b border-white/10 text-xs">
        <nav class="flex items-center gap-2 text-neutral-400" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition">Overview</a>
          <span>/</span>
          <a href="/team" class="hover:text-white transition">Drivers</a>
          <span>/</span>
          <span class="text-emerald-400 font-semibold">{driver.name}</span>
        </nav>
        <a href="/team" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#161c24] border border-white/10 text-neutral-300 hover:text-white hover:border-white/20 transition">
          <span>&larr;</span>
          <span>Volver a Plantilla</span>
        </a>
      </div>

      <!-- Main Driver Hero Card -->
      <div class="bg-[#161c24] rounded-3xl p-6 sm:p-10 border border-white/10 relative overflow-hidden shadow-2xl">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8 relative z-10">
          
          <!-- Avatar Initial Circle with Number Badge -->
          <div class="relative flex-shrink-0">
            <div class={`w-32 h-32 sm:w-40 sm:h-40 rounded-3xl border-2 flex items-center justify-center text-4xl sm:text-5xl font-black font-mono shadow-2xl ${driver.avatarColor}`}>
              {driver.initials}
            </div>
            <div class="absolute -bottom-3 -right-3 px-3.5 py-1 rounded-xl bg-[#0b0e13] border-2 border-white/20 text-white font-mono font-black text-base shadow-lg">
              {driver.number}
            </div>
          </div>

          <!-- Driver Identity & Role Header -->
          <div class="flex-1 text-center md:text-left space-y-4">
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
              <span class={`text-[11px] font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full border ${driver.badgeColor}`}>
                {driver.badge}
              </span>
              <span class="text-[11px] font-semibold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300">
                iRacing Official Squad
              </span>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-400">
                Sant Andreu, Barcelona
              </span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
              {driver.name}
            </h1>

            <p class="text-sm sm:text-base text-neutral-300 leading-relaxed max-w-3xl">
              {driver.bio}
            </p>

            <!-- Action CTAs -->
            <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-3">
              <a href="/setups" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-emerald-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>Acceder a Setups del Vault</span>
              </a>
              <a href={`/mail`} class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-xs border border-white/10 transition-all font-mono">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <span>{driver.email}</span>
              </a>
              <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-white/5 hover:bg-white/10 text-neutral-300 font-semibold text-xs border border-white/10 transition-all">
                <span>Discord de Carrera</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      <!-- CAR & MACHINERY SHOWCASE -->
      <div class="bg-[#161c24] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-5 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase">
              <span>Vehículo Oficial en Competición</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
              {driver.carName}
            </h2>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Configuración y telemetría de carrera ajustada en banco de pruebas para la temporada actual en iRacing.
            </p>
            <div class="pt-2 flex flex-wrap gap-2 text-xs font-mono">
              <span class="px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-neutral-200">
                Clase: <strong class="text-white">{driver.carClass}</strong>
              </span>
              <span class="px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-neutral-200">
                Sincronización: <strong class="text-emerald-400">Garage 61</strong>
              </span>
            </div>
          </div>

          <div class="lg:col-span-7">
            <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-[#0e1217]">
              <img 
                src={driver.carImg} 
                alt={driver.carName}
                width="640" 
                height="360"
                class="w-full h-64 sm:h-80 object-cover object-center"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#161c24] via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs font-mono text-neutral-300 bg-[#0e1217]/80 backdrop-blur-md px-4 py-2.5 rounded-xl border border-white/10">
                <span>Muntrume Official Livery</span>
                <span class="text-emerald-400 font-bold">Temporada 2026</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- DRIVER TECHNICAL SPECS & TELEMETRY GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Spec Card 1: Categories -->
        <div class="p-6 rounded-2xl bg-[#161c24] border border-white/10 space-y-4 shadow-lg">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Categorías &amp; Coches</span>
            </h3>
            <span class="text-[10px] font-mono text-emerald-400 font-bold">iRacing</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {driver.categories.map((cat) => (
              <span class="px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-xs text-neutral-200 font-medium">
                {cat}
              </span>
            ))}
          </div>
        </div>

        <!-- Spec Card 2: Technical Focus -->
        <div class="p-6 rounded-2xl bg-[#161c24] border border-white/10 space-y-4 shadow-lg">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Especialidad Técnica</span>
            </h3>
            <span class="text-[10px] font-mono text-cyan-400 font-bold">Telemetría</span>
          </div>
          <p class="text-xs text-neutral-300 leading-relaxed font-mono">
            {driver.focus}
          </p>
          <div class="pt-2 text-[11px] text-neutral-400 font-mono">
            Rig &amp; Hardware: <span class="text-white">{driver.hardware}</span>
          </div>
        </div>

        <!-- Spec Card 3: Competitions -->
        <div class="p-6 rounded-2xl bg-[#161c24] border border-white/10 space-y-4 shadow-lg md:col-span-2 lg:col-span-1">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <span>Competiciones Destacadas</span>
            </h3>
            <span class="text-[10px] font-mono text-amber-400 font-bold">Endurance</span>
          </div>
          <ul class="space-y-1.5 text-xs text-neutral-300">
            {driver.competitions.map((comp) => (
              <li class="flex items-center gap-2">
                <span class="text-emerald-400 font-bold">•</span>
                <span>{comp}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <!-- TELEMETRY METRICS & HIGHLIGHTS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Telemetry Data Strip -->
        <div class="p-6 rounded-2xl bg-[#161c24] border border-white/10 space-y-4 shadow-lg">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Parámetros de Telemetría Homologados</span>
            </h3>
            <span class="text-[10px] font-mono text-neutral-400">MoTeC i2 Pro</span>
          </div>
          <div class="space-y-3">
            {driver.telemetryMetrics.map((item) => (
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 text-xs font-mono">
                <span class="text-neutral-400">{item.label}</span>
                <span class="text-emerald-400 font-bold">{item.value}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Career Highlights -->
        <div class="p-6 rounded-2xl bg-[#161c24] border border-white/10 space-y-4 shadow-lg">
          <div class="flex items-center justify-between pb-3 border-b border-white/10">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Hitos en el Equipo &amp; Trayectoria</span>
            </h3>
            <span class="text-[10px] font-mono text-emerald-400 font-bold">2026</span>
          </div>
          <ul class="space-y-3 text-xs text-neutral-300">
            {driver.careerHighlights.map((hl) => (
              <li class="flex items-start gap-2.5 p-3 rounded-xl bg-white/5 border border-white/5">
                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">🏁</span>
                <span class="leading-relaxed">{hl}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>

      <!-- SQUAD TEAMMATES SWITCHER STRIP -->
      <div class="pt-4 border-t border-white/10">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-xs font-bold text-neutral-400 uppercase tracking-wider">
            Otros Pilotos del Equipo
          </h3>
          <a href="/team" class="text-xs text-emerald-400 hover:text-emerald-300 font-bold">
            Ver Plantilla Completa &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {Object.values(DRIVERS).map((d) => (
            <a 
              href={`/p/${d.slug}/`} 
              class={`p-3.5 rounded-2xl border transition flex items-center gap-3 ${d.slug === driver.slug ? 'bg-emerald-500/10 border-emerald-500/40' : 'bg-[#161c24] border-white/10 hover:border-white/20'}`}
            >
              <div class="w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center font-mono font-bold text-xs text-emerald-400 shrink-0">
                {d.initials}
              </div>
              <div class="min-w-0">
                <div class="text-xs font-bold text-white truncate">{d.name}</div>
                <div class="text-[10px] font-mono text-neutral-400">{d.number}</div>
              </div>
            </a>
          ))}
        </div>
      </div>

    </div>
  </main>
</Layout>
