---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const fallbackPilots = [
    { slug: "alberto-trujillo", name: "Alberto Trujillo", role: "Founder · Driver", team: "Muntrume Motorsport", car_class: "GTP / GT3", bio: "Sim racer & vehicle dynamics specialist." },
    { slug: "mateo-berbis", name: "Mateo Berbis", role: "Driver", team: "Muntrume Motorsport", car_class: "GT3", bio: "Endurance & sprint racing driver." },
    { slug: "eduardo-chongkan", name: "Eduardo Chongkan", role: "Driver", team: "Muntrume Motorsport", car_class: "GT3 / GTP", bio: "Telemetry & consistency driver." },
    { slug: "juanlu-carrillo", name: "Juanlu Carrillo", role: "Driver", team: "Muntrume Motorsport", car_class: "GT3", bio: "Sim racer & endurance driver." }
  ];

  let pilots = fallbackPilots;
  try {
    const res = await fetch("https://muntrume.atrumin16.workers.dev/api/pilots", {
      headers: { "User-Agent": "muntrume-astro-build" }
    });
    if (res.ok) {
      const data = await res.json();
      if (data && data.success && Array.isArray(data.pilots) && data.pilots.length > 0) {
        pilots = data.pilots;
      }
    }
  } catch (err) {
    console.warn("Could not reach pilots API during build, using verified roster fallbacks.");
  }

  return pilots.map((p) => ({
    params: { slug: p.slug },
    props: { pilot: p }
  }));
}

const { slug } = Astro.params;
const { pilot } = Astro.props;

const pageTitle = `${pilot.name} · Muntrume Motorsport`;
const pageDescription = [pilot.name, pilot.team, pilot.car_class].filter(Boolean).join(" · ") + (pilot.bio ? ` — ${pilot.bio}` : " — Muntrume Motorsport");
const pageUrl = `https://muntru.me/p/${slug}/`;

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "url": pageUrl,
      "name": pageTitle,
      "mainEntity": { "@id": `${pageUrl}#person` }
    },
    {
      "@type": "Person",
      "@id": `${pageUrl}#person`,
      "name": pilot.name,
      "url": pageUrl,
      ...(pilot.photo ? { "image": pilot.photo } : {}),
      ...(pilot.bio ? { "description": pilot.bio } : {}),
      "memberOf": {
        "@type": "SportsTeam",
        "name": "Muntrume Motorsport",
        "url": "https://muntru.me/"
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} canonical={pageUrl} schemaJson={personSchema}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back button -->
    <div class="mb-8">
      <a href="/pilotos" class="inline-flex items-center gap-2 text-sm text-emerald-400 hover:text-emerald-300 font-medium transition-colors">
        <span aria-hidden="true">←</span>
        <span>All pilots</span>
      </a>
    </div>

    <!-- Pilot Detail Container -->
    <article id="pilotDetail" class="pl-detail">
      <div class="glass-card rounded-2xl p-6 sm:p-10 border border-white/10 relative overflow-hidden">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
          
          <!-- Avatar / Photo -->
          <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl overflow-hidden bg-neutral-900 border-2 border-emerald-500/30 shadow-xl flex-shrink-0 flex items-center justify-center">
            {pilot.photo ? (
              <img src={pilot.photo} alt={pilot.name} class="w-full h-full object-cover" />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-emerald-950 to-neutral-900 flex items-center justify-center text-emerald-400 font-black text-4xl">
                {pilot.name.charAt(0)}
              </div>
            )}
          </div>

          <!-- Bio & Credentials -->
          <div class="flex-grow text-center md:text-left space-y-4">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-2">
                {pilot.role || "Official Driver"}
              </div>
              <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">{pilot.name}</h1>
              <p class="text-neutral-400 text-sm mt-1">{pilot.team || "Muntrume Motorsport"} · {pilot.car_class || "GT3 / GTP"}</p>
            </div>

            {pilot.bio && (
              <p class="text-neutral-300 text-base max-w-2xl leading-relaxed">{pilot.bio}</p>
            )}

            <!-- Active Setups & Telemetry Quick Link -->
            <div class="pt-4 flex flex-wrap items-center justify-center md:justify-start gap-3">
              <a href="/setups" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-sm transition-all shadow-lg shadow-emerald-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>Access Team Setups</span>
              </a>
              <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/10 transition-all">
                <span>Contact via Discord</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </article>
  </section>

  <script is:inline define:vars={{ pilotSlug: slug }}>
    window.MM_PILOT_SLUG = pilotSlug;
  </script>
  <script is:inline src="/assets/js/pilots.js"></script>
</Layout>
