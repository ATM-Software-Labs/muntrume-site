---
import Layout from "../layouts/Layout.astro";
import desktopPkg from "../../desktop/package.json";
import { OFFICIAL_BRAND_PATHS } from "../../desktop/src/cars/brand-icons";
import { getCarBrandInfo, getSupportedBrandsCatalog } from "../../desktop/src/brand-logos";

const appVersion = desktopPkg.version;
const releaseUrl = "https://github.com/ATM-Software-Labs/muntrume-site/releases/latest";
const repoUrl = "https://github.com/ATM-Software-Labs/muntrume-site/tree/main/desktop";

const pageTitle = "MMT Sync Overlays · 60 FPS iRacing Telemetry HUD";
const pageDescription = `MMT Sync Overlays v${appVersion}: lightweight native 60 FPS iRacing HUD with multiclass Standings, Relative, Catmull-Rom Track Map, Fuel calculator, and Radar. MMT.`;
const pageUrl = "https://muntru.me/overlay/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";

const supportedBrands = getSupportedBrandsCatalog();

// Extract only the manufacturer SVG paths & colors from desktop/src/brand-logos.ts (single source of truth)
const simBrandSamples: Record<string, string> = {
  ford: "fordmustanggt3",
  porsche: "porsche992rgt3",
  mclaren: "mclaren720sgt3",
  ferrari: "ferrari296gt3",
  lambo: "lamborghinievogt3",
  cadillac: "cadillacvseriesrgtp",
  acura: "acuraarx06gtp",
  bmw: "bmwm4gt3",
  dallara: "dallarap217",
  mercedes: "mercedesamgevogt3",
  aston: "amvantageevogt3",
};
const SIM_BRAND_PATHS: Record<string, { svg: string; color: string; name: string }> = Object.fromEntries(
  Object.entries(simBrandSamples).map(([key, sampleCar]) => {
    const info = getCarBrandInfo(sampleCar);
    return [
      key,
      {
        svg: info.svg,
        color: info.color,
        name: info.name,
      },
    ];
  })
);

const overlaySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { "@id": "https://muntru.me/#website" },
      about: { "@id": `${pageUrl}#software` },
      primaryImageOfPage: ogImage,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${pageUrl}#software`,
      name: "MMT Sync Overlays",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Windows 10, Windows 11",
      softwareVersion: appVersion,
      url: pageUrl,
      downloadUrl: releaseUrl,
      description: pageDescription,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR",
      },
      publisher: { "@id": "https://muntru.me/#org" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://muntru.me/" },
        { "@type": "ListItem", position: 2, name: "Overlay HUD", item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="mmt sync overlays, iracing hud, iracing overlay gratis, kapps alternativa, racelab alternativa, iracing telemetry hud, standings multiclase iracing, track map iracing, radar helicorsa iracing, muntrume motorsport"
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt="MMT Sync Overlays — Telemetría HUD de baja latencia para iRacing"
  ogImageWidth={1200}
  ogImageHeight={630}
  schemaJson={overlaySchema}
>
  <div class="ov-page">
    <!-- ===================================================================== -->
    <!-- 1. HERO & DESCARGA DIRECTA                                            -->
    <!-- ===================================================================== -->
    <section class="ov-hero">
      <div class="ov-container">
        <div class="ov-hero__badges">
          <span class="ov-pill ov-pill--live">
            <span class="ov-dot" aria-hidden="true"></span>
            <span>MMT Sync HUD · v{appVersion}</span>
          </span>
          <span class="ov-pill">Windows 10/11 · iRacing SDK nativo</span>
          <span class="ov-pill">60 FPS · Click-Through</span>
          <a href="#opensource" class="ov-pill ov-pill--oss" style="text-decoration:none;">
            100 % Open Source · Licencia MIT
          </a>
        </div>

        <h1 class="ov-hero__title">
          MMT Sync Overlays — <span class="ov-accent">Telemetría HUD</span> de baja latencia para iRacing
        </h1>

        <p class="ov-hero__lead">
          Superposiciones nativas transparentes <code>click-through</code> a 60 FPS diseñadas con la densidad visual, legibilidad y ergonomía de los estándares clásicos de competición (Kapps / Racelab), con <strong>0 % de consumo de CPU</strong> cuando un módulo está desactivado.
        </p>

        <div class="ov-hero__actions">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ov-btn ov-btn--primary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span>Descargar última release (v{appVersion})</span>
          </a>

          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ov-btn ov-btn--secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
            <span>Código y documentación</span>
          </a>

          <a href="#simulador-hud" class="ov-btn ov-btn--ghost">
            <span>Probar simulador en vivo ↓</span>
          </a>
        </div>

        <div class="ov-specs">
          <div class="ov-spec">
            <span class="ov-spec__val">60 Hz</span>
            <span class="ov-spec__lbl">Lectura memoria compartida iRSDK</span>
          </div>
          <div class="ov-spec">
            <span class="ov-spec__val">0 % CPU</span>
            <span class="ov-spec__lbl">En módulos desactivados</span>
          </div>
          <div class="ov-spec">
            <span class="ov-spec__val">Tauri v2</span>
            <span class="ov-spec__lbl">Core Rust + TypeScript nativo</span>
          </div>
          <div class="ov-spec">
            <span class="ov-spec__val">SHA-256</span>
            <span class="ov-spec__lbl">Releases verificadas en GitHub</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. PREVISUALIZACIÓN INTERACTIVA EN VIVO DEL HUD                       -->
    <!-- ===================================================================== -->
    <section id="simulador-hud" class="ov-section">
      <div class="ov-container">
        <div class="ov-section__head">
          <div>
            <p class="ov-kicker">Simulador interactivo en navegador · Silverstone GP</p>
            <h2 class="ov-section__title">Prueba los 8 módulos del HUD en tiempo real</h2>
            <p class="ov-section__sub">
              Activa o desactiva cada módulo, aplica presets instantáneos (<strong>Sprint GT3</strong>, <strong>Endurance</strong>, <strong>Minimalist Qualy</strong>), bloquea el HUD o alterna entre <strong>Pista (P)</strong> y <strong>Replay (R)</strong>.
            </p>
          </div>
        </div>

        <!-- Barra de control interactiva -->
        <div class="sim-toolbar" data-no-translate role="region" aria-label="Controles del simulador HUD">
          <div class="sim-toolbar__group">
            <span class="sim-toolbar__label" data-i18n="ov.modules">MÓDULOS:</span>
            <button type="button" class="sim-chip is-on" data-toggle-mod="standings" aria-pressed="true">
              <span class="sim-chip__dot"></span>Standings
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="relative" aria-pressed="true">
              <span class="sim-chip__dot"></span>Relative
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="trackmap" aria-pressed="true">
              <span class="sim-chip__dot"></span>Track Map
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="fuel" aria-pressed="true">
              <span class="sim-chip__dot"></span>Fuel Calc
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="pit" aria-pressed="true">
              <span class="sim-chip__dot"></span>Pit Strategy
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="tires" aria-pressed="true">
              <span class="sim-chip__dot"></span>Tire &amp; Track
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="inputs" aria-pressed="true">
              <span class="sim-chip__dot"></span>Inputs &amp; Delta
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="radar" aria-pressed="true">
              <span class="sim-chip__dot"></span>Radar
            </button>
          </div>

          <div class="sim-toolbar__group sim-toolbar__right">
            <span class="sim-toolbar__label" data-i18n="ov.presets">PRESETS:</span>
            <button type="button" class="sim-action-btn" data-sim-preset="all_on">Full HUD (8/8)</button>
            <button type="button" class="sim-action-btn" data-sim-preset="sprint_gt3">Sprint GT3</button>
            <button type="button" class="sim-action-btn" data-sim-preset="endurance_multi">Endurance</button>
            <button type="button" class="sim-action-btn" data-sim-preset="minimal_qualy">Minimalist Qualy</button>
            <button type="button" id="simResetPosBtn" class="sim-action-btn" title="Restaurar posiciones originales del HUD">↺ Reset Layout</button>
            <button type="button" id="simLockHudBtn" class="sim-action-btn" aria-pressed="false" title="Bloquear o desbloquear arrastre de widgets">🔒 Lock HUD</button>
            <div class="sim-mode-switch" role="group" aria-label="Modo de sesión">
              <button type="button" id="simModeTrack" class="sim-mode-btn is-active" aria-pressed="true">
                Track <kbd>P</kbd>
              </button>
              <button type="button" id="simModeReplay" class="sim-mode-btn" aria-pressed="false">
                Replay <kbd>R</kbd>
              </button>
            </div>
            <button type="button" id="simNextCircuitBtn" class="sim-action-btn" title="Rotar circuito (Silverstone / Spa / Daytona / Interlagos)">
              Circuit ↻
            </button>
            <button type="button" id="simTriggerRadar" class="sim-action-btn" title="Simular coche en paralelo (1-wide / 3-wide)">
              3-Wide
            </button>
            <button type="button" id="simPauseBtn" class="sim-action-btn" aria-pressed="false">
              Pause
            </button>
          </div>
        </div>

        <!-- Lienzo de Cabina Simulada 16:9 (60 FPS Canvas + Posición Real iRacing) -->
        <div class="sim-stage" id="simStage" data-no-translate>
          <canvas id="simTrackBackdropCanvas" class="sim-backdrop" aria-hidden="true"></canvas>

          <!-- Barra superior de estado del simulador -->
          <div class="sim-statusbar">
            <div class="sim-statusbar__left">
              <span class="sim-status-tag" id="simCircuitBanner">SILVERSTONE GP · IMSA MULTICLASS</span>
              <span class="sim-status-meta" id="simLapClock">LAP 14/28 · 18:42 REM</span>
              <span class="sim-status-hint" id="simDragHint">⠿ Arrastra cualquier widget · Clic en piloto para enfocar</span>
            </div>
            <div class="sim-statusbar__right">
              <span class="sim-replay-badge" id="simReplayBadge" hidden>REPLAY · isReplayPlaying=true · Controles de pilotaje ocultos</span>
              <span class="sim-fps-badge" id="simCpuBadge">60 FPS · 8/8 activos</span>
            </div>
          </div>

          <!-- Visor Ergonomía Real iRacing (16:9 Cockpit Layout) -->
          <div class="sim-cockpit-layer" id="simCockpitLayer">
            <!-- ARRIBA IZQUIERDA (top: 12px; left: 12px): STANDINGS MULTICLASE KAPPS -->
            <div class="hud-box hud-standings hud-pos-standings" data-hud-mod="standings">
              <div class="hud-std-sessbar">
                <div class="flex items-center gap-2">
                  <span class="font-extrabold text-white">RACE</span>
                  <span class="px-1 rounded-[2px] font-extrabold text-[9.5px] bg-[#facc15]/20 text-[#facc15]">IMSA</span>
                  <span class="text-white/90">1:12:58/2h</span>
                </div>
                <div class="flex items-center gap-2 text-white/80">
                  <span>20°C</span>
                  <span>11/11</span>
                </div>
              </div>
              <div class="hud-std-colbar">
                <span>P</span>
                <span>#</span>
                <span>PILOTO</span>
                <span></span>
                <span>LIC / iR</span>
                <span class="text-right">GAP</span>
                <span class="text-right">INT</span>
                <span class="text-right">LAST</span>
              </div>
              <div class="hud-standings__body" id="simStandingsBody"></div>
            </div>

            <!-- CENTRO SUPERIOR (top: 14px; left: 50%): DELTA BAR (Retrovisor) -->
            <div class="hud-box hud-delta hud-pos-delta" data-hud-mod="inputs" data-driving-only="true">
              <div class="hud-delta__row">
                <span class="hud-delta__tag">SESSION BEST Δ</span>
                <span class="hud-delta__val" id="simDeltaVal">-0.28s</span>
              </div>
              <div class="hud-delta__track">
                <div class="hud-delta__center"></div>
                <div class="hud-delta__fill" id="simDeltaFill"></div>
              </div>
            </div>

            <!-- ARRIBA DERECHA (top: 12px; right: 12px): RELATIVE COMPACTO KAPPS -->
            <div class="hud-box hud-relative hud-pos-relative" data-hud-mod="relative">
              <div class="hud-box__head">
                <span class="hud-box__title">RELATIVE · Δ PISTA</span>
                <span class="hud-box__meta" id="simRelFocusTag">#16 A. Trujillo</span>
              </div>
              <div class="hud-relative__body" id="simRelativeBody"></div>
            </div>

            <!-- DEBAJO DE RELATIVE (top: 184px; right: 12px): TRACK MAP KAPPS -->
            <div class="hud-box hud-trackmap hud-pos-trackmap" data-hud-mod="trackmap">
              <div class="hud-box__head">
                <span class="hud-box__title" id="simTrackMapTitle">TRACK MAP · SILVERSTONE GP</span>
                <span class="hud-box__meta">GPS 60Hz</span>
              </div>
              <div class="hud-trackmap__canvas">
                <svg id="simTrackSvg" viewBox="0 0 280 200" class="hud-trackmap__svg" aria-label="Mapa de circuito en vivo">
                  <path id="simTrackOutline" fill="none" stroke="rgba(248,250,252,0.55)" stroke-width="9" stroke-linejoin="round" stroke-linecap="round"/>
                  <path id="simTrackLine" fill="none" stroke="#090b0f" stroke-width="6" stroke-linejoin="round" stroke-linecap="round"/>
                  <line id="simSfLine" x1="0" y1="0" x2="0" y2="0" stroke="#ffffff" stroke-width="2.5"/>
                  <g id="simTrackDots"></g>
                </svg>
              </div>
            </div>

            <!-- CENTRO INFERIOR (bottom: 128px; left: 50%): RADAR CARLEFTRIGHT -->
            <div class="hud-radar-wrap hud-pos-radar" id="simRadarCard" data-hud-mod="radar" data-driving-only="true">
              <div class="hud-radar" id="simRadar" data-state="clear" aria-live="polite">
                <svg viewBox="0 0 180 180" class="hud-radar__svg" aria-label="Radar de proximidad lateral">
                  <circle cx="90" cy="90" r="78" fill="rgba(9,11,15,0.78)" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
                  <circle cx="90" cy="90" r="46" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="4 4"/>
                  <path id="radarArcLeft" d="M 38 38 A 74 74 0 0 0 38 142" fill="none" stroke="transparent" stroke-width="8" stroke-linecap="round"/>
                  <path id="radarArcRight" d="M 142 38 A 74 74 0 0 1 142 142" fill="none" stroke="transparent" stroke-width="8" stroke-linecap="round"/>
                  <rect x="78" y="64" width="24" height="52" rx="6" fill="#10b981" fill-opacity="0.22" stroke="#10b981" stroke-width="1.6"/>
                  <line x1="90" y1="68" x2="90" y2="78" stroke="#34d399" stroke-width="2" stroke-linecap="round"/>
                  <rect id="radarCarLeft" x="34" y="70" width="20" height="44" rx="5" fill="#f59e0b" fill-opacity="0" stroke="#f59e0b" stroke-opacity="0" stroke-width="1.5"/>
                  <rect id="radarCarRight" x="126" y="74" width="20" height="44" rx="5" fill="#ef4444" fill-opacity="0" stroke="#ef4444" stroke-opacity="0" stroke-width="1.5"/>
                </svg>
                <div class="hud-radar__label" id="simRadarLabel">CLEAR</div>
              </div>
            </div>

            <!-- ABAJO CENTRO (bottom: 14px; left: 50%): INPUT TELEMETRY (Pedales + Marcha + Velocidad) -->
            <div class="hud-box hud-inputs hud-pos-inputs" data-hud-mod="inputs" data-driving-only="true">
              <div class="hud-inputs__trace">
                <canvas id="simPedalCanvas" width="230" height="62" aria-label="Gráfica de pedales en vivo"></canvas>
              </div>
              <div class="hud-inputs__bars">
                <div class="pedal-col">
                  <div class="pedal-bar"><div class="pedal-fill pedal-fill--clutch" id="simClutchBar" style="height:0%"></div></div>
                  <span class="pedal-lbl">C</span>
                </div>
                <div class="pedal-col">
                  <div class="pedal-bar"><div class="pedal-fill pedal-fill--brake" id="simBrakeBar" style="height:0%"></div></div>
                  <span class="pedal-lbl">B</span>
                </div>
                <div class="pedal-col">
                  <div class="pedal-bar"><div class="pedal-fill pedal-fill--throttle" id="simThrottleBar" style="height:82%"></div></div>
                  <span class="pedal-lbl">T</span>
                </div>
              </div>
              <div class="hud-inputs__gear">
                <span class="gear-val" id="simGear">4</span>
                <span class="speed-val" id="simSpeed">214</span>
                <span class="speed-unit">KM/H</span>
              </div>
            </div>

            <!-- ABAJO DERECHA (bottom: 14px; right: 12px): FUEL & STINT CALCULATOR -->
            <div class="hud-box hud-fuel hud-pos-fuel" data-hud-mod="fuel">
              <div class="hud-box__head">
                <span class="hud-box__title">FUEL &amp; STINT CALC</span>
                <span class="hud-box__meta">FILTRO FCY / PIT</span>
              </div>
              <div class="hud-fuel__grid">
                <div class="fuel-cell">
                  <span class="fuel-lbl">FUEL REM</span>
                  <span class="fuel-val" id="simFuelRem">34.8 L</span>
                </div>
                <div class="fuel-cell">
                  <span class="fuel-lbl">AVG L/LAP</span>
                  <span class="fuel-val fuel-val--emerald" id="simFuelAvg">2.84 L</span>
                </div>
                <div class="fuel-cell">
                  <span class="fuel-lbl">LAPS EST.</span>
                  <span class="fuel-val" id="simFuelLaps">12.2</span>
                </div>
                <div class="fuel-cell fuel-cell--highlight">
                  <span class="fuel-lbl">TO ADD (+1.5L)</span>
                  <span class="fuel-val fuel-val--amber" id="simFuelAdd">+9.4 L</span>
                </div>
              </div>
              <div class="hud-fuel__bar-wrap">
                <div class="hud-fuel__bar" id="simFuelBar" style="width: 44%"></div>
              </div>
            </div>

            <!-- ABAJO IZQUIERDA (bottom: 14px; left: 12px): PIT & STRATEGY WINDOW -->
            <div class="hud-box hud-pit hud-pos-pit" data-hud-mod="pit" data-driving-only="true">
              <div class="hud-box__head">
                <span class="hud-box__title">PIT &amp; STRATEGY</span>
                <span class="px-1.5 py-0.5 rounded-[2px] text-[9px] font-black bg-amber-500/20 text-amber-300" id="simPitAlert">FUEL SAVE +0.12 L/lap</span>
              </div>
              <div class="grid grid-cols-3 gap-1.5 text-center font-mono text-[10px] mt-1">
                <div class="p-1 rounded bg-black/45 border border-white/10">
                  <span class="block text-[8px] text-white/45 uppercase">PIT WINDOW</span>
                  <strong class="text-amber-300" id="simPitWindow">L16–L18</strong>
                </div>
                <div class="p-1 rounded bg-black/45 border border-white/10">
                  <span class="block text-[8px] text-white/45 uppercase">EST. BOX</span>
                  <strong class="text-white" id="simPitTime">27.4s</strong>
                </div>
                <div class="p-1 rounded bg-black/45 border border-white/10">
                  <span class="block text-[8px] text-white/45 uppercase">REJOIN</span>
                  <strong class="text-emerald-300" id="simPitRejoin">P5/18</strong>
                </div>
              </div>
            </div>

            <!-- DERECHA MEDIA (bottom: 122px; right: 12px): TIRE & TRACK TEMP MONITOR -->
            <div class="hud-box hud-tires hud-pos-tires" data-hud-mod="tires">
              <div class="hud-box__head">
                <span class="hud-box__title">TIRE &amp; TRACK TEMP</span>
                <span class="hud-box__meta text-emerald-300">75–92°C</span>
              </div>
              <div class="grid grid-cols-2 gap-1 font-mono text-[10px] mt-1" id="simTiresGrid">
                <div class="flex items-center justify-between px-1.5 py-1 rounded bg-black/45 border border-white/10"><span>FL</span><strong id="simTireFL" class="text-emerald-300">84°C · 174kPa</strong></div>
                <div class="flex items-center justify-between px-1.5 py-1 rounded bg-black/45 border border-white/10"><span>FR</span><strong id="simTireFR" class="text-emerald-300">82°C · 172kPa</strong></div>
                <div class="flex items-center justify-between px-1.5 py-1 rounded bg-black/45 border border-white/10"><span>RL</span><strong id="simTireRL" class="text-emerald-300">79°C · 170kPa</strong></div>
                <div class="flex items-center justify-between px-1.5 py-1 rounded bg-black/45 border border-white/10"><span>RR</span><strong id="simTireRR" class="text-emerald-300">77°C · 169kPa</strong></div>
              </div>
              <div class="flex items-center justify-between font-mono text-[9.5px] text-white/75 mt-1 pt-1 border-t border-white/10">
                <span>Pista <strong id="simTrackTemp" class="text-amber-300">29.2°C</strong></span>
                <span>Viento <strong id="simWind" class="text-white">14 km/h ↗</strong></span>
                <span>Lluvia <strong id="simWetness" class="text-sky-300">0%</strong></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Resumen técnico de los 6 módulos -->
        <div class="ov-mod-grid">
          <article class="ov-card">
            <span class="ov-card__num">01</span>
            <h3>Standings Multiclase</h3>
            <p>Cabeceras por categoría con SOF, barra lateral de color de clase, logos oficiales SVG con <code>fill-rule="evenodd"</code>, badges de Licencia + iRating de alto contraste, ganancia/pérdida de iR en tiempo real y cálculo continuo de <code>GAP</code> e <code>INT</code> tick a tick desde <code>CarIdxLap + CarIdxLapDistPct</code>.</p>
