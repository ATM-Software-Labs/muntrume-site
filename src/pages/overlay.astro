  <!-- Datos de vectores SVG oficiales para el script del simulador -->
  <script id="simBrandData" type="application/json" set:html={JSON.stringify(SIM_BRAND_PATHS)} />

  <script is:inline>
    (() => {
      const brandMap = JSON.parse(document.getElementById("simBrandData")?.textContent || "{}");

      function brandSvg(key, size = 15) {
        const b = brandMap[key];
        if (!b || !b.path) return "";
        return `<span class="hud-brand" style="width:${size}px;height:${size}px;color:${b.color}" title="${b.name}"><svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="${b.path}"/></svg></span>`;
      }

      // -----------------------------------------------------------------------
      // Catmull-Rom Closed Spline for Silverstone GP
      // -----------------------------------------------------------------------
      const silverstonePts = [
        [118, 166], [156, 162], [186, 146], [202, 124], [192, 102],
        [218, 86],  [248, 72],  [246, 46],  [222, 34],  [190, 44],
        [164, 58],  [146, 78],  [118, 66],  [92, 48],   [64, 42],
        [38, 56],   [34, 84],   [56, 100],  [78, 114],  [62, 134],
        [44, 152],  [64, 170],  [92, 168]
      ];

      function sampleCatmullRomClosed(pts, segmentsPerSpan = 10) {
        const n = pts.length;
        const out = [];
        for (let i = 0; i < n; i++) {
          const p0 = pts[(i - 1 + n) % n];
          const p1 = pts[i];
          const p2 = pts[(i + 1) % n];
          const p3 = pts[(i + 2) % n];
          for (let s = 0; s < segmentsPerSpan; s++) {
            const t = s / segmentsPerSpan;
            const t2 = t * t;
            const t3 = t2 * t;
            const x = 0.5 * (
              (2 * p1[0]) +
              (-p0[0] + p2[0]) * t +
              (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 +
              (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3
            );
            const y = 0.5 * (
              (2 * p1[1]) +
              (-p0[1] + p2[1]) * t +
              (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 +
              (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3
            );
            out.push([x, y]);
          }
        }
        return out;
      }

      const splinePts = sampleCatmullRomClosed(silverstonePts, 10);
      const trackPathD = splinePts.map((p, i) => `${i === 0 ? "M" : "L"}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" ") + " Z";
      const outlineEl = document.getElementById("simTrackOutline");
      const lineEl = document.getElementById("simTrackLine");
      const sfEl = document.getElementById("simSfLine");
      if (outlineEl) outlineEl.setAttribute("d", trackPathD);
      if (lineEl) lineEl.setAttribute("d", trackPathD);

      // Perpendicular Start/Finish line at spline index 0
      if (sfEl && splinePts.length > 2) {
        const p0 = splinePts[0];
        const p1 = splinePts[2];
        const dx = p1[0] - p0[0];
        const dy = p1[1] - p0[1];
        const len = Math.hypot(dx, dy) || 1;
        const nx = -dy / len;
        const ny = dx / len;
        sfEl.setAttribute("x1", (p0[0] - nx * 8).toFixed(1));
        sfEl.setAttribute("y1", (p0[1] - ny * 8).toFixed(1));
        sfEl.setAttribute("x2", (p0[0] + nx * 8).toFixed(1));
        sfEl.setAttribute("y2", (p0[1] + ny * 8).toFixed(1));
      }

      function pointOnSpline(pct) {
        const norm = ((pct % 1) + 1) % 1;
        const idx = norm * splinePts.length;
        const i0 = Math.floor(idx) % splinePts.length;
        const i1 = (i0 + 1) % splinePts.length;
        const f = idx - Math.floor(idx);
        return [
          splinePts[i0][0] + (splinePts[i1][0] - splinePts[i0][0]) * f,
          splinePts[i0][1] + (splinePts[i1][1] - splinePts[i0][1]) * f,
        ];
      }

      // -----------------------------------------------------------------------
      // Simulated Multiclass Grid (Silverstone GP — GTP / LMP2 / GT3)
      // -----------------------------------------------------------------------
      const CLASSES = {
        GTP:  { color: "#f59e0b", sof: "3.4k", lapSec: 94.5 },
        LMP2: { color: "#06b6d4", sof: "2.8k", lapSec: 99.8 },
        GT3:  { color: "#10b981", sof: "2.5k", lapSec: 112.4 },
      };

      const LIC_COLOR = { A: "#2563eb", B: "#16a34a", C: "#d97706", D: "#dc2626" };

      const drivers = [
        // GTP
        { id: 1,  num: "01", name: "M. Lindqvist",  cls: "GTP",  brand: "cadillac", lic: "A", sr: "4.99", ir: "3.8k", irDelta: +58, lap: 15, pct: 0.54, speed: 1.003, isPit: false },
        { id: 2,  num: "07", name: "K. Takahashi",  cls: "GTP",  brand: "porsche",  lic: "A", sr: "4.42", ir: "3.3k", irDelta: +24, lap: 15, pct: 0.51, speed: 1.001, isPit: false },
        { id: 3,  num: "24", name: "L. Van Der Berg",cls: "GTP", brand: "bmw",      lic: "A", sr: "3.85", ir: "3.1k", irDelta: -19, lap: 15, pct: 0.45, speed: 0.998, isPit: false },
        // LMP2
        { id: 4,  num: "32", name: "R. Moretti",    cls: "LMP2", brand: "dallara",  lic: "A", sr: "4.10", ir: "2.9k", irDelta: +41, lap: 14, pct: 0.67, speed: 0.946, isPit: false },
        { id: 5,  num: "48", name: "J. O'Connor",   cls: "LMP2", brand: "dallara",  lic: "B", sr: "3.64", ir: "2.7k", irDelta: -14, lap: 14, pct: 0.61, speed: 0.943, isPit: false },
        // GT3 (Focused driver: #16 A. Trujillo)
        { id: 6,  num: "51", name: "D. Rossi",      cls: "GT3",  brand: "ferrari",  lic: "A", sr: "4.65", ir: "2.9k", irDelta: +44, lap: 14, pct: 0.525, speed: 0.844, isPit: false },
        { id: 7,  num: "16", name: "A. Trujillo",   cls: "GT3",  brand: "porsche",  lic: "A", sr: "4.99", ir: "2.7k", irDelta: +65, lap: 14, pct: 0.500, speed: 0.846, isPit: false, isMe: true },
        { id: 8,  num: "88", name: "M. Berbis",     cls: "GT3",  brand: "mercedes", lic: "B", sr: "3.41", ir: "2.4k", irDelta: +18, lap: 14, pct: 0.482, speed: 0.843, isPit: false },
        { id: 9,  num: "77", name: "E. Chongkan",   cls: "GT3",  brand: "mclaren",  lic: "B", sr: "3.12", ir: "2.3k", irDelta: -24, lap: 14, pct: 0.458, speed: 0.841, isPit: false },
        { id: 10, num: "95", name: "T. Schneider",  cls: "GT3",  brand: "aston",    lic: "C", sr: "2.88", ir: "1.9k", irDelta: -36, lap: 13, pct: 0.435, speed: 0.835, isPit: false },
        { id: 11, num: "63", name: "S. Dubois",     cls: "GT3",  brand: "bmw",      lic: "D", sr: "2.40", ir: "1.6k", irDelta: -42, lap: 13, pct: 0.545, speed: 0.420, isPit: true },
      ];

      // State
      const enabledMods = { standings: true, relative: true, trackmap: true, fuel: true, inputs: true, radar: true };
      let isReplay = false;
      let isPaused = false;
      let radarOverrideUntil = 0;
      let radarOverrideMode = 3; // 1 = left, 2 = right, 3 = 3-wide

      // Pedal trace history
      const TRACE_LEN = 110;
      const traceT = new Float32Array(TRACE_LEN).fill(0.8);
      const traceB = new Float32Array(TRACE_LEN).fill(0);
      const traceC = new Float32Array(TRACE_LEN).fill(0);

      // DOM Refs
      const standingsEl = document.getElementById("simStandingsBody");
      const relativeEl = document.getElementById("simRelativeBody");
      const trackDotsEl = document.getElementById("simTrackDots");
      const radarEl = document.getElementById("simRadar");
      const radarHintEl = document.getElementById("simRadarHint");
      const radarLabelEl = document.getElementById("simRadarLabel");
      const radarArcLeft = document.getElementById("radarArcLeft");
      const radarArcRight = document.getElementById("radarArcRight");
      const radarCarLeft = document.getElementById("radarCarLeft");
      const radarCarRight = document.getElementById("radarCarRight");
      const deltaValEl = document.getElementById("simDeltaVal");
      const deltaFillEl = document.getElementById("simDeltaFill");
      const clutchBar = document.getElementById("simClutchBar");
      const brakeBar = document.getElementById("simBrakeBar");
      const throttleBar = document.getElementById("simThrottleBar");
      const gearEl = document.getElementById("simGear");
      const speedEl = document.getElementById("simSpeed");
      const fuelRemEl = document.getElementById("simFuelRem");
      const fuelAvgEl = document.getElementById("simFuelAvg");
      const fuelLapsEl = document.getElementById("simFuelLaps");
      const fuelAddEl = document.getElementById("simFuelAdd");
      const fuelBarEl = document.getElementById("simFuelBar");
      const cpuBadgeEl = document.getElementById("simCpuBadge");
      const replayBadgeEl = document.getElementById("simReplayBadge");
      const lapClockEl = document.getElementById("simLapClock");
      const pedalCanvas = document.getElementById("simPedalCanvas");
      const pedalCtx = pedalCanvas ? pedalCanvas.getContext("2d") : null;

      function syncVisibility() {
        let activeCount = 0;
        document.querySelectorAll("[data-hud-mod]").forEach((el) => {
          const mod = el.getAttribute("data-hud-mod");
          const drivingOnly = el.getAttribute("data-driving-only") === "true";
          const visible = Boolean(enabledMods[mod]) && !(isReplay && drivingOnly);
          el.classList.toggle("is-hidden", !visible);
          if (visible) activeCount++;
        });
        if (replayBadgeEl) replayBadgeEl.hidden = !isReplay;
        if (cpuBadgeEl) {
          cpuBadgeEl.textContent = `${isPaused ? "PAUSA" : "60 FPS"} · ${activeCount}/6 activos`;
        }
      }

      // Wire module toggle buttons
      document.querySelectorAll("[data-toggle-mod]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const mod = btn.getAttribute("data-toggle-mod");
          enabledMods[mod] = !enabledMods[mod];
          btn.classList.toggle("is-on", enabledMods[mod]);
          btn.setAttribute("aria-pressed", String(enabledMods[mod]));
          syncVisibility();
        });
      });

      const btnTrack = document.getElementById("simModeTrack");
      const btnReplay = document.getElementById("simModeReplay");
      if (btnTrack && btnReplay) {
        btnTrack.addEventListener("click", () => {
          isReplay = false;
          btnTrack.classList.add("is-active");
          btnReplay.classList.remove("is-active");
          btnTrack.setAttribute("aria-pressed", "true");
          btnReplay.setAttribute("aria-pressed", "false");
          syncVisibility();
        });
        btnReplay.addEventListener("click", () => {
          isReplay = true;
          btnReplay.classList.add("is-active");
          btnTrack.classList.remove("is-active");
          btnReplay.setAttribute("aria-pressed", "true");
          btnTrack.setAttribute("aria-pressed", "false");
          syncVisibility();
        });
      }

      const btnRadar = document.getElementById("simTriggerRadar");
      if (btnRadar) {
        btnRadar.addEventListener("click", () => {
          if (isReplay && btnTrack) btnTrack.click();
          if (!enabledMods.radar) {
            const chip = document.querySelector('[data-toggle-mod="radar"]');
            if (chip) chip.click();
          }
          radarOverrideMode = radarOverrideMode === 3 ? 1 : 3;
          radarOverrideUntil = performance.now() + 3600;
          btnRadar.textContent = radarOverrideMode === 3 ? "Simular 1-Wide" : "Simular 3-Wide";
        });
      }

      const btnPause = document.getElementById("simPauseBtn");
      if (btnPause) {
        btnPause.addEventListener("click", () => {
          isPaused = !isPaused;
          btnPause.textContent = isPaused ? "Reanudar" : "Pausar";
          btnPause.setAttribute("aria-pressed", String(isPaused));
          syncVisibility();
        });
      }

      // Render Standings Multiclase
      function renderStandings() {
        if (!standingsEl || !enabledMods.standings) return;
        let html = "";
        ["GTP", "LMP2", "GT3"].forEach((clsKey) => {
          const meta = CLASSES[clsKey];
          const group = drivers
            .filter((d) => d.cls === clsKey)
            .sort((a, b) => (b.lap + b.pct) - (a.lap + a.pct));
          if (!group.length) return;

          html += `<div class="st-cls-head" style="border-left-color:${meta.color}">
            <span class="st-cls-name" style="color:${meta.color}">${clsKey}</span>
            <span class="st-cls-sof">SOF ${meta.sof} · ${group.length} CARS</span>
          </div>`;

          const leaderDist = group[0].lap + group[0].pct;
          group.forEach((d, idx) => {
            const dist = d.lap + d.pct;
            const gapSec = (leaderDist - dist) * meta.lapSec;
            const prevDist = idx > 0 ? group[idx - 1].lap + group[idx - 1].pct : dist;
            const intSec = (prevDist - dist) * meta.lapSec;
            const gapStr = idx === 0 ? "LDR" : `+${gapSec.toFixed(1)}s`;
            const intStr = idx === 0 ? "—" : `+${intSec.toFixed(1)}`;
            const irCls = d.irDelta >= 0 ? "ir-pos" : "ir-neg";
            const irStr = d.irDelta >= 0 ? `+${d.irDelta}` : `${d.irDelta}`;
            const licBg = LIC_COLOR[d.lic] || "#64748b";

            html += `<div class="st-row ${d.isMe ? "is-me" : ""} ${d.isPit ? "is-pit" : ""}" style="border-left-color:${meta.color}">
              <span class="st-pos">${idx + 1}</span>
              ${brandSvg(d.brand, 14)}
              <span class="st-num">#${d.num}</span>
              <span class="st-name">${d.name}</span>
              <span class="st-lic" style="background:${licBg}">${d.lic} ${d.sr}</span>
              <span class="st-ir">${d.ir}</span>
              <span class="st-ird ${irCls}">${irStr}</span>
              <span class="st-int">${intStr}</span>
              <span class="st-gap">${gapStr}</span>
            </div>`;
          });
        });
        standingsEl.innerHTML = html;
      }

      // Render Relative Compacto (±3 cars around #16)
      function renderRelative() {
        if (!relativeEl || !enabledMods.relative) return;
        const me = drivers.find((d) => d.isMe) || drivers[0];
        const refLapSec = CLASSES[me.cls].lapSec;

        const items = drivers.map((d) => {
          let dp = d.pct - me.pct;
          if (dp > 0.5) dp -= 1;
          if (dp < -0.5) dp += 1;
          const timeDelta = dp * refLapSec;
          const lapDiff = d.lap - me.lap;
          let tone = "same";
          if (d.isPit) tone = "pit";
          else if (d.isMe) tone = "me";
          else if (lapDiff > 0) tone = "lapping";
          else if (lapDiff < 0) tone = "lapped";
          return { d, timeDelta, tone };
        });

        const ahead = items.filter((x) => !x.d.isMe && x.timeDelta >= 0).sort((a, b) => a.timeDelta - b.timeDelta).slice(0, 3).reverse();
        const behind = items.filter((x) => !x.d.isMe && x.timeDelta < 0).sort((a, b) => b.timeDelta - a.timeDelta).slice(0, 3);
        const meItem = items.find((x) => x.d.isMe);
        const ordered = [...ahead, meItem, ...behind].filter(Boolean);

        relativeEl.innerHTML = ordered.map(({ d, timeDelta, tone }) => {
          const clsColor = CLASSES[d.cls].color;
          const gapText = d.isMe ? "0.0s" : `${timeDelta >= 0 ? "+" : ""}${timeDelta.toFixed(1)}s`;
          const licBg = LIC_COLOR[d.lic] || "#64748b";
          return `<div class="rel-row rel-row--${tone}" style="border-left-color:${clsColor}">
            <span class="rel-num">#${d.num}</span>
            ${brandSvg(d.brand, 13)}
            <span class="rel-name">${d.name}</span>
            ${d.isPit ? '<span class="rel-pit">PIT</span>' : `<span class="rel-lic" style="background:${licBg}">${d.lic}</span><span class="rel-ir">${d.ir}</span>`}
            <span class="rel-gap">${gapText}</span>
          </div>`;
        }).join("");
      }

      // Render Track Map Dots
      function renderTrackMap() {
        if (!trackDotsEl || !enabledMods.trackmap) return;
        let svg = "";
        drivers.forEach((d) => {
          const [x, y] = pointOnSpline(d.pct);
          const color = CLASSES[d.cls].color;
          if (d.isMe) {
            svg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="10.5" fill="rgba(16,185,129,0.28)" stroke="#10b981" stroke-width="1.6"/>`;
          }
          svg += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${d.isMe ? 6.5 : 5.2}" fill="${color}" stroke="#090b0f" stroke-width="1.2"/>`;
          svg += `<text x="${x.toFixed(1)}" y="${(y + 2.4).toFixed(1)}" text-anchor="middle" font-size="6.4" font-family="ui-monospace,monospace" font-weight="800" fill="#090b0f">${d.num}</text>`;
        });
        trackDotsEl.innerHTML = svg;
      }

      // Render Pedal Canvas + Telemetry
      function renderInputs(tSec) {
        if (!enabledMods.inputs || isReplay) return;
        // Realistic Silverstone Maggotts/Becketts/Hangar Straight input curve
        const phase = (tSec * 0.42) % (Math.PI * 2);
        const s = Math.sin(phase);
        const c = Math.cos(phase * 2);
        let throttle = Math.max(0, Math.min(1, 0.58 + 0.48 * s + 0.14 * c));
        let brake = s < -0.25 ? Math.min(0.92, (-s - 0.25) * 1.25) : 0;
        if (brake > 0.08) throttle = Math.min(throttle, 0.06);
        const clutch = brake > 0.72 ? 0.18 : 0;

        traceT.copyWithin(0, 1); traceT[TRACE_LEN - 1] = throttle;
        traceB.copyWithin(0, 1); traceB[TRACE_LEN - 1] = brake;
        traceC.copyWithin(0, 1); traceC[TRACE_LEN - 1] = clutch;

        if (throttleBar) throttleBar.style.height = `${Math.round(throttle * 100)}%`;
        if (brakeBar) brakeBar.style.height = `${Math.round(brake * 100)}%`;
        if (clutchBar) clutchBar.style.height = `${Math.round(clutch * 100)}%`;

        const speed = Math.round(138 + throttle * 124 - brake * 68);
        const gear = speed > 238 ? 6 : speed > 200 ? 5 : speed > 165 ? 4 : speed > 125 ? 3 : 2;
        if (gearEl) gearEl.textContent = String(gear);
        if (speedEl) speedEl.textContent = String(speed);

        // Delta bar oscillation (-0.52s to +0.28s)
        const delta = -0.14 + Math.sin(tSec * 0.35) * 0.34;
        if (deltaValEl) {
          deltaValEl.textContent = `${delta >= 0 ? "+" : ""}${delta.toFixed(2)}s`;
          deltaValEl.style.color = delta <= 0 ? "#34d399" : "#f87171";
        }
        if (deltaFillEl) {
          const pct = Math.min(50, (Math.abs(delta) / 0.8) * 50);
          deltaFillEl.style.width = `${pct.toFixed(1)}%`;
          deltaFillEl.style.left = delta <= 0 ? `${(50 - pct).toFixed(1)}%` : "50%";
          deltaFillEl.style.background = delta <= 0 ? "#10b981" : "#ef4444";
        }

        if (pedalCtx && pedalCanvas) {
          const w = pedalCanvas.width;
          const h = pedalCanvas.height;
          pedalCtx.clearRect(0, 0, w, h);
          // Grid lines
          pedalCtx.strokeStyle = "rgba(255,255,255,0.06)";
          pedalCtx.lineWidth = 1;
          [0.25, 0.5, 0.75].forEach((g) => {
            pedalCtx.beginPath();
            pedalCtx.moveTo(0, h * g);
            pedalCtx.lineTo(w, h * g);
            pedalCtx.stroke();
          });

          const drawSeries = (arr, color) => {
            pedalCtx.beginPath();
            pedalCtx.strokeStyle = color;
            pedalCtx.lineWidth = 2;
            for (let i = 0; i < TRACE_LEN; i++) {
              const x = (i / (TRACE_LEN - 1)) * w;
              const y = h - 4 - arr[i] * (h - 8);
              if (i === 0) pedalCtx.moveTo(x, y);
              else pedalCtx.lineTo(x, y);
            }
            pedalCtx.stroke();
          };
          drawSeries(traceC, "#38bdf8");
          drawSeries(traceB, "#ef4444");
          drawSeries(traceT, "#10b981");
        }
      }

      // Render Radar (CarLeftRight)
      function renderRadar(nowMs) {
        if (!radarEl || !enabledMods.radar || isReplay) return;
        const me = drivers.find((d) => d.isMe);
        let state = 0; // 0 clear, 1 left, 2 right, 3 3-wide
        if (nowMs < radarOverrideUntil) {
          state = radarOverrideMode;
        } else if (me) {
          // Detect natural proximity with GTP/GT3 cars
          const close = drivers.filter((d) => !d.isMe && !d.isPit && Math.abs(((d.pct - me.pct + 1.5) % 1) - 0.5) < 0.012);
          if (close.length >= 2) state = 3;
          else if (close.length === 1) state = close[0].id % 2 === 0 ? 1 : 2;
        }

        const active = state > 0;
        radarEl.setAttribute("data-state", active ? (state === 3 ? "threewide" : "side") : "clear");
        if (radarHintEl) radarHintEl.style.opacity = active ? "0" : "1";

        const leftOn = state === 1 || state === 3;
        const rightOn = state === 2 || state === 3;
        const color = state === 3 ? "#ef4444" : "#f59e0b";

        if (radarArcLeft) radarArcLeft.setAttribute("stroke", leftOn ? color : "transparent");
        if (radarArcRight) radarArcRight.setAttribute("stroke", rightOn ? color : "transparent");
        if (radarCarLeft) {
          radarCarLeft.setAttribute("fill", color);
          radarCarLeft.setAttribute("stroke", color);
          radarCarLeft.setAttribute("fill-opacity", leftOn ? "0.35" : "0");
          radarCarLeft.setAttribute("stroke-opacity", leftOn ? "1" : "0");
        }
        if (radarCarRight) {
          radarCarRight.setAttribute("fill", color);
          radarCarRight.setAttribute("stroke", color);
          radarCarRight.setAttribute("fill-opacity", rightOn ? "0.35" : "0");
          radarCarRight.setAttribute("stroke-opacity", rightOn ? "1" : "0");
        }
        if (radarLabelEl) {
          radarLabelEl.textContent = state === 3 ? "3-WIDE!" : state === 1 ? "CAR LEFT" : state === 2 ? "CAR RIGHT" : "CLEAR";
          radarLabelEl.style.color = state === 3 ? "#f87171" : active ? "#fbbf24" : "#64748b";
        }
      }

      // Main animation loop
      let lastMs = performance.now();
      let lastDomMs = 0;
      let fuelLevel = 34.8;
      let simTimeSec = 0;

      function tick(nowMs) {
        const dt = Math.min(0.1, (nowMs - lastMs) / 1000);
        lastMs = nowMs;

        if (!isPaused) {
          simTimeSec += dt;
          drivers.forEach((d) => {
            const step = (dt / 32) * d.speed;
            d.pct += step;
            if (d.pct >= 1) {
              d.pct -= 1;
              d.lap += 1;
            }
          });

          // Burn fuel realistically
          fuelLevel -= dt * 0.088;
          if (fuelLevel < 12) fuelLevel = 38.4;

          renderInputs(simTimeSec);
          renderTrackMap();
          renderRadar(nowMs);

          // DOM tables at ~6 Hz for crisp readability without layout thrash
          if (nowMs - lastDomMs > 160) {
            lastDomMs = nowMs;
            renderStandings();
            renderRelative();

            if (enabledMods.fuel) {
              const avg = 2.84;
              const lapsLeft = fuelLevel / avg;
              const need = Math.max(0, (14 * avg + 1.5) - fuelLevel);
              if (fuelRemEl) fuelRemEl.textContent = `${fuelLevel.toFixed(1)} L`;
              if (fuelAvgEl) fuelAvgEl.textContent = `${avg.toFixed(2)} L`;
              if (fuelLapsEl) fuelLapsEl.textContent = lapsLeft.toFixed(1);
              if (fuelAddEl) fuelAddEl.textContent = need > 0.1 ? `+${need.toFixed(1)} L` : "OK";
              if (fuelBarEl) fuelBarEl.style.width = `${Math.min(100, (fuelLevel / 80) * 100).toFixed(0)}%`;
            }

            const me = drivers.find((d) => d.isMe);
            if (lapClockEl && me) {
              const remMin = Math.max(1, 18 - Math.floor(simTimeSec / 60));
              const remSec = 59 - (Math.floor(simTimeSec) % 60);
              lapClockEl.textContent = `LAP ${me.lap}/28 · ${String(remMin).padStart(2, "0")}:${String(remSec).padStart(2, "0")} REM`;
            }
          }
        }

        requestAnimationFrame(tick);
      }

      syncVisibility();
      renderStandings();
      renderRelative();
      renderTrackMap();
      requestAnimationFrame(tick);
    })();
  </script>
</Layout>

