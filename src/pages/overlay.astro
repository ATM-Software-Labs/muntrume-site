---
import Layout from "../layouts/Layout.astro";
import desktopPkg from "../../desktop/package.json";
import { OFFICIAL_BRAND_PATHS } from "../../desktop/src/cars/brand-icons";

const appVersion = desktopPkg.version;
const releaseUrl = "https://github.com/ATM-Software-Labs/muntrume-site/releases/latest";
const repoUrl = "https://github.com/ATM-Software-Labs/muntrume-site/tree/main/desktop";

const pageTitle = "MMT Sync Overlays · HUD Telemetría iRacing | Muntrume Motorsport";
const pageDescription = `MMT Sync Overlays v${appVersion}: telemetría HUD nativa a 60 FPS para iRacing con Standings multiclase, Relative, Track Map Catmull-Rom, Fuel y Radar. Equipo MMT.`;
const pageUrl = "https://muntru.me/overlay/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";

// Extract only the manufacturer SVG paths needed for the interactive HUD simulator
const SIM_BRAND_PATHS: Record<string, { path: string; color: string; name: string }> = {
  porsche: { path: OFFICIAL_BRAND_PATHS["logo-porsche"] || "", color: "#EF4444", name: "Porsche" },
  ferrari: { path: OFFICIAL_BRAND_PATHS["logo-ferrari"] || "", color: "#FACC15", name: "Ferrari" },
  cadillac: { path: OFFICIAL_BRAND_PATHS["logo-cadillac"] || "", color: "#D4AF37", name: "Cadillac" },
  bmw: { path: OFFICIAL_BRAND_PATHS["logo-bmw"] || "", color: "#3B82F6", name: "BMW" },
  dallara: { path: OFFICIAL_BRAND_PATHS["logo-dallara"] || "", color: "#00E699", name: "Dallara" },
  mercedes: { path: OFFICIAL_BRAND_PATHS["logo-mercedes"] || "", color: "#00D2BE", name: "Mercedes-AMG" },
  mclaren: { path: OFFICIAL_BRAND_PATHS["logo-mclaren"] || "", color: "#FF8000", name: "McLaren" },
  aston: { path: OFFICIAL_BRAND_PATHS["logo-aston"] || "", color: "#10B981", name: "Aston Martin" },
};

const overlaySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { "@id": "https://muntru.me/#website" },
      about: { "@id": `${pageUrl}#software` },
      primaryImageOfPage: ogImage,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${pageUrl}#software`,
      name: "MMT Sync Overlays",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Windows 10, Windows 11",
      softwareVersion: appVersion,
      url: pageUrl,
      downloadUrl: releaseUrl,
      description: pageDescription,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "EUR",
      },
      publisher: { "@id": "https://muntru.me/#org" },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://muntru.me/" },
        { "@type": "ListItem", position: 2, name: "Overlay HUD", item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="mmt sync overlays, iracing hud, iracing overlay gratis, kapps alternativa, racelab alternativa, iracing telemetry hud, standings multiclase iracing, track map iracing, radar helicorsa iracing, muntrume motorsport"
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt="MMT Sync Overlays — Telemetría HUD de baja latencia para iRacing"
  ogImageWidth={1200}
  ogImageHeight={630}
  schemaJson={overlaySchema}
>
  <div class="ov-page">
    <!-- ===================================================================== -->
    <!-- 1. HERO & DESCARGA DIRECTA                                            -->
    <!-- ===================================================================== -->
    <section class="ov-hero">
      <div class="ov-container">
        <div class="ov-hero__badges">
          <span class="ov-pill ov-pill--live">
            <span class="ov-dot" aria-hidden="true"></span>
            <span>MMT Sync HUD · v{appVersion}</span>
          </span>
          <span class="ov-pill">Windows 10/11 · iRacing SDK nativo</span>
          <span class="ov-pill">60 FPS · Click-Through</span>
        </div>

        <h1 class="ov-hero__title">
          MMT Sync Overlays — <span class="ov-accent">Telemetría HUD</span> de baja latencia para iRacing
        </h1>

        <p class="ov-hero__lead">
          Superposiciones nativas transparentes <code>click-through</code> a 60 FPS diseñadas con la densidad visual, legibilidad y ergonomía de los estándares clásicos de competición (Kapps / Racelab), con <strong>0 % de consumo de CPU</strong> cuando un módulo está desactivado.
        </p>

        <div class="ov-hero__actions">
          <a
            href={releaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ov-btn ov-btn--primary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            <span>Descargar última release (v{appVersion})</span>
          </a>

          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="ov-btn ov-btn--secondary"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
            <span>Código y documentación</span>
          </a>

          <a href="#simulador-hud" class="ov-btn ov-btn--ghost">
            <span>Probar simulador en vivo ↓</span>
          </a>
        </div>

        <div class="ov-specs">
          <div class="ov-spec">
            <span class="ov-spec__val">60 Hz</span>
            <span class="ov-spec__lbl">Lectura memoria compartida iRSDK</span>
          </div>
          <div class="ov-spec">
            <span class="ov-spec__val">0 % CPU</span>
            <span class="ov-spec__lbl">En módulos desactivados</span>
          </div>
          <div class="ov-spec">
            <span class="ov-spec__val">Tauri v2</span>
            <span class="ov-spec__lbl">Core Rust + TypeScript nativo</span>
          </div>
          <div class="ov-spec">
            <span class="ov-spec__val">SHA-256</span>
            <span class="ov-spec__lbl">Releases verificadas en GitHub</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. PREVISUALIZACIÓN INTERACTIVA EN VIVO DEL HUD                       -->
    <!-- ===================================================================== -->
    <section id="simulador-hud" class="ov-section">
      <div class="ov-container">
        <div class="ov-section__head">
          <div>
            <p class="ov-kicker">Simulador interactivo en navegador · Silverstone GP</p>
            <h2 class="ov-section__title">Prueba los 6 módulos del HUD en tiempo real</h2>
            <p class="ov-section__sub">
              Activa o desactiva cada módulo, alterna entre perfil de <strong>Pista (P)</strong> y <strong>Replay (R)</strong>, o dispara una situación de coche en paralelo para ver el radar <code>CarLeftRight</code> en acción.
            </p>
          </div>
        </div>

        <!-- Barra de control interactiva -->
        <div class="sim-toolbar" role="region" aria-label="Controles del simulador HUD">
          <div class="sim-toolbar__group">
            <span class="sim-toolbar__label">MÓDULOS:</span>
            <button type="button" class="sim-chip is-on" data-toggle-mod="standings" aria-pressed="true">
              <span class="sim-chip__dot"></span>Standings
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="relative" aria-pressed="true">
              <span class="sim-chip__dot"></span>Relative
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="trackmap" aria-pressed="true">
              <span class="sim-chip__dot"></span>Track Map
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="fuel" aria-pressed="true">
              <span class="sim-chip__dot"></span>Fuel Calc
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="inputs" aria-pressed="true">
              <span class="sim-chip__dot"></span>Inputs &amp; Delta
            </button>
            <button type="button" class="sim-chip is-on" data-toggle-mod="radar" aria-pressed="true">
              <span class="sim-chip__dot"></span>Radar
            </button>
          </div>

          <div class="sim-toolbar__group sim-toolbar__right">
            <div class="sim-mode-switch" role="group" aria-label="Modo de sesión">
              <button type="button" id="simModeTrack" class="sim-mode-btn is-active" aria-pressed="true">
                Pista <kbd>P</kbd>
              </button>
              <button type="button" id="simModeReplay" class="sim-mode-btn" aria-pressed="false">
                Replay <kbd>R</kbd>
              </button>
            </div>
            <button type="button" id="simTriggerRadar" class="sim-action-btn" title="Simular coche en paralelo (1-wide / 3-wide)">
              Simular 3-Wide
            </button>
            <button type="button" id="simPauseBtn" class="sim-action-btn" aria-pressed="false">
              Pausar
            </button>
          </div>
        </div>

        <!-- Lienzo de Cabina Simulada (Silverstone GP) -->
        <div class="sim-stage" id="simStage">
          <!-- Fondo de pista estilizado (Silverstone GP · cockpit perspective SVG) -->
          <svg class="sim-backdrop" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <defs>
              <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#070a10"/>
                <stop offset="55%" stop-color="#0d131d"/>
                <stop offset="100%" stop-color="#090b0f"/>
              </linearGradient>
              <linearGradient id="asphaltGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#131822"/>
                <stop offset="100%" stop-color="#0a0d12"/>
              </linearGradient>
              <radialGradient id="horizonGlow" cx="50%" cy="42%" r="48%">
                <stop offset="0%" stop-color="rgba(16,185,129,0.12)"/>
                <stop offset="100%" stop-color="rgba(9,11,15,0)"/>
              </radialGradient>
            </defs>
            <rect width="1280" height="720" fill="url(#skyGrad)"/>
            <rect width="1280" height="720" fill="url(#horizonGlow)"/>
            <!-- Horizonte y silueta de gradas Silverstone -->
            <line x1="0" y1="300" x2="1280" y2="300" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
            <path d="M0 300 L180 284 L380 292 L580 280 L820 288 L1080 278 L1280 294 L1280 300 Z" fill="#0c1118"/>
            <!-- Asfalto en perspectiva hacia curva Maggotts / Becketts -->
            <path d="M560 300 L720 300 L1220 720 L60 720 Z" fill="url(#asphaltGrad)"/>
            <!-- Pianos (kerbs) rojo/blanco sutiles -->
            <path d="M560 300 L548 300 L28 720 L60 720 Z" fill="rgba(239,68,68,0.16)"/>
            <path d="M720 300 L732 300 L1252 720 L1220 720 Z" fill="rgba(255,255,255,0.08)"/>
            <!-- Línea de trazada / referencia central -->
            <line x1="640" y1="300" x2="640" y2="720" stroke="rgba(255,255,255,0.04)" stroke-width="2" stroke-dasharray="18 22"/>
            <!-- Halo sutil de parabrisas / cockpit -->
            <path d="M0 0 L1280 0 L1280 48 Q640 16 0 48 Z" fill="rgba(4,6,9,0.75)"/>
          </svg>

          <!-- Barra superior de estado del simulador -->
          <div class="sim-statusbar">
            <div class="sim-statusbar__left">
              <span class="sim-status-tag">SILVERSTONE GP · IMSA MULTICLASS</span>
              <span class="sim-status-meta" id="simLapClock">LAP 14/28 · 18:42 REM</span>
            </div>
            <div class="sim-statusbar__right">
              <span class="sim-replay-badge" id="simReplayBadge" hidden>REPLAY · isReplayPlaying=true · Controles de pilotaje ocultos</span>
              <span class="sim-fps-badge" id="simCpuBadge">60 FPS · 6/6 activos</span>
            </div>
          </div>

          <!-- Grid HUD Responsive -->
          <div class="sim-hud-grid">
            <!-- COLUMNA IZQUIERDA: Standings + Relative -->
            <div class="sim-col sim-col--left">
              <!-- MÓDULO 1: STANDINGS MULTICLASE -->
              <div class="hud-box hud-standings" data-hud-mod="standings">
                <div class="hud-box__head">
                  <span class="hud-box__title">STANDINGS · IMSA</span>
                  <span class="hud-box__meta">TICK GAP/INT · iR Δ</span>
                </div>
                <div class="hud-standings__body" id="simStandingsBody"></div>
              </div>

              <!-- MÓDULO 2: RELATIVE COMPACTO -->
              <div class="hud-box hud-relative" data-hud-mod="relative">
                <div class="hud-box__head">
                  <span class="hud-box__title">RELATIVE</span>
                  <span class="hud-box__meta">±3 COCHES · COLOR VUELTA</span>
                </div>
                <div class="hud-relative__body" id="simRelativeBody"></div>
              </div>
            </div>

            <!-- COLUMNA CENTRAL: Radar Proximidad + Inputs & Delta Bar -->
            <div class="sim-col sim-col--center">
              <!-- MÓDULO 6: RADAR DE PROXIMIDAD LATERAL (Helicorsa) -->
              <div class="hud-radar-wrap" data-hud-mod="radar" data-driving-only="true">
                <div class="hud-radar" id="simRadar" data-state="clear" aria-live="polite">
                  <svg viewBox="0 0 180 180" class="hud-radar__svg" aria-label="Radar de proximidad lateral">
                    <circle cx="90" cy="90" r="78" fill="rgba(9,11,15,0.72)" stroke="rgba(255,255,255,0.10)" stroke-width="1"/>
                    <circle cx="90" cy="90" r="46" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" stroke-dasharray="4 4"/>
                    <!-- Arco Izquierdo -->
                    <path id="radarArcLeft" d="M 38 38 A 74 74 0 0 0 38 142" fill="none" stroke="transparent" stroke-width="8" stroke-linecap="round"/>
                    <!-- Arco Derecho -->
                    <path id="radarArcRight" d="M 142 38 A 74 74 0 0 1 142 142" fill="none" stroke="transparent" stroke-width="8" stroke-linecap="round"/>
                    <!-- Coche propio centrado -->
                    <rect x="78" y="64" width="24" height="52" rx="6" fill="#10b981" fill-opacity="0.22" stroke="#10b981" stroke-width="1.6"/>
                    <line x1="90" y1="68" x2="90" y2="78" stroke="#34d399" stroke-width="2" stroke-linecap="round"/>
                    <!-- Coche rival izquierdo -->
                    <rect id="radarCarLeft" x="34" y="70" width="20" height="44" rx="5" fill="#f59e0b" fill-opacity="0" stroke="#f59e0b" stroke-opacity="0" stroke-width="1.5"/>
                    <!-- Coche rival derecho -->
                    <rect id="radarCarRight" x="126" y="74" width="20" height="44" rx="5" fill="#ef4444" fill-opacity="0" stroke="#ef4444" stroke-opacity="0" stroke-width="1.5"/>
                  </svg>
                  <div class="hud-radar__label" id="simRadarLabel">CLEAR</div>
                </div>
                <div class="hud-radar__hint" id="simRadarHint">
                  Radar <code>CarLeftRight</code> en espera (invisible en pista libre)
                </div>
              </div>

              <!-- MÓDULO 5: INPUT TELEMETRY & DELTA BAR -->
              <div class="hud-center-bottom" data-hud-mod="inputs" data-driving-only="true">
                <!-- Delta Bar bidireccional -->
                <div class="hud-box hud-delta">
                  <div class="hud-delta__row">
                    <span class="hud-delta__tag">SESSION BEST Δ</span>
                    <span class="hud-delta__val" id="simDeltaVal">-0.28s</span>
                  </div>
                  <div class="hud-delta__track">
                    <div class="hud-delta__center"></div>
                    <div class="hud-delta__fill" id="simDeltaFill"></div>
                  </div>
                </div>

                <!-- Input Telemetry (Trace + Pedals + Gear/Speed) -->
                <div class="hud-box hud-inputs">
                  <div class="hud-inputs__trace">
                    <canvas id="simPedalCanvas" width="260" height="68" aria-label="Gráfica de pedales en vivo"></canvas>
                  </div>
                  <div class="hud-inputs__bars">
                    <div class="pedal-col">
                      <div class="pedal-bar"><div class="pedal-fill pedal-fill--clutch" id="simClutchBar" style="height:0%"></div></div>
                      <span class="pedal-lbl">C</span>
                    </div>
                    <div class="pedal-col">
                      <div class="pedal-bar"><div class="pedal-fill pedal-fill--brake" id="simBrakeBar" style="height:0%"></div></div>
                      <span class="pedal-lbl">B</span>
                    </div>
                    <div class="pedal-col">
                      <div class="pedal-bar"><div class="pedal-fill pedal-fill--throttle" id="simThrottleBar" style="height:82%"></div></div>
                      <span class="pedal-lbl">T</span>
                    </div>
                  </div>
                  <div class="hud-inputs__gear">
                    <span class="gear-val" id="simGear">4</span>
                    <span class="speed-val" id="simSpeed">214</span>
                    <span class="speed-unit">KM/H</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- COLUMNA DERECHA: Track Map + Fuel & Stint Calculator -->
            <div class="sim-col sim-col--right">
              <!-- MÓDULO 3: TRACK MAP CATMULL-ROM -->
              <div class="hud-box hud-trackmap" data-hud-mod="trackmap">
                <div class="hud-box__head">
                  <span class="hud-box__title">TRACK MAP · SILVERSTONE GP</span>
                  <span class="hud-box__meta">CATMULL-ROM SPLINE</span>
                </div>
                <div class="hud-trackmap__canvas">
                  <svg id="simTrackSvg" viewBox="0 0 280 200" class="hud-trackmap__svg" aria-label="Mapa de circuito Silverstone GP">
                    <path id="simTrackOutline" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="9" stroke-linejoin="round" stroke-linecap="round"/>
                    <path id="simTrackLine" fill="none" stroke="#1e293b" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"/>
                    <line id="simSfLine" x1="0" y1="0" x2="0" y2="0" stroke="#ffffff" stroke-width="2.5"/>
                    <g id="simTrackDots"></g>
                  </svg>
                </div>
              </div>

              <!-- MÓDULO 4: FUEL & STINT CALCULATOR -->
              <div class="hud-box hud-fuel" data-hud-mod="fuel">
                <div class="hud-box__head">
                  <span class="hud-box__title">FUEL &amp; STINT CALC</span>
                  <span class="hud-box__meta">FILTRO FCY / PIT</span>
                </div>
                <div class="hud-fuel__grid">
                  <div class="fuel-cell">
                    <span class="fuel-lbl">FUEL REM</span>
                    <span class="fuel-val" id="simFuelRem">34.8 L</span>
                  </div>
                  <div class="fuel-cell">
                    <span class="fuel-lbl">AVG L/LAP</span>
                    <span class="fuel-val fuel-val--emerald" id="simFuelAvg">2.84 L</span>
                  </div>
                  <div class="fuel-cell">
                    <span class="fuel-lbl">LAPS EST.</span>
                    <span class="fuel-val" id="simFuelLaps">12.2</span>
                  </div>
                  <div class="fuel-cell fuel-cell--highlight">
                    <span class="fuel-lbl">TO ADD (+1.5L)</span>
                    <span class="fuel-val fuel-val--amber" id="simFuelAdd">+9.4 L</span>
                  </div>
                </div>
                <div class="hud-fuel__bar-wrap">
                  <div class="hud-fuel__bar" id="simFuelBar" style="width: 44%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Resumen técnico de los 6 módulos -->
        <div class="ov-mod-grid">
          <article class="ov-card">
            <span class="ov-card__num">01</span>
            <h3>Standings Multiclase</h3>
            <p>Cabeceras por categoría con SOF, barra lateral de color de clase, logos oficiales SVG con <code>fill-rule="evenodd"</code>, badges de Licencia + iRating de alto contraste, ganancia/pérdida de iR en tiempo real y cálculo continuo de <code>GAP</code> e <code>INT</code> tick a tick desde <code>CarIdxLap + CarIdxLapDistPct</code>.</p>
          </article>
          <article class="ov-card">
            <span class="ov-card__num">02</span>
            <h3>Relative Compacto</h3>
            <p>3 coches por delante y 3 por detrás ordenados por distancia temporal (<code>±0.0s</code>) con código de colores por vuelta: misma vuelta en blanco, dobladores en rojo coral, doblados en cian y coches en pit lane atenuados.</p>
          </article>
          <article class="ov-card">
            <span class="ov-card__num">03</span>
            <h3>Track Map Catmull-Rom</h3>
            <p>Trazado interpolado mediante splines Catmull-Rom cerrados, línea de salida/meta perpendicular y burbujas numeradas con el color de clase de cada piloto más halo esmeralda en el coche enfocado (<code>CamCarIdx</code>).</p>
          </article>
          <article class="ov-card">
            <span class="ov-card__num">04</span>
            <h3>Fuel &amp; Stint Calculator</h3>
            <p>Consumo medio real (<code>L/LAP</code>) filtrando automáticamente vueltas bajo bandera amarilla o paso por boxes, vueltas restantes reales y litros exactos a repostar con margen de seguridad configurable.</p>
          </article>
          <article class="ov-card">
            <span class="ov-card__num">05</span>
            <h3>Input Telemetry &amp; Delta Bar</h3>
            <p>Barras de pedales de alta precisión (Gas, Freno, Embrague) con traza continua en Canvas 2D, indicador de marcha/velocidad y barra bidireccional de delta contra mejor vuelta de sesión (<code>LapDeltaToSessionBestLap</code>).</p>
          </article>
          <article class="ov-card">
            <span class="ov-card__num">06</span>
            <h3>Radar de Proximidad Lateral</h3>
            <p>Indicador tipo Helicorsa conectado a <code>CarLeftRight</code> que permanece completamente invisible en pista libre y alerta en ámbar o rojo cuando hay coches en paralelo (<code>1-wide</code> / <code>3-wide</code>).</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 3. ARQUITECTURA TÉCNICA ("CÓMO ESTÁ CONSTRUIDO POR DENTRO")           -->
    <!-- ===================================================================== -->
    <section id="arquitectura" class="ov-section ov-section--alt">
      <div class="ov-container">
        <div class="ov-section__head">
          <p class="ov-kicker">Ingeniería de software · Zero-overhead</p>
          <h2 class="ov-section__title">Cómo está construido por dentro</h2>
          <p class="ov-section__sub">
            Diseñado desde cero para no robar ni un solo fotograma al simulador, eliminando navegadores embebidos pesados y capas intermedias innecesarias.
          </p>
        </div>

        <div class="ov-arch-grid">
          <article class="ov-arch-card">
            <div class="ov-arch-card__top">
              <span class="ov-arch-tag">MEMORIA COMPARTIDA</span>
              <span class="ov-arch-metric">60 Hz nativo</span>
            </div>
            <h3>Lectura directa del iRacing SDK</h3>
            <p>
              Acceso sin latencia a las variables de telemetría de memoria mapeada de Windows (<code>CarIdxLapDistPct</code>, <code>CarIdxF2Time</code>, <code>CarLeftRight</code>, <code>SessionFlags</code>, <code>FuelLevel</code>) y parsing incremental del YAML de sesión (<code>DriverInfo</code>, <code>WeekendInfo</code>).
