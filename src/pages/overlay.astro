        { id: 5,  num: "48", name: "J. O'Connor",   cls: "LMP2", brand: "dallara",  lic: "B", sr: "3.64", ir: "2.7k", irDelta: -14, lap: 14, pct: 0.6100, speed: 0.943, isPit: false },
        // GT3 — Podio 1-2-3 Muntrume Motorsport (#16 A. Trujillo P1, #1 M. Berbis P2 +0.6s, #22 E. Chongkan P3 +1.3s)
        { id: 7,  num: "16", name: "A. Trujillo",   cls: "GT3",  brand: "ford",     lic: "A", sr: "4.99", ir: "2.7k", irDelta: +65, lap: 14, pct: 0.5000, speed: 0.846, isPit: false, isMe: true },
        { id: 6,  num: "1",  name: "M. Berbis",     cls: "GT3",  brand: "porsche",  lic: "A", sr: "4.65", ir: "2.9k", irDelta: +44, lap: 14, pct: 0.4947, speed: 0.846, isPit: false, battleSide: "left" },
        { id: 8,  num: "22", name: "E. Chongkan",   cls: "GT3",  brand: "mclaren",  lic: "B", sr: "3.41", ir: "2.4k", irDelta: +18, lap: 14, pct: 0.4884, speed: 0.846, isPit: false, battleSide: "right" },
        { id: 9,  num: "77", name: "D. Rossi",      cls: "GT3",  brand: "ferrari",  lic: "B", sr: "3.12", ir: "2.3k", irDelta: -24, lap: 14, pct: 0.4620, speed: 0.841, isPit: false },
        { id: 10, num: "95", name: "T. Schneider",  cls: "GT3",  brand: "lambo",    lic: "C", sr: "2.88", ir: "1.9k", irDelta: -36, lap: 13, pct: 0.4350, speed: 0.835, isPit: false },
        { id: 11, num: "63", name: "S. Dubois",     cls: "GT3",  brand: "aston",    lic: "D", sr: "2.40", ir: "1.6k", irDelta: -42, lap: 13, pct: 0.5450, speed: 0.420, isPit: true },
      ];

      // State
      const enabledMods = { standings: true, relative: true, trackmap: true, fuel: true, pit: true, tires: true, inputs: true, radar: true };
      let isReplay = false;
      let isPaused = false;
      let radarOverrideUntil = 0;
      let radarOverrideMode = 1; // toggles to 3 on first "Simular 3-Wide" click

      // Pedal trace history
      const TRACE_LEN = 110;
      const traceT = new Float32Array(TRACE_LEN).fill(0.8);
      const traceB = new Float32Array(TRACE_LEN).fill(0);
      const traceC = new Float32Array(TRACE_LEN).fill(0);

      // DOM Refs
      const standingsEl = document.getElementById("simStandingsBody");
      const relativeEl = document.getElementById("simRelativeBody");
      const trackDotsEl = document.getElementById("simTrackDots");
      const radarEl = document.getElementById("simRadar");
      const radarLabelEl = document.getElementById("simRadarLabel");
      const radarArcLeft = document.getElementById("radarArcLeft");
      const radarArcRight = document.getElementById("radarArcRight");
      const radarCarLeft = document.getElementById("radarCarLeft");
      const radarCarRight = document.getElementById("radarCarRight");
      const deltaValEl = document.getElementById("simDeltaVal");
      const deltaFillEl = document.getElementById("simDeltaFill");
      const clutchBar = document.getElementById("simClutchBar");
      const brakeBar = document.getElementById("simBrakeBar");
      const throttleBar = document.getElementById("simThrottleBar");
      const gearEl = document.getElementById("simGear");
      const speedEl = document.getElementById("simSpeed");
      const fuelRemEl = document.getElementById("simFuelRem");
      const fuelAvgEl = document.getElementById("simFuelAvg");
      const fuelLapsEl = document.getElementById("simFuelLaps");
      const fuelAddEl = document.getElementById("simFuelAdd");
      const fuelBarEl = document.getElementById("simFuelBar");
      const cpuBadgeEl = document.getElementById("simCpuBadge");
      const replayBadgeEl = document.getElementById("simReplayBadge");
      const lapClockEl = document.getElementById("simLapClock");
      const pedalCanvas = document.getElementById("simPedalCanvas");
      const pedalCtx = pedalCanvas ? pedalCanvas.getContext("2d") : null;

      function syncVisibility() {
        const activeMods = new Set();
        document.querySelectorAll("[data-hud-mod]").forEach((el) => {
          const mod = el.getAttribute("data-hud-mod");
          const drivingOnly = el.getAttribute("data-driving-only") === "true";
          const visible = Boolean(enabledMods[mod]) && !(isReplay && drivingOnly);
          el.classList.toggle("is-hidden", !visible);
          if (visible && mod) activeMods.add(mod);
        });
        if (replayBadgeEl) replayBadgeEl.hidden = !isReplay;
        if (cpuBadgeEl) {
          cpuBadgeEl.textContent = `${isPaused ? "PAUSA" : "60 FPS"} · ${activeMods.size}/8 activos`;
        }
      }

      const SIM_PRESETS = {
        all_on: { standings: true, relative: true, trackmap: true, fuel: true, pit: true, tires: true, inputs: true, radar: true },
        sprint_gt3: { standings: false, relative: true, trackmap: false, fuel: false, pit: false, tires: true, inputs: true, radar: true },
        endurance_multi: { standings: true, relative: true, trackmap: true, fuel: true, pit: true, tires: false, inputs: false, radar: false },
        minimal_qualy: { standings: false, relative: false, trackmap: false, fuel: false, pit: false, tires: true, inputs: true, radar: false },
      };

      document.querySelectorAll("[data-sim-preset]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.getAttribute("data-sim-preset");
          const preset = SIM_PRESETS[key];
          if (!preset) return;
          Object.assign(enabledMods, preset);
          document.querySelectorAll("[data-toggle-mod]").forEach((chip) => {
            const m = chip.getAttribute("data-toggle-mod");
            const on = Boolean(enabledMods[m]);
            chip.classList.toggle("is-on", on);
            chip.setAttribute("aria-pressed", String(on));
          });
          document.querySelectorAll("[data-sim-preset]").forEach((b) => {
            b.style.borderColor = b === btn ? "#10b981" : "";
            b.style.color = b === btn ? "#34d399" : "";
          });
          syncVisibility();
        });
      });

      const lockHudBtn = document.getElementById("simLockHudBtn");
      const resetPosBtn = document.getElementById("simResetPosBtn");
      const cockpitLayerEl = document.getElementById("simCockpitLayer");
      const relFocusTagEl = document.getElementById("simRelFocusTag");
      const simStageEl = document.getElementById("simStage");
      let hudLocked = false;
      lockHudBtn?.addEventListener("click", () => {
        hudLocked = !hudLocked;
        lockHudBtn.setAttribute("aria-pressed", String(hudLocked));
        lockHudBtn.textContent = hudLocked ? "🔓 HUD Fijado" : "🔒 Fijar HUD";
        lockHudBtn.style.borderColor = hudLocked ? "#10b981" : "";
        lockHudBtn.style.color = hudLocked ? "#34d399" : "";
        if (simStageEl) simStageEl.classList.toggle("is-hud-locked", hudLocked);
      });

      // Interactive HUD Widget Dragging & Layout Reset
      if (cockpitLayerEl) {
        const draggableWidgets = cockpitLayerEl.querySelectorAll(".hud-box, .hud-radar-wrap");
        draggableWidgets.forEach((widget) => {
          let dragging = false;
          let startX = 0;
          let startY = 0;
          let baseDx = 0;
          let baseDy = 0;

          widget.addEventListener("pointerdown", (e) => {
            if (hudLocked || window.innerWidth <= 1040) return;
            if (e.target.closest("[data-st-id], [data-rel-slot], button")) return;
            dragging = true;
            startX = e.clientX;
            startY = e.clientY;
            baseDx = Number(widget.dataset.dx || 0);
            baseDy = Number(widget.dataset.dy || 0);
            widget.setPointerCapture(e.pointerId);
            widget.classList.add("is-dragging");
          });

          widget.addEventListener("pointermove", (e) => {
            if (!dragging) return;
            const dx = baseDx + (e.clientX - startX);
            const dy = baseDy + (e.clientY - startY);
            widget.dataset.dx = String(dx);
            widget.dataset.dy = String(dy);
            widget.style.translate = `${dx}px ${dy}px`;
          });

          const endDrag = () => {
            if (!dragging) return;
            dragging = false;
            widget.classList.remove("is-dragging");
          };
          widget.addEventListener("pointerup", endDrag);
          widget.addEventListener("pointercancel", endDrag);
        });

        resetPosBtn?.addEventListener("click", () => {
          cockpitLayerEl.querySelectorAll(".hud-box, .hud-radar-wrap").forEach((w) => {
            delete w.dataset.dx;
            delete w.dataset.dy;
            w.style.translate = "";
          });
        });
      }

      function focusDriverById(targetId) {
        const target = drivers.find((d) => d.id === targetId);
        if (!target) return;
        drivers.forEach((d) => {
          d.isMe = d.id === targetId;
        });
        if (relFocusTagEl) {
          relFocusTagEl.textContent = `#${target.num} ${target.name}`;
        }
        standingsRows.forEach((slot) => {
          const isMe = slot.d.isMe;
          slot.rowEl.classList.toggle("is-me", Boolean(isMe));
          slot.rowEl.style.borderLeftColor = isMe ? "#10b981" : CLASSES[slot.clsKey].color;
        });
        relPool.forEach((s) => { s.lastKey = ""; });
        if (trackDotsEl) {
          trackDotsEl.innerHTML = "";
          trackDotNodes.length = 0;
          trackDotsInit = false;
          initTrackMapDom();
        }
        renderStandings();
        renderRelative();
        renderTrackMap();
      }

      // Wire module toggle buttons
      document.querySelectorAll("[data-toggle-mod]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const mod = btn.getAttribute("data-toggle-mod");
          enabledMods[mod] = !enabledMods[mod];
          btn.classList.toggle("is-on", enabledMods[mod]);
          btn.setAttribute("aria-pressed", String(enabledMods[mod]));
          syncVisibility();
        });
      });

      const btnTrack = document.getElementById("simModeTrack");
      const btnReplay = document.getElementById("simModeReplay");
      if (btnTrack && btnReplay) {
        btnTrack.addEventListener("click", () => {
          isReplay = false;
          btnTrack.classList.add("is-active");
          btnReplay.classList.remove("is-active");
          btnTrack.setAttribute("aria-pressed", "true");
          btnReplay.setAttribute("aria-pressed", "false");
          syncVisibility();
        });
        btnReplay.addEventListener("click", () => {
          isReplay = true;
          btnReplay.classList.add("is-active");
          btnTrack.classList.remove("is-active");
          btnReplay.setAttribute("aria-pressed", "true");
          btnTrack.setAttribute("aria-pressed", "false");
          syncVisibility();
        });
      }

      const btnRadar = document.getElementById("simTriggerRadar");
      if (btnRadar) {
        btnRadar.addEventListener("click", () => {
          if (isReplay && btnTrack) btnTrack.click();
          if (!enabledMods.radar) {
            const chip = document.querySelector('[data-toggle-mod="radar"]');
            if (chip) chip.click();
          }
          radarOverrideMode = radarOverrideMode === 3 ? 1 : 3;
          const now = performance.now();
          radarOverrideUntil = now + 3600;
          btnRadar.textContent = radarOverrideMode === 3 ? "Simular 1-Wide" : "Simular 3-Wide";
          const meDrv = drivers.find((d) => d.isMe);
          if (meDrv) {
            const gt3Sec = CLASSES.GT3.lapSec;
            const berbis = drivers.find((d) => d.num === "1");
            const chongkan = drivers.find((d) => d.num === "22");
            if (berbis) {
              berbis.pct = (meDrv.pct + 0.1 / gt3Sec) % 1;
              berbis.lap = meDrv.lap;
            }
            if (chongkan) {
              const targetGapSec = radarOverrideMode === 3 ? -0.1 : -1.1;
              chongkan.pct = (meDrv.pct + targetGapSec / gt3Sec + 1) % 1;
              chongkan.lap = meDrv.lap;
            }
          }
          renderRadar(now, simTimeSec);
          renderRelative();
          renderTrackMap();
          renderTrackBackdrop(0, now, simTimeSec);
        });
      }

      const btnPause = document.getElementById("simPauseBtn");
      if (btnPause) {
        btnPause.addEventListener("click", () => {
          isPaused = !isPaused;
          btnPause.textContent = isPaused ? "Reanudar" : "Pausar";
          btnPause.setAttribute("aria-pressed", String(isPaused));
          syncVisibility();
        });
      }

      // Render Standings Multiclase (DOM built once; only textContent updated at <= 4 Hz)
      const standingsRows = [];
      let standingsInit = false;

      function initStandingsDom() {
        if (!standingsEl || standingsInit) return;
        standingsInit = true;
        let html = "";
        ["GTP", "LMP2", "GT3"].forEach((clsKey) => {
          const meta = CLASSES[clsKey];
          const group = drivers.filter((d) => d.cls === clsKey);
          if (!group.length) return;
          html += `<div class="st-cls-head" style="border-left-color:${meta.color};background:${meta.color}24">
            <span class="st-cls-name" style="color:${meta.color}">${clsKey}</span>
            <span class="st-cls-sof">${group.length}/${group.length} · SOF ${meta.sof}</span>
          </div>`;
          group.forEach((d, idx) => {
            const licBg = LIC_COLOR[d.lic] || "#64748b";
            const irExact = d.ir.endsWith("k") ? Math.round(parseFloat(d.ir) * 1000) : d.ir;
            const lapMin = Math.floor((meta.lapSec + idx * 0.312) / 60);
            const lapRem = ((meta.lapSec + idx * 0.312) % 60).toFixed(3).padStart(6, "0");
            const lapStr = `${lapMin}:${lapRem}`;
            html += `<div class="st-row ${d.isMe ? "is-me" : ""} ${d.isPit ? "is-pit" : ""}" data-st-id="${d.id}" title="Clic para seguir cámara y Relative de #${d.num} ${d.name}" style="border-left-color:${d.isMe ? "#10b981" : meta.color}">
              <span class="st-pos">${idx + 1}</span>
              <span class="st-num" style="color:${meta.color}">#${d.num}</span>
              <span class="st-name">${d.name}</span>
              ${brandSvg(d.brand, 16)}
              <span class="st-lic-ir" style="background:${licBg}">${d.lic}${d.sr} <span>${irExact}</span></span>
              <span class="st-gap">LDR</span>
              <span class="st-int">—</span>
              <span class="st-lap">${lapStr}</span>
            </div>`;
          });
        });
        standingsEl.innerHTML = html;
        standingsEl.querySelectorAll("[data-st-id]").forEach((rowEl) => {
          rowEl.addEventListener("click", () => {
            const id = Number(rowEl.getAttribute("data-st-id"));
            if (id) focusDriverById(id);
          });
        });
        ["GTP", "LMP2", "GT3"].forEach((clsKey) => {
          const group = drivers.filter((d) => d.cls === clsKey);
          group.forEach((d) => {
            const rowEl = standingsEl.querySelector(`[data-st-id="${d.id}"]`);
            if (rowEl) {
              standingsRows.push({
                d,
                clsKey,
                rowEl,
                posEl: rowEl.querySelector(".st-pos"),
                intEl: rowEl.querySelector(".st-int"),
                gapEl: rowEl.querySelector(".st-gap"),
                lapEl: rowEl.querySelector(".st-lap"),
                lastInt: "",
                lastGap: "",
                lastPos: "",
                lastLap: "",
              });
            }
          });
        });
      }

      function formatLapSec(sec) {
        const m = Math.floor(sec / 60);
        const rem = (sec % 60).toFixed(3).padStart(6, "0");
        return `${m}:${rem}`;
      }

      const stGroupBuf = [];
      function renderStandings() {
        if (!standingsEl || !enabledMods.standings) return;
        if (!standingsInit) initStandingsDom();
        ["GTP", "LMP2", "GT3"].forEach((clsKey) => {
          const meta = CLASSES[clsKey];
          stGroupBuf.length = 0;
          for (let i = 0; i < standingsRows.length; i++) {
            if (standingsRows[i].clsKey === clsKey) stGroupBuf.push(standingsRows[i]);
          }
          if (!stGroupBuf.length) return;
          stGroupBuf.sort((a, b) => (b.d.lap + b.d.pct) - (a.d.lap + a.d.pct));
          let cumGap = 0;
          for (let idx = 0; idx < stGroupBuf.length; idx++) {
            const slot = stGroupBuf[idx];
            const dist = slot.d.lap + slot.d.pct;
            const prevDist = idx > 0 ? stGroupBuf[idx - 1].d.lap + stGroupBuf[idx - 1].d.pct : dist;
            const intRounded = idx === 0 ? 0 : Math.max(0, Number(((prevDist - dist) * meta.lapSec).toFixed(3)));
            cumGap = idx === 0 ? 0 : Number((cumGap + intRounded).toFixed(3));
            const gapStr = idx === 0 ? "LDR" : cumGap.toFixed(3);
            const intStr = idx === 0 ? "—" : intRounded.toFixed(3);
            const posStr = String(idx + 1);
            // Realistic deterministic lap variation (±0.15s to ±0.45s across positions/laps)
            const lapVar = idx * 0.28 + ((slot.d.lap + slot.d.id) % 3) * 0.14;
            const lapStr = formatLapSec(meta.lapSec + lapVar);
            if (slot.lastPos !== posStr && slot.posEl) {
              slot.posEl.textContent = posStr;
              slot.lastPos = posStr;
            }
            if (slot.lastInt !== intStr && slot.intEl) {
              slot.intEl.textContent = intStr;
              slot.lastInt = intStr;
            }
            if (slot.lastGap !== gapStr && slot.gapEl) {
              slot.gapEl.textContent = gapStr;
              slot.lastGap = gapStr;
            }
            if (slot.lastLap !== lapStr && slot.lapEl) {
              slot.lapEl.textContent = lapStr;
              slot.lastLap = lapStr;
            }
          }
        });
      }

      // Render Relative Compacto (fixed 7-slot DOM pool; zero per-tick allocations)
      const relPool = [];
      const relItems = drivers.map((d) => ({ d, timeDelta: 0, tone: "same" }));
      const relAhead = [];
      const relBehind = [];
      const relOrdered = [];
      let relInit = false;

      function initRelativePool() {
        if (!relativeEl || relInit) return;
        relInit = true;
        let html = "";
        for (let i = 0; i < 7; i++) {
          html += `<div class="rel-row rel-row--same" data-rel-slot="${i}">
            <span class="rel-pos"></span>
            <span class="rel-num"></span>
            <span class="rel-name"></span>
            <span class="rel-brand"></span>
            <span class="rel-pit" hidden>PIT</span>
            <span class="rel-lic"></span>
            <span class="rel-ir"></span>
            <span class="rel-gap"></span>
          </div>`;
        }
        relativeEl.innerHTML = html;
        for (let i = 0; i < 7; i++) {
          const rowEl = relativeEl.querySelector(`[data-rel-slot="${i}"]`);
          rowEl?.addEventListener("click", () => {
            const drvId = Number(rowEl.dataset.drvId || 0);
            if (drvId) focusDriverById(drvId);
          });
          relPool.push({
            rowEl,
            posEl: rowEl.querySelector(".rel-pos"),
            numEl: rowEl.querySelector(".rel-num"),
            nameEl: rowEl.querySelector(".rel-name"),
            brandEl: rowEl.querySelector(".rel-brand"),
            pitEl: rowEl.querySelector(".rel-pit"),
            licEl: rowEl.querySelector(".rel-lic"),
            irEl: rowEl.querySelector(".rel-ir"),
            gapEl: rowEl.querySelector(".rel-gap"),
            lastKey: "",
            lastGap: "",
          });
        }
      }

      function renderRelative() {
        if (!relativeEl || !enabledMods.relative) return;
        if (!relInit) initRelativePool();
        const me = drivers.find((d) => d.isMe) || drivers[0];
        const refLapSec = CLASSES[me.cls].lapSec;

        relAhead.length = 0;
        relBehind.length = 0;
        let meItem = null;

        for (let i = 0; i < drivers.length; i++) {
          const d = drivers[i];
          const item = relItems[i];
          let dp = d.pct - me.pct;
          if (dp > 0.5) dp -= 1;
          if (dp < -0.5) dp += 1;
          const timeDelta = dp * refLapSec;
          const lapDiff = d.lap - me.lap;
          let tone = "same";
          if (d.isPit) tone = "pit";
          else if (d.isMe) tone = "me";
          else if (lapDiff > 0) tone = "lapping";
          else if (lapDiff < 0) tone = "lapped";
          item.d = d;
          item.timeDelta = timeDelta;
          item.tone = tone;
          if (d.isMe) meItem = item;
          else if (timeDelta >= 0) relAhead.push(item);
          else relBehind.push(item);
        }

        relAhead.sort((a, b) => a.timeDelta - b.timeDelta);
        relBehind.sort((a, b) => b.timeDelta - a.timeDelta);

        relOrdered.length = 0;
        const aheadCount = Math.min(3, relAhead.length);
        for (let i = aheadCount - 1; i >= 0; i--) relOrdered.push(relAhead[i]);
        if (meItem) relOrdered.push(meItem);
        const behindCount = Math.min(3, relBehind.length);
        for (let i = 0; i < behindCount; i++) relOrdered.push(relBehind[i]);

        for (let i = 0; i < relPool.length; i++) {
          const slot = relPool[i];
          const entry = relOrdered[i];
          if (!entry) {
            slot.rowEl.style.display = "none";
            continue;
          }
          slot.rowEl.style.display = "";
          const { d, timeDelta, tone } = entry;
          const slotKey = `${d.id}|${tone}`;
          if (slot.lastKey !== slotKey) {
            slot.lastKey = slotKey;
            slot.rowEl.dataset.drvId = String(d.id);
            slot.rowEl.className = `rel-row rel-row--${tone}`;
            slot.rowEl.style.borderLeftColor = d.isMe ? "#10b981" : CLASSES[d.cls].color;
            slot.posEl.textContent = String(d.id);
            slot.numEl.textContent = `#${d.num}`;
            slot.numEl.style.color = CLASSES[d.cls].color;
            slot.nameEl.textContent = d.name;
            if (slot.brandEl) slot.brandEl.innerHTML = brandSvg(d.brand, 14);
            if (d.isPit) {
              slot.pitEl.hidden = false;
              slot.licEl.hidden = true;
              slot.irEl.hidden = true;
            } else {
              slot.pitEl.hidden = true;
              slot.licEl.hidden = false;
              slot.irEl.hidden = false;
              slot.licEl.style.background = LIC_COLOR[d.lic] || "#64748b";
              slot.licEl.textContent = `${d.lic}${d.sr.slice(0, 3)}`;
              slot.irEl.textContent = d.ir;
            }
          }
          const gapText = d.isMe ? "0.0" : `${timeDelta >= 0 ? "+" : ""}${timeDelta.toFixed(1)}`;
          if (slot.lastGap !== gapText) {
            slot.lastGap = gapText;
            slot.gapEl.textContent = gapText;
          }
        }
      }

      // Render Track Map Dots (SVG nodes created once; only cx/cy/x/y attributes updated)
      const trackDotNodes = [];
      let trackDotsInit = false;

      function initTrackMapDom() {
        if (!trackDotsEl || trackDotsInit) return;
        trackDotsInit = true;
        const ns = "http://www.w3.org/2000/svg";
        drivers.forEach((d) => {
          const color = CLASSES[d.cls].color;
          let halo = null;
          if (d.isMe) {
            halo = document.createElementNS(ns, "circle");
            halo.setAttribute("r", "10.5");
            halo.setAttribute("fill", "rgba(16,185,129,0.28)");
            halo.setAttribute("stroke", "#10b981");
            halo.setAttribute("stroke-width", "1.6");
            trackDotsEl.appendChild(halo);
          }
          const dot = document.createElementNS(ns, "circle");
          dot.setAttribute("r", "6");
          dot.setAttribute("fill", color);
          dot.setAttribute("stroke", "#090b0f");
          dot.setAttribute("stroke-width", "1.2");
          trackDotsEl.appendChild(dot);

          const label = document.createElementNS(ns, "text");
          label.setAttribute("text-anchor", "middle");
          label.setAttribute("font-size", "6.2");
          label.setAttribute("font-family", "ui-monospace,monospace");
          label.setAttribute("font-weight", "800");
          label.setAttribute("fill", "#ffffff");
          label.textContent = d.num;
          trackDotsEl.appendChild(label);

          trackDotNodes.push({ d, halo, dot, label });
        });
      }

      function renderTrackMap() {
        if (!trackDotsEl || !enabledMods.trackmap) return;
        if (!trackDotsInit) initTrackMapDom();
        for (let i = 0; i < trackDotNodes.length; i++) {
          const node = trackDotNodes[i];
          const [x, y] = pointOnSpline(node.d.pct);
          const xs = x.toFixed(1);
          const ys = y.toFixed(1);
          if (node.halo) {
            node.halo.setAttribute("cx", xs);
            node.halo.setAttribute("cy", ys);
          }
          node.dot.setAttribute("cx", xs);
          node.dot.setAttribute("cy", ys);
          node.label.setAttribute("x", xs);
          node.label.setAttribute("y", (y + 2.4).toFixed(1));
        }
      }

      // Shared 10s lap-sector telemetry model (fast straight 275 km/h -> 200m/100m heavy braking 90-98% to 85 km/h -> apex)
      function computeTelemetryState(tSec) {
        const u = (tSec % 10) / 10;
        let throttle = 1;
        let brake = 0;
        let clutch = 0;
        let speed = 275;
        let gear = 6;
        let downshiftFlash = 0;

        if (u < 0.48) {
          // Flat-out straight acceleration up to 275 km/h
          const p = u / 0.48;
          throttle = Math.min(1, 0.90 + p * 0.10);
          speed = Math.round(212 + p * 63);
          gear = speed > 240 ? 6 : 5;
        } else if (u < 0.74) {
          // Heavy braking zone (90-98% brake + rapid 6->5->4->3->2 downshifts + heel-toe blip)
          const b = (u - 0.48) / 0.26;
          brake = b < 0.12 ? 0.65 + (b / 0.12) * 0.30 : b < 0.76 ? 0.92 + Math.sin(b * 32) * 0.05 : Math.max(0.22, 0.94 * (1 - (b - 0.76) / 0.24));
          const blipPhase = (b * 4) % 1;
          const isBlip = b > 0.14 && b < 0.88 && blipPhase < 0.25;
          throttle = isBlip ? 0.46 : 0;
          clutch = isBlip ? 0.24 : 0;
          downshiftFlash = isBlip ? 1 : 0;
          speed = Math.round(275 - b * 190);
          gear = b < 0.20 ? 6 : b < 0.40 ? 5 : b < 0.60 ? 4 : b < 0.80 ? 3 : 2;
        } else {
          // Apex roll-on & corner exit (85 km/h -> 212 km/h)
          const e = (u - 0.74) / 0.26;
          throttle = Math.min(1, 0.36 + e * 0.64);
          brake = 0;
          speed = Math.round(85 + e * 127);
          gear = speed > 190 ? 5 : speed > 150 ? 4 : speed > 115 ? 3 : 2;
        }

        return { u, throttle, brake, clutch, speed, gear, downshiftFlash };
      }

      // Render Pedal Canvas + Telemetry
      function renderInputs(tSec) {
        if (!enabledMods.inputs || isReplay) return;
        const { throttle, brake, clutch, speed, gear } = computeTelemetryState(tSec);

        traceT.copyWithin(0, 1); traceT[TRACE_LEN - 1] = throttle;
        traceB.copyWithin(0, 1); traceB[TRACE_LEN - 1] = brake;
        traceC.copyWithin(0, 1); traceC[TRACE_LEN - 1] = clutch;

        if (throttleBar) throttleBar.style.height = `${Math.round(throttle * 100)}%`;
        if (brakeBar) brakeBar.style.height = `${Math.round(brake * 100)}%`;
        if (clutchBar) clutchBar.style.height = `${Math.round(clutch * 100)}%`;

        if (gearEl) gearEl.textContent = String(gear);
        if (speedEl) speedEl.textContent = String(speed);

        // Delta bar oscillation (-0.52s to +0.28s)
        const delta = -0.14 + Math.sin(tSec * 0.35) * 0.34;
        if (deltaValEl) {
          deltaValEl.textContent = `${delta >= 0 ? "+" : ""}${delta.toFixed(2)}s`;
          deltaValEl.style.color = delta <= 0 ? "#34d399" : "#f87171";
        }
        if (deltaFillEl) {
          const pct = Math.min(50, (Math.abs(delta) / 0.8) * 50);
          deltaFillEl.style.width = `${pct.toFixed(1)}%`;
          deltaFillEl.style.left = delta <= 0 ? `${(50 - pct).toFixed(1)}%` : "50%";
          deltaFillEl.style.background = delta <= 0 ? "#10b981" : "#ef4444";
        }

        if (pedalCtx && pedalCanvas) {
          const w = pedalCanvas.width;
          const h = pedalCanvas.height;
          pedalCtx.clearRect(0, 0, w, h);
          // Grid lines
          pedalCtx.strokeStyle = "rgba(255,255,255,0.06)";
          pedalCtx.lineWidth = 1;
          [0.25, 0.5, 0.75].forEach((g) => {
            pedalCtx.beginPath();
            pedalCtx.moveTo(0, h * g);
            pedalCtx.lineTo(w, h * g);
            pedalCtx.stroke();
          });

          const drawSeries = (arr, color) => {
            pedalCtx.beginPath();
            pedalCtx.strokeStyle = color;
            pedalCtx.lineWidth = 2;
            for (let i = 0; i < TRACE_LEN; i++) {
              const x = (i / (TRACE_LEN - 1)) * w;
              const y = h - 4 - arr[i] * (h - 8);
              if (i === 0) pedalCtx.moveTo(x, y);
              else pedalCtx.lineTo(x, y);
            }
            pedalCtx.stroke();
          };
          drawSeries(traceC, "#38bdf8");
          drawSeries(traceB, "#ef4444");
          drawSeries(traceT, "#10b981");
        }
      }

      // Button: Cambiar Circuito manually
      const btnNextCircuit = document.getElementById("simNextCircuitBtn");
      let lastCircuitSwitchMs = performance.now();
      if (btnNextCircuit) {
        btnNextCircuit.addEventListener("click", () => {
          applyCircuit(activeCircuitIdx + 1);
          lastCircuitSwitchMs = performance.now();
          renderStandings();
          renderRelative();
          renderTrackMap();
        });
      }

      // Prototype multiclass overtake cycle (GTP #01 or LMP2 #32 passing GT3 pack on the inside)
      function computePrototypePass(tSec) {
        const cycIdx = Math.floor(tSec / 10);
        const cyc = tSec % 10;
        // Prototype sweeps from -0.8s behind to +0.8s ahead between 3.0s and 5.6s
        if (cyc >= 3.0 && cyc <= 5.6) {
          const progress = (cyc - 3.0) / 2.6; // 0..1
          const deltaSec = -0.8 + progress * 1.6; // -0.8s -> +0.8s
          const isGtp = cycIdx % 2 === 0;
          return {
            active: true,
            progress,
            deltaSec,
            protoNum: isGtp ? "01" : "32",
            isGtp,
          };
        }
        return { active: false, progress: 0, deltaSec: 2.4, protoNum: cycIdx % 2 === 0 ? "01" : "32", isGtp: cycIdx % 2 === 0 };
      }

      // Render Radar (CarLeftRight) synced with prototype overtake & 3-wide GT3 battle
      function computeBattleState(nowMs, tSec) {
        if (nowMs < radarOverrideUntil) {
          return radarOverrideMode; // manual trigger 1 or 3
        }
        const proto = computePrototypePass(tSec);
        if (proto.active && Math.abs(proto.deltaSec) < 0.42) {
          return 1; // Prototype alongside on the left inside!
        }
        const cyc = tSec % 10;
        if (cyc >= 6.4 && cyc < 8.8) return 3; // 3-wide GT3 pack into braking/exit
        return 0;
      }

      function renderRadar(nowMs, tSec) {
        if (!radarEl || !enabledMods.radar || isReplay) return;
        const state = computeBattleState(nowMs, tSec);

        const active = state > 0;
        radarEl.setAttribute("data-state", active ? (state === 3 ? "threewide" : "side") : "clear");

        const leftOn = state === 1 || state === 3;
        const rightOn = state === 2 || state === 3;
        const color = state === 3 ? "#ef4444" : "#f59e0b";

        if (radarArcLeft) radarArcLeft.setAttribute("stroke", leftOn ? color : "transparent");
        if (radarArcRight) radarArcRight.setAttribute("stroke", rightOn ? color : "transparent");
        if (radarCarLeft) {
          radarCarLeft.setAttribute("fill", color);
          radarCarLeft.setAttribute("stroke", color);
          radarCarLeft.setAttribute("fill-opacity", leftOn ? "0.38" : "0");
          radarCarLeft.setAttribute("stroke-opacity", leftOn ? "1" : "0");
        }
        if (radarCarRight) {
          radarCarRight.setAttribute("fill", color);
          radarCarRight.setAttribute("stroke", color);
          radarCarRight.setAttribute("fill-opacity", rightOn ? "0.38" : "0");
          radarCarRight.setAttribute("stroke-opacity", rightOn ? "1" : "0");
        }
        if (radarLabelEl) {
          radarLabelEl.textContent = state === 3 ? "3-WIDE!" : state === 1 ? "CAR LEFT" : state === 2 ? "CAR RIGHT" : "CLEAR";
          radarLabelEl.style.color = state === 3 ? "#f87171" : active ? "#fbbf24" : "#64748b";
        }
      }

      // -----------------------------------------------------------------------
      // Offscreen Sprite & Background Cache (0 gradients / 0 shadowBlur per frame)
      // -----------------------------------------------------------------------
      const backdropCanvas = document.getElementById("simTrackBackdropCanvas");
      const backdropCtx = backdropCanvas ? backdropCanvas.getContext("2d", { alpha: false }) : null;
      let roadOffset = 0;

      const SPRITE_W = 160;
      const SPRITE_H = 116;

      function createGt3Sprite(model, bodyColor, accentColor, secondaryColor, numLabel, isBraking) {
        const c = document.createElement("canvas");
        c.width = SPRITE_W;
        c.height = SPRITE_H;
        const ctx = c.getContext("2d");
        ctx.translate(SPRITE_W * 0.5, SPRITE_H * 0.62);

        // Ground shadow
        const sg = ctx.createRadialGradient(0, 20, 8, 0, 20, 66);
        sg.addColorStop(0, "rgba(0,0,0,0.84)");
        sg.addColorStop(0.68, "rgba(0,0,0,0.45)");
        sg.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = sg;
        ctx.beginPath();
        ctx.ellipse(0, 20, 66, 13, 0, 0, Math.PI * 2);
        ctx.fill();

        // Wide rear slick tires + glowing brake discs
        ctx.fillStyle = "#080a0e";
        ctx.beginPath();
        ctx.roundRect(-53, 3, 18, 20, 4);
        ctx.roundRect(35, 3, 18, 20, 4);
        ctx.fill();
        if (isBraking) {
          ctx.fillStyle = "rgba(249, 115, 22, 0.72)";
          ctx.fillRect(-38, 9, 4, 10);
          ctx.fillRect(34, 9, 4, 10);
        }

        // Carbon rear diffuser with vertical aero fins + dual exhausts
        ctx.fillStyle = "#090b0f";
        ctx.beginPath();
        ctx.moveTo(-40, 11);
        ctx.lineTo(40, 11);
        ctx.lineTo(35, 21);
        ctx.lineTo(-35, 21);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = "#1e293b";
        [-24, -14, 14, 24].forEach((fx) => ctx.fillRect(fx - 1, 12, 2, 8));

        ctx.fillStyle = "#475569";
        ctx.beginPath();
        ctx.arc(-6, 16, 3, 0, Math.PI * 2);
        ctx.arc(6, 16, 3, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = "#020617";
        ctx.beginPath();
        ctx.arc(-6, 16, 1.8, 0, Math.PI * 2);
        ctx.arc(6, 16, 1.8, 0, Math.PI * 2);
        ctx.fill();

        // Rectangular FIA center brake/rain light with pre-rendered soft halo
        ctx.save();
        if (isBraking) {
          ctx.fillStyle = "rgba(239, 68, 68, 0.28)";
          ctx.beginPath();
          ctx.arc(0, 13.5, 9, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowColor = "#ef4444";
          ctx.shadowBlur = 14;
          ctx.fillStyle = "#ff2a2a";
        } else {
          ctx.fillStyle = "#7f1d1d";
        }
        ctx.fillRect(-3.2, 11.5, 6.4, 3.6);
        ctx.restore();

        // Wide, low GT3 body + rounded widebody rear wheel arches using Bezier curves
        const hipExtra = model === "porsche" ? 3.5 : 0;
        const bg = ctx.createLinearGradient(0, -23, 0, 14);
        bg.addColorStop(0, bodyColor);
        bg.addColorStop(1, secondaryColor);
        ctx.fillStyle = bg;
        ctx.beginPath();
        ctx.moveTo(-49 - hipExtra, 11);
        ctx.bezierCurveTo(-56 - hipExtra, 3, -55 - hipExtra, -10, -44, -17);
        ctx.bezierCurveTo(-38, -21, -32, -23, -27, -23);
        ctx.lineTo(27, -23);
        ctx.bezierCurveTo(32, -23, 38, -21, 44, -17);
        ctx.bezierCurveTo(55 + hipExtra, -10, 56 + hipExtra, 3, 49 + hipExtra, 11);
        ctx.bezierCurveTo(44, 13, 40, 13.5, 36, 13);
        ctx.lineTo(-36, 13);
        ctx.bezierCurveTo(-40, 13.5, -44, 13, -49 - hipExtra, 11);
        ctx.closePath();
        ctx.fill();

        // Center stripe & matte black hood/roof (Mustang) or wheel-arch aero vents (McLaren)
        ctx.fillStyle = model === "mustang" ? "#0f172a" : secondaryColor;
        ctx.fillRect(-13, -23, 26, 34);
        ctx.fillStyle = accentColor;
        ctx.fillRect(-15, -23, 2.2, 34);
        ctx.fillRect(12.8, -23, 2.2, 34);
        if (model === "mclaren") {
          ctx.fillStyle = "#090b0f";
          ctx.beginPath();
          ctx.moveTo(-47, -3);
          ctx.bezierCurveTo(-42, -3, -40, 2, -40, 8);
          ctx.lineTo(-47, 8);
          ctx.closePath();
          ctx.fill();
          ctx.beginPath();
          ctx.moveTo(47, -3);
          ctx.bezierCurveTo(42, -3, 40, 2, 40, 8);
          ctx.lineTo(47, 8);
          ctx.closePath();
          ctx.fill();
        }

        // Domed trapezoidal GT3 greenhouse tapering upward with sloped C-pillars & meshed rear window
        ctx.fillStyle = "#0b1120";
        ctx.beginPath();
        ctx.moveTo(-30, -19);
        ctx.bezierCurveTo(-27, -29, -23, -37, -17, -38.5);
        ctx.bezierCurveTo(-8, -40, 8, -40, 17, -38.5);
        ctx.bezierCurveTo(23, -37, 27, -29, 30, -19);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = "rgba(255,255,255,0.20)";
        ctx.lineWidth = 1;
        ctx.stroke();

        // Internal roll cage & subtle rear glass mesh
        ctx.strokeStyle = "rgba(148, 163, 184, 0.35)";
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(-18, -34);
        ctx.lineTo(14, -20);
        ctx.moveTo(18, -34);
        ctx.lineTo(-14, -20);
        ctx.stroke();

        // Model-specific horizontal LED taillights
        ctx.save();
        ctx.shadowColor = "#ef4444";
        ctx.shadowBlur = isBraking ? 18 : 8;
        ctx.fillStyle = isBraking ? "#ff1f1f" : "#dc2626";
        if (model === "mustang") {
          // Mustang triple vertical LED bars on each side
          [-43, -37, -31, 28, 34, 40].forEach((bx) => {
            ctx.fillRect(bx, -13, 3.2, 7.5);
          });
        } else if (model === "porsche") {
          // Porsche 911 continuous full-width LED light bar
          ctx.beginPath();
          ctx.roundRect(-44, -11, 88, 3.6, 1.5);
          ctx.fill();
        } else {
          // McLaren 720S thin curved LED blades
          ctx.lineWidth = 3.2;
          ctx.strokeStyle = isBraking ? "#ff2a2a" : "#ef4444";
          ctx.beginPath();
          ctx.moveTo(-44, -8);
          ctx.quadraticCurveTo(-34, -14, -23, -9);
          ctx.moveTo(23, -9);
          ctx.quadraticCurveTo(34, -14, 44, -8);
          ctx.stroke();
        }
        ctx.restore();

        // Swan-neck pylons + wide carbon GT3 rear wing with endplates
        ctx.fillStyle = "#0f172a";
        ctx.fillRect(-19, -42, 4, 21);
        ctx.fillRect(15, -42, 4, 21);

        ctx.fillStyle = "#090b0f";
        ctx.beginPath();
        ctx.moveTo(-55, -43);
        ctx.quadraticCurveTo(0, -46, 55, -43);
        ctx.lineTo(53, -37);
        ctx.quadraticCurveTo(0, -40, -53, -37);
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = "rgba(255,255,255,0.16)";
        ctx.fillRect(-48, -43, 96, 1.2);
        ctx.fillStyle = accentColor;
        ctx.fillRect(-56, -45, 4, 14);
        ctx.fillRect(52, -45, 4, 14);

        // Number plate
        ctx.fillStyle = "rgba(9,11,15,0.92)";
        ctx.beginPath();
        ctx.roundRect(-12, -13, 24, 13, 3);
        ctx.fill();
        ctx.strokeStyle = accentColor;
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.fillStyle = "#ffffff";
        ctx.font = "800 9.5px ui-monospace, monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(numLabel, 0, -6.5);

        return c;
      }

      function createPrototypeSprite(bodyColor, accentColor, numLabel, isBraking) {
        const c = document.createElement("canvas");
        c.width = SPRITE_W;
        c.height = SPRITE_H;
        const ctx = c.getContext("2d");
        ctx.translate(SPRITE_W * 0.5, SPRITE_H * 0.62);

        // Narrower prototype proportions (~58px base width) + protruding wheel arches + bubble canopy + shark fin
        ctx.fillStyle = "rgba(0,0,0,0.72)";
        ctx.beginPath();
        ctx.ellipse(0, 16, 48, 10, 0, 0, Math.PI * 2);
        ctx.fill();

        // Protruding front/rear wheel arches
        ctx.fillStyle = "#090b0f";
        ctx.beginPath();
        ctx.roundRect(-42, 0, 84, 14, 4);
        ctx.fill();

        ctx.fillStyle = bodyColor;
        ctx.beginPath();
        ctx.moveTo(-42, 10);
        ctx.quadraticCurveTo(-44, -9, -32, -13);
        ctx.lineTo(-16, -13);
        ctx.lineTo(-11, -24);
        ctx.lineTo(11, -24);
        ctx.lineTo(16, -13);
        ctx.lineTo(32, -13);
        ctx.quadraticCurveTo(44, -9, 42, 10);
        ctx.closePath();
        ctx.fill();

        // Narrow central bubble canopy
        ctx.fillStyle = "#0b1120";
        ctx.beginPath();
        ctx.ellipse(0, -18, 11, 11, 0, Math.PI, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "rgba(255,255,255,0.22)";
        ctx.lineWidth = 1;
        ctx.stroke();

        // Longitudinal shark fin along engine cover
        ctx.fillStyle = accentColor;
        ctx.beginPath();
        ctx.moveTo(-1.5, -31);
        ctx.lineTo(1.5, -31);
        ctx.lineTo(2.5, -7);
        ctx.lineTo(-2.5, -7);
        ctx.closePath();
        ctx.fill();

        // Prototype LED light blades
        ctx.save();
        ctx.shadowColor = "#ef4444";
        ctx.shadowBlur = isBraking ? 16 : 8;
        ctx.fillStyle = isBraking ? "#ff2a2a" : "#dc2626";
        ctx.fillRect(-38, -6, 12, 3);
        ctx.fillRect(26, -6, 12, 3);
        ctx.fillRect(-38, -11, 3, 8);
        ctx.fillRect(35, -11, 3, 8);
        ctx.restore();

        // Twin-plane prototype rear wing
        ctx.fillStyle = "#090b0f";
        ctx.fillRect(-44, -31, 88, 5);
        ctx.fillStyle = accentColor;
        ctx.fillRect(-45, -33, 3.5, 15);
        ctx.fillRect(41.5, -33, 3.5, 15);

        ctx.fillStyle = "rgba(9,11,15,0.92)";
        ctx.beginPath();
        ctx.roundRect(-11, -8, 22, 11, 3);
        ctx.fill();
        ctx.strokeStyle = accentColor;
        ctx.lineWidth = 1;
        ctx.stroke();
        ctx.fillStyle = "#ffffff";
        ctx.font = "800 8.5px ui-monospace, monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(numLabel, 0, -2.5);

        return c;
      }

      const CAR_SPRITES = {
        mustang:  [createGt3Sprite("mustang", "#1d4ed8", "#10b981", "#0f172a", "16", false), createGt3Sprite("mustang", "#1d4ed8", "#10b981", "#0f172a", "16", true)],
        porsche:  [createGt3Sprite("porsche", "#e2e8f0", "#ef4444", "#111827", "1",  false), createGt3Sprite("porsche", "#e2e8f0", "#ef4444", "#111827", "1",  true)],
        mclaren:  [createGt3Sprite("mclaren", "#ff8000", "#ff8000", "#111827", "22", false), createGt3Sprite("mclaren", "#ff8000", "#ff8000", "#111827", "22", true)],
        gtp01:    [createPrototypeSprite("#facc15", "#111827", "01", false), createPrototypeSprite("#facc15", "#111827", "01", true)],
        lmp232:   [createPrototypeSprite("#06b6d4", "#0284c7", "32", false), createPrototypeSprite("#06b6d4", "#0284c7", "32", true)],
      };

      const bgCacheCanvas = document.createElement("canvas");
      let bgCacheW = 0;
      let bgCacheH = 0;

      function ensureBgCache(w, h) {
        if (bgCacheW === w && bgCacheH === h) return;
        bgCacheW = w;
        bgCacheH = h;
        bgCacheCanvas.width = w;
        bgCacheCanvas.height = h;
        const bctx = bgCacheCanvas.getContext("2d");
        const horizonY = h * 0.42;

        const sky = bctx.createLinearGradient(0, 0, 0, horizonY);
        sky.addColorStop(0, "#05070b");
        sky.addColorStop(0.65, "#0a1019");
        sky.addColorStop(1, "#111c26");
        bctx.fillStyle = sky;
        bctx.fillRect(0, 0, w, horizonY + 2);

        const glow = bctx.createRadialGradient(w * 0.5, horizonY, 20, w * 0.5, horizonY, w * 0.52);
        glow.addColorStop(0, "rgba(16, 185, 129, 0.14)");
        glow.addColorStop(1, "rgba(5, 7, 11, 0)");
        bctx.fillStyle = glow;
        bctx.fillRect(0, 0, w, horizonY + 40);

        bctx.fillStyle = "#080b10";
        bctx.fillRect(0, horizonY, w, h - horizonY);
      }

      function drawCarSprite(ctx, sprite, x, y, scale, downshiftFlash, brakeAmount = 0, rollRad = 0) {
        const pitchScale = 1 + brakeAmount * 0.042;
        const pitchY = brakeAmount * 5.2 * scale;
        const dw = SPRITE_W * scale * 0.84 * pitchScale;
        const dh = SPRITE_H * scale * 0.84 * (1 - brakeAmount * 0.03);
        ctx.save();
        ctx.translate(x, y + pitchY);
        if (rollRad !== 0) ctx.rotate(rollRad);
        ctx.drawImage(sprite, -dw * 0.5, -dh * 0.62, dw, dh);

        // Front-wheel brake dust / smoke particles under heavy braking
        if (brakeAmount > 0.55) {
          const dustAlpha = ((brakeAmount - 0.5) * 0.65).toFixed(2);
          ctx.fillStyle = `rgba(203, 213, 225, ${dustAlpha})`;
          ctx.beginPath();
          ctx.arc(-44 * scale, 12 * scale, 5 * scale, 0, Math.PI * 2);
          ctx.arc(44 * scale, 12 * scale, 5 * scale, 0, Math.PI * 2);
          ctx.fill();
        }

        if (downshiftFlash > 0) {
          ctx.fillStyle = "#fed7aa";
          ctx.fillRect(-8 * scale, 10 * scale, 4.5 * scale, 4.5 * scale);
          ctx.fillRect(3.5 * scale, 10 * scale, 4.5 * scale, 4.5 * scale);
        }
        ctx.restore();
      }

      function renderTrackBackdrop(dt, nowMs, tSec) {
        if (!backdropCanvas || !backdropCtx) return;
        const rect = backdropCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        const w = Math.min(1280, Math.max(640, Math.round(rect.width || 1180)));
        const h = Math.min(720, Math.max(400, Math.round(rect.height || 640)));
        const bw = Math.round(w * dpr);
        const bh = Math.round(h * dpr);
        if (backdropCanvas.width !== bw || backdropCanvas.height !== bh) {
          backdropCanvas.width = bw;
          backdropCanvas.height = bh;
        }
        backdropCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const speedKmh = Number(speedEl?.textContent || 214);
        const speedNorm = Math.max(0.4, speedKmh / 200);
        roadOffset = (roadOffset + dt * 6.5 * speedNorm) % 1;

        const ctx = backdropCtx;
        const horizonY = h * 0.42;
        ensureBgCache(w, h);
        ctx.drawImage(bgCacheCanvas, 0, 0, w, h);

        // Master lapProgress-driven smooth curvature & exponential lerped car formation (0 wobble/jumps)
        const targetCurve = Math.sin(lapProgress * Math.PI * 2) * 0.24;
        const lerpK = dt > 0 ? 1 - Math.exp(-6 * dt) : 1;
        smoothCurve += (targetCurve - smoothCurve) * lerpK;
        const curveFactor = smoothCurve;

        const tel = computeTelemetryState(tSec);
        const isBrakingZone = tel.u >= 0.44 && tel.u <= 0.74;

        // Perspective road strips (moving kerbs, asphalt grain, braking marks, racing line)
        const slices = 42;
        for (let i = 0; i < slices; i++) {
          const p0 = i / slices;
          const p1 = (i + 1) / slices;
          const z0 = p0 * p0;
          const z1 = p1 * p1;
          const y0 = horizonY + z0 * (h - horizonY);
          const y1 = horizonY + z1 * (h - horizonY);

          const cx0 = w * 0.5 + curveFactor * w * (1 - p0) * (1 - p0);
          const cx1 = w * 0.5 + curveFactor * w * (1 - p1) * (1 - p1);
          const halfW0 = w * (0.045 + z0 * 0.46);
          const halfW1 = w * (0.045 + z1 * 0.46);

          const stripePhase = Math.floor((p0 * 14 - roadOffset * 2 + 100) % 2);
          const kerbColor = stripePhase === 0 ? "rgba(239, 68, 68, 0.65)" : "rgba(248, 250, 252, 0.55)";

          // Kerbs left & right
          const kw0 = halfW0 * 0.08;
          const kw1 = halfW1 * 0.08;
          ctx.fillStyle = kerbColor;
          ctx.beginPath();
          ctx.moveTo(cx0 - halfW0 - kw0, y0);
          ctx.lineTo(cx0 - halfW0, y0);
          ctx.lineTo(cx1 - halfW1, y1);
          ctx.lineTo(cx1 - halfW1 - kw1, y1);
          ctx.closePath();
          ctx.fill();

          ctx.beginPath();
          ctx.moveTo(cx0 + halfW0, y0);
          ctx.lineTo(cx0 + halfW0 + kw0, y0);
          ctx.lineTo(cx1 + halfW1 + kw1, y1);
          ctx.lineTo(cx1 + halfW1, y1);
          ctx.closePath();
          ctx.fill();

          // Textured asphalt
          ctx.fillStyle = stripePhase === 0 ? "#131822" : "#111620";
          ctx.beginPath();
          ctx.moveTo(cx0 - halfW0, y0);
          ctx.lineTo(cx0 + halfW0, y0);
          ctx.lineTo(cx1 + halfW1, y1);
          ctx.lineTo(cx1 - halfW1, y1);
          ctx.closePath();
          ctx.fill();

          // Dark rubber braking marks on asphalt during braking zone (intensifying with brake pressure)
          if (isBrakingZone) {
            const skidAlpha = (0.28 + 0.52 * tel.brake).toFixed(2);
            ctx.fillStyle = `rgba(0,0,0,${skidAlpha})`;
            ctx.fillRect(cx1 - halfW1 * 0.46, y0, halfW1 * 0.075, Math.max(1, y1 - y0));
            ctx.fillRect(cx1 + halfW1 * 0.385, y0, halfW1 * 0.075, Math.max(1, y1 - y0));
            ctx.fillRect(cx1 - halfW1 * 0.14, y0, halfW1 * 0.055, Math.max(1, y1 - y0));
            ctx.fillRect(cx1 + halfW1 * 0.085, y0, halfW1 * 0.055, Math.max(1, y1 - y0));
          }

          // Dynamic racing line
          ctx.strokeStyle = "rgba(16, 185, 129, 0.12)";
          ctx.lineWidth = Math.max(1, z1 * 3.5);
          ctx.beginPath();
          ctx.moveTo(cx0 + curveFactor * halfW0 * 0.45, y0);
          ctx.lineTo(cx1 + curveFactor * halfW1 * 0.45, y1);
          ctx.stroke();

          // Center dashed line
          if (stripePhase === 0) {
            ctx.strokeStyle = "rgba(255,255,255,0.09)";
            ctx.lineWidth = Math.max(1, z1 * 2.2);
            ctx.beginPath();
            ctx.moveTo(cx0, y0);
            ctx.lineTo(cx1, y1);
            ctx.stroke();
          }
        }

        // Trackside Braking Distance Marker Boards (200m, 100m, 50m)
        if (isBrakingZone) {
          const boards = [
            { label: "200m", offset: 0.44 },
            { label: "100m", offset: 0.52 },
            { label: "50m",  offset: 0.60 },
          ];
          boards.forEach((b) => {
            const p = (tel.u - b.offset) / 0.16;
            if (p >= 0 && p <= 1) {
              const z = p * p;
              const by = horizonY + z * (h - horizonY);
              const bx = w * 0.5 + curveFactor * w * (1 - p) * (1 - p) - w * (0.06 + z * 0.52);
              const bw = 24 + z * 30;
              const bh = 13 + z * 16;
              ctx.fillStyle = "#f8fafc";
              ctx.fillRect(bx - bw * 0.5, by - bh, bw, bh);
              ctx.strokeStyle = "#090b0f";
              ctx.lineWidth = 1.5;
              ctx.strokeRect(bx - bw * 0.5, by - bh, bw, bh);
              ctx.fillStyle = "#090b0f";
              ctx.font = `900 ${Math.round(8 + z * 6)}px ui-monospace, monospace`;
              ctx.textAlign = "center";
              ctx.textBaseline = "middle";
              ctx.fillText(b.label, bx, by - bh * 0.5);
            }
          });
        }

        // Closed track-bound positioning helpers (laneOffset strictly clamped to [-0.68, +0.68])
        const roadCenterX = (y) => {
          const p = Math.max(0, Math.min(1, Math.sqrt(Math.max(0, (y - horizonY) / (h - horizonY)))));
          return w * 0.5 + curveFactor * w * (1 - p) * (1 - p);
        };
        const roadHalfWidth = (y) => {
          const z = Math.max(0, Math.min(1, (y - horizonY) / (h - horizonY)));
          return w * (0.045 + z * 0.46);
        };
        const trackBoundX = (y, laneOffset) => {
          const clamped = Math.max(-0.68, Math.min(0.68, laneOffset));
          return roadCenterX(y) + clamped * roadHalfWidth(y);
        };

        // Chase Cam perspective: #16 A. Trujillo foreground at y = 74%, scale 1.15x;
        // clean track ahead in P1 except overtaking GTP/LMP2 prototype pulling away ahead;
        // #1 M. Berbis (-0.6s) and #22 E. Chongkan (-1.2s) enter alongside smoothly during 3-Wide
        const battle = computeBattleState(nowMs, tSec);
        const proto = computePrototypePass(tSec);
        const brakeState = tel.brake > 0.25 ? 1 : 0;
        const rollRad = curveFactor * 0.16; // ±2.2° body roll tangential to corner

        const targetPull = battle === 3 ? 1 : 0;
        const pullLerp = dt > 0 ? 1 - Math.exp(-5 * dt) : 1;
        smoothLeftPull += (targetPull - smoothLeftPull) * pullLerp;
        smoothRightPull += (targetPull - smoothRightPull) * pullLerp;

        // Multiclass Prototype (GTP #01 or LMP2 #32) overtaking on inside left and pulling away ahead
        if (proto.active) {
          const protoY = h * 0.84 - proto.progress * h * 0.42;
          const protoLane = -0.58 + Math.sin(proto.progress * Math.PI) * 0.04;
          const protoScale = 1.06 - proto.progress * 0.48;
          const pSprite = proto.isGtp ? CAR_SPRITES.gtp01[brakeState] : CAR_SPRITES.lmp232[brakeState];
          drawCarSprite(ctx, pSprite, trackBoundX(protoY, protoLane), protoY, protoScale, 0, tel.brake * 0.5, rollRad * 1.15);
        }

        // #1 M. Berbis — Porsche 911 GT3 R (992) (enters frame smoothly alongside left in 3-Wide)
        if (smoothLeftPull > 0.04) {
          const porscheY = h * (0.94 - smoothLeftPull * 0.22);
          const porscheLane = -0.44 + curveFactor * 0.16;
          drawCarSprite(ctx, CAR_SPRITES.porsche[brakeState], trackBoundX(porscheY, porscheLane), porscheY, 1.08, tel.downshiftFlash, tel.brake, rollRad);
        }

        // #22 E. Chongkan — McLaren 720S GT3 Evo (enters frame smoothly alongside right in 3-Wide)
        if (smoothRightPull > 0.04) {
          const mclarenY = h * (0.94 - smoothRightPull * 0.21);
          const mclarenLane = 0.44 + curveFactor * 0.16;
          drawCarSprite(ctx, CAR_SPRITES.mclaren[brakeState], trackBoundX(mclarenY, mclarenLane), mclarenY, 1.08, tel.downshiftFlash, tel.brake, rollRad);
        }

        // #16 A. Trujillo — Ford Mustang GT3 (P1 leading GT3 pack, Chase Cam foreground y = 74%, scale 1.15x)
        const mustangY = h * 0.74;
        const mustangLane = curveFactor * 0.22;
        drawCarSprite(ctx, CAR_SPRITES.mustang[brakeState], trackBoundX(mustangY, mustangLane), mustangY, 1.15, tel.downshiftFlash, tel.brake, rollRad);
      }

      // Main animation loop (bounded dt <= 0.05s, exponential lerp, master lapProgress 0..1, 4 Hz DOM)
      let lastMs = performance.now();
      let lastDomMs = 0;
      let fuelLevel = 34.8;
      let simTimeSec = 0;
      let lapProgress = 0;
      let smoothCurve = 0;
      let smoothLeftPull = 0;
      let smoothRightPull = 0;
      let smoothBerbisGap = -0.6;
      let smoothChongkanGap = -1.3;
      let isViewportVisible = true;
      let isTabVisible = !document.hidden;
      let rafId = 0;

      function shouldAnimate() {
        return isViewportVisible && isTabVisible;
      }

      function scheduleNextFrame() {
        if (!rafId && shouldAnimate()) {
          lastMs = performance.now();
          rafId = requestAnimationFrame(tick);
        }
      }

      function tick(nowMs) {
        rafId = 0;
        if (!shouldAnimate()) return;

        const dt = Math.min(0.05, Math.max(0, (nowMs - lastMs) / 1000));
        lastMs = nowMs;

        if (!isPaused) {
          simTimeSec += dt;
          lapProgress = (simTimeSec % 10) / 10;
          if (nowMs - lastCircuitSwitchMs >= 32000) {
            lastCircuitSwitchMs = nowMs;
            applyCircuit(activeCircuitIdx + 1);
          }

          for (let i = 0; i < drivers.length; i++) {
            const d = drivers[i];
            d.pct += (dt / 32) * d.speed;
            if (d.pct >= 1) {
              d.pct -= 1;
              d.lap += 1;
            }
          }

          // Smooth exponential interpolation of Relative deltas (#1 Berbis & #22 Chongkan) + Prototype pass
          const meDrv = drivers.find((d) => d.isMe);
          const battleNow = computeBattleState(nowMs, simTimeSec);
          const protoPass = computePrototypePass(simTimeSec);
          if (meDrv) {
            const gt3Sec = CLASSES.GT3.lapSec;
            const gapLerp = 1 - Math.exp(-4.5 * dt);
            const targetBerbisGap = battleNow === 3 ? 0.1 : -0.6;
            const targetChongkanGap = battleNow === 3 ? -0.1 : -1.2;
            smoothBerbisGap += (targetBerbisGap - smoothBerbisGap) * gapLerp;
            smoothChongkanGap += (targetChongkanGap - smoothChongkanGap) * gapLerp;

            const berbis = drivers.find((d) => d.num === "1");
            const chongkan = drivers.find((d) => d.num === "22");
            if (berbis) {
              berbis.pct = (meDrv.pct + smoothBerbisGap / gt3Sec + 1) % 1;
              berbis.lap = meDrv.lap;
            }
            if (chongkan) {
              chongkan.pct = (meDrv.pct + smoothChongkanGap / gt3Sec + 1) % 1;
              chongkan.lap = meDrv.lap;
            }
            if (protoPass.active) {
              const protoDrv = drivers.find((d) => d.num === protoPass.protoNum);
              if (protoDrv) {
                protoDrv.pct = (meDrv.pct + protoPass.deltaSec / gt3Sec + 1) % 1;
                protoDrv.lap = meDrv.lap + 1;
              }
            }
          }

          const cMeta = CIRCUITS[activeCircuitIdx];
          fuelLevel -= dt * (cMeta.avgFuel / 32);
          if (fuelLevel < 12) fuelLevel = 38.4;

          renderTrackBackdrop(dt, nowMs, simTimeSec);
          renderInputs(simTimeSec);
          renderRadar(nowMs, simTimeSec);

          // DOM tables & Track Map SVG at 4 Hz (250 ms) using cached node updates only
          if (nowMs - lastDomMs >= 250) {
            lastDomMs = nowMs;
            renderStandings();
            renderRelative();
            renderTrackMap();

            if (enabledMods.fuel) {
              const avg = cMeta.avgFuel;
              const lapsLeft = fuelLevel / avg;
              const need = Math.max(0, (14 * avg + 1.5) - fuelLevel);
              if (fuelRemEl) fuelRemEl.textContent = `${fuelLevel.toFixed(1)} L`;
              if (fuelAvgEl) fuelAvgEl.textContent = `${avg.toFixed(2)} L`;
              if (fuelLapsEl) fuelLapsEl.textContent = lapsLeft.toFixed(1);
              if (fuelAddEl) fuelAddEl.textContent = need > 0.1 ? `+${need.toFixed(1)} L` : "OK";
              if (fuelBarEl) fuelBarEl.style.width = `${Math.min(100, (fuelLevel / 80) * 100).toFixed(0)}%`;
            }

            if (enabledMods.pit && !isReplay) {
              const me = drivers.find((d) => d.isMe);
              const curLap = me?.lap || 14;
              const avg = cMeta.avgFuel;
              const lapsLeft = fuelLevel / avg;
              const winStart = curLap + Math.max(1, Math.floor(lapsLeft - 2));
              const winEnd = curLap + Math.max(1, Math.floor(lapsLeft));
              const need = Math.max(0, (14 * avg + 1.5) - fuelLevel);
              const pitTime = 21.5 + need * 0.25;
              const pitWinEl = document.getElementById("simPitWindow");
              const pitTimeEl = document.getElementById("simPitTime");
              const pitRejoinEl = document.getElementById("simPitRejoin");
              const pitAlertEl = document.getElementById("simPitAlert");
              if (pitWinEl) pitWinEl.textContent = `L${winStart}–L${winEnd}`;
              if (pitTimeEl) pitTimeEl.textContent = `${pitTime.toFixed(1)}s`;
              if (pitRejoinEl) pitRejoinEl.textContent = `P${Math.min(18, (me?.pos || 4) + 2)}/18`;
              if (pitAlertEl) {
                if (lapsLeft <= 2) {
                  pitAlertEl.textContent = "BOX THIS LAP";
                  pitAlertEl.className = "px-1.5 py-0.5 rounded-[2px] text-[9px] font-black bg-rose-500/25 text-rose-300 animate-pulse";
                } else {
                  pitAlertEl.textContent = "FUEL SAVE +0.12 L/lap";
                  pitAlertEl.className = "px-1.5 py-0.5 rounded-[2px] text-[9px] font-black bg-amber-500/20 text-amber-300";
                }
              }
            }

            if (enabledMods.tires) {
              const osc = Math.sin(simTimeSec * 0.6) * 2.5;
              const tVals = [
                { id: "simTireFL", temp: 84 + osc, kpa: 174 },
                { id: "simTireFR", temp: 81 + osc * 0.8, kpa: 172 },
                { id: "simTireRL", temp: 78 - osc * 0.5, kpa: 170 },
                { id: "simTireRR", temp: 76 - osc * 0.4, kpa: 169 },
              ];
              tVals.forEach((tv) => {
                const el = document.getElementById(tv.id);
                if (!el) return;
                el.textContent = `${tv.temp.toFixed(0)}°C · ${tv.kpa}kPa`;
                el.className = tv.temp < 70 ? "text-sky-400" : tv.temp > 98 ? "text-rose-400" : tv.temp > 92 ? "text-amber-300" : "text-emerald-300";
              });
            }

            const me = drivers.find((d) => d.isMe);
            if (lapClockEl && me) {
              const remMin = Math.max(1, 18 - Math.floor(simTimeSec / 60));
              const remSec = 59 - (Math.floor(simTimeSec) % 60);
              lapClockEl.textContent = `LAP ${me.lap}/28 · ${String(remMin).padStart(2, "0")}:${String(remSec).padStart(2, "0")} REM`;
            }
          }
        }

        scheduleNextFrame();
      }

      if ("IntersectionObserver" in window && backdropCanvas) {
        const observer = new IntersectionObserver((entries) => {
          isViewportVisible = entries.some((e) => e.isIntersecting);
          if (isViewportVisible) scheduleNextFrame();
        }, { threshold: 0.05 });
        observer.observe(backdropCanvas);
      }

      document.addEventListener("visibilitychange", () => {
        isTabVisible = !document.hidden;
        if (isTabVisible) scheduleNextFrame();
      });

      syncVisibility();
      renderStandings();
      renderRelative();
      renderTrackMap();
      scheduleNextFrame();
    })();
  </script>
</Layout>

