    border-radius: 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    background: #090b0f;
    border: 1px solid rgba(255, 255, 255, 0.07);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sim-chip__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #334155;
  }

  .sim-chip.is-on {
    color: #e2e8f0;
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.08);
  }

  .sim-chip.is-on .sim-chip__dot {
    background: #10b981;
  }

  .sim-mode-switch {
    display: inline-flex;
    background: #090b0f;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 2px;
  }

  .sim-mode-btn {
    padding: 4px 10px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #94a3b8;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .sim-mode-btn kbd {
    font-size: 10px;
    padding: 0 4px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    color: inherit;
  }

  .sim-mode-btn.is-active {
    background: #10b981;
    color: #04130d;
  }

  .sim-mode-btn.is-active kbd {
    background: rgba(4, 19, 13, 0.22);
  }

  .sim-action-btn {
    padding: 6px 11px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #131923;
    color: #cbd5e1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sim-action-btn:hover {
    border-color: rgba(16, 185, 129, 0.45);
    color: #34d399;
  }

  /* SIMULATOR STAGE */
  .sim-stage {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0 0 14px 14px;
    overflow: hidden;
    background: #07090d;
    min-height: 540px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.85);
  }

  .sim-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .sim-statusbar {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 14px;
    background: rgba(9, 11, 15, 0.78);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-variant-numeric: tabular-nums;
    font-size: 10.5px;
  }

  .sim-statusbar__left,
  .sim-statusbar__right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .sim-status-tag {
    color: #f8fafc;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .sim-status-meta {
    color: #94a3b8;
  }

  .sim-status-hint {
    color: #34d399;
    font-size: 9.5px;
    font-weight: 600;
    opacity: 0.85;
  }

  .sim-fps-badge {
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.28);
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 700;
  }

  .sim-replay-badge {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.14);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 700;
  }

  /* 16:9 REAL COCKPIT ERGONOMIC STAGE */
  .sim-cockpit-layer {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 620px;
    padding: 12px;
  }

  @media (min-width: 1041px) {
    .sim-cockpit-layer {
      min-height: 640px;
      padding: 0;
    }
    .hud-pos-standings {
      position: absolute;
      top: 12px;
      left: 12px;
      width: 416px;
    }
    .hud-pos-relative {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 296px;
    }
    .hud-pos-trackmap {
      position: absolute;
      top: 184px;
      right: 12px;
      width: 216px;
    }
    .hud-pos-delta {
      position: absolute;
      top: 14px;
      left: 50%;
      transform: translateX(-50%);
      width: 240px;
    }
    .hud-pos-radar {
      position: absolute;
      bottom: 136px;
      left: 50%;
      transform: translateX(-50%);
      margin: 0 !important;
      min-height: 0 !important;
      z-index: 25;
      pointer-events: none;
    }
    .hud-pos-inputs {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      width: 356px;
    }
    .hud-pos-fuel {
      position: absolute;
      bottom: 14px;
      right: 12px;
      width: 244px;
    }
    .hud-pos-pit {
      position: absolute;
      bottom: 14px;
      left: 12px;
      width: 258px;
    }
    .hud-pos-tires {
      position: absolute;
      bottom: 124px;
      right: 12px;
      width: 244px;
    }
    .sim-stage.is-hud-locked .hud-box {
      pointer-events: none;
      user-select: none;
    }
  }

  @media (max-width: 1040px) {
    .sim-cockpit-layer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-content: start;
    }
    .hud-pos-radar,
    .hud-pos-inputs,
    .hud-pos-delta {
      grid-column: 1 / -1;
    }
  }

  .hud-box {
    background: rgba(9, 11, 15, 0.90);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 4px;
    overflow: hidden;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-variant-numeric: tabular-nums;
    transition: opacity 0.2s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    cursor: grab;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .hud-box.is-dragging {
    cursor: grabbing;
    border-color: rgba(16, 185, 129, 0.65);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(16, 185, 129, 0.35);
    z-index: 40;
  }

  .hud-box.is-hidden,
  .hud-radar-wrap.is-hidden,
  .hud-center-bottom.is-hidden {
    display: none !important;
  }

  .hud-box__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 9px;
    background: rgba(255, 255, 255, 0.035);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hud-box__title {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #e2e8f0;
  }

  .hud-box__meta {
    font-size: 9px;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.05em;
  }

  /* STANDINGS KAPPS */
  .hud-std-sessbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 19px;
    padding: 0 6px;
    background: #090b0f;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 9.5px;
    font-weight: 700;
  }

  .hud-std-colbar {
    display: grid;
    grid-template-columns: 16px 26px 114px 18px 72px 44px 40px 54px;
    align-items: center;
    height: 16px;
    padding: 0 5px;
    border-left: 3px solid transparent;
    background: rgba(255, 255, 255, 0.025);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #64748b;
  }

  .hud-standings__body {
    padding: 0;
  }

  .sim-stage :global(.st-cls-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 18px;
    padding: 0 6px;
    margin-top: 0;
    border-left: 3px solid #10b981;
    background: rgba(255, 255, 255, 0.05);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .sim-stage :global(.st-cls-sof) {
    color: #e2e8f0;
    font-weight: 700;
  }

  .sim-stage :global(.st-row) {
    display: grid;
    grid-template-columns: 16px 26px 114px 18px 72px 44px 40px 54px;
    align-items: center;
    gap: 0;
    height: 21px;
    padding: 0 5px;
    border-left: 3px solid transparent;
    font-size: 10.5px;
    color: #f8fafc;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: background-color 0.12s ease;
  }

  .sim-stage :global(.st-row:hover) {
    background: rgba(255, 255, 255, 0.06);
  }

  .sim-stage :global(.st-lic-ir) {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    height: 14px;
    padding: 0 4px;
    margin-left: 4px;
    border-radius: 2px;
    font-size: 9px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }

  .sim-stage :global(.st-lap) {
    text-align: right;
    color: #e2e8f0;
    font-size: 10px;
  }

  .sim-stage :global(.st-row.is-me) {
    background: rgba(16, 185, 129, 0.14);
    color: #ffffff;
    font-weight: 700;
  }

  .sim-stage :global(.st-row.is-pit) {
    opacity: 0.48;
  }

  .sim-stage :global(.st-pos) {
    color: #94a3b8;
    text-align: right;
    font-weight: 700;
  }

  .sim-stage :global(.hud-brand) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sim-stage :global(.st-num) {
    color: #94a3b8;
    font-size: 9.5px;
  }

  .sim-stage :global(.st-name) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sim-stage :global(.st-lic) {
    display: inline-block;
    text-align: center;
    padding: 1px 3px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
  }

  .sim-stage :global(.st-ir) {
    text-align: right;
    color: #cbd5e1;
    font-size: 9.5px;
  }

  .sim-stage :global(.st-ird) {
    text-align: right;
    font-size: 9.5px;
    font-weight: 800;
  }

  .sim-stage :global(.ir-pos) { color: #22c55e; }
  .sim-stage :global(.ir-neg) { color: #f87171; }

  .sim-stage :global(.st-int) {
    text-align: right;
    color: #64748b;
    font-size: 9.5px;
  }

  .sim-stage :global(.st-gap) {
    text-align: right;
    color: #f8fafc;
    font-weight: 700;
    font-size: 10px;
  }

  /* RELATIVE KAPPS */
  .hud-relative__body {
    padding: 0;
  }

  .sim-stage :global(.rel-row) {
    display: grid;
    grid-template-columns: 16px 24px minmax(74px, 1fr) 16px 32px 30px 36px;
    align-items: center;
    gap: 4px;
    height: 20px;
    padding: 0 5px;
    border-left: 3px solid transparent;
    font-size: 10.5px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: background-color 0.12s ease;
  }

  .sim-stage :global(.rel-row:hover) {
    background: rgba(255, 255, 255, 0.06);
  }

  .sim-stage :global(.rel-brand) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .sim-stage :global(.rel-pos) {
    color: #94a3b8;
    text-align: right;
    font-weight: 700;
    font-size: 10px;
  }

  .sim-stage :global(.rel-row--same) { color: #f1f5f9; }
  .sim-stage :global(.rel-row--me) { background: rgba(16, 185, 129, 0.16); color: #ffffff; font-weight: 800; }
  .sim-stage :global(.rel-row--lapping) { color: #fb7185; }
  .sim-stage :global(.rel-row--lapped) { color: #38bdf8; }
  .sim-stage :global(.rel-row--pit) { color: #64748b; opacity: 0.65; }

  .sim-stage :global(.rel-num) { font-size: 9.5px; opacity: 0.85; }
  .sim-stage :global(.rel-name) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sim-stage :global(.rel-lic) {
    text-align: center;
    border-radius: 3px;
    font-size: 9px;
    font-weight: 800;
    color: #ffffff;
    padding: 1px 0;
  }
  .sim-stage :global(.rel-ir) { text-align: right; font-size: 9.5px; opacity: 0.85; }
  .sim-stage :global(.rel-pit) {
    grid-column: span 2;
    text-align: center;
    font-size: 9px;
    font-weight: 800;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.14);
    border-radius: 3px;
    padding: 1px 4px;
  }
  .sim-stage :global(.rel-gap) { text-align: right; font-weight: 700; }

  /* RADAR */
  .hud-radar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hud-radar {
    position: relative;
    width: 158px;
    height: 158px;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .hud-radar[data-state="clear"] {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
  }

  .hud-radar[data-state="side"],
  .hud-radar[data-state="threewide"] {
    opacity: 1;
    transform: scale(1);
  }

  .hud-radar__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hud-radar__label {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .hud-radar__hint {
    margin-top: 4px;
    font-size: 10.5px;
    color: #64748b;
    text-align: center;
    transition: opacity 0.2s ease;
  }

  /* INPUTS & DELTA */
  .hud-center-bottom {
    width: 100%;
    max-width: 390px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hud-delta {
    padding: 7px 10px;
  }

  .hud-delta__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 5px;
  }

  .hud-delta__tag {
    font-size: 9.5px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.08em;
  }

  .hud-delta__val {
    font-size: 13px;
    font-weight: 800;
  }

  .hud-delta__track {
    position: relative;
    height: 7px;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    overflow: hidden;
  }

  .hud-delta__center {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255, 255, 255, 0.35);
    z-index: 2;
  }

  .hud-delta__fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 3px;
    transition: width 0.08s linear, left 0.08s linear;
  }

  .hud-inputs {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
  }

  .hud-inputs__trace canvas {
    width: 100%;
    height: 62px;
    display: block;
    background: rgba(4, 6, 9, 0.65);
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .hud-inputs__bars {
    display: flex;
    gap: 5px;
    height: 62px;
  }

  .pedal-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .pedal-bar {
    width: 10px;
    flex: 1;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 3px;
    position: relative;
    overflow: hidden;
  }

  .pedal-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 2px;
  }

  .pedal-fill--clutch { background: #38bdf8; }
  .pedal-fill--brake { background: #ef4444; }
  .pedal-fill--throttle { background: #10b981; }

  .pedal-lbl {
    font-size: 9px;
    font-weight: 800;
    color: #94a3b8;
  }

  .hud-inputs__gear {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 54px;
    padding-left: 6px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gear-val {
    font-size: 26px;
    font-weight: 900;
    line-height: 1;
    color: #10b981;
  }

  .speed-val {
    font-size: 13px;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2px;
  }

  .speed-unit {
    font-size: 8.5px;
    color: #64748b;
    letter-spacing: 0.06em;
  }

  /* TRACK MAP */
  .hud-trackmap__canvas {
    padding: 8px;
  }

  .hud-trackmap__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* FUEL */
  .hud-fuel__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.05);
  }

  .fuel-cell {
    background: rgba(9, 11, 15, 0.92);
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fuel-cell--highlight {
    background: rgba(245, 158, 11, 0.06);
  }

  .fuel-lbl {
    font-size: 9px;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.07em;
  }

  .fuel-val {
    font-size: 14px;
    font-weight: 800;
    color: #f8fafc;
  }

  .fuel-val--emerald { color: #34d399; }
  .fuel-val--amber { color: #fbbf24; }

  .hud-fuel__bar-wrap {
    height: 4px;
    background: rgba(255, 255, 255, 0.07);
  }

  .hud-fuel__bar {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #34d399);
    transition: width 0.25s ease;
  }

  /* MODULE SUMMARY CARDS */
  .ov-mod-grid {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .ov-card {
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 18px 20px;
  }

  .ov-card__num {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 11px;
    font-weight: 800;
    color: #10b981;
    margin-bottom: 8px;
  }

  .ov-card h3 {
    font-size: 15px;
    font-weight: 750;
    color: #f8fafc;
    margin: 0 0 8px;
  }

  .ov-card p {
    font-size: 13px;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }

  /* ARCHITECTURE */
  .ov-arch-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .ov-arch-card {
    background: #090b0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 22px 24px;
  }

  .ov-arch-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 10.5px;
  }

  .ov-arch-tag {
    color: #34d399;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .ov-arch-metric {
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .ov-arch-card h3 {
    font-size: 17px;
    font-weight: 750;
    color: #f8fafc;
    margin: 0 0 10px;
  }

  .ov-arch-card p {
    font-size: 13.5px;
    line-height: 1.65;
    color: #94a3b8;
    margin: 0;
  }

  /* 3-STEP GUIDE */
  .ov-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .ov-step {
    background: #0d1117;
