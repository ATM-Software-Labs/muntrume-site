          <div id="paddockPassSuccess" class="hidden relative p-5 rounded-xl bg-[var(--r-accent)]/10 border border-[var(--r-accent)]/30 text-xs font-mono text-[var(--r-accent)] text-center overflow-hidden">
            <div id="paddockConfettiHost" class="pointer-events-none absolute inset-0 overflow-hidden"></div>
