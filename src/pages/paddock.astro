---
import Layout from '../layouts/Layout.astro';
import StatsGrid from '../components/StatsGrid.astro';
import PrivateAreaHeader from '../components/PrivateAreaHeader.astro';
import SalaIngenieros from '../components/paddock/SalaIngenieros.astro';
import { PILOTOS } from '../lib/pilotos';

const pageTitle = "Paddock | Muntrume Motorsport";
const pageDescription = "Official Muntrume Motorsport Paddock. Canal de radio en carrera, telemetría Garage 61, galería fotográfica en iRacing, redes sociales oficiales y acceso Paddock Pass.";

const channels = [
  {
    title: "Discord Paddock Radio",
    desc: "Canal oficial de voz en carrera y enlace directo con pilotos e ingenieros.",
    link: "https://discord.gg/ehX6B8JUtE",
    cta: "Conectar a Radio",
    isExternal: true,
    icon: "discord",
    badge: "Voice & Radio"
  },
  {
    title: "Telemetría Garage 61",
    desc: "Datos a 60 Hz, comparación de sectores, trazadas y deltas con el equipo.",
    link: "https://garage61.net/app/teams/muntrume-motorsport",
    cta: "Abrir Telemetría",
    isExternal: true,
    icon: "garage61",
    badge: "60 Hz Live"
  },
  {
    title: "Setup Vault (.STO)",
    desc: "Más de 41.000 reglajes listos para sincronizar en tu simulador iRacing.",
    link: "/garage",
    cta: "Acceder al Vault",
    isExternal: false,
    icon: "vault",
    badge: "+41.000 STO"
  },
  {
    title: "Roster de Pilotos",
    desc: "Fichas oficiales, índice MTI y estadísticas en series Sports Car.",
    link: "/drivers",
    cta: "Ver Pilotos",
    isExternal: false,
    icon: "roster",
    badge: "3 Oficiales"
  }
];

const socialLinks = [
  {
    name: "Discord Paddock",
    handle: "Muntrume Radio",
    desc: "Canal oficial de voz en carrera, salas técnicas de telemetría y sala de espera para pilotos aspirantes.",
    link: "https://discord.gg/ehX6B8JUtE",
    cta: "Entrar a Discord",
    badge: "Voz & Telemetría",
    icon: "discord",
    brandColor: "#5865F2"
  },
  {
    name: "Garage 61",
    handle: "Muntrume Motorsport",
    desc: "Perfil oficial de escudería en Garage 61 con análisis de vueltas a 60 Hz y comparación de deltas por sector.",
    link: "https://garage61.net/app/teams/muntrume-motorsport",
    cta: "Abrir Telemetría",
    badge: "60 Hz Live",
    icon: "garage61",
    brandColor: "#00E699"
  },
  {
    name: "YouTube",
    handle: "@MuntrumeMotorsport",
    desc: "Retransmisiones oficiales de carreras de resistencia de 24h, vueltas rápidas on-board y análisis de setups.",
    link: "https://www.youtube.com",
    cta: "Ver Canal",
    badge: "Onboards HD",
    icon: "youtube",
    brandColor: "#FF0000"
  },
  {
    name: "Twitch",
    handle: "MuntrumeLive",
    desc: "Directos multiclase desde el habitáculo, stint radio con ingenieros de pista y sesiones de práctica.",
    link: "https://www.twitch.tv",
    cta: "Seguir Directos",
    badge: "Cockpit Live",
    icon: "twitch",
    brandColor: "#9146FF"
  },
  {
    name: "X / Twitter",
    handle: "@MuntrumeRT",
    desc: "Despachos oficiales del equipo, resultados en directo, sanciones de carrera y partes meteorológicos.",
    link: "https://x.com",
    cta: "Seguir en X",
    badge: "Actualidad",
    icon: "x",
    brandColor: "#1DA1F2"
  },
  {
    name: "Instagram",
    handle: "@muntrumems",
    desc: "Fotografía del paddock, libreas corporativas de la temporada 2026, cascos y momentos del equipo.",
    link: "https://www.instagram.com",
    cta: "Ver Galería",
    badge: "Lifestyle",
    icon: "instagram",
    brandColor: "#E1306C"
  }
];

const teamCars = [
  {
    name: "Ferrari 296 GT3",
    category: "GT3",
    driverDorsals: ["#16", "#1", "#22"],
    desc: "Coche oficial de resistencia GT3 con motor V6 Twin-Turbo y reparto de frenada optimizado.",
    setupCar: "Ferrari 296 GT3",
    img: "/assets/img/coche1-640.webp"
  },
  {
    name: "Ford Mustang GT3",
    category: "GT3",
    driverDorsals: ["#16"],
    desc: "Chasis V8 de competición homologado para la serie IMSA GTD y resistencia multiclase.",
    setupCar: "Ford Mustang GT3",
    img: "/assets/img/coche3-640.webp"
  },
  {
    name: "McLaren 720S GT3 EVO",
    category: "GT3",
    driverDorsals: ["#16"],
    desc: "Aerodinámica de alto downforce y estabilidad en virajes rápidos de circuito largo.",
    setupCar: "McLaren 720S GT3 EVO",
    img: "/assets/img/coche4-640.webp"
  },
  {
    name: "Porsche 911 GT3 R (992)",
    category: "GT3",
    driverDorsals: ["#1"],
    desc: "Motor bóxer trasero con tracción excelente en tracción lenta y curvas enlazadas.",
    setupCar: "Porsche 911 GT3 R (992)",
    img: "/assets/img/coche2-640.webp"
  }
];

const galleryItems = [
  {
    id: "g1",
    title: "Ferrari 296 GT3 #27",
    subtitle: "Muntrume Motorsport Livery · iRacing",
    category: "cars",
    tag: "GT3 Oficial",
    img: "/assets/img/coche1.webp",
    thumb: "/assets/img/coche1-640.webp",
    desc: "Captura en pista del Ferrari 296 GT3 con librea corporativa verde esmeralda y patrocinadores oficiales en iRacing."
  },
  {
    id: "g2",
    title: "Pelotón GT3 en Carrera",
    subtitle: "Series de Resistencia Multiclase",
    category: "track",
    tag: "Carrera",
    img: "/assets/img/coche2.webp",
    thumb: "/assets/img/coche2-640.webp",
    desc: "Lucha en pelotón cerrado negociando la entrada a curva peraltada durante una prueba oficial de resistencia."
  },
  {
    id: "g3",
    title: "Tráfico y Frenada en Grupo",
    subtitle: "Gestión de Carrera y Doblados",
    category: "track",
    tag: "Pista",
    img: "/assets/img/race1.webp",
    thumb: "/assets/img/race1-640.webp",
    desc: "Frenada sincronizada con luces de cruce encendidas y gestión de adelantamientos entre diferentes clases de vehículos."
  },
  {
    id: "g4",
    title: "Stint Nocturno con Ópticas LED",
    subtitle: "Transición al Anochecer",
    category: "track",
    tag: "Nocturna",
    img: "/assets/img/coche3.webp",
    thumb: "/assets/img/coche3-640.webp",
    desc: "Competición con iluminación artificial en pista y gestión de temperatura de neumáticos con caída térmica."
  },
  {
    id: "g5",
    title: "Apoyo Aerodinámico en Vértice",
    subtitle: "Paso por Curva Rápida",
    category: "cars",
    tag: "GT3",
    img: "/assets/img/coche4.webp",
    thumb: "/assets/img/coche4-640.webp",
    desc: "Alineación de caída y convergencia trabajando en máxima carga lateral sobre el piano de salida."
  },
  {
    id: "g6",
    title: "Parrilla de Salida al Ocaso",
    subtitle: "Alineación Oficial de Escuderías",
    category: "track",
    tag: "Parrilla",
    img: "/assets/img/hero-bg.webp",
    thumb: "/assets/img/hero-bg-640.webp",
    desc: "Momento previo a la bandera verde con los vehículos en formación de parrilla para la prueba de resistencia."
  },
  {
    id: "g7",
    title: "Puesto de Control de Telemetría",
    subtitle: "Monitorización Garage 61 en Directo",
    category: "tech",
    tag: "Telemetría",
    img: "/assets/img/og-team.jpg",
    thumb: "/assets/img/og-team.jpg",
    desc: "Estación de análisis de datos a 60 Hz con curvas de aceleración, presión de freno y deltas de tiempo por sector."
  },
  {
    id: "g8",
    title: "Identidad Corporativa 2026",
    subtitle: "Muntrume Motorsport Visual Identity",
    category: "tech",
    tag: "Escudería",
    img: "/assets/img/og-cover.jpg",
    thumb: "/assets/img/og-cover.jpg",
    desc: "Diseño institucional del equipo combinando el verde neón (#00E699), gris carbón y tipografía deportiva."
  },
  {
    id: "g9",
    title: "Setup Vault (.STO)",
    subtitle: "Banco de Reglajes Oficiales",
    category: "tech",
    tag: "Setup Lab",
    img: "/assets/img/og-setups.jpg",
    thumb: "/assets/img/og-setups.jpg",
    desc: "Catálogo técnico con más de 41.000 configuraciones .STO verificadas y listas para sincronización local."
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/paddock/" forceDark>
  <div class="pt-24 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
    <PrivateAreaHeader activeTab="paddock" />
    <SalaIngenieros />

    <!-- 1. Header Hero -->
    <section class="text-center max-w-3xl mx-auto space-y-4 pt-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[var(--r-surface)] border border-[var(--r-accent)]/40 text-[var(--r-accent)] text-xs font-mono uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-[var(--r-accent)] animate-pulse"></span>
        <span>PADDOCK &amp; TEAM HQ · SANT ANDREU, BARCELONA</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold text-[var(--r-text)] tracking-tight font-display uppercase">
        MUNTRUME <span class="text-[var(--r-accent)]">PADDOCK</span>
      </h1>

      <p class="text-base sm:text-lg text-[var(--r-muted)] leading-relaxed max-w-2xl mx-auto font-normal">
        Punto de encuentro del equipo. Acceso directo a comunicaciones de radio en carrera, directos técnicos, galería oficial de competición y solicitud de ingreso.
      </p>
    </section>

    <!-- 2. Grid de 4 Canales Oficiales con Iconos Destacados -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {channels.map(c => (
        <div class="relative p-6 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-[var(--r-accent)] transition-all duration-300 flex flex-col justify-between space-y-4 group overflow-hidden shadow-sm">
          <div class="flex items-center justify-between">
            <div class="w-12 h-12 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] flex items-center justify-center text-[var(--r-accent)] group-hover:scale-105 transition-transform shadow-xs">
              {c.icon === 'discord' && (
                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.13-.255-.01-.556-.28-.646a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
              )}
              {c.icon === 'garage61' && (
                <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              )}
              {c.icon === 'vault' && (
                <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
              )}
              {c.icon === 'roster' && (
                <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              )}
            </div>
            <span class="px-2.5 py-0.5 rounded-full bg-[var(--r-bg-2)] border border-[var(--r-line)] text-[10px] font-mono text-[var(--r-accent)] font-semibold">
              {c.badge}
            </span>
          </div>

          <div>
            <h3 class="text-lg font-bold text-[var(--r-text)] font-display tracking-tight group-hover:text-[var(--r-accent)] transition-colors">
              {c.title}
            </h3>
            <p class="text-xs text-[var(--r-muted)] mt-1.5 leading-relaxed">
              {c.desc}
            </p>
          </div>

          <a 
            href={c.link} 
            target={c.isExternal ? "_blank" : "_self"} 
            rel={c.isExternal ? "noopener noreferrer" : ""} 
            class="pt-4 border-t border-[var(--r-line)] text-xs font-mono font-bold text-[var(--r-accent)] hover:underline flex items-center justify-between group-hover:translate-x-0.5 transition-transform"
          >
            <span>{c.cta}</span>
            <span>&rarr;</span>
          </a>
        </div>
      ))}
    </section>

    <!-- 3. REDES SOCIALES & CANALES OFICIALES DE LA ESCUDERÍA -->
    <section id="social-hub" class="space-y-8 pt-4">
      <div class="pb-4 border-b border-[var(--r-line)] flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[var(--r-accent)] mb-1">
            <span class="w-2 h-2 rounded-full bg-[var(--r-accent)]"></span>
            <span>COMMUNITY &amp; SOCIAL HUBS</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-[var(--r-text)] font-display tracking-tight">
            OFFICIAL TEAM CHANNELS
          </h2>
          <p class="text-xs sm:text-sm text-[var(--r-muted)] mt-1 max-w-xl">
            Sigue a Muntrume Motorsport en las plataformas de emisión en directo, análisis de telemetría y redes sociales.
          </p>
        </div>
        <span class="text-xs font-mono text-[var(--r-muted)]">6 Canales Activos</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {socialLinks.map(s => (
          <a 
            href={s.link} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="group p-5 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-[var(--r-accent)] transition-all duration-300 flex flex-col justify-between space-y-4 shadow-sm hover:shadow-md"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] flex items-center justify-center text-[var(--r-text)] group-hover:text-[var(--r-accent)] transition-colors shadow-xs">
                  {s.icon === 'discord' && (
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.13-.255-.01-.556-.28-.646a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
                  )}
                  {s.icon === 'garage61' && (
                    <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                  )}
                  {s.icon === 'youtube' && (
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  )}
                  {s.icon === 'twitch' && (
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/></svg>
                  )}
                  {s.icon === 'x' && (
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  )}
                  {s.icon === 'instagram' && (
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  )}
                </div>
                <div>
                  <h3 class="text-sm font-bold text-[var(--r-text)] group-hover:text-[var(--r-accent)] transition-colors">
                    {s.name}
                  </h3>
                  <span class="text-xs font-mono text-[var(--r-muted)]">{s.handle}</span>
                </div>
              </div>
