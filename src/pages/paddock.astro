      <div class="p-6 sm:p-8 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] shadow-sm">
        <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-[var(--r-accent)] mb-2">
          <span class="w-2 h-2 rounded-full bg-[var(--r-accent)]"></span>
            <span data-i18n="paddock.rules.kicker">Estándares de competición</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-[var(--r-text)] font-display tracking-tight mb-4" data-i18n="paddock.rules.title">
