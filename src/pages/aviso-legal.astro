<Layout title="Aviso legal · Muntrume Motorsport" description="Identificación del titular de muntru.me y condiciones de uso del sitio de Muntrume Motorsport." canonical="https://muntru.me/aviso-legal">
  <section class="r-section lg" style="border-top:0;padding-top:clamp(104px,13vw,150px)" aria-labelledby="lgTitle">
