---
import Layout from "../../../layouts/Layout.astro";
import eventsData from "../../../data/iracing-special-events.json";

interface SpecialEvent {
  id: string;
  slug: string;
  year: number;
  title: string;
  dateLabel: string;
  startUtc: string;
  endUtc: string;
  type: string;
  discipline: string;
  duration: string;
  license: string;
  teamSize: string;
  timeSlots: string;
  cars: string;
  track: string;
  description: string;
  logo: string;
  poster: string;
}

export function getStaticPaths() {
  const all = eventsData as SpecialEvent[];
  return all.map((ev) => ({
    params: { slug: ev.slug },
    props: { event: ev },
  }));
}

interface Props {
  event: SpecialEvent;
}

const { event } = Astro.props;
const others = (eventsData as SpecialEvent[])
  .filter((e) => e.slug !== event.slug)
  .sort((a, b) => Date.parse(a.startUtc) - Date.parse(b.startUtc))
  .slice(0, 6);

const pageTitle = `${event.title} ${event.year} · Special Event iRacing`;
const pageDescription = `${event.title} (${event.dateLabel}) en ${event.track}: ${event.duration}, coches ${event.cars}, licencia ${event.license}, horarios UTC y setups .STO. MMT.`;
const canonical = `https://muntru.me/calendar/special-events/${event.slug}/`;
const ogImage = event.poster || event.logo || "https://muntru.me/assets/img/og-setups.jpg";
const ogImageAlt = `${event.title} ${event.year} · ${event.dateLabel} en ${event.track} · Muntrume Motorsport`;

const eventSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SportsEvent",
      "@id": `${canonical}#event`,
      "name": `${event.title} ${event.year} (iRacing Special Event)`,
      "description": event.description,
      "startDate": event.startUtc,
      "endDate": event.endUtc,
      "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "image": [event.poster, event.logo].filter(Boolean),
      "url": canonical,
      "inLanguage": "es",
      "location": {
        "@type": "VirtualLocation",
        "name": event.track,
        "url": canonical,
      },
      "organizer": {
        "@type": "Organization",
        "name": "iRacing",
        "url": "https://www.iracing.com/special-events/",
      },
      "competitor": {
        "@type": "SportsTeam",
        "name": "Muntrume Motorsport",
        "url": "https://muntru.me/",
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://muntru.me/" },
        { "@type": "ListItem", "position": 2, "name": "Calendario iRacing", "item": "https://muntru.me/calendar/" },
        { "@type": "ListItem", "position": 3, "name": `Special Events ${event.year}`, "item": "https://muntru.me/calendar/special-events/" },
        { "@type": "ListItem", "position": 4, "name": event.title, "item": canonical },
      ],
    },
  ],
};

function resolveTrackQuery(trackName: string): string {
  const t = trackName.toLowerCase();
  if (t.includes("spa")) return "Spa";
  if (t.includes("daytona")) return "Daytona";
  if (t.includes("panorama") || t.includes("bathurst")) return "Bathurst";
  if (t.includes("sebring")) return "Sebring";
  if (t.includes("watkins")) return "Watkins Glen";
  if (t.includes("indianapolis") || t.includes("indy")) return "Indianapolis";
  if (t.includes("charlotte")) return "Charlotte";
  if (t.includes("road america")) return "Road America";
  if (t.includes("road atlanta")) return "Road Atlanta";
  if (t.includes("suzuka")) return "Suzuka";
  if (t.includes("silverstone")) return "Silverstone";
  if (t.includes("algarve") || t.includes("portimao")) return "Algarve";
  if (t.includes("brands hatch")) return "Brands Hatch";
  if (t.includes("virginia")) return "Virginia";
  if (t.includes("homestead")) return "Homestead";
  if (t.includes("darlington")) return "Darlington";
  if (t.includes("five flags")) return "Five Flags";
  if (t.includes("knoxville")) return "Knoxville";
  if (t.includes("thruxton")) return "Thruxton";
  if (t.includes("tulsa")) return "Tulsa";
  if (t.includes("crandon")) return "Crandon";
  if (t.includes("rburgring") || t.includes("nurburgring")) return "Nurburgring";
  return trackName.split("(")[0].trim();
}

function resolveSingleCar(carsText: string): string | null {
  const c = carsText.toLowerCase();
  if (c.includes(",")) return null;
  if (c.includes("992.2") || c.includes("porsche 911 cup")) return "porsche9922cup";
  if (c.includes("super formula lights")) return "superformulalights324";
  if (c.includes("ir18")) return "dallarair18";
  if (c.includes("ff1600")) return "ff1600";
  if (c.includes("super late model")) return "superlatemodel";
  if (c.includes("410 sprint")) return "dirtsprint winged 410";
  return null;
}

const trackQuery = resolveTrackQuery(event.track);
const singleCar = resolveSingleCar(event.cars);
const setupParams = new URLSearchParams({ track: trackQuery });
if (singleCar) setupParams.set("car", singleCar);
const setupUrl = `/garage/?${setupParams.toString()}`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  ogType="article"
  ogLocale="es_ES"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageWidth={1200}
  ogImageHeight={630}
  schemaJson={eventSchema}
>
  <section class="r-section sed-page" aria-labelledby="sedTitle">
    <div class="r-wrap">
      <nav class="sed-crumb" aria-label="Ruta">
        <a href="/calendar/special-events/">← Special Events {event.year}</a>
        <span>/</span>
        <span>{event.title}</span>
      </nav>

      <header class="sed-hero" data-start={event.startUtc} data-end={event.endUtc}>
        <div class="sed-hero__logo">
          <img src={event.logo} alt={event.title} loading="eager" decoding="async" />
        </div>
        <div class="sed-hero__body">
          <div class="sed-badges">
            <span id="sedState" class="sed-badge sed-badge--live">CARGANDO…</span>
            <span class="sed-badge">{event.type}</span>
            <span class="sed-badge">{event.discipline}</span>
            <span class="sed-badge">{event.year}</span>
          </div>
          <h1 id="sedTitle" class="r-h1">{event.title}</h1>
          <p class="sed-date">{event.dateLabel} · {event.track}</p>
          <p class="sed-desc">{event.description}</p>

          <div class="sed-cd" role="timer" aria-label="Cuenta atrás">
            <div class="sed-cd-box"><span id="cdD">--</span><small>Días</small></div>
            <div class="sed-cd-sep">:</div>
            <div class="sed-cd-box"><span id="cdH">--</span><small>Horas</small></div>
            <div class="sed-cd-sep">:</div>
            <div class="sed-cd-box"><span id="cdM">--</span><small>Min</small></div>
            <div class="sed-cd-sep">:</div>
            <div class="sed-cd-box"><span id="cdS">--</span><small>Seg</small></div>
          </div>

          <div class="sed-actions">
            <a href={setupUrl} class="sed-btn sed-btn--primary">Setups .STO para este evento →</a>
            <button type="button" id="sedShareBtn" class="sed-btn" data-share-title={`${event.title} ${event.year} · iRacing`} data-share-text={`${event.title} (${event.dateLabel}) en ${event.track} · ${event.duration}`}>Compartir</button>
            <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noreferrer noopener" class="sed-btn">Apuntarme en Discord</a>
            <a href="https://www.iracing.com/special-events/" target="_blank" rel="noreferrer noopener" class="sed-btn">Web oficial iRacing ↗</a>
          </div>
        </div>
      </header>

      <div class="sed-layout">
        <section class="sed-panel">
          <h2 class="sed-h2">Información del Evento</h2>
          <dl class="sed-specs">
            <div><dt>Fechas oficiales</dt><dd>{event.dateLabel}</dd></div>
            <div><dt>Circuito</dt><dd>{event.track}</dd></div>
            <div><dt>Duración / Formato</dt><dd>{event.duration}</dd></div>
            <div><dt>Coches elegibles</dt><dd>{event.cars}</dd></div>
            <div><dt>Licencia mínima</dt><dd>{event.license}</dd></div>
            <div><dt>Tamaño de equipo</dt><dd>{event.teamSize}</dd></div>
            <div><dt>Franjas horarias (UTC)</dt><dd>{event.timeSlots}</dd></div>
          </dl>
        </section>

        {event.poster && (
          <aside class="sed-panel">
            <h2 class="sed-h2">Póster Oficial {event.year}</h2>
            <a href={event.poster} target="_blank" rel="noreferrer noopener" class="sed-poster">
              <img src={event.poster} alt={`Póster oficial ${event.title} ${event.year}`} loading="lazy" decoding="async" />
            </a>
          </aside>
        )}
      </div>

      <section class="sed-more">
        <div class="sed-more__head">
          <h2 class="sed-h2">Otros Special Events {event.year}</h2>
          <a href="/calendar/special-events/" class="sed-link">Ver todos →</a>
        </div>
        <div class="sed-more__grid">
          {others.map((o) => (
            <a href={`/calendar/special-events/${o.slug}/`} class="sed-mini">
              <img src={o.logo} alt={o.title} loading="lazy" decoding="async" />
              <div>
                <strong>{o.title}</strong>
                <span>{o.dateLabel} · {o.duration}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>

  <style>
    .sed-crumb {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-family: var(--r-mono, monospace);
      font-size: 0.78rem;
      color: var(--r-muted);
      margin-bottom: 1.1rem;
    }
    .sed-crumb a { color: var(--r-accent); text-decoration: none; font-weight: 700; }
    .sed-crumb a:hover { text-decoration: underline; }
    .sed-hero {
      display: grid;
      grid-template-columns: minmax(220px, 340px) 1fr;
      gap: 1.5rem;
      padding: clamp(1rem, 3vw, 1.5rem);
      border-radius: 1rem;
      border: 1px solid color-mix(in srgb, var(--r-accent) 38%, var(--r-line));
      background: radial-gradient(circle at top right, color-mix(in srgb, var(--r-accent) 14%, transparent), var(--r-surface) 60%);
      align-items: center;
      margin-bottom: 1.75rem;
      box-shadow: 0 12px 32px -20px rgba(0, 0, 0, 0.25);
    }
    @media (max-width: 780px) { .sed-hero { grid-template-columns: 1fr; } }
    .sed-hero__logo {
      background: #0b1016;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 0.75rem;
      padding: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 180px;
    }
    .sed-hero__logo img { max-height: 170px; width: auto; object-fit: contain; }
    .sed-badges { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 0.6rem; }
    .sed-badge {
      font-family: var(--r-mono, monospace);
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.22rem 0.58rem;
      border-radius: 999px;
      background: var(--r-bg);
      border: 1px solid var(--r-line);
      color: var(--r-text);
      text-transform: uppercase;
    }
    .sed-badge--live {
      background: color-mix(in srgb, var(--r-accent) 16%, var(--r-bg));
      color: var(--r-accent);
      border-color: color-mix(in srgb, var(--r-accent) 45%, transparent);
    }
    .sed-date {
      margin: 0.35rem 0 0.6rem;
      font-family: var(--r-mono, monospace);
      font-size: 0.85rem;
      color: var(--r-accent);
      font-weight: 700;
    }
    .sed-desc {
      margin: 0 0 1rem;
      color: var(--r-muted);
      font-size: 0.92rem;
      line-height: 1.58;
      max-width: 65ch;
    }
    .sed-cd {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.65rem 0.9rem;
      border-radius: 0.75rem;
      background: var(--r-bg);
      border: 1px solid var(--r-line);
      margin-bottom: 1rem;
      max-width: 100%;
    }
    .sed-cd-box { min-width: 2.85rem; text-align: center; }
    .sed-cd-box span {
      display: block;
      font-family: var(--r-mono, monospace);
      font-size: 1.5rem;
      font-weight: 800;
      line-height: 1.1;
      color: var(--r-accent);
      font-variant-numeric: tabular-nums;
    }
    .sed-cd-box small {
      display: block;
      font-size: 0.62rem;
      text-transform: uppercase;
      color: var(--r-muted);
      margin-top: 0.15rem;
    }
    .sed-cd-sep {
      font-family: var(--r-mono, monospace);
      font-size: 1.2rem;
      color: var(--r-muted);
      opacity: 0.5;
      padding-bottom: 0.75rem;
    }
    .sed-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .sed-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.55rem 0.95rem;
      border-radius: 0.6rem;
      border: 1px solid var(--r-line);
      background: var(--r-bg);
      color: var(--r-text);
      font-size: 0.8rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: opacity 140ms, border-color 140ms, color 140ms;
    }
    .sed-btn:hover { border-color: var(--r-accent); color: var(--r-accent); }
    .sed-btn--primary { background: var(--r-accent); border-color: var(--r-accent); color: #04150e; }
    :global(html.light) .sed-btn--primary,
    :global(html[data-theme="light"]) .sed-btn--primary { color: #ffffff; }
    .sed-btn--primary:hover { opacity: 0.92; color: #04150e; }
    :global(html.light) .sed-btn--primary:hover,
    :global(html[data-theme="light"]) .sed-btn--primary:hover { color: #ffffff; }

    .sed-layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.25rem; margin-bottom: 2rem; }
    @media (max-width: 820px) { .sed-layout { grid-template-columns: 1fr; } }
    .sed-panel {
      padding: 1.25rem;
      border-radius: 0.95rem;
      border: 1px solid var(--r-line);
      background: var(--r-surface);
    }
    .sed-h2 { margin: 0 0 0.95rem; font-size: 1.05rem; font-weight: 800; color: var(--r-text); }
    .sed-specs { margin: 0; display: grid; gap: 0.65rem; }
    .sed-specs div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.55rem;
      border-bottom: 1px solid var(--r-line);
      font-size: 0.86rem;
    }
    .sed-specs div:last-child { border-bottom: 0; padding-bottom: 0; }
    @media (max-width: 520px) {
      .sed-specs div { flex-direction: column; gap: 0.2rem; }
      .sed-specs dd { text-align: left !important; }
    }
    .sed-specs dt { color: var(--r-muted); flex-shrink: 0; }
    .sed-specs dd { margin: 0; text-align: right; color: var(--r-text); font-weight: 600; }
    .sed-poster { display: block; border-radius: 0.65rem; overflow: hidden; border: 1px solid var(--r-line); }
    .sed-poster img { width: 100%; height: auto; display: block; }
    .sed-more__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .sed-link { color: var(--r-accent); text-decoration: none; font-family: var(--r-mono, monospace); font-size: 0.8rem; font-weight: 700; }
    .sed-link:hover { text-decoration: underline; }
    .sed-more__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 0.75rem; }
    .sed-mini {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem;
      border-radius: 0.75rem;
      border: 1px solid var(--r-line);
      background: var(--r-surface);
      text-decoration: none;
      color: var(--r-text);
      transition: border-color 140ms, transform 140ms;
    }
    .sed-mini:hover { border-color: var(--r-accent); transform: translateY(-1px); }
    .sed-mini img { width: 64px; height: 42px; object-fit: contain; background: #0b1016; border-radius: 0.45rem; padding: 0.2rem; flex-shrink: 0; }
    .sed-mini strong { display: block; font-size: 0.84rem; color: var(--r-text); }
    .sed-mini span { display: block; font-size: 0.72rem; color: var(--r-muted); }
  </style>

  <script>
    (() => {
      const shareBtn = document.getElementById("sedShareBtn");
      shareBtn?.addEventListener("click", async () => {
        const title = shareBtn.dataset.shareTitle || document.title;
        const text = shareBtn.dataset.shareText || "";
        const url = window.location.href;
        if (navigator.share) {
          try { await navigator.share({ title, text, url }); return; } catch {}
        }
        try {
          await navigator.clipboard.writeText(url);
          const prev = shareBtn.textContent;
          shareBtn.textContent = "✓ Enlace copiado";
          setTimeout(() => { shareBtn.textContent = prev || "Compartir"; }, 1800);
        } catch {}
      });

      const hero = document.querySelector<HTMLElement>(".sed-hero");
      const stateEl = document.getElementById("sedState");
      const cdD = document.getElementById("cdD");
      const cdH = document.getElementById("cdH");
      const cdM = document.getElementById("cdM");
      const cdS = document.getElementById("cdS");
      if (!hero) return;

      const startMs = Date.parse(hero.dataset.start || "");
      const endMs = Date.parse(hero.dataset.end || "");
      const pad = (n: number) => String(Math.max(0, Math.floor(n))).padStart(2, "0");

      function tick() {
        const now = Date.now();
        let target = startMs;
        if (now >= startMs && now <= endMs) {
          if (stateEl) stateEl.textContent = "EN DIRECTO AHORA";
          target = endMs;
        } else if (now < startMs) {
          if (stateEl) stateEl.textContent = "PRÓXIMAMENTE";
          target = startMs;
        } else {
          if (stateEl) stateEl.textContent = "EDICIÓN 2026 COMPLETADA";
          if (cdD) cdD.textContent = "00";
          if (cdH) cdH.textContent = "00";
          if (cdM) cdM.textContent = "00";
          if (cdS) cdS.textContent = "00";
          return;
        }
        const diff = Math.max(0, target - now);
        if (cdD) cdD.textContent = pad(diff / 86400000);
        if (cdH) cdH.textContent = pad((diff % 86400000) / 3600000);
        if (cdM) cdM.textContent = pad((diff % 3600000) / 60000);
        if (cdS) cdS.textContent = pad((diff % 60000) / 1000);
      }

      tick();
      setInterval(tick, 1000);
    })();
  </script>
</Layout>
