---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Preferencias de correo · Muntrume Motorsport";
const pageDescription = "Muntrume Motorsport";
---

<Layout title={pageTitle} description={pageDescription}>
<main>
  <a class="brand" href="/"><img src="/assets/img/logo-64.webp" alt="" width="36" height="36">Muntrume Motorsport</a>
  <div class="card" aria-live="polite">
    <h1 id="title">Preferencias de correo</h1>
    <p id="who">Cargando tus preferencias…</p>
    <div id="msg" class="msg" role="status"></div>
    <form id="form" hidden>
      <div class="row">
        <label for="new_setups"><strong>Novedades del Setup Vault</strong><span>Setups nuevos de los coches que usas y resumen de la temporada.</span></label>
        <div class="sw"><input type="checkbox" id="new_setups" role="switch"><i aria-hidden="true"></i></div>
      </div>
      <div class="row">
        <label for="team_news"><strong>Noticias del equipo</strong><span>Resultados, eventos y anuncios de Muntrume Motorsport.</span></label>
        <div class="sw"><input type="checkbox" id="team_news" role="switch"><i aria-hidden="true"></i></div>
      </div>
      <div class="row" style="display:block">
        <label for="tz"><strong>Tu zona horaria</strong><span>La usamos para saludarte a la hora correcta y mostrar fechas en tu hora local.</span></label>
        <select id="tz"></select>
      </div>
      <button class="btn" type="submit" id="save">Guardar preferencias</button>
      <button class="btn ghost" type="button" id="all">Darme de baja de todo lo opcional</button>
      <p class="note">Los correos de seguridad (códigos de acceso, enlaces para crear o cambiar tu contraseña) se envían siempre, porque protegen tu cuenta.</p>
    </form>
  </div>
</main>
<script is:inline src="/assets/js/email-preferences.js?v=26s4.7" defer></script>
</Layout>
