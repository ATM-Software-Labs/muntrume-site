<script is:inline>
  (() => {
    const btn = document.getElementById("mmtAppDownloadBtn");
    if (btn) {
      fetch("https://muntrume.atrumin16.workers.dev/api/download/latest?info=1")
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => {
          if (d && d.version) btn.textContent = `Descargar MMT Sync v${d.version} (.exe)`;
        })
        .catch(() => {});
    }

    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const canvas = document.getElementById("appTelemetryCanvas");
    if (!canvas || !canvas.getContext) return;
    const ctx = canvas.getContext("2d");
    const thrBar = document.getElementById("appThrBar");
    const brkBar = document.getElementById("appBrkBar");
    const gearEl = document.getElementById("appGearVal");
    const speedEl = document.getElementById("appSpeedVal");
    const deltaEl = document.getElementById("appPodDelta");
    const deltaFill = document.getElementById("appPodDeltaFill");
    const trackEl = document.getElementById("appPodTrack");
    const setupEl = document.getElementById("appSetupCode");

    const STINTS = [
      { track: "SPA-FRANCORCHAMPS · GT3", setup: "MMT_F296_SPA_END_V2.sto" },
      { track: "DAYTONA 24H · GTP", setup: "MMT_P963_DAYTONA_END.sto" },
      { track: "NÜRBURGRING 24H · GT3", setup: "MMT_M4_NORDS_END_SAFE.sto" },
      { track: "LE MANS 24H · HYPERCAR", setup: "MMT_F499P_LEMANS_Q2_V2.sto" },
    ];
    let stintIdx = 0;
    setInterval(() => {
      stintIdx = (stintIdx + 1) % STINTS.length;
      if (trackEl) trackEl.textContent = STINTS[stintIdx].track;
      if (setupEl) setupEl.textContent = STINTS[stintIdx].setup;
    }, 7500);

    const N = 80;
    const thrHist = new Array(N).fill(0.85);
    const brkHist = new Array(N).fill(0.0);
    let t = 0;
    let visible = true;
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { visible = e.isIntersecting; });
      });
      io.observe(canvas);
    }
    function step() {
      if (visible && !document.hidden) {
        t += 0.045;
        const wave = Math.sin(t * 0.7) * Math.cos(t * 0.35);
        const brakingZone = wave < -0.42;
        const thr = brakingZone ? Math.max(0.04, 0.25 + (wave + 0.42) * 0.9) : Math.min(1, 0.72 + Math.sin(t * 0.9) * 0.28);
        const brk = brakingZone ? Math.min(0.96, Math.abs(wave + 0.35) * 1.45) : 0;
        thrHist.push(thr); thrHist.shift();
        brkHist.push(brk); brkHist.shift();

        const spd = Math.round(118 + thr * 154 - brk * 82);
        const gear = spd < 115 ? 2 : spd < 155 ? 3 : spd < 195 ? 4 : spd < 235 ? 5 : 6;
        const delta = (-0.18 - Math.sin(t * 0.3) * 0.16).toFixed(2);

        if (thrBar) thrBar.style.height = Math.round(thr * 100) + "%";
        if (brkBar) brkBar.style.height = Math.round(brk * 100) + "%";
        if (gearEl) gearEl.textContent = String(gear);
        if (speedEl) speedEl.textContent = String(spd);
        if (deltaEl) deltaEl.textContent = (Number(delta) <= 0 ? delta : "+" + delta) + "s";
        if (deltaFill) {
          const pct = Math.min(44, Math.max(8, Math.abs(Number(delta)) * 110));
          deltaFill.style.left = (50 - pct) + "%";
          deltaFill.style.width = pct + "%";
        }
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);
        ctx.strokeStyle = "rgba(255,255,255,0.05)";
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(0, h * 0.5); ctx.lineTo(w, h * 0.5); ctx.stroke();

        ctx.strokeStyle = "#00E699";
        ctx.lineWidth = 2;
        ctx.beginPath();
        for (let i = 0; i < N; i++) {
          const x = (i / (N - 1)) * w;
          const y = h - 6 - thrHist[i] * (h - 14);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();

        ctx.strokeStyle = "#EF4444";
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        for (let i = 0; i < N; i++) {
          const x = (i / (N - 1)) * w;
          const y = h - 6 - brkHist[i] * (h - 14);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  })();
