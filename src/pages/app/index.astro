---
import Layout from "../../layouts/Layout.astro";
import desktopPkg from "../../../desktop/package.json";

const appVersion = desktopPkg.version;
const pageTitle = "MMT Sync for Windows · iRacing Setup Sync & Telemetry";
const pageDescription = `Download MMT Sync ${appVersion} for Windows: auto-sync verified .sto setups, analyze .ibt telemetry locally, and run 60 FPS iRacing overlays. MMT Team.`;
const pageUrl = "https://muntru.me/app/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
const appSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": "https://muntru.me/#website" },
      "about": { "@id": `${pageUrl}#software` },
      "primaryImageOfPage": ogImage
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${pageUrl}#software`,
      "name": "MMT Sync",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Windows",
      "softwareVersion": appVersion,
      "url": pageUrl,
      "downloadUrl": "https://github.com/ATM-Software-Labs/muntrume-site/releases/latest",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "publisher": { "@id": "https://muntru.me/#org" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://muntru.me/" },
        { "@type": "ListItem", "position": 2, "name": "MMT Sync", "item": pageUrl }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt="MMT Sync para Windows"
  ogImageWidth={1200}
  ogImageHeight={630}
  schemaJson={appSchema}
  translated
  i18nTitle="app.meta.title"
  i18nDescription="app.meta.desc"
>
  <div class="app-page">
    <section class="app-hero g-bento-card" data-g-reveal>
      <div class="app-hero__pills">
        <span class="g-chip-accent">Tauri v2 · Rust Native</span>
        <span class="g-chip-muted">60 FPS · &lt; 15 MB RAM</span>
        <span class="g-chip-muted">MIT Open Source</span>
      </div>
      <p class="r-kicker" data-i18n="app.kicker">Software oficial de equipo · iRacing</p>
      <h1 data-i18n="app.title">MMT Sync</h1>
      <p class="r-lead" data-i18n="app.lead">La aplicación de escritorio oficial de Muntrume Motorsport. Sincroniza los setups de carrera, clasificación y lluvia en tus carpetas de iRacing y muestra en pista barras en directo de acelerador, freno, dirección, marcha y velocidad.</p>
      <div class="app-cta">
        <button type="button" id="btnLaunchOverlaysWeb" class="r-btn r-btn--primary">Lanzar Overlays en iRacing</button>
        <button type="button" id="btnInstallPwaWeb" data-mmt-install-pwa class="r-btn app-btn">Instalar como App</button>
        <a id="mmtAppDownloadBtn" class="r-btn app-btn" href="https://muntrume.atrumin16.workers.dev/api/download/latest" target="_blank" rel="noopener noreferrer" data-i18n="app.download">Descargar MMT Sync (.exe)</a>
        <a class="r-btn app-btn" href="/overlay/">Simulador HUD en vivo</a>
        <a class="r-btn app-btn" href="/app/install/">Guía de instalación</a>
        <a class="r-btn app-btn" href="/garage/" data-i18n="app.catalog">Ver catálogo web</a>
      </div>
      <p id="mmtPwaInstallHint" class="app-bridge-status" hidden>En Brave / Chrome / Edge: pulsa el icono «Instalar aplicación» (⊕) en la barra de direcciones para abrir Muntrume en ventana propia.</p>
      <p id="mmtLocalBridgeStatus" class="app-bridge-status" hidden></p>

      <div class="app-winget-box">
        <span class="app-winget-label">Instalación alternativa por consola (sin aviso SmartScreen):</span>
        <button type="button" class="app-winget-copy" id="copyWingetBtn" title="Copiar comando winget" onclick="navigator.clipboard.writeText('winget install Muntrume.MMTSync').then(()=>{const b=this;b.dataset.copied='1';setTimeout(()=>delete b.dataset.copied,2000);})">
          <code>winget install Muntrume.MMTSync</code>
          <span class="app-winget-icon">📋</span>
        </button>
      </div>

      <p class="app-meta">
        <span data-i18n="app.meta.os">Windows 10 / 11 (64-bit) · iOS &amp; Android Companion PWA</span>
        <span aria-hidden="true">·</span>
        <span>Versión {appVersion}</span>
        <span aria-hidden="true">·</span>
        <span data-i18n="app.meta.free">Gratis</span>
      </p>
    </section>

    <!-- ======================================================================= -->
    <!-- MMT MOBILE & CLOUD COMPANION HUB (PHONE PWA <-> D1 <-> MMT SYNC <-> IRACING) -->
    <!-- ======================================================================= -->
    <section class="app-card g-bento-card app-comp-shell" data-g-reveal aria-label="MMT Companion Cloud & Mobile">
      <div class="app-cmd-head">
        <div>
          <span class="g-chip-accent">Auto-Caché IRSDK RAM + lapfiles/*.blap · 0 Archivos Manuales</span>
          <h2 style="margin-top:8px">MMT Companion en Vivo · Telemetría, Última Carrera, Estrategia y Setups</h2>
          <p class="app-sub">No necesitas pulsar <code>Alt+L</code> ni guardar ningún archivo al terminar de correr. <strong>MMT Sync</strong> captura automáticamente desde la memoria RAM de iRacing y la caché de vueltas (<code>lapfiles/*.blap</code>) y lo sincroniza con tu móvil.</p>
        </div>
        <div class="app-comp-top-actions">
          <button type="button" id="btnCompRefresh" class="r-btn r-btn--primary">↻ Escanear Caché &amp; Cloud</button>
        </div>
      </div>

      <div id="mmtCompMsg" class="app-comp-msg" hidden></div>

      <!-- Shown if not signed in -->
      <div id="compNeedAuth" class="app-comp-authgate" hidden>
        <div>
          <strong>Inicia sesión para ver tu telemetría, última carrera y setups sincronizados</strong>
          <p>Tu cuenta conecta automáticamente <strong>MMT Sync</strong> en tu PC de simracing con la app de tu teléfono.</p>
        </div>
        <a href="/login/?next=/app/" class="r-btn r-btn--primary">Iniciar sesión →</a>
      </div>

      <!-- Shown when signed in -->
      <div id="compAuthedBox" data-no-translate>
        <div class="app-comp-statusbar">
          <div><span class="app-cmd-kicker">PILOTO CONECTADO</span><strong id="compPilotBadge">Cargando piloto…</strong></div>
          <div><span class="app-cmd-kicker">PC VINCULADO (MMT SYNC)</span><strong id="compDeviceStatus">Desktop PC · Online</strong></div>
          <div><span class="app-cmd-kicker">SETUPS .STO EN VAULT</span><strong id="compSetupsCount">42.654</strong></div>
          <div><a href="/app/vincular/" class="r-btn app-btn" style="padding:7px 14px;font-size:12.5px">+ Vincular otro PC</a></div>
        </div>

        <div class="app-comp-tabs" role="tablist">
          <button type="button" class="app-comp-tab is-active" data-comp-tab="race">1. Última Carrera y Debrief</button>
          <button type="button" class="app-comp-tab" data-comp-tab="telemetry">2. Telemetría en Caché (60 Hz)</button>
          <button type="button" class="app-comp-tab" data-comp-tab="strategy">3. Combustible, Stints y Presiones</button>
          <button type="button" class="app-comp-tab" data-comp-tab="queue">4. Radar Semanal y Enviar al PC</button>
        </div>

        <!-- PANEL 1: LAST RACE, STREAKS & AUTO ENGINEER DEBRIEF -->
        <div class="app-comp-panel" data-comp-panel="race">
          <div class="app-comp-racehero">
            <div>
              <span class="app-cmd-kicker">DETECTADO AUTOMÁTICAMENTE EN CACHÉ DE IRACING</span>
              <h3 id="compLrTrack" style="margin:4px 0;font-size:20px">Circuit de Spa-Francorchamps</h3>
              <p id="compLrMeta" style="margin:0;color:var(--r-muted);font-size:13px">Ferrari 296 GT3 · Official Race</p>
            </div>
            <code id="compLrSetup" class="app-comp-setupbadge">MMT_26S4_W08_SPA_R.sto</code>
          </div>

          <div class="app-comp-kpis">
            <div class="app-comp-kpi"><span>RESULTADO</span><strong id="compLrPos">P4 → P2 (+2)</strong></div>
            <div class="app-comp-kpi"><span>DELTA iRATING</span><strong id="compLrIrDelta" style="color:#10b981">+48 iR</strong></div>
            <div class="app-comp-kpi"><span>INCIDENTES</span><strong id="compLrInc">0x</strong></div>
            <div class="app-comp-kpi"><span>MEJOR VUELTA</span><strong id="compLrBestLap">2:16.412</strong></div>
            <div class="app-comp-kpi"><span>VUELTA MEDIA</span><strong id="compLrAvgLap">2:17.185</strong></div>
            <div class="app-comp-kpi"><span>CONSISTENCIA</span><strong id="compLrCons">98.6%</strong></div>
          </div>

          <div class="app-comp-streaks">
            <div class="app-comp-streak"><span>RACHA LIMPIA (&lt;4x)</span><strong id="compStreakClean">4 seguidas</strong></div>
            <div class="app-comp-streak"><span>RACHA TOP 5</span><strong id="compStreakTop5">3 podios/Top 5</strong></div>
            <div class="app-comp-streak"><span>VUELTAS 0x</span><strong id="compStreakLaps">89 vueltas 0x</strong></div>
            <div class="app-comp-streak"><span>BALANCE 10 CARR.</span><strong id="compStreakGain">+14 pos.</strong></div>
          </div>

          <!-- AUTO ENGINEER DEBRIEF -->
          <div class="app-comp-debrief" style="margin-top:14px">
            <div class="app-cmd-kicker">INGENIERO DE PISTA · DIAGNÓSTICO AUTOMÁTICO POST-CARRERA</div>
            <strong id="compDebriefTitle" style="display:block;margin:4px 0 8px;font-size:15px">Analizando caché de la última tanda…</strong>
            <ul id="compDebriefList" style="margin:0;padding-left:18px;font-size:13px;line-height:1.65;color:var(--r-muted)"></ul>
          </div>

          <div class="r-scroll" style="margin-top:14px">
            <table class="r-table">
              <thead><tr><th>Circuito / Origen Caché</th><th>Coche / Setup .sto</th><th>Posición</th><th>Inc.</th><th>iR Δ</th><th>Mejor Vuelta</th></tr></thead>
              <tbody id="compSessionsTbody"></tbody>
            </table>
          </div>
        </div>

        <!-- PANEL 2: 60 HZ TELEMETRY TRACE FROM CACHE -->
        <div class="app-comp-panel" data-comp-panel="telemetry" hidden>
          <div class="app-comp-racehero">
            <div>
              <span class="app-cmd-kicker">MEMORIA COMPARTIDA IRSDK &amp; CACHÉ .BLAP (SIN ARCHIVOS MANUALES)</span>
              <h3 id="compTelTitle" style="margin:4px 0;font-size:19px">Circuit de Spa-Francorchamps · Ferrari 296 GT3</h3>
              <p id="compTelSub" style="margin:0;color:var(--r-muted);font-size:12.5px">Cargando canales desde caché…</p>
            </div>
            <span class="g-chip-accent">60 Hz Auto-Capture</span>
          </div>

          <div class="app-comp-canvasbox">
            <div class="app-comp-legend">
              <span><i style="background:#38BDF8"></i>Velocidad (km/h)</span>
              <span><i style="background:#10B981"></i>Acelerador (%)</span>
              <span><i style="background:#EF4444"></i>Freno (%)</span>
              <code id="compTelReadout">Desliza el dedo o el ratón sobre la gráfica para inspeccionar metro a metro</code>
            </div>
            <canvas id="compTelCanvas" width="860" height="210" style="width:100%;height:210px;display:block;cursor:crosshair"></canvas>
          </div>

          <div class="r-scroll" style="margin-top:14px">
            <table class="r-table">
              <thead><tr><th>Vuelta en Caché</th><th>Tiempo</th><th>Delta</th><th>Vel. Punta</th><th>Estado</th></tr></thead>
              <tbody id="compTelLapsTbody"></tbody>
            </table>
          </div>
        </div>

        <!-- PANEL 3: AUTO FUEL, STINT & TIRE PRESSURES CALCULATOR -->
        <div class="app-comp-panel" data-comp-panel="strategy" hidden>
          <div class="app-comp-racehero">
            <div>
              <span class="app-cmd-kicker">ESTRATEGIA PRE-CALCULADA DESDE TU ÚLTIMA SESIÓN EN CACHÉ</span>
              <h3 id="compStratTitle" style="margin:4px 0;font-size:19px">Ferrari 296 GT3 · Circuit de Spa-Francorchamps</h3>
              <p style="margin:0;color:var(--r-muted);font-size:13px">Ajustada automáticamente con tu tiempo por vuelta y consumo real en pista.</p>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
              <label for="compStratDuration" style="font-size:12.5px;font-weight:700">Duración carrera:</label>
              <select id="compStratDuration" style="padding:7px 12px;border-radius:10px;border:1px solid var(--r-line);background:var(--r-bg);color:var(--r-text);font-weight:700">
                <option value="20">20 min (Fixed / Sprint)</option>
                <option value="35">35 min (IMSA Fixed)</option>
                <option value="40" selected>40 min (GT Sprint)</option>
                <option value="45">45 min (IMSA Open)</option>
                <option value="60">60 min (Endurance 1h)</option>
                <option value="180">180 min (GT Endurance 3h)</option>
              </select>
            </div>
          </div>

          <div class="app-comp-kpis">
            <div class="app-comp-kpi"><span>CONSUMO / VUELTA</span><strong id="compStFuelLap">2.78 L</strong></div>
            <div class="app-comp-kpi"><span>AUTONOMÍA DEPÓSITO</span><strong id="compStMaxLaps">35 vueltas</strong></div>
            <div class="app-comp-kpi"><span>LITROS TOTALES CARRERA</span><strong id="compStTotalFuel" style="color:#10b981">52 L</strong></div>
            <div class="app-comp-kpi"><span>REPOSTAR EN BOXES</span><strong id="compStPitAdd">24 L</strong></div>
            <div class="app-comp-kpi"><span>PRESIÓN FRÍO / CALIENTE</span><strong id="compStPress">148 → 168 kPa</strong></div>
            <div class="app-comp-kpi"><span>BRAKE BIAS BASE</span><strong id="compStBias">54.2%</strong></div>
          </div>
        </div>

        <!-- PANEL 4: WEEK RADAR & REMOTE SETUP QUEUE TO PC -->
        <div class="app-comp-panel" data-comp-panel="queue" hidden>
          <div class="app-cmd-kicker" style="margin-bottom:8px">RADAR DE SERIES ESTA SEMANA · ESTADO EN LA CACHÉ DE TU PC</div>
          <div id="compWeekRadarList" class="app-comp-qlist" style="margin-bottom:18px"></div>

          <p style="margin:0 0 10px;color:var(--r-muted);font-size:13.5px">¿Quieres preparar otro coche o circuito desde el teléfono? Envíalo a la cola y <strong>MMT Sync</strong> lo dejará listo en <code>Documents\iRacing\setups\</code>:</p>
          <form id="formCompQueueSetup" class="app-comp-formgrid">
            <select id="compQueueCar">
              <option value="ferrari296gt3">Ferrari 296 GT3</option>
              <option value="porsche992rgt3">Porsche 911 GT3 R (992)</option>
              <option value="bmwm4gt3">BMW M4 GT3 EVO</option>
              <option value="mercedesamgevogt3">Mercedes-AMG GT3 2020</option>
              <option value="mclaren720sgt3">McLaren 720S GT3 EVO</option>
              <option value="fordmustanggt3">Ford Mustang GT3</option>
              <option value="chevyvettez06rgt3">Corvette Z06 GT3.R</option>
              <option value="lamborghinievogt3">Lamborghini Huracán GT3 EVO</option>
              <option value="audir8lmsevo2gt3">Audi R8 LMS EVO II GT3</option>
              <option value="acuransxevo22gt3">Acura NSX GT3 EVO 22</option>
              <option value="amvantageevogt3">Aston Martin Vantage GT3 EVO</option>
              <option value="porsche963gtp">Porsche 963 GTP</option>
              <option value="ferrari499p">Ferrari 499P</option>
              <option value="bmwlmdh">BMW M Hybrid V8</option>
              <option value="cadillacvseriesrgtp">Cadillac V-Series.R GTP</option>
              <option value="acuraarx06gtp">Acura ARX-06 GTP</option>
              <option value="dallarap217">Dallara P217 LMP2</option>
              <option value="porsche9922cup">Porsche 911 Cup (992.2)</option>
              <option value="porsche718gt4">Porsche 718 Cayman GT4</option>
            </select>
            <input type="text" id="compQueueTrack" placeholder="Circuito (ej. Silverstone, Road Atlanta, Spa)" value="Silverstone Circuit - Grand Prix" required />
            <select id="compQueueType">
              <option value="race">Race (Carrera)</option>
              <option value="quali">Qualy (Clasificación)</option>
              <option value="endurance">Endurance (Resistencia)</option>
              <option value="wet">Wet (Lluvia)</option>
              <option value="safe">Safe (Seguro)</option>
            </select>
            <button type="submit" class="r-btn r-btn--primary">📲 Enviar a mi PC (MMT Sync)</button>
          </form>

          <div id="compQueueList" class="app-comp-qlist" style="margin-top:14px"></div>
        </div>
      </div>
    </section>

    <!-- INTERACTIVE REMOTE COMMAND CENTER & RUST ENGINE SHOWCASE -->
    <section class="app-card g-bento-card" data-g-reveal>
      <div class="app-cmd-head">
        <div>
          <span class="g-chip-accent">Local Bridge · 127.0.0.1:38421</span>
          <h2 style="margin-top:8px">Centro de Mando Remoto · MMT Sync v{appVersion}</h2>
          <p class="app-sub">Controla la aplicación de escritorio en Rust directamente desde el navegador o lanza los módulos en iRacing con un clic.</p>
        </div>
        <span id="appBridgePill" class="g-chip-muted">Esperando conexión local…</span>
      </div>

      <div class="app-cmd-grid" data-no-translate>
        <button type="button" data-bridge-cmd="launch-overlay" class="app-cmd-tile">
          <span class="app-cmd-kicker">01 · OVERLAYS 60 HZ</span>
          <strong>Lanzar HUD en Pista</strong>
          <small>Activa la ventana transparente Click-Through sobre iRacing</small>
        </button>
        <button type="button" data-bridge-cmd="edit-hud" class="app-cmd-tile">
          <span class="app-cmd-kicker">02 · LAYOUT STUDIO</span>
          <strong>Editar Posición HUD</strong>
          <small>Desbloquea los 9 widgets para arrastrarlos con el ratón (F9)</small>
        </button>
        <button type="button" data-bridge-cmd="sync-week" class="app-cmd-tile">
          <span class="app-cmd-kicker">03 · SHA-256 VAULT</span>
          <strong>Sincronizar Semana S4</strong>
          <small>Descarga los setups .sto Open nuevos o actualizados en 1 clic</small>
        </button>
        <button type="button" data-bridge-cmd="open-app" class="app-cmd-tile">
          <span class="app-cmd-kicker">04 · DESKTOP CLIENT</span>
          <strong>Abrir Ventana Nativa</strong>
          <small>Restaura MMT Sync desde la bandeja del sistema de Windows</small>
        </button>
      </div>
    </section>

    <!-- LIVE 60 HZ TELEMETRY & POST-STINT SETUP FEEDBACK SHOWCASE -->
    <section class="app-card app-telemetry-card" data-g-reveal aria-label="Telemetría en directo y valoración de setups">
      <div class="app-tel-copy">
        <div class="app-hero__pills" style="justify-content:flex-start">
          <span class="g-chip-accent">IRSDK Shared Memory</span>
          <span class="g-chip-muted">60 Hz En Vivo</span>
          <span class="g-chip-muted">Feedback Post-Stint</span>
        </div>
        <h2>Telemetría en directo y valoración de setups</h2>
        <p>Lectura directa de acelerador, freno, marcha, delta de vuelta y setup <code>.sto</code> activo desde la memoria compartida de iRacing (<code>FILE_MAP_READ</code>). Al terminar tu tanda en <strong>MMT Sync</strong>, valora el setup con sensaciones, delta frente a Top Split y notas moderadas automáticamente por <strong>MMT Steward Bot</strong>.</p>
        <div class="app-cta" style="justify-content:flex-start">
          <a href="/overlay/" class="r-btn r-btn--primary">Abrir Simulador HUD</a>
          <a href="/garage/#valoraciones" class="r-btn app-btn">Ver valoraciones en Garage →</a>
        </div>
      </div>

      <aside class="app-pod" data-no-translate aria-label="Vista previa telemetría 60 Hz">
        <div class="app-pod__head">
          <div class="app-pod__status">
            <span class="app-pod__dot" aria-hidden="true"></span>
            <span class="app-pod__tag">IRSDK SHARED MEMORY · 60 HZ</span>
          </div>
          <span class="app-pod__badge" id="appPodTrack">SPA-FRANCORCHAMPS · GT3</span>
        </div>

        <div class="app-pod__delta">
          <div class="app-pod__delta-top">
            <span>SESSION BEST Δ</span>
            <strong id="appPodDelta">-0.24s</strong>
          </div>
          <div class="app-pod__delta-bar">
            <span class="app-pod__delta-mid"></span>
            <div class="app-pod__delta-fill" id="appPodDeltaFill" style="left:22%;width:28%"></div>
          </div>
        </div>

        <div class="app-pod__cockpit">
          <div class="app-pod__trace">
            <canvas id="appTelemetryCanvas" width="320" height="84" aria-label="Curva de acelerador y freno en tiempo real"></canvas>
            <div class="app-pod__legend">
              <span><i style="background:#00E699"></i>THR</span>
              <span><i style="background:#EF4444"></i>BRK</span>
              <span><i style="background:#38BDF8"></i>RPM</span>
            </div>
          </div>

          <div class="app-pod__pedals" aria-hidden="true">
            <div class="app-pod__pedal">
              <div class="app-pod__pedal-track"><div id="appBrkBar" class="app-pod__pedal-fill app-pod__pedal-fill--brk" style="height:8%"></div></div>
              <span>B</span>
            </div>
            <div class="app-pod__pedal">
              <div class="app-pod__pedal-track"><div id="appThrBar" class="app-pod__pedal-fill app-pod__pedal-fill--thr" style="height:94%"></div></div>
              <span>T</span>
            </div>
          </div>

          <div class="app-pod__gear">
            <span class="app-pod__gear-lbl">GEAR</span>
            <strong class="app-pod__gear-val" id="appGearVal">5</strong>
            <span class="app-pod__speed"><b id="appSpeedVal">246</b> km/h</span>
          </div>
        </div>

        <div class="app-pod__foot">
          <div>
            <span class="app-pod__kicker">SETUP ACTIVO (.STO)</span>
            <code id="appSetupCode">MMT_F296_SPA_END_V2.sto</code>
          </div>
          <div class="app-pod__pills">
            <span>2.84 L/lap</span>
            <span>84°C FL</span>
            <a href="/overlay/">Probar HUD →</a>
          </div>
        </div>
      </aside>
    </section>

    <section class="app-card" data-g-reveal>
      <h2 data-i18n="app.safe.title">Revisado por el equipo</h2>
      <p class="app-sub" data-i18n="app.safe.sub">Sin publicidad · sin rastreadores de terceros · no modifica tus archivos privados</p>
      <div class="app-split">
        <article>
