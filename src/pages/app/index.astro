  <script is:inline>
    (function () {
      const BRIDGE_URL = "http://127.0.0.1:38421";
      const btn = document.getElementById("btnLaunchOverlaysWeb");
      const statusEl = document.getElementById("mmtLocalBridgeStatus");
      const modal = document.getElementById("mmtDownloadModal");
      const modalClose = document.getElementById("mmtModalClose");
      const dlBtn = document.getElementById("mmtDirectDownloadBtn");
      let bridgeReady = false;

      async function pingLocalBridge() {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 400);
        try {
          const res = await fetch(BRIDGE_URL + "/ping", { method: "GET", signal: ctrl.signal });
          clearTimeout(timer);
          if (!res.ok) return null;
          const data = await res.json();
          if (data && data.status === "ready") return data;
        } catch (_e) {
          clearTimeout(timer);
        }
        return null;
      }

      function showStatus(msg, ok) {
        if (!statusEl) return;
        statusEl.hidden = false;
        statusEl.textContent = msg;
        statusEl.dataset.ok = ok ? "1" : "0";
      }

      async function initBridgeCheck() {
        const isStandalone = window.matchMedia && window.matchMedia("(display-mode: standalone)").matches;
        const pill = document.getElementById("appBridgePill");
        const info = await pingLocalBridge();
        if (info && btn) {
          bridgeReady = true;
          btn.textContent = "LANZAR OVERLAYS EN PISTA";
          if (pill) {
            pill.className = "g-chip-accent";
            pill.textContent = info.inTrack
              ? `● MMT Sync v${info.version} · En pista`
              : `● MMT Sync v${info.version} · Conectado`;
          }
          showStatus(
            info.inTrack
              ? "MMT Sync v" + info.version + " conectado · iRacing en pista"
              : "MMT Sync v" + info.version + " listo en segundo plano",
            true
          );
        } else if (isStandalone) {
          showStatus("Modo App Independiente activo · Abre MMT Sync para conectar overlays en pista", false);
        }
      }

      async function sendBridgeAction(action) {
        const info = bridgeReady ? { status: "ready" } : await pingLocalBridge();
        if (info && info.status === "ready") {
          bridgeReady = true;
          try {
            const ctrl = new AbortController();
            const t = setTimeout(() => ctrl.abort(), 800);
            const res = await fetch(BRIDGE_URL + "/command", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ action }),
              signal: ctrl.signal,
            });
            clearTimeout(t);
            if (res.ok) {
              const data = await res.json().catch(() => ({}));
              showStatus(data.message || "Comando ejecutado en MMT Sync", true);
              return true;
            }
          } catch (_e) {}
        }
        showStatus("Despertando MMT Sync…", true);
        window.location.href = "mmtsync://" + action;
        return false;
      }

      document.querySelectorAll("[data-bridge-cmd]").forEach((tile) => {
        tile.addEventListener("click", () => {
          const action = tile.getAttribute("data-bridge-cmd") || "launch-overlay";
          sendBridgeAction(action);
        });
      });

      if (modalClose && modal) {
        modalClose.addEventListener("click", () => {
          modal.hidden = true;
        });
      }

      if (btn) {
        btn.addEventListener("click", async () => {
          const info = bridgeReady ? { status: "ready" } : await pingLocalBridge();
          if (info && info.status === "ready") {
            bridgeReady = true;
            try {
              const ctrl = new AbortController();
              const t = setTimeout(() => ctrl.abort(), 800);
              const res = await fetch(BRIDGE_URL + "/command", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ action: "launch-overlay" }),
                signal: ctrl.signal,
              });
              clearTimeout(t);
              if (res.ok) {
                showStatus("Overlays activados en MMT Sync", true);
                return;
              }
            } catch (_e) {}
          }

          showStatus("Despertando MMT Sync…", true);
          window.location.href = "mmtsync://launch-overlay";

          setTimeout(async () => {
            const verify = await pingLocalBridge();
            if (verify && verify.status === "ready") {
              bridgeReady = true;
              btn.textContent = "LANZAR OVERLAYS EN PISTA";
              showStatus("Overlays activados en MMT Sync", true);
            } else if (modal) {
              try {
                const r = await fetch("https://github.com/ATM-Software-Labs/muntrume-site/releases/latest/download/latest.json");
                if (r.ok) {
                  const j = await r.json();
                  const winUrl = j?.platforms?.["windows-x86_64"]?.url;
                  if (winUrl && dlBtn) dlBtn.href = winUrl;
                }
              } catch (_e) {}
              modal.hidden = false;
            }
          }, 2000);
        });
      }

      initBridgeCheck();
    })();
  </script>
</Layout>

