---
import Layout from "../../layouts/Layout.astro";
import desktopPkg from "../../../desktop/package.json";

const appVersion = desktopPkg.version;
const pageTitle = "MMT Sync para Windows | Muntrume Motorsport";
const pageDescription = `MMT Sync ${appVersion} para Windows. Sincroniza setups .sto Open, analiza telemetría .ibt y muestra overlays en iRacing.`;
const pageUrl = "https://muntru.me/app/";
const ogImage = "https://muntru.me/assets/img/og-setups.jpg";
const appSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": pageTitle,
      "description": pageDescription,
      "isPartOf": { "@id": "https://muntru.me/#website" },
      "about": { "@id": `${pageUrl}#software` },
      "primaryImageOfPage": ogImage
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${pageUrl}#software`,
      "name": "MMT Sync",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Windows",
      "softwareVersion": appVersion,
      "url": pageUrl,
      "downloadUrl": "https://github.com/ATM-Software-Labs/muntrume-site/releases/latest",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR"
      },
      "publisher": { "@id": "https://muntru.me/#org" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${pageUrl}#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://muntru.me/" },
        { "@type": "ListItem", "position": 2, "name": "MMT Sync", "item": pageUrl }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pageUrl}
  ogImage={ogImage}
  ogImageAlt="MMT Sync para Windows"
  ogImageWidth={1200}
  ogImageHeight={630}
  schemaJson={appSchema}
  translated
  i18nTitle="app.meta.title"
  i18nDescription="app.meta.desc"
>
  <div class="app-page">
    <section class="app-hero">
      <p class="r-kicker" data-i18n="app.kicker">Software oficial de equipo · iRacing</p>
      <h1 data-i18n="app.title">MMT Sync</h1>
      <p class="r-lead" data-i18n="app.lead">La aplicación de escritorio oficial de Muntrume Motorsport. Sincroniza los setups de carrera, clasificación y lluvia en tus carpetas de iRacing y muestra en pista barras en directo de acelerador, freno, dirección, marcha y velocidad.</p>
      <div class="app-cta">
        <a class="r-btn r-btn--primary" href="https://github.com/ATM-Software-Labs/muntrume-site/releases/latest" target="_blank" rel="noopener noreferrer" data-i18n="app.download">Descargar para Windows (64-bit)</a>
        <a class="r-btn app-btn" href="/garage/" data-i18n="app.catalog">Ver catálogo web de setups</a>
      </div>
      <p class="app-meta">
        <span data-i18n="app.meta.os">Windows 10 / 11 (64-bit)</span>
        <span aria-hidden="true">·</span>
        <span>Versión {appVersion}</span>
        <span aria-hidden="true">·</span>
        <span data-i18n="app.meta.free">Gratis</span>
      </p>
      <p class="app-meta" style="margin-top:-6px;font-size:11px;">
        <span>Alternativa por consola: <code>winget install Muntrume.MMTSync</code></span>
      </p>
    </section>

    <section class="app-card">
      <h2 data-i18n="app.safe.title">Revisado por el equipo</h2>
      <p class="app-sub" data-i18n="app.safe.sub">Sin publicidad · sin rastreadores de terceros · no modifica tus archivos privados</p>
      <div class="app-split">
        <article>
          <h3 data-i18n="app.safe.sdk.title">SDK de iRacing solo lectura</h3>
          <p data-i18n="app.safe.sdk.body">MMT Sync se conecta con iRacing en modo lectura (<code>FILE_MAP_READ</code>) a través de la memoria compartida oficial del simulador. No escribe en el juego.</p>
        </article>
        <article>
          <h3 data-i18n="app.safe.screen.title">Aviso de Windows SmartScreen</h3>
          <p data-i18n="app.safe.screen.body">Es una herramienta privada del equipo sin certificado comercial de Microsoft, así que Windows puede decir que protegió tu PC. Para instalar, elige Más información y después Ejecutar de todas formas.</p>
        </article>
      </div>
    </section>

    <section class="app-grid">
      <article class="app-card">
        <p class="app-num">01</p>
        <h2 data-i18n="app.cap.1.title">Setups Open por semana</h2>
        <p data-i18n="app.cap.1.body">Sincroniza automáticamente los reglajes .sto de la semana en <code>iRacing\setups</code>. Bloquea series Fixed para no duplicar archivos innecesarios.</p>
      </article>
      <article class="app-card">
        <p class="app-num">02</p>
        <h2 data-i18n="app.cap.2.title">HUD estilo GO Setups</h2>
        <p data-i18n="app.cap.2.body">Overlay transparente Always-On-Top con telemetría en directo, shift lights, radar relativo y presets (Completo, Radar, Telemetría).</p>
      </article>
      <article class="app-card">
        <p class="app-num">03</p>
        <h2 data-i18n="app.cap.3.title">Análisis .ibt local</h2>
        <p data-i18n="app.cap.3.body">Compara tu vuelta metro a metro y revisa tu última sesión sin subir datos privados ni dorsales fuera de tu PC.</p>
      </article>
    </section>

    <section class="app-card">
      <h2 data-i18n="app.how.title">Vincula la aplicación en tres pasos</h2>
      <ol class="app-steps">
        <li>
          <span>1</span>
          <h3 data-i18n="app.how.1.title">Instala y abre MMT Sync</h3>
          <p data-i18n="app.how.1.body">Ejecuta el instalador y pulsa Vincular con muntru.me. Verás un código de 8 caracteres.</p>
        </li>
        <li>
          <span>2</span>
          <h3 data-i18n="app.how.2.title">Autoriza en la web</h3>
          <p data-i18n="app.how.2.body">Se abrirá el navegador en muntru.me. Pulsa Autorizar este dispositivo con tu sesión de piloto activa.</p>
        </li>
        <li>
          <span>3</span>
          <h3 data-i18n="app.how.3.title">Listo para rodar</h3>
          <p data-i18n="app.how.3.body">El token se guarda en el Credential Manager de Windows. Pulsa Sincronizar ahora para tener los setups en iRacing.</p>
        </li>
      </ol>
    </section>

    <p class="app-meta">
      Free code signing provided by <a href="https://signpath.io/" target="_blank" rel="noopener">SignPath.io</a>, certificate by <a href="https://signpath.org/" target="_blank" rel="noopener">SignPath Foundation</a>.
    </p>
  </div>
</Layout>

<style>
  .app-page { width: min(1040px, calc(100% - 2 * var(--r-gutter))); margin: 0 auto; padding: clamp(28px, 5vw, 64px) 0 80px; display: grid; gap: 20px; }
  .app-hero { display: grid; gap: 14px; justify-items: center; text-align: center; padding: 12px 0 8px; }
  .app-hero .r-kicker { justify-content: center; }
  .app-hero h1 { margin: 0; font: 800 clamp(56px, 10vw, 96px)/.9 var(--r-display); letter-spacing: .02em; text-transform: uppercase; }
  .app-hero .r-lead { margin: 0 auto; }
  .app-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .app-btn { border-color: var(--r-line); color: var(--r-text); background: var(--r-surface); }
  .app-btn:hover { border-color: var(--r-accent); color: var(--r-accent); }
  .app-meta { margin: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; justify-content: center; color: var(--r-muted); font: 600 12px/1.4 var(--r-mono); }
  .app-card { padding: 22px; border: 1px solid var(--r-line); border-radius: 16px; background: var(--r-surface); display: grid; gap: 10px; transition: border-color .2s ease, transform .2s ease; }
  .app-card:hover { border-color: var(--r-accent); }
  .app-card h2, .app-card h3 { margin: 0; }
  .app-card p { margin: 0; color: var(--r-muted); font-size: 14px; line-height: 1.55; }
  .app-card code { color: var(--r-accent); font-family: var(--r-mono); font-size: 12px; }
  .app-sub { font: 600 12px/1.4 var(--r-mono) !important; }
  .app-num { margin: 0; color: var(--r-accent); font: 800 28px/1 var(--r-mono); }
  .app-split, .app-grid, .app-steps { display: grid; gap: 12px; }
  .app-split article, .app-steps li { padding: 14px; border: 1px solid var(--r-line); border-radius: 12px; background: var(--r-bg); display: grid; gap: 6px; }
  .app-steps { list-style: none; margin: 8px 0 0; padding: 0; }
  .app-steps span { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px; background: color-mix(in srgb, var(--r-accent) 14%, transparent); color: var(--r-accent); font: 800 13px/1 var(--r-mono); }
  @media (min-width: 800px) {
    .app-split, .app-grid, .app-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .app-split { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-card { transition: none; }
    .app-card:hover { transform: none; }
  }
</style>
