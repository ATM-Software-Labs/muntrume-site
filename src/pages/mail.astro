---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Webmail & Telemetry Comms · Muntrume Motorsport";
const pageDescription = "Embedded corporate webmail client and institutional telemetry communications portal for Muntrume Motorsport drivers, engineering and staff.";
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- ========================================================================= -->
  <!-- 1. HERO HEADER: WEBMAIL WORKSPACE & SYSTEM STATUS                         -->
  <!-- ========================================================================= -->
  <section class="pt-28 pb-6 bg-[#0e1217] border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Status Strip -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-4 border-b border-white/10 text-xs">
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-semibold uppercase flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Institutional Domain · @muntru.me
          </span>
          <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono text-[11px]">
            ⚡ Cloudflare Edge + Brevo Relay
          </span>
        </div>
        <div class="flex items-center gap-3 text-neutral-400 font-medium font-mono text-[11px]">
          <span class="text-emerald-400 flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            TLS 1.3 Strict
          </span>
          <span class="text-neutral-600">|</span>
          <span>DMARC 100% Pass</span>
          <span class="text-neutral-600">|</span>
          <button id="open-settings-btn" class="text-emerald-400 hover:text-emerald-300 underline font-sans transition">
            Configuración Brevo
          </button>
        </div>
      </div>

      <!-- Header Title & Active Identity Selector -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 py-2">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-emerald-400 text-xs font-semibold mb-2">
            <span>🏁 Muntrume Team Mail Client</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
            CORP <span class="text-emerald-400">WEBMAIL</span>
          </h1>
          <p class="text-xs sm:text-sm text-neutral-400 mt-1">
            Gestión interna de briefings de carrera, telemetrías y setups sin salir de la plataforma oficial.
          </p>
        </div>

        <!-- Identity Switcher Dropdown -->
        <div class="bg-[#161c24] border border-white/10 rounded-2xl p-2.5 flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center font-bold text-emerald-400 text-sm shadow-inner" id="active-avatar">
            AT
          </div>
          <div class="text-left pr-2">
            <div class="text-[10px] uppercase font-mono tracking-wider text-neutral-400 font-bold">Buzón Activo</div>
            <select id="driver-account-selector" class="bg-transparent text-white font-bold text-xs focus:outline-none cursor-pointer">
              <option value="alberto@muntru.me" selected>Alberto Trujillo (alberto@muntru.me)</option>
              <option value="mateo@muntru.me">Mateo Berbis (mateo@muntru.me)</option>
              <option value="eduardo@muntru.me">Eduardo Chongkan (eduardo@muntru.me)</option>
              <option value="juanlu@muntru.me">Juanlu Carrillo (juanlu@muntru.me)</option>
              <option value="admin@muntru.me">Race Control (admin@muntru.me)</option>
            </select>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. GMAIL-STYLE EMBEDDED WEBMAIL APP CONTAINER                             -->
  <!-- ========================================================================= -->
  <section class="py-6 bg-[#090d12] min-h-[750px]">
    <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8">
      
      <!-- Main Webmail Card UI -->
      <div class="bg-[#12171f] border border-white/10 rounded-2xl shadow-2xl overflow-hidden flex flex-col min-h-[680px]">
        
        <!-- TOP APP TOOLBAR -->
        <div class="p-3 sm:p-4 bg-[#161c24] border-b border-white/10 flex flex-wrap items-center justify-between gap-3">
          
          <!-- Mobile Sidebar Toggle & Search Bar -->
          <div class="flex items-center gap-3 flex-1 min-w-[260px]">
            <button id="toggle-sidebar-mobile" class="md:hidden p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white" aria-label="Abrir carpetas">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>

            <!-- Search input -->
            <div class="relative flex-1 max-w-xl">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <input 
                type="text" 
                id="mail-search-input" 
                placeholder="Buscar en correos, setups .sto, telemetrías o pilotos..." 
                class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#0e1217] border border-white/10 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500/50 transition font-sans"
              />
            </div>
          </div>

          <!-- Quick Actions & Status -->
          <div class="flex items-center gap-2">
            <button id="refresh-mailbox-btn" title="Actualizar buzón" class="p-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-emerald-400 transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            </button>
            <button id="open-compose-header-btn" class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition shadow-lg shadow-emerald-500/20">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>Redactar</span>
            </button>
          </div>

        </div>

        <!-- APP BODY (SIDEBAR + MESSAGE LIST / DETAIL VIEW) -->
        <div class="flex-1 flex overflow-hidden relative">
          
          <!-- LEFT SIDEBAR (GMAIL FOLDERS) -->
          <aside id="mail-sidebar" class="w-64 bg-[#131922] border-r border-white/10 flex flex-col justify-between shrink-0 transition-transform duration-200 z-20 absolute inset-y-0 left-0 md:relative md:translate-x-0 -translate-x-full">
            <div class="p-4 space-y-4">
              <!-- Compose Button (Prominent Gmail Style) -->
              <button id="open-compose-btn" class="w-full py-3.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-xs uppercase tracking-wider transition-all shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 group">
                <svg class="w-4 h-4 group-hover:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>Redactar Mensaje</span>
              </button>

              <!-- Folder Nav Links -->
              <nav class="space-y-1" id="folders-nav">
                <button data-folder="inbox" class="folder-btn active w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition">
                  <div class="flex items-center gap-3">
                    <span class="text-base">📥</span>
                    <span>Bandeja de entrada</span>
                  </div>
                  <span id="unread-counter" class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">3</span>
                </button>

                <button data-folder="briefings" class="folder-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white hover:bg-white/5">
                  <div class="flex items-center gap-3">
                    <span class="text-base">🏁</span>
                    <span>Briefings &amp; Setups</span>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 font-mono text-[10px] font-bold">.STO</span>
                </button>

                <button data-folder="starred" class="folder-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white hover:bg-white/5">
                  <div class="flex items-center gap-3">
                    <span class="text-base">⭐</span>
                    <span>Destacados</span>
                  </div>
                  <span id="starred-counter" class="text-neutral-500 font-mono text-[10px]">1</span>
                </button>

                <button data-folder="sent" class="folder-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white hover:bg-white/5">
                  <div class="flex items-center gap-3">
                    <span class="text-base">📤</span>
                    <span>Enviados</span>
                  </div>
                  <span id="sent-counter" class="text-neutral-500 font-mono text-[10px]">0</span>
                </button>

                <button data-folder="drafts" class="folder-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white hover:bg-white/5">
                  <div class="flex items-center gap-3">
                    <span class="text-base">📝</span>
                    <span>Borradores</span>
                  </div>
                  <span id="drafts-counter" class="text-neutral-500 font-mono text-[10px]">0</span>
                </button>

                <button data-folder="trash" class="folder-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition text-neutral-400 hover:text-white hover:bg-white/5">
                  <div class="flex items-center gap-3">
                    <span class="text-base">🗑️</span>
                    <span>Papelera</span>
                  </div>
                </button>
              </nav>

              <!-- Quick Tag Filters -->
              <div class="pt-4 border-t border-white/10 space-y-2">
                <div class="text-[10px] font-mono uppercase tracking-wider text-neutral-500 font-bold px-2">Etiquetas de Carrera</div>
                <div class="flex flex-col gap-1 text-xs">
                  <button data-tag="strategy" class="tag-filter text-left px-3 py-1.5 rounded-lg text-neutral-400 hover:text-white hover:bg-white/5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                    <span>Estrategia &amp; Stints</span>
                  </button>
                  <button data-tag="telemetry" class="tag-filter text-left px-3 py-1.5 rounded-lg text-neutral-400 hover:text-white hover:bg-white/5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <span>Telemetría MoTeC</span>
                  </button>
                  <button data-tag="governance" class="tag-filter text-left px-3 py-1.5 rounded-lg text-neutral-400 hover:text-white hover:bg-white/5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                    <span>Comisarios &amp; Reglas</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Sidebar Bottom: Storage Meter & Edge Relay -->
            <div class="p-4 bg-[#0e1217] border-t border-white/10 space-y-3">
              <div class="flex justify-between items-center text-[10px] font-mono text-neutral-400">
                <span>Almacenamiento Vault</span>
                <span class="text-emerald-400 font-bold">1.4 GB / 15 GB</span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" style="width: 12%;"></div>
              </div>
              <div class="pt-1 flex items-center justify-between text-[10px] font-mono text-neutral-500">
                <span class="flex items-center gap-1 text-emerald-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  Relay Online
                </span>
                <span id="brevo-badge" class="px-1.5 py-0.5 rounded bg-white/5 text-neutral-400">Brevo v3</span>
              </div>
            </div>
          </aside>

          <!-- MAIN WORKSPACE: EMAIL LIST / EMAIL DETAIL -->
          <main class="flex-1 flex flex-col bg-[#0e1217] overflow-hidden min-w-0">
            
            <!-- FILTER TABS & BULK ACTIONS STRIP -->
            <div class="px-4 py-2.5 bg-[#141a23] border-b border-white/10 flex flex-wrap items-center justify-between gap-3 text-xs">
              
              <!-- Tab Pills -->
              <div class="flex items-center gap-1.5" id="category-tabs">
                <button data-filter="all" class="category-pill active px-3 py-1.5 rounded-lg font-bold text-xs bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                  Todos
                </button>
                <button data-filter="unread" class="category-pill px-3 py-1.5 rounded-lg font-medium text-xs text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent">
                  No leídos
                </button>
                <button data-filter="has_setup" class="category-pill px-3 py-1.5 rounded-lg font-medium text-xs text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent flex items-center gap-1.5">
                  <span>Con Setups</span>
                  <span class="px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-400 text-[10px] font-mono">.sto</span>
                </button>
                <button data-filter="starred" class="category-pill px-3 py-1.5 rounded-lg font-medium text-xs text-neutral-400 hover:text-white hover:bg-white/5 border border-transparent">
                  ⭐ Destacados
                </button>
              </div>

              <!-- Message Counter -->
              <div class="text-[11px] font-mono text-neutral-400 flex items-center gap-2">
                <span id="list-status-text">Cargando buzón...</span>
              </div>
            </div>

            <!-- EMAIL LIST VIEW (GMAIL ROWS) -->
            <div id="email-list-container" class="flex-1 overflow-y-auto divide-y divide-white/5">
              <!-- Dynamically populated rows -->
            </div>

            <!-- EMAIL DETAIL READING PANE (HIDDEN BY DEFAULT) -->
            <div id="email-detail-container" class="flex-1 overflow-y-auto hidden flex-col p-4 sm:p-6 bg-[#0e1217]">
              <!-- Toolbar back button -->
              <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10">
                <button id="back-to-list-btn" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-bold text-neutral-300 hover:text-white transition">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                  <span>Volver a la bandeja</span>
                </button>

                <div class="flex items-center gap-2">
                  <button id="detail-star-btn" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 text-neutral-400 hover:text-amber-400 transition" title="Destacar">
                    ⭐
                  </button>
                  <button id="detail-delete-btn" class="p-2 rounded-xl bg-white/5 hover:bg-red-500/20 text-neutral-400 hover:text-red-400 transition" title="Mover a papelera">
                    🗑️
                  </button>
                  <button id="detail-reply-top-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 text-emerald-400 text-xs font-bold transition">
                    <span>↩️ Responder</span>
                  </button>
                </div>
              </div>

              <!-- Detail Header -->
              <div class="space-y-4 mb-6">
                <div class="flex flex-wrap items-center gap-2" id="detail-tags">
                  <!-- Badges inserted here -->
                </div>

                <h2 id="detail-subject" class="text-xl sm:text-2xl font-black text-white tracking-tight">
                  <!-- Subject inserted here -->
                </h2>

                <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl bg-[#161c24] border border-white/10">
                  <div class="flex items-center gap-3">
                    <div id="detail-avatar" class="w-11 h-11 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center font-bold text-emerald-400 text-sm">
                      --
                    </div>
                    <div>
                      <div class="flex items-center gap-2">
                        <span id="detail-sender-name" class="font-bold text-sm text-white"></span>
                        <span id="detail-sender-email" class="text-xs font-mono text-emerald-400"></span>
                        <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-[9px] font-bold">
                          ✓ DKIM Verified
                        </span>
                      </div>
                      <div class="text-[11px] text-neutral-400 font-mono mt-0.5">
                        Para: <span id="detail-recipients" class="text-neutral-300"></span>
                      </div>
                    </div>
                  </div>

                  <div class="text-right">
                    <div id="detail-date" class="text-xs font-mono text-neutral-400"></div>
                    <div class="text-[10px] font-mono text-neutral-500 mt-0.5">Cifrado TLS 1.3 / Brevo SMTP Relay</div>
                  </div>
                </div>
              </div>

              <!-- Message Body -->
              <div id="detail-body" class="p-6 rounded-2xl bg-[#131922] border border-white/10 text-neutral-200 text-sm leading-relaxed space-y-4 font-sans whitespace-pre-line mb-6">
                <!-- Rich body text -->
              </div>

              <!-- Attachment Card (if present) -->
              <div id="detail-attachment-box" class="hidden mb-6 p-4 rounded-2xl bg-[#161c24] border border-amber-500/30 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-xl font-mono font-bold">
                    ⚙️
                  </div>
                  <div>
                    <div id="attachment-name" class="text-xs font-bold text-white font-mono">setup_spa_v3.sto</div>
                    <div id="attachment-meta" class="text-[11px] text-neutral-400">Archivo de Setup Oficial Assetto Corsa Competizione / iRacing · 14 KB</div>
                  </div>
                </div>
                <button id="download-setup-btn" class="px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                  <span>Descargar .STO</span>
                </button>
              </div>

              <!-- Reply Action Box -->
              <div class="p-4 rounded-2xl bg-[#141a23] border border-white/10 flex items-center justify-between">
                <div class="text-xs text-neutral-400">
                  ¿Deseas enviar telemetría de respuesta o notas de ingeniero?
                </div>
                <button id="detail-reply-bottom-btn" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold text-xs uppercase tracking-wider transition flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/></svg>
                  <span>Responder a este correo</span>
                </button>
              </div>

            </div>

          </main>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. FLOATING GMAIL COMPOSE MODAL (BOTTOM-RIGHT)                             -->
  <!-- ========================================================================= -->
  <div id="compose-modal" class="hidden fixed bottom-4 right-4 sm:right-6 w-[94vw] sm:w-[540px] max-w-[94vw] bg-[#161c24] border border-emerald-500/40 rounded-2xl shadow-2xl z-50 overflow-hidden flex-col">
    <!-- Compose Header -->
    <div class="px-4 py-3 bg-[#1c2430] border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        <span class="font-bold text-xs text-white uppercase tracking-wider">Nuevo Mensaje de Carrera</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="close-compose-btn" class="p-1 rounded-lg text-neutral-400 hover:text-white transition" title="Cerrar">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Compose Form -->
    <form id="compose-form" class="p-4 space-y-3 flex-1 flex flex-col">
      <!-- Sender selection -->
      <div class="flex items-center gap-2 text-xs border-b border-white/5 pb-2">
        <span class="text-neutral-400 w-12 font-mono">De:</span>
        <select id="compose-from" class="flex-1 bg-transparent text-emerald-400 font-bold focus:outline-none cursor-pointer">
          <option value="alberto@muntru.me">Alberto Trujillo &lt;alberto@muntru.me&gt;</option>
          <option value="mateo@muntru.me">Mateo Berbis &lt;mateo@muntru.me&gt;</option>
          <option value="eduardo@muntru.me">Eduardo Chongkan &lt;eduardo@muntru.me&gt;</option>
          <option value="juanlu@muntru.me">Juanlu Carrillo &lt;juanlu@muntru.me&gt;</option>
          <option value="admin@muntru.me">Race Control &lt;admin@muntru.me&gt;</option>
        </select>
      </div>

      <!-- Recipient (Para) with quick chips -->
      <div class="space-y-1.5 border-b border-white/5 pb-2">
        <div class="flex items-center gap-2 text-xs">
          <span class="text-neutral-400 w-12 font-mono">Para:</span>
          <input 
            type="email" 
            id="compose-to" 
            required 
            placeholder="destinatario@muntru.me o email externo" 
            class="flex-1 bg-transparent text-white placeholder-neutral-500 focus:outline-none font-mono text-xs"
          />
        </div>
        <!-- Quick recipient chips -->
        <div class="flex flex-wrap gap-1 pl-14">
