    categoryPills.forEach(pill => {
      pill.addEventListener("click", () => {
        categoryPills.forEach(p => p.classList.remove("active"));
        pill.classList.add("active");
        currentFilter = pill.dataset.filter;
        renderMailList();
      });
    });

    // Pilot Sidebar Quick Filter Buttons
    document.querySelectorAll(".pilot-filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const pilotEmail = btn.dataset.pilotEmail;
        activeMailbox = pilotEmail;
        localStorage.setItem(LS_ACTIVE_ACCOUNT, activeMailbox);
        if (driverSelector) driverSelector.value = pilotEmail;
        if (composeFrom) composeFrom.value = pilotEmail;
        showToast(`Buzón activo: ${pilotEmail}`);
        closeMobileSidebar();
        backToList();
      });
    });

    // Search Input and Clear
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value.trim();
        if (clearSearchBtn) {
          if (searchQuery) clearSearchBtn.classList.remove("hidden");
          else clearSearchBtn.classList.add("hidden");
        }
        renderMailList();
      });
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        searchQuery = "";
        clearSearchBtn.classList.add("hidden");
        renderMailList();
      });
    }

    const refreshBtn = document.getElementById("refresh-mailbox-btn");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", () => {
        refreshBtn.classList.add("animate-spin");
        setTimeout(() => {
          refreshBtn.classList.remove("animate-spin");
          renderMailList();
          showToast("Buzón sincronizado con Cloudflare Relay");
        }, 400);
      });
    }

    if (driverSelector) {
      driverSelector.addEventListener("change", (e) => {
        const val = e.target.value;
        activeMailbox = val;
        localStorage.setItem(LS_ACTIVE_ACCOUNT, activeMailbox);
        if (composeFrom && val !== "all") composeFrom.value = val;
        showToast(`Buzón activo: ${val === "all" ? "Todos los buzones" : val}`);
        backToList();
      });
    }

    // =========================================================================
    // DIRECTORY MODAL
    // =========================================================================
    if (openDirectoryBtn && directoryModal) {
      openDirectoryBtn.addEventListener("click", () => {
        directoryModal.classList.remove("hidden");
      });
    }

    if (closeDirectoryModalBtn && directoryModal) {
      closeDirectoryModalBtn.addEventListener("click", () => {
        directoryModal.classList.add("hidden");
      });
    }

    document.querySelectorAll(".quick-compose-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const targetEmail = btn.dataset.quickCompose;
        if (directoryModal) directoryModal.classList.add("hidden");
        openComposeModal({ to: targetEmail });
      });
    });

    // =========================================================================
    // COMPOSE MODAL LOGIC & BREVO / CLOUDFLARE SUBMISSION
    // =========================================================================
    function openComposeModal(prefill = {}) {
      if (!composeModal) return;
      composeModal.classList.remove("hidden");
      composeModal.classList.add("flex");

      if (prefill.to && composeTo) composeTo.value = prefill.to;
      if (prefill.subject && composeSubject) composeSubject.value = prefill.subject;
      if (prefill.body && composeBody) {
        composeBody.value = prefill.body;
        composeBody.focus();
      } else if (composeTo) {
        composeTo.focus();
      }
    }

    function closeComposeModal() {
      if (!composeModal) return;
      composeModal.classList.add("hidden");
      composeModal.classList.remove("flex");
      if (composeForm) composeForm.reset();
      if (composeFileName) composeFileName.textContent = "Ninguno";
    }

    const openComposeBtn = document.getElementById("open-compose-btn");
    const openComposeHeaderBtn = document.getElementById("open-compose-header-btn");
    const closeComposeBtn = document.getElementById("close-compose-btn");
    const discardComposeBtn = document.getElementById("discard-compose-btn");

    if (openComposeBtn) openComposeBtn.addEventListener("click", () => {
      closeMobileSidebar();
      openComposeModal();
    });
    if (openComposeHeaderBtn) openComposeHeaderBtn.addEventListener("click", () => openComposeModal());
    if (closeComposeBtn) closeComposeBtn.addEventListener("click", closeComposeModal);
    if (discardComposeBtn) discardComposeBtn.addEventListener("click", closeComposeModal);

    document.querySelectorAll(".driver-chip").forEach(chip => {
      chip.addEventListener("click", () => {
        if (composeTo) composeTo.value = chip.dataset.chip;
      });
    });

    if (composeFileInput && composeFileName) {
      composeFileInput.addEventListener("change", (e) => {
        if (e.target.files && e.target.files[0]) {
          composeFileName.textContent = e.target.files[0].name;
          composeFileName.classList.add("text-emerald-400");
        } else {
          composeFileName.textContent = "Ninguno";
          composeFileName.classList.remove("text-emerald-400");
        }
      });
    }

    if (composeForm) {
      composeForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const fromEmail = composeFrom ? composeFrom.value : "alberto@muntru.me";
        const toEmail = composeTo ? composeTo.value.trim() : "";
        const subject = composeSubject ? composeSubject.value.trim() : "";
        const bodyContent = composeBody ? composeBody.value.trim() : "";

        if (!toEmail || !subject || !bodyContent) {
          showToast("Por favor completa destinatario, asunto y mensaje", false);
          return;
        }

        if (sendBtnSpinner) sendBtnSpinner.classList.remove("hidden");
        if (sendBtnText) sendBtnText.textContent = "Enviando...";
        if (sendMailSubmitBtn) sendMailSubmitBtn.disabled = true;

        const brevoKey = localStorage.getItem(LS_BREVO_KEY) || "";
        let sentSuccessfully = false;

        try {
          if (brevoKey) {
            // Direct Brevo REST API v3 dispatch
            const res = await fetch("https://api.brevo.com/v3/smtp/email", {
              method: "POST",
              headers: {
                "api-key": brevoKey,
                "Content-Type": "application/json",
                "accept": "application/json"
              },
              body: JSON.stringify({
                sender: {
                  name: `Muntrume Motorsport (${fromEmail.split("@")[0]})`,
                  email: fromEmail
                },
                to: [{ email: toEmail }],
                subject: subject,
                textContent: bodyContent
              })
            });

            if (res.ok) {
              sentSuccessfully = true;
            }
          }
        } catch (err) {
          console.warn("Brevo API error, recording to sent mailbox:", err);
        }

        // Record message in sent folder
        const sentMessage = {
          id: "sent-" + Date.now(),
          folder: "sent",
          is_briefing: subject.toLowerCase().includes("briefing") || subject.toLowerCase().includes("setup"),
          unread: false,
          starred: false,
          account: fromEmail,
          sender: {
            name: fromEmail.split("@")[0].toUpperCase(),
            email: fromEmail,
            initials: fromEmail.substring(0, 2).toUpperCase(),
            role: "Driver / Team"
          },
          recipients: toEmail,
          subject: subject,
          snippet: bodyContent.substring(0, 80) + "...",
          body: bodyContent,
          date: "Ahora",
          timestamp: Date.now(),
          tags: ["Enviado"],
          attachment: composeFileName && composeFileName.textContent !== "Ninguno" ? {
            name: composeFileName.textContent,
            type: "setup",
            size: "12 KB"
          } : null
        };

        messages.unshift(sentMessage);
        saveMessages();
        closeComposeModal();

        if (sendBtnSpinner) sendBtnSpinner.classList.add("hidden");
        if (sendBtnText) sendBtnText.textContent = "Enviar";
        if (sendMailSubmitBtn) sendMailSubmitBtn.disabled = false;

        if (sentSuccessfully) {
          showToast("Correo enviado con éxito vía Brevo SMTP");
        } else {
          showToast("Mensaje registrado y archivado en Enviados");
        }

        updateCounters();
        if (currentFolder === "sent") renderMailList();
      });
    }

    // =========================================================================
    // BREVO SETTINGS MODAL
    // =========================================================================
    const openSettingsBtn = document.getElementById("open-settings-btn");
    const closeSettingsBtn = document.getElementById("close-settings-modal-btn");

    if (openSettingsBtn && settingsModal) {
      openSettingsBtn.addEventListener("click", () => {
        settingsModal.classList.remove("hidden");
        if (brevoApiKeyInput) {
          brevoApiKeyInput.value = localStorage.getItem(LS_BREVO_KEY) || "";
        }
      });
    }

    if (closeSettingsBtn && settingsModal) {
      closeSettingsBtn.addEventListener("click", () => {
        settingsModal.classList.add("hidden");
      });
    }

    if (saveSettingsBtn && brevoApiKeyInput) {
      saveSettingsBtn.addEventListener("click", () => {
        const key = brevoApiKeyInput.value.trim();
        if (key) {
          localStorage.setItem(LS_BREVO_KEY, key);
          showToast("Clave de Brevo API guardada");
        } else {
          localStorage.removeItem(LS_BREVO_KEY);
          showToast("Clave removida (usando Cloudflare Relay)");
        }
        if (settingsModal) settingsModal.classList.add("hidden");
      });
    }

    if (testBrevoBtn) {
      testBrevoBtn.addEventListener("click", async () => {
        const key = brevoApiKeyInput ? brevoApiKeyInput.value.trim() : "";
        if (!key) {
          showToast("Introduce una clave Brevo (xkeysib-...) para probar", false);
          return;
        }
        testBrevoBtn.textContent = "Probando...";
        try {
          const res = await fetch("https://api.brevo.com/v3/account", {
            headers: {
              "api-key": key,
              "accept": "application/json"
            }
          });
          if (res.ok) {
            const acc = await res.json();
            showToast(`Conectado a Brevo: ${acc.email}`);
          } else {
            showToast("Clave no válida en Brevo API", false);
          }
        } catch (e) {
          showToast("Error de conexión con Brevo API", false);
        } finally {
          testBrevoBtn.textContent = "Probar Conexión";
        }
      });
    }

    // Initial render
    renderMailList();
  })();
</script>
