    // Show Toast Function
    function showToast(msg, isSuccess = true) {
      if (!toast) return;
      toastIcon.textContent = isSuccess ? "✓" : "⚠️";
      toastMessage.textContent = msg;
      toast.classList.remove("opacity-0", "translate-y-4");
      toast.classList.add("opacity-100", "translate-y-0");
      setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "translate-y-4");
      }, 3500);
    }

    // Matches message with active mailbox
    function matchesActiveMailbox(msg) {
      if (activeMailbox === "all") return true;
      if (msg.account === "all") return true;
      if (msg.account && msg.account === activeMailbox) return true;
      if (msg.sender && msg.sender.email === activeMailbox) return true;
      if (msg.recipients && (msg.recipients.includes(activeMailbox) || msg.recipients.toLowerCase().includes("todos"))) return true;

      // Cruce de piloto (ej. 'alberto' coincide con alberto@muntru.me y alberto.muntrume@trujillomingorance.com)
      const actPrefix = activeMailbox.split("@")[0].split(".")[0].toLowerCase();
      const accPrefix = (msg.account || "").split("@")[0].split(".")[0].toLowerCase();
      const sndPrefix = (msg.sender?.email || "").split("@")[0].split(".")[0].toLowerCase();
      if (actPrefix && (actPrefix === accPrefix || actPrefix === sndPrefix)) return true;
      return false;
    }

    // Update Counters
        // Helper: Team Colors for Pilot Initials
    function getPilotColor(email) {
      const e = (email || "").toLowerCase();
      if (e.includes("alberto")) return { bg: "bg-emerald-500/15", border: "border-emerald-500/35", text: "text-emerald-400" };
      if (e.includes("mateo")) return { bg: "bg-amber-500/15", border: "border-amber-500/35", text: "text-amber-400" };
      if (e.includes("eduardo")) return { bg: "bg-cyan-500/15", border: "border-cyan-500/35", text: "text-cyan-400" };
      if (e.includes("juanlu")) return { bg: "bg-orange-500/15", border: "border-orange-500/35", text: "text-orange-400" };
      if (e.includes("admin")) return { bg: "bg-purple-500/15", border: "border-purple-500/35", text: "text-purple-400" };
      return { bg: "bg-white/10", border: "border-white/20", text: "text-neutral-300" };
    }

    function updateCounters() {
      const activeMsgs = messages.filter(matchesActiveMailbox);

      const unreadCount = activeMsgs.filter(m => m.folder === "inbox" && m.unread).length;
      const briefingsCount = activeMsgs.filter(m => m.is_briefing && m.folder !== "trash").length;
      const starCount = activeMsgs.filter(m => m.starred && m.folder !== "trash").length;
      const sentCount = activeMsgs.filter(m => m.folder === "sent").length;
      const draftsCount = activeMsgs.filter(m => m.folder === "drafts").length;

      if (unreadCounter) unreadCounter.textContent = unreadCount;
      if (briefingsCounter) briefingsCounter.textContent = briefingsCount;
      if (starredCounter) starredCounter.textContent = starCount;
      if (sentCounter) sentCounter.textContent = sentCount;
      if (draftsCounter) draftsCounter.textContent = draftsCount;
    }

    // Filter and Render Mail List
    function renderMailList() {
      updateCounters();

      // Filter messages
      let filtered = messages.filter(m => {
        // Mailbox account check
        if (!matchesActiveMailbox(m)) return false;

        // Folder check
        if (currentFolder === "starred") {
          if (!m.starred || m.folder === "trash") return false;
        } else if (currentFolder === "briefings") {
          if (!m.is_briefing || m.folder === "trash") return false;
        } else {
          if (m.folder !== currentFolder) return false;
        }

        // Category filter pills
        if (currentFilter === "unread" && !m.unread) return false;
        if (currentFilter === "has_setup" && (!m.attachment || !m.attachment.name.endsWith(".sto"))) return false;
        if (currentFilter === "starred" && !m.starred) return false;

        // Search Query
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchSub = (m.subject || "").toLowerCase().includes(q);
          const matchBody = (m.body || "").toLowerCase().includes(q);
          const matchSender = (m.sender.name || "").toLowerCase().includes(q) || (m.sender.email || "").toLowerCase().includes(q);
          const matchAttach = m.attachment && m.attachment.name.toLowerCase().includes(q);
          if (!matchSub && !matchBody && !matchSender && !matchAttach) return false;
        }

        return true;
      });

      // Sort by timestamp desc
      filtered.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

      if (listStatusText) {
        listStatusText.textContent = `${filtered.length} mensaje${filtered.length === 1 ? '' : 's'}`;
      }

      if (!emailListContainer) return;

      if (filtered.length === 0) {
        emailListContainer.innerHTML = `
          <div class="py-20 px-4 text-center space-y-3">
            <div class="text-4xl">📬</div>
            <div class="text-white font-bold text-sm">No hay mensajes en esta vista</div>
            <p class="text-neutral-500 text-xs max-w-sm mx-auto">No se encontraron correos para el buzón activo con los filtros seleccionados.</p>
          </div>
        `;
        return;
      }

      let html = "";
      filtered.forEach(msg => {
        const isUnread = msg.unread ? "unread font-bold text-white" : "text-neutral-300";
        const pilotTheme = getPilotColor(msg.sender.email);
        const unreadIndicator = msg.unread ? `<span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0"></span>` : "";
        const isStarred = msg.starred ? "text-amber-400" : "text-neutral-600 hover:text-neutral-400";
        const hasSetup = msg.attachment ? `
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-mono shrink-0">
            <span>⚙️</span>
            <span>${msg.attachment.name.endsWith(".sto") ? ".STO" : "FILE"}</span>
          </span>
        ` : "";

        html += `
          <div class="mail-row ${msg.unread ? 'unread' : ''} p-3 sm:px-5 sm:py-3 cursor-pointer select-none" data-msg-id="${msg.id}">
            
            <!-- DESKTOP ROW (md+) -->
            <div class="mail-row-desktop">
              <!-- Star Toggle -->
              <button class="star-toggle cursor-pointer p-1 text-sm ${isStarred} transition shrink-0" data-star-id="${msg.id}" title="Destacar">
                ★
              </button>

              ${unreadIndicator}

              <!-- Sender Avatar with Pilot Identity Colors -->
              <div class="w-8 h-8 rounded-xl ${pilotTheme.bg} border ${pilotTheme.border} flex items-center justify-center font-bold ${pilotTheme.text} text-xs shrink-0 font-mono">
                ${msg.sender.initials || "MU"}
              </div>

              <!-- Sender Name -->
              <div class="w-36 truncate text-xs ${isUnread} shrink-0">
                ${msg.sender.name}
              </div>

              <!-- Subject & Snippet -->
              <div class="flex-1 min-w-0 flex items-center gap-2 overflow-hidden">
                <span class="truncate text-xs ${msg.unread ? 'font-bold text-white' : 'text-neutral-200'}">
                  ${msg.subject}
                </span>
                <span class="text-neutral-400 text-xs truncate max-w-sm">
                  - ${msg.snippet}
                </span>
                ${hasSetup}
              </div>

              <!-- Date -->
              <div class="text-[11px] font-mono text-neutral-400 shrink-0 text-right w-20">
                ${msg.date}
              </div>
            </div>

            <!-- MOBILE ROW (< md) -->
            <div class="mail-row-mobile space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <button class="star-toggle text-sm ${isStarred} shrink-0" data-star-id="${msg.id}">
                    ★
                  </button>
                  ${unreadIndicator}
                  <div class="w-6 h-6 rounded-lg ${pilotTheme.bg} border ${pilotTheme.border} flex items-center justify-center font-bold ${pilotTheme.text} text-[10px] shrink-0 font-mono">
                    ${msg.sender.initials || "MU"}
                  </div>
                  <span class="text-xs font-bold text-white truncate">
                    ${msg.sender.name}
                  </span>
                </div>
                
                <div class="flex items-center gap-1.5 shrink-0">
                  ${hasSetup}
                  <span class="text-[10px] font-mono text-neutral-400">
                    ${msg.date}
                  </span>
                </div>
              </div>

              <div class="text-xs ${msg.unread ? 'font-bold text-white' : 'text-neutral-300'} truncate pl-6">
                ${msg.subject}
              </div>
            </div>

          </div>
        `;
      });

      emailListContainer.innerHTML = html;

      // Attach row click listeners
      emailListContainer.querySelectorAll(".mail-row").forEach(row => {
        row.addEventListener("click", (e) => {
          if (e.target.closest(".star-toggle")) {
            const id = e.target.closest(".star-toggle").dataset.starId;
            toggleStar(id);
            return;
          }
          const msgId = row.dataset.msgId;
          openMessageDetail(msgId);
        });
      });
    }

    // Toggle Star
    function toggleStar(id) {
      const msg = messages.find(m => m.id === id);
      if (msg) {
        msg.starred = !msg.starred;
        saveMessages();
        renderMailList();
      }
    }

    // Open Message Detail View
    function openMessageDetail(id) {
      const msg = messages.find(m => m.id === id);
      if (!msg) return;

      activeMessageId = id;

      if (msg.unread) {
        msg.unread = false;
        saveMessages();
        updateCounters();
      }

      const detailSubject = document.getElementById("detail-subject");
      const detailSenderName = document.getElementById("detail-sender-name");
      const detailSenderEmail = document.getElementById("detail-sender-email");
      const detailAvatar = document.getElementById("detail-avatar");
      const detailRecipients = document.getElementById("detail-recipients");
      const detailDate = document.getElementById("detail-date");
      const detailBody = document.getElementById("detail-body");
      const detailTags = document.getElementById("detail-tags");
      const detailAttachmentBox = document.getElementById("detail-attachment-box");
      const attachmentName = document.getElementById("attachment-name");
      const attachmentMeta = document.getElementById("attachment-meta");
      const detailStarBtn = document.getElementById("detail-star-btn");

      if (detailSubject) detailSubject.textContent = msg.subject;
      if (detailSenderName) detailSenderName.textContent = msg.sender.name;
      if (detailSenderEmail) detailSenderEmail.textContent = `<${msg.sender.email}>`;
      if (detailAvatar) {
        detailAvatar.textContent = msg.sender.initials || "MU";
        const pCol = getPilotColor(msg.sender.email);
        detailAvatar.className = `w-11 h-11 rounded-2xl ${pCol.bg} border ${pCol.border} flex items-center justify-center font-bold ${pCol.text} text-sm shrink-0 font-mono`;
      }

      // Configure Inline Quick Reply Target and Active Sender
      const inlineReplyTarget = document.getElementById("inline-reply-target");
      const inlineReplySender = document.getElementById("inline-reply-sender");
      const inlineReplyBody = document.getElementById("inline-reply-body");
      if (inlineReplyTarget) inlineReplyTarget.textContent = `${msg.sender.name} <${msg.sender.email}>`;
      if (inlineReplySender) {
        const verifiedSender = (composeFrom && composeFrom.value) ? composeFrom.value : "alberto.muntrume@trujillomingorance.com";
        inlineReplySender.textContent = verifiedSender;
      }
      if (inlineReplyBody) inlineReplyBody.value = "";
      if (detailRecipients) detailRecipients.textContent = msg.recipients;
      if (detailDate) detailDate.textContent = msg.date;
      if (detailBody) {
        const raw = String(msg.body || "");
        const lines = raw.split("\n");
        let htmlOut = "";
        let inQuote = false;
        lines.forEach(l => {
          const trimmed = l.trim();
          if (trimmed.startsWith(">") || /^(El|On|El mar|El lun|El mié|El jue|El vie|El sáb|El dom) .+ (escribió|wrote):/i.test(trimmed)) {
            if (!inQuote) {
              htmlOut += '<div class="pl-3.5 my-2.5 border-l-2 border-emerald-500/40 text-neutral-400 text-xs italic bg-white/[0.02] py-2 px-2 rounded-r-lg font-mono leading-relaxed">';
              inQuote = true;
            }
            htmlOut += escMail(l) + "<br>";
          } else {
            if (inQuote) {
              htmlOut += '</div>';
              inQuote = false;
            }
            htmlOut += escMail(l) + "<br>";
          }
        });
        if (inQuote) htmlOut += '</div>';
        detailBody.innerHTML = htmlOut || "<span class='text-neutral-500'>(Mensaje vacío)</span>";
      }

      if (detailStarBtn) {
        detailStarBtn.textContent = msg.starred ? "⭐ Destacado" : "☆ Destacar";
      }

      if (detailTags) {
        let tagHtml = "";
        if (msg.tags && msg.tags.length > 0) {
          msg.tags.forEach(t => {
            tagHtml += `<span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">${t}</span>`;
          });
        }
        detailTags.innerHTML = tagHtml;
      }

      if (msg.attachment && detailAttachmentBox) {
        detailAttachmentBox.classList.remove("hidden");
        if (attachmentName) attachmentName.textContent = msg.attachment.name;
        if (attachmentMeta) attachmentMeta.textContent = `Archivo oficial de Telemetría/Setup · Tamaño: ${msg.attachment.size || '12 KB'}`;
      } else if (detailAttachmentBox) {
        detailAttachmentBox.classList.add("hidden");
      }

      if (emailListContainer) emailListContainer.classList.add("hidden");
      if (emailDetailContainer) {
        emailDetailContainer.classList.remove("hidden");
        emailDetailContainer.classList.add("flex");
      }
    }

    // Back to list view
    function backToList() {
      activeMessageId = null;
      if (emailDetailContainer) {
        emailDetailContainer.classList.add("hidden");
        emailDetailContainer.classList.remove("flex");
      }
      if (emailListContainer) {
        emailListContainer.classList.remove("hidden");
      }
      renderMailList();
    }

    const backBtn = document.getElementById("back-to-list-btn");
    if (backBtn) backBtn.addEventListener("click", backToList);

    const detailStarBtn = document.getElementById("detail-star-btn");
    if (detailStarBtn) {
      detailStarBtn.addEventListener("click", () => {
        if (activeMessageId) {
          toggleStar(activeMessageId);
          const msg = messages.find(m => m.id === activeMessageId);
          if (msg && detailStarBtn) {
            detailStarBtn.textContent = msg.starred ? "⭐ Destacado" : "☆ Destacar";
          }
        }
      });
    }

    const detailDeleteBtn = document.getElementById("detail-delete-btn");
    if (detailDeleteBtn) {
      detailDeleteBtn.addEventListener("click", () => {
        if (!activeMessageId) return;
        const msg = messages.find(m => m.id === activeMessageId);
        if (msg) {
          msg.folder = "trash";
          saveMessages();
          showToast("Mensaje movido a Papelera");
          backToList();
        }
      });
    }

    // Reply handlers
    function setupReply() {
      if (!activeMessageId) return;
      const msg = messages.find(m => m.id === activeMessageId);
      if (!msg) return;

      openComposeModal({
        to: msg.sender.email,
        subject: msg.subject.startsWith("Re:") ? msg.subject : `Re: ${msg.subject}`,
        body: `\n\n--- El ${msg.date}, ${msg.sender.name} escribió:\n> ` + (msg.body || "").replace(/\n/g, "\n> ")
      });
    }

    const replyTopBtn = document.getElementById("detail-reply-top-btn");
    const replyBottomBtn = document.getElementById("detail-reply-bottom-btn");
    if (replyTopBtn) replyTopBtn.addEventListener("click", setupReply);
    if (replyBottomBtn) replyBottomBtn.addEventListener("click", setupReply);

        // =========================================================================
    // INLINE QUICK REPLY & COMPOSE PRESETS CONTROLLER
    // =========================================================================
    // 1. Compose Modal Subject Presets
    document.querySelectorAll(".subject-preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const prefix = btn.dataset.prefix;
        if (composeSubject) {
          const current = composeSubject.value.trim();
          if (!current.includes(prefix)) {
            composeSubject.value = prefix + current;
          }
          composeSubject.focus();
        }
      });
    });

    // 2. Inline Reply Template Presets
    document.querySelectorAll(".reply-preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const text = btn.dataset.text;
        const inlineReplyBody = document.getElementById("inline-reply-body");
        if (inlineReplyBody) {
          const current = inlineReplyBody.value.trim();
          if (current) {
            inlineReplyBody.value = current + "\n" + text;
          } else {
            inlineReplyBody.value = text;
          }
          inlineReplyBody.focus();
        }
      });
    });

    // 3. Inline Reply Popout (Expand to Full Modal)
    const inlineReplyPopoutBtn = document.getElementById("inline-reply-popout-btn");
    if (inlineReplyPopoutBtn) {
      inlineReplyPopoutBtn.addEventListener("click", () => {
        if (!activeMessageId) return;
        const msg = messages.find(m => m.id === activeMessageId);
        if (!msg) return;
        const inlineReplyBody = document.getElementById("inline-reply-body");
        const replyText = inlineReplyBody ? inlineReplyBody.value.trim() : "";
        openComposeModal({
          to: msg.sender.email,
          subject: msg.subject.startsWith("Re:") ? msg.subject : `Re: ${msg.subject}`,
          body: replyText || `\n\n--- El ${msg.date}, ${msg.sender.name} escribió:\n> ` + (msg.body || "").replace(/\n/g, "\n> ")
        });
      });
    }

    // 4. Inline Reply Direct Send
    const inlineReplySendBtn = document.getElementById("inline-reply-send-btn");
    if (inlineReplySendBtn) {
      inlineReplySendBtn.addEventListener("click", async () => {
        if (!activeMessageId) return;
        const msg = messages.find(m => m.id === activeMessageId);
        if (!msg) return;

        const inlineReplyBody = document.getElementById("inline-reply-body");
        const bodyContent = inlineReplyBody ? inlineReplyBody.value.trim() : "";
        if (!bodyContent) {
          showToast("Escribe un mensaje de respuesta antes de enviar", false);
          if (inlineReplyBody) inlineReplyBody.focus();
          return;
        }

        const inlineReplySpinner = document.getElementById("inline-reply-spinner");
        const inlineReplySendText = document.getElementById("inline-reply-send-text");
        const fromEmail = (composeFrom && composeFrom.value) ? composeFrom.value : "alberto.muntrume@trujillomingorance.com";
        const toEmail = msg.sender.email;
        const subject = msg.subject.startsWith("Re:") ? msg.subject : `Re: ${msg.subject}`;

        if (inlineReplySpinner) inlineReplySpinner.classList.remove("hidden");
        if (inlineReplySendText) inlineReplySendText.textContent = "Despachando...";
        inlineReplySendBtn.disabled = true;

        let sentLive = false;
        let relayDetail = "Resend Relay";

        try {
          const workerRes = await fetch("https://muntrume.atrumin16.workers.dev/api/mail/send", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              from: fromEmail,
              fromName: `${fromEmail.split("@")[0].toUpperCase()} · Muntrume Motorsport`,
              to: toEmail,
              subject: subject,
              body: bodyContent
            })
          });

          const workerData = await workerRes.json().catch(() => ({}));
          if (workerRes.ok && workerData.success) {
            sentLive = true;
            relayDetail = workerData.provider || "Resend Relay";
          }
        } catch (err) {
          console.warn("Error enviando respuesta mediante Cloudflare Worker:", err);
        }

        // Add to sent messages archive
        const sentMessage = {
          id: "sent-" + Date.now(),
          folder: "sent",
          is_briefing: subject.toLowerCase().includes("briefing") || subject.toLowerCase().includes("setup"),
          unread: false,
          starred: false,
          account: fromEmail,
          sender: {
            name: fromEmail.split("@")[0].toUpperCase(),
            email: fromEmail,
            initials: fromEmail.substring(0, 2).toUpperCase(),
            role: "Driver / Team"
          },
          recipients: toEmail,
          subject: subject,
          snippet: bodyContent.substring(0, 80) + "...",
          body: bodyContent,
          date: "Ahora",
          timestamp: Date.now(),
          tags: ["Respuesta", "Enviado"],
          attachment: null
        };

        messages.unshift(sentMessage);
        saveMessages();

        if (inlineReplyBody) inlineReplyBody.value = "";
        if (inlineReplySpinner) inlineReplySpinner.classList.add("hidden");
        if (inlineReplySendText) inlineReplySendText.textContent = "Enviar Respuesta";
        inlineReplySendBtn.disabled = false;

        if (sentLive) {
          showToast(`✓ Respuesta oficial enviada a ${toEmail} vía ${relayDetail}`);
        } else {
          showToast("Respuesta registrada y archivada en Enviados");
        }
        updateCounters();
      });
    }

    // Download simulated .sto setup file
    const downloadSetupBtn = document.getElementById("download-setup-btn");
    if (downloadSetupBtn) {
      downloadSetupBtn.addEventListener("click", () => {
        const msg = messages.find(m => m.id === activeMessageId);
        const fileName = (msg && msg.attachment) ? msg.attachment.name : "setup_muntrume.sto";
        const dummyContent = `[Muntrume Motorsport Setup File]\nCar=Porsche 992 GT3 R\nTrack=Circuit de Spa-Francorchamps\nFrontToe=-0.05\nRearWing=7\nBrakeBias=54.2\nChecksum=MRT-2026-OK\n`;
        const blob = new Blob([dummyContent], { type: "application/octet-stream" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
