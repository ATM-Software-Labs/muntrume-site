---
import Layout from '../layouts/Layout.astro';
import PrivateAreaHeader from '../components/PrivateAreaHeader.astro';

const pageTitle = "Webmail Corporativo y Comunicaciones de Telemetría · Muntrume";
const pageDescription = "Portal institucional de comunicaciones y correo seguro de escudería para pilotos e ingenieros de pista de Muntrume Motorsport.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="flex-grow pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full select-none font-sans">
    
    <!-- Unified Hub Área Privada Header -->
    <PrivateAreaHeader activeTab="mail" />

    <!-- ========================================================================= -->
    <!-- VIEW A: TEAM COMMS LANDING GATE (UNAUTHENTICATED)                         -->
    <!-- ========================================================================= -->
    <div id="mailLanding" class="rounded-3xl bg-gradient-to-b from-[#161c24] via-[#12171f] to-[#0e1217] border border-white/10 p-6 sm:p-10 lg:p-12 shadow-2xl relative overflow-hidden text-center space-y-6">
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-600"></div>
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-3xl mx-auto space-y-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-xs font-semibold text-emerald-400">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Buzón Privado de Escudería · Acceso Restringido</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
          MUNTRUME <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-emerald-500">TEAM COMMS</span>
        </h1>

        <p class="text-sm sm:text-base text-neutral-300 max-w-2xl mx-auto leading-relaxed">
          Portal confidencial de mensajería, telemetría y coordinación de carrera entre los pilotos de <strong class="text-white">Muntrume Motorsport</strong>. Cada piloto dispone de su propio buzón protegido y privado.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3.5 pt-3">
          <button 
            type="button" 
            id="hero-login-btn"
            class="px-7 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-xs sm:text-sm uppercase tracking-wider transition flex items-center gap-2.5 shadow-xl shadow-emerald-500/25 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
            <span>Iniciar Sesión de Piloto</span>
          </button>
          <a 
            href="/setups" 
            class="px-6 py-3.5 rounded-2xl bg-[#161c24] hover:bg-white/10 border border-white/15 text-white font-bold text-xs sm:text-sm transition flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            <span>Ir al Setup Vault</span>
          </a>
        </div>

        <!-- Security & Features 3-Card Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 text-left">
          <div class="p-5 rounded-2xl bg-[#12171f] border border-white/10 space-y-2">
            <div class="w-8 h-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-sm font-bold">
              🔒
            </div>
            <h3 class="text-sm font-bold text-white">Privacidad Estricta</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Cada piloto accede exclusivamente a su buzón personal. Nadie ajeno puede leer ni filtrar comunicaciones privadas de compañeros.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-[#12171f] border border-white/10 space-y-2">
            <div class="w-8 h-8 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400 text-sm font-bold">
              ⚡
            </div>
            <h3 class="text-sm font-bold text-white">Telemetría y .STO</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Descarga e intercambio directo de archivos de setup Assetto Corsa / iRacing y logs de MoTeC i2 Pro en un clic.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-[#12171f] border border-white/10 space-y-2">
            <div class="w-8 h-8 rounded-xl bg-cyan-500/15 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-sm font-bold">
              🛡️
            </div>
            <h3 class="text-sm font-bold text-white">Entrega Verificada</h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Relay con dominio propio trujillomingorance.com, soporte DKIM y enrutamiento bidireccional mediante Cloudflare.
            </p>
          </div>
        </div>

      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- VIEW B: AUTHENTICATED WEBMAIL APP                                         -->
    <!-- ========================================================================= -->
    <div id="mailAppContainer" class="hidden rounded-2xl border border-white/10 bg-[#0e1217] shadow-2xl flex flex-col overflow-hidden min-h-[640px] h-[calc(100vh-210px)]">

      <!-- 1. UNIFIED APP TOP TOOLBAR -->
      <header class="h-14 sm:h-16 px-3 sm:px-6 bg-[#12171f] border-b border-white/10 flex items-center justify-between gap-2 sm:gap-4 shrink-0 z-20">
        
        <!-- Left: Mobile Menu + App Identity -->
        <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
          <button id="toggle-sidebar-mobile" class="md:hidden p-2 rounded-xl bg-white/5 border border-white/10 text-neutral-300 hover:text-white" aria-label="Abrir carpetas">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>

          <div class="flex items-center gap-2">
            <span class="font-extrabold text-white text-sm sm:text-base tracking-tight">BUZÓN OFICIAL</span>
            <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Cifrado D1</span>
          </div>
        </div>
<!-- Center: Search Input Bar -->
      <div class="flex-1 max-w-xl mx-1 sm:mx-4">
        <div class="relative w-full">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-neutral-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <input 
            type="text" 
            id="mail-search-input" 
            placeholder="Buscar en correos, setups .sto, telemetrías o pilotos..." 
            class="w-full pl-9 pr-8 py-1.5 sm:py-2 rounded-xl bg-[#0b0f14] border border-white/10 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-emerald-500/50 transition font-sans"
          />
          <button id="clear-search-btn" class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-neutral-500 hover:text-white text-xs">
            ✕
          </button>
        </div>
      </div>

      <!-- Right: Mailbox Selector + Modals + Refresh + Compose -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        
        <!-- Active Driver Mailbox Selector -->
        <div class="bg-[#161c24] border border-white/10 rounded-xl px-2 sm:px-2.5 py-1.5 flex items-center gap-1.5 text-xs">
          <span class="text-[10px] uppercase font-mono tracking-wider text-neutral-400 font-bold hidden lg:inline">Buzón:</span>
          <select id="driver-account-selector" class="bg-transparent text-emerald-400 font-bold text-xs focus:outline-none cursor-pointer max-w-[125px] sm:max-w-[200px] truncate">
            <option value="alberto@muntru.me" selected>Alberto Trujillo (alberto@muntru.me)</option>
            <option value="admin@muntru.me">Race Control (admin@muntru.me)</option>
            <option value="mateo@muntru.me" disabled class="text-neutral-500">🔒 Mateo Berbis (Privado)</option>
            <option value="eduardo@muntru.me" disabled class="text-neutral-500">🔒 Eduardo Chongkan (Privado)</option>
            <option value="juanlu@muntru.me" disabled class="text-neutral-500">🔒 Juanlu Carrillo (Privado)</option>
          </select>
        </div>

        <!-- Session Pilot Pill & Logout -->
        <div id="session-pilot-pill" class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-xs text-neutral-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span id="session-pilot-name" class="font-bold text-emerald-400 text-xs truncate max-w-[100px]">Alberto</span>
          <button id="logout-btn" class="text-neutral-500 hover:text-red-400 ml-1 p-0.5 text-xs transition cursor-pointer" title="Cerrar sesión">✕</button>
        </div>

        <!-- Directory Button -->
        <button id="open-directory-btn" title="Directorio Oficial de Pilotos" class="p-2 sm:px-2.5 sm:py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition flex items-center gap-1.5 text-xs font-semibold">
          <span class="text-sm">👥</span>
          <span class="hidden xl:inline">Directorio</span>
        </button>

        <!-- Brevo API Settings Button -->
        <button id="open-settings-btn" title="Configurar Brevo API" class="p-2 sm:px-2.5 sm:py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-white transition flex items-center gap-1.5 text-xs font-semibold">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="hidden md:inline">Brevo API</span>
        </button>

        <!-- Refresh Mailbox Button -->
        <button id="refresh-mailbox-btn" title="Actualizar buzón" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-neutral-300 hover:text-emerald-400 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>

        <!-- Quick Compose Button -->
        <button id="open-compose-header-btn" class="md:hidden inline-flex items-center gap-1.5 px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-xs uppercase tracking-wider transition shadow-lg shadow-emerald-500/20 shrink-0 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span class="hidden sm:inline">Redactar</span>
        </button>
      </div>

    </header>

    <!-- ======================================================================= -->
    <!-- 2. APP MAIN WORKSPACE (SIDEBAR + CONTENT SPLIT)                         -->
    <!-- ======================================================================= -->
    <div id="mail-app-workspace" class="flex-1 flex overflow-hidden relative">
      
      <!-- MOBILE SIDEBAR BACKDROP -->
      <div id="sidebar-backdrop" class="hidden md:hidden fixed inset-0 bg-black/70 z-30 backdrop-blur-xs"></div>

      <!-- A. LEFT SIDEBAR (NAVIGATION & FOLDERS) -->
      <aside id="mail-sidebar" class="w-64 bg-[#0e1217] border-r border-white/10 flex flex-col justify-between py-4 shrink-0">
        
        <div class="space-y-4 px-3">
          <!-- Big Compose Button in Sidebar -->
          <button id="open-compose-btn" class="w-full py-3 px-4 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-black text-xs uppercase tracking-wider transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Redactar Correo</span>
          </button>

          <!-- Standard Folders Navigation -->
          <nav class="space-y-1 text-xs">
            <button data-folder="inbox" class="folder-btn active w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-bold transition text-emerald-400 bg-emerald-500/10">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                <span>Recibidos</span>
              </div>
              <span id="unread-counter" class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">0</span>
            </button>

            <button data-folder="briefings" class="folder-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-neutral-300 hover:bg-white/5 transition">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>Briefings &amp; Setups</span>
              </div>
              <span id="briefings-counter" class="px-2 py-0.5 rounded-full bg-white/5 text-neutral-400 font-mono text-[10px]">0</span>
            </button>

            <button data-folder="starred" class="folder-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-neutral-300 hover:bg-white/5 transition">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                <span>Destacados</span>
              </div>
              <span id="starred-counter" class="px-2 py-0.5 rounded-full bg-white/5 text-neutral-400 font-mono text-[10px]">0</span>
            </button>

            <button data-folder="sent" class="folder-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-neutral-300 hover:bg-white/5 transition">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                <span>Enviados</span>
              </div>
              <span id="sent-counter" class="px-2 py-0.5 rounded-full bg-white/5 text-neutral-400 font-mono text-[10px]">0</span>
            </button>

            <button data-folder="drafts" class="folder-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-neutral-300 hover:bg-white/5 transition">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <span>Borradores</span>
              </div>
              <span id="drafts-counter" class="px-2 py-0.5 rounded-full bg-white/5 text-neutral-400 font-mono text-[10px]">0</span>
            </button>

            <button data-folder="trash" class="folder-btn w-full flex items-center justify-between px-3 py-2.5 rounded-xl font-medium text-neutral-300 hover:bg-white/5 transition">
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <span>Papelera</span>
              </div>
            </button>
          </nav>

          <!-- Quick Pilot Filter Switcher in Sidebar -->
          <div class="pt-3 border-t border-white/10 space-y-2">
            <span class="text-[10px] uppercase font-mono tracking-wider text-neutral-400 font-bold px-3">Filtrar por Piloto</span>
            <div class="space-y-1 text-xs">
              <button class="pilot-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-neutral-300 hover:text-white hover:bg-white/5 transition flex items-center justify-between" data-pilot-email="alberto@muntru.me">
                <span class="truncate">🟢 Alberto Trujillo</span>
                <span class="text-[10px] font-mono text-emerald-400 font-bold">#1 &middot; ACTIVO</span>
              </button>
              <button class="pilot-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-neutral-300 hover:text-white hover:bg-white/5 transition flex items-center justify-between" data-pilot-email="admin@muntru.me">
                <span class="truncate">🟣 Race Control</span>
                <span class="text-[10px] font-mono text-purple-400 font-bold">DIR &middot; ADMIN</span>
              </button>
              <button class="pilot-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-neutral-500 hover:bg-white/5 transition flex items-center justify-between opacity-60 cursor-not-allowed" data-pilot-email="mateo@muntru.me" data-locked="true">
                <span class="truncate">🔒 Mateo Berbis</span>
                <span class="text-[9px] font-mono px-1 rounded bg-white/5 text-neutral-500">PRIVADO</span>
              </button>
              <button class="pilot-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-neutral-500 hover:bg-white/5 transition flex items-center justify-between opacity-60 cursor-not-allowed" data-pilot-email="eduardo@muntru.me" data-locked="true">
                <span class="truncate">🔒 Eduardo Chongkan</span>
                <span class="text-[9px] font-mono px-1 rounded bg-white/5 text-neutral-500">PRIVADO</span>
              </button>
              <button class="pilot-filter-btn w-full text-left px-3 py-1.5 rounded-lg text-neutral-500 hover:bg-white/5 transition flex items-center justify-between opacity-60 cursor-not-allowed" data-pilot-email="juanlu@muntru.me" data-locked="true">
                <span class="truncate">🔒 Juanlu Carrillo</span>
                <span class="text-[9px] font-mono px-1 rounded bg-white/5 text-neutral-500">PRIVADO</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Sidebar Footer Security / Status Badge -->
        <div class="px-4 pt-3 border-t border-white/10 text-[11px] font-mono text-neutral-500 space-y-1">
          <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>DKIM &amp; SPF 100% Verified</span>
          </div>
          <div class="truncate text-[10px]">Relay: Resend (trujillomingorance.com)</div>
        </div>

      </aside>

      <!-- B. MAIN EMAIL DISPLAY WORKSPACE -->
      <section id="mail-main-pane" class="flex-1 flex flex-col min-w-0 bg-[#12171f] overflow-hidden">
        
        <!-- SUB-HEADER: CATEGORY FILTER PILLS & STATUS -->
        <div class="px-3 sm:px-6 py-2.5 bg-[#161c24] border-b border-white/10 flex items-center justify-between gap-3 shrink-0">
          
          <!-- Category Pills -->
          <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 text-xs">
            <button class="category-pill active px-3 py-1 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 font-bold transition shrink-0" data-filter="all">
              Todos
            </button>
            <button class="category-pill px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-neutral-400 hover:text-white border border-white/10 font-medium transition shrink-0" data-filter="unread">
              No leídos
            </button>
            <button class="category-pill px-3 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-neutral-400 hover:text-white border border-white/10 font-medium transition shrink-0 flex items-center gap-1" data-filter="has_setup">
