    // Show Toast Function
    function showToast(msg, isSuccess = true) {
      if (!toast) return;
      toastIcon.textContent = isSuccess ? "✓" : "⚠️";
      toastMessage.textContent = msg;
      toast.classList.remove("opacity-0", "translate-y-4");
      toast.classList.add("opacity-100", "translate-y-0");
      setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0");
        toast.classList.add("opacity-0", "translate-y-4");
      }, 3500);
    }

    // Matches message with active mailbox
    function matchesActiveMailbox(msg) {
      if (activeMailbox === "all") return true;
      if (msg.account === "all") return true;
      if (msg.account && msg.account === activeMailbox) return true;
      if (msg.sender && msg.sender.email === activeMailbox) return true;
      if (msg.recipients && (msg.recipients.includes(activeMailbox) || msg.recipients.toLowerCase().includes("todos"))) return true;
      return false;
    }

    // Update Counters
    function updateCounters() {
      const activeMsgs = messages.filter(matchesActiveMailbox);

      const unreadCount = activeMsgs.filter(m => m.folder === "inbox" && m.unread).length;
      const briefingsCount = activeMsgs.filter(m => m.is_briefing && m.folder !== "trash").length;
      const starCount = activeMsgs.filter(m => m.starred && m.folder !== "trash").length;
      const sentCount = activeMsgs.filter(m => m.folder === "sent").length;
      const draftsCount = activeMsgs.filter(m => m.folder === "drafts").length;

      if (unreadCounter) unreadCounter.textContent = unreadCount;
      if (briefingsCounter) briefingsCounter.textContent = briefingsCount;
      if (starredCounter) starredCounter.textContent = starCount;
      if (sentCounter) sentCounter.textContent = sentCount;
      if (draftsCounter) draftsCounter.textContent = draftsCount;
    }

    // Filter and Render Mail List
    function renderMailList() {
      updateCounters();

      // Filter messages
      let filtered = messages.filter(m => {
        // Mailbox account check
        if (!matchesActiveMailbox(m)) return false;

        // Folder check
        if (currentFolder === "starred") {
          if (!m.starred || m.folder === "trash") return false;
        } else if (currentFolder === "briefings") {
          if (!m.is_briefing || m.folder === "trash") return false;
        } else {
          if (m.folder !== currentFolder) return false;
        }

        // Category filter pills
        if (currentFilter === "unread" && !m.unread) return false;
        if (currentFilter === "has_setup" && (!m.attachment || !m.attachment.name.endsWith(".sto"))) return false;
        if (currentFilter === "starred" && !m.starred) return false;

        // Search Query
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchSub = (m.subject || "").toLowerCase().includes(q);
          const matchBody = (m.body || "").toLowerCase().includes(q);
          const matchSender = (m.sender.name || "").toLowerCase().includes(q) || (m.sender.email || "").toLowerCase().includes(q);
          const matchAttach = m.attachment && m.attachment.name.toLowerCase().includes(q);
          if (!matchSub && !matchBody && !matchSender && !matchAttach) return false;
        }

        return true;
      });

      // Sort by timestamp desc
      filtered.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

      if (listStatusText) {
        listStatusText.textContent = `${filtered.length} mensaje${filtered.length === 1 ? '' : 's'}`;
      }

      if (!emailListContainer) return;

      if (filtered.length === 0) {
        emailListContainer.innerHTML = `
