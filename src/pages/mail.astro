                </span>
                <span class="text-neutral-400 text-xs truncate max-w-sm">
                  - ${msg.snippet}
                </span>
                ${hasSetup}
              </div>

              <!-- Date -->
              <div class="text-[11px] font-mono text-neutral-400 shrink-0 text-right w-20">
                ${msg.date}
              </div>
            </div>

            <!-- MOBILE ROW (< md) -->
            <div class="mail-row-mobile space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2 min-w-0">
                  <button class="star-toggle text-sm ${isStarred} shrink-0" data-star-id="${msg.id}">
                    ★
                  </button>
                  ${unreadIndicator}
                  <div class="w-6 h-6 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center font-bold text-emerald-400 text-[10px] shrink-0 font-mono">
