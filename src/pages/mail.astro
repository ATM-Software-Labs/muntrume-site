              ${unreadIndicator}

              <!-- Sender Avatar -->
              <div class="w-8 h-8 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center font-bold text-emerald-400 text-xs shrink-0 font-mono">
                ${msg.sender.initials || "MU"}
              </div>

              <!-- Sender Name -->
              <div class="w-36 truncate text-xs ${isUnread} shrink-0">
                ${msg.sender.name}
              </div>

              <!-- Subject & Snippet -->
              <div class="flex-1 min-w-0 flex items-center gap-2 overflow-hidden">
                <span class="truncate text-xs ${msg.unread ? 'font-bold text-white' : 'text-neutral-200'}">
