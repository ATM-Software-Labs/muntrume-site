        html += `
          <div class="mail-row ${msg.unread ? 'unread' : ''} p-3 sm:px-5 sm:py-3 cursor-pointer select-none" data-msg-id="${msg.id}">
            
            <!-- DESKTOP ROW (md+) -->
            <div class="mail-row-desktop">
