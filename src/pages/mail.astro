    function getLoggedInUser() {
      try {
        const stored = localStorage.getItem("mrt_vault_user") || sessionStorage.getItem("mrt_vault_user");
        if (stored) return JSON.parse(stored);
      } catch (e) {}
      return null;
    }

    function checkAuth() {
      const user = getLoggedInUser();
      const token = localStorage.getItem("mrt_vault_token") || sessionStorage.getItem("mrt_vault_token");
      if (user && token && (user.email || user.role)) {
        if (mailLanding) mailLanding.classList.add("hidden");
        if (mailAppContainer) {
          mailAppContainer.classList.remove("hidden");
          mailAppContainer.classList.add("flex");
        }
        if (sessionPilotName) {
          sessionPilotName.textContent = user.name || (user.email ? user.email.split("@")[0].toUpperCase() : "Alberto");
        }
        return true;
      } else {
        if (mailAppContainer) {
          mailAppContainer.classList.add("hidden");
          mailAppContainer.classList.remove("flex");
        }
        if (mailLanding) mailLanding.classList.remove("hidden");
        return false;
      }
    }

    function openMailAuthModal() {
      window.openMailAuthModal = openMailAuthModal;
      if (mailAuthModal) mailAuthModal.classList.remove("hidden");
      if (codeAuthEmail) codeAuthEmail.focus();
    }

    function closeMailAuthModal() {
      if (mailAuthModal) mailAuthModal.classList.add("hidden");
      if (codeAuthError) codeAuthError.classList.add("hidden");
      if (codeAuthSuccess) codeAuthSuccess.classList.add("hidden");
      if (passAuthError) passAuthError.classList.add("hidden");
      if (codeStep2) codeStep2.classList.add("hidden");
      if (authCodeForm) authCodeForm.reset();
      if (authPassForm) authPassForm.reset();
      if (codeSubmitBtn) codeSubmitBtn.textContent = "Solicitar Código 2FA →";
    }

    if (landingLoginBtn) landingLoginBtn.addEventListener("click", openMailAuthModal);
    if (heroLoginBtn) heroLoginBtn.addEventListener("click", openMailAuthModal);
    if (closeMailAuthBtn) closeMailAuthBtn.addEventListener("click", closeMailAuthModal);

    // Tab Switching
    if (tabCodeBtn && tabPassBtn) {
      tabCodeBtn.addEventListener("click", () => {
        tabCodeBtn.classList.add("bg-emerald-500", "text-neutral-950", "font-bold");
        tabCodeBtn.classList.remove("text-neutral-400");
        tabPassBtn.classList.remove("bg-emerald-500", "text-neutral-950", "font-bold");
        tabPassBtn.classList.add("text-neutral-400");
        authCodeForm.classList.remove("hidden");
        authPassForm.classList.add("hidden");
      });

      tabPassBtn.addEventListener("click", () => {
        tabPassBtn.classList.add("bg-emerald-500", "text-neutral-950", "font-bold");
        tabPassBtn.classList.remove("text-neutral-400");
        tabCodeBtn.classList.remove("bg-emerald-500", "text-neutral-950", "font-bold");
        tabCodeBtn.classList.add("text-neutral-400");
        authPassForm.classList.remove("hidden");
        authCodeForm.classList.add("hidden");
      });
    }

    // 1. 2FA Code Form Submission
    if (authCodeForm) {
      authCodeForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = codeAuthEmail ? codeAuthEmail.value.trim() : "";
        if (!email) return;

        if (codeAuthError) codeAuthError.classList.add("hidden");
        if (codeAuthSuccess) codeAuthSuccess.classList.add("hidden");

        // STEP 1: Request code
        if (codeStep2 && codeStep2.classList.contains("hidden")) {
          if (codeSubmitBtn) {
            codeSubmitBtn.disabled = true;
            codeSubmitBtn.textContent = "Enviando código...";
          }

          try {
            const res = await fetch("https://muntrume.atrumin16.workers.dev/api/setups/code/request", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email })
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok && data.success) {
              codeStep2.classList.remove("hidden");
              if (codeAuthSuccess) {
                codeAuthSuccess.textContent = data.message || "✓ Código de 6 dígitos enviado a tu correo.";
                codeAuthSuccess.classList.remove("hidden");
              }
              if (codeSubmitBtn) codeSubmitBtn.textContent = "Verificar y Entrar al Buzón →";
              if (codeAuthInput) {
                codeAuthInput.focus();
              }
            } else {
              if (codeAuthError) {
                codeAuthError.textContent = data.error || "No se pudo enviar el código. Verifica que el correo esté autorizado.";
                codeAuthError.classList.remove("hidden");
              }
            }
          } catch (err) {
            if (codeAuthError) {
              codeAuthError.textContent = "Error de conexión con el servidor de autenticación.";
              codeAuthError.classList.remove("hidden");
            }
          } finally {
            if (codeSubmitBtn) codeSubmitBtn.disabled = false;
          }
          return;
        }

        // STEP 2: Verify code
        const code = codeAuthInput ? codeAuthInput.value.replace(/\D/g, "") : "";
        if (code.length !== 6) {
          if (codeAuthError) {
            codeAuthError.textContent = "El código debe tener exactamente 6 dígitos numéricos.";
            codeAuthError.classList.remove("hidden");
          }
          return;
        }

        if (codeSubmitBtn) {
          codeSubmitBtn.disabled = true;
          codeSubmitBtn.textContent = "Verificando...";
        }

        try {
          const res = await fetch("https://muntrume.atrumin16.workers.dev/api/setups/code/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, code })
          });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            localStorage.setItem("mrt_vault_user", JSON.stringify(data.user || { email, role: "admin", name: "Alberto Trujillo" }));
            localStorage.setItem("mrt_vault_token", data.token || "session_verified");
            closeMailAuthModal();
            checkAuth();
            showToast(`✓ Identidad 100% verificada. Bienvenido Alberto`);
            renderMailList();
            fetchRemoteInbox();
          } else {
            if (codeAuthError) {
              codeAuthError.textContent = data.error || "Código incorrecto o caducado. Solicita uno nuevo.";
              codeAuthError.classList.remove("hidden");
            }
          }
        } catch (err) {
          if (codeAuthError) {
            codeAuthError.textContent = "Error al verificar el código con el servidor.";
            codeAuthError.classList.remove("hidden");
          }
        } finally {
          if (codeSubmitBtn) codeSubmitBtn.disabled = false;
        }
      });
    }

    if (resendCodeBtn) {
      resendCodeBtn.addEventListener("click", () => {
        if (codeStep2) codeStep2.classList.add("hidden");
        if (codeSubmitBtn) codeSubmitBtn.textContent = "Solicitar Código 2FA →";
        if (authCodeForm) authCodeForm.requestSubmit();
      });
    }

    // 2. Password Form Submission
    if (authPassForm) {
      authPassForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const email = passAuthEmail ? passAuthEmail.value.trim() : "";
        const password = passAuthPassword ? passAuthPassword.value : "";
        if (!email || !password) {
          if (passAuthError) {
            passAuthError.textContent = "Introduce correo y contraseña.";
            passAuthError.classList.remove("hidden");
          }
          return;
        }

        if (passSubmitBtn) {
          passSubmitBtn.disabled = true;
          passSubmitBtn.textContent = "Autenticando...";
        }
        if (passAuthError) passAuthError.classList.add("hidden");

        try {
          const res = await fetch("https://muntrume.atrumin16.workers.dev/api/setups/auth", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password })
          });
          const data = await res.json().catch(() => ({}));

          if (res.ok && data.success) {
            localStorage.setItem("mrt_vault_user", JSON.stringify(data.user || { email, role: "member" }));
            if (data.token) localStorage.setItem("mrt_vault_token", data.token);
            closeMailAuthModal();
            checkAuth();
            showToast(`✓ Acceso concedido: ${data.user?.name || email}`);
            renderMailList();
            fetchRemoteInbox();
          } else {
            if (passAuthError) {
              passAuthError.textContent = data.error || "Credenciales no válidas. Comprueba correo y contraseña.";
              passAuthError.classList.remove("hidden");
            }
          }
        } catch (err) {
          if (passAuthError) {
            passAuthError.textContent = "Error conectando con el servidor de autenticación.";
            passAuthError.classList.remove("hidden");
          }
        } finally {
          if (passSubmitBtn) {
            passSubmitBtn.disabled = false;
            passSubmitBtn.textContent = "Verificar Credenciales →";
          }
        }
      });
    }

    // Logout
    if (logoutBtn) {
      logoutBtn.addEventListener("click", () => {
        localStorage.removeItem("mrt_vault_user");
        localStorage.removeItem("mrt_vault_token");
        sessionStorage.removeItem("mrt_vault_user");
        sessionStorage.removeItem("mrt_vault_token");
        checkAuth();
        showToast("Sesión cerrada");
      });
    }

    // =========================================================================
    // INBOUND REAL EMAILS REMOTE SYNC// =========================================================================
    // INBOUND REAL EMAILS REMOTE SYNC (Cloudflare Worker -> D1)
    // =========================================================================
    async function fetchRemoteInbox() {
      try {
        const res = await fetch(`https://muntrume.atrumin16.workers.dev/api/mail/inbox?mailbox=${encodeURIComponent(activeMailbox)}`);
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success && Array.isArray(data.messages) && data.messages.length > 0) {
          let added = 0;
          data.messages.forEach(remoteMsg => {
            const exists = messages.some(m => m.id === remoteMsg.id);
            if (!exists) {
              messages.unshift({
                id: remoteMsg.id,
                folder: remoteMsg.folder || "inbox",
                is_briefing: (remoteMsg.subject || "").toLowerCase().includes("briefing") || (remoteMsg.subject || "").toLowerCase().includes("setup"),
                unread: remoteMsg.unread === 1,
                starred: remoteMsg.starred === 1,
                account: remoteMsg.recipient_email || activeMailbox,
                sender: {
                  name: remoteMsg.sender_name || remoteMsg.sender_email.split("@")[0],
                  email: remoteMsg.sender_email,
                  initials: (remoteMsg.sender_name || remoteMsg.sender_email).substring(0, 2).toUpperCase(),
                  role: "Remitente Externo"
                },
                recipients: remoteMsg.recipient_email,
                subject: remoteMsg.subject || "(Sin asunto)",
                snippet: remoteMsg.snippet || "",
                body: remoteMsg.body || "",
                date: remoteMsg.date_str || "Hoy",
                timestamp: remoteMsg.timestamp || Date.now(),
                tags: ["Respuesta Real", "Inbound"],
                attachment: remoteMsg.attachment_name ? {
                  name: remoteMsg.attachment_name,
                  type: "file",
                  size: remoteMsg.attachment_size || "10 KB"
                } : null
              });
              added++;
            }
          });
          if (added > 0) {
            saveMessages();
            renderMailList();
            showToast(`✓ Sincronizados ${added} nuevo(s) correo(s) recibidos`);
          }
        }
      } catch (e) {
        console.warn("No se pudo consultar el buzón remoto en tiempo real:", e);
      }
    }

    // Initial check & render
    checkAuth();
    renderMailList();
