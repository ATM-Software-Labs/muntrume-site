    if (composeForm) {
      composeForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const fromEmail = (composeFrom && composeFrom.value) ? composeFrom.value : "alberto.muntrume@trujillomingorance.com";
        const toEmail = composeTo ? composeTo.value.trim() : "";
        const subject = composeSubject ? composeSubject.value.trim() : "";
        const bodyContent = composeBody ? composeBody.value.trim() : "";

        if (!toEmail || !subject || !bodyContent) {
          showToast("Por favor completa destinatario, asunto y mensaje", false);
          return;
        }

        if (sendBtnSpinner) sendBtnSpinner.classList.remove("hidden");
        if (sendBtnText) sendBtnText.textContent = "Enviando...";
        if (sendMailSubmitBtn) sendMailSubmitBtn.disabled = true;

        const brevoKey = localStorage.getItem(LS_BREVO_KEY) || "";
        let sentLive = false;
        let relayDetail = "Resend Relay";

        try {
          // 1. Despacho en servidor seguro mediante Cloudflare Worker + Resend (@trujillomingorance.com verificado)
          const workerRes = await fetch("https://muntrume.atrumin16.workers.dev/api/mail/send", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              from: fromEmail,
              fromName: `${fromEmail.split("@")[0].toUpperCase()} · Muntrume Motorsport`,
              to: toEmail,
              subject: subject,
              body: bodyContent
            })
          });

          const workerData = await workerRes.json().catch(() => ({}));
          if (workerRes.ok && workerData.success) {
            sentLive = true;
            relayDetail = workerData.provider || "Resend Relay";
          } else if (brevoKey) {
            // 2. Fallback secundario a Brevo API si el usuario configuró clave personal
            const res = await fetch("https://api.brevo.com/v3/smtp/email", {
              method: "POST",
              headers: {
                "api-key": brevoKey,
                "Content-Type": "application/json",
                "accept": "application/json"
              },
              body: JSON.stringify({
                sender: {
                  name: `Muntrume Motorsport (${fromEmail.split("@")[0]})`,
                  email: fromEmail
                },
                to: [{ email: toEmail }],
                subject: subject,
                textContent: bodyContent
              })
            });
            if (res.ok) {
              sentLive = true;
              relayDetail = "Brevo SMTP Relay";
            }
          }
        } catch (err) {
          console.warn("Error en relay de correo, archivando en buzón local:", err);
        }

        // Record message in sent folder
        const sentMessage = {
          id: "sent-" + Date.now(),
          folder: "sent",
          is_briefing: subject.toLowerCase().includes("briefing") || subject.toLowerCase().includes("setup"),
          unread: false,
          starred: false,
          account: fromEmail,
          sender: {
            name: fromEmail.split("@")[0].toUpperCase(),
            email: fromEmail,
            initials: fromEmail.substring(0, 2).toUpperCase(),
            role: "Driver / Team"
          },
          recipients: toEmail,
          subject: subject,
          snippet: bodyContent.substring(0, 80) + "...",
          body: bodyContent,
          date: "Ahora",
          timestamp: Date.now(),
          tags: ["Enviado"],
          attachment: composeFileName && composeFileName.textContent !== "Ninguno" ? {
            name: composeFileName.textContent,
            type: "setup",
            size: "12 KB"
          } : null
        };

        messages.unshift(sentMessage);
        saveMessages();
        closeComposeModal();

        if (sendBtnSpinner) sendBtnSpinner.classList.add("hidden");
        if (sendBtnText) sendBtnText.textContent = "Enviar";
        if (sendMailSubmitBtn) sendMailSubmitBtn.disabled = false;

        if (sentLive) {
          showToast(`✓ Correo real entregado con éxito a ${toEmail} vía ${relayDetail}`);
        } else {
          showToast("Mensaje registrado y archivado en Enviados");
        }

        updateCounters();
        if (currentFolder === "sent") renderMailList();
      });
