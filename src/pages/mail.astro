    function updateCounters() {
      const unreadCount = messages.filter(m => m.folder === "inbox" && m.unread).length;
      const starCount = messages.filter(m => m.starred && m.folder !== "trash").length;
      const sentCount = messages.filter(m => m.folder === "sent").length;
      const draftsCount = messages.filter(m => m.folder === "drafts").length;

      if (unreadCounter) unreadCounter.textContent = unreadCount;
      if (starredCounter) starredCounter.textContent = starCount;
      if (sentCounter) sentCounter.textContent = sentCount;
      if (draftsCounter) draftsCounter.textContent = draftsCount;
    }

    // Filter and Render Mail List
    function renderMailList() {
      updateCounters();

      // Filter messages
      let filtered = messages.filter(m => {
        // Folder check
        if (currentFolder === "starred") {
          if (!m.starred || m.folder === "trash") return false;
        } else if (currentFolder === "briefings") {
          if (!m.is_briefing || m.folder === "trash") return false;
        } else {
          if (m.folder !== currentFolder) return false;
        }

        // Category filter pills
        if (currentFilter === "unread" && !m.unread) return false;
        if (currentFilter === "has_setup" && (!m.attachment || !m.attachment.name.endsWith(".sto"))) return false;
        if (currentFilter === "starred" && !m.starred) return false;

        // Search Query
        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const matchSub = (m.subject || "").toLowerCase().includes(q);
          const matchBody = (m.body || "").toLowerCase().includes(q);
          const matchSender = (m.sender.name || "").toLowerCase().includes(q) || (m.sender.email || "").toLowerCase().includes(q);
          const matchAttach = m.attachment && m.attachment.name.toLowerCase().includes(q);
          if (!matchSub && !matchBody && !matchSender && !matchAttach) return false;
        }

        return true;
      });

      // Sort by timestamp desc
      filtered.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));

      if (listStatusText) {
        listStatusText.textContent = `${filtered.length} mensaje${filtered.length === 1 ? '' : 's'}`;
      }

      if (!emailListContainer) return;

      if (filtered.length === 0) {
        emailListContainer.innerHTML = `
          <div class="py-16 px-4 text-center space-y-3">
            <div class="text-4xl">📬</div>
            <div class="text-white font-bold text-sm">No hay mensajes en esta vista</div>
            <p class="text-neutral-500 text-xs max-w-sm mx-auto">No se encontraron correos que coincidan con los filtros o la carpeta seleccionada.</p>
          </div>
        `;
        return;
      }

      let html = "";
      filtered.forEach(msg => {
        const isUnread = msg.unread ? "unread" : "";
        const isStarred = msg.starred ? "text-amber-400" : "text-neutral-600 hover:text-neutral-400";
        const hasSetup = msg.attachment ? `
          <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-mono shrink-0">
            <span>⚙️</span>
            <span>${msg.attachment.name.endsWith(".sto") ? ".STO" : "FILE"}</span>
          </span>
        ` : "";

        html += `
          <div class="mail-row ${isUnread} flex items-center gap-3 px-3 sm:px-4 py-3 cursor-pointer select-none" data-msg-id="${msg.id}">
            <!-- Star Button -->
            <button class="star-toggle p-1 text-xs ${isStarred} transition shrink-0" data-star-id="${msg.id}" title="Destacar">
              ★
            </button>

            <!-- Sender Avatar -->
            <div class="w-8 h-8 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center font-bold text-emerald-400 text-xs shrink-0 font-mono">
              ${msg.sender.initials || "MU"}
            </div>

            <!-- Sender Name -->
            <div class="w-28 sm:w-36 truncate text-xs font-bold text-neutral-200 shrink-0">
              ${msg.sender.name}
            </div>

            <!-- Subject & Snippet -->
            <div class="flex-1 min-w-0 flex items-center gap-2">
              <span class="mail-subject truncate text-xs text-neutral-300">
                ${msg.subject}
              </span>
              <span class="text-neutral-600 hidden md:inline text-xs truncate max-w-[280px]">
                - ${msg.snippet}
              </span>
              ${hasSetup}
            </div>

            <!-- Date -->
            <div class="text-[11px] font-mono text-neutral-400 shrink-0">
              ${msg.date}
            </div>
          </div>
        `;
      });

      emailListContainer.innerHTML = html;

      // Attach row click listeners
      emailListContainer.querySelectorAll(".mail-row").forEach(row => {
        row.addEventListener("click", (e) => {
          // If clicked star, toggle star
          if (e.target.closest(".star-toggle")) {
            const id = e.target.closest(".star-toggle").dataset.starId;
            toggleStar(id);
            return;
          }
          const msgId = row.dataset.msgId;
          openMessageDetail(msgId);
        });
      });
    }

    // Toggle Star
    function toggleStar(id) {
      const msg = messages.find(m => m.id === id);
      if (msg) {
        msg.starred = !msg.starred;
        saveMessages();
        renderMailList();
      }
    }

    // Open Message Detail View
    function openMessageDetail(id) {
      const msg = messages.find(m => m.id === id);
      if (!msg) return;

      activeMessageId = id;

      // Mark as read
      if (msg.unread) {
        msg.unread = false;
        saveMessages();
        updateCounters();
      }

      // Populate Detail View
      const detailSubject = document.getElementById("detail-subject");
      const detailSenderName = document.getElementById("detail-sender-name");
      const detailSenderEmail = document.getElementById("detail-sender-email");
      const detailAvatar = document.getElementById("detail-avatar");
      const detailRecipients = document.getElementById("detail-recipients");
      const detailDate = document.getElementById("detail-date");
      const detailBody = document.getElementById("detail-body");
      const detailTags = document.getElementById("detail-tags");
      const detailAttachmentBox = document.getElementById("detail-attachment-box");
      const attachmentName = document.getElementById("attachment-name");
      const attachmentMeta = document.getElementById("attachment-meta");
      const detailStarBtn = document.getElementById("detail-star-btn");

      if (detailSubject) detailSubject.textContent = msg.subject;
      if (detailSenderName) detailSenderName.textContent = msg.sender.name;
      if (detailSenderEmail) detailSenderEmail.textContent = `<${msg.sender.email}>`;
      if (detailAvatar) detailAvatar.textContent = msg.sender.initials || "MU";
      if (detailRecipients) detailRecipients.textContent = msg.recipients;
      if (detailDate) detailDate.textContent = msg.date;
      if (detailBody) detailBody.textContent = msg.body;

      if (detailStarBtn) {
        detailStarBtn.textContent = msg.starred ? "⭐ Destacado" : "☆ Destacar";
      }

      // Tags
      if (detailTags) {
        let tagHtml = "";
        if (msg.tags && msg.tags.length > 0) {
          msg.tags.forEach(t => {
            tagHtml += `<span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">${t}</span>`;
          });
        }
        detailTags.innerHTML = tagHtml;
      }

      // Attachment box
      if (msg.attachment && detailAttachmentBox) {
        detailAttachmentBox.classList.remove("hidden");
        if (attachmentName) attachmentName.textContent = msg.attachment.name;
        if (attachmentMeta) attachmentMeta.textContent = `Archivo oficial de Telemetría/Setup · Tamaño: ${msg.attachment.size || '12 KB'}`;
      } else if (detailAttachmentBox) {
        detailAttachmentBox.classList.add("hidden");
      }

      // Switch pane display
      if (emailListContainer) emailListContainer.classList.add("hidden");
      if (emailDetailContainer) {
        emailDetailContainer.classList.remove("hidden");
        emailDetailContainer.classList.add("flex");
      }
    }

    // Back to list view
    function backToList() {
      activeMessageId = null;
      if (emailDetailContainer) {
        emailDetailContainer.classList.add("hidden");
        emailDetailContainer.classList.remove("flex");
      }
      if (emailListContainer) {
        emailListContainer.classList.remove("hidden");
      }
      renderMailList();
    }

    // Attach back button
    const backBtn = document.getElementById("back-to-list-btn");
    if (backBtn) backBtn.addEventListener("click", backToList);

    // Star inside detail
    const detailStarBtn = document.getElementById("detail-star-btn");
    if (detailStarBtn) {
      detailStarBtn.addEventListener("click", () => {
        if (activeMessageId) {
          toggleStar(activeMessageId);
          const msg = messages.find(m => m.id === activeMessageId);
          if (msg) {
            detailStarBtn.textContent = msg.starred ? "⭐ Destacado" : "☆ Destacar";
          }
        }
      });
    }

    // Delete inside detail
    const detailDeleteBtn = document.getElementById("detail-delete-btn");
    if (detailDeleteBtn) {
      detailDeleteBtn.addEventListener("click", () => {
        if (activeMessageId) {
          const msg = messages.find(m => m.id === activeMessageId);
          if (msg) {
            msg.folder = "trash";
            saveMessages();
            showToast("Mensaje movido a la papelera");
            backToList();
          }
        }
      });
    }

    // Download Setup Simulation
    const downloadSetupBtn = document.getElementById("download-setup-btn");
    if (downloadSetupBtn) {
      downloadSetupBtn.addEventListener("click", () => {
        const msg = messages.find(m => m.id === activeMessageId);
        if (!msg || !msg.attachment) return;

        const dummySetup = `[CAR_SETUP_DATA]\nCAR=Porsche_992_GT3_R\nTRACK=Spa_Francorchamps\nAUTHOR=Muntrume_Motorsport\nCAMBER_FL=-3.8\nCAMBER_FR=-3.8\nPRESSURE_FL=26.8\nPRESSURE_FR=26.8\nWING=7\nBRAKE_BIAS=54.2\nTIMESTAMP=${Date.now()}`;
        const blob = new Blob([dummySetup], { type: "application/octet-stream" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = msg.attachment.name;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast(`Setup ${msg.attachment.name} descargado correctamente`);
      });
    }

    // Quick Reply Buttons inside Detail
    function setupReply() {
      const msg = messages.find(m => m.id === activeMessageId);
      if (!msg) return;

      openComposeModal({
        to: msg.sender.email,
        subject: msg.subject.startsWith("Re:") ? msg.subject : `Re: ${msg.subject}`,
        body: `\n\n--- Mensaje original de ${msg.sender.name} ---\n${msg.body}`
      });
    }

    const replyTopBtn = document.getElementById("detail-reply-top-btn");
    const replyBottomBtn = document.getElementById("detail-reply-bottom-btn");
    if (replyTopBtn) replyTopBtn.addEventListener("click", setupReply);
    if (replyBottomBtn) replyBottomBtn.addEventListener("click", setupReply);

    // Folder navigation clicks
    const folderButtons = document.querySelectorAll(".folder-btn");
    folderButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        folderButtons.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentFolder = btn.dataset.folder;
        backToList();
        // Close mobile drawer if open
        const sidebar = document.getElementById("mail-sidebar");
        if (sidebar && window.innerWidth < 768) {
          sidebar.classList.add("-translate-x-full");
        }
      });
    });

    // Category pills
    const categoryPills = document.querySelectorAll(".category-pill");
    categoryPills.forEach(pill => {
      pill.addEventListener("click", () => {
        categoryPills.forEach(p => p.classList.remove("active"));
        pill.classList.add("active");
        currentFilter = pill.dataset.filter;
        renderMailList();
      });
    });

    // Tag Filters
    const tagFilters = document.querySelectorAll(".tag-filter");
    tagFilters.forEach(tagBtn => {
      tagBtn.addEventListener("click", () => {
        const tag = tagBtn.dataset.tag;
        if (searchInput) {
          searchInput.value = tag;
          searchQuery = tag;
          renderMailList();
        }
      });
    });

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value.trim();
        renderMailList();
      });
    }

    // Refresh button
    const refreshBtn = document.getElementById("refresh-mailbox-btn");
    if (refreshBtn) {
      refreshBtn.addEventListener("click", () => {
        refreshBtn.classList.add("animate-spin");
        setTimeout(() => {
          refreshBtn.classList.remove("animate-spin");
          renderMailList();
          showToast("Buzón sincronizado con Cloudflare Relay");
        }, 600);
      });
    }

    // Mobile Sidebar Toggle
    const mobileToggle = document.getElementById("toggle-sidebar-mobile");
    const mailSidebar = document.getElementById("mail-sidebar");
    if (mobileToggle && mailSidebar) {
      mobileToggle.addEventListener("click", () => {
        mailSidebar.classList.toggle("-translate-x-full");
      });
    }

    // Driver Switcher dropdown
    if (driverSelector) {
      driverSelector.addEventListener("change", (e) => {
        const val = e.target.value;
        if (activeAvatar) {
          const initials = val.split("@")[0].substring(0, 2).toUpperCase();
          activeAvatar.textContent = initials;
        }
        if (composeFrom) {
          composeFrom.value = val;
        }
        showToast(`Buzón activo cambiado a ${val}`);
      });
    }

    // Quick Compose from directory buttons
    document.querySelectorAll(".quick-compose-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const targetEmail = btn.dataset.quickCompose;
        openComposeModal({ to: targetEmail });
      });
    });

    // =========================================================================
    // COMPOSE MODAL LOGIC & BREVO / CLOUDFLARE SUBMISSION
    // =========================================================================
    function openComposeModal(prefill = {}) {
      if (!composeModal) return;
      composeModal.classList.remove("hidden");
      composeModal.classList.add("flex");

      if (prefill.to && composeTo) composeTo.value = prefill.to;
      if (prefill.subject && composeSubject) composeSubject.value = prefill.subject;
      if (prefill.body && composeBody) {
        composeBody.value = prefill.body;
        composeBody.focus();
      } else if (composeTo) {
        composeTo.focus();
      }
    }

    function closeComposeModal() {
      if (!composeModal) return;
      composeModal.classList.add("hidden");
      composeModal.classList.remove("flex");
      if (composeForm) composeForm.reset();
      if (composeFileName) composeFileName.textContent = "Ninguno";
    }

    const openComposeBtn = document.getElementById("open-compose-btn");
    const openComposeHeaderBtn = document.getElementById("open-compose-header-btn");
    const closeComposeBtn = document.getElementById("close-compose-btn");
    const discardComposeBtn = document.getElementById("discard-compose-btn");

    if (openComposeBtn) openComposeBtn.addEventListener("click", () => openComposeModal());
    if (openComposeHeaderBtn) openComposeHeaderBtn.addEventListener("click", () => openComposeModal());
    if (closeComposeBtn) closeComposeBtn.addEventListener("click", closeComposeModal);
    if (discardComposeBtn) discardComposeBtn.addEventListener("click", closeComposeModal);

    // Recipient chips
    document.querySelectorAll(".driver-chip").forEach(chip => {
      chip.addEventListener("click", () => {
        if (composeTo) {
          composeTo.value = chip.dataset.chip;
        }
      });
    });

    // File input handler
    if (composeFileInput && composeFileName) {
      composeFileInput.addEventListener("change", (e) => {
        if (e.target.files && e.target.files[0]) {
          composeFileName.textContent = e.target.files[0].name;
          composeFileName.classList.add("text-emerald-400");
        } else {
          composeFileName.textContent = "Ninguno";
          composeFileName.classList.remove("text-emerald-400");
        }
      });
    }

    // Send Mail Submission via Cloudflare Pages Function + Brevo API
    if (composeForm) {
      composeForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const fromEmail = composeFrom ? composeFrom.value : "alberto@muntru.me";
        const toEmail = composeTo ? composeTo.value.trim() : "";
        const subject = composeSubject ? composeSubject.value.trim() : "";
        const bodyContent = composeBody ? composeBody.value.trim() : "";

        if (!toEmail || !subject || !bodyContent) {
          showToast("Por favor completa destinatario, asunto y mensaje", false);
          return;
        }

        // UI loading state
        if (sendBtnSpinner) sendBtnSpinner.classList.remove("hidden");
        if (sendBtnText) sendBtnText.textContent = "Enviando...";
        if (sendMailSubmitBtn) sendMailSubmitBtn.disabled = true;

        const brevoKey = localStorage.getItem(LS_BREVO_KEY) || "";

        try {
          // Send request to Cloudflare Pages Functions (/api/mail/send)
          const response = await fetch("/api/mail/send", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              ...(brevoKey ? { "api-key": brevoKey } : {})
            },
            body: JSON.stringify({
              fromEmail: fromEmail,
              fromName: "Muntrume Motorsport (" + fromEmail.split("@")[0] + ")",
              to: toEmail,
              subject: subject,
              textContent: bodyContent,
              apiKey: brevoKey
            })
          });

          const data = await response.json();

          // Add message to local sent folder
          const sentMessage = {
            id: "sent-" + Date.now(),
            folder: "sent",
            is_briefing: subject.toLowerCase().includes("briefing") || subject.toLowerCase().includes("setup"),
            unread: false,
            starred: false,
            sender: {
              name: fromEmail.split("@")[0].toUpperCase(),
              email: fromEmail,
              initials: fromEmail.substring(0, 2).toUpperCase(),
              role: "Driver / Team"
            },
            recipients: toEmail,
            subject: subject,
            snippet: bodyContent.substring(0, 80) + "...",
            body: bodyContent,
            date: "Ahora",
            timestamp: Date.now(),
            tags: ["Enviado"],
            attachment: composeFileName && composeFileName.textContent !== "Ninguno" ? {
              name: composeFileName.textContent,
              type: "setup",
              size: "12 KB"
            } : null
          };

          messages.unshift(sentMessage);
          saveMessages();

          closeComposeModal();

          if (data.simulated) {
            showToast("Mensaje registrado en Enviados (Brevo Relay listo)");
          } else {
            showToast("Correo enviado con éxito mediante Brevo SMTP");
          }

          updateCounters();
          if (currentFolder === "sent") {
            renderMailList();
          }

        } catch (err) {
          console.error("Error al enviar email:", err);
          // Even if server is in static mock mode, record sent mail locally
          const fallbackSent = {
            id: "sent-" + Date.now(),
            folder: "sent",
            is_briefing: false,
            unread: false,
            starred: false,
            sender: {
              name: fromEmail.split("@")[0].toUpperCase(),
              email: fromEmail,
              initials: fromEmail.substring(0, 2).toUpperCase()
            },
            recipients: toEmail,
            subject: subject,
            snippet: bodyContent.substring(0, 80) + "...",
            body: bodyContent,
            date: "Ahora",
            timestamp: Date.now(),
            tags: ["Enviado"]
          };
          messages.unshift(fallbackSent);
          saveMessages();
          closeComposeModal();
          showToast("Mensaje procesado y guardado en Enviados");
          updateCounters();
        } finally {
          if (sendBtnSpinner) sendBtnSpinner.classList.add("hidden");
          if (sendBtnText) sendBtnText.textContent = "Enviar";
          if (sendMailSubmitBtn) sendMailSubmitBtn.disabled = false;
        }
      });
    }

    // =========================================================================
    // BREVO API KEY SETTINGS MODAL
    // =========================================================================
    const openSettingsBtn = document.getElementById("open-settings-btn");
    const closeSettingsBtn = document.getElementById("close-settings-modal-btn");

    if (openSettingsBtn && settingsModal) {
      openSettingsBtn.addEventListener("click", () => {
        settingsModal.classList.remove("hidden");
        if (brevoApiKeyInput) {
          brevoApiKeyInput.value = localStorage.getItem(LS_BREVO_KEY) || "";
        }
      });
    }

    if (closeSettingsBtn && settingsModal) {
      closeSettingsBtn.addEventListener("click", () => {
        settingsModal.classList.add("hidden");
      });
    }

    if (saveSettingsBtn && brevoApiKeyInput) {
      saveSettingsBtn.addEventListener("click", () => {
        const key = brevoApiKeyInput.value.trim();
        if (key) {
          localStorage.setItem(LS_BREVO_KEY, key);
          showToast("Clave de Brevo API guardada");
        } else {
          localStorage.removeItem(LS_BREVO_KEY);
          showToast("Clave removida (usando Cloudflare Relay)");
        }
        if (settingsModal) settingsModal.classList.add("hidden");
      });
    }

    if (testBrevoBtn) {
      testBrevoBtn.addEventListener("click", async () => {
        const key = brevoApiKeyInput ? brevoApiKeyInput.value.trim() : "";
        if (!key) {
          showToast("Introduce una clave Brevo (xkeysib-...) para probar", false);
          return;
        }
        testBrevoBtn.textContent = "Probando...";
        try {
          const res = await fetch("https://api.brevo.com/v3/account", {
            headers: {
              "api-key": key,
              "accept": "application/json"
            }
          });
          if (res.ok) {
            const acc = await res.json();
            showToast(`Conectado a Brevo: ${acc.email}`);
          } else {
            showToast("Clave no válida en Brevo API", false);
          }
        } catch (e) {
          showToast("Error de conexión con Brevo API", false);
        } finally {
          testBrevoBtn.textContent = "Probar Conexión";
        }
      });
    }

    // Initial render
    renderMailList();
  })();
</script>
