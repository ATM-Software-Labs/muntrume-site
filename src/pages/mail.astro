    };

    function syncComposeSender(mailbox) {
      const verified = PILOT_SENDER_MAP[mailbox] || "alberto.muntrume@trujillomingorance.com";
      if (composeFrom) composeFrom.value = verified;
      const inlineReplySender = document.getElementById("inline-reply-sender");
