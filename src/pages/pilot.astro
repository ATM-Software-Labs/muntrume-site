---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Perfil de Piloto — Muntrume Motorsport";
const pageDescription = "Perfil oficial del piloto en Muntrume Motorsport Esports iRacing.";
---

<Layout title={pageTitle} description={pageDescription}>
<!-- Main Pilot Profile Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12 w-full space-y-8">
    
    <!-- Hero Profile Header Card -->
    <div class="glass-card rounded-3xl p-6 sm:p-10 relative overflow-hidden shadow-2xl border border-white/10">
      <!-- Background Ambient Glow -->
      <div id="ambientGlow" class="absolute -top-32 -right-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8 relative z-10">
        <!-- Avatar & Number Badge -->
        <div class="relative flex-shrink-0">
          <div id="driverAvatar" class="w-32 h-32 sm:w-40 sm:h-40 rounded-3xl border-2 border-emerald-500 bg-emerald-950/50 flex items-center justify-center text-4xl sm:text-5xl font-black text-emerald-400 shadow-2xl shadow-emerald-950/80">
            --
          </div>
          <div id="driverNumberBadge" class="absolute -bottom-3 -right-3 px-3 py-1 rounded-xl bg-[#0b0e13] border-2 border-emerald-500 text-emerald-400 font-mono font-black text-sm shadow-lg">
            #--
          </div>
        </div>

        <!-- Identity & Role -->
        <div class="flex-1 text-center md:text-left space-y-3">
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
            <span id="roleBadge" class="text-xs font-extrabold uppercase px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 tracking-wider">
              PILOTO OFICIAL
            </span>
            <span id="licenseBadge" class="text-xs font-semibold px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300">
              Licencia iRacing Oficial
            </span>
            <span id="locationBadge" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-400">
              🇪🇸 España
            </span>
          </div>

          <h1 id="driverName" class="text-3xl sm:text-5xl font-black text-white tracking-tight">
            Piloto Muntrume
          </h1>

          <p id="driverBio" class="text-sm sm:text-base text-neutral-300 leading-relaxed max-w-3xl">
            Cargando perfil oficial del piloto...
          </p>

          <!-- Core Attributes Quick Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 text-left">
            <div class="p-3 rounded-2xl bg-[#0b0e13]/60 border border-white/5">
              <div class="text-[10px] text-neutral-500 uppercase font-bold tracking-wider">Coche Habitual</div>
              <div id="primaryCar" class="text-xs font-bold text-white mt-0.5 truncate">Por definir</div>
            </div>
            <div class="p-3 rounded-2xl bg-[#0b0e13]/60 border border-white/5">
              <div class="text-[10px] text-neutral-500 uppercase font-bold tracking-wider">Categoría</div>
              <div id="specialty" class="text-xs font-bold text-white mt-0.5 truncate">Simracing Oficial</div>
            </div>
            <div class="p-3 rounded-2xl bg-[#0b0e13]/60 border border-white/5">
              <div class="text-[10px] text-neutral-500 uppercase font-bold tracking-wider">Buzón Oficial</div>
              <div id="driverEmail" class="text-xs font-mono font-bold text-cyan-300 mt-0.5 truncate">piloto@muntru.me</div>
            </div>
            <div class="p-3 rounded-2xl bg-[#0b0e13]/60 border border-white/5">
              <div class="text-[10px] text-neutral-500 uppercase font-bold tracking-wider">Estado de Verificación</div>
              <div id="verifyStatus" class="text-xs font-bold text-emerald-400 mt-0.5 truncate">Verificación Activa</div>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-2">
            <a id="vaultSetupsLink" href="/setups" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs transition flex items-center gap-1.5 shadow-lg shadow-emerald-500/20">
              <span id="vaultSetupsText">🏎️ Ver Setups en el Vault</span>
            </a>
            <a id="sendMailLink" href="/mail" class="px-4 py-2 rounded-xl bg-[#1c232d] hover:bg-white/10 border border-white/10 text-white font-bold text-xs transition flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>Contactar por Correo Interno</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Career Stats & Verification Status Cards -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg">📊</span>
          <h2 class="text-xl font-extrabold text-white">Estadísticas y Ficha iRacing</h2>
        </div>
        <span class="text-xs text-neutral-400 font-mono">Datos Oficiales Sin Alteraciones</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="glass-card rounded-2xl p-5 border border-white/5 space-y-1">
          <div class="text-[11px] text-neutral-400 uppercase font-semibold">Estado de Validación</div>
          <div id="statStatusLabel" class="text-base font-extrabold text-emerald-400 font-mono">Piloto Oficial Muntrume</div>
          <p class="text-[11px] text-neutral-400 leading-relaxed">
            Ficha en proceso de personalización directa con el piloto.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 space-y-1">
          <div class="text-[11px] text-neutral-400 uppercase font-semibold">Plataforma y Licencia</div>
          <div id="statPlatform" class="text-base font-extrabold text-cyan-400 font-mono">iRacing Simracing</div>
          <p class="text-[11px] text-neutral-400 leading-relaxed">
            Licencia verificada bajo la normativa de competición oficial.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 space-y-1">
          <div class="text-[11px] text-neutral-400 uppercase font-semibold">Club Deportivo</div>
          <div id="statClub" class="text-base font-extrabold text-white font-mono">Club Iberia / España</div>
          <p class="text-[11px] text-neutral-400 leading-relaxed">
            División regional de competición en eventos y ligas iRacing.
          </p>
        </div>

        <div class="glass-card rounded-2xl p-5 border border-white/5 space-y-1">
          <div class="text-[11px] text-neutral-400 uppercase font-semibold">Setups y Telemetría</div>
          <div id="statSetupsStatus" class="text-base font-extrabold text-amber-400 font-mono">Disponible en Vault</div>
          <p class="text-[11px] text-neutral-400 leading-relaxed">
            Sincronizado a través de Garage 61 (Colección 3).
          </p>
        </div>
      </div>
    </div>

    <!-- Section: Palmarés y Logros -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg">🏆</span>
          <h2 class="text-xl font-extrabold text-white">Palmarés y Logros Deportivos</h2>
        </div>
        <span class="text-xs text-neutral-400 font-mono">Recopilación Directa</span>
      </div>

      <div class="glass-card rounded-3xl p-6 sm:p-8 border border-white/10 text-center space-y-3">
        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 mx-auto text-xl">
          🏆
        </div>
        <h3 class="text-lg font-bold text-white">
          Dossier Deportivo en Actualización
        </h3>
        <p class="text-xs sm:text-sm text-neutral-400 max-w-2xl mx-auto leading-relaxed">
          Los datos de victorias, podios y campeonatos de <strong id="pilotNameNotice" class="text-white">este piloto</strong> se incorporarán directamente a medida que el piloto confirme qué hitos de su trayectoria desea destacar en su perfil oficial.
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[11px] text-neutral-400 mt-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Sin estadísticas inventadas · Transparencia y rigor institucional</span>
        </div>
      </div>
    </div>

    <!-- Section: Estilo de Conducción y Configuración Dinámica -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Telemetry Preferences -->
      <div class="glass-card rounded-3xl p-6 border border-white/10 space-y-3">
        <h3 class="text-sm font-extrabold text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
          <span>⚙️</span>
          <span>Preferencias de Pista</span>
        </h3>
        <p class="text-xs text-neutral-300 leading-relaxed" id="telemetryPhilosophy">
          Cargando configuración de pista...
        </p>
        <div class="space-y-2 pt-2 text-xs">
          <div class="flex justify-between border-b border-white/5 pb-1">
            <span class="text-neutral-500">Categoría Titular:</span>
            <span id="prefCategory" class="font-bold text-white">iRacing Official</span>
          </div>
          <div class="flex justify-between border-b border-white/5 pb-1">
            <span class="text-neutral-500">Especialidad:</span>
            <span id="prefSpecialty" class="font-bold text-emerald-400">Competición en Equipo</span>
          </div>
          <div class="flex justify-between">
            <span class="text-neutral-500">Telemetría:</span>
            <span id="prefTelemetry" class="font-bold text-white">Garage 61 Sync</span>
          </div>
        </div>
      </div>

      <!-- Team Role & Attribution -->
      <div class="glass-card rounded-3xl p-6 border border-white/10 space-y-3">
        <h3 class="text-sm font-extrabold text-cyan-400 uppercase tracking-wider flex items-center gap-1.5">
          <span>🛡️</span>
          <span>Equipo y Responsabilidades</span>
        </h3>
        <p class="text-xs text-neutral-300 leading-relaxed" id="teamRoleDescription">
          Cargando responsabilidades...
        </p>
        <div class="p-3 rounded-2xl bg-[#0b0e13]/60 border border-white/5 text-xs space-y-1">
          <div class="text-[10px] text-neutral-400 uppercase font-bold">Firma Institucional:</div>
          <div id="driverWatermark" class="font-mono text-emerald-400 text-[11px] truncate">
            muntru.me - Muntrume Motorsport.
          </div>
        </div>
      </div>

      <!-- Webmail Card -->
      <div class="glass-card rounded-3xl p-6 border border-white/10 space-y-3 flex flex-col justify-between">
        <div>
          <h3 class="text-sm font-extrabold text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
            <span>📫</span>
            <span>Buzón Oficial en Muntru.me</span>
          </h3>
          <p class="text-xs text-neutral-300 leading-relaxed pt-2">
            Puedes comunicarte con este piloto o coordinar sesiones de entreno a través del correo interno del equipo.
          </p>
        </div>
        <a id="composeMessageBtn" href="/mail" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-black font-extrabold text-xs transition text-center shadow-lg shadow-emerald-500/20">
          Redactar Mensaje a <span id="composeBtnName">Piloto</span> →
        </a>
      </div>
    </div>

  </main>

  <!-- Footer -->

<!-- Drivers Database & Dynamic Rendering Logic -->
  <script is:inline src="/assets/js/pilot.js?v=26s4.7" defer></script>
</Layout>
