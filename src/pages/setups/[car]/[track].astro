---
import Layout from "../../../layouts/Layout.astro";
import { buildSetupRoutePairs, getSetupTechSheet } from "../../../lib/setups-seo";

export function getStaticPaths() {
  return buildSetupRoutePairs().map(({ car, carSlug, track }) => ({
    params: { car: carSlug, track: track.slug },
    props: { car, carSlug, track },
  }));
}

const { car, carSlug, track } = Astro.props;
const sheet = getSetupTechSheet(car, track);
const title = `Setup ${car.brand} ${car.model} en ${track.name} · iRacing`;
const description = `Setup .sto y vuelta fantasma .blap para ${car.brand} ${car.model} en ${track.name}. Variantes Qualy, Race, Safe y Wet listas para MMT Sync.`;
const relatedTracks = buildSetupRoutePairs()
  .filter((p) => p.carSlug === carSlug && p.track.slug !== track.slug)
  .slice(0, 6);
---

<Layout title={title} description={description} canonical={`https://muntru.me/setups/${carSlug}/${track.slug}/`}>
  <main class="r-wrap py-10 sm:py-14">
    <nav class="text-xs font-mono text-[var(--r-muted)] mb-4 flex flex-wrap gap-2">
      <a href="/" class="hover:text-[var(--r-accent)]">Inicio</a>
      <span>/</span>
      <a href="/garage/" class="hover:text-[var(--r-accent)]">Garage</a>
      <span>/</span>
      <a href={`/setups/${carSlug}/`} class="hover:text-[var(--r-accent)]">{car.brand} {car.model}</a>
      <span>/</span>
      <span class="text-[var(--r-accent)] font-bold">{track.name}</span>
    </nav>

    <header class="rounded-2xl border border-[var(--r-line)] bg-[var(--r-surface)] p-6 sm:p-8 mb-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class={car.previewImg ? "lg:col-span-7" : "lg:col-span-12"}>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="px-2.5 py-1 rounded-lg bg-[var(--r-accent)]/15 border border-[var(--r-accent)]/35 text-[var(--r-accent)] font-mono text-xs font-bold">
              {car.carClass}
            </span>
            {sheet.variants.map((v) => (
              <span class="px-2 py-0.5 rounded bg-[var(--r-bg-2)] border border-[var(--r-line)] text-[var(--r-muted)] font-mono text-[11px]">{v}</span>
            ))}
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-[var(--r-text)] font-display tracking-tight">
            Setup {car.brand} {car.model} en {track.name} · iRacing
          </h1>
          <p class="mt-2 text-sm text-[var(--r-muted)]">
            Paquete técnico de Muntrume Motorsport con archivos <code class="text-[var(--r-accent)]">.sto</code> y vuelta fantasma <code class="text-[var(--r-accent)]">.blap</code> listos para sincronizar en tu carpeta de iRacing.
          </p>

          <div class="mt-5 flex flex-wrap gap-3">
            <a
              href={`mmtsync://sync?car=${encodeURIComponent(car.carFolder)}&track=${encodeURIComponent(track.slug)}`}
              id="btnLocalSyncTrigger"
              data-car={car.carFolder}
              data-track={track.slug}
              class="px-5 py-3 rounded-xl bg-[var(--r-accent)] text-[var(--r-accent-ink,#04130d)] font-bold text-sm hover:opacity-90 transition shadow-lg"
            >
              Sincronizar en 1 clic con MMT Sync
            </a>
            <a href="/calendar/" class="px-4 py-3 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg-2)] text-[var(--r-text)] text-sm font-semibold hover:border-[var(--r-accent)] transition">
              Ver semana en /calendar →
            </a>
            <a href={`/albums/?brand=${encodeURIComponent(car.brand)}`} class="px-4 py-3 rounded-xl border border-[var(--r-line)] bg-[var(--r-bg-2)] text-[var(--r-text)] text-sm font-semibold hover:border-[var(--r-accent)] transition">
              Galería {car.brand} →
            </a>
          </div>
        </div>
        {car.previewImg && (
          <div class="lg:col-span-5">
            <div class="aspect-[16/9] rounded-xl overflow-hidden border border-[var(--r-line)] bg-[var(--r-bg-2)]">
              <img
                src={car.previewImg}
                alt={`${car.brand} ${car.model}`}
                width="640"
                height="360"
                loading="eager"
                decoding="async"
                onerror="this.parentElement.parentElement.remove()"
                class="w-full h-full object-cover object-center"
              />
            </div>
          </div>
        )}
      </div>
    </header>

    <section class="rounded-2xl border border-[var(--r-line)] bg-[var(--r-surface)] p-6 mb-6">
      <h2 class="text-lg font-bold text-[var(--r-text)] font-display mb-4">Ficha técnica y parámetros clave</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <tbody class="divide-y divide-[var(--r-line)]">
            <tr>
              <th class="py-2.5 pr-4 font-mono text-xs text-[var(--r-muted)] uppercase">Carga aerodinámica</th>
              <td class="py-2.5 text-[var(--r-text)] font-medium">{sheet.downforce}</td>
            </tr>
            <tr>
              <th class="py-2.5 pr-4 font-mono text-xs text-[var(--r-muted)] uppercase">Temperatura asfalto objetivo</th>
              <td class="py-2.5 text-[var(--r-text)] font-medium">{sheet.targetTrackTemp}</td>
            </tr>
            <tr>
              <th class="py-2.5 pr-4 font-mono text-xs text-[var(--r-muted)] uppercase">Consumo estimado</th>
              <td class="py-2.5 text-[var(--r-text)] font-medium">{sheet.fuelPerLap}</td>
            </tr>
            <tr>
              <th class="py-2.5 pr-4 font-mono text-xs text-[var(--r-muted)] uppercase">Presiones en frío / Brake Bias</th>
              <td class="py-2.5 text-[var(--r-text)] font-medium">{sheet.coldPressure} · BB {sheet.brakeBias}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="rounded-2xl border border-[var(--r-line)] bg-[var(--r-surface)] p-6 mb-6">
      <h2 class="text-lg font-bold text-[var(--r-text)] font-display mb-4">Guía rápida de frenada por sector</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {sheet.sectors.map((s) => (
          <div class="rounded-xl border border-[var(--r-line)] bg-[var(--r-bg-2)] p-4">
            <h3 class="font-mono text-xs font-bold text-[var(--r-accent)] uppercase mb-1.5">{s.sector}</h3>
            <p class="text-xs text-[var(--r-muted)] leading-relaxed">{s.tip}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-base font-bold text-[var(--r-text)] font-display mb-3">Otros circuitos para {car.brand} {car.model}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {relatedTracks.map((rel) => (
          <a
            href={`/setups/${carSlug}/${rel.track.slug}/`}
            class="rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-3.5 hover:border-[var(--r-accent)] transition text-sm text-[var(--r-text)] hover:text-[var(--r-accent)]"
          >
            {rel.track.name} →
          </a>
        ))}
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const btn = document.getElementById("btnLocalSyncTrigger");
      if (!btn) return;
      btn.addEventListener("click", () => {
        const car = btn.getAttribute("data-car") || "";
        const track = btn.getAttribute("data-track") || "";
        fetch(`http://127.0.0.1:38421/sync?car=${encodeURIComponent(car)}&track=${encodeURIComponent(track)}`).catch(() => {});
      });
    })();
  </script>
</Layout>
