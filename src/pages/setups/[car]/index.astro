---
import Layout from "../../../layouts/Layout.astro";
import { getCarSlug, getProgrammaticSetupCars, getTopRoadTracks } from "../../../lib/setups-seo";

export function getStaticPaths() {
  const cars = getProgrammaticSetupCars();
  return cars.map((car) => ({
    params: { car: getCarSlug(car) },
    props: { car },
  }));
}

const { car } = Astro.props;
const carSlug = getCarSlug(car);
const tracks = getTopRoadTracks();
const title = `Setups ${car.brand} ${car.model} · iRacing`;
const description = `Descarga setups .sto (${car.carClass}) para ${car.brand} ${car.model} en iRacing: variantes Qualy, Race, Safe y Wet con sincronización automática vía MMT Sync.`;
---

<Layout title={title} description={description} canonical={`https://muntru.me/setups/${carSlug}/`}>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <nav class="text-xs font-mono text-white/60 mb-4 flex flex-wrap gap-2">
      <a href="/" class="hover:text-emerald-400">Inicio</a>
      <span>/</span>
      <a href="/garage/" class="hover:text-emerald-400">Garage</a>
      <span>/</span>
      <span class="text-emerald-400">{car.brand} {car.model}</span>
    </nav>

    <header class="rounded-2xl border border-white/10 bg-[#0d1117]/90 p-6 sm:p-8 mb-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="inline-block px-2.5 py-1 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-mono text-xs font-bold mb-3">
            {car.carClass} · {car.category}
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Setups {car.brand} {car.model} · iRacing
          </h1>
          <p class="mt-2 text-sm text-white/70 max-w-2xl">
            {car.specs || `Reglajes .sto verificados por el equipo Muntrume Motorsport para ${car.brand} ${car.model} en todas las variantes (Qualy, Race, Safe y Wet).`}
          </p>
        </div>
        <a
          href={`mmtsync://sync?car=${encodeURIComponent(car.carFolder)}`}
          class="px-5 py-3 rounded-xl bg-emerald-500 text-slate-950 font-bold text-sm hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20"
        >
          Sincronizar en 1 clic con MMT Sync
        </a>
      </div>

      <div class="mt-5 flex flex-wrap gap-3 text-xs font-mono">
        <a href="/calendar/" class="px-3 py-1.5 rounded-lg border border-white/15 text-white/80 hover:border-emerald-400 hover:text-emerald-300 transition">
          Ver calendario 2026 →
        </a>
        <a href="/albumes/" class="px-3 py-1.5 rounded-lg border border-white/15 text-white/80 hover:border-emerald-400 hover:text-emerald-300 transition">
          Álbumes {car.brand} →
        </a>
        <a href="/app/" class="px-3 py-1.5 rounded-lg border border-white/15 text-white/80 hover:border-emerald-400 hover:text-emerald-300 transition">
          Descargar MMT Sync →
        </a>
      </div>
    </header>

    <section aria-labelledby="tracks-heading">
      <h2 id="tracks-heading" class="text-xl font-bold text-white mb-4">
        Circuitos disponibles para {car.brand} {car.model} ({tracks.length})
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tracks.map((track) => (
          <a
            href={`/setups/${carSlug}/${track.slug}/`}
            class="group rounded-xl border border-white/10 bg-[#0d1117]/80 p-4 hover:border-emerald-400/50 transition flex flex-col justify-between gap-2"
          >
            <div>
              <span class="text-[11px] font-mono text-emerald-400 uppercase">{car.carClass} · .STO + .BLAP</span>
              <h3 class="text-base font-bold text-white group-hover:text-emerald-300 mt-1">{track.name}</h3>
            </div>
            <span class="text-xs font-mono text-white/60 group-hover:text-white">Ver tabla técnica y sincronizar →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
