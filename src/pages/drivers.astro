---
import Layout from '../layouts/Layout.astro';
import DriverCard from '../components/DriverCard.astro';
import TeamBand from '../components/TeamBand.astro';
import { PILOTOS, LICENCE_UPDATED_LABEL } from '../lib/pilotos';

const pageTitle = "Drivers | Muntrume Motorsport";
const pageDescription = `Official driver roster of Muntrume Motorsport: ${PILOTOS.map(p => p.fullName).join(", ")}. Sports Car license, GT3/GT4 endurance telemetry hours, and Muntrume Telemetry Index (MTI) performance ratings.`;
---

<Layout title={pageTitle} description={pageDescription} canonical="https://muntru.me/drivers/">
  <section class="r-section" style="border-top:0;padding-top:clamp(80px,8vw,104px);padding-bottom:40px" aria-labelledby="plTitle">
    <div class="r-wrap max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="r-head" style="margin-bottom:16px">
        <div>
          <p class="r-kicker">Official Roster 2026 · Sports Car, GT3, GT4 &amp; Multiclass Endurance</p>
          <h1 id="plTitle" class="r-h2">Drivers</h1>
          <p class="r-lead">{PILOTOS.length} official drivers. Sports Car license &amp; real hours on track weighted by lap time.</p>
          <p class="r-meta" id="licenceUpdated">Updated: <time datetime="2026-11-07">{LICENCE_UPDATED_LABEL}</time></p>
        </div>
      </div>
      <TeamBand />
      <div class="d-grid grid grid-cols-1 lg:grid-cols-3 gap-5 items-stretch w-full">
        {PILOTOS.map(p => (
          <DriverCard driver={p} heading="h2" />
        ))}
      </div>
    </div>
  </section>
  <script is:inline src="/assets/js/home-r.js?v=t295" defer></script>
</Layout>
