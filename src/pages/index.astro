---
import Layout from '../layouts/Layout.astro';
import DriverCard from '../components/DriverCard.astro';
import TeamBand from '../components/TeamBand.astro';
import { PILOTOS, LICENCE_UPDATED_LABEL } from '../lib/pilotos';
import catalog from '../../public/assets/data/catalog_index.json';

const pageTitle = "Muntrume Motorsport | Equipo de sim racing en iRacing — Barcelona";
const pageDescription = "Muntrume Motorsport: equipo de sim racing de Sant Andreu (Barcelona) en iRacing. Pilotos oficiales, calendario, Setup Vault con más de 41.000 setups y sala de prensa.";
const fmt = (n: number) => n.toLocaleString('es-ES');
const figs = [
  { n: String(PILOTOS.length), l: "Pilotos oficiales" },
  { n: fmt(catalog.total_setups), l: "Setups en el catálogo" },
  { n: String(catalog.cars.length), l: "Coches" },
  { n: String(catalog.circuits.length), l: "Circuitos" },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <link slot="head" rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset="/assets/img/hero-bg-640.avif 640w, /assets/img/hero-bg-960.avif 960w, /assets/img/hero-bg-1280.avif 1280w" imagesizes="100vw" />

  <!-- 1 · HERO -->
  <section class="r-hero" aria-labelledby="heroTitle">
    <picture>
      <source type="image/avif" srcset="/assets/img/hero-bg-640.avif 640w, /assets/img/hero-bg-960.avif 960w, /assets/img/hero-bg-1280.avif 1280w" sizes="100vw" />
      <source type="image/webp" srcset="/assets/img/hero-bg-640.webp 640w, /assets/img/hero-bg-960.webp 960w, /assets/img/hero-bg-1280.webp 1280w, /assets/img/hero-bg.webp 1920w" sizes="100vw" />
      <img src="/assets/img/hero-bg-1280.webp" width="1920" height="1080" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="r-wrap">
      <p class="r-kicker">Muntrume Motorsport · Sant Andreu, Barcelona</p>
      <h1 id="heroTitle" class="r-h1">Sim racing con método.</h1>
      <p class="r-lead">Equipo de sim racing en iRacing. Preparación, setups y trabajo de equipo para competir en GT3, prototipos y resistencia.</p>
      <div class="r-hero__cta">
        <a href="/pilotos" class="r-btn r-btn--primary">Conoce a los pilotos</a>
        <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="r-btn r-btn--ghost">Únete en Discord</a>
      </div>
      <div class="r-hero__meta">
        {figs.map(f => (<div><strong>{f.n}</strong>{f.l}</div>))}
      </div>
    </div>
  </section>

  <!-- 2 · PILOTOS -->
  <section class="r-section" aria-labelledby="driversTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">Plantilla 2026</p>
          <h2 id="driversTitle" class="r-h2">Pilotos</h2>
        </div>
        <a href="/pilotos" class="r-link">Ver plantilla</a>
      </div>
      <p class="r-meta" id="licenceUpdated">Actualizado: <time datetime="2026-11-06">{LICENCE_UPDATED_LABEL}</time></p>
      <TeamBand />
      <div class="d-grid">
        {PILOTOS.map(p => (
          <DriverCard driver={p} heading="h3" />
        ))}
      </div>
    </div>
  </section>

  <!-- 3 · CALENDARIO (solo eventos reales de Race Control) -->
  <section class="r-section r-section--alt" aria-labelledby="calTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">Temporada</p>
          <h2 id="calTitle" class="r-h2">Calendario</h2>
        </div>
      </div>
      <ul class="r-list" id="calList" hidden></ul>
      <p class="r-empty" id="calEmpty">No hay próximos eventos publicados. El calendario se actualiza desde Race Control.</p>
    </div>
  </section>

  <!-- 4 · EL EQUIPO / VALORES -->
  <section class="r-section" aria-labelledby="aboutTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">El equipo</p>
          <h2 id="aboutTitle" class="r-h2">Quiénes somos</h2>
          <p class="r-lead">Un equipo de amigos de Sant Andreu y Costa Rica que compite en iRacing con la organización de un equipo profesional: preparación, datos y comunicación en carrera.</p>
        </div>
      </div>
      <div class="r-cols">
        <div class="r-value"><h3 class="r-h3">Preparación</h3><p>Setups organizados por coche, circuito y temporada en el Setup Vault del equipo, accesible solo para pilotos.</p></div>
        <div class="r-value"><h3 class="r-h3">Datos</h3><p>Las cifras de los pilotos se publican solo cuando vienen de iRacing. Nada inventado, nada estimado.</p></div>
        <div class="r-value"><h3 class="r-h3">Equipo</h3><p>Comunicación por radio en Discord, estrategia compartida y relevos coordinados en carreras de resistencia.</p></div>
      </div>
    </div>
  </section>

  <!-- 5 · PRENSA / CONTACTO -->
  <section class="r-section r-section--alt" aria-labelledby="pressTitle">
    <div class="r-wrap r-cols" style="align-items:end">
      <div style="display:grid;gap:16px">
        <p class="r-kicker">Prensa</p>
        <h2 id="pressTitle" class="r-h2">Sala de prensa</h2>
        <p class="r-lead">Crónicas, comunicados y novedades del equipo.</p>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/news" class="r-btn r-btn--primary">Ver noticias</a>
        <a href="/contact" class="r-btn" style="border-color:var(--r-line-2);color:var(--r-text)">Contacto</a>
      </div>
    </div>
  </section>

  <script is:inline src="/assets/js/home-r.js?v=t288" defer></script>
</Layout>
