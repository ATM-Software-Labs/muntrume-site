    .mmt-week-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-top: 16px; }
    .mmt-week-links { display: flex; flex-wrap: wrap; gap: 16px; }

    /* CALENDAR BANNER & METHOD CARDS */
    .mmt-cal-banner {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px;
      padding: 24px; border-radius: 18px; border: 1px solid var(--r-line);
