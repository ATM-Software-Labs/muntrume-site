---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Muntrume Motorsport · Sim Racing Team";
const pageDescription = "Muntrume Motorsport is a sim racing team from Barcelona racing on iRacing, with a private setup vault for our drivers.";
---

<Layout title={pageTitle} description={pageDescription}>
<!-- ========================================================================= -->
  <!-- 2. HERO FULLSCREEN (Modern Motorsport Luxury)                             -->
  <!-- ========================================================================= -->
  <section id="overview" class="relative min-h-[85vh] lg:min-h-screen flex items-center justify-center overflow-hidden pt-16">
    
    <!-- Background Image with High Quality Cover -->
    <img 
      src="/assets/img/hero-bg.webp" 
      srcset="/assets/img/hero-bg-960.webp 960w, /assets/img/hero-bg.webp 1920w"
      sizes="100vw"
      width="1920" height="1080"
      alt="Muntrume Motorsport Virtual Racing Squad at Le Mans" 
      class="absolute inset-0 w-full h-full object-cover object-[70%_center] sm:object-center select-none pointer-events-none"
      fetchpriority="high"
      decoding="async"
    >
    
    <!-- Seamless Gradient Overlays (Smooth transition to #0e1217) -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0e1217] via-[#0e1217]/70 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#0e1217] via-[#0e1217]/85 sm:via-[#0e1217]/65 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0e1217]/90 via-transparent to-transparent h-28 z-10"></div>

    <!-- Hero Content Container -->
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 relative z-20 py-12 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: Mission & Headline -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Event Status Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#161c24]/90 border border-white/10 backdrop-blur-md text-xs">
            <span class="pulse-dot"></span>
            <span class="text-neutral-300 font-medium" id="hero-live-badge">iRacing sim racing · Barcelona</span>
          </div>

          <!-- Main Title -->
          <div class="space-y-2">
            <div class="text-xs sm:text-sm tracking-widest text-emerald-400 uppercase font-bold">
              Sim Racing &amp; Setups
            </div>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08]">
              PRECISION RACING. <br>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-emerald-300 to-teal-200">
                ENGINEERED TO WIN.
              </span>
            </h1>
          </div>

          <!-- Technical Subtitle -->
          <p class="text-sm sm:text-base text-neutral-300 max-w-xl font-normal leading-relaxed">
            Muntrume Motorsport is a sim racing team from Barcelona racing on iRacing, with a private setup vault for our drivers.
          </p>

          <!-- Multi-Class Spec Chips -->
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300 font-medium">GT3 Endurance</span>
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300 font-medium">Prototypes (GTP)</span>
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300 font-medium">Single-Seater</span>
            <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-neutral-300 font-medium">Mazda MX-5 Cup</span>
          </div>

                    <!-- Action Buttons -->
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="/setups" class="inline-flex items-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-extrabold text-xs uppercase tracking-wider px-5 py-3 rounded-lg transition-all shadow-lg hover:shadow-emerald-500/20">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
              <span>Setup Vault (41.016 Setups)</span>
            </a>
            <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 bg-white/10 hover:bg-white/15 text-white border border-white/15 font-semibold text-xs uppercase tracking-wider px-5 py-3 rounded-lg transition-all">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.13-.255-.01-.556-.28-.646a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
              </svg>
              <span>Join Race Comms</span>
            </a>
            <a href="/team" class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 text-white border border-white/10 hover:border-white/20 font-semibold text-xs uppercase tracking-wider px-5 py-3 rounded-lg transition-all">
              <span>Explore Driver Roster</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

        </div>

        <!-- Right Column: Next Race & Season Overview Card -->
        <div class="lg:col-span-5" id="hud">
          <div class="bg-[#161c24] border border-white/10 rounded-2xl overflow-hidden shadow-2xl backdrop-blur-sm">
            
            <!-- Top Bar -->
            <div class="bg-[#1c232d] px-5 py-3 border-b border-white/10 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2 text-neutral-300 font-semibold">
                <span id="hud-status-label">Race Calendar</span>
              </div>
              <div class="flex items-center gap-2 text-emerald-400 font-medium" id="hud-status-wrap">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" id="hud-status-dot"></span>
                <span id="hud-status-badge">Loading</span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6 space-y-5">
              
              <!-- Next Event & Circuit -->
              <div class="pb-4 border-b border-white/10">
                <div class="text-[11px] uppercase tracking-wider text-neutral-400 mb-1 font-medium">Event &amp; Circuit</div>
                <div class="text-lg font-bold text-white flex items-center justify-between" id="hud-next-event">
                  <span>—</span>
                </div>
              </div>

              <!-- Metrics 2x2 Grid -->
              <div class="grid grid-cols-2 gap-3 pb-4 border-b border-white/10">
                <div class="bg-[#1c232d]/70 p-3.5 rounded-xl border border-white/5">
                  <div class="text-[11px] uppercase text-neutral-400 font-medium">Active Squad</div>
                  <div class="text-xl font-bold text-white mt-0.5">4 <span class="text-xs font-normal text-emerald-400">Drivers</span></div>
                </div>

                <div class="bg-[#1c232d]/70 p-3.5 rounded-xl border border-white/5">
                  <div class="text-[11px] uppercase text-neutral-400 font-medium">Setup Vault</div>
                  <div class="text-xl font-bold text-emerald-400 mt-0.5">41,016 <span class="text-xs font-normal text-neutral-400">setups</span></div>
                  <div class="text-[11px] text-neutral-400 mt-0.5">105 cars · 127 circuits</div>
                </div>

                <div class="bg-[#1c232d]/70 p-3.5 rounded-xl border border-white/5">
                  <div class="text-[11px] uppercase text-neutral-400 font-medium">Platform &amp; Base</div>
                  <div class="text-sm font-semibold text-white mt-1 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>iRacing</span>
                  </div>
                  <div class="text-[11px] text-neutral-400 mt-0.5">Barcelona, ESP</div>
                </div>

                <div class="bg-[#1c232d]/70 p-3.5 rounded-xl border border-white/5">
                  <div class="text-[11px] uppercase text-neutral-400 font-medium">Competition Class</div>
                  <div class="text-sm font-semibold text-white mt-1">Community</div>
                  <div class="text-[11px] text-neutral-400 mt-0.5"><a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="text-emerald-400">Discord</a></div>
                </div>
              </div>

              <!-- Live Countdown To Race -->
              <div>
                <div class="flex items-center justify-between text-xs text-neutral-400 mb-2.5 font-medium">
                  <span id="hud-countdown-label">Next race</span>
                  <span class="text-emerald-400 font-semibold" id="hud-target-date">—</span>
                </div>
                <div class="grid grid-cols-4 gap-2.5 text-center" id="hud-countdown">
                  <div class="bg-[#1c232d] border border-white/10 p-3 rounded-xl">
                    <div class="text-xl font-extrabold text-white" id="cd-days">--</div>
                    <div class="text-[10px] uppercase text-neutral-400 font-medium mt-0.5">Days</div>
                  </div>
                  <div class="bg-[#1c232d] border border-white/10 p-3 rounded-xl">
                    <div class="text-xl font-extrabold text-white" id="cd-hours">--</div>
                    <div class="text-[10px] uppercase text-neutral-400 font-medium mt-0.5">Hours</div>
                  </div>
                  <div class="bg-[#1c232d] border border-white/10 p-3 rounded-xl">
                    <div class="text-xl font-extrabold text-white" id="cd-mins">--</div>
                    <div class="text-[10px] uppercase text-neutral-400 font-medium mt-0.5">Mins</div>
                  </div>
                  <div class="bg-[#1c232d] border border-white/10 p-3 rounded-xl">
                    <div class="text-xl font-extrabold text-white" id="cd-secs">--</div>
                    <div class="text-[10px] uppercase text-neutral-400 font-medium mt-0.5">Secs</div>
                  </div>
                </div>
              </div>

            </div>

            <!-- Bottom Action Link -->
            <div class="bg-[#1c232d]/60 px-6 py-3 border-t border-white/10 flex items-center justify-between text-xs">
              <span class="text-neutral-400">Official calendar</span>
              <a href="https://www.iracing.com/special-events/" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-semibold flex items-center gap-1.5 transition" style="min-height:44px">
                <span>iRacing special events</span>
                <span>↗</span>
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- ========================================================================= -->
  <!-- 3. TEAM METRICS RIBBON (Clean, Athletic & Minimalist)                     -->
  <!-- ========================================================================= -->
  <section class="border-y border-white/10 bg-[#161c24]/60 backdrop-blur-sm py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        
        <div class="p-2 border-r border-white/10 last:border-none">
          <div class="text-3xl sm:text-5xl font-extrabold text-white">4</div>
          <div class="text-xs text-neutral-400 uppercase tracking-wider font-medium mt-1.5">Drivers</div>
        </div>

        <div class="p-2 border-r border-white/10 last:border-none">
          <div class="text-3xl sm:text-5xl font-extrabold text-emerald-400">41,016</div>
          <div class="text-xs text-neutral-400 uppercase tracking-wider font-medium mt-1.5">Setups in the Vault</div>
        </div>

        <div class="p-2 border-r border-white/10 last:border-none">
          <div class="text-3xl sm:text-5xl font-extrabold text-white">105</div>
          <div class="text-xs text-neutral-400 uppercase tracking-wider font-medium mt-1.5">Cars Covered</div>
        </div>

        <div class="p-2">
          <div class="text-3xl sm:text-5xl font-extrabold text-emerald-400">127</div>
          <div class="text-xs text-neutral-400 uppercase tracking-wider font-medium mt-1.5">Circuits</div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. SQUAD SPOTLIGHT & MACHINERY (Consolidated Teaser -> team.html)          -->
  <!-- ========================================================================= -->
  <section id="squad-spotlight" class="py-20 bg-[#0e1217] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12 pb-6 border-b border-white/10">
        <div>
          <span class="text-xs uppercase tracking-wider text-emerald-400 font-semibold">El Equipo</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-1">Nuestros Pilotos</h2>
        </div>
        <div>
          <a href="/team" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-semibold text-xs transition shadow-md">
            <span>Ver Plantilla Completa</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Athlete Roster Teaser Banner -->
      <div class="bg-gradient-to-r from-[#161c24] via-[#1c232d] to-[#161c24] border border-white/10 rounded-3xl p-8 sm:p-10 shadow-2xl mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-wider">
              <span>iRacing</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
              Cuatro pilotos, una misma pasión en pista.
            </h3>
            <div class="flex flex-wrap gap-4 pt-2">
              <a href="/team" class="inline-flex items-center gap-2 text-xs font-semibold text-emerald-400 hover:text-emerald-300 transition">
                <span>Ver perfiles de pilotos</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="grid grid-cols-2 gap-3.5">
              <!-- Alberto -->
              <a href="/team" class="group bg-[#0e1217]/80 hover:bg-[#0e1217] border border-white/10 hover:border-emerald-500/40 p-4 rounded-2xl transition duration-300 block">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-emerald-500/20 border border-emerald-500/60 flex items-center justify-center font-bold text-emerald-400 text-xs group-hover:scale-105 transition-transform">AT</div>
                  <div class="min-w-0">
                    <div class="font-bold text-white text-xs leading-tight group-hover:text-emerald-400 transition-colors">Alberto Trujillo</div>
                    <div class="text-[11px] text-emerald-400 font-medium">Founder</div>
                  </div>
                </div>
              </a>
              <!-- Mateo -->
              <a href="/team" class="group bg-[#0e1217]/80 hover:bg-[#0e1217] border border-white/10 hover:border-amber-500/40 p-4 rounded-2xl transition duration-300 block">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-amber-500/20 border border-amber-500/60 flex items-center justify-center font-bold text-amber-400 text-xs group-hover:scale-105 transition-transform">MB</div>
                  <div class="min-w-0">
                    <div class="font-bold text-white text-xs leading-tight group-hover:text-amber-400 transition-colors">Mateo Berbis</div>
                    <div class="text-[11px] text-amber-400 font-medium">Driver</div>
                  </div>
                </div>
              </a>
              <!-- Eduardo -->
              <a href="/team" class="group bg-[#0e1217]/80 hover:bg-[#0e1217] border border-white/10 hover:border-slate-400/40 p-4 rounded-2xl transition duration-300 block">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-slate-500/20 border border-slate-400/60 flex items-center justify-center font-bold text-slate-300 text-xs group-hover:scale-105 transition-transform">EC</div>
                  <div class="min-w-0">
                    <div class="font-bold text-white text-xs leading-tight group-hover:text-slate-200 transition-colors">Eduardo Chongkan</div>
                    <div class="text-[11px] text-slate-300 font-medium">Driver</div>
                  </div>
                </div>
              </a>
              <!-- Juanlu -->
              <a href="/team" class="group bg-[#0e1217]/80 hover:bg-[#0e1217] border border-white/10 hover:border-orange-500/40 p-4 rounded-2xl transition duration-300 block">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-orange-500/20 border border-orange-500/60 flex items-center justify-center font-bold text-orange-400 text-xs group-hover:scale-105 transition-transform">JC</div>
                  <div class="min-w-0">
                    <div class="font-bold text-white text-xs leading-tight group-hover:text-orange-400 transition-colors">Juanlu Carrillo</div>
                    <div class="text-[11px] text-orange-400 font-medium">Driver</div>
                  </div>
                </div>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>


  <!-- ========================================================================= -->
  <!-- 5B. MUNTRUME SETUP VAULT LANDING SECTION (41,016 .sto Setups)   -->
  <!-- ========================================================================= -->
  <section id="setups-vault" class="py-20 bg-[#0e1217] border-t border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="bg-gradient-to-br from-[#161c24] via-[#1c232d] to-[#161c24] border border-emerald-500/25 rounded-3xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-600"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

          <!-- Left Column: Setup Vault Pitch -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-semibold text-emerald-400 uppercase tracking-wider">
              <span class="pulse-dot"></span>
              <span>Temporada 2026 Season 4</span>
            </div>

            <div class="space-y-2">
              <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
                Muntrume Setup Vault
              </h2>
              <p class="text-sm sm:text-base text-neutral-300 leading-relaxed max-w-2xl">
                Nuestro repositorio de setups de competición para <strong>iRacing</strong> con <strong>41.016 configuraciones <code class="text-emerald-400">.sto</code></strong> distribuidas en <strong>105 coches</strong> y <strong>127 circuitos</strong>. Vincula tu carpeta <code class="text-emerald-400">Documents\iRacing\setups</code> y guarda cada semana directamente en ella.
              </p>
            </div>

            <!-- Feature Chips -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div class="bg-[#0e1217]/80 border border-white/10 rounded-2xl p-4 flex items-start gap-3">
                <span class="text-emerald-400 font-bold text-base">⚡</span>
                <div>
                  <div class="font-bold text-white">Guardado directo en tu carpeta</div>
                  <div class="text-neutral-400 mt-0.5">Guarda la carpeta de la semana directamente en <code class="text-emerald-400">Garage 61 - Muntrume Motorsport</code>.</div>
                </div>
              </div>
              <div class="bg-[#0e1217]/80 border border-white/10 rounded-2xl p-4 flex items-start gap-3">
                <span class="text-emerald-400 font-bold text-base">🏁</span>
                <div>
                  <div class="font-bold text-white">Qualy, Race y Wet</div>
                  <div class="text-neutral-400 mt-0.5">Variantes por tipo de sesión según el catálogo de cada semana.</div>
                </div>
              </div>
            </div>

            <!-- CTAs -->
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a href="/setups" class="inline-flex items-center gap-2.5 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-extrabold text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl transition-all shadow-lg hover:shadow-emerald-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>Entrar al Setup Vault &rarr;</span>
              </a>
              <a href="/setups#join" class="inline-flex items-center gap-2 bg-[#0e1217] hover:bg-white/10 text-emerald-400 border border-emerald-500/30 font-bold text-xs uppercase tracking-wider px-6 py-3.5 rounded-xl transition-all">
                <span>Solicitar Acceso de Piloto</span>
              </a>
            </div>
          </div>

          <!-- Right Column: Vault Stats & Active Categories Card -->
          <div class="lg:col-span-5">
            <div class="bg-[#0e1217] border border-white/10 rounded-2xl p-6 space-y-5 shadow-xl">
              <div class="flex items-center justify-between pb-3 border-b border-white/10">
                <span class="text-xs font-bold uppercase tracking-wider text-neutral-400">Estado del repositorio</span>
                
              </div>

              <div class="grid grid-cols-3 gap-2 text-center">
                <div class="bg-[#161c24] border border-white/5 rounded-xl p-3.5">
                  <div class="text-2xl font-black text-white">105</div>
                  <div class="text-[10px] uppercase text-neutral-400 font-semibold mt-0.5">Coches</div>
                </div>
                <div class="bg-[#161c24] border border-white/5 rounded-xl p-3.5">
                  <div class="font-black text-emerald-400" style="font-size:clamp(1.05rem,5vw,1.5rem);line-height:2rem">41.016</div>
                  <div class="text-[10px] uppercase text-neutral-400 font-semibold mt-0.5">Setups</div>
                </div>
                <div class="bg-[#161c24] border border-white/5 rounded-xl p-3.5">
                  <div class="text-2xl font-black text-white">127</div>
                  <div class="text-[10px] uppercase text-neutral-400 font-semibold mt-0.5">Circuitos</div>
                </div>
