    .g-media-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* RESPONSIVE BREAKPOINTS */
    @media (max-width: 1120px) {
      .g-hero-grid {
        grid-template-columns: 1fr;
      }
      .g-bento-card,
      .g-bento-card--wide,
      .g-bento-card--tall {
        grid-column: span 6 / span 6;
