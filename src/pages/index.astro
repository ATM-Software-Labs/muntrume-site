    .mmt-cal-banner p { margin: 0; max-width: 62ch; }
    .mmt-cal-banner__actions { display: flex; flex-wrap: wrap; gap: 10px; }

    .g-method-card {
      background: var(--r-surface);
      border: 1px solid var(--r-line);
