---
import Layout from '../layouts/Layout.astro';
import DriverCard from '../components/DriverCard.astro';
import TeamBand from '../components/TeamBand.astro';
import { PILOTOS, LICENCE_UPDATED_LABEL } from '../lib/pilotos';
import catalog from '../../public/assets/data/catalog_index.json';
import schedule from '../../desktop/src/season_schedule_2026_s4.json';
import desktopPkg from '../../desktop/package.json';
import { OFFICIAL_BRAND_PATHS } from '../../desktop/src/cars/brand-icons';

// "Esta semana": Top 5 series Open con mayor participación semanal en iRacing 2026 S4 (incluyendo GT Sprint GT3; las Fixed usan el setup oficial de iRacing).
const GT3_CARS = 'acuransxevo22gt3,amvantageevogt3,audir8gt3,audir8lmsevo2gt3,bmwm4gt3,chevyvettez06rgt3,ferrari296gt3,fordmustanggt3,lamborghinievogt3,mclaren720sgt3,mercedesamgevogt3,mercedesamggt3,porsche992rgt3';
const IMSA_CARS = `acuraarx06gtp,amvalkyriegtp,bmwlmdh,cadillacvseriesrgtp,dallarap217,ferrari499p,porsche963gtp,${GT3_CARS}`;
const PCC_CARS = 'mx5 cup,toyotagr86,bmwm2csr,bmwm2g87,renaultcliocup';

const FEATURED = [
  { prefix: 'IMSA iRacing Series by GO Fast', schedule: '45 min · Cada 2h (:45 UTC)', img: '/assets/img/series/imsa.jpg', cars: IMSA_CARS, badge: 'MULTICLASS · GTP/LMP2/GT3' },
  { prefix: 'GT Sprint Series by Simucube', schedule: '40 min · Cada 2h (:00 UTC)', img: '/assets/img/series/gt-sprint.jpg', cars: GT3_CARS, badge: 'GT3 OPEN · SPRINT' },
  { prefix: 'Production Car Challenge by Sim-Lab', schedule: '25 min · Cada 1h (:30 UTC)', img: '/assets/img/series/pcc.jpg', cars: PCC_CARS, badge: 'MULTICLASS · TOURING' },
  { prefix: 'iRacing Porsche Cup by CONSPIT', schedule: '19 vueltas · Cada 2h (:45 UTC)', img: '/assets/img/series/porsche-cup.jpg', car: 'porsche992cup', badge: '992 GT3 CUP · OPEN' },
  { prefix: 'Formula C - Super Formula Lights by RSS', schedule: '30 min · Cada 2h (:15 UTC)', img: '/assets/img/series/sfl.jpg', car: 'superformulalights324', badge: 'SFL 324 · OPEN' },
];

const SHOWCASE_BRANDS = [
  { name: 'Porsche', code: 'P911 / P963', color: '#D5001C', path: OFFICIAL_BRAND_PATHS['logo-porsche'] },
  { name: 'Ferrari', code: 'F296 / F499P', color: '#DC0000', path: OFFICIAL_BRAND_PATHS['logo-ferrari'] },
  { name: 'BMW M', code: 'M4 / BMWH', color: '#1C69D4', path: OFFICIAL_BRAND_PATHS['logo-bmw'] },
  { name: 'Ford', code: 'FORD GT3', color: '#38BDF8', path: OFFICIAL_BRAND_PATHS['logo-ford'] },
  { name: 'McLaren', code: 'MACLA 720S', color: '#FF8700', path: OFFICIAL_BRAND_PATHS['logo-mclaren'] },
  { name: 'Mercedes-AMG', code: 'AMG GT3', color: '#00D2BE', path: OFFICIAL_BRAND_PATHS['logo-mercedes'] },
  { name: 'Aston Martin', code: 'AMR / VALK', color: '#2DD4BF', path: OFFICIAL_BRAND_PATHS['logo-aston'] },
  { name: 'Cadillac', code: 'CADDY GTP', color: '#D4AF37', path: OFFICIAL_BRAND_PATHS['logo-cadillac'] },
  { name: 'Corvette', code: 'VETTE Z06', color: '#EAB308', path: OFFICIAL_BRAND_PATHS['logo-chevy'] },
  { name: 'Audi Sport', code: 'R8 EVO II', color: '#F43F5E', path: OFFICIAL_BRAND_PATHS['logo-audi'] },
  { name: 'Lamborghini', code: 'HUR EVO2', color: '#DDB321', path: OFFICIAL_BRAND_PATHS['logo-lambo'] },
  { name: 'Acura', code: 'ACURA GTP', color: '#E11D48', path: OFFICIAL_BRAND_PATHS['logo-acura'] },
].filter((b) => Boolean(b.path));

function trackQuery(rawTrack: string): string {
  const t = rawTrack || '';
  if (/suzuka/i.test(t)) return 'Suzuka';
  if (/fuji/i.test(t)) return 'Fuji';
  if (/mans/i.test(t)) return 'Le Mans';
  if (/long beach/i.test(t)) return 'Long Beach';
  if (/panorama|bathurst/i.test(t)) return 'Bathurst';
  if (/spa-francorchamps/i.test(t)) return 'Spa';
  if (/nürburgring|nurburgring/i.test(t)) return 'Nurburgring';
  if (/interlagos/i.test(t)) return 'Interlagos';
  if (/monza/i.test(t)) return 'Monza';
  if (/laguna seca/i.test(t)) return 'Laguna Seca';
  if (/watkins glen/i.test(t)) return 'Watkins Glen';
  if (/road america/i.test(t)) return 'Road America';
  if (/road atlanta/i.test(t)) return 'Road Atlanta';
  if (/daytona/i.test(t)) return 'Daytona';
  if (/sebring/i.test(t)) return 'Sebring';
  if (/imola/i.test(t)) return 'Imola';
  if (/silverstone/i.test(t)) return 'Silverstone';
  if (/barcelona/i.test(t)) return 'Barcelona';
  if (/red bull ring/i.test(t)) return 'Red Bull Ring';
  if (/americas|cota/i.test(t)) return 'COTA';
  return t.replace(/\s+(International Racing Course|International Speedway|Street Circuit|Circuit|Raceway|Motorsports Park).*$/i, '').trim();
}

function garageHref(item: (typeof FEATURED)[number], trackName: string): string {
  const p = new URLSearchParams();
  if (item.car) p.set('car', item.car);
  else if (item.cars) p.set('cars', item.cars);
  const q = trackQuery(trackName);
  if (q) p.set('track', q);
  return `/garage/?${p.toString()}`;
}

const weekly = FEATURED
  .map((item) => {
    const s = schedule.series.find((x) => x.name.startsWith(item.prefix));
    if (!s) return undefined;
    return {
      name: s.name.replace(/\s*-?\s*2026 Season.*$/i, '').trim(),
      schedule: item.schedule,
      badge: item.badge,
      img: item.img,
      car: item.car ?? '',
      cars: item.cars ?? '',
      weeks: s.weeks.map((w) => [w.week_num, w.track_name, w.config ?? '', garageHref(item, w.track_name)] as [number, string, string, string]),
    };
  })
  .filter((s) => s !== undefined);
const SEASON_START_MS = Date.UTC(2026, 8, 15);
const buildWeek = Math.max(1, Math.min(12, Math.floor((Date.now() - SEASON_START_MS) / 604_800_000) + 1));

const pageTitle = "Muntrume Motorsport (MMT) · iRacing Team & .STO Setups";
const pageDescription = "Muntrume Motorsport (MMT) is an iRacing endurance team from Barcelona. Official drivers, Garage 61 telemetry, MMT Sync app, and 42,600+ .sto setups.";
const pageKeywords = "muntrume motorsport, official simracing team, iracing team, endurance sim racing, gt3 endurance, sim racing engineering, garage 61 telemetry, alberto trujillo, escuderia simracing, equipo iracing";
const es = (n: number) => n.toLocaleString('es-ES');
const figs = [
  { n: PILOTOS.length, k: "home.fig.drivers", l: "Pilotos oficiales" },
  { n: catalog.total_setups, k: "home.fig.setups", l: "Setups en el catálogo" },
  { n: catalog.cars.length, k: "home.fig.cars", l: "Coches" },
  { n: catalog.circuits.length, k: "home.fig.tracks", l: "Circuitos" },
];
const appVersion = desktopPkg.version;
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} canonical="https://muntru.me/" ogImage="https://muntru.me/assets/img/og-home.jpg" ogImageAlt="Muntrume Motorsport (MMT)" translated i18nTitle="home.meta.title" i18nDescription="home.meta.desc">
  <link slot="head" rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset="/assets/img/hero-bg-640.avif 640w, /assets/img/hero-bg-960.avif 960w, /assets/img/hero-bg-1280.avif 1280w" imagesizes="100vw" />

  <!-- ===================================================================== -->
  <!-- 1. GOOGLE-STYLE CINEMATIC HERO + LIVE TELEMETRY COCKPIT STAGE          -->
  <!-- ===================================================================== -->
  <section class="r-hero g-hero-stage" aria-labelledby="heroTitle">
    <picture>
      <source type="image/avif" srcset="/assets/img/hero-bg-640.avif 640w, /assets/img/hero-bg-960.avif 960w, /assets/img/hero-bg-1280.avif 1280w" sizes="100vw" />
      <source type="image/webp" srcset="/assets/img/hero-bg-640.webp 640w, /assets/img/hero-bg-960.webp 960w, /assets/img/hero-bg-1280.webp 1280w, /assets/img/hero-bg.webp 1920w" sizes="100vw" />
      <img src="/assets/img/hero-bg-1280.webp" width="1920" height="1080" alt="Muntrume Motorsport en pista" fetchpriority="high" decoding="async" class="g-hero-bg" />
    </picture>

    <!-- Animated ambient aurora & telemetry laser lines -->
    <div class="g-hero-aurora" aria-hidden="true"></div>

    <div class="r-wrap g-hero-grid">
      <div class="g-hero-copy">
        <div class="g-hero-pills">
          <span class="g-live-pill">
            <span class="g-live-dot" aria-hidden="true"></span>
            <span>MMT · Sant Andreu, Barcelona</span>
          </span>
          <a href="/app/" class="g-version-pill">
            <span>MMT Sync v{appVersion}</span>
            <span class="g-pill-sep">·</span>
            <span>60 Hz Native Rust</span>
            <span aria-hidden="true">→</span>
          </a>
          <button type="button" id="heroLocalBridgeBadge" hidden class="g-bridge-live-pill" title="Lanzar Overlays directamente en tu iRacing local">
            <span class="g-live-dot" aria-hidden="true"></span>
            <span id="heroLocalBridgeText">MMT Sync Detectado · Lanzar HUD</span>
          </button>
        </div>

        <h1 id="heroTitle" class="r-h1 g-hero-title">Muntrume Motorsport</h1>
        <p class="r-lead" data-i18n="home.lead">Sim racing con criterio de ingeniería. Equipo oficial de iRacing en resistencia y sprint: telemetría, setups .sto y trabajo de equipo en Sports Car, GT3 y GT4.</p>

        <div class="r-hero__cta">
          <a href="/app/" class="r-btn r-btn--primary g-btn-glow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            <span>Descargar MMT Sync</span>
          </a>
          <a href="/garage/" class="r-btn r-btn--ghost" data-i18n="home.cta.vault">Entrar al Garage</a>
          <a href="/overlay/" class="r-btn r-btn--ghost">Simulador HUD 60Hz</a>
          <a href="/login" class="r-btn r-btn--ghost">Acceso piloto</a>
        </div>

        <div class="r-hero__meta">
          {figs.map(f => (
            <div>
              <strong data-i18n-num={f.n} data-g-count={f.n}>{es(f.n)}</strong>
              <span data-i18n={f.k}>{f.l}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 1B. INFINITE MANUFACTURER & TELEMETRY TICKER                          -->
  <!-- ===================================================================== -->
  <div class="g-brand-ribbon" aria-label="Fabricantes soportados en el Garage y HUD">
    <div class="g-brand-ribbon__track">
      {[...SHOWCASE_BRANDS, ...SHOWCASE_BRANDS].map((b, idx) => (
        <a href="/garage/" class="g-brand-chip" tabindex={idx >= SHOWCASE_BRANDS.length ? -1 : undefined} aria-hidden={idx >= SHOWCASE_BRANDS.length ? "true" : undefined}>
          <svg viewBox="0 0 24 24" width="16" height="16" fill={b.color} aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d={b.path} />
          </svg>
          <strong>{b.name}</strong>
          <span>{b.code}</span>
        </a>
      ))}
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- 2. GOOGLE HARDWARE BENTO SHOWCASE (ECOSISTEMA MUNTRUME)               -->
  <!-- ===================================================================== -->
  <section class="r-section r-section--alt" aria-labelledby="ecosystemTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">Ingeniería Open Source · Ecosistema MMT</p>
          <h2 id="ecosystemTitle" class="r-h2">Tecnología de competición diseñada al milímetro</h2>
          <p class="r-lead">Herramientas nativas creadas en Sant Andreu (Barcelona) para reducir la carga cognitiva en pista: cero suscripciones, cero telemetría espía y máximo rendimiento.</p>
        </div>
        <a href="/app/" class="r-link">Explorar suite MMT Sync →</a>
      </div>

      <div class="g-bento-grid">
        <!-- BENTO 1: MMT SYNC & OVERLAYS 60 FPS (Wide Span 7) -->
        <article class="g-bento-card g-bento-card--wide" data-g-reveal>
          <div class="g-bento-card__top">
            <div class="g-bento-badges">
              <span class="g-chip-accent">Tauri v2 + Rust</span>
              <span class="g-chip-muted">&lt; 15 MB RAM · 60 FPS</span>
              <span class="g-chip-muted">MIT Open Source</span>
            </div>
            <a href="/overlay/" class="g-bento-arrow" aria-label="Abrir simulador de Overlays">↗</a>
          </div>

          <div class="g-bento-split">
            <div class="g-bento-copy">
              <h3 class="r-h3">MMT Sync &amp; Overlays 60 Hz</h3>
              <p>Superposiciones transparentes <code>click-through</code> conectadas directamente a la memoria compartida del SDK de iRacing (<code>FILE_MAP_READ</code>). Standings multiclase, Relative, Track Map Catmull-Rom, calculadora de Stints, temperaturas de neumáticos y Radar 360°.</p>
              <div class="g-bento-actions">
                <a href="/overlay/" class="r-btn r-btn--primary r-btn--sm">Simulador interactivo</a>
                <a href="/app/" class="r-btn r-btn--ghost r-btn--sm">Descargar v{appVersion}</a>
              </div>
            </div>

            <!-- Interactive Live Track Map & Radar Mini-Widget -->
            <div class="g-bento-visual" aria-hidden="true">
              <div class="g-mini-hud">
                <div class="g-mini-hud__bar">
                  <span>STANDINGS · SOF 3.4K</span>
                  <span class="g-mini-hud__fps">0% CPU IDLE</span>
                </div>
                <div class="g-mini-hud__rows">
                  <div class="g-mini-row is-leader">
                    <span class="pos">P1</span>
                    <span class="cls gtp">GTP</span>
                    <span class="drv">#16 A. Trujillo</span>
                    <span class="ir">A 4.42</span>
                    <span class="gap">LEADER</span>
                  </div>
                  <div class="g-mini-row">
                    <span class="pos">P2</span>
                    <span class="cls gt3">GT3</span>
                    <span class="drv">#1 M. Berbis</span>
                    <span class="ir">A 3.85</span>
                    <span class="gap">+0.42s</span>
                  </div>
                  <div class="g-mini-row">
                    <span class="pos">P3</span>
                    <span class="cls gt3">GT3</span>
                    <span class="drv">#22 E. Chongkan</span>
                    <span class="ir">A 3.61</span>
                    <span class="gap">+1.18s</span>
                  </div>
                </div>
                <div class="g-mini-hud__foot">
                  <span>PIT WINDOW: <b>L16–L18</b></span>
                  <span>TO ADD: <b>+9.4 L</b></span>
                  <span class="ok">CLEAR 360°</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- BENTO 2: SETUP VAULT .STO + NOMENCLATURA OFICIAL (Span 5) -->
        <article class="g-bento-card g-bento-card--tall" data-g-reveal>
          <div class="g-bento-card__top">
            <div class="g-bento-badges">
              <span class="g-chip-accent">{es(catalog.total_setups)} archivos .sto</span>
              <span class="g-chip-muted">{catalog.cars.length} coches</span>
            </div>
            <a href="/garage/" class="g-bento-arrow" aria-label="Abrir Setup Vault">↗</a>
          </div>

          <h3 class="r-h3">Setup Vault &amp; Estándar MMT</h3>
          <p>Catálogo sincronizado en un clic en <code>Documents\iRacing\setups\MMT</code> con nomenclatura oficial de ingeniería para identificar cada reglaje al instante en el box:</p>

          <!-- Interactive Setup Filename Decoder (from Google Drive MMT_Nomenclatura_Setups) -->
          <div class="g-sto-decoder" aria-label="Estructura oficial de archivos de setup MMT">
            <div class="g-sto-code">
              <span class="t-team" title="Escudería Muntrume Motorsport">MMT</span>_<span class="t-car" title="Modelo (4-5 letras: F296, P911, M4, P963)">F296</span>_<span class="t-trk" title="Circuito oficial">SPA</span>_<span class="t-ses" title="Sesión: Q, Q2, R, END, W, SAFE">END</span>_<span class="t-ver" title="Iteración verificada">V2</span><small>.sto</small>
            </div>
            <div class="g-sto-pills">
              <span><b>Q / Q2</b> Qualy 1–2 vueltas</span>
              <span><b>R</b> Race Sprint</span>
              <span><b>END</b> Resistencia</span>
              <span><b>W</b> Wet / Lluvia</span>
              <span><b>SAFE</b> Alta estabilidad</span>
            </div>
          </div>

          <div class="g-bento-actions" style="margin-top:auto">
            <a href="/garage/" class="r-btn r-btn--primary r-btn--sm">Abrir el Garage</a>
            <a href="/setup-builder/" class="r-btn r-btn--ghost r-btn--sm">Setup Builder</a>
          </div>
        </article>

        <!-- BENTO 3: MUNTRUME AI COPILOT (Span 4) -->
        <article class="g-bento-card" data-g-reveal>
          <div class="g-bento-card__top">
            <div class="g-bento-badges">
              <span class="g-chip-accent">Muntrume 1.0 Pro</span>
              <span class="g-chip-muted">1.0 Apex &amp; PitWall</span>
            </div>
            <a href="/ai/" class="g-bento-arrow" aria-label="Abrir Muntrume AI">↗</a>
          </div>
          <h3 class="r-h3">Muntrume AI · Copiloto de pista</h3>
          <p>Modelos propios de ingeniería con Artifacts exportables a Word (.doc), PDF y Presentación 16:9, cálculo de combustible, ventanas de parada y diagnóstico de setups .sto.</p>
          <div class="g-ai-prompt-preview">
            <code>"Calcula combustible y estrategia GT3 para 8h Indy"</code>
            <a href="/ai/">Preguntar →</a>
          </div>
        </article>

        <!-- BENTO 4: CALENDARIO 2026 S4 & ROI PLANNER (Span 4) -->
        <article class="g-bento-card" data-g-reveal>
          <div class="g-bento-card__top">
            <div class="g-bento-badges">
              <span class="g-chip-accent">{schedule.series.length} series oficiales</span>
              <span class="g-chip-muted">{catalog.circuits.length} circuitos</span>
            </div>
            <a href="/calendar/" class="g-bento-arrow" aria-label="Abrir Calendario">↗</a>
          </div>
          <h3 class="r-h3">Calendario S4 &amp; Store Planner</h3>
          <p>Planificador inteligente de las 12 semanas de temporada con matriz de Participation Credits (8/12 semanas), cálculo de descuentos por volumen e impuestos locales.</p>
          <div class="g-bento-actions" style="margin-top:auto">
            <a href="/calendar/" class="r-link">Planificar temporada 2026 S4 →</a>
          </div>
        </article>

        <!-- BENTO 5: WALLPAPERS 4K & MULTI-MONITOR 0ms SYNC (Span 4) -->
        <article class="g-bento-card" data-g-reveal>
          <div class="g-bento-card__top">
            <div class="g-bento-badges">
              <span class="g-chip-accent">16:9 HD &amp; 9:16 4K</span>
              <span class="g-chip-muted">0 ms Multi-Monitor</span>
            </div>
            <a href="/wallpapers/" class="g-bento-arrow" aria-label="Abrir Wallpapers">↗</a>
          </div>
          <h3 class="r-h3">Wallpapers &amp; Paddock Gallery</h3>
          <p>Capturas reales en pista exportadas a <code>.JPG</code> nativo y sincronizador multi-monitor para Windows sin permisos de administrador (<code>user32.dll</code>) con 0 ms de desfase entre pantallas.</p>
          <div class="g-bento-actions" style="margin-top:auto">
            <a href="/wallpapers/" class="r-link">Descargar packs 4K →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. ESTA SEMANA EN IRACING (TOP 5 SERIES OPEN)                         -->
  <!-- ===================================================================== -->
  <section class="r-section" aria-labelledby="weekTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">2026 Season 4 · <span id="weekNum">Semana {buildWeek}</span></p>
          <h2 id="weekTitle" class="r-h2">Esta semana en iRacing · <span id="weekNumBadge">Semana {buildWeek}</span></h2>
        </div>
        <a href="/garage/" class="r-link">Ver todos los setups →</a>
      </div>
      <div id="weekGrid" class="mmt-week-grid" data-weeks={JSON.stringify(weekly)}>
        {weekly.map((s) => {
          const w = s.weeks.find((x) => x[0] === buildWeek);
          return (
            <a href={w?.[3] ?? '/garage/'} class="mmt-week-card" data-g-reveal>
              <div class="mmt-week-card__media">
                <img src={s.img} alt={s.name} loading="lazy" decoding="async" />
                <span class="mmt-week-card__pill">{s.badge}</span>
              </div>
              <div class="mmt-week-card__body">
                <span class="mmt-week-card__series">{s.name}</span>
                <strong class="mmt-week-card__track" data-track>{w?.[1] ?? '—'}</strong>
                <span class="mmt-week-card__config" data-config>{w?.[2] ?? ''}</span>
                <div class="mmt-week-card__foot">
                  <span class="mmt-week-card__time">{s.schedule}</span>
                  <span class="mmt-week-card__go">Setups →</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div class="mmt-week-foot">
        <p class="r-meta">Top 5 series Open por participación semanal (incluyendo GT Sprint GT3). Las series Fixed (ej. GT3 Regional Tour) usan setup oficial de iRacing.</p>
        <div class="mmt-week-links">
          <a href="/calendar/" class="r-link">Calendario completo ({schedule.series.length} series) →</a>
          <a href="https://www.iracing.com/series/" target="_blank" rel="noopener noreferrer" class="r-link">Series oficiales en iRacing.com ↗</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const grid = document.getElementById('weekGrid');
      if (!grid) return;
      let data = [];
      try { data = JSON.parse(grid.dataset.weeks || '[]'); } catch { return; }
      const week = Math.max(1, Math.min(12, Math.floor((Date.now() - Date.UTC(2026, 8, 15)) / 604800000) + 1));
      const label = document.getElementById('weekNum');
      if (label) label.textContent = 'Semana ' + week;
      const badge = document.getElementById('weekNumBadge');
      if (badge) badge.textContent = 'Semana ' + week;
      grid.querySelectorAll('.mmt-week-card').forEach((card, i) => {
        const hit = ((data[i] && data[i].weeks) || []).find((e) => e[0] === week);
        card.hidden = !hit;
        if (!hit) return;
        card.querySelector('[data-track]').textContent = hit[1];
        card.querySelector('[data-config]').textContent = hit[2];
        if (hit[3]) card.setAttribute('href', hit[3]);
      });
    })();
  </script>

