---
import Layout from '../layouts/Layout.astro';
import DriverCard from '../components/DriverCard.astro';
import TeamBand from '../components/TeamBand.astro';
import { PILOTOS, LICENCE_UPDATED_LABEL } from '../lib/pilotos';
import catalog from '../../public/assets/data/catalog_index.json';
import schedule from '../../desktop/src/season_schedule_2026_s4.json';

// "Esta semana": series Open destacadas del calendario oficial 2026 S4 (las Fixed usan el setup de iRacing).
const FEATURED = [
  'GT Sprint Series by Simucube',
  'IMSA iRacing Series by GO Fast',
  'GT3 Regional Tour by SensitHaptics - Europe',
  'GT4 Falken Tyre Challenge',
  'LMP3 Trophy',
  'Supercars Series - 2026',
];
const weekly = FEATURED
  .map((prefix) => schedule.series.find((s) => s.name.startsWith(prefix)))
  .filter((s) => s !== undefined)
  .map((s) => ({
    name: s.name.replace(/\s*-?\s*2026 Season.*$/i, '').trim(),
    weeks: s.weeks.map((w) => [w.week_num, w.track_name, w.config ?? ''] as [number, string, string]),
  }));
const SEASON_START_MS = Date.UTC(2026, 8, 15);
const buildWeek = Math.max(1, Math.min(12, Math.floor((Date.now() - SEASON_START_MS) / 604_800_000) + 1));

const pageTitle = "Muntrume Motorsport (MMT) · Equipo iRacing";
const pageDescription = "Muntrume Motorsport (MMT) es el equipo de iRacing de Sant Andreu, Barcelona. Pilotos oficiales, telemetría y setups .sto en el Garage.";
const pageKeywords = "muntrume motorsport, official simracing team, iracing team, endurance sim racing, gt3 endurance, sim racing engineering, garage 61 telemetry, alberto trujillo, escuderia simracing, equipo iracing";
const es = (n: number) => n.toLocaleString('es-ES');
const figs = [
  { n: PILOTOS.length, k: "home.fig.drivers", l: "Pilotos oficiales" },
  { n: catalog.total_setups, k: "home.fig.setups", l: "Setups en el catálogo" },
  { n: catalog.cars.length, k: "home.fig.cars", l: "Coches" },
  { n: catalog.circuits.length, k: "home.fig.tracks", l: "Circuitos" },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} canonical="https://muntru.me/" ogImage="https://muntru.me/assets/img/og-home.jpg" ogImageAlt="Muntrume Motorsport (MMT)" translated i18nTitle="home.meta.title" i18nDescription="home.meta.desc">
  <link slot="head" rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset="/assets/img/hero-bg-640.avif 640w, /assets/img/hero-bg-960.avif 960w, /assets/img/hero-bg-1280.avif 1280w" imagesizes="100vw" />

  <section class="r-hero" aria-labelledby="heroTitle">
    <picture>
      <source type="image/avif" srcset="/assets/img/hero-bg-640.avif 640w, /assets/img/hero-bg-960.avif 960w, /assets/img/hero-bg-1280.avif 1280w" sizes="100vw" />
      <source type="image/webp" srcset="/assets/img/hero-bg-640.webp 640w, /assets/img/hero-bg-960.webp 960w, /assets/img/hero-bg-1280.webp 1280w, /assets/img/hero-bg.webp 1920w" sizes="100vw" />
      <img src="/assets/img/hero-bg-1280.webp" width="1920" height="1080" alt="Muntrume Motorsport en pista" fetchpriority="high" decoding="async" />
    </picture>
    <div class="r-wrap">
      <p class="r-kicker">MMT · Sant Andreu, Barcelona</p>
      <h1 id="heroTitle" class="r-h1">Muntrume Motorsport</h1>
      <p class="r-lead" data-i18n="home.lead">Sim racing con criterio de ingeniería. Equipo oficial de iRacing en resistencia y sprint: telemetría, setups .sto y trabajo de equipo en Sports Car, GT3 y GT4.</p>
      <div class="r-hero__cta">
        <a href="/app/" class="r-btn r-btn--primary">Descargar MMT Sync</a>
        <a href="/garage/" class="r-btn r-btn--ghost" data-i18n="home.cta.vault">Entrar al Garage</a>
        <a href="/login" class="r-btn r-btn--ghost">Acceso piloto</a>
      </div>
      <div class="r-hero__meta">
        {figs.map(f => (
          <div>
            <strong data-i18n-num={f.n}>{es(f.n)}</strong>
            <span data-i18n={f.k}>{f.l}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="r-section" aria-labelledby="weekTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker">2026 Season 4 · <span id="weekNum">Semana {buildWeek}</span></p>
          <h2 id="weekTitle" class="r-h2">Esta semana en iRacing</h2>
        </div>
        <a href="/garage/" class="r-link">Ver todos los setups →</a>
      </div>
      <div id="weekGrid" class="mmt-week-grid" data-weeks={JSON.stringify(weekly)}>
        {weekly.map((s) => {
          const w = s.weeks.find((x) => x[0] === buildWeek);
          return (
            <a href="/garage/" class="mmt-week-card">
              <span class="mmt-week-card__series">{s.name}</span>
              <strong class="mmt-week-card__track" data-track>{w?.[1] ?? '—'}</strong>
              <span class="mmt-week-card__config" data-config>{w?.[2] ?? ''}</span>
            </a>
          );
        })}
      </div>
      <p class="r-meta" style="margin-top:12px">Calendario oficial de iRacing. Solo series Open: en las series Fixed se corre con el setup de iRacing.</p>
    </div>
  </section>

  <style>
    .mmt-week-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
    .mmt-week-card {
      display: grid; gap: 6px; padding: 16px 18px; border-radius: 12px;
      border: 1px solid var(--r-line); border-top: 2px solid var(--r-accent, #00e5ff);
      background: var(--r-surface, rgba(255,255,255,0.03)); color: var(--r-text); text-decoration: none;
      transition: border-color .15s ease, transform .15s ease;
    }
    .mmt-week-card:hover { border-color: var(--r-line-2); transform: translateY(-2px); }
    .mmt-week-card__series { font: 600 11px/1.3 ui-monospace, monospace; text-transform: uppercase; letter-spacing: .06em; color: var(--r-muted); }
    .mmt-week-card__track { font-size: 18px; line-height: 1.25; }
    .mmt-week-card__config { font-size: 13px; color: var(--r-muted); }
  </style>

  <script is:inline>
    (() => {
      const grid = document.getElementById('weekGrid');
      if (!grid) return;
      let data = [];
      try { data = JSON.parse(grid.dataset.weeks || '[]'); } catch { return; }
      const week = Math.max(1, Math.min(12, Math.floor((Date.now() - Date.UTC(2026, 8, 15)) / 604800000) + 1));
      const label = document.getElementById('weekNum');
      if (label) label.textContent = 'Semana ' + week;
      grid.querySelectorAll('.mmt-week-card').forEach((card, i) => {
        const hit = ((data[i] && data[i].weeks) || []).find((e) => e[0] === week);
        card.hidden = !hit;
        if (!hit) return;
        card.querySelector('[data-track]').textContent = hit[1];
        card.querySelector('[data-config]').textContent = hit[2];
      });
    })();
  </script>

  <section class="r-section" aria-labelledby="driversTitle">
    <div class="r-wrap max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="r-head">
        <div>
          <p class="r-kicker" data-i18n="home.roster.kicker">Plantilla oficial 2026</p>
          <h2 id="driversTitle" class="r-h2" data-i18n="home.roster.title">Pilotos</h2>
        </div>
        <a href="/pilotos/" class="r-link" data-i18n="home.roster.link">Ver la plantilla →</a>
      </div>
      <p class="r-meta" id="licenceUpdated" style="margin-bottom:14px"><span data-i18n="home.roster.updated">Actualizado:</span> <time datetime="2026-11-07">{LICENCE_UPDATED_LABEL}</time></p>
      <TeamBand />
      <div class="d-grid grid grid-cols-1 lg:grid-cols-3 gap-5 items-stretch w-full">
        {PILOTOS.map(p => (
          <DriverCard driver={p} heading="h3" />
        ))}
      </div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="calTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker" data-i18n="home.cal.kicker">Temporada</p>
          <h2 id="calTitle" class="r-h2" data-i18n="home.cal.title">Calendario</h2>
        </div>
      </div>
      <ul class="r-list" id="calList" hidden></ul>
      <p class="r-empty" id="calEmpty" data-i18n="home.cal.empty">Todavía no hay carreras publicadas. El calendario se sincroniza desde Race Control.</p>
    </div>
  </section>

  <section class="r-section" aria-labelledby="aboutTitle">
    <div class="r-wrap">
      <div class="r-head">
        <div>
          <p class="r-kicker" data-i18n="home.team.kicker">El equipo</p>
          <h2 id="aboutTitle" class="r-h2" data-i18n="home.team.title">Quiénes somos</h2>
          <p class="r-lead" data-i18n="home.team.lead">Un equipo de Sant Andreu (Barcelona) y Costa Rica que compite en iRacing con método de ingeniería: preparación de setups, telemetría de Garage 61 y radio en carrera.</p>
        </div>
      </div>
      <div class="r-cols">
        <div class="r-value">
          <h3 class="r-h3" data-i18n="home.team.prep.title">Preparación</h3>
          <p><span data-i18n-num={catalog.total_setups}>{es(catalog.total_setups)}</span> <span data-i18n="home.team.prep.body">setups .sto, ordenados por coche, circuito y temporada, en el Garage del equipo y en el Setup Builder.</span></p>
        </div>
        <div class="r-value">
          <h3 class="r-h3" data-i18n="home.team.tel.title">Telemetría</h3>
          <p data-i18n="home.team.tel.body">Telemetría de carretera ponderada por horas reales en pista, y licencias de iRacing, vía Garage 61.</p>
        </div>
        <div class="r-value">
          <h3 class="r-h3" data-i18n="home.team.work.title">Trabajo de equipo</h3>
          <p data-i18n="home.team.work.body">Radio de carrera en Discord, planes compartidos de combustible y stint de neumáticos, y relevos coordinados en carreras de resistencia de 24 h.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="r-section r-section--alt" aria-labelledby="pressTitle">
    <div class="r-wrap r-cols" style="align-items:end">
      <div style="display:grid;gap:16px">
        <p class="r-kicker" data-i18n="home.media.kicker">Medios</p>
        <h2 id="pressTitle" class="r-h2" data-i18n="home.media.title">Sala de prensa y copiloto</h2>
        <p class="r-lead" data-i18n="home.media.lead">Despachos de carrera, titulares de motor y el copiloto de ingeniería Muntrume AI (Groq LPU).</p>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/noticias/" class="r-btn r-btn--primary" data-i18n="home.media.news">Sala de prensa</a>
        <a href="/app/" class="r-btn" style="border-color:var(--r-line-2);color:var(--r-text)" data-i18n="home.media.app">MMT Sync</a>
        <a href="/paddock/" class="r-btn" style="border-color:var(--r-line-2);color:var(--r-text)" data-i18n="home.media.paddock">Paddock</a>
        <a href="/ai/" class="r-btn" style="border-color:var(--r-line-2);color:var(--r-text)" data-i18n="home.media.ai">Copiloto AI</a>
      </div>
    </div>
  </section>

  <script is:inline src="/assets/js/home-r.js?v=t330" defer></script>
</Layout>
