---
import Layout from '../layouts/Layout.astro';
import StatsBar from '../components/StatsBar.astro';

const pageTitle = "Muntrume Motorsport | Precision Racing. Engineered to Win. — iRacing Team";
const pageDescription = "Escudería de Sant Andreu con 239k setups y telemetría Garage 61 para iRacing. Pilotos oficiales, setup vault automatizado y canal de radio.";

const drivers = [
  {
    name: "Alberto Trujillo",
    slug: "alberto-trujillo",
    role: "Team Principal & GT3 Driver",
    car: "Porsche 911 GT3 R (992)",
    num: "#01",
    rating: "3.9k iR · Licencia A",
    tags: ["GT3 Specialist", "VRS 24h", "Setup Architect"]
  },
  {
    name: "Mateo Berbis",
    slug: "mateo-berbis",
    role: "Endurance & GT3 Driver",
    car: "Ferrari 296 GT3",
    num: "#02",
    rating: "3.4k iR · Licencia A",
    tags: ["Endurance Pro", "Telemetry Lead", "Night Stints"]
  },
  {
    name: "Eduardo Chongkan",
    slug: "eduardo-chongkan",
    role: "Prototype & Formula Driver",
    car: "Cadillac V-Series.R GTP",
    num: "#03",
    rating: "3.7k iR · Licencia A",
    tags: ["Hypercar GTP", "Super Formula", "Qualy Pace"]
  },
  {
    name: "Juanlu Carrillo",
    slug: "juanlu-carrillo",
    role: "Touring & Cup Driver",
    car: "Porsche 992 Cup",
    num: "#04",
    rating: "3.2k iR · Licencia A",
    tags: ["Cup Series", "Close Racing", "TBR SimOps"]
  }
];
---

<Layout title={pageTitle} description={pageDescription}>
  
  <!-- ========================================================================= -->
  <!-- 1. HERO MINIMALISTA (Estilo Mercedes-AMG F1 + Linear.app)                 -->
  <!-- ========================================================================= -->
  <section class="relative min-h-[85vh] lg:min-h-[92vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
    
    <!-- Hero Background Image (Low contrast overlay) -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/assets/img/hero-bg.webp" 
        alt="Muntrume Motorsport Track Action" 
        class="w-full h-full object-cover object-center opacity-25 filter grayscale contrast-125 select-none pointer-events-none"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#080C0A] via-[#080C0A]/80 to-[#080C0A]/40"></div>
    </div>

    <!-- Hero Content Container (12-Column Grid) -->
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        
        <!-- Left: Headline & Claim -->
        <div class="lg:col-span-7 space-y-6">
          
          <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-[#121A17] border border-[#1E2A26] text-xs font-mono text-[#8B9A8F]">
            <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
            <span>MUNTRUME MOTORSPORT &middot; SANT ANDREU, BCN</span>
          </div>

          <!-- Main Title -->
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.05] font-display">
            PRECISION RACING. <br />
            <span class="text-[#00E699]">ENGINEERED TO WIN.</span>
          </h1>

          <!-- Concise Subtitle (12 words) -->
          <p class="text-base sm:text-lg text-[#8B9A8F] max-w-xl font-normal leading-relaxed">
            Escudería de Sant Andreu con 239k setups y telemetría Garage 61 para iRacing.
          </p>

          <!-- 2 Primary CTAs -->
          <div class="flex flex-wrap items-center gap-4 pt-3">
            <a 
              href="/garage" 
              class="inline-flex items-center gap-2.5 bg-[#00E699] hover:bg-[#00c985] text-neutral-950 font-black text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 rounded-xl transition-all shadow-lg hover:shadow-[#00E699]/20"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <span>Setup Vault (239k)</span>
            </a>
            
            <a 
              href="https://discord.gg/ehX6B8JUtE" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2.5 bg-transparent hover:bg-white/5 text-white border border-[#1E2A26] hover:border-[#00E699] font-bold text-xs sm:text-sm uppercase tracking-wider px-6 py-3.5 rounded-xl transition-all"
            >
              <span class="w-2 h-2 rounded-full bg-[#00E699]"></span>
              <span>Unirse a la Radio en Discord</span>
            </a>
          </div>

        </div>

        <!-- Right: Single Team Status Widget (Mercedes-AMG F1 style) -->
        <div class="lg:col-span-5">
          <div class="paddock-card p-6 space-y-5 bg-[#121A17] border border-[#1E2A26] rounded-2xl shadow-2xl">
            
            <div class="flex items-center justify-between pb-4 border-b border-[#1E2A26]">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00E699] animate-pulse"></span>
                <span class="text-xs font-mono uppercase tracking-widest text-[#8B9A8F]">Paddock Telemetry Live</span>
              </div>
              <span class="text-[11px] font-mono text-[#00E699] font-bold">iRacing Official</span>
            </div>

            <!-- Squad & Next Race Specs -->
            <div class="grid grid-cols-2 gap-3 pb-4 border-b border-[#1E2A26]">
              <div class="p-3 rounded-xl bg-[#080C0A] border border-[#1E2A26]">
                <div class="text-[10px] font-mono uppercase text-[#8B9A8F]">Pilotos Activos</div>
                <div class="text-xl font-extrabold text-white font-display mt-0.5">4 <span class="text-xs font-normal text-[#00E699]">Pilotos</span></div>
              </div>

              <div class="p-3 rounded-xl bg-[#080C0A] border border-[#1E2A26]">
                <div class="text-[10px] font-mono uppercase text-[#8B9A8F]">Setups .STO</div>
                <div class="text-xl font-extrabold text-[#00E699] font-display mt-0.5">239.539</div>
              </div>

              <div class="p-3 rounded-xl bg-[#080C0A] border border-[#1E2A26]">
                <div class="text-[10px] font-mono uppercase text-[#8B9A8F]">Próximo Desafío</div>
                <div class="text-sm font-bold text-white mt-0.5 truncate">24h Nürburgring</div>
              </div>

              <div class="p-3 rounded-xl bg-[#080C0A] border border-[#1E2A26]">
                <div class="text-[10px] font-mono uppercase text-[#8B9A8F]">Telemetría Engine</div>
                <div class="text-sm font-bold text-[#00E699] mt-0.5 truncate">Garage 61 Sync</div>
              </div>
            </div>

            <!-- Countdown Timer Row -->
            <div>
              <div class="flex items-center justify-between text-xs text-[#8B9A8F] mb-2 font-mono">
                <span>Cuenta Regresiva Próximo Evento</span>
                <span class="text-white font-bold">Special Events</span>
              </div>
              <div class="grid grid-cols-4 gap-2 text-center font-mono">
                <div class="bg-[#080C0A] border border-[#1E2A26] p-2.5 rounded-xl">
                  <div class="text-lg font-black text-white font-display">14</div>
                  <div class="text-[9px] uppercase text-[#8B9A8F]">DÍAS</div>
                </div>
                <div class="bg-[#080C0A] border border-[#1E2A26] p-2.5 rounded-xl">
                  <div class="text-lg font-black text-white font-display">08</div>
                  <div class="text-[9px] uppercase text-[#8B9A8F]">HRS</div>
                </div>
                <div class="bg-[#080C0A] border border-[#1E2A26] p-2.5 rounded-xl">
                  <div class="text-lg font-black text-white font-display">24</div>
                  <div class="text-[9px] uppercase text-[#8B9A8F]">MIN</div>
                </div>
                <div class="bg-[#080C0A] border border-[#1E2A26] p-2.5 rounded-xl">
                  <div class="text-lg font-black text-[#00E699] font-display">52</div>
                  <div class="text-[9px] uppercase text-[#8B9A8F]">SEG</div>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. REUSABLE UNIFIED STATS BAR (Single Source of Truth)                    -->
  <!-- ========================================================================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <StatsBar />
  </section>

  <!-- ========================================================================= -->
  <!-- 3. PILOTOS OFICIALES GRID (Clean Monochrome Racing Cards)                 -->
  <!-- ========================================================================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-[#1E2A26]">
      <div>
        <div class="text-[11px] font-mono uppercase tracking-widest text-[#00E699] mb-1">PLANTILLA OFICIAL &bull; 2026</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display tracking-tight">
          Pilotos del Equipo
        </h2>
      </div>
      <a href="/pilotos" class="text-xs font-mono font-bold text-[#8B9A8F] hover:text-[#00E699] transition flex items-center gap-1.5">
        <span>Ver Roster Completo</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- 4 Drivers Minimal Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {drivers.map(d => (
        <a href={`/p/${d.slug}`} class="group paddock-card p-5 flex flex-col justify-between space-y-4">
          <div>
            <div class="flex items-center justify-between text-xs font-mono mb-3">
              <span class="text-[#00E699] font-bold">{d.num}</span>
              <span class="text-[#8B9A8F] text-[10px] uppercase">{d.rating}</span>
            </div>
            
            <div class="w-full aspect-[4/3] rounded-xl bg-[#080C0A] border border-[#1E2A26] overflow-hidden mb-3 relative flex items-center justify-center">
              <svg class="w-16 h-16 text-[#8B9A8F]/40 group-hover:text-[#00E699]/70 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-[#080C0A]/90 text-[10px] font-mono text-neutral-300 border border-[#1E2A26]">
                {d.car}
              </div>
            </div>

            <h3 class="text-lg font-bold text-white group-hover:text-[#00E699] transition-colors font-display">
              {d.name}
            </h3>
            <div class="text-[11px] font-mono uppercase text-[#8B9A8F] mt-0.5">
              {d.role}
            </div>
          </div>

          <div class="pt-3 border-t border-[#1E2A26] flex flex-wrap gap-1.5">
            {d.tags.map(t => (
              <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-[#080C0A] text-[#8B9A8F] border border-[#1E2A26]">
                {t}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. TECNOLOGÍA: 3 PILARES DEL GARAGE                                      -->
  <!-- ========================================================================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
      <div class="text-xs font-mono uppercase tracking-widest text-[#00E699]">INGENIERÍA SIMRACING</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-display tracking-tight">
        Ecosistema Muntrume Garage
      </h2>
      <p class="text-xs sm:text-sm text-[#8B9A8F] leading-relaxed">
        Herramientas de competición desarrolladas bajo los estándares de ingeniería de ATM Software Labs.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Box #01: Setup Vault & Raw FTP -->
      <div class="paddock-card p-6 flex flex-col justify-between space-y-4">
        <div>
          <div class="text-xs font-mono font-bold text-[#00E699] mb-2">BOX #01 &middot; SETUPS &amp; FTP</div>
          <h3 class="text-xl font-bold text-white font-display">Setup Vault Automatizado</h3>
          <p class="text-xs text-[#8B9A8F] mt-2 leading-relaxed">
            239.539 setups firmados digitalmente. Descarga e inyección directa en <code class="text-white font-mono">Documents\iRacing\setups</code> con explorador FTP integrado.
          </p>
        </div>
        <a href="/garage" class="text-xs font-mono font-bold text-[#00E699] hover:underline flex items-center gap-1.5 pt-4 border-t border-[#1E2A26]">
          <span>Entrar al Garage</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Box #02: Telemetría Garage 61 -->
      <div class="paddock-card p-6 flex flex-col justify-between space-y-4">
        <div>
          <div class="text-xs font-mono font-bold text-[#00E699] mb-2">BOX #02 &middot; TELEMETRY</div>
          <h3 class="text-xl font-bold text-white font-display">Telemetría Garage 61</h3>
          <p class="text-xs text-[#8B9A8F] mt-2 leading-relaxed">
            Sincronización directa con los servidores de Garage 61. Análisis de mejores vueltas, deltas de acelerador/freno y tiempos de referencia.
          </p>
        </div>
        <a href="/garage" class="text-xs font-mono font-bold text-[#00E699] hover:underline flex items-center gap-1.5 pt-4 border-t border-[#1E2A26]">
          <span>Ver Métricas</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Box #03: Paddock & Comms -->
      <div class="paddock-card p-6 flex flex-col justify-between space-y-4">
        <div>
          <div class="text-xs font-mono font-bold text-[#00E699] mb-2">BOX #03 &middot; COMMS &amp; RADIO</div>
          <h3 class="text-xl font-bold text-white font-display">Paddock &amp; Canales</h3>
          <p class="text-xs text-[#8B9A8F] mt-2 leading-relaxed">
            Coordinación de carrera privada para pilotos oficiales con enrutamiento seguro bajo dominio <code class="text-white font-mono">trujillomingorance.com</code>.
          </p>
        </div>
        <a href="/paddock" class="text-xs font-mono font-bold text-[#00E699] hover:underline flex items-center gap-1.5 pt-4 border-t border-[#1E2A26]">
          <span>Ver Paddock</span>
          <span>&rarr;</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. CALL TO ACTION: DISCORD PADDOCK RADIO                                  -->
  <!-- ========================================================================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="paddock-card p-8 sm:p-12 text-center relative overflow-hidden bg-gradient-to-b from-[#121A17] to-[#080C0A]">
      <div class="max-w-2xl mx-auto space-y-4 relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#080C0A] border border-[#1E2A26] text-xs font-mono text-[#00E699]">
          <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
          <span>CANAL DE RADIO Y TELEMETRÍA</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white font-display tracking-tight">
          ÚNETE A LA RADIO DE MUNTRUME
        </h2>
        <p class="text-xs sm:text-sm text-[#8B9A8F] leading-relaxed">
          Comunidad de pilotos, ingenieros de pista y aficionados al sim racing en iRacing. Acceso libre al canal general y debates de telemetría.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a 
            href="https://discord.gg/ehX6B8JUtE" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-7 py-3.5 rounded-xl bg-[#00E699] hover:bg-[#00c985] text-neutral-950 font-black text-xs uppercase tracking-wider transition shadow-lg shadow-[#00E699]/20"
          >
            Conectar con Discord
          </a>
          <a 
            href="/paddock" 
            class="px-7 py-3.5 rounded-xl bg-[#080C0A] hover:bg-white/5 border border-[#1E2A26] text-white font-bold text-xs uppercase tracking-wider transition"
          >
            Request Paddock Pass
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
