  </style>

  <!-- Local Rust Bridge Live Detection on Home Hero (127.0.0.1:38421) -->
  <script is:inline>
    (() => {
      const bridgeBadge = document.getElementById('heroLocalBridgeBadge');
      const bridgeTxt = document.getElementById('heroLocalBridgeText');
      if (bridgeBadge && bridgeTxt) {
        const ctrl = new AbortController();
        const timer = setTimeout(() => ctrl.abort(), 450);
        fetch('http://127.0.0.1:38421/ping', { method: 'GET', signal: ctrl.signal })
          .then((r) => (r.ok ? r.json() : null))
          .then((info) => {
            clearTimeout(timer);
            if (info && info.status === 'ready') {
              bridgeBadge.hidden = false;
              bridgeTxt.textContent = info.inTrack
                ? `MMT Sync v${info.version} · iRacing en Pista`
                : `MMT Sync v${info.version} Activo · Lanzar HUD`;
              bridgeBadge.addEventListener('click', () => {
                fetch('http://127.0.0.1:38421/command', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ action: 'launch-overlay' }),
                })
                  .then(() => { bridgeTxt.textContent = '✓ HUD 60Hz Lanzado en iRacing'; })
                  .catch(() => {});
              });
            }
          })
          .catch(() => { clearTimeout(timer); });
      }
    })();
  </script>

  <script is:inline src="/assets/js/home-r.js?v=t330" defer></script>
