---
import catalog from "../../public/assets/data/catalog_index.json";
import { PILOTOS } from "../lib/pilotos";
import { licenciaPrincipal } from "../lib/licencias";
import { formatoAprox, localeDeIdioma } from "../lib/formato-licencia.js";

const totalHours = Math.round(PILOTOS.reduce((sum, driver) => sum + driver.totalTrackHours, 0) * 10) / 10;
const irRows = PILOTOS.map((d) => licenciaPrincipal(d.slug)?.irating ?? 0).filter((n) => n > 0);
const avgIr = irRows.length ? Math.round(irRows.reduce((a, b) => a + b, 0) / irRows.length) : 0;
const loc = localeDeIdioma("es");
---
<section class="d-band d-reveal grid grid-cols-2 lg:grid-cols-4 gap-4 w-full mb-6" aria-label="Cifras del equipo" data-i18n-aria="band.aria">
  <div class="rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-[var(--r-text)]" data-i18n-num={PILOTOS.length}>{PILOTOS.length}</strong>
    <span class="text-xs font-mono text-[var(--r-muted)]" data-i18n="band.drivers">Pilotos activos</span>
  </div>
  <div class="rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-[var(--r-text)]" data-approx="h" data-n={totalHours}>{formatoAprox(totalHours, "h", loc)}</strong>
    <span class="text-xs font-mono text-[var(--r-muted)]" data-i18n="band.hours">Horas de Sports Car (Garage 61)</span>
  </div>
  <div class="rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-[var(--r-text)]" id="teamAvgIr" data-approx="k" data-n={avgIr}>{formatoAprox(avgIr, "k", loc)}</strong>
    <span class="text-xs font-mono text-[var(--r-muted)]" data-i18n="band.ir">iRating medio de Sports Car</span>
  </div>
  <div class="rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-[var(--r-text)]" data-i18n-num={catalog.total_setups}>{catalog.total_setups.toLocaleString("es-ES")}</strong>
    <span class="text-xs font-mono text-[var(--r-muted)]" data-i18n="band.setups">Setups en el catálogo</span>
  </div>
  <div id="nextEventStat" class="rounded-xl border border-[var(--r-line)] bg-[var(--r-surface)] p-4 flex flex-col justify-center gap-1" hidden>
    <strong data-next-title></strong>
    <time data-next-when></time>
    <span data-i18n="band.next">Próxima carrera</span>
  </div>
</section>
