---
import catalog from "../../public/assets/data/catalog_index.json";
import { PILOTOS } from "../lib/pilotos";
import { licenciaPrincipal } from "../lib/licencias";
import { formatoAprox, localeDeIdioma } from "../lib/formato-licencia.js";

const totalHours = Math.round(PILOTOS.reduce((sum, driver) => sum + driver.totalTrackHours, 0) * 10) / 10;
const irRows = PILOTOS.map((d) => licenciaPrincipal(d.slug)?.irating ?? 0).filter((n) => n > 0);
const avgIr = irRows.length ? Math.round(irRows.reduce((a, b) => a + b, 0) / irRows.length) : 0;
const loc = localeDeIdioma("en");
const setups = catalog.total_setups.toLocaleString("en-US");
---
<section class="d-band d-reveal grid grid-cols-2 lg:grid-cols-4 gap-4 w-full mb-6" aria-label="Team Telemetry Figures">
  <div class="rounded-xl border border-[#232C2A] bg-[#101514] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-white">{PILOTOS.length}</strong>
    <span class="text-xs font-mono text-[#A3B0AC]">Active Drivers</span>
  </div>
  <div class="rounded-xl border border-[#232C2A] bg-[#101514] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-white" data-approx="h" data-n={totalHours}>{formatoAprox(totalHours, "h", loc)}</strong>
    <span class="text-xs font-mono text-[#A3B0AC]">Sports Car Hours (Garage 61)</span>
  </div>
  <div class="rounded-xl border border-[#232C2A] bg-[#101514] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-white" id="teamAvgIr" data-approx="k" data-n={avgIr}>{formatoAprox(avgIr, "k", loc)}</strong>
    <span class="text-xs font-mono text-[#A3B0AC]">Avg Sports Car iRating</span>
  </div>
  <div class="rounded-xl border border-[#232C2A] bg-[#101514] p-4 flex flex-col justify-center gap-1">
    <strong class="text-2xl font-extrabold text-white">{setups}</strong>
    <span class="text-xs font-mono text-[#A3B0AC]">Setups in the Vault</span>
  </div>
  <div id="nextEventStat" class="rounded-xl border border-[#232C2A] bg-[#101514] p-4 flex flex-col justify-center gap-1" hidden>
    <strong data-next-title></strong>
    <time data-next-when></time>
    <span>Next Event</span>
  </div>
</section>
