---
import catalog from '../../public/assets/data/catalog_index.json';
import { PILOTOS } from '../lib/pilotos';
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

export const OFFICIAL_STATS = [
  { number: catalog.total_setups.toLocaleString('en-US'), label: "Setups in the Vault", detail: "Certified .STO files", tag: "Setup Vault" },
  { number: String(catalog.cars.length), label: "Supported Cars", detail: "Sports Car, GT3 & GT4", tag: "Cars" },
  { number: String(catalog.circuits.length), label: "Calibrated Circuits", detail: "Road & Endurance tracks", tag: "Circuits" },
  { number: String(PILOTOS.length), label: "Official Drivers", detail: "Numbers #16, #1, #22", tag: "Roster" }
];
---

<div class={`grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 ${className}`}>
  {OFFICIAL_STATS.map((s) => (
    <div class="relative group p-4 sm:p-5 rounded-2xl bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-[var(--r-accent)] transition-all duration-300 flex flex-col justify-between overflow-hidden">
      <div class="flex items-center justify-between gap-2 mb-3">
        <span class="text-[10px] font-mono uppercase tracking-widest text-[var(--r-muted)]">{s.tag}</span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--r-accent)] opacity-80 group-hover:scale-125 transition-transform"></span>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--r-text)] tracking-tight font-display mb-1">
          {s.number}
        </div>
        <div class="text-xs font-bold text-[var(--r-text)]">
          {s.label}
        </div>
        <div class="text-[11px] text-[var(--r-muted)] font-mono mt-0.5 truncate">
          {s.detail}
        </div>
      </div>
    </div>
  ))}
</div>
