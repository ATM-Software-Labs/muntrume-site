---
import Layout from '../layouts/Layout.astro';

export interface TocItem {
  id: string;
  label: string;
}

export interface Props {
  title: string;
  description: string;
  slug: string; // "" for index, or "modelos", "artefactos", "seguridad", "api", "seo-llms"
  kicker?: string;
  toc?: TocItem[];
  prev?: { href: string; label: string } | null;
  next?: { href: string; label: string } | null;
  jsonLd?: any;
}

const {
  title,
  description,
  slug,
  kicker = "MUNTRUME AI DOCS · OPEN SOURCE (MIT)",
  toc = [],
  prev = null,
  next = null,
  jsonLd = null,
} = Astro.props;

const canonical = slug ? `https://docs.muntru.me/${slug}/` : "https://docs.muntru.me/";

const NAV_GROUPS = [
  {
    title: "Primeros pasos",
    items: [
      { slug: "", href: "https://docs.muntru.me/", label: "Introducción y Arquitectura" },
      { slug: "modelos", href: "https://docs.muntru.me/modelos/", label: "Motores 1.0, Skills y Slash" },
    ],
  },
  {
    title: "Plataforma y Ecosistema",
    items: [
      { slug: "mmt-sync", href: "https://docs.muntru.me/mmt-sync/", label: "MMT Sync, Overlays & Calendario" },
      { slug: "artefactos", href: "https://docs.muntru.me/artefactos/", label: "Artifacts Studio y Hosting" },
      { slug: "seguridad", href: "https://docs.muntru.me/seguridad/", label: "Seguridad, Passkeys y MFA" },
    ],
  },
  {
    title: "Desarrolladores e IAs",
    items: [
      { slug: "api", href: "https://docs.muntru.me/api/", label: "Referencia API REST & SSE" },
      { slug: "seo-llms", href: "https://docs.muntru.me/seo-llms/", label: "SEO, LLMs y OpenAPI" },
    ],
  },
];

const defaultLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  url: canonical,
  inLanguage: "es",
  author: { "@type": "Organization", name: "Muntrume Motorsport", url: "https://muntru.me/" },
  publisher: { "@type": "Organization", name: "Muntrume Motorsport", url: "https://muntru.me/" },
};

const fullLd = jsonLd ? (Array.isArray(jsonLd) ? [defaultLd, ...jsonLd] : [defaultLd, jsonLd]) : defaultLd;
---

<Layout title={`${title} · Muntrume AI Docs`} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(fullLd)} />

  <div class="mdoc-page">
    <!-- Mobile subpage switcher -->
    <div class="mdoc-mob-bar">
      <div class="mdoc-mob-bar__scroll">
        {NAV_GROUPS.flatMap((g) => g.items).map((it) => (
          <a href={it.href} class:list={["mdoc-mob-pill", { "is-active": it.slug === slug }]}>{it.label}</a>
        ))}
      </div>
    </div>

    <div class="mdoc-grid">
      <!-- LEFT SIDEBAR -->
      <aside class="mdoc-sidebar" aria-label="Navegación de Muntrume Docs">
        <div class="mdoc-sidebar__brand">
          <span class="mdoc-brand-dot" aria-hidden="true"></span>
          <div>
            <strong>docs.muntru.me</strong>
            <span>Documentación v1.2 · 2026 S4</span>
          </div>
        </div>

        <label class="mdoc-search" aria-label="Filtrar guías de documentación">
          <input id="mdocFilterInput" type="search" placeholder="Filtrar guías…" autocomplete="off" />
        </label>

        {NAV_GROUPS.map((group) => (
          <div class="mdoc-nav-group" data-doc-group>
            <div class="mdoc-nav-group__title">{group.title}</div>
            {group.items.map((it) => (
              <a href={it.href} data-doc-nav-item class:list={["mdoc-nav-link", { "is-active": it.slug === slug }]} aria-current={it.slug === slug ? "page" : undefined}>
                {it.label}
              </a>
            ))}
          </div>
        ))}

        <div class="mdoc-sidebar__foot">
          <a href="https://ai.muntru.me/" class="mdoc-cta-mini">Abrir Muntrume AI Studio ↗</a>
          <a href="https://muntru.me/app/" class="mdoc-cta-mini mdoc-cta-mini--sub">Descargar MMT Sync ↗</a>
        </div>
      </aside>

      <!-- CENTER CONTENT -->
      <article class="mdoc-article">
        <div class="mdoc-crumb">
          <a href="https://muntru.me/">muntru.me</a>
          <span aria-hidden="true">/</span>
          <a href="https://docs.muntru.me/">docs.muntru.me</a>
          {slug && (
            <>
              <span aria-hidden="true">/</span>
              <span>{title}</span>
            </>
          )}
        </div>
        <div class="mdoc-kicker">
          <span class="mdoc-kicker__dot" aria-hidden="true"></span>
          <span>{kicker}</span>
        </div>

        <slot />

        {(prev || next) && (
          <nav class="mdoc-pager" aria-label="Navegación entre páginas">
            {prev ? (
              <a href={prev.href} class="mdoc-pager__btn mdoc-pager__btn--prev">
                <span>← Anterior</span>
                <strong>{prev.label}</strong>
              </a>
            ) : <div />}
            {next ? (
              <a href={next.href} class="mdoc-pager__btn mdoc-pager__btn--next">
                <span>Siguiente →</span>
                <strong>{next.label}</strong>
              </a>
            ) : <div />}
          </nav>
        )}
      </article>

      <!-- RIGHT RAIL -->
      <aside class="mdoc-rail" aria-label="En esta página">
        {toc.length > 0 && (
          <>
            <div class="mdoc-rail__title">En esta página</div>
            <nav class="mdoc-rail__nav">
              {toc.map((item, idx) => (
                <a href={`#${item.id}`} data-rail-link={item.id} class:list={[{ "is-active": idx === 0 }]}>{item.label}</a>
              ))}
            </nav>
          </>
        )}

        <div class="mdoc-rail__box">
          <div class="mdoc-rail__title">Especificaciones</div>
          <a href="https://docs.muntru.me/llms.txt">llms.txt ↗</a>
          <a href="https://docs.muntru.me/llms-full.txt">llms-full.txt ↗</a>
          <a href="https://docs.muntru.me/ai-knowledge.json">ai-knowledge.json ↗</a>
          <a href="https://docs.muntru.me/ai-openapi.json">ai-openapi.json ↗</a>
          <a href="https://docs.muntru.me/.well-known/ai-plugin.json">ai-plugin.json ↗</a>
        </div>
      </aside>
    </div>
  </div>

  <script is:inline>
    (function () {
      // Canonical redirect: keep all docs served under docs.muntru.me
      var host = location.hostname.toLowerCase();
      if (host === 'muntru.me' || host === 'www.muntru.me' || host === 'ai.muntru.me') {
        var sub = location.pathname.replace(/^\/(?:ai-docs|docs)\/?/i, '').replace(/\/+$/, '');
        var dest = 'https://docs.muntru.me/' + (sub ? sub + '/' : '') + location.search + location.hash;
        location.replace(dest);
        return;
      }

      var filterInput = document.getElementById('mdocFilterInput');
      if (filterInput) {
        filterInput.addEventListener('input', function () {
          var q = (filterInput.value || '').trim().toLowerCase();
          document.querySelectorAll('[data-doc-group]').forEach(function (group) {
            var any = false;
            group.querySelectorAll('[data-doc-nav-item]').forEach(function (link) {
              var match = !q || (link.textContent || '').toLowerCase().indexOf(q) !== -1;
              link.hidden = !match;
              if (match) any = true;
            });
            group.hidden = !any;
          });
        });
      }

      var sections = document.querySelectorAll('[data-doc-section]');
      if ('IntersectionObserver' in window && sections.length) {
        var spy = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var id = entry.target.getAttribute('data-doc-section');
            if (!id) return;
            document.querySelectorAll('[data-rail-link]').forEach(function (a) {
              a.classList.toggle('is-active', a.getAttribute('data-rail-link') === id);
            });
          });
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0 });
        sections.forEach(function (sec) { spy.observe(sec); });
      }
    })();
  </script>
</Layout>

<style is:global>
  .mdoc-page { background: var(--r-bg); color: var(--r-text); min-height: 100vh; padding-top: 64px; }
  .mdoc-mob-bar { display: none; border-bottom: 1px solid var(--r-line); background: var(--r-surface); padding: 10px 16px; }
  .mdoc-mob-bar__scroll { display: flex; gap: 8px; overflow-x: auto; }
  .mdoc-mob-pill { flex-shrink: 0; font-size: 12.5px; font-weight: 600; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--r-line); color: var(--r-muted); text-decoration: none; background: var(--r-bg); }
  .mdoc-mob-pill.is-active { color: var(--r-accent, #10b981); border-color: var(--r-accent, #10b981); background: color-mix(in srgb, var(--r-accent, #10b981) 12%, var(--r-bg)); }

  .mdoc-grid { max-width: 1380px; margin: 0 auto; padding: 0 24px 96px; display: grid; grid-template-columns: 256px minmax(0, 1fr) 216px; gap: 44px; align-items: start; }
  .mdoc-sidebar { position: sticky; top: 84px; max-height: calc(100vh - 104px); overflow-y: auto; padding-right: 12px; border-right: 1px solid var(--r-line); }
  .mdoc-sidebar__brand { display: flex; align-items: center; gap: 10px; padding: 0 8px 16px; margin-bottom: 16px; border-bottom: 1px solid var(--r-line); }
  .mdoc-sidebar__brand strong { display: block; font-size: 14px; color: var(--r-text); }
  .mdoc-sidebar__brand span { display: block; font: 600 11px/1.3 var(--r-mono, ui-monospace, monospace); color: var(--r-muted); }
  .mdoc-brand-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--r-accent, #10b981); box-shadow: 0 0 0 4px color-mix(in srgb, var(--r-accent, #10b981) 18%, transparent); flex-shrink: 0; }
  .mdoc-search { display: block; margin-bottom: 16px; }
  .mdoc-search input { width: 100%; padding: 8px 11px; border-radius: 9px; border: 1px solid var(--r-line); background: var(--r-surface); color: var(--r-text); font-size: 12.5px; outline: none; transition: border-color .15s ease; }
  .mdoc-search input:focus { border-color: var(--r-accent, #10b981); }
  .mdoc-nav-group { margin-bottom: 20px; }
  .mdoc-nav-group__title { font: 700 11px/1 var(--r-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 0.08em; color: var(--r-muted); padding: 0 10px 8px; }
  .mdoc-nav-link { display: block; padding: 8px 10px; margin-bottom: 2px; border-radius: 8px; font-size: 13.5px; font-weight: 500; color: var(--r-muted); text-decoration: none; border-left: 2px solid transparent; transition: background .15s ease, color .15s ease, border-color .15s ease; }
  .mdoc-nav-link:hover { color: var(--r-text); background: color-mix(in srgb, var(--r-text) 5%, transparent); }
  .mdoc-nav-link.is-active { color: var(--r-accent, #10b981); font-weight: 600; background: color-mix(in srgb, var(--r-accent, #10b981) 10%, transparent); border-left-color: var(--r-accent, #10b981); }
  .mdoc-sidebar__foot { padding-top: 12px; border-top: 1px solid var(--r-line); display: grid; gap: 8px; }
  .mdoc-cta-mini { display: flex; align-items: center; justify-content: center; padding: 9px 12px; border-radius: 10px; background: color-mix(in srgb, var(--r-accent, #10b981) 12%, var(--r-surface)); border: 1px solid color-mix(in srgb, var(--r-accent, #10b981) 30%, transparent); color: var(--r-accent, #10b981); font-size: 13px; font-weight: 600; text-decoration: none; }
  .mdoc-cta-mini:hover { background: color-mix(in srgb, var(--r-accent, #10b981) 18%, var(--r-surface)); }
  .mdoc-cta-mini--sub { background: var(--r-surface); border-color: var(--r-line); color: var(--r-text); font-size: 12.5px; }
  .mdoc-cta-mini--sub:hover { border-color: var(--r-accent, #10b981); color: var(--r-accent, #10b981); background: var(--r-surface); }

  .mdoc-article { min-width: 0; max-width: 820px; padding-top: 24px; }
  .mdoc-crumb { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--r-muted); margin-bottom: 14px; }
  .mdoc-crumb a { color: var(--r-muted); text-decoration: none; }
  .mdoc-crumb a:hover { color: var(--r-text); }
  .mdoc-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--r-line); background: var(--r-surface); font: 700 10.5px/1 var(--r-mono, ui-monospace, monospace); letter-spacing: 0.08em; color: var(--r-accent, #10b981); margin-bottom: 14px; }
  .mdoc-kicker__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--r-accent, #10b981); }

  .mdoc-article h1 { font-family: var(--r-sans, system-ui, -apple-system, sans-serif); text-transform: none; font-size: clamp(28px, 4vw, 42px); font-weight: 700; line-height: 1.12; letter-spacing: -0.03em; margin: 0 0 14px; color: var(--r-text); }
  .mdoc-lead { font-size: 16px; line-height: 1.68; color: var(--r-muted); margin: 0 0 22px; }
  .mdoc-lead strong { color: var(--r-text); }
  .mdoc-lead a { color: var(--r-accent, #10b981); text-decoration: none; font-weight: 600; }
  .mdoc-lead a:hover { text-decoration: underline; }
  .mdoc-hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }

  .mdoc-callout { border: 1px solid var(--r-line); border-left: 3px solid var(--r-accent, #10b981); background: var(--r-surface); border-radius: 12px; padding: 14px 18px; margin: 18px 0; }
  .mdoc-callout--warn { border-left-color: #f59e0b; }
  .mdoc-callout__title { font-size: 13px; font-weight: 700; color: var(--r-text); margin-bottom: 4px; }
  .mdoc-callout p { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--r-muted); }
  .mdoc-callout a { color: var(--r-accent, #10b981); text-decoration: none; font-weight: 600; }

  .mdoc-section { margin-top: 42px; padding-top: 28px; border-top: 1px solid var(--r-line); scroll-margin-top: 86px; }
  .mdoc-section h2 { font-family: var(--r-sans, system-ui, -apple-system, sans-serif); text-transform: none; font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 8px; color: var(--r-text); }
  .mdoc-section h3 { font-size: 16px; font-weight: 700; margin: 18px 0 8px; color: var(--r-text); }
  .mdoc-sub { margin: 0 0 18px; font-size: 15px; line-height: 1.65; color: var(--r-muted); }
  .mdoc-article code { font-family: var(--r-mono, ui-monospace, Consolas, monospace); font-size: 0.86em; padding: 2px 6px; border-radius: 6px; background: color-mix(in srgb, var(--r-text) 6%, var(--r-surface)); color: var(--r-text); border: 1px solid var(--r-line); }

  .mdoc-cards { display: grid; gap: 14px; }
  .mdoc-cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .mdoc-cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mdoc-card { background: var(--r-surface); border: 1px solid var(--r-line); border-radius: 14px; padding: 18px 20px; text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .mdoc-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--r-accent, #10b981) 45%, var(--r-line)); box-shadow: 0 12px 28px -18px rgba(0, 0, 0, .35); }
  .mdoc-step { font: 700 11px/1 var(--r-mono, ui-monospace, monospace); color: var(--r-accent, #10b981); margin-bottom: 10px; }
  .mdoc-card__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }
  .mdoc-card__head span { font: 600 11px/1 var(--r-mono, ui-monospace, monospace); color: var(--r-muted); }
  .mdoc-card h3 { margin: 0 0 6px; font-size: 15.5px; color: var(--r-text); }
  .mdoc-card p { margin: 0; font-size: 13.8px; line-height: 1.6; color: var(--r-muted); flex: 1; }
  .mdoc-card__more { margin-top: 12px; font-size: 13px; font-weight: 600; color: var(--r-accent, #10b981); }

  .mdoc-feature-list { border: 1px solid var(--r-line); border-radius: 14px; background: var(--r-surface); overflow: hidden; }
  .mdoc-feature { display: grid; grid-template-columns: 205px minmax(0, 1fr); gap: 16px; padding: 14px 18px; border-bottom: 1px solid var(--r-line); }
  .mdoc-feature:last-child { border-bottom: 0; }
  .mdoc-feature__k { font-size: 13.5px; font-weight: 700; color: var(--r-text); }
  .mdoc-feature__v { font-size: 14px; line-height: 1.6; color: var(--r-muted); }
  .mdoc-feature__v strong { color: var(--r-text); }
  .mdoc-bullets { margin: 0; padding-left: 20px; display: grid; gap: 10px; font-size: 14.5px; line-height: 1.65; color: var(--r-muted); }
  .mdoc-bullets strong { color: var(--r-text); }

  .mdoc-table-wrap { overflow-x: auto; border: 1px solid var(--r-line); border-radius: 14px; background: var(--r-surface); }
  .mdoc-table { width: 100%; border-collapse: collapse; font-size: 13.8px; }
  .mdoc-table th, .mdoc-table td { padding: 12px 15px; border-bottom: 1px solid var(--r-line); text-align: left; vertical-align: top; }
  .mdoc-table tbody tr:last-child td { border-bottom: 0; }
  .mdoc-table tbody tr:hover { background: color-mix(in srgb, var(--r-text) 3%, transparent); }
  .mdoc-table th { font: 700 11px/1 var(--r-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 0.06em; color: var(--r-muted); background: color-mix(in srgb, var(--r-text) 3%, var(--r-surface)); }
  .mdoc-table td { color: var(--r-muted); line-height: 1.55; }
  .mdoc-table td strong { color: var(--r-text); }
  .mdoc-table td a { color: var(--r-accent, #10b981); text-decoration: none; font-weight: 600; }
  .mdoc-tag { display: inline-block; margin-left: 6px; padding: 2px 7px; border-radius: 999px; font: 700 10px/1.2 var(--r-mono, ui-monospace, monospace); color: var(--r-accent, #10b981); background: color-mix(in srgb, var(--r-accent, #10b981) 12%, transparent); border: 1px solid color-mix(in srgb, var(--r-accent, #10b981) 30%, transparent); }

  .mdoc-code-box { border: 1px solid var(--r-line); border-radius: 14px; overflow: hidden; background: #0d1016; margin: 14px 0; }
  .mdoc-code-box__bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 12px; background: #141923; border-bottom: 1px solid rgba(255,255,255,.08); }
  .mdoc-code-tabs { display: flex; gap: 4px; flex-wrap: wrap; }
  .mdoc-code-tab { border: 0; background: transparent; color: #9aa4b2; padding: 6px 11px; border-radius: 8px; font: 600 12px/1 system-ui, sans-serif; cursor: pointer; }
  .mdoc-code-tab.is-active { color: #10b981; background: rgba(16,185,129,.14); }
  .mdoc-copy-btn { border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.05); color: #e5e7eb; padding: 5px 11px; border-radius: 8px; font: 600 12px/1 system-ui, sans-serif; cursor: pointer; }
  .mdoc-copy-btn:hover { border-color: #10b981; color: #10b981; }
  .mdoc-pre { margin: 0; padding: 16px 18px; overflow-x: auto; }
  .mdoc-pre[hidden] { display: none; }
  .mdoc-pre code { background: transparent !important; border: 0 !important; padding: 0 !important; color: #e5e7eb !important; font-size: 13px; line-height: 1.62; }

  .mdoc-faq { display: grid; gap: 10px; }
  .mdoc-faq__item { border: 1px solid var(--r-line); border-radius: 12px; background: var(--r-surface); padding: 14px 18px; }
  .mdoc-faq__item summary { font-size: 14.5px; font-weight: 700; color: var(--r-text); cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mdoc-faq__item summary::after { content: "+"; font: 700 16px/1 var(--r-mono, monospace); color: var(--r-accent, #10b981); }
  .mdoc-faq__item[open] summary::after { content: "−"; }
  .mdoc-faq__item p { margin: 10px 0 0; font-size: 14px; line-height: 1.65; color: var(--r-muted); }

  .mdoc-pager { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--r-line); }
  .mdoc-pager__btn { display: flex; flex-direction: column; gap: 4px; padding: 14px 18px; border-radius: 12px; border: 1px solid var(--r-line); background: var(--r-surface); text-decoration: none; transition: border-color .18s ease, transform .18s ease; }
  .mdoc-pager__btn:hover { border-color: var(--r-accent, #10b981); transform: translateY(-2px); }
  .mdoc-pager__btn--next { text-align: right; }
  .mdoc-pager__btn span { font: 600 11.5px/1 var(--r-mono, ui-monospace, monospace); color: var(--r-muted); }
  .mdoc-pager__btn strong { font-size: 14.5px; color: var(--r-text); }

  .mdoc-rail { position: sticky; top: 84px; }
  .mdoc-rail__title { font: 700 11px/1 var(--r-mono, ui-monospace, monospace); text-transform: uppercase; letter-spacing: 0.08em; color: var(--r-muted); margin-bottom: 10px; }
  .mdoc-rail__nav { display: grid; gap: 4px; border-left: 1px solid var(--r-line); padding-left: 12px; margin-bottom: 24px; }
  .mdoc-rail__nav a { font-size: 12.5px; color: var(--r-muted); text-decoration: none; padding: 3px 0; }
  .mdoc-rail__nav a:hover, .mdoc-rail__nav a.is-active { color: var(--r-accent, #10b981); font-weight: 600; }
  .mdoc-rail__box { display: grid; gap: 6px; padding-top: 16px; border-top: 1px solid var(--r-line); }
  .mdoc-rail__box a { font: 600 12px/1.3 var(--r-mono, ui-monospace, monospace); color: var(--r-muted); text-decoration: none; }
