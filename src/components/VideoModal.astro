---
/**
 * VideoModal.astro
 * Modal reproductor de vídeos directos de YouTube para circuitos y coches.
 * Escucha clics en elementos con [data-video-id] y reproduce el vídeo sin salir de la web.
 */
---
<div
  id="mmt-video-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-md p-3 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mmt-video-title"
>
  <div class="relative w-full max-w-4xl rounded-2xl border border-[var(--r-line)] bg-[#0c1017] shadow-2xl overflow-hidden flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between gap-3 px-5 py-3.5 border-b border-[var(--r-line)] bg-[var(--r-surface)]">
      <div class="min-w-0">
        <h3 id="mmt-video-title" class="text-sm sm:text-base font-extrabold text-[var(--r-text)] font-display truncate"></h3>
        <p id="mmt-video-sub" class="text-[11px] font-mono text-[var(--r-muted)] truncate"></p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          id="mmt-video-external"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1 rounded-lg bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-[var(--r-accent)] text-xs font-mono text-[var(--r-accent)] hover:text-white transition flex items-center gap-1.5 cursor-pointer"
          title="Abrir este vídeo directamente en YouTube"
        >
          <span>Abrir en YouTube</span>
          <span class="text-xs">↗</span>
        </a>
        <button
          id="mmt-video-close"
          type="button"
          aria-label="Cerrar reproductor"
          class="w-8 h-8 rounded-lg bg-[var(--r-bg-2)] border border-[var(--r-line)] hover:border-red-500 text-[var(--r-text)] hover:text-red-400 flex items-center justify-center font-bold transition cursor-pointer"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Video Stage / iframe -->
    <div class="relative w-full aspect-[16/9] bg-black">
      <iframe
        id="mmt-video-iframe"
        src=""
        title="Reproductor de vídeo iRacing"
        class="w-full h-full border-0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <!-- Footer info -->
    <div class="px-5 py-3 border-t border-[var(--r-line)] bg-[var(--r-surface)] flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[var(--r-muted)]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span>Vídeo oficial directo · Reproducción en alta definición</span>
      </div>
      <span class="text-[11px]">Pulsa ESC para cerrar</span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var modal = document.getElementById('mmt-video-modal');
    var iframe = document.getElementById('mmt-video-iframe');
    var titleEl = document.getElementById('mmt-video-title');
    var subEl = document.getElementById('mmt-video-sub');
    var externalLink = document.getElementById('mmt-video-external');
    var closeBtn = document.getElementById('mmt-video-close');

    function openVideo(videoId, title, channel) {
      if (!modal || !iframe || !videoId) return;
      var embedUrl = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1&rel=0';
      var watchUrl = 'https://www.youtube.com/watch?v=' + videoId;
      iframe.setAttribute('src', embedUrl);
      if (titleEl) titleEl.textContent = title || 'Vídeo oficial';
      if (subEl) subEl.textContent = channel || 'iRacing & Comunidad';
      if (externalLink) externalLink.setAttribute('href', watchUrl);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeVideo() {
      if (!modal || !iframe) return;
      iframe.setAttribute('src', '');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target.closest ? e.target.closest('[data-video-id]') : null;
      if (trigger) {
        // Solo interceptamos clic izquierdo sin modificadores para abrir el modal
        if (e.button === 0 && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
          e.preventDefault();
          var videoId = trigger.getAttribute('data-video-id');
          var title = trigger.getAttribute('data-video-title');
          var channel = trigger.getAttribute('data-video-channel');
          openVideo(videoId, title, channel);
        }
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeVideo);
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeVideo();
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeVideo();
      }
    });
  })();
</script>
