---
// Muntrume AI: solo el botón se carga con la página; el panel se descarga al abrirlo.
const isAiPage = Astro.url.pathname.startsWith('/ai');
---
<div id="muntrumeChatbot" class:list={["fixed z-50 font-sans", isAiPage && "hidden"]} style="right:max(0.85rem,env(safe-area-inset-right));bottom:max(0.85rem,env(safe-area-inset-bottom))" data-no-i18n>
  <button type="button" id="chatbotLaunchBtn" aria-haspopup="dialog" aria-expanded="false" aria-controls="mmChatPanel" aria-label="Abrir Muntrume AI"
    class="flex items-center justify-center gap-2 px-3 py-2 sm:px-4 sm:py-2.5 rounded-full bg-[var(--r-surface)] hover:bg-[var(--r-bg-2)] text-[var(--r-text)] border border-[var(--r-line)] hover:border-[var(--r-accent)] shadow-[0_8px_28px_rgba(0,0,0,0.22)] transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--r-accent)]">
    <span class="relative flex items-center justify-center w-6 h-6 rounded-full bg-[var(--r-accent)]/15 shrink-0" aria-hidden="true">
      <svg class="w-3.5 h-3.5 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z"/></svg>
      <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-[var(--r-surface)]"></span>
    </span>
    <span class="text-left leading-none">
      <span class="block text-[11px] sm:text-xs font-mono font-extrabold tracking-wide">MUNTRUME AI</span>
      <span class="hidden sm:block text-[10px] font-mono text-[var(--r-muted)] mt-0.5">Asistente IA</span>
    </span>
  </button>
</div>
<script is:inline>
(function(){var b=document.getElementById('chatbotLaunchBtn');if(!b)return;var p;function load(){return p||(p=import('/assets/js/chat-widget.js?v=t372'))}
b.addEventListener('pointerenter',load,{once:true});b.addEventListener('focus',load,{once:true});
b.addEventListener('click',function(){b.setAttribute('aria-busy','true');load().then(function(m){b.removeAttribute('aria-busy');m.open(b)}).catch(function(){b.removeAttribute('aria-busy');p=null;location.href='https://discord.gg/ehX6B8JUtE'})});})();
</script>
