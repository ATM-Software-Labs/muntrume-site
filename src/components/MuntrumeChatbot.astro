---
// Muntrume Motorsport Official AI Copilot Widget
// Connected via https://ai.trujillomingorance.com/
---

<div id="muntrumeChatbot" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 font-sans select-none" data-no-i18n>
  <!-- Floating Launch Button -->
  <button
    type="button"
    id="chatbotLaunchBtn"
    class="flex items-center gap-2.5 px-4 py-3 rounded-full bg-[#0E1513] hover:bg-[#15201C] text-white border border-[#00E699]/50 hover:border-[#00E699] shadow-[0_8px_30px_rgba(0,230,153,0.25)] transition-all duration-300 group cursor-pointer focus:outline-none"
    aria-label="Abrir asistente Muntrume AI"
  >
    <div class="relative flex items-center justify-center w-6 h-6 rounded-full bg-[#00E699]/20 text-[#00E699]">
      <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
      <svg class="w-4 h-4 text-[#00E699] absolute" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <div class="text-left">
      <div class="text-xs font-mono font-bold text-white group-hover:text-[#00E699] transition-colors leading-tight">
        MUNTRUME AI
      </div>
      <div class="text-[10px] font-mono text-[#9AA8A3] leading-tight">
        Copilot Oficial
      </div>
    </div>
  </button>

  <!-- Chat Window Panel (Hidden by default) -->
  <div
    id="chatbotPanel"
    class="hidden flex-col w-[calc(100vw-32px)] sm:w-[380px] h-[520px] max-h-[80vh] rounded-2xl bg-[#0E1513] border border-[#242E2C] shadow-[0_20px_50px_rgba(0,0,0,0.8)] overflow-hidden transition-all duration-300"
  >
    <!-- Header -->
    <div class="px-4 py-3.5 bg-[#141E1A] border-b border-[#242E2C] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-[#00E699]/15 border border-[#00E699]/40 flex items-center justify-center text-[#00E699] font-mono font-bold text-xs">
          AI
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-white text-xs font-display tracking-tight">MUNTRUME COPILOT</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[#00E699] animate-pulse"></span>
          </div>
          <div class="text-[10px] font-mono text-[#9AA8A3]">
            Motor oficial: <a href="https://ai.trujillomingorance.com/" target="_blank" rel="noopener noreferrer" class="text-[#00E699] hover:underline">Trujillo AI</a>
          </div>
        </div>
      </div>
      
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="chatbotClearBtn"
          class="p-1.5 text-[#9AA8A3] hover:text-white rounded-lg hover:bg-white/5 transition focus:outline-none"
          title="Reiniciar conversación"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>
        <button
          type="button"
          id="chatbotCloseBtn"
          class="p-1.5 text-[#9AA8A3] hover:text-white rounded-lg hover:bg-white/5 transition focus:outline-none"
          title="Cerrar chat"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="chatbotMessages" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs leading-relaxed">
      <!-- Default Welcome Message -->
      <div class="flex gap-2.5 items-start">
        <div class="w-6 h-6 rounded-md bg-[#00E699]/15 border border-[#00E699]/30 flex items-center justify-center text-[#00E699] text-[10px] font-mono shrink-0 mt-0.5">
          AI
        </div>
        <div class="p-3 rounded-xl rounded-tl-none bg-[#16201C] border border-[#242E2C] text-[#E0E6E4] max-w-[85%] space-y-2">
          <p>¡Hola! Soy el asistente y copiloto oficial de ingeniería de <strong>Muntrume Motorsport</strong>.</p>
          <p class="text-[#9AA8A3] text-[11px]">Puedo orientarte sobre los 239k setups .STO, telemetría Garage 61, eventos de resistencia o acceso al Paddock.</p>
        </div>
      </div>
    </div>

    <!-- Quick Prompt Chips -->
    <div id="chatbotQuickChips" class="px-3 py-1.5 flex gap-1.5 overflow-x-auto no-scrollbar shrink-0 border-t border-[#1C2523] bg-[#0A0F0D]">
      <button type="button" class="quick-chip whitespace-nowrap text-[11px] font-mono px-2.5 py-1 rounded-full bg-[#16201C] hover:bg-[#1E2C26] text-[#9AA8A3] hover:text-white border border-[#242E2C] transition">
        🏎️ Setup GT3
      </button>
      <button type="button" class="quick-chip whitespace-nowrap text-[11px] font-mono px-2.5 py-1 rounded-full bg-[#16201C] hover:bg-[#1E2C26] text-[#9AA8A3] hover:text-white border border-[#242E2C] transition">
        ⏱️ Garage 61
      </button>
      <button type="button" class="quick-chip whitespace-nowrap text-[11px] font-mono px-2.5 py-1 rounded-full bg-[#16201C] hover:bg-[#1E2C26] text-[#9AA8A3] hover:text-white border border-[#242E2C] transition">
        📋 Paddock Pass
      </button>
    </div>

    <!-- Input Footer -->
    <form id="chatbotForm" class="p-3 bg-[#121A17] border-t border-[#242E2C] flex items-center gap-2 shrink-0">
      <input
        type="text"
        id="chatbotInput"
        placeholder="Escribe tu consulta de simracing..."
        autocomplete="off"
        class="flex-1 bg-[#0A0E0D] border border-[#242E2C] focus:border-[#00E699] rounded-xl px-3 py-2.5 text-xs text-white placeholder-[#788883] focus:outline-none transition"
      />
      <button
        type="submit"
        id="chatbotSendBtn"
        class="p-2.5 rounded-xl bg-[#00E699] hover:bg-[#00c985] text-neutral-950 font-bold transition disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
        title="Enviar mensaje"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </button>
    </form>
  </div>
</div>

<script is:inline>
(function initMuntrumeChatbot() {
  var launchBtn = document.getElementById('chatbotLaunchBtn');
  var panel = document.getElementById('chatbotPanel');
  var closeBtn = document.getElementById('chatbotCloseBtn');
  var clearBtn = document.getElementById('chatbotClearBtn');
  var form = document.getElementById('chatbotForm');
  var input = document.getElementById('chatbotInput');
  var messagesBox = document.getElementById('chatbotMessages');
  var quickChips = document.querySelectorAll('.quick-chip');

  if (!launchBtn || !panel || !form || !input || !messagesBox) return;

  var chatHistory = [];
  var isStreaming = false;

  // Toggle Visibility
  function toggleChat(open) {
    var shouldOpen = typeof open === 'boolean' ? open : panel.classList.contains('hidden');
    if (shouldOpen) {
      panel.classList.remove('hidden');
      panel.classList.add('flex');
      launchBtn.classList.add('hidden');
      setTimeout(function() { if (input) input.focus(); }, 100);
    } else {
      panel.classList.add('hidden');
      panel.classList.remove('flex');
      launchBtn.classList.remove('hidden');
    }
  }

  launchBtn.addEventListener('click', function() { toggleChat(true); });
  if (closeBtn) closeBtn.addEventListener('click', function() { toggleChat(false); });

  // Clear Chat History
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      chatHistory = [];
      messagesBox.innerHTML = [
        '<div class="flex gap-2.5 items-start">',
        '  <div class="w-6 h-6 rounded-md bg-[#00E699]/15 border border-[#00E699]/30 flex items-center justify-center text-[#00E699] text-[10px] font-mono shrink-0 mt-0.5">AI</div>',
        '  <div class="p-3 rounded-xl rounded-tl-none bg-[#16201C] border border-[#242E2C] text-[#E0E6E4] max-w-[85%] space-y-2">',
        '    <p>Conversación reiniciada. ¿En qué circuito o coche compites hoy?</p>',
        '  </div>',
        '</div>'
      ].join('');
    });
  }

  // Quick Chips
  quickChips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      var prompt = chip.textContent.trim().replace(/^[^\w\s]+/, '').trim();
      input.value = prompt;
      sendMessage(prompt);
    });
  });

  // Append Message
  function appendMessage(role, text) {
    var msgWrapper = document.createElement('div');
    msgWrapper.className = 'flex gap-2.5 items-start ' + (role === 'user' ? 'justify-end' : '');

    if (role === 'assistant') {
      var icon = document.createElement('div');
      icon.className = 'w-6 h-6 rounded-md bg-[#00E699]/15 border border-[#00E699]/30 flex items-center justify-center text-[#00E699] text-[10px] font-mono shrink-0 mt-0.5';
      icon.textContent = 'AI';
      msgWrapper.appendChild(icon);
    }

    var bubble = document.createElement('div');
    bubble.className = role === 'user'
      ? 'p-3 rounded-xl rounded-tr-none bg-[#00E699] text-neutral-950 font-medium max-w-[85%]'
      : 'p-3 rounded-xl rounded-tl-none bg-[#16201C] border border-[#242E2C] text-[#E0E6E4] max-w-[85%] leading-relaxed msg-content';
    bubble.textContent = text;

    msgWrapper.appendChild(bubble);
    messagesBox.appendChild(msgWrapper);
    messagesBox.scrollTop = messagesBox.scrollHeight;
    return bubble;
  }

  // Send Message & Connect to https://ai.trujillomingorance.com/
  async function sendMessage(text) {
    if (!text || !text.trim() || isStreaming) return;
    var prompt = text.trim();
    input.value = '';

    appendMessage('user', prompt);
    chatHistory.push({ role: 'user', content: prompt });

    var botBubble = appendMessage('assistant', 'Pensando telemetría...');
    isStreaming = true;

    try {
      var res = await fetch('https://ai.trujillomingorance.com/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          prompt: prompt,
          custom_prompt: 'Eres Muntrume AI, copiloto oficial de simracing de Muntrume Motorsport (Barcelona). Experto en setups (.STO), telemetría Garage 61, GT3/GTP e iRacing. Respuestas concisas y directas.',
          chat_history: chatHistory.slice(-6)
        })
      });

      if (!res.ok) {
        throw new Error('Servicio temporalmente ocupado (' + res.status + ')');
      }

      botBubble.textContent = '';
      var reader = res.body.getReader();
      var decoder = new TextDecoder();
      var accumulated = '';
      var buffer = '';

      while (true) {
        var chunk = await reader.read();
        if (chunk.done) break;
        buffer += decoder.decode(chunk.value, { stream: true });

        var lines = buffer.split('\n');
        buffer = lines.pop() || '';

        for (var i = 0; i < lines.length; i++) {
          var line = lines[i].trim();
          if (!line.startsWith('data:')) continue;
          var dataStr = line.replace(/^data:\s*/, '');
          if (dataStr === '[DONE]') break;
          try {
            var parsed = JSON.parse(dataStr);
            if (parsed.content) {
              accumulated += parsed.content;
              botBubble.textContent = accumulated;
              messagesBox.scrollTop = messagesBox.scrollHeight;
            }
          } catch (e) {}
        }
      }

      if (!accumulated) {
        botBubble.textContent = 'Recibido. Para sincronizar setups ingresa a https://muntru.me/garage o únete a la radio oficial de Discord.';
      }

      chatHistory.push({ role: 'assistant', content: accumulated || botBubble.textContent });
    } catch (err) {
      console.warn('[Muntrume AI]', err);
      botBubble.textContent = 'En este momento la telemetría en vivo está en boxes. Puedes consultar nuestros setups directamente en /garage o en discord.gg/ehX6B8JUtE.';
    } finally {
      isStreaming = false;
    }
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    sendMessage(input.value);
  });
})();
</script>
