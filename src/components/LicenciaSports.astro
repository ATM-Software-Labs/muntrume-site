---
import DriverHelmet from "./DriverHelmet.astro";
import { formatoAprox, localeDeIdioma } from "../lib/formato-licencia.js";
import { licenciaPrincipal, LICENCE_UPDATED_LABEL } from "../lib/licencias";

interface Props {
  slug: string;
  name: string;
  helmet?: string | null;
  heading?: "h1" | "h2" | "h3";
  headingId?: string;
  kicker?: string;
  eagerHelmet?: boolean;
}
const { slug, name, helmet, heading = "h2", headingId, kicker, eagerHelmet = false } = Astro.props;
const lic = licenciaPrincipal(slug);
const loc = localeDeIdioma("es");
const Tag = heading;
---
<article class="sc-block" data-lic="sports_car" data-driver-lic={slug}>
  <DriverHelmet name={name} src={helmet} eager={eagerHelmet} />
  <div class="sc-block__body">
    {kicker && <p class="r-kicker">{kicker}</p>}
    <Tag class="sc-block__name" id={headingId}>{name}</Tag>
    {lic && (
      <p class="sc-badge"><span data-lic-f="class">{lic.classLabel}</span></p>
    )}
    <dl class="sc-nums">
      <div><dt>SR</dt><dd data-approx="sr" data-n={lic?.sr ?? ""} data-lic-f="sr">{lic ? formatoAprox(Number(lic.sr), "sr", loc) : "Sin datos"}</dd></div>
      <div><dt>iRating</dt><dd data-approx="k" data-n={lic?.irating ?? ""} data-f="irating" data-lic-f="irating">{formatoAprox(lic?.irating ?? null, "k", loc)}</dd></div>
      <div><dt>ttRating</dt><dd data-approx="k" data-n={lic?.ttRating ?? ""} data-lic-f="tt">{lic ? formatoAprox(lic.ttRating, "k", loc) : "Sin datos"}</dd></div>
    </dl>
    <p class="r-meta" data-lic-updated>Actualizado: {LICENCE_UPDATED_LABEL}</p>
  </div>
</article>
