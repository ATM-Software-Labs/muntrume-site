---
interface Telemetry {
  lapTime?: string;
  fuelPerLap?: string;
  source?: string;
}

interface Props {
  id: string | number;
  file: string;
  kind: "race" | "qualy" | "wet" | "endurance";
  car: string;
  carId?: string;
  track: string;
  season: string;
  week: string;
  irVersion?: string;
  sizeKb: number;
  updatedAt?: string;
  telemetry?: Telemetry;
  typeLabel?: string;
  hidden?: boolean;
}

const {
  id,
  file,
  kind,
  car,
  carId = "",
  track,
  season,
  week,
  irVersion = "",
  sizeKb,
  updatedAt = "",
  telemetry,
  typeLabel = "",
  hidden = false,
} = Astro.props;

const kindLabel: Record<Props["kind"], string> = {
  race: "Carrera",
  qualy: "Clasificación",
  wet: "Lluvia",
  endurance: "Resistencia",
};

const version = irVersion.trim();
const when = updatedAt.trim();
const kb = Number.isFinite(sizeKb) && sizeKb > 0
  ? `${sizeKb.toLocaleString("es-ES", { minimumFractionDigits: 1, maximumFractionDigits: 1 })} KB`
  : "";
const seasonWeek = [season, week].map((part) => part.trim()).filter(Boolean).join(" · ");
const meta = [
  seasonWeek ? { k: "Temporada", v: seasonWeek } : null,
  kb ? { k: "Tamaño", v: kb } : null,
  when ? { k: "Fecha", v: when } : null,
].filter((cell): cell is { k: string; v: string } => cell !== null);
const telLap = telemetry?.lapTime?.trim() || "";
const telFuel = telemetry?.fuelPerLap?.trim() || "";
const telSource = telemetry?.source?.trim() || "";
const hasTelemetry = Boolean(telLap || telFuel);
---

<article
  class="glow-card setup-card"
  data-page-item
  data-kind={kind}
  hidden={hidden || undefined}
  style="contain: layout paint"
>
  <header class="setup-card__head">
    <span class={`setup-pill setup-pill--${kind}`}>{kindLabel[kind]}</span>
    {version && <span class="setup-ir">iR {version}</span>}
  </header>
  <p class="setup-card__file" title={file}><code>{file}</code></p>
  {meta.length > 0 && (
    <dl class="setup-card__meta">
      {meta.map((cell) => (
        <div>
          <dt>{cell.k}</dt>
          <dd class:list={[{ "setup-card__kb": cell.k === "Tamaño" }]}>{cell.v}</dd>
        </div>
      ))}
    </dl>
  )}
  {hasTelemetry && (
    <p class="setup-card__tel">
      {telLap && <span>Vuelta {telLap}</span>}
      {telFuel && <span>Consumo {telFuel}</span>}
      {telSource && <span>Fuente {telSource}</span>}
    </p>
  )}
  <footer class="setup-card__foot">
    <button
      type="button"
      class="setup-card__btn focus-ring"
      data-preview
      data-id={id}
      data-file={file}
      data-car={carId || car}
      data-track={track}
      data-season={season}
      data-week={week}
      data-type={typeLabel || kindLabel[kind]}
    >
      Vista previa
    </button>
    <button
      type="button"
      class="setup-card__btn setup-card__btn--go focus-ring"
      data-download
      data-id={id}
      data-file={file}
      data-auth="pending"
    >
      Inicia sesión
    </button>
  </footer>
</article>

<style>
  .setup-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 228px;
    padding: 14px;
    border: 1px solid var(--line);
    box-sizing: border-box;
  }
  .setup-card__head,
  .setup-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .setup-card__foot { margin-top: auto; }
  .setup-pill,
  .setup-ir {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding: 0 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font: 700 11px/1 ui-monospace, "JetBrains Mono", monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .setup-pill--qualy { color: #6d28d9; }
  .setup-pill--race { color: var(--r-accent); }
  .setup-pill--wet { color: #0369a1; }
  .setup-pill--endurance { color: #b45309; }
  :global(html.dark) .setup-pill--qualy { color: #ddd6fe; }
  :global(html.dark) .setup-pill--wet { color: #7dd3fc; }
  :global(html.dark) .setup-pill--endurance { color: #fbbf24; }
  .setup-ir { color: var(--txt); }
  .setup-card__file {
    margin: 0;
    min-width: 0;
  }
  .setup-card__file code {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 600 13px/1.3 ui-monospace, "JetBrains Mono", monospace;
    color: var(--txt);
  }
  .setup-card__tel {
    margin: 0;
    color: var(--mut);
    font: 500 12px/1.4 ui-sans-serif, system-ui, sans-serif;
  }
  .setup-card__tel {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding-top: 4px;
    border-top: 1px solid var(--line);
  }
  .setup-card__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
    gap: 8px;
    margin: 0;
  }
  .setup-card__meta dt {
    margin: 0;
    color: var(--mut);
    font: 600 10px/1.2 ui-monospace, monospace;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .setup-card__meta dd {
    margin: 3px 0 0;
    color: var(--txt);
    font: 600 12px/1.3 ui-sans-serif, system-ui, sans-serif;
  }
  .setup-card__kb { white-space: nowrap; }
  .setup-card__btn {
    min-height: 44px;
    min-width: 44px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--txt);
    font: 700 13px/1 ui-sans-serif, system-ui, sans-serif;
    cursor: pointer;
  }
  .setup-card__btn--go {
    background: var(--r-accent);
    color: var(--r-accent-ink);
    border-color: transparent;
  }
</style>
