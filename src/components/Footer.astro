<footer class="bg-[#0b0e13] border-t border-white/10 py-12 text-neutral-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 pb-8 border-b border-white/5">
      
      <!-- Brand & Corporate Identity -->
      <div class="flex items-center gap-3.5">
        <img src="/assets/img/logo-sm.webp" alt="Muntrume" class="h-8 w-auto" width="31" height="32" loading="lazy" decoding="async" />
        <div>
          <div class="font-extrabold text-white text-base tracking-tight">MUNTRUME MOTORSPORT</div>
          <div class="text-xs text-neutral-400 flex items-center gap-2">
            <span>Sant Andreu, Barcelona</span>
            <span class="text-neutral-600">·</span>
            <span class="inline-flex items-center gap-1 text-[11px] text-emerald-400 font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Systems Online</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Navigation & Governance Links -->
      <div class="flex flex-wrap items-center gap-6 text-sm font-medium">
        <a href="/" class="hover:text-emerald-400 transition-colors">Overview</a>
        <a href="/pilotos" class="hover:text-emerald-400 transition-colors">Pilots</a>
        <a href="/team" class="hover:text-emerald-400 transition-colors">Roster</a>
        <a href="/news" class="hover:text-emerald-400 transition-colors">Press Room</a>
        <a href="/about" class="hover:text-emerald-400 transition-colors">Organization</a>
        <a href="/contact" class="hover:text-emerald-400 transition-colors">Contact</a>
        <a href="/legal" class="hover:text-emerald-400 transition-colors text-xs text-neutral-400">Legal &amp; Privacy</a>
        <span class="text-neutral-700 hidden sm:inline">|</span>
        <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">Discord</a>
        <a href="https://twitch.tv/muntrumemrt" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">Twitch</a>
        <a href="https://github.com/atrumin16/muntrume-site" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">GitHub</a>
      </div>

    </div>

