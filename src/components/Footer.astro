---
const year = new Date().getFullYear();
---
<footer class="r-footer">
  <div class="r-wrap">
    <div class="r-footer__grid">
      <div style="display:grid;gap:14px;align-content:start">
        <a href="/" class="r-lockup" data-no-i18n>
          <img src="/assets/img/logo-64.webp" width="44" height="44" alt="Muntrume Motorsport" loading="lazy" decoding="async" />
          <span class="r-lockup__txt"><b>Muntrume</b><small>Motorsport</small></span>
        </a>
        <span class="text-xs text-[var(--r-muted)]">Official iRacing Sim Racing Team · Barcelona, Spain</span>
        <span class="r-footer__id">Principal: Alberto Trujillo · <a href="mailto:info@muntru.me">info@muntru.me</a></span>
      </div>
      <nav aria-label="Team">
        <h2>Team</h2>
        <ul>
          <li><a href="/drivers">Pilotos de Muntrume Motorsport</a></li>
          <li><a href="/news">Noticias de Muntrume Motorsport</a></li>
          <li><a href="/paddock">Paddock de Muntrume Motorsport</a></li>
          <li><a href="/ai">AI Copilot</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
      <nav aria-label="Driver Area">
        <h2>Driver Area</h2>
        <ul>
          <li><a href="/garage">Garage MMT de Muntrume Motorsport</a></li>
          <li><a href="/setup-builder">Setup Builder</a></li>
          <li><a href="/communications">Communications &amp; Webmail</a></li>
          <li><a href="https://mail.trujillomingorance.com" target="_blank" rel="noopener noreferrer">Corporate Webmail ↗</a></li>
          <li><a href="https://garage61.net/app/teams/muntrume-motorsport" target="_blank" rel="noopener noreferrer">Garage 61 Telemetry ↗</a></li>
          <li><a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer">Discord Radio ↗</a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2>Legal Information</h2>
        <ul>
          <li><a href="/aviso-legal">Legal Notice</a></li>
          <li><a href="/privacidad">Privacy Policy</a></li>
          <li><a href="/cookies">Cookie Policy</a></li>
          <li><a href="/legal/retirada">DMCA Takedown</a></li>
          <li><a href="/legal/fuentes">Media Sources</a></li>
        </ul>
      </nav>
    </div>
    <div class="r-footer__legal">
      <span>&copy; {year} Muntrume Motorsport <span>· All rights reserved</span></span>
      <span>Zero ad or tracking cookies · <a href="/cookies" style="font-size:12px;padding:0">Política de cookies de Muntrume Motorsport</a></span>
    </div>
  </div>
</footer>
