<footer class="r-footer">
  <div class="r-wrap">
    <div class="r-footer__grid">
      <div style="display:grid;gap:14px;align-content:start">
        <a href="/" class="r-lockup">
          <img src="/assets/img/logo-64.webp" width="44" height="44" alt="" loading="lazy" decoding="async" />
          <span class="r-lockup__txt"><b>Muntrume</b><small>Motorsport</small></span>
        </a>
        <span style="font-size:13px;color:#A3B0AC">Equipo de sim racing en iRacing · Barcelona (España)</span>
        <span class="r-footer__id">Titular: Alberto Trujillo · <a href="mailto:info@muntru.me">info@muntru.me</a></span>
      </div>
      <nav aria-label="Equipo">
        <h2>Equipo</h2>
        <ul><li><a href="/pilotos">Pilotos</a></li><li><a href="/news">Noticias</a></li><li><a href="/paddock">Paddock</a></li><li><a href="/contact">Contacto</a></li></ul>
      </nav>
      <nav aria-label="Pilotos">
        <h2>Área de pilotos</h2>
        <ul><li><a href="/garage">Garage · Setup Vault</a></li><li><a href="/mail">Webmail</a></li><li><a href="/email-preferences">Preferencias de email</a></li><li><a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer">Discord</a></li><li><a href="https://garage61.net/app/teams/muntrume" target="_blank" rel="noopener noreferrer">Garage 61</a></li></ul>
