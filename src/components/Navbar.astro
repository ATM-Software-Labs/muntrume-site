---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Helper para active state
const isInicio = currentPath === '/' || currentPath === '/index.html' || currentPath === '';
const isPilotos = currentPath.startsWith('/pilotos') || currentPath.startsWith('/team') || currentPath.startsWith('/p/');
const isNews = currentPath.startsWith('/news') || currentPath.startsWith('/noticias') || currentPath.startsWith('/article');
const isPaddock = currentPath.startsWith('/paddock') || currentPath.startsWith('/about') || currentPath.startsWith('/contact');
---

<!-- Header en 1 sola línea (h-14, bg #0E1211, border-b #1A2120, sticky top-0 z-50) -->
<header class="w-full h-14 bg-[#0E1211] border-b border-[#1A2120] sticky top-0 z-50 px-4 sm:px-8 flex items-center justify-between select-none">
  
  <!-- Izq: Logo tortuga 24px + MUNTRUME text bold -->
  <a href="/" class="flex items-center gap-2.5 group focus:outline-none shrink-0" title="Muntrume Motorsport - Sant Andreu, Barcelona">
    <img 
      src="/assets/img/logo-sm.webp" 
      alt="Muntrume" 
      class="h-6 w-6 object-contain transition-transform group-hover:scale-105" 
      width="24" 
      height="24" 
    />
    <span class="font-extrabold tracking-tight text-white text-base font-display">
      MUNTRUME
    </span>
  </a>

  <!-- Centro: Nav flex gap-6 lg:gap-8: INICIO + PILOTOS + NOTICIAS + PADDOCK (1 línea, centrado absoluto) -->
  <nav class="hidden md:flex gap-6 lg:gap-8 absolute left-1/2 -translate-x-1/2 text-xs font-mono uppercase tracking-wider">
    <a 
      href="/" 
      class={`py-1 transition-colors ${isInicio ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#9AA8A3] hover:text-white'}`}
    >
      INICIO
    </a>
    <a 
      href="/pilotos" 
      class={`py-1 transition-colors ${isPilotos ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#9AA8A3] hover:text-white'}`}
    >
      PILOTOS
    </a>
    <a 
      href="/news" 
      class={`py-1 transition-colors ${isNews ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#9AA8A3] hover:text-white'}`}
    >
      NOTICIAS
    </a>
    <a 
      href="/paddock" 
      class={`py-1 transition-colors ${isPaddock ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#9AA8A3] hover:text-white'}`}
    >
      PADDOCK
    </a>
  </nav>

  <!-- Der: Radio Discord punto verde pulse + LanguageSwitcher + GARAGE ACCESS bg #00E699 rounded-full -->
  <div class="flex items-center gap-3 sm:gap-4 shrink-0">
    
    <!-- Radio Discord (Desktop) -->
    <a 
      href="https://discord.gg/ehX6B8JUtE" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="hidden lg:inline-flex items-center gap-2 text-xs font-mono text-[#9AA8A3] hover:text-white px-2.5 py-1 rounded-lg border border-transparent hover:border-[#242E2C] transition"
      title="Radio Oficial del Equipo en Discord"
    >
      <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
      <span class="text-[11px]">Radio Discord</span>
    </a>

    <!-- Language Switcher con ES 🇪🇸, EN 🇬🇧 y CA con senyera real -->
    <div class="relative inline-block text-left" id="langSwitcherContainer">
      <button 
        type="button" 
        id="langSwitcherBtn" 
        class="flex items-center gap-1.5 bg-[#1A2120] hover:bg-[#242E2C] border border-[#242E2C] hover:border-[#00E699]/40 rounded-lg px-2.5 py-1.5 text-[12px] font-mono text-white transition-all cursor-pointer focus:outline-none"
        aria-label="Seleccionar idioma"
      >
        <span id="currentLangIcon" class="flex items-center">
          <img src="/flags/senyera.png" alt="Senyera" class="w-4 h-3 object-contain rounded-xs hidden" id="currentSenyeraImg" />
          <span id="currentFlagEmoji">🇪🇸</span>
        </span>
        <span id="currentLangLabel" class="font-semibold text-neutral-200">ES</span>
        <svg class="w-3 h-3 text-[#9AA8A3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <!-- Dropdown -->
      <div 
        id="langDropdown" 
        class="hidden absolute right-0 mt-1 w-28 rounded-lg bg-[#1A2120] border border-[#242E2C] shadow-2xl py-1 z-50"
      >
        <button type="button" onclick="setLanguage('ES')" class="w-full flex items-center gap-2 px-3 py-1.5 text-xs font-mono text-neutral-300 hover:bg-white/5 hover:text-white cursor-pointer">
          <span class="text-sm leading-none">🇪🇸</span>
          <span>ES</span>
        </button>
        <button type="button" onclick="setLanguage('EN')" class="w-full flex items-center gap-2 px-3 py-1.5 text-xs font-mono text-neutral-300 hover:bg-white/5 hover:text-white cursor-pointer">
          <span class="text-sm leading-none">🇬🇧</span>
          <span>EN</span>
        </button>
        <button type="button" onclick="setLanguage('CA')" class="w-full flex items-center gap-2 px-3 py-1.5 text-xs font-mono text-neutral-300 hover:bg-white/5 hover:text-white cursor-pointer">
          <img src="/flags/senyera.png" alt="Senyera" class="w-4 h-3 object-contain rounded-xs" />
          <span>CA</span>
        </button>
      </div>
    </div>

    <!-- GARAGE ACCESS rounded-full -->
    <a 
      href="/garage" 
      class="inline-flex items-center gap-1.5 bg-[#00E699] hover:bg-[#00c985] text-neutral-950 font-black text-xs font-mono uppercase tracking-wider px-3.5 sm:px-4 py-1.5 rounded-full transition-all shadow-md hover:shadow-[#00E699]/20 shrink-0"
    >
      <span>GARAGE ACCESS</span>
    </a>

    <!-- Mobile Drawer Trigger Button -->
    <button 
      type="button" 
      id="navDrawerOpenBtn" 
      class="md:hidden p-1.5 text-[#9AA8A3] hover:text-white bg-[#1A2120] border border-[#242E2C] rounded-lg transition focus:outline-none shrink-0" 
      aria-label="Abrir Menú de Navegación"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>

  </div>
</header>

<!-- Mobile Drawer Navigation -->
<div id="mobileDrawer">
  <div class="space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-[#242E2C]">
      <div class="flex items-center gap-2">
        <img src="/assets/img/logo-sm.webp" alt="Muntrume" class="h-6 w-auto" width="24" height="24" />
        <span class="font-extrabold text-white text-sm font-display tracking-tight">MUNTRUME</span>
      </div>
      <button type="button" id="navDrawerCloseBtn" class="p-1 text-[#9AA8A3] hover:text-white rounded-lg focus:outline-none">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col space-y-3 font-mono text-sm uppercase">
      <a href="/" class={`px-3 py-2 rounded-xl transition ${isInicio ? 'bg-[#00E699]/10 text-[#00E699] font-bold' : 'text-[#9AA8A3] hover:bg-white/5 hover:text-white'}`}>
        Inicio
      </a>
      <a href="/pilotos" class={`px-3 py-2 rounded-xl transition ${isPilotos ? 'bg-[#00E699]/10 text-[#00E699] font-bold' : 'text-[#9AA8A3] hover:bg-white/5 hover:text-white'}`}>
        Pilotos
      </a>
      <a href="/news" class={`px-3 py-2 rounded-xl transition ${isNews ? 'bg-[#00E699]/10 text-[#00E699] font-bold' : 'text-[#9AA8A3] hover:bg-white/5 hover:text-white'}`}>
        Noticias
      </a>
      <a href="/paddock" class={`px-3 py-2 rounded-xl transition ${isPaddock ? 'bg-[#00E699]/10 text-[#00E699] font-bold' : 'text-[#9AA8A3] hover:bg-white/5 hover:text-white'}`}>
        Paddock
      </a>
      <a href="/garage" class="px-3 py-2 rounded-xl bg-[#00E699] text-neutral-950 font-bold transition">
        Garage Access
      </a>
    </nav>
  </div>

  <div class="pt-6 border-t border-[#242E2C] space-y-3">
    <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-xs font-mono text-[#9AA8A3] hover:text-white">
      <span>Radio Discord</span>
      <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
    </a>
  </div>
</div>

<div id="mobileBackdrop"></div>

<script is:inline>
  // Language Switcher Logic
  function setLanguage(code) {
    var label = document.getElementById('currentLangLabel');
    var emoji = document.getElementById('currentFlagEmoji');
    var senyera = document.getElementById('currentSenyeraImg');
    var dropdown = document.getElementById('langDropdown');

    if (code === 'CA') {
      if (emoji) emoji.classList.add('hidden');
      if (senyera) senyera.classList.remove('hidden');
      if (label) label.textContent = 'CA';
    } else if (code === 'EN') {
      if (senyera) senyera.classList.add('hidden');
      if (emoji) { emoji.classList.remove('hidden'); emoji.textContent = '🇬🇧'; }
      if (label) label.textContent = 'EN';
    } else {
      if (senyera) senyera.classList.add('hidden');
      if (emoji) { emoji.classList.remove('hidden'); emoji.textContent = '🇪🇸'; }
      if (label) label.textContent = 'ES';
    }

    try {
      localStorage.setItem('muntrume_lang', code);
      document.documentElement.lang = code.toLowerCase();
    } catch (e) {}

    if (dropdown) dropdown.classList.add('hidden');
  }

  // Init Language Switcher on Load
  (function initLang() {
    var btn = document.getElementById('langSwitcherBtn');
    var dropdown = document.getElementById('langDropdown');
    if (btn && dropdown) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });
      document.addEventListener('click', function() {
        dropdown.classList.add('hidden');
      });
    }

    try {
      var saved = localStorage.getItem('muntrume_lang');
      if (saved && (saved === 'EN' || saved === 'CA' || saved === 'ES')) {
        setLanguage(saved);
      }
    } catch (e) {}
  })();

  // Mobile Drawer Logic
  (function initDrawer() {
    var openBtn = document.getElementById('navDrawerOpenBtn');
    var closeBtn = document.getElementById('navDrawerCloseBtn');
    var drawer = document.getElementById('mobileDrawer');
    var backdrop = document.getElementById('mobileBackdrop');

    function open() {
      if (drawer) drawer.classList.add('open');
      if (backdrop) {
        backdrop.style.opacity = '1';
        backdrop.style.pointerEvents = 'auto';
      }
    }

    function close() {
      if (drawer) drawer.classList.remove('open');
      if (backdrop) {
        backdrop.style.opacity = '0';
        backdrop.style.pointerEvents = 'none';
      }
    }

    if (openBtn) openBtn.addEventListener('click', open);
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (backdrop) backdrop.addEventListener('click', close);
  })();
</script>
