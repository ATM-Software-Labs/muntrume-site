---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isHome = currentPath === '/' || currentPath === '/index.html' || currentPath === '';
const isDrivers =
  currentPath.startsWith('/drivers') ||
  currentPath.startsWith('/pilotos') ||
  currentPath.startsWith('/d/') ||
  currentPath.startsWith('/team') ||
  currentPath.startsWith('/p/');
const isNews = currentPath.startsWith('/news') || currentPath.startsWith('/noticias') || currentPath.startsWith('/article');
const isPaddock = currentPath.startsWith('/paddock') || currentPath.startsWith('/about') || currentPath.startsWith('/contact');
---

<header class="w-full h-16 bg-[var(--r-surface)] border-b border-[var(--r-line)] sticky top-0 z-50 select-none max-w-full flex items-center transition-colors">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    <!-- Left: Official Logo + Clean Full MUNTRUME MOTORSPORT Lockup -->
    <a
      href="/"
      data-no-i18n
      class="flex items-center gap-2.5 group focus:outline-none shrink-0"
      title="Muntrume Motorsport — Official iRacing Team"
    >
      <img
        src="/assets/img/logo-64.webp"
        alt="Muntrume Motorsport"
        class="h-8 w-8 object-contain transition-transform group-hover:scale-105 shrink-0"
        width="32"
        height="32"
      />
      <span class="font-extrabold tracking-[.06em] text-[var(--r-text)] text-sm sm:text-base font-display uppercase whitespace-nowrap leading-none">
        MUNTRUME<span class="hidden min-[380px]:inline"> <span class="text-[var(--r-accent)]">MOTORSPORT</span></span>
      </span>
    </a>

    <!-- Center: Navigation Links (Home, Drivers, News, Paddock) — Flex aligned without overlap -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-8 text-xs font-mono uppercase tracking-wider shrink-0" aria-label="Main Navigation">
      <a
        href="/"
        class={`py-1 transition-colors whitespace-nowrap ${isHome ? 'text-[var(--r-accent)] font-bold border-b-2 border-[var(--r-accent)]' : 'text-[var(--r-muted)] hover:text-[var(--r-text)]'}`}
      >
        Home
      </a>
      <a
        href="/drivers"
        class={`py-1 transition-colors whitespace-nowrap ${isDrivers ? 'text-[var(--r-accent)] font-bold border-b-2 border-[var(--r-accent)]' : 'text-[var(--r-muted)] hover:text-[var(--r-text)]'}`}
      >
        Drivers
      </a>
      <a
        href="/news"
        class={`py-1 transition-colors whitespace-nowrap ${isNews ? 'text-[var(--r-accent)] font-bold border-b-2 border-[var(--r-accent)]' : 'text-[var(--r-muted)] hover:text-[var(--r-text)]'}`}
      >
        News
      </a>
      <a
        href="/paddock"
        class={`py-1 transition-colors whitespace-nowrap ${isPaddock ? 'text-[var(--r-accent)] font-bold border-b-2 border-[var(--r-accent)]' : 'text-[var(--r-muted)] hover:text-[var(--r-text)]'}`}
      >
        Paddock
      </a>
    </nav>

    <!-- Right: Discord Radio + Theme Toggle + Language Switcher + User Area -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Discord Radio Indicator (Desktop) -->
      <a
        href="https://discord.gg/ehX6B8JUtE"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden xl:inline-flex items-center gap-2 min-h-[40px] text-xs font-mono text-[var(--r-muted)] hover:text-[var(--r-text)] px-3 py-2 rounded-xl border border-[var(--r-line)] hover:border-[var(--r-accent)] bg-[var(--r-bg-2)] transition whitespace-nowrap shrink-0"
        title="Official Team Radio on Discord"
      >
        <span class="w-2 h-2 rounded-full bg-[var(--r-accent)] animate-pulse shrink-0"></span>
        <span class="text-[11px] font-semibold">Discord Radio</span>
      </a>

      <!-- Theme Switcher (Dark / Light) - Min 40x40px touch target -->
      <button
        type="button"
        id="themeToggleBtn"
        class="flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--r-bg-2)] hover:bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-[var(--r-accent)] text-[var(--r-muted)] hover:text-[var(--r-text)] transition-all cursor-pointer focus:outline-none shrink-0"
        title="Toggle theme (Dark / Light)"
        aria-label="Toggle theme"
      >
        <svg id="themeSunIcon" width="18" height="18" class="w-4.5 h-4.5 hidden text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg id="themeMoonIcon" width="18" height="18" class="w-4.5 h-4.5 text-[var(--r-accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>

      <!-- Language Switcher - Min 40px touch target -->
      <div class="relative inline-block text-left shrink-0" id="langSwitcherContainer">
        <button
          type="button"
          id="langSwitcherBtn"
          class="flex items-center gap-1.5 min-h-[40px] bg-[var(--r-bg-2)] hover:bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-[var(--r-accent)] rounded-xl px-3 py-2 text-xs font-mono text-[var(--r-text)] transition-all cursor-pointer focus:outline-none"
          title="Language / Idioma"
          aria-haspopup="true"
        >
          <span class="sr-only">Language</span>
          <span id="currentLangIcon" class="flex items-center">
            <img src="/flags/senyera.png" alt="Senyera" width="16" height="12" class="w-4 h-3 object-contain rounded-xs hidden" id="currentSenyeraImg" />
            <span id="currentFlagEmoji">🇬🇧</span>
          </span>
          <span id="currentLangLabel" class="font-bold">EN</span>
          <svg width="12" height="12" class="w-3 h-3 text-[var(--r-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="langDropdown"
          class="hidden absolute right-0 mt-1 w-28 rounded-xl bg-[var(--r-surface)] border border-[var(--r-line)] shadow-2xl py-1 z-50"
        >
          <button type="button" data-set-lang="EN" class="w-full flex items-center gap-2 px-3 py-2 text-xs font-mono text-[var(--r-text)] hover:bg-[var(--r-bg-2)] cursor-pointer">
            <span class="text-sm leading-none">🇬🇧</span>
            <span>EN</span>
          </button>
          <button type="button" data-set-lang="ES" class="w-full flex items-center gap-2 px-3 py-2 text-xs font-mono text-[var(--r-text)] hover:bg-[var(--r-bg-2)] cursor-pointer">
            <span class="text-sm leading-none">🇪🇸</span>
            <span>ES</span>
          </button>
          <button type="button" data-set-lang="CA" class="w-full flex items-center gap-2 px-3 py-2 text-xs font-mono text-[var(--r-text)] hover:bg-[var(--r-bg-2)] cursor-pointer">
            <img src="/flags/senyera.png" alt="Senyera" width="16" height="12" class="w-4 h-3 object-contain rounded-xs" />
            <span>CA</span>
          </button>
          <button type="button" data-set-lang="FR" class="w-full flex items-center gap-2 px-3 py-2 text-xs font-mono text-[var(--r-text)] hover:bg-[var(--r-bg-2)] cursor-pointer">
            <span class="text-sm leading-none">🇫🇷</span>
            <span>FR</span>
          </button>
        </div>
      </div>

      <!-- Active Session / Admin Race Control Bar (Desktop) -->
      <div id="navSessionBox" class="hidden items-center gap-2 shrink-0">
        <a
          href="/drivers/albertot/"
          id="navAdminBadge"
          class="hidden lg:inline-flex items-center gap-2 min-h-[40px] px-3 py-2 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] text-xs font-mono text-[var(--r-text)] hover:border-[var(--r-accent)] transition whitespace-nowrap"
          title="Team Principal & Administrator — atrumin16@gmail.com"
        >
          <span class="w-2 h-2 rounded-full bg-[var(--r-accent)] shrink-0"></span>
          <span id="navSessionHandle" class="font-bold text-[var(--r-accent)]">atrumin16</span>
          <span class="text-[var(--r-muted)]">·</span>
          <span id="navSessionLabel" class="font-medium text-[var(--r-text)]">Alberto Trujillo</span>
        </a>
        <a
          href="/admin"
          id="navRaceControlBtn"
          class="hidden items-center gap-1.5 min-h-[40px] bg-[var(--r-accent)] hover:opacity-90 text-[var(--r-accent-ink)] font-black text-xs font-mono uppercase tracking-wider px-3.5 py-2 rounded-xl transition-all shadow-md whitespace-nowrap shrink-0"
          title="Open Race Control Admin Console"
        >
          <span>RACE CONTROL</span>
        </a>
        <button
          type="button"
          id="navLogoutBtn"
          class="inline-flex items-center min-h-[40px] px-3 py-2 rounded-xl bg-[var(--r-bg-2)] hover:bg-[var(--r-surface)] border border-[var(--r-line)] hover:border-rose-500/50 text-xs font-mono text-[var(--r-muted)] hover:text-rose-500 transition cursor-pointer whitespace-nowrap"
        >
          Log out
        </button>
      </div>

      <!-- GARAGE ACCESS Button - Only shown when user is NOT authenticated -->
      <a
        href="/garage"
        id="navGarageAccessBtn"
        class="hidden lg:inline-flex items-center gap-1.5 min-h-[40px] bg-[var(--r-accent)] hover:opacity-90 text-[var(--r-accent-ink)] font-black text-xs font-mono uppercase tracking-wider px-4 py-2 rounded-xl transition-all shadow-md whitespace-nowrap shrink-0"
      >
        <span>GARAGE ACCESS</span>
      </a>

      <!-- Mobile Drawer Trigger - Min 40x40px touch target -->
      <button
        type="button"
        id="navDrawerOpenBtn"
        class="md:hidden flex items-center justify-center w-10 h-10 text-[var(--r-muted)] hover:text-[var(--r-text)] bg-[var(--r-bg-2)] border border-[var(--r-line)] rounded-xl transition focus:outline-none shrink-0"
        aria-label="Open Navigation Menu"
      >
        <svg width="20" height="20" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Navigation -->
<div id="mobileDrawer">
  <div class="space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-[var(--r-line)]">
      <div class="flex items-center gap-2" data-no-i18n>
        <img src="/assets/img/logo-48.webp" alt="" class="h-6 w-auto" width="24" height="24" />
        <span class="font-extrabold text-[var(--r-text)] text-sm font-display tracking-tight uppercase">MUNTRUME <span class="text-[var(--r-accent)]">MOTORSPORT</span></span>
      </div>
      <button type="button" id="navDrawerCloseBtn" aria-label="Close menu" class="p-1 text-[var(--r-muted)] hover:text-[var(--r-text)] rounded-lg focus:outline-none">
        <svg width="24" height="24" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col space-y-2.5 font-mono text-sm uppercase">
      <a href="/" class={`px-3 py-2 rounded-xl transition ${isHome ? 'bg-[var(--r-accent)]/10 text-[var(--r-accent)] font-bold' : 'text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)]'}`}>
        Home
      </a>
      <a href="/drivers" class={`px-3 py-2 rounded-xl transition ${isDrivers ? 'bg-[var(--r-accent)]/10 text-[var(--r-accent)] font-bold' : 'text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)]'}`}>
        Drivers
      </a>
      <a href="/news" class={`px-3 py-2 rounded-xl transition ${isNews ? 'bg-[var(--r-accent)]/10 text-[var(--r-accent)] font-bold' : 'text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)]'}`}>
        News
      </a>
      <a href="/paddock" class={`px-3 py-2 rounded-xl transition ${isPaddock ? 'bg-[var(--r-accent)]/10 text-[var(--r-accent)] font-bold' : 'text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)]'}`}>
        Paddock
      </a>
      <a href="/ai" class="px-3 py-2 rounded-xl text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)] transition">
        AI Copilot
      </a>
      <a href="/setup-builder" class="px-3 py-2 rounded-xl text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)] transition">
        Setup Builder
      </a>
      <a href="/communications" class="px-3 py-2 rounded-xl text-[var(--r-muted)] hover:bg-[var(--r-bg-2)] hover:text-[var(--r-text)] transition">
        Communications &amp; Webmail
      </a>
      <a href="/garage" class="px-3 py-2.5 rounded-xl bg-[var(--r-accent)] text-[var(--r-accent-ink)] font-bold text-center transition">
        Garage Access
      </a>
      <div id="mobileAdminBox" class="hidden pt-2 mt-2 border-t border-[var(--r-line)] space-y-2">
        <div class="px-3 py-2 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] text-xs font-mono">
          <div class="font-bold text-[var(--r-accent)]" id="mobileSessionHandle">atrumin16 · #16</div>
          <div class="text-[11px] text-[var(--r-muted)]" id="mobileSessionLabel">Alberto Trujillo (Team Principal)</div>
        </div>
        <a id="mobileRaceControlBtn" href="/admin" class="hidden block px-3 py-2.5 rounded-xl bg-[var(--r-accent)] text-[var(--r-accent-ink)] font-black text-center tracking-wider transition shadow-[0_0_16px_rgba(0,230,153,0.28)]">
          RACE CONTROL
        </a>
        <button type="button" id="mobileLogoutBtn" class="w-full px-3 py-2 rounded-xl bg-[var(--r-bg-2)] border border-[var(--r-line)] text-xs font-mono text-[var(--r-muted)] hover:text-[var(--r-text)] text-center cursor-pointer">
          Log out
        </button>
      </div>
    </nav>
  </div>

  <div class="pt-6 border-t border-[var(--r-line)] space-y-3">
    <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-xs font-mono text-[var(--r-muted)] hover:text-[var(--r-text)]">
      <span>Discord Radio</span>
      <span class="w-2 h-2 rounded-full bg-[var(--r-accent)] animate-pulse"></span>
    </a>
    <div class="flex items-center justify-between pt-2">
      <span class="text-xs font-mono text-[var(--r-muted)]">Theme</span>
      <button
        type="button"
        id="themeToggleBtnMobile"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[var(--r-bg-2)] border border-[var(--r-line)] text-xs font-mono text-[var(--r-text)] cursor-pointer"
      >
        <span id="themeMobileLabel">Switch to Light ☀️</span>
      </button>
    </div>
  </div>
</div>

<div id="mobileBackdrop"></div>

<script is:inline>
  function applyThemeUI(theme) {
    var isLight = theme === 'light';
    var sun = document.getElementById('themeSunIcon');
    var moon = document.getElementById('themeMoonIcon');
    var mobileLabel = document.getElementById('themeMobileLabel');
    var btn = document.getElementById('themeToggleBtn');
    // Display the target theme action: in dark mode show Sun (to switch to light), in light mode show Moon (to switch to dark)
    if (sun) sun.classList.toggle('hidden', isLight);
    if (moon) moon.classList.toggle('hidden', !isLight);
    if (btn) btn.setAttribute('title', isLight ? 'Switch to Dark Mode' : 'Switch to Light Mode');
    if (mobileLabel) mobileLabel.textContent = isLight ? 'Switch to Dark 🌙' : 'Switch to Light ☀️';
  }

  function toggleTheme() {
    var isCurrentlyLight = document.documentElement.classList.contains('light');
    var nextTheme = isCurrentlyLight ? 'dark' : 'light';
    if (nextTheme === 'light') {
      document.documentElement.classList.add('light');
      document.documentElement.classList.remove('dark');
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      document.documentElement.classList.remove('light');
      document.documentElement.setAttribute('data-theme', 'dark');
    }
    try { localStorage.setItem('muntrume_theme', nextTheme); } catch (e) {}
    applyThemeUI(nextTheme);
  }

  var themeBtn = document.getElementById('themeToggleBtn');
  var themeBtnMobile = document.getElementById('themeToggleBtnMobile');
  if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
  if (themeBtnMobile) themeBtnMobile.addEventListener('click', toggleTheme);
  applyThemeUI(document.documentElement.classList.contains('light') ? 'light' : 'dark');

  document.addEventListener('click', function (e) {
    var b = e.target.closest && e.target.closest('[data-set-lang]');
    if (b) setLanguage(b.getAttribute('data-set-lang'));
  });

  function setLanguage(code, triggerI18n) {
    var label = document.getElementById('currentLangLabel');
    var emoji = document.getElementById('currentFlagEmoji');
    var senyera = document.getElementById('currentSenyeraImg');
    var dropdown = document.getElementById('langDropdown');

    if (code === 'CA') {
      if (emoji) emoji.classList.add('hidden');
      if (senyera) senyera.classList.remove('hidden');
      if (label) label.textContent = 'CA';
    } else if (code === 'ES' || code === 'FR') {
      if (senyera) senyera.classList.add('hidden');
      if (emoji) { emoji.classList.remove('hidden'); emoji.textContent = code === 'FR' ? '🇫🇷' : '🇪🇸'; }
      if (label) label.textContent = code;
    } else {
      code = 'EN';
      if (senyera) senyera.classList.add('hidden');
      if (emoji) { emoji.classList.remove('hidden'); emoji.textContent = '🇬🇧'; }
      if (label) label.textContent = 'EN';
    }

    try {
      localStorage.setItem('muntrume_lang', code);
      localStorage.setItem('mm_lang', code.toLowerCase());
      document.documentElement.lang = code.toLowerCase();
    } catch (e) {}

    if (dropdown) dropdown.classList.add('hidden');

    if (triggerI18n !== false && window.muntruI18n && typeof window.muntruI18n.set === 'function') {
      window.muntruI18n.set(code.toLowerCase());
    }
  }

  (function initLang() {
    var btn = document.getElementById('langSwitcherBtn');
    var dropdown = document.getElementById('langDropdown');
    if (btn && dropdown) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdown.classList.toggle('hidden');
      });
      document.addEventListener('click', function() {
        dropdown.classList.add('hidden');
      });
    }

    try {
      var q = (new URLSearchParams(location.search).get('lang') || '').toUpperCase();
      if (q === 'EN' || q === 'CA' || q === 'ES' || q === 'FR') { setLanguage(q, false); return; }
    } catch (e) {}
    try {
      var saved = localStorage.getItem('muntrume_lang') || localStorage.getItem('mm_lang');
      if (saved) {
        var s = saved.toUpperCase();
        if (s === 'EN' || s === 'CA' || s === 'ES' || s === 'FR') {
          setLanguage(s, false);
          return;
        }
      }
    } catch (e) {}

    // Global default: English (EN)
    setLanguage('EN', false);
  })();

  (function initDrawer() {
    var openBtn = document.getElementById('navDrawerOpenBtn');
    var closeBtn = document.getElementById('navDrawerCloseBtn');
    var drawer = document.getElementById('mobileDrawer');
    var backdrop = document.getElementById('mobileBackdrop');

    function open() {
      if (drawer) drawer.classList.add('open');
      if (backdrop) {
        backdrop.style.opacity = '1';
        backdrop.style.pointerEvents = 'auto';
      }
    }

    function close() {
      if (drawer) drawer.classList.remove('open');
      if (backdrop) {
        backdrop.style.opacity = '0';
        backdrop.style.pointerEvents = 'none';
      }
    }

    if (openBtn) openBtn.addEventListener('click', open);
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (backdrop) backdrop.addEventListener('click', close);
  })();

  (function initGlobalAuthHeader() {
    var ADMIN_EMAIL = 'atrumin16@gmail.com';

    function getActiveUser() {
      try {
        var rawUser = localStorage.getItem('mrt_vault_user') || sessionStorage.getItem('mrt_vault_user');
        var savedEmail = (localStorage.getItem('muntrume_user_email') || '').trim().toLowerCase();
        var authState = localStorage.getItem('muntrume_auth_state') || '';
        if (rawUser) {
          var parsed = JSON.parse(rawUser);
          if (parsed && parsed.role !== 'guest' && parsed.email) {
            return parsed;
          }
        }
        if (authState === 'authenticated' && savedEmail) {
          return {
            email: savedEmail,
            role: savedEmail === ADMIN_EMAIL ? 'admin' : 'driver',
            name: savedEmail === ADMIN_EMAIL ? 'Alberto Trujillo' : savedEmail.split('@')[0]
          };
        }
      } catch (e) {}
      return null;
    }

    function syncNavbarSession() {
      var user = getActiveUser();
      var email = user && user.email ? String(user.email).trim().toLowerCase() : '';
      var isAuth = Boolean(email);
      var isAdmin = isAuth && (email === ADMIN_EMAIL || user.role === 'admin');

      var sessionBox = document.getElementById('navSessionBox');
      var adminBadge = document.getElementById('navAdminBadge');
      var sessionHandle = document.getElementById('navSessionHandle');
      var sessionLabel = document.getElementById('navSessionLabel');
      var raceControlBtn = document.getElementById('navRaceControlBtn');
      var garageAccessBtn = document.getElementById('navGarageAccessBtn');
      var mobileAdminBox = document.getElementById('mobileAdminBox');
      var mobileHandle = document.getElementById('mobileSessionHandle');
      var mobileLabel = document.getElementById('mobileSessionLabel');
      var mobileRaceControlBtn = document.getElementById('mobileRaceControlBtn');

      var onGaragePage = window.location.pathname.startsWith('/garage') || window.location.pathname.startsWith('/setups');

      if (isAuth) {
        if (sessionBox) {
          sessionBox.classList.remove('hidden');
          sessionBox.classList.add('flex');
        }
        if (mobileAdminBox) mobileAdminBox.classList.remove('hidden');
        if (garageAccessBtn) garageAccessBtn.style.display = 'none';

        if (isAdmin) {
          if (sessionHandle) sessionHandle.textContent = 'atrumin16';
          if (sessionLabel) sessionLabel.textContent = 'Alberto Trujillo (#16)';
          if (adminBadge) adminBadge.href = '/drivers/albertot/';
          if (raceControlBtn) {
            raceControlBtn.classList.remove('hidden');
            raceControlBtn.classList.add('inline-flex');
          }
          if (mobileHandle) mobileHandle.textContent = 'atrumin16 · #16';
          if (mobileLabel) mobileLabel.textContent = 'Alberto Trujillo (Team Principal & Admin)';
          if (mobileRaceControlBtn) mobileRaceControlBtn.classList.remove('hidden');
        } else {
          var handle = email.split('@')[0];
          if (sessionHandle) sessionHandle.textContent = handle;
          if (sessionLabel) sessionLabel.textContent = user.name || 'Official Driver';
          if (raceControlBtn) {
            raceControlBtn.classList.add('hidden');
            raceControlBtn.classList.remove('inline-flex');
          }
          if (mobileHandle) mobileHandle.textContent = handle;
          if (mobileLabel) mobileLabel.textContent = user.name || 'Official Driver';
          if (mobileRaceControlBtn) mobileRaceControlBtn.classList.add('hidden');
        }
      } else {
        if (sessionBox) {
          sessionBox.classList.add('hidden');
          sessionBox.classList.remove('flex');
        }
        if (raceControlBtn) {
          raceControlBtn.classList.add('hidden');
          raceControlBtn.classList.remove('inline-flex');
        }
        if (garageAccessBtn) {
          garageAccessBtn.style.display = onGaragePage ? 'none' : '';
        }
        if (mobileAdminBox) mobileAdminBox.classList.add('hidden');
      }
    }

    function globalLogout() {
      if (typeof window.handleLogout === 'function') {
        window.handleLogout();
        syncNavbarSession();
        return;
      }
      try {
        localStorage.removeItem('mrt_vault_token');
        localStorage.removeItem('mrt_vault_user');
        localStorage.removeItem('muntrume_user_email');
        localStorage.removeItem('muntrume_auth_state');
        localStorage.removeItem('muntrume_is_admin');
        sessionStorage.removeItem('mrt_vault_token');
        sessionStorage.removeItem('mrt_vault_user');
      } catch (e) {}
      syncNavbarSession();
      window.dispatchEvent(new Event('muntrume-auth-change'));
    }

    var navLogout = document.getElementById('navLogoutBtn');
    var mobileLogout = document.getElementById('mobileLogoutBtn');
    if (navLogout) navLogout.addEventListener('click', globalLogout);
    if (mobileLogout) mobileLogout.addEventListener('click', globalLogout);

    window.addEventListener('muntrume-auth-change', syncNavbarSession);
    window.addEventListener('storage', syncNavbarSession);
    syncNavbarSession();
  })();
</script>
