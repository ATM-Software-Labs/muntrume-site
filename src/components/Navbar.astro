---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Active state helper
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/' || currentPath === '/index.html' || currentPath === '';
  return currentPath.startsWith(path);
};
---

<!-- Fixed Master Minimalist Navbar -->
<header class="fixed top-0 left-0 right-0 z-50 h-16 bg-[#080C0A]/90 backdrop-blur-md border-b border-[#1E2A26] transition-all duration-300">
  <div class="max-w-7xl mx-auto h-full px-3 sm:px-6 lg:px-8 flex items-center justify-between gap-2 sm:gap-4">
    
    <!-- Left: Brand Identity -->
    <a href="/" class="flex items-center gap-2 sm:gap-3 group focus:outline-none flex-shrink-0" title="Muntrume Motorsport - Sant Andreu, Barcelona">
      <img src="/assets/img/logo-sm.webp" alt="Muntrume" class="h-6 sm:h-7 w-auto object-contain transition-transform group-hover:scale-105" width="28" height="28" />
      <span class="font-extrabold tracking-tight text-white text-sm sm:text-base font-display">MUNTRUME</span>
    </a>

    <!-- Center: 3 Clean Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8 text-xs font-semibold uppercase tracking-wider">
      <a 
        href="/" 
        class={`transition-colors py-1 ${isActive('/') && !isActive('/pilotos') && !isActive('/team') && !isActive('/paddock') && !isActive('/garage') ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#8B9A8F] hover:text-white'}`}
      >
        Inicio
      </a>
      <a 
        href="/pilotos" 
        class={`transition-colors py-1 ${isActive('/pilotos') || isActive('/team') ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#8B9A8F] hover:text-white'}`}
      >
        Pilotos
      </a>
      <a 
        href="/paddock" 
        class={`transition-colors py-1 ${isActive('/paddock') || isActive('/about') || isActive('/contact') || isActive('/news') ? 'text-[#00E699] font-bold border-b-2 border-[#00E699]' : 'text-[#8B9A8F] hover:text-white'}`}
      >
        Paddock
      </a>
    </nav>

    <!-- Right: Radio Discord & Garage Access Button + Mobile Drawer Toggle -->
    <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
      
      <!-- Radio Discord (Desktop only) -->
      <a 
        href="https://discord.gg/ehX6B8JUtE" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="hidden lg:inline-flex items-center gap-2 text-xs font-semibold text-[#8B9A8F] hover:text-white px-3 py-1.5 rounded-xl border border-transparent hover:border-[#1E2A26] transition"
        title="Canal de Radio Oficial en Discord"
      >
        <span class="w-2 h-2 rounded-full bg-[#00E699] animate-pulse"></span>
        <span class="font-mono text-[11px]">Radio Discord</span>
      </a>

      <!-- Primary Action: GARAGE ACCESS -->
      <a 
        href="/garage" 
        class="inline-flex items-center gap-1.5 bg-[#00E699] hover:bg-[#00c985] text-neutral-950 font-black text-xs uppercase tracking-wider px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl transition-all shadow-sm shrink-0"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span class="inline">Garage Access</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        type="button" 
        id="navDrawerOpenBtn" 
        onclick="toggleNavDrawer()" 
        class="md:hidden p-1.5 text-[#8B9A8F] hover:text-white focus:outline-none shrink-0" 
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer & Backdrop -->
<div id="mobileBackdrop" onclick="toggleNavDrawer(false)" aria-hidden="true"></div>
<aside id="mobileDrawer" aria-label="Mobile Navigation" class="bg-[#080C0A] border-l border-[#1E2A26]">
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-[#1E2A26] mb-6">
      <a href="/" onclick="toggleNavDrawer(false)" class="flex items-center gap-2.5">
        <img src="/assets/img/logo-sm.webp" alt="Muntrume" class="h-6 w-auto" width="23" height="24" loading="lazy" decoding="async" />
        <span class="font-extrabold text-white text-base tracking-tight font-display">MUNTRUME</span>
      </a>
      <button id="navDrawerCloseBtn" onclick="toggleNavDrawer(false)" class="p-1.5 text-[#8B9A8F] hover:text-white focus:outline-none" aria-label="Cerrar menú">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <nav class="space-y-2 text-sm font-semibold">
      <a 
        href="/" 
        onclick="toggleNavDrawer(false)" 
        class={`block px-3 py-2.5 rounded-xl transition ${isActive('/') && !isActive('/pilotos') && !isActive('/paddock') && !isActive('/garage') ? 'text-[#00E699] bg-[#121A17] border border-[#1E2A26]' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}
      >
        Inicio
      </a>
      <a 
        href="/pilotos" 
        onclick="toggleNavDrawer(false)" 
        class={`block px-3 py-2.5 rounded-xl transition ${isActive('/pilotos') || isActive('/team') ? 'text-[#00E699] bg-[#121A17] border border-[#1E2A26]' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}
      >
        Pilotos
      </a>
      <a 
        href="/paddock" 
        onclick="toggleNavDrawer(false)" 
        class={`block px-3 py-2.5 rounded-xl transition ${isActive('/paddock') || isActive('/about') || isActive('/contact') ? 'text-[#00E699] bg-[#121A17] border border-[#1E2A26]' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}
      >
        Paddock &amp; Canales
      </a>
      <a 
        href="/garage" 
        onclick="toggleNavDrawer(false)" 
        class="block px-3 py-2.5 rounded-xl text-neutral-950 bg-[#00E699] font-extrabold transition text-center mt-4"
      >
        ⚡ GARAGE ACCESS (Setups &amp; Comms)
      </a>
    </nav>
  </div>

  <div class="pt-6 border-t border-[#1E2A26] space-y-3 text-xs">
    <a 
      href="https://discord.gg/ehX6B8JUtE" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="block text-center py-2.5 rounded-xl bg-[#121A17] border border-[#1E2A26] text-white font-semibold transition hover:border-[#00E699]"
    >
      Canal de Radio en Discord
    </a>
    <p class="text-[11px] text-[#8B9A8F] text-center font-mono">Muntrume Motorsport &copy; 2026 &middot; Sant Andreu, BCN</p>
  </div>
</aside>

<script is:inline>
  function toggleNavDrawer(shouldBeOpen) {
    var drawer = document.getElementById('mobileDrawer');
    var backdrop = document.getElementById('mobileBackdrop');
    if (!drawer || !backdrop) return;
    var isOpen = drawer.classList.contains('open');
    var nextState = typeof shouldBeOpen === 'boolean' ? shouldBeOpen : !isOpen;
    if (nextState) {
      drawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    } else {
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.style.overflow = '';
    }
  }
  window.toggleNavDrawer = toggleNavDrawer;
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') toggleNavDrawer(false);
  });
</script>
