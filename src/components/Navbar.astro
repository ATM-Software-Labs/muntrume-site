---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { href: "/", label: "Overview", match: (p: string) => p === "/" || p === "/index.html" },
  { href: "/pilotos", label: "Pilots", match: (p: string) => p.startsWith("/piloto") || p.startsWith("/p/") },
  { href: "/team", label: "Roster", match: (p: string) => p.startsWith("/team") },
  { href: "/news", label: "Press Room", match: (p: string) => p.startsWith("/news") },
  { href: "/about", label: "Organization", match: (p: string) => p.startsWith("/about") },
  { href: "/contact", label: "Contact", match: (p: string) => p.startsWith("/contact") },
  { href: "/setups", label: "Vault", match: (p: string) => p.startsWith("/setup"), isVault: true },
];
---

<header class="fixed top-0 left-0 right-0 z-50 h-16 bg-[#0e1217]/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <img src="/assets/img/logo-sm.webp" alt="Muntrume Logo" class="h-8 w-auto object-contain transition-transform group-hover:scale-105" width="31" height="32" />
      <div class="flex items-center gap-2">
        <span class="font-extrabold tracking-tight text-white text-base">MUNTRUME</span>
        <span class="text-[11px] font-semibold tracking-wider text-emerald-400 uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">MOTORSPORT</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navLinks.map((link) => {
        const isActive = link.match(currentPath);
        if (link.isVault) {
          return (
            <a href={link.href} class={`flex items-center gap-1.5 transition-colors ${isActive ? 'text-emerald-400 font-semibold border-b-2 border-emerald-400 pb-0.5' : 'text-neutral-400 hover:text-white'}`}>
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              <span>{link.label}</span>
            </a>
          );
        }
        return (
          <a href={link.href} class={`transition-colors ${isActive ? 'text-emerald-400 font-semibold border-b-2 border-emerald-400 pb-0.5' : 'text-neutral-400 hover:text-white'}`}>
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right CTAs -->
    <div class="flex items-center gap-3">
      <!-- Live status badge -->
      <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300">
        <span class="pulse-dot"></span>
        <span class="font-medium">iRacing Sim Racing Team</span>
      </div>

      <!-- Discord Button -->
      <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-semibold text-xs px-4 py-2 rounded-lg transition-all shadow-sm hover:shadow-emerald-500/20">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.13-.255-.01-.556-.28-.646a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
        </svg>
        <span>Discord</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button type="button" id="navDrawerOpenBtn" class="md:hidden p-2 text-neutral-400 hover:text-white focus:outline-none" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Drawer & Backdrop -->
<div id="mobileBackdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden transition-opacity"></div>
<aside id="mobileDrawer" class="fixed top-0 right-0 bottom-0 w-72 bg-[#161c24] border-l border-white/10 z-50 p-6 flex flex-col justify-between shadow-2xl transition-transform duration-300 translate-x-full">
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
      <div class="flex items-center gap-2.5">
        <img src="/assets/img/logo-sm.webp" alt="Muntrume" class="h-6 w-auto" width="23" height="24" loading="lazy" decoding="async" />
        <span class="font-extrabold text-white text-base tracking-tight">MUNTRUME</span>
      </div>
      <button id="navDrawerCloseBtn" class="p-1 text-neutral-400 hover:text-white" aria-label="Close menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="space-y-1.5 text-sm font-medium">
      {navLinks.map((link) => {
        const isActive = link.match(currentPath);
        return (
          <a href={link.href} class={`block px-3 py-2.5 rounded-lg transition ${isActive ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
  <div class="pt-6 border-t border-white/10 space-y-3 text-xs">
    <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="block text-center py-3 rounded-lg bg-emerald-500 font-semibold text-neutral-950 transition hover:bg-emerald-400">
      Join Discord Community
    </a>
    <p class="text-[11px] text-neutral-500 text-center">Muntrume Motorsport © 2026 · Barcelona</p>
  </div>
</aside>

<script>
  function setupDrawer() {
    const drawer = document.getElementById('mobileDrawer');
    const backdrop = document.getElementById('mobileBackdrop');
    const openBtn = document.getElementById('navDrawerOpenBtn');
    const closeBtn = document.getElementById('navDrawerCloseBtn');

    if (!drawer || !backdrop) return;

    const toggle = (open?: boolean) => {
      const isOpen = open !== undefined ? open : drawer.classList.contains('translate-x-0');
      if (isOpen) {
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        backdrop.classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    };

    openBtn?.addEventListener('click', () => toggle(false));
    closeBtn?.addEventListener('click', () => toggle(true));
    backdrop?.addEventListener('click', () => toggle(true));
  }

  // Support Astro view transitions or standard loads
  document.addEventListener('DOMContentLoaded', setupDrawer);
  document.addEventListener('astro:page-load', setupDrawer);
</script>
