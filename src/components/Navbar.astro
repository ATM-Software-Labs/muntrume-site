---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Helper to determine active state
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/' || currentPath === '/index.html' || currentPath === '';
  return currentPath.startsWith(path);
};
---

<!-- Fixed Master Navbar -->
<header class="fixed top-0 left-0 right-0 z-50 h-16 bg-[#0e1217]/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-4">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none flex-shrink-0">
      <img src="/assets/img/logo-sm.webp" alt="Muntrume Motorsport" class="h-8 w-auto object-contain transition-transform group-hover:scale-105" width="31" height="32" />
      <div class="flex items-center gap-2">
        <span class="font-extrabold tracking-tight text-white text-base">MUNTRUME</span>
        <span class="text-[11px] font-semibold tracking-wider text-emerald-400 uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">MOTORSPORT</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-3 lg:gap-5 xl:gap-6 text-xs lg:text-sm font-medium whitespace-nowrap">
      <a href="/" class={`transition-colors border-b-2 pb-0.5 ${isActive('/') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        Inicio
      </a>
      <a href="/team" class={`transition-colors border-b-2 pb-0.5 ${isActive('/team') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        Pilotos
      </a>
      <a href="/news" class={`transition-colors border-b-2 pb-0.5 ${isActive('/news') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        Noticias
      </a>
      <a href="/about" class={`transition-colors border-b-2 pb-0.5 ${isActive('/about') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        Equipo
      </a>
      <a href="/contact" class={`transition-colors border-b-2 pb-0.5 ${isActive('/contact') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        Contacto
      </a>
      <a href="/mail" class={`transition-colors border-b-2 pb-0.5 flex items-center gap-1.5 ${isActive('/mail') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span>Mail</span>
      </a>
      <a href="/setups" class={`transition-colors border-b-2 pb-0.5 flex items-center gap-1.5 ${isActive('/setup') ? 'text-emerald-400 font-semibold border-emerald-400' : 'text-neutral-400 hover:text-white border-transparent'}`}>
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>Vault</span>
      </a>
    </nav>

    <!-- Right CTAs -->
    <div class="flex items-center gap-3 flex-shrink-0">
      <!-- Live status badge -->
      <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300">
        <span class="pulse-dot"></span>
        <span class="font-medium whitespace-nowrap">iRacing Sim Racing Team</span>
      </div>

      <!-- Discord Button -->
      <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-semibold text-xs px-3.5 py-2 rounded-lg transition-all shadow-sm hover:shadow-emerald-500/20 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.13-.255-.01-.556-.28-.646a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
        </svg>
        <span>Discord</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button type="button" id="navDrawerOpenBtn" onclick="toggleNavDrawer()" class="md:hidden p-2 text-neutral-400 hover:text-white focus:outline-none" aria-label="Toggle navigation menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer & Backdrop -->
<div id="mobileBackdrop" onclick="toggleNavDrawer(false)" aria-hidden="true"></div>
<aside id="mobileDrawer" aria-label="Mobile Navigation">
  <div>
    <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
      <a href="/" onclick="toggleNavDrawer(false)" class="flex items-center gap-2.5">
        <img src="/assets/img/logo-sm.webp" alt="Muntrume" class="h-6 w-auto" width="23" height="24" loading="lazy" decoding="async" />
        <span class="font-extrabold text-white text-base tracking-tight">MUNTRUME</span>
      </a>
      <button id="navDrawerCloseBtn" onclick="toggleNavDrawer(false)" class="p-1.5 text-neutral-400 hover:text-white focus:outline-none" aria-label="Close menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <nav class="space-y-1.5 text-sm font-medium">
      <a href="/" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition ${isActive('/') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        Inicio
      </a>
      <a href="/team" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition ${isActive('/team') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        Pilotos
      </a>
      <a href="/news" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition ${isActive('/news') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        Noticias
      </a>
      <a href="/about" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition ${isActive('/about') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        Equipo
      </a>
      <a href="/contact" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition ${isActive('/contact') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        Contacto
      </a>
      <a href="/mail" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition flex items-center justify-between ${isActive('/mail') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        <span>Webmail Corporativo</span>
        <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-white/5 text-emerald-400 border border-emerald-500/20">@muntru.me</span>
      </a>
      <a href="/setups" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition flex items-center justify-between ${isActive('/setup') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        <span>Setup Vault</span>
        <span class="text-[10px] uppercase font-bold text-emerald-400 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20">Privado</span>
      </a>
      <a href="/admin" onclick="toggleNavDrawer(false)" class={`block px-3 py-2.5 rounded-lg transition flex items-center justify-between ${isActive('/admin') ? 'text-emerald-400 bg-emerald-500/10 font-semibold border border-emerald-500/20' : 'text-neutral-300 hover:text-white hover:bg-white/5'}`}>
        <span>Consola de Administración</span>
        <span class="text-[10px] uppercase font-bold text-neutral-400 px-2 py-0.5 rounded-full bg-white/5 border border-white/10">Staff</span>
      </a>
    </nav>
  </div>
  <div class="pt-6 border-t border-white/10 space-y-3 text-xs">
    <a href="https://discord.gg/ehX6B8JUtE" target="_blank" rel="noopener noreferrer" class="block text-center py-3 rounded-lg bg-emerald-500 font-semibold text-neutral-950 transition hover:bg-emerald-400">
      Join Discord Community
    </a>
    <p class="text-[11px] text-neutral-500 text-center font-mono">Muntrume Motorsport © 2026 · Barcelona</p>
  </div>
</aside>

<script is:inline>
  function toggleNavDrawer(shouldBeOpen) {
    var drawer = document.getElementById('mobileDrawer');
    var backdrop = document.getElementById('mobileBackdrop');
    if (!drawer || !backdrop) return;
    var isOpen = drawer.classList.contains('open');
    var nextState = typeof shouldBeOpen === 'boolean' ? shouldBeOpen : !isOpen;
    if (nextState) {
      drawer.classList.add('open');
      backdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    } else {
      drawer.classList.remove('open');
      backdrop.classList.remove('open');
      document.body.style.overflow = '';
    }
  }
  window.toggleNavDrawer = toggleNavDrawer;
  
  // Close drawer on ESC key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') toggleNavDrawer(false);
  });
</script>

<style>
  nav a.border-transparent {
    border-color: transparent !important;
  }
</style>
