---
import DriverHelmet from "./DriverHelmet.astro";
import { formatoAprox, localeDeIdioma } from "../lib/formato-licencia.js";
import { licenciaPrincipal } from "../lib/licencias";
import { LICENCE_UPDATED_LABEL, computeAsymptoticRating, type Piloto } from "../lib/pilotos";
import { resolveSimBadges } from "../lib/sim-badges";
import { computeDriverAchievements } from "../lib/achievements";

interface Props {
  driver: Piloto;
  heading?: "h1" | "h2" | "h3";
  headingId?: string;
  hero?: boolean;
  profileHref?: string;
  eagerHelmet?: boolean;
}
const { driver, heading = "h2", headingId, hero = false, profileHref = `/drivers/${driver.slug}/`, eagerHelmet = false } = Astro.props;
const Tag = heading;
const BlockTag = hero ? "h2" : "h3";
const lic = licenciaPrincipal(driver.slug);
const loc = localeDeIdioma("es");
const bio = driver.bio.trim();
const ROLE_ES: Record<string, string> = {
  albertot: "Director de equipo y telemetría",
  mateob: "Resistencia y sprint GT3",
  eduardoc: "Resistencia GT3 y GT4",
};
const SPEC_ES: Record<string, string> = {
  albertot: "Resistencia multiclase y GT3",
  mateob: "Resistencia y sprint GT3",
  eduardoc: "Resistencia GT3 y GT4",
};
const BIO_ES: Record<string, string> = {
  albertot: "Fundador, director de equipo e ingeniero jefe de telemetría de Muntrume Motorsport. Especializado en el desarrollo de setups de Sports Car, la estrategia de resistencia GT3 y el análisis de telemetría en Garage 61.",
  mateob: "Piloto oficial de resistencia y sprint GT3 de Muntrume Motorsport, centrado en un ritmo constante en tandas largas de Sports Car y en una gestión limpia del tráfico.",
  eduardoc: "Piloto oficial de resistencia multiclase de Sports Car que representa a Costa Rica en Muntrume Motorsport, y compite en campeonatos de GT3 y GT4.",
};
const roleText = ROLE_ES[driver.slug] || driver.role;
const roleKey = ROLE_ES[driver.slug] ? `driver.role.${driver.slug}` : undefined;
const specText = SPEC_ES[driver.slug] || driver.specialty;
const specKey = SPEC_ES[driver.slug] ? `driver.specialty.${driver.slug}` : undefined;
const bioText = BIO_ES[driver.slug] || bio;
const bioKey = BIO_ES[driver.slug] ? `driver.bio.${driver.slug}` : undefined;
const cars = driver.favouriteCars.map((s) => s.trim()).filter(Boolean);
const series = driver.favouriteSeries.map((s) => s.trim()).filter(Boolean);
const achievements = driver.achievements.map((s) => s.trim()).filter(Boolean);
const since = driver.memberSince.trim();
const club = driver.club.trim();
const tracks = driver.topTracks || [];
const usedCars = driver.topCars || [];
const topTrack = tracks[0];
const sumTrackHours = driver.totalTrackHours || tracks.reduce((m, item) => m + item.hours, 0) || 1;
const sumCarHours = driver.totalCarHours || usedCars.reduce((m, item) => m + item.hours, 0) || 1;
const maxTrackHours = tracks.length ? Math.max(...tracks.map((t) => t.hours), 1) : 1;
const maxCarHours = usedCars.length ? Math.max(...usedCars.map((c) => c.hours), 1) : 1;
const maxTrackLaps = tracks.length ? Math.max(...tracks.map((t) => t.laps), 1) : 1;
const hoursText = (h: number) => formatoAprox(h, "h", loc);
const share = (val: number, total: number) => Math.max(2, Math.round((100 * val) / total));
const barWidth = (val: number, maxVal: number) => Math.max(8, Math.round((100 * val) / maxVal));
const fav = (driver.favoriteTrack || "").trim();

const srNum = Number(lic?.sr) || 3.0;
const srProgress = Math.min(100, Math.max(12, Math.round((srNum / 4.99) * 100)));
const ovrScore = computeAsymptoticRating(lic?.irating || 1500, srNum, sumTrackHours);
const sparklines: Record<string, string> = {
  albertot: "M2,20 Q28,17 55,14 T95,9 T126,4",
  mateob: "M2,21 Q30,18 60,14 T98,10 T126,6",
  eduardoc: "M2,22 Q32,19 64,15 T100,11 T126,8"
};
const sparkPath = sparklines[driver.slug] || "M2,20 Q30,16 65,12 T126,5";

const DRIVER_RECIPIENT_IDS: Record<string, string> = {
  albertot: "alberto",
  mateob: "mateo",
};
const driverRecipientId = DRIVER_RECIPIENT_IDS[driver.slug] || "admin";

function safeUrl(url: string) {
  const value = url.trim();
  if (!value) return "";
  try {
    const parsed = new URL(value);
    if (parsed.protocol === "https:" || parsed.protocol === "http:") return parsed.href;
  } catch { /* empty */ }
  return "";
}
const socials = (
  [
    ["twitch", "Twitch"],
    ["youtube", "YouTube"],
    ["instagram", "Instagram"],
    ["x", "X"],
  ] as const
).map(([key, label]) => ({ key, label, href: safeUrl(driver.socials[key]) })).filter((s) => s.href);

const simBadges = resolveSimBadges(driver.sims, driver.memberType, Boolean(lic || driver.cust_id));
const isStaffOnly = driver.memberType === "staff" && !lic && !driver.cust_id;
const achData = computeDriverAchievements(
  driver,
  lic?.irating ?? null,
  lic?.sr != null ? Number(lic.sr) : null,
  lic?.classLabel ?? null,
);
---
<article
  class:list={[
    "d-reveal",
    hero ? "d-hero-wrap" : "d-card",
  ]}
  data-driver={driver.slug}
  data-lic="sports_car"
  data-no-i18n
  id={hero ? "resumen" : undefined}
>
  {hero ? (
    <>
      <!-- 1. HERO HEADER CARD: Symmetrical 2-Column Grid, Vertically & Horizontally Balanced -->
      <div class="d-hero-card">
        <div class="d-stage" data-team={driver.slug}>
          <span class="d-stage-dorsal" data-f="dorsal" aria-label={`Official Number ${driver.dorsal}`}>{driver.dorsal}</span>
          <DriverHelmet slug={driver.slug} name={driver.fullName} eager={true} />
        </div>

        <div class="d-hero-main">
          <div class="d-hero-identity">
            <p class="d-kicker">
              <span class="d-flag" aria-hidden="true">{driver.flag}</span>
              <span data-f="country">{driver.country}</span>
              <span>·</span>
              <span data-f="role" data-i18n={roleKey}>{roleText}</span>
            </p>
            <Tag class="d-name" id={headingId}>
              <span class="d-num-pill" data-f="dorsal">{driver.dorsal}</span>
              <span data-f="name">{driver.fullName}</span>
            </Tag>
            <div class="d-badges-row">
              {lic && <p class="sc-badge"><span data-lic-f="class">{lic.classLabel}</span></p>}
              {isStaffOnly && (
                <span class="d-staff-pill">STAFF &amp; INGENIERÍA</span>
              )}
              {!isStaffOnly && (
                <span class="d-ovr-pill" title="Muntrume Telemetry Index (MTI)">
                  OVR <strong data-f="ovr">{ovrScore}</strong>
                </span>
              )}
              {driver.specialty && <span class="d-specialty-pill" data-f="specialty" data-i18n={specKey}>{specText}</span>}
            </div>
            {simBadges.length > 0 && (
              <div class="d-sims-row" aria-label="Simuladores y plataformas">
                {simBadges.map((sim) => (
                  <span class="d-sim-pill" style={`--sim-color:${sim.color}`} title={sim.name}>
                    <span class="d-sim-pill__ico" set:html={sim.svg} />
                    <span>{sim.name}</span>
                  </span>
                ))}
              </div>
            )}
            <div class="d-email-bar" aria-label="Contacto directo del piloto">
              <a href={`/contact/?to=${driverRecipientId}`} class="d-email-link">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>
                <span>Contactar con {driver.name} →</span>
              </a>
            </div>
          </div>

          {isStaffOnly ? (
            <dl class="d-stats d-stats--hero" id="stats">
              <div>
                <dt>Rol</dt>
                <dd class="d-stats__dorsal" style="font-size:1rem;">{roleText}</dd>
                <span class="d-stats__sub">Muntrume Staff</span>
              </div>
              <div>
                <dt>Plataformas</dt>
                <dd>{simBadges.length}</dd>
                <span class="d-stats__sub">{simBadges.map((s) => s.short).join(" · ")}</span>
              </div>
              <div>
                <dt>Logros</dt>
                <dd>{achData.unlocked.length}</dd>
                <span class="d-stats__sub">Insignias MMT</span>
              </div>
              <div>
                <dt>En el equipo</dt>
                <dd>{since || "2026"}</dd>
                <span class="d-stats__sub">{club || "Muntrume"}</span>
              </div>
            </dl>
          ) : (
            <dl class="d-stats d-stats--hero" id="stats">
              <div>
                <dt data-i18n="card.dorsal">Dorsal</dt>
                <dd class="d-stats__dorsal" data-f="dorsal">{driver.dorsal}</dd>
                <span class="d-stats__sub">Muntrume Roster</span>
              </div>
              <div>
                <dt id="licencia">SR Sports Car</dt>
                <dd data-approx="sr" data-n={lic?.sr ?? ""} data-lic-f="sr">{lic ? formatoAprox(Number(lic.sr), "sr", loc) : "—"}</dd>
                <span class="d-sr-bar" aria-hidden="true"><span class="d-sr-fill" style={`width:${srProgress}%`}></span></span>
              </div>
              <div>
                <dt>iRating</dt>
                <dd data-approx="k" data-n={lic?.irating ?? ""} data-f="irating" data-lic-f="irating">{lic?.irating != null ? formatoAprox(lic.irating, "k", loc) : "—"}</dd>
                <svg class="d-sparkline" viewBox="0 0 130 24" width="68" height="12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d={sparkPath} stroke="#00E699" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <dt data-i18n="card.trackHours">Horas en pista</dt>
                <dd data-approx="h" data-n={sumTrackHours} data-f="total_track_hours">{hoursText(sumTrackHours)}</dd>
                <span class="d-stats__sub">Garage 61</span>
              </div>
            </dl>
          )}

          <div id="driverAllLicenses" class="flex flex-wrap gap-2 mt-2" hidden></div>

          <div class="d-hero-meta">
            <div class="d-hero-meta__items">
              <span data-block="member_since" hidden={!since}>
                <span data-i18n="card.since">En el equipo desde</span> <strong data-f="member_since_value">{since}</strong>
              </span>
              <span data-block="club" hidden={!club}>
                <span data-i18n="card.club">Club:</span> <strong data-f="club_value">{club}</strong>
              </span>
              <span id="licenceUpdated">
                <span data-i18n="card.updated">Actualizado:</span> <time datetime="2026-11-07">{LICENCE_UPDATED_LABEL}</time>
              </span>
            </div>
            <div id="redes" data-block="socials">
              {socials.length > 0 ? (
                <ul class="d-socials">
                  {socials.map((s) => (
                    <li>
                      <a href={s.href} rel="noopener noreferrer" target="_blank">
                        {s.label} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="d-pending" data-i18n="card.pending">Pendiente. Este piloto todavía no ha publicado redes.</p>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- 2. FAVORITE TRACK & MOST DRIVEN TRACK: Symmetrical 2-Column Grid -->
      <div class="d-track-cards">
        {fav && (
          <div class="d-track-card" id="favorito">
            <div class="flex items-center gap-2">
              <span class="p-1.5 rounded-lg bg-[var(--r-bg)] border border-[var(--r-line)] text-amber-500 shrink-0">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.2 6.8 18.6l1-5.8L3.6 8.7l5.8-.8z"/></svg>
              </span>
              <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[var(--r-muted)]" data-i18n="card.fav">Circuito favorito</span>
            </div>
            <div class="my-1">
              <h3 class="font-sans font-bold text-lg text-[var(--r-text)] leading-tight" data-f="favorite_track">{fav}</h3>
            </div>
            <p class="text-xs font-mono text-[var(--r-muted)]" data-i18n="card.favNote">Elegido por el equipo: el circuito con menos incidentes.</p>
          </div>
        )}
        {topTrack && (
          <div class="d-track-card">
            <div class="flex items-center gap-2">
              <span class="p-1.5 rounded-lg bg-[var(--r-bg)] border border-[var(--r-line)] text-[var(--r-accent)] shrink-0">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <span class="text-[10px] font-mono font-semibold uppercase tracking-wider text-[var(--r-muted)]" data-i18n="card.mostUsed">Circuito más usado</span>
            </div>
            <div class="my-1">
              <h3 class="font-sans font-bold text-lg text-[var(--r-text)] leading-tight" data-f="top_track_name">{topTrack.name}</h3>
            </div>
            <p class="text-xs font-mono text-[var(--r-muted)]"><span class="font-bold text-[var(--r-text)]" data-approx="h" data-n={topTrack.hours} data-f="top_track_hours">{hoursText(topTrack.hours)}</span> en pista</p>
          </div>
        )}
      </div>

      <!-- 2B. GITHUB-STYLE ACHIEVEMENTS & TROPHIES SHOWCASE -->
      <section class="d-ach-section" id="logros" aria-label="Logros e insignias del piloto">
        <div class="d-ach-head">
          <div class="d-ach-head__title">
            <span class="d-ach-head__ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
            </span>
            <BlockTag class="d-block__title" style="margin:0;">Logros e Insignias</BlockTag>
          </div>
          <span class="d-ach-count">{achData.unlocked.length} desbloqueados</span>
        </div>

        <div class="d-ach-grid">
          {achData.unlocked.map((a) => (
            <div class={`d-ach-card d-ach-card--${a.tier}`}>
              <div class="d-ach-medal" set:html={a.iconSvg} />
              <div class="d-ach-body">
                <div class="d-ach-top">
                  <strong class="d-ach-title">{a.title}</strong>
                  <span class={`d-ach-tier d-ach-tier--${a.tier}`}>{a.tierLabel}</span>
                </div>
                <p class="d-ach-desc">{a.desc}</p>
              </div>
            </div>
          ))}
        </div>

        {achData.nextMilestones.length > 0 && (
          <div class="d-ach-next">
            <span class="d-ach-next__k">Próximos objetivos</span>
            <div class="d-ach-next__grid">
              {achData.nextMilestones.map((m) => (
                <div class="d-ach-mile">
                  <div class="d-ach-mile__top">
                    <span class="d-ach-mile__ico" set:html={m.iconSvg} />
                    <strong class="d-ach-mile__title">{m.title}</strong>
                    <span class="d-ach-mile__pct">{m.progressLabel}</span>
                  </div>
                  <div class="d-ach-mile__bar" aria-hidden="true">
                    <span style={`width:${Math.max(4, Math.min(100, m.progressPct ?? 0))}%`}></span>
                  </div>
                  <p class="d-ach-mile__desc">{m.desc}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </section>

      <!-- 3. BIO, SPORTS CARS & SERIES: Symmetrical 3-Column Grid -->
      <div class="d-info-grid">
        <div class="d-block d-info-card" id="bio" data-block="bio">
          <BlockTag class="d-block__title">Perfil</BlockTag>
          {bio ? <p class="d-bio" data-f="bio" data-i18n={bioKey}>{bioText}</p> : <p class="d-pending" data-i18n="card.bioPending">Pendiente de publicación. La biografía todavía no está escrita.</p>}
          {achievements.length > 0 && (
            <div class="d-info-card__sub" data-block="achievements">
              <span class="r-kicker">Palmarés destacado</span>
              <ul data-list="achievements">
                {achievements.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}
        </div>

        <div class="d-block d-info-card" data-block="cars" hidden={!cars.length}>
          <BlockTag class="d-block__title">Coches principales</BlockTag>
          <ul data-list="cars">
            {cars.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="d-block d-info-card" data-block="series" hidden={!series.length}>
          <BlockTag class="d-block__title">Series</BlockTag>
          <ul data-list="series">
            {series.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      {tracks.length > 0 && (
        <section class="d-laps-chart" id="vueltas" aria-labelledby={`${driver.slug}-laps`}>
          <h2 id={`${driver.slug}-laps`} class="d-block__title">Vueltas por circuito</h2>
          <svg viewBox={`0 0 ${Math.max(tracks.length, 1) * 56} 180`} width="100%" height="180" role="img" aria-label={`Vueltas de ${driver.fullName} por circuito`}>
            {tracks.map((item, idx) => {
              const h = Math.max(4, Math.round((item.laps / maxTrackLaps) * 120));
              const x = idx * 56 + 8;
              return (
                <g>
                  <rect x={x} y={140 - h} width="32" height={h} rx="4" fill="#2ee6a6" />
                  <text x={x + 16} y="158" text-anchor="middle" fill="#8a959c" font-size="9">{item.laps}</text>
                </g>
              );
            })}
          </svg>
          <ol class="d-laps-chart__names">
            {tracks.map((item) => <li>{item.name}</li>)}
          </ol>
        </section>
      )}

      <!-- 4. TELEMETRY BARS: Symmetrical 2-Column Grid for Circuits & Cars -->
      {tracks.length > 0 && (
        <div class="d-laps">
          <section id="circuitos" aria-labelledby={`${driver.slug}-tracks`} class="d-bars-panel">
            <div class="d-bars-head">
              <h2 id={`${driver.slug}-tracks`} class="d-block__title">Circuitos Sports Car (horas)</h2>
              <span class="r-meta">{tracks.length} circuitos · solo Sports Car</span>
            </div>
            <ol class="d-bars" data-telemetry-tracks={driver.slug} id={`tracksList-${driver.slug}`}>
              {tracks.map((item, idx) => (
                <li data-track={item.name} data-extra-bar={idx >= 5 ? "true" : undefined} hidden={idx >= 5}>
                  <span class="d-bars__name">{item.name}</span>
                  <span class="d-bars__val">
                    <span data-approx="h" data-n={item.hours}>{hoursText(item.hours)}</span> <span>en pista</span>
                    {item.incidentsPerLap != null ? ` · ${item.incidentsPerLap}x/lap` : ""}
                  </span>
                  <span class="d-bars__share">{share(item.hours, sumTrackHours)}% <span>del total</span></span>
                  <span class="d-bar" aria-hidden="true"><span style={`width:${barWidth(item.hours, maxTrackHours)}%`}></span></span>
                </li>
              ))}
            </ol>
            {tracks.length > 5 && (
              <button
                type="button"
                class="d-bars-toggle"
                data-toggle-bars={`tracksList-${driver.slug}`}
                data-total-count={tracks.length}
                data-label-unit="circuitos"
                aria-expanded="false"
              >
                Ver lista ({tracks.length} circuitos) ▾
              </button>
            )}
          </section>

          <section id="coches" aria-labelledby={`${driver.slug}-cars`} class="d-bars-panel">
            <div class="d-bars-head">
              <h2 id={`${driver.slug}-cars`} class="d-block__title">Coches Sports Car (horas)</h2>
              <span class="r-meta">{usedCars.length} coches · Garage 61</span>
            </div>
            <ol class="d-bars" data-telemetry-cars={driver.slug} id={`carsList-${driver.slug}`}>
              {usedCars.map((item, idx) => (
                <li data-car={item.name} data-extra-bar={idx >= 5 ? "true" : undefined} hidden={idx >= 5}>
                  <span class="d-bars__name">{item.name}</span>
                  <span class="d-bars__val"><span data-approx="h" data-n={item.hours}>{hoursText(item.hours)}</span> <span>en pista</span></span>
                  <span class="d-bars__share">{share(item.hours, sumCarHours)}% <span>del total</span></span>
                  <span class="d-bar" aria-hidden="true"><span style={`width:${barWidth(item.hours, maxCarHours)}%`}></span></span>
                </li>
              ))}
            </ol>
            {usedCars.length > 5 && (
              <button
                type="button"
                class="d-bars-toggle"
                data-toggle-bars={`carsList-${driver.slug}`}
                data-total-count={usedCars.length}
                data-label-unit="coches"
                aria-expanded="false"
              >
                Ver lista ({usedCars.length} coches) ▾
              </button>
            )}
          </section>
          <p class="r-meta d-laps__src">
            Horas de Sports Car ponderadas por el tiempo de vuelta en Garage 61 · nov 2026
          </p>
        </div>
      )}
    </>
  ) : (
    <>
      <!-- OVERVIEW GRID CARD (!hero): Equal Height Flex Column with Bottom-Aligned CTA -->
      <div class="d-stage" data-team={driver.slug}>
        <span class="d-stage-dorsal" data-f="dorsal" aria-label={`Official Number ${driver.dorsal}`}>{driver.dorsal}</span>
        <DriverHelmet slug={driver.slug} name={driver.fullName} eager={eagerHelmet} />
      </div>

      <div class="d-card__body">
        <!-- Top Group: Balanced Header + Badges + 3-Column Stats -->
        <div class="d-card__top">
          <p class="d-kicker">
            <span class="d-flag" aria-hidden="true">{driver.flag}</span>
            <span data-f="country">{driver.country}</span> · <span data-f="role" data-i18n={roleKey}>{roleText}</span>
          </p>
          <Tag class="d-name" id={headingId}>
            <span class="d-num-pill d-num-pill--sm" data-f="dorsal">{driver.dorsal}</span>
            <span data-f="name">{driver.fullName}</span>
          </Tag>
          <div class="d-badges-row">
            {lic && <p class="sc-badge"><span data-lic-f="class">{lic.classLabel}</span></p>}
            {isStaffOnly && <span class="d-staff-pill">STAFF</span>}
            {!isStaffOnly && (
              <span class="d-ovr-pill" title="Muntrume Telemetry Index (MTI)">
                OVR <strong data-f="ovr">{ovrScore}</strong>
              </span>
            )}
            {driver.specialty && <span class="d-specialty-pill" data-f="specialty" data-i18n={specKey}>{specText}</span>}
          </div>

          {simBadges.length > 0 && (
            <div class="d-sims-row d-sims-row--sm" aria-label="Simuladores">
              {simBadges.map((sim) => (
                <span class="d-sim-pill d-sim-pill--sm" style={`--sim-color:${sim.color}`} title={sim.name}>
                  <span class="d-sim-pill__ico" set:html={sim.svg} />
                  <span>{sim.short}</span>
                </span>
              ))}
              {achData.unlocked.length > 0 && (
                <span class="d-ach-mini-pill" title={achData.unlocked.map((a) => `${a.title} (${a.tierLabel})`).join(" · ")}>
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
                  <span>{achData.unlocked.length}</span>
                </span>
              )}
            </div>
          )}

          {isStaffOnly ? (
            <dl class="d-stats">
              <div>
                <dt>Rol</dt>
                <dd style="font-size:0.82rem;">{driver.badge}</dd>
              </div>
              <div>
                <dt>Plataformas</dt>
                <dd>{simBadges.length}</dd>
              </div>
              <div>
                <dt>Desde</dt>
                <dd>{since || "2026"}</dd>
              </div>
            </dl>
          ) : (
            <dl class="d-stats">
              <div>
                <dt>SR</dt>
                <dd data-approx="sr" data-n={lic?.sr ?? ""} data-lic-f="sr">{lic ? formatoAprox(Number(lic.sr), "sr", loc) : "—"}</dd>
                <span class="d-sr-bar" aria-hidden="true"><span class="d-sr-fill" style={`width:${srProgress}%`}></span></span>
              </div>
              <div>
                <dt>iRating</dt>
                <dd data-approx="k" data-n={lic?.irating ?? ""} data-f="irating" data-lic-f="irating">{lic?.irating != null ? formatoAprox(lic.irating, "k", loc) : "—"}</dd>
                <svg class="d-sparkline" viewBox="0 0 130 24" width="68" height="12" fill="none" preserveAspectRatio="none" aria-hidden="true">
                  <path d={sparkPath} stroke="#00E699" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
              <div>
                <dt data-i18n="card.hours">Horas</dt>
                <dd data-approx="h" data-n={sumTrackHours}>{hoursText(sumTrackHours)}</dd>
              </div>
            </dl>
          )}
        </div>

        <!-- Bottom Group: Compact Tracks + Expandable Circuits + Aligned Full Profile Button -->
        <div class="d-card__bottom">
          <div class="d-compact-tracks">
            {fav && (
              <p class="d-fav">
                <svg class="d-star" viewBox="0 0 24 24" width="14" height="14" role="img" aria-label="Circuito favorito" data-i18n-aria="card.favAria"><path fill="currentColor" d="M12 2.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.2 6.8 18.6l1-5.8L3.6 8.7l5.8-.8z"/></svg>
                <span class="d-fav__k" data-i18n="card.fav">Circuito favorito</span>
                <span class="d-fav__n">{fav}</span>
              </p>
            )}
            {topTrack && (
              <p class="d-lap">
                <span class="d-lap__k"><span data-i18n="card.most">Más usado</span> ({hoursText(topTrack.hours)})</span>
                <span class="d-lap__n">{topTrack.name}</span>
              </p>
            )}
          </div>

          <details class="d-telemetry-expand">
            <summary class="d-expand-summary">
              <span><span data-i18n="card.tracks">Circuitos</span> ({tracks.length})</span>
              <span class="d-chevron">▾</span>
            </summary>
            <div class="d-expand-content">
              <ul class="d-expand-list">
                {tracks.map((t) => (
                  <li>
                    <span>{t.name}</span>
                    <strong class="text-[var(--r-accent)]" data-approx="h" data-n={t.hours}>{hoursText(t.hours)}</strong>
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <div class="d-email-bar d-email-bar--compact">
            <a href={`/contact/?to=${driverRecipientId}`} class="d-email-link">
              <span aria-hidden="true">✉</span>
              <span>Contactar con {driver.name} →</span>
            </a>
          </div>

          <div class="d-actions-row">
            <a class="d-card__link" href={profileHref}>
              <span data-i18n="card.profile">Ver ficha</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </>
  )}
</article>

