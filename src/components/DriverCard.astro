---
import DriverHelmet from "./DriverHelmet.astro";
import { formatoAprox, localeDeIdioma } from "../lib/formato-licencia.js";
import { licenciaPrincipal } from "../lib/licencias";
import { LICENCE_UPDATED_LABEL, type Piloto } from "../lib/pilotos";

interface Props {
  driver: Piloto;
  heading?: "h1" | "h2" | "h3";
  headingId?: string;
  hero?: boolean;
}
const { driver, heading = "h2", headingId, hero = false } = Astro.props;
const Tag = heading;
const BlockTag = hero ? "h2" : "h3";
const lic = licenciaPrincipal(driver.slug);
const loc = localeDeIdioma("es");
const bio = driver.bio.trim();
const cars = driver.favouriteCars.map((s) => s.trim()).filter(Boolean);
const series = driver.favouriteSeries.map((s) => s.trim()).filter(Boolean);
const achievements = driver.achievements.map((s) => s.trim()).filter(Boolean);
const since = driver.memberSince.trim();
const club = driver.club.trim();
const tracks = driver.topTracks || [];
const usedCars = driver.topCars || [];
const topTrack = tracks[0];
const topCar = usedCars[0];
const sumTrack = tracks.reduce((m, item) => m + item.laps, 0) || 1;
const sumCar = usedCars.reduce((m, item) => m + item.laps, 0) || 1;
const lapsText = (n: number) => formatoAprox(n, "k", loc);
const share = (n: number, sum: number) => Math.max(4, Math.round((100 * n) / sum));
const fav = (driver.favoriteTrack || "").trim();

function safeUrl(url: string) {
  const value = url.trim();
  if (!value) return "";
  try {
    const parsed = new URL(value);
    if (parsed.protocol === "https:" || parsed.protocol === "http:") return parsed.href;
  } catch { /* vacío */ }
  return "";
}
const socials = (
  [
    ["twitch", "Twitch"],
    ["youtube", "YouTube"],
    ["instagram", "Instagram"],
    ["x", "X"],
  ] as const
).map(([key, label]) => ({ key, label, href: safeUrl(driver.socials[key]) })).filter((s) => s.href);
---
<article class:list={["d-card", "d-reveal", hero && "d-hero"]} data-driver={driver.slug} data-lic="sports_car" id={hero ? "resumen" : undefined}>
  <div class="d-stage" data-team={driver.slug}>
    <DriverHelmet slug={driver.slug} name={driver.fullName} eager={hero} />
  </div>
  <div class="d-card__body">
    <p class="d-kicker"><span class="d-flag" aria-hidden="true">{driver.flag}</span> <span>{driver.country}</span> · <span>{driver.role}</span></p>
    <Tag class="d-name" id={headingId}><span class="d-num">{driver.dorsal}</span> {driver.fullName}</Tag>
    {lic && <p class="sc-badge"><span data-lic-f="class">{lic.classLabel}</span></p>}
    <dl class="d-stats">
      <div><dt>SR</dt><dd data-approx="sr" data-n={lic?.sr ?? ""} data-lic-f="sr">{lic ? formatoAprox(Number(lic.sr), "sr", loc) : ""}</dd></div>
      <div><dt>iRating</dt><dd data-approx="k" data-n={lic?.irating ?? ""} data-f="irating" data-lic-f="irating">{lic?.irating != null ? formatoAprox(lic.irating, "k", loc) : ""}</dd></div>
      <div><dt>ttRating</dt><dd data-approx="k" data-n={lic?.ttRating ?? ""} data-lic-f="tt">{lic ? formatoAprox(lic.ttRating, "k", loc) : ""}</dd></div>
    </dl>
    <p class="d-meta" data-block="member_since" hidden={!since}><span>Miembro desde</span> <time data-f="member_since_value" datetime={since || undefined}>{since}</time></p>
    <p class="d-meta" data-block="club" hidden={!club}><span>Club</span> <span data-f="club_value">{club}</span></p>
    {hero ? (
      <div class="d-track-cards">
        {fav && (
          <div class="d-track-card d-track-card--fav">
            <p class="d-fav">
              <svg class="d-star" viewBox="0 0 24 24" width="16" height="16" role="img" aria-label="Circuito favorito"><path fill="currentColor" d="M12 2.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.2 6.8 18.6l1-5.8L3.6 8.7l5.8-.8z"/></svg>
              <span class="d-fav__k">Circuito favorito</span>
              <span class="d-fav__n" data-f="favorite_track">{fav}</span>
            </p>
            <p class="r-meta">Elección personal del piloto</p>
          </div>
        )}
        {topTrack && (
          <div class="d-track-card">
            <p class="d-lap">
              <span class="d-lap__k">Circuito más rodado</span>
              <span class="d-lap__n" data-f="top_track_name">{topTrack.name}</span>
              <span class="d-lap__v"><span data-approx="k" data-n={topTrack.laps} data-f="top_track_laps">{lapsText(topTrack.laps)}</span> <span>vueltas</span></span>
            </p>
            <p class="r-meta">Volumen confirmado en pista</p>
          </div>
        )}
      </div>
    ) : (
      <>
        {fav && (
          <p class="d-fav">
            <svg class="d-star" viewBox="0 0 24 24" width="16" height="16" role="img" aria-label="Circuito favorito"><path fill="currentColor" d="M12 2.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 16.2 6.8 18.6l1-5.8L3.6 8.7l5.8-.8z"/></svg>
            <span class="d-fav__k">Circuito favorito</span>
            <span class="d-fav__n">{fav}</span>
          </p>
        )}
        {topTrack && (
          <p class="d-lap"><span class="d-lap__k">Circuito más rodado</span> <span class="d-lap__n">{topTrack.name}</span> <span class="d-lap__v"><span data-approx="k" data-n={topTrack.laps}>{lapsText(topTrack.laps)}</span> <span>vueltas</span></span></p>
        )}
        {topCar && (
          <p class="d-lap"><span class="d-lap__k">Coche más usado</span> <span class="d-lap__n">{topCar.name}</span> <span class="d-lap__v"><span data-approx="k" data-n={topCar.laps}>{lapsText(topCar.laps)}</span> <span>vueltas</span></span></p>
        )}
        {(topTrack || topCar) && <p class="r-meta">telemetría del equipo, nov 2026</p>}
      </>
    )}
    {hero && <p class="r-meta" id="licenceUpdated">Actualizado: <time datetime="2026-11-06">{LICENCE_UPDATED_LABEL}</time></p>}
    <div class="d-block" data-block="bio" hidden={!bio}>
      <p class="d-bio" data-f="bio">{bio}</p>
    </div>
    <div class="d-block" data-block="cars" hidden={!cars.length}>
      <BlockTag class="d-block__title">Coches</BlockTag>
      <ul data-list="cars">{cars.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="d-block" data-block="series" hidden={!series.length}>
      <BlockTag class="d-block__title">Series</BlockTag>
      <ul data-list="series">{series.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="d-block" data-block="achievements" hidden={!achievements.length}>
      <BlockTag class="d-block__title">Logros</BlockTag>
      <ul data-list="achievements">{achievements.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="d-block" data-block="socials" hidden={!socials.length}>
      <ul class="d-socials">
        {socials.map((s) => <li><a href={s.href} rel="noopener noreferrer" target="_blank">{s.label}</a></li>)}
      </ul>
    </div>
    {!hero && <a class="r-link d-card__link" href={`/d/${driver.slug}/`}>Ver ficha</a>}
  </div>
  {hero && tracks.length > 0 && (
    <div class="d-laps">
      <section id="circuitos" aria-labelledby={`${driver.slug}-tracks`}>
        <h2 id={`${driver.slug}-tracks`} class="d-block__title">Circuitos más rodados</h2>
        <ol class="d-bars" data-telemetry-tracks={driver.slug}>
          {tracks.map((item) => (
            <li data-track={item.name}>
              <span class="d-bars__name">{item.name}</span>
              <span class="d-bars__val">
                <span data-approx="k" data-n={item.laps}>{lapsText(item.laps)}</span> <span>vueltas</span>
                {item.timeOnTrack ? ` · ${item.timeOnTrack}` : ""}
                {item.incidentsPerLap != null ? ` · ${item.incidentsPerLap}x/vta` : ""}
              </span>
              <span class="d-bars__share">{share(item.laps, sumTrack)}% <span>del top 5</span></span>
              <span class="d-bar" aria-hidden="true"><span style={`width:${share(item.laps, sumTrack)}%`}></span></span>
            </li>
          ))}
        </ol>
      </section>
      <section id="coches" aria-labelledby={`${driver.slug}-cars`}>
        <h2 id={`${driver.slug}-cars`} class="d-block__title">Coches habituales</h2>
        <ol class="d-bars" data-telemetry-cars={driver.slug}>
          {usedCars.map((item) => (
            <li data-car={item.name}>
              <span class="d-bars__name">{item.name}</span>
              <span class="d-bars__val"><span data-approx="k" data-n={item.laps}>{lapsText(item.laps)}</span> <span>vueltas</span></span>
              <span class="d-bars__share">{share(item.laps, sumCar)}% <span>del top 5</span></span>
              <span class="d-bar" aria-hidden="true"><span style={`width:${share(item.laps, sumCar)}%`}></span></span>
            </li>
          ))}
        </ol>
      </section>
      <p class="r-meta d-laps__src">telemetría del equipo, nov 2026</p>
    </div>
  )}
</article>
